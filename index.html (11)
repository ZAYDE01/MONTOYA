               Se oculta solo si el producto no tiene ningún detalle. -->
          <div class="acc-item" id="pdpDetailsItem" style="display:none;">
            <div class="acc-head" onclick="this.parentElement.classList.toggle('open')"><span data-zt="pdp.acc.details" data-zg="Ficha de producto">Detalles</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></div>
            <div class="acc-body"><div class="acc-inner pdp-facts">
              <table class="fact-table"><tbody id="pdpDetailsBody"></tbody></table>
