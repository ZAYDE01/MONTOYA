            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h2l2 12h11l2-9H6"/><circle cx="9" cy="21" r="1"/><circle cx="17" cy="21" r="1"/></svg>
            <span data-zt="pdp.addcart" data-zg="Ficha de producto">Añadir al carrito</span>
          </button>
