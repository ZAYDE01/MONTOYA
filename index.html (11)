              <div class="pdp-gorra-pic" id="pdpGorraSilueta" style="display:none;"></div>
            </div></div>
          </div>
          <!-- [GORRAS] Cómo saber tu talla (imagen compartida según Cerrada / Ajustable). Solo sale en gorras con imagen. -->
          <div class="acc-item" id="pdpTallaItem" style="display:none;">
            <div class="acc-head" onclick="this.parentElement.classList.toggle('open')"><span data-zt="pdp.acc.size" data-zg="Ficha de producto">Cómo saber tu talla</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></div>
            <div class="acc-body"><div class="acc-inner" id="pdpTallaBody"></div></div>
          </div>
          <!-- [FICHA-TECNICA] Ahora vive debajo de "Descripción" y arranca CERRADA:
               se despliega solo cuando la persona le da clic. La tabla sigue
               en el DOM (SEO/lectores de pantalla) aunque esté plegada. -->
          <div class="acc-item" id="pdpFactsItem">
            <div class="acc-head" onclick="this.parentElement.classList.toggle('open')"><span data-zt="pdp.acc.facts" data-zg="Ficha de producto">Ficha técnica</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></div>
