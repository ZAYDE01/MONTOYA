/* ---------- CARRUSEL DE PRODUCTOS ----------
   [PEDIDO CLIENTE] Antes "En tendencia", "Más vendidos", "Recién
   llegados" y "Visto recientemente" (en ZAYDE y en ZAYDE G) eran una
   cuadrícula que se envolvía en varias filas — se veía amontonado y
   alargaba mucho la página, sobre todo en celular. Ahora cada sección
   muestra sus 6 piezas en una sola fila con scroll horizontal hacia la
   derecha, exactamente como el carrusel de "Reseñas destacadas" de
   arriba (.fr-row), pero con el ancho de una tarjeta de producto en vez
   de una tarjeta de reseña. Se aplica por id a cada grid de producto del
   home de ambas tiendas — ver la lista de selectores abajo. */
#homeTabPanelTrending.active, #homeTabPanelBestsellers.active, #grid-new, #grid-recently-viewed,
#zgHomeTabPanelTrending.active, #zgHomeTabPanelBestsellers.active, #zgNewGrid, #zgGridRecentlyViewed{
  display:flex; grid-template-columns:none; gap:16px; overflow-x:auto; padding-bottom:8px;
  scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none;
}
#homeTabPanelTrending::-webkit-scrollbar, #homeTabPanelBestsellers::-webkit-scrollbar, #grid-new::-webkit-scrollbar, #grid-recently-viewed::-webkit-scrollbar,
#zgHomeTabPanelTrending::-webkit-scrollbar, #zgHomeTabPanelBestsellers::-webkit-scrollbar, #zgNewGrid::-webkit-scrollbar, #zgGridRecentlyViewed::-webkit-scrollbar{display:none;}
#homeTabPanelTrending .card, #homeTabPanelBestsellers .card, #grid-new .card, #grid-recently-viewed .card,
#zgHomeTabPanelTrending .card, #zgHomeTabPanelBestsellers .card, #zgNewGrid .card, #zgGridRecentlyViewed .card{
  flex:0 0 220px; scroll-snap-align:start;
}
@media(max-width:760px){
  #homeTabPanelTrending.active, #homeTabPanelBestsellers.active, #grid-new, #grid-recently-viewed,
  #zgHomeTabPanelTrending.active, #zgHomeTabPanelBestsellers.active, #zgNewGrid, #zgGridRecentlyViewed{
    gap:12px; margin:0 -16px; padding:0 16px 6px;
  }
  #homeTabPanelTrending .card, #homeTabPanelBestsellers .card, #grid-new .card, #grid-recently-viewed .card,
  #zgHomeTabPanelTrending .card, #zgHomeTabPanelBestsellers .card, #zgNewGrid .card, #zgGridRecentlyViewed .card{
    flex:0 0 46%; max-width:190px;
  }
}

/* [Punto 4 — auditoría] "Cómo verificamos" — sección propia del home. */
