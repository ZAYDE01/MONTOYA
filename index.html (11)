          <!-- [RELOJES — ESPECIFICACIONES] Entre Descripción y Detalles. Solo sale en relojes con datos. -->
          <div class="acc-item" id="pdpSpecsItem" style="display:none;">
            <div class="acc-head" onclick="this.parentElement.classList.toggle('open')"><span data-zt="pdp.acc.specs" data-zg="Ficha de producto">Especificaciones</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></div>
            <div class="acc-body"><div class="acc-inner pdp-facts">
