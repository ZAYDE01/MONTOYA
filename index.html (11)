.order-card-headline{font-size:12px; color:var(--steel); margin-bottom:4px;}
.order-card-headline b{color:var(--text); font-weight:700;}
.order-card-num{display:inline-flex; align-items:center; gap:10px; font-size:13px; font-weight:700; letter-spacing:.02em;
  border:1px solid var(--line); border-radius:var(--r-pill); padding:8px 8px 8px 16px; background:var(--surface-dim); color:var(--text);}
.order-copy-btn{background:var(--surface); border:1px solid var(--line); color:var(--steel); padding:6px; border-radius:50%;
  display:flex; transition:color .15s, border-color .15s;}
.order-copy-btn:hover{color:var(--signal); border-color:var(--signal);}
.order-status-pill{font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; padding:4px 10px;
  border-radius:var(--r-lg); background:var(--signal-dim); color:var(--signal); white-space:nowrap; flex:none;}
.order-status-pill.status-up{background:rgba(28,138,75,.12); color:var(--up);}
.order-card-meta{font-size:12px; color:var(--steel); margin:2px 0 16px;}
/* [RASTREO ESTILO MERCADO LIBRE / AMAZON] Encabezado con la fecha
   estimada de entrega + un stepper horizontal con ícono por etapa
   (recibido, verificando, preparando, en camino, entregado), conectados
   por una barra que se va llenando en verde a medida que avanza el
   pedido — mismo lenguaje visual que el rastreo de Mercado Libre/Amazon,
   con un toque propio: el ícono de la etapa actual "respira" con un
   anillo de color de marca (--signal) en vez de quedarse estático. Debajo
   va el detalle cronológico ("Detalles de rastreo") con fecha y hora real
   de cada cambio de estado. Ver zyRenderOrderCard()/zyTrackingStepperHTML()
   /zyTrackingDetailsHTML() en el JS. */
.zy-track-eta{display:flex; align-items:center; gap:12px; padding:2px 0 18px; margin-bottom:2px;}
.zy-track-eta.is-done{}
.zy-track-eta-icon{width:36px; height:36px; border-radius:50%; background:var(--signal); color:#fff; flex:none;
  display:flex; align-items:center; justify-content:center;}
.zy-track-eta.is-done .zy-track-eta-icon{background:var(--up);}
.zy-track-eta-icon svg{width:17px; height:17px;}
.zy-track-eta-text b{display:block; font-size:13px; color:var(--text);}
.zy-track-eta-text span{display:block; font-size:11px; color:var(--steel); margin-top:1px; line-height:1.4;}
.zy-stepper{display:flex; align-items:flex-start; margin-bottom:22px;}
.zy-step{flex:1; display:flex; flex-direction:column; align-items:center; text-align:center; position:relative; min-width:0; padding:0 2px;}
.zy-step-line{position:absolute; top:17px; left:-50%; width:100%; height:3px; background:var(--line); z-index:0; border-radius:var(--r-sm);}
.zy-step:first-child .zy-step-line{display:none;}
.zy-step.filled .zy-step-line{background:var(--up);}
.zy-step-dot{width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center;
  position:relative; z-index:1; background:var(--surface-dim); border:2px solid var(--line); color:var(--steel);
  transition:background .25s ease, border-color .25s ease, color .25s ease;}
.zy-step-dot svg{width:15px; height:15px;}
.zy-step.filled .zy-step-dot{background:var(--up); border-color:var(--up); color:#fff;}
.zy-step.current .zy-step-dot{background:var(--signal); border-color:var(--signal); color:#fff;
  box-shadow:0 0 0 5px var(--signal-dim); animation:zyStepPulse 1.8s ease-in-out infinite;}
@keyframes zyStepPulse{0%,100%{box-shadow:0 0 0 5px var(--signal-dim);} 50%{box-shadow:0 0 0 9px rgba(0,0,0,0);}}
.zy-step-label{font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.02em; color:var(--steel);
  margin-top:8px; line-height:1.3; width:100%; overflow-wrap:break-word; word-break:break-word; hyphens:auto;}
.zy-step.filled .zy-step-label, .zy-step.current .zy-step-label{color:var(--text);}
@media(max-width:480px){
  .zy-step-dot{width:28px; height:28px;} .zy-step-dot svg{width:12px; height:12px;}
  .zy-step-line{top:14px;} .zy-step-label{font-size:10px; letter-spacing:0; line-height:1.2; margin-top:6px;}
}
@media(max-width:360px){
  .zy-step{padding:0 1px;}
  .zy-step-label{font-size:10px;}
}
.zy-track-details{border-top:1px solid var(--line); padding-top:14px;}
.zy-track-detail-row{display:flex; gap:12px; padding:8px 0; font-size:12px; align-items:flex-start;}
.zy-track-detail-dot{width:8px; height:8px; border-radius:50%; background:var(--line); flex:none; margin-top:5px;}
.zy-track-detail-row.is-latest .zy-track-detail-dot{background:var(--up);}
.zy-track-detail-time{flex:0 0 auto; color:var(--steel); min-width:118px;}
.zy-track-detail-label{font-weight:600; color:var(--text);}
.zy-track-detail-row.is-latest .zy-track-detail-label{color:var(--up);}
@media(max-width:480px){
  .zy-track-detail-row{flex-direction:column; gap:2px;}
  .zy-track-detail-time{font-size:11px;}
}
.order-card-section{border-top:1px solid var(--line); padding-top:14px; margin-top:14px;}
.order-help-link{display:flex; align-items:center; justify-content:space-between; font-size:13px; font-weight:700;
  color:var(--text); padding:2px 0;}
.order-help-link:hover{color:var(--signal);}
/* ---------- COMPROBANTE DE PAGO (estilo ticket, tipo SPIN/OXXO) ----------
   [FIX — color] Antes este ticket usaba un fondo blanco fijo (#FFFFFF) sin
   importar el tema del sitio, para garantizar buen contraste. El problema:
   en modo oscuro se veía como un recuadro blanco "pegado" en medio de una
   página oscura — fuera de lugar y poco profesional (justo lo que reportó
   el cliente). Ahora usa las mismas variables de color del resto del sitio
   (var(--surface), var(--text), var(--line)), así se ve como una tarjeta
   más de ZAYDE — oscura en modo oscuro, clara en modo claro — conservando
   el look de "ticket" (borde punteado, encabezado centrado) solo con el
   color acento verde para el check de "Pagado". */
.order-receipt-block{background:var(--surface); color:var(--text); border-radius:var(--r-md); padding:4px 14px 14px;
  border:1px dashed var(--line); position:relative;}
.order-receipt-head{display:flex; align-items:center; gap:6px; justify-content:center; text-align:center;
  padding:12px 0 10px; margin-bottom:6px; border-bottom:1px dashed var(--line); color:var(--text);}
.order-receipt-head svg{color:var(--up);}
.order-receipt-head b{font-size:11px; text-transform:uppercase; letter-spacing:.07em;}
.order-receipt-row{display:flex; justify-content:space-between; gap:10px; font-size:13px; padding:5px 0;}
.order-receipt-row span:first-child{color:var(--steel);}
.order-receipt-row span:last-child{font-weight:700; text-align:right; color:var(--text);}
.order-receipt-ok{color:var(--up) !important; font-weight:700;}
.order-receipt-total{display:flex; justify-content:space-between; align-items:center; gap:10px;
  margin-top:6px; padding-top:10px; border-top:1px dashed var(--line); font-size:14px; font-weight:800; color:var(--text);}
.order-receipt-total span:first-child{font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--steel); font-weight:700;}
.receipt-share-notice{display:flex; gap:9px; align-items:flex-start; background:var(--signal-dim);
  border:1px solid var(--line); border-radius:var(--r-md); padding:11px 12px; margin-top:12px; font-size:12px;
  color:var(--text); line-height:1.45;}
.receipt-share-notice svg{flex-shrink:0; margin-top:1px; color:var(--signal);}
.receipt-share-btn{display:flex; align-items:center; justify-content:center; gap:8px; width:100%; margin-top:10px;
  padding:12px; border-radius:var(--r-md); background:var(--signal); color:#fff; border:none; font-weight:700;
  font-size:12px; letter-spacing:.02em; cursor:pointer;}
.receipt-share-btn:hover{opacity:.9;}
.order-card-section-title{font-size:10px; text-transform:uppercase; letter-spacing:.06em; font-weight:700; color:var(--steel); margin-bottom:10px;}
/* ---- Fila de producto con foto, estilo Nike (antes era solo una línea
   de texto "1× Marca Nombre · Talla X — $000.00", sin ninguna imagen) ---- */
.order-item{display:flex; gap:14px; padding:12px 0; border-bottom:1px solid var(--line);}
.order-item:last-child{border-bottom:none; padding-bottom:2px;}
.order-item-img{width:78px; height:78px; border-radius:var(--r-md); object-fit:cover; background:var(--surface-dim); flex:none; border:1px solid var(--line);}
.order-item-img.ph{display:flex; align-items:center; justify-content:center; color:var(--steel);}

/* [TARJETA DE REGALO — FONDO DE MARCA] La Z de ZAYDE (mismo ícono del
   favicon/manifest, /icons/icon-512.png) como fondo visual de la tarjeta
   de regalo — en la vista previa de compra y en el modal de confirmación
   — en vez de una foto de producto genérica, ya que una tarjeta de regalo
   no es una prenda con foto real. */
.gift-card-face{position:relative; overflow:hidden; background:radial-gradient(120% 140% at 88% 0%, rgba(74,95,199,.5), transparent 58%), linear-gradient(135deg,#0B1030 0%,#07070A 70%); display:flex; flex-direction:column; justify-content:space-between;}
.gift-card-face::before{content:''; position:absolute; inset:0; background:url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20100%20100'%3E%3Cdefs%3E%3ClinearGradient%20id='g'%20x1='0'%20y1='0'%20x2='1'%20y2='1'%3E%3Cstop%20offset='0'%20stop-color='%236478DC'/%3E%3Cstop%20offset='1'%20stop-color='%234A5FC7'/%3E%3C/linearGradient%3E%3Cfilter%20id='b'%20x='-30%25'%20y='-30%25'%20width='160%25'%20height='160%25'%3E%3CfeGaussianBlur%20stdDeviation='4'/%3E%3C/filter%3E%3C/defs%3E%3Cpath%20d='M18,15%20L82,15%20L82,32%20L45,68%20L82,68%20L82,85%20L18,85%20L18,68%20L55,32%20L18,32%20Z'%20fill='%234A5FC7'%20opacity='.55'%20filter='url(%23b)'/%3E%3Cpath%20d='M18,15%20L82,15%20L82,32%20L45,68%20L82,68%20L82,85%20L18,85%20L18,68%20L55,32%20L18,32%20Z'%20fill='url(%23g)'/%3E%3C/svg%3E") center/auto 70% no-repeat;}
.gift-card-face > *{position:relative; z-index:1;}
.gift-card-face .gcf-brand{font-size:12px; letter-spacing:.14em; color:#fff; font-weight:800; text-transform:uppercase;}
.gift-card-face .gcf-amount{font-size:12px; letter-spacing:.14em; color:#fff; font-weight:800; text-transform:uppercase; align-self:flex-end;}
.gift-card-face--hero{height:170px; border-radius:var(--r-lg); border:1px solid var(--line); padding:18px 20px; margin-bottom:18px;}
.gift-card-face--modal{height:150px; padding:16px 18px;}

/* [MONTO LIBRE] Campo "Otro monto" de la tarjeta de regalo. */
.gift-custom{margin:-4px 0 16px;}
.gift-custom-label{display:block; font-size:11px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; color:var(--steel); margin-bottom:6px;}
.gift-custom-field{display:flex; align-items:center; gap:8px; padding:0 14px; border:1px solid var(--line); border-radius:var(--r-md); background:var(--surface); font-weight:700; color:var(--steel); transition:border-color .15s ease, box-shadow .15s ease;}
.gift-custom-field:focus-within{border-color:var(--signal); box-shadow:0 0 0 3px var(--signal-dim);}
.gift-custom-field input#giftCustomAmount{flex:1; min-width:0; width:100%; margin:0 !important; padding:13px 0 !important; border:none !important; box-shadow:none !important; outline:none; background:transparent !important; font-size:15px; font-weight:700; -moz-appearance:textfield; appearance:textfield;}
.gift-custom-field input#giftCustomAmount::-webkit-outer-spin-button,.gift-custom-field input#giftCustomAmount::-webkit-inner-spin-button{-webkit-appearance:none; margin:0;}
.gift-custom-hint{margin:6px 2px 0; font-size:12px; color:var(--steel);}
.order-item-body{flex:1; min-width:0;}
.order-item-name{font-size:14px; font-weight:700; line-height:1.3; margin-bottom:3px;}
.order-item-price{font-size:13px; font-weight:700; margin-bottom:6px;}
.order-item-price del{color:var(--steel); font-weight:500; margin-left:7px;}
.order-item-desc{font-size:11px; color:var(--steel); line-height:1.55;}
.order-deliver-block{font-size:12px; line-height:1.5;}
.order-total-row{display:flex; justify-content:space-between; font-size:13px; font-weight:800; padding-top:8px;}
/* ---- Resumen final (Subtotal / Envío / Total), estilo Nike ---- */
.order-summary-row{display:flex; justify-content:space-between; font-size:12px; color:var(--steel); padding:5px 0;}
.order-summary-row span:last-child{font-weight:600; color:var(--text);}
.order-summary-row.total{border-top:1px solid var(--line); margin-top:6px; padding-top:12px; font-size:14px; font-weight:800; color:var(--text);}
.order-summary-row.total span:last-child{color:var(--text); font-weight:800;}
.order-card-actions{display:flex; gap:8px; margin-top:16px;}
.order-card-actions .btn{flex:1; padding:12px 14px; font-size:11px;}
.order-empty{text-align:center; padding:28px 16px; color:var(--steel); font-size:13px; border:1px dashed var(--line); border-radius:var(--r-md); margin-bottom:6px;}


/* ---------- TOTALES DE CHECKOUT (productos + envío) ---------- */
.ck-total-box{border:1px solid var(--line); border-radius:var(--r-md); padding:14px 16px; margin:14px 0 18px; background:var(--surface-dim);}
.ck-total-row{display:flex; justify-content:space-between; align-items:center; font-size:12px; color:var(--steel); padding:4px 0;}
.ck-total-row span:last-child{font-family:var(--font-body); font-weight:600; color:var(--text);}
.ck-total-row.ck-total-final{border-top:1px solid var(--line); margin-top:6px; padding-top:10px; font-size:14px; font-weight:700; color:var(--text);}
.ck-total-row.ck-total-final span:last-child{font-size:16px; color:var(--signal);}
/* [Punto 4 — auditoría] Buyer Protection visible en checkout, junto al total. */
.ck-trust-badge{display:flex; align-items:center; gap:10px; width:100%; text-align:left; padding:12px 14px; margin-bottom:18px; border:1px solid var(--line); border-radius:var(--r-md); background:var(--surface-dim); cursor:pointer; transition:border-color .15s;}
.ck-trust-badge:hover{border-color:var(--signal);}
.ck-trust-badge svg{width:18px; height:18px; color:var(--signal); flex-shrink:0;}
.ck-trust-badge span{font-size:12px; line-height:1.4; color:var(--steel);}
.ck-trust-badge b{color:var(--text);}
.ck-weight-note{font-size:11px; color:var(--steel); margin-top:6px; line-height:1.5;}
.digital-note{display:flex; align-items:flex-start; gap:10px; background:var(--signal-dim); color:var(--signal); border:1px solid var(--signal); border-radius:var(--r-md); padding:12px 14px; font-size:12px; line-height:1.5; margin:18px 0;}
.digital-note svg{flex-shrink:0; margin-top:1px;}

/* ---------- PAGO CON STRIPE (tarjeta / Apple Pay / Google Pay) ---------- */
#payment-element{margin-bottom:14px; min-height:44px;}
.pay-loading{display:flex; align-items:center; gap:10px; font-size:12px; color:var(--steel); padding:14px 0;}
.pay-loading .pay-spinner{border-color:rgba(107,109,118,.25); border-top-color:var(--steel);}
.payment-message{font-size:12px; color:var(--down); background:rgba(198,67,42,0.08); border:1px solid var(--down);
  border-radius:var(--r-sm); padding:10px 12px; margin-bottom:12px;}
.secure-note{display:flex; align-items:center; gap:6px; font-size:11px; color:var(--steel); justify-content:center; margin-top:10px;}
.secure-note svg{width:13px; height:13px;}
.btn-primary.stripe-pay-btn{width:100%; display:flex; align-items:center; justify-content:center; gap:8px; background:#635BFF;}
.btn-primary.stripe-pay-btn:hover{background:#4f46e5;}
.btn-primary.stripe-pay-btn:disabled{opacity:.5; cursor:not-allowed;}

/* ---------- MÉTODO DE PAGO: pestañas WhatsApp / Stripe (vista previa) ---------- */
.pay-method-tabs{display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:12px;}
.pay-method-tab{position:relative; display:flex; align-items:center; gap:10px; text-align:left; border:1px solid var(--line);
  background:var(--surface-dim); border-radius:var(--r-md); padding:12px 12px; transition:all .15s; color:var(--text);}
.pay-method-tab svg{width:20px; height:20px; flex-shrink:0; color:var(--steel);}
.pay-method-tab span{font-size:12px; font-weight:700; line-height:1.35;}
.pay-method-tab .pmt-sub{font-size:10px; font-weight:500; color:var(--steel);}
.pay-method-tab.active{border-color:var(--text); background:var(--surface);}
.pay-method-tab.active svg{color:var(--text);}
.pay-method-tab.stripe.active{border-color:#635BFF;}
.pay-method-tab.stripe.active svg{color:#635BFF;}
.pmt-badge{position:absolute; top:-8px; right:8px; background:#635BFF; color:#fff; font-size:10px; font-weight:800;
  text-transform:uppercase; letter-spacing:.04em; padding:2px 7px; border-radius:var(--r-lg);}
.stripe-card-preview{border:1px solid var(--line); border-radius:var(--r-md); padding:16px; margin-bottom:14px; background:var(--surface-dim);}
.stripe-card-preview-brand{display:flex; align-items:center; justify-content:space-between; margin-bottom:14px;}
.stripe-card-preview-brand b{font-size:12px;}
.stripe-card-preview-brand .scp-wordmark{color:#635BFF; font-weight:800; font-style:italic; font-size:13px; letter-spacing:.01em;}
.stripe-card-preview-note{font-size:11px; color:var(--steel); background:rgba(99,91,255,0.08); border:1px dashed #635BFF44;
  border-radius:var(--r-sm); padding:8px 10px; margin-bottom:14px; line-height:1.5;}
.scp-row{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
.stripe-card-preview input{pointer-events:none; opacity:.85;}
.stripe-card-element{background:var(--surface); border:1px solid var(--line); border-radius:var(--r-md); padding:12px 14px; margin-bottom:8px;}
.stripe-card-errors{color:var(--down); font-size:12px; min-height:16px; margin-bottom:6px;}
.stripe-payment-failed-box{margin:8px 0 4px; padding:12px 14px; border:1px solid #e0b4b4; background:#FBEAEA; border-radius:var(--r-md); font-size:12px; color:#5a1414;}
.stripe-payment-failed-box b{color:#8A1F1F;}
.stripe-payment-failed-box .spf-actions{display:flex; gap:8px; margin-top:10px; flex-wrap:wrap;}
.stripe-payment-failed-box .spf-actions button{font-size:12px; padding:7px 12px; border-radius:var(--r-sm); border:1px solid #8A1F1F; background:#fff; color:#8A1F1F; cursor:pointer; font-weight:600;}
.stripe-payment-failed-box .spf-actions button:hover{background:#8A1F1F; color:#fff;}

/* ---------- SELECTOR DE PAQUETERÍA (sucursal: Estafeta / FedEx / DHL Express) ---------- */
.carrier-tabs{display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-bottom:12px;}
.carrier-tab{border:1px solid var(--line); background:var(--surface); border-radius:var(--r-sm); padding:9px 6px; font-size:11px; font-weight:700;
  text-align:center; color:var(--steel); transition:all .15s;}
.carrier-tab.active{border-color:var(--carrier-color, var(--signal)); color:var(--text); background:var(--surface-dim);}
.carrier-tab .ct-dot{display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--carrier-color, var(--signal)); margin-right:6px;}

/* ---------- SHIP MODE TABS ---------- */
.ship-mode-tabs{display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:18px;}
.ship-mode-tab{border:1px solid var(--line); background:var(--surface-dim); border-radius:var(--r-sm); padding:12px 10px; font-size:12px; font-weight:700;
  text-align:center; color:var(--steel); display:flex; flex-direction:column; align-items:center; gap:6px; transition:all .15s;}
.ship-mode-tab svg{width:18px; height:18px;}
.ship-mode-tab.active{background:var(--text); color:var(--bg); border-color:var(--text);}

/* ---------- FUTURISTIC LOCATION PANEL (envío a domicilio) ---------- */
.geo-panel{position:relative; border:1px solid var(--signal); border-radius:var(--r-md); padding:16px; margin-bottom:16px; overflow:hidden;
  background:linear-gradient(180deg, var(--signal-dim), transparent 70%);}
.geo-panel::before{content:''; position:absolute; left:0; right:0; top:0; height:2px; background:linear-gradient(90deg, transparent, var(--signal), transparent);
  animation:scanline 2.4s linear infinite;}
@keyframes scanline{0%{top:0;}100%{top:100%;}}
.geo-panel-top{display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px;}
.geo-panel-label{display:flex; align-items:center; gap:8px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:var(--signal);}
.geo-dot{width:7px; height:7px; border-radius:50%; background:var(--signal); flex-shrink:0; animation:pulse 1.6s infinite;}
.geo-btn{display:flex; align-items:center; gap:7px; background:var(--text); color:var(--bg); border:none; border-radius:var(--r-lg);
  padding:8px 14px; font-size:11px; font-weight:700;}
.geo-btn svg{width:14px; height:14px;}
.geo-btn:hover{background:var(--signal); color:#fff;}
.geo-btn:disabled{opacity:.5;}
.geo-readout{font-family:var(--font-body); font-size:11px; color:var(--steel); display:flex; flex-wrap:wrap; gap:14px; padding:10px 12px;
  background:var(--surface); border:1px solid var(--line); border-radius:var(--r-sm);}
.geo-readout b{color:var(--text);}
.geo-readout .geo-empty{color:var(--steel); font-style:italic;}

/* ---------- ESTAFETA SUCURSAL MAP ---------- */
.branch-locate-row{display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:12px;}
.branch-locate-row .geo-btn{width:auto;}
.estafeta-map-wrap{display:grid; grid-template-columns:1fr; gap:12px; margin-bottom:16px;}
#estafetaMap{width:100%; height:230px; border-radius:var(--r-md); overflow:hidden; border:1px solid var(--line); background:var(--surface-dim);
  position:relative;}
.map-fallback{position:absolute; inset:0; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:8px;
  padding:16px; text-align:center; font-size:12px; color:var(--steel);}
.branch-list{display:flex; flex-direction:column; gap:8px; max-height:190px; overflow-y:auto; padding-right:2px;}
.branch-item{display:flex; align-items:center; gap:10px; border:1px solid var(--line); border-radius:var(--r-sm); padding:10px 12px; cursor:pointer; transition:all .12s;}
.branch-item:hover{border-color:var(--text);}
.branch-item.active{border-color:var(--signal); background:var(--signal-dim);}
.branch-item .b-pin{width:26px; height:26px; border-radius:50%; background:var(--surface-dim); display:flex; align-items:center; justify-content:center; flex-shrink:0;}
.branch-item.active .b-pin{background:var(--signal); color:#fff;}
.branch-item .b-pin svg{width:14px; height:14px;}
.branch-item .b-info{flex:1; min-width:0;}
.branch-item .b-name{font-size:12px; font-weight:700;}
.branch-item .b-addr{font-size:11px; color:var(--steel); margin-top:1px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.branch-item .b-dist{font-family:var(--font-body); font-size:11px; color:var(--signal); flex-shrink:0; text-align:right;}
.branch-selected-summary{display:none; align-items:flex-start; gap:10px; border:1px solid var(--up); background:rgba(28,138,75,0.08);
  border-radius:var(--r-sm); padding:12px 14px; margin-bottom:16px; font-size:12px;}
.branch-selected-summary.show{display:flex;}
.branch-selected-summary svg{width:16px; height:16px; color:var(--up); flex-shrink:0; margin-top:1px;}
.branch-selected-summary b{display:block; margin-bottom:2px;}
.branch-selected-summary span{color:var(--steel); font-size:11px;}
/* ---- [UBICACIÓN / SUCURSALES] mapa de entrega con pin ajustable y buscador de sucursales ---- */
.delivery-map{width:100%; height:240px; border-radius:var(--r-md); border:1px solid var(--line); margin-top:12px; z-index:0;}
.geo-hint{font-size:11.5px; color:var(--steel); margin:8px 0 0; line-height:1.45;}
.ck-locate-btn{display:block; width:100%; margin:0 0 4px; padding:10px 12px; border:1px dashed var(--signal); border-radius:var(--r-sm); background:var(--signal-dim); color:var(--text); font-family:inherit; font-size:12px; font-weight:700; cursor:pointer;}
/* ---- Mapa profesional: pines por paquetería, punto de ubicación pulsante, tarjeta flotante ---- */
.zy-map-shell{position:relative; border-radius:16px; overflow:hidden; border:1px solid var(--line); box-shadow:0 10px 30px rgba(14,14,16,.10); background:#E5E3DF;}
.zy-map-shell .leaflet-container, .delivery-map.leaflet-container{background:#E5E3DF; font-family:inherit;}
.zy-map-shell #estafetaMap{height:340px; border:0; border-radius:0; box-shadow:none;}
.zy-map-chip{position:absolute; left:12px; top:12px; z-index:500; display:flex; align-items:center; gap:8px; max-width:calc(100% - 24px); padding:7px 12px; border-radius:999px; background:rgba(255,255,255,.94); color:#0E0E10; font-size:11.5px; font-weight:700; box-shadow:0 4px 14px rgba(14,14,16,.18); backdrop-filter:blur(6px); pointer-events:none;}
.zy-map-chip i{width:8px; height:8px; border-radius:50%; background:var(--cc,#2F5FFF); flex:none;}
.zy-map-chip span{white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.zy-map-loading{position:absolute; inset:0; z-index:600; display:flex; align-items:center; justify-content:center; gap:10px; background:#E5E3DF; color:#585A63; font-size:12px; font-weight:600;}
.zy-map-loading.off{display:none;}
.zy-spin{width:16px; height:16px; border-radius:50%; border:2px solid var(--line); border-top-color:var(--signal); animation:zyspin .7s linear infinite; display:inline-block; vertical-align:-3px;}
@keyframes zyspin{to{transform:rotate(360deg);}}
.zy-pin-wrap{background:none !important; border:0 !important;}
.zy-pin{filter:drop-shadow(0 3px 4px rgba(14,14,16,.35)); transition:transform .15s; transform-origin:50% 100%;}
.zy-pin:hover{transform:scale(1.12);}
.zy-pin.active{animation:zybounce .5s ease-out;}
@keyframes zybounce{0%{transform:translateY(-14px) scale(.9);}60%{transform:translateY(2px);}100%{transform:none;}}
.zy-me-wrap{background:none !important; border:0 !important;}
.zy-me{position:relative; width:18px; height:18px; border-radius:50%; background:#2F5FFF; border:3px solid #fff; box-shadow:0 2px 8px rgba(47,95,255,.6);}
.zy-me::after{content:""; position:absolute; inset:-10px; border-radius:50%; border:2px solid rgba(47,95,255,.5); animation:zypulse 1.8s ease-out infinite;}
@keyframes zypulse{0%{transform:scale(.4); opacity:1;}100%{transform:scale(1.5); opacity:0;}}
.leaflet-tooltip.zy-tip{border:0; border-radius:10px; padding:8px 10px; font-family:inherit; font-size:11.5px; line-height:1.4; box-shadow:0 6px 18px rgba(14,14,16,.22); color:#0E0E10;}
.leaflet-tooltip.zy-tip b{font-size:12px;}
.leaflet-tooltip-top.zy-tip::before{border-top-color:#fff;}
.branch-status.loading::before{content:""; display:inline-block; width:12px; height:12px; margin-right:8px; border-radius:50%; border:2px solid var(--line); border-top-color:var(--signal); animation:zyspin .7s linear infinite; vertical-align:-2px;}
.branch-list{max-height:250px;}
.branch-item{border-radius:12px;}
.branch-item .b-pin{background:color-mix(in srgb,var(--bc,var(--signal)) 14%,transparent); color:var(--bc,var(--signal));}
.branch-item.active{border-color:var(--bc,var(--signal));}
.branch-item.active .b-pin{background:var(--bc,var(--signal)); color:#fff;}
.branch-item .b-dist{font-weight:700; background:var(--surface-dim); border-radius:999px; padding:3px 8px;}
.delivery-map{height:260px; border-radius:16px; box-shadow:0 10px 30px rgba(14,14,16,.10);}
.geo-btn.is-loading{opacity:.85; pointer-events:none;}
.branch-search-row{display:flex; gap:8px; margin-bottom:10px;}
.branch-search-row input{flex:1; min-width:0;}
.branch-search-row .geo-btn{width:auto; flex:none;}
.branch-status{font-size:11.5px; color:var(--steel); margin:0 0 10px; line-height:1.45; min-height:16px;}
.branch-empty{font-size:12px; color:var(--steel); padding:12px; border:1px dashed var(--line); border-radius:var(--r-sm);}
.branch-manual{margin-top:12px; border:1px solid var(--line); border-radius:var(--r-sm); padding:10px 12px;}
.branch-manual summary{cursor:pointer; font-size:12px; font-weight:700;}
.branch-manual input,.branch-manual select{width:100%; margin-top:8px;}
.branch-manual .btn{margin-top:10px; width:100%;}

/* toast */
.toast{position:fixed; bottom:24px; left:50%; transform:translateX(-50%) translateY(20px); background:var(--text); color:var(--bg);
  /* [FIX — "no pasa nada" en el panel admin] Antes z-index:200, MENOS que
     .zy-modal (z-index:500) — cualquier showToast() disparado mientras el
     panel admin está abierto (que es casi siempre, porque casi todas las
     acciones del panel llaman a showToast) quedaba tapado por el propio
     panel y nunca se veía. Ahora va por encima de todo. */
  padding:14px 22px; border-radius:var(--r-sm); font-size:13px; font-weight:600; z-index:900; opacity:0; pointer-events:none; transition:all .25s; display:flex; align-items:center; gap:10px;}
.toast.show{opacity:1; transform:translateX(-50%) translateY(0);}
.toast svg{width:16px; height:16px; color:var(--up);}
.toast.toast-error{background:#8A1F1F; color:#fff;}
.toast.toast-error svg{color:#fff;}

/* ---------- panel privado (acceso vía logo ZAYDE del footer) ---------- */

.zy-modal{position:fixed; inset:0; z-index:500; display:flex; align-items:center; justify-content:center;
  background:rgba(14,14,16,0.5); opacity:0; pointer-events:none; transition:opacity .2s; padding:20px;}
.zy-modal.open{opacity:1; pointer-events:auto;}
.zy-panel{background:var(--surface); border-radius:var(--r-md); width:340px; max-width:92vw; box-shadow:var(--shadow); padding:22px; position:relative;}
.zy-panel.zy-wide{width:540px; max-height:88vh; overflow-y:auto;}
.zy-close{position:absolute; top:10px; right:12px; background:none; border:none; color:var(--steel); font-size:20px; line-height:1; padding:4px; font-weight:400;}
.zy-pass-row{display:flex; gap:8px;}
.zy-pass-row input{flex:1; background:var(--surface-dim); border:1px solid var(--line); border-radius:var(--r-sm); padding:11px 12px; font-size:13px; color:var(--text); font-family:inherit;}
.zy-pass-row input:focus{border-color:var(--signal);}
.zy-pass-row button{background:var(--text); color:var(--bg); border:none; border-radius:var(--r-sm); padding:0 16px; font-size:13px; font-weight:700;}
.zy-pass-row.shake{animation:zyShake .3s;}
@keyframes zyShake{0%,100%{transform:translateX(0);}25%{transform:translateX(-6px);}75%{transform:translateX(6px);}}
.region-item{display:flex; align-items:center; gap:10px; width:100%; padding:11px 6px; background:none; border:none; border-bottom:1px solid var(--line); text-align:left; font-family:inherit; font-size:13px; color:var(--text); cursor:pointer;}
.region-item:hover{background:var(--surface-dim);}
.region-item.active{color:var(--signal); font-weight:700;}
.region-item-flag{font-size:18px; line-height:1;}
.region-item-name{flex:1;}
.region-item-cur{font-size:11px; color:var(--steel); font-weight:600;}
.zy-notify-prompt{position:fixed; left:16px; bottom:-160px; width:340px; max-width:calc(100vw - 32px); z-index:900; background:var(--surface); border:1px solid var(--line); border-radius:var(--r-md); box-shadow:var(--shadow); padding:16px; display:flex; flex-direction:column; gap:10px; transition:bottom .35s ease;}
.zy-notify-prompt.show{bottom:16px;}
.zy-notify-prompt-icon{color:var(--signal);}
.zy-notify-prompt-icon svg{width:22px; height:22px;}
.zy-notify-prompt-text{display:flex; flex-direction:column; gap:2px;}
.zy-notify-prompt-text b{font-size:13px;}
.zy-notify-prompt-text span{font-size:12px; color:var(--steel);}
.zy-notify-prompt-actions{display:flex; gap:8px;}
.zy-notify-prompt-actions button{flex:1; padding:9px 10px; font-size:12px;}
@media(max-width:640px){ .zy-notify-prompt{left:12px; right:12px; width:auto;} }

.zy-form label{display:block; font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--steel); font-weight:700; margin:14px 0 6px;}
.zy-form label:first-of-type{margin-top:0;}
.zy-form input, .zy-form select, .zy-form textarea{
  width:100%; background:var(--surface-dim); border:1px solid var(--line); border-radius:var(--r-sm);
  padding:10px 12px; font-size:13px; color:var(--text); font-family:inherit;
}
.zy-form textarea{resize:vertical; min-height:64px;}
.zy-admin-tabs{display:flex; gap:8px; margin:6px 0 18px; flex-wrap:wrap;}
.zy-admin-tab{flex:1; padding:10px; border:1px solid var(--line); border-radius:var(--r-md); background:var(--surface-dim); color:var(--steel); font-weight:700; font-size:12px; text-transform:uppercase; letter-spacing:.04em;}
.zy-admin-tab.active{background:var(--text); color:var(--bg); border-color:var(--text);}

/* ============================================================
   [ADMIN-ORGANIZADO] La franja de 13 pestañas planas (flex:1 +
   flex-wrap) se sentía "revuelta" porque cada fila reajustaba el
   ancho de sus botones según cuántos cabían — filas desiguales, y en
   celular quedaban carreras de botones apretadísimos. Se reemplaza
   por grupos con encabezado (Catálogo, Pedidos y clientes, Contenido
   del sitio, Analítica) en una cuadrícula fija que SIEMPRE alinea
   parejo, tanto en escritorio como en celular.
   ============================================================ */
.zy-admin-tabs-wrap{margin:6px 0 20px;}
.zy-admin-tab-group{margin-bottom:16px;}
.zy-admin-tab-group:last-child{margin-bottom:0;}
.zy-admin-tab-group-title{font-size:10px; text-transform:uppercase; letter-spacing:.06em; color:var(--steel); font-weight:800; margin:0 0 8px 2px;}
.zy-admin-tab-grid{display:grid; grid-template-columns:repeat(auto-fill, minmax(128px, 1fr)); gap:8px;}
.zy-admin-tab-grid .zy-admin-tab{flex:none; width:auto;}
@media(max-width:640px){
  .zy-admin-tab-grid{grid-template-columns:repeat(2, 1fr);}
  .zy-admin-tab-grid .zy-admin-tab{padding:12px 8px; font-size:11px; line-height:1.25;}
}
.zy-stock-per-size{margin-bottom:14px;}
.zy-stock-grid{display:flex; flex-wrap:wrap; gap:8px; margin-top:6px;}
.zy-stock-item{display:flex; flex-direction:column; align-items:center; gap:4px; border:1px solid var(--line); border-radius:var(--r-md); padding:6px 8px; min-width:56px;}
.zy-stock-item span{font-size:11px; color:var(--steel); font-weight:700;}
.zy-stock-item input{width:100%; min-width:44px; text-align:center; border:1px solid var(--line); border-radius:var(--r-sm); padding:4px 2px; font-size:12px; background:var(--surface);}
.zy-stats-grid{display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin-bottom:22px;}
.zy-stat-card{border:1px solid var(--line); border-radius:var(--r-md); padding:16px 18px; background:var(--surface-dim);}
.zy-stat-label{display:block; font-size:11px; text-transform:uppercase; letter-spacing:.04em; color:var(--steel); margin-bottom:8px;}
.zy-stat-value{display:block; font-size:24px; font-weight:800; color:var(--text);}
.zy-charts-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:16px;}
.verify-badge{display:inline-flex; align-items:center; gap:5px; font-weight:700; font-size:12px;}
.verify-badge.verified{color:var(--up);}
.verify-badge.pending{color:var(--steel);}
.zy-orders-toolbar{display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end; margin-bottom:12px;}
.zy-orders-search{flex:1 1 260px; min-width:220px; position:relative; display:flex; align-items:center; border:1px solid var(--line); border-radius:var(--r-md); background:var(--surface); padding:0 10px;}
.zy-orders-search svg{width:14px; height:14px; color:var(--steel); flex:none;}
.zy-orders-search input{flex:1; border:none; background:transparent; padding:10px 8px; font-size:12px; color:var(--text); outline:none;}
.zy-orders-search-clear{background:transparent; border:none; color:var(--steel); font-size:16px; line-height:1; cursor:pointer; padding:4px 2px;}
.zy-orders-search-clear:hover{color:var(--text);}
.zy-orders-sort-label{font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--steel); font-weight:700; flex:none;}
.zy-orders-sort-label select{display:block; margin-top:6px; padding:9px 8px; font-size:12px; border:1px solid var(--line); border-radius:var(--r-md); background:var(--surface); color:var(--text);}
.zy-order-row{border:1px solid var(--line); border-radius:var(--r-md); padding:14px 16px; margin-bottom:10px; display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;}
.zy-order-row-info b{font-size:13px;}
.zy-order-row-info span{display:block; font-size:11px; color:var(--steel); margin-top:2px;}
.zy-order-verify-btn{background:var(--up); color:#fff; border:none; border-radius:var(--r-md); padding:8px 14px; font-size:12px; font-weight:700; white-space:nowrap;}
.zy-order-status-select{width:100%; margin-top:4px; padding:6px 8px; font-size:12px; border:1px solid var(--line); border-radius:var(--r-md); background:var(--surface); color:var(--text);}
.zy-order-verify-btn:disabled{background:transparent; color:var(--up); border:1px solid var(--up); cursor:default;}
.zy-chart-card{border:1px solid var(--line); border-radius:var(--r-md); padding:16px 18px; background:var(--surface-dim);}
.zy-chart-card h5{margin:0 0 12px; font-size:12px; text-transform:uppercase; letter-spacing:.03em; color:var(--steel);}
.zy-chart-wide{grid-column:1 / -1;}
@media (max-width:720px){ .zy-charts-grid{grid-template-columns:1fr;} }
.zy-text-group{margin-top:18px;}
.zy-text-group h6{font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:var(--signal); font-weight:800; margin-bottom:8px;}
.zy-text-field{margin-bottom:12px;}
.zy-text-field label{display:block; font-size:11px; color:var(--steel); margin-bottom:4px;}
.zy-text-field textarea{width:100%; background:var(--surface-dim); border:1px solid var(--line); border-radius:var(--r-md); padding:8px 10px; font-size:13px; color:var(--text); min-height:44px; font-family:inherit;}
.zy-text-field .zy-text-actions{display:flex; gap:8px; margin-top:4px;}
.zy-text-field .zy-text-actions button{font-size:11px; padding:4px 10px; border-radius:var(--r-sm); border:1px solid var(--line); background:var(--surface); color:var(--steel);}
.zy-text-field.zy-dirty textarea{border-color:var(--signal);}
[data-zt]{transition:outline .1s;}
body.zy-live-edit [data-zt]{outline:1px dashed var(--signal); outline-offset:2px; cursor:text; border-radius:var(--r-sm);}
body.zy-live-edit [data-zt]:hover{outline:2px solid var(--signal); background:var(--signal-dim);}
body.zy-live-edit [data-zt]:focus{outline:2px solid var(--brass); background:var(--signal-dim);}
.zy-live-bar{position:fixed; left:0; right:0; bottom:0; z-index:200; background:var(--text); color:var(--bg); padding:12px 20px; display:flex; align-items:center; justify-content:center; gap:16px; font-size:12px; font-weight:600; box-shadow:0 -4px 16px rgba(0,0,0,.25);}

/* ---------- COOKIE BANNER ---------- */
.cookie-bar{position:fixed; left:16px; right:16px; bottom:16px; z-index:190; max-width:480px; margin:0 auto;
  background:var(--surface); border:1px solid var(--line); border-radius:var(--r-md); padding:18px 20px; box-shadow:var(--shadow);
  display:none; flex-direction:column; gap:12px;}
.cookie-bar.show{display:flex;}
.cookie-bar p{font-size:12px; line-height:1.5; color:var(--steel);}
.cookie-bar p a{color:var(--signal); font-weight:700;}
.cookie-bar-actions{display:flex; gap:10px;}
.cookie-bar-actions button{flex:1; padding:10px 14px; font-size:12px; font-weight:700; letter-spacing:.03em; text-transform:uppercase; border-radius:var(--r-sm);}
.cookie-btn-accept{background:var(--text); color:var(--bg); border:none;}
/* [NEWSLETTER] Popup de captura de email — mismo lenguaje visual que el
   resto de modales del sitio (overlay + panel centrado). Aparece una sola
   vez por navegador; ver zyInitNewsletterPopup(). */
.nl-overlay{position:fixed; inset:0; background:rgba(0,0,0,.55); z-index:195; display:none;}
.nl-overlay.open{display:block;}
.nl-popup{position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); z-index:196; width:100%; max-width:380px;
  background:var(--surface); border:1px solid var(--line); border-radius:var(--r-md); padding:28px 26px; box-shadow:var(--shadow);
  display:none; text-align:center;}
.nl-popup.open{display:block;}
.nl-popup-close{position:absolute; top:10px; right:10px; width:30px; height:30px; border-radius:50%; background:transparent; border:none; color:var(--steel); font-size:18px; line-height:1; cursor:pointer;}
.nl-popup-close:hover{background:var(--surface-dim);}
.nl-popup h4{font-size:18px; font-weight:800; margin:6px 0 8px; text-transform:uppercase; letter-spacing:-.01em;}
.nl-popup p{font-size:12px; color:var(--steel); line-height:1.5; margin-bottom:18px;}
.nl-popup form{display:flex; flex-direction:column; gap:10px;}
.nl-popup .nl-code{background:var(--surface-dim); border:1px dashed var(--line); border-radius:var(--r-md); padding:10px; font-size:13px; font-weight:700; letter-spacing:.04em;}
.cookie-btn-reject{background:transparent; color:var(--text); border:1px solid var(--line);}
@media(max-width:600px){.cookie-bar{left:10px; right:10px; bottom:10px;}}

.zy-live-bar button{background:var(--signal); color:#fff; border:none; padding:8px 16px; border-radius:var(--r-lg); font-weight:700; font-size:12px;}
@media(max-width:600px){.zy-live-bar{flex-direction:column; gap:8px; text-align:center;}}
.zy-row2{display:grid; grid-template-columns:1fr 1fr; gap:10px;}
@media(max-width:480px){ .zy-row2{grid-template-columns:1fr;} }
.zy-submit{width:100%; margin-top:18px; background:var(--signal); color:#fff; border:none; border-radius:var(--r-sm); padding:13px; font-size:13px; font-weight:700;}
.zy-hint{font-size:11px; color:var(--steel); margin-top:4px; text-transform:none; letter-spacing:0; font-weight:500;}
/* [DESCUENTO-AUTO] Caja que agrupa "Precio original" + "Descuento" del
   formulario de alta/edición de producto, con una vista previa en vivo
   abajo (izquierda = precio final que se cobra, derecha = precio original
   tachado) — el mismo orden que ve el cliente en la tienda. Ver
   zyUpdateDiscountPreview() en el JS. */
.zy-ficha{background:var(--surface-dim); border:1px solid var(--line); border-radius:var(--r-md); padding:14px 14px 16px; margin:18px 0;}
.zy-ficha-title{font-size:14px; font-weight:800; margin-bottom:10px;}
.zy-ficha-title .zy-hint{display:block; margin-top:2px;}

/* [FICHA TÉCNICA] Buscador desplegable de Material y Color */
.zy-combo{position:relative; margin-bottom:14px;}
.zy-combo input{margin-bottom:0 !important; padding-right:34px;}
.zy-combo::after{content:'▾'; position:absolute; right:12px; top:12px; font-size:12px; color:var(--steel); pointer-events:none;}
.zy-combo-list{position:absolute; z-index:60; left:0; right:0; top:calc(100% + 4px); max-height:280px; overflow-y:auto; background:var(--surface); color:var(--text, inherit); border:1px solid var(--line); border-radius:var(--r-sm); box-shadow:0 10px 28px rgba(0,0,0,.22); display:none; -webkit-overflow-scrolling:touch;}
.zy-combo.open .zy-combo-list{display:block;}
.zy-combo-opt{display:flex; align-items:center; gap:10px; padding:9px 12px; font-size:14px; cursor:pointer;}
.zy-combo-opt:hover,.zy-combo-opt.active{background:var(--surface-dim);}
.zy-combo-opt .zy-sw{width:18px; height:18px; border-radius:50%; flex:none; border:1px solid rgba(128,128,128,.55);}
.zy-combo-opt.sel{font-weight:800;}
.zy-combo-empty{padding:10px 12px; font-size:13px; color:var(--steel);}
.zy-combo-count{padding:6px 12px; font-size:11px; color:var(--steel); border-bottom:1px solid var(--line); position:sticky; top:0; background:var(--surface);}
.zy-combo-grp{padding:8px 12px 4px; font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--steel);}
.zy-dim-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:0 10px;}
.zy-unit{position:relative; margin-bottom:14px;}
.zy-unit input{margin-bottom:0 !important; padding-right:40px;}
.zy-unit span{position:absolute; right:12px; top:50%; transform:translateY(-50%); font-size:12px; font-weight:700; color:var(--steel); pointer-events:none;}
.zy-det-grid{display:grid; grid-template-columns:1fr 1fr; gap:0 10px;}
@media(max-width:480px){ .zy-det-grid{grid-template-columns:1fr;} }
.zy-spec-title{font-size:11px; font-weight:800; letter-spacing:.09em; text-transform:uppercase; color:var(--text); margin:16px 0 4px; padding-bottom:6px; border-bottom:2px solid var(--text);}
.zy-spec-title:first-child{margin-top:0;}
.zy-discount-box{background:var(--surface-dim); border:1px solid var(--line); border-radius:var(--r-md); padding:14px 14px 16px; margin:14px 0;}
.zy-discount-box label:first-of-type{margin-top:0;}
.zy-discount-preview{display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-top:12px; padding-top:12px; border-top:1px dashed var(--line);}
.zy-discount-preview-final{font-size:20px; font-weight:800; color:var(--text);}
.zy-discount-preview-old{font-size:14px; color:var(--steel); text-decoration:line-through;}
.zy-discount-preview-badge{background:var(--down); color:#fff; font-size:10px; font-weight:800; letter-spacing:.03em; text-transform:uppercase; padding:3px 8px; border-radius:var(--r-lg);}
.zy-size-grid{margin-bottom:0; grid-template-columns:repeat(6,1fr);}
.zy-size-grid .size-opt{padding:9px 0; font-size:12px; cursor:pointer;}
.zy-cat-chips{display:flex; flex-wrap:wrap; gap:8px;}
.zy-cat-chips .size-opt{padding:8px 14px; font-size:12px; cursor:pointer; width:auto;}
.zy-select-all{font-size:11px; font-weight:700; color:var(--signal); background:none; border:none; margin-left:8px; text-transform:none; letter-spacing:0; padding:0;}
.zy-select-all:hover{text-decoration:underline;}
#zySizeGrid{user-select:none; -webkit-user-select:none; -webkit-touch-callout:none; touch-action:pan-y;}
#zySizeGrid .size-opt{touch-action:pan-y;}
.zy-quickhint{font-size:12px; color:var(--steel); background:var(--surface-dim); border-radius:var(--r-sm); padding:10px 12px; margin-bottom:14px; line-height:1.4;}
.zy-advanced{margin-top:16px; border-top:1px solid var(--line); padding-top:2px;}
.zy-advanced summary{cursor:pointer; font-size:12px; font-weight:700; color:var(--signal); list-style:none; padding:12px 0; user-select:none;}
.zy-advanced summary::-webkit-details-marker{display:none;}
.zy-advanced summary::before{content:'+ ';}
.zy-advanced[open] summary::before{content:'– ';}
.zy-advanced label:first-of-type{margin-top:0;}
.zy-ok-msg{font-size:12px; color:var(--up); margin-top:10px; display:none;}
.zy-ok-msg.show{display:block;}
.zy-thumbs{display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;}
/* [FOTOS Y VIDEOS] Miniaturas ordenables del panel */
.zy-media-thumbs{gap:10px;}
.zy-media-thumbs .zy-thumb{width:86px; height:86px; cursor:grab; touch-action:manipulation; user-select:none; -webkit-user-select:none;}
.zy-media-thumbs .zy-thumb.dragging{opacity:.35;}
.zy-media-thumbs .zy-thumb.drop-target{outline:2px solid var(--signal, #c8102e); outline-offset:2px;}
.zy-media-thumbs .zy-thumb img,.zy-media-thumbs .zy-thumb video{pointer-events:none;}
.zy-thumb-n{position:absolute; top:3px; left:3px; min-width:18px; height:18px; padding:0 5px; line-height:18px; text-align:center; border-radius:9px; background:rgba(0,0,0,.7); color:#fff; font-size:10px; font-weight:800;}
.zy-thumb-v{position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:26px; height:26px; line-height:26px; text-align:center; border-radius:50%; background:rgba(0,0,0,.6); color:#fff; font-size:11px; pointer-events:none;}
.zy-thumb-mv{position:absolute; bottom:3px; width:22px; height:20px; line-height:18px; text-align:center; border-radius:5px; background:rgba(0,0,0,.7); color:#fff; font-size:10px; border:none; cursor:pointer; padding:0;}
.zy-thumb-mv.l{left:3px;} .zy-thumb-mv.r{right:3px;}
.zy-thumb-mv:hover{background:var(--signal, #c8102e);}
.zy-thumb-up{position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px; font-size:11px; color:var(--steel); background:var(--surface-dim); text-align:center; padding:4px;}
.zy-thumb-up i{display:block; width:70%; height:4px; border-radius:2px; background:rgba(128,128,128,.3); overflow:hidden;}
.zy-thumb-up i b{display:block; height:100%; width:0; background:var(--signal, #c8102e); transition:width .2s;}

.zy-thumb{position:relative; width:52px; height:52px; border-radius:var(--r-sm); overflow:hidden; border:1px solid var(--line); background:var(--surface-dim);}
.zy-thumb img, .zy-thumb video{width:100%; height:100%; object-fit:cover;}
.zy-thumb-x{position:absolute; top:2px; right:2px; width:16px; height:16px; line-height:14px; text-align:center; border-radius:50%; background:rgba(0,0,0,.65); color:#fff; font-size:11px; cursor:pointer; border:none; padding:0;}
.zy-thumb-x:hover{background:#c0392b;}
.zy-list{margin-top:10px; max-height:320px; overflow-y:auto; border-top:1px solid var(--line);}
.zy-list-item{display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid var(--line); font-size:12px; flex-wrap:wrap; gap:8px;}
.zy-list-item button{background:none; border:none; color:var(--down); font-size:11px; font-weight:700;}
.zy-list-section-title{display:flex; justify-content:space-between; font-size:11px; text-transform:uppercase; letter-spacing:.05em;
  font-weight:700; color:var(--steel); padding:14px 0 6px; margin-top:4px; border-top:1px solid var(--line);}
.zy-list-section:first-child .zy-list-section-title{border-top:none; margin-top:0; padding-top:0;}
.zy-list-section-title span{font-weight:600; color:var(--text);}

/* [MÓVIL — PANEL PRIVADO] Antes, en pantallas angostas, cada fila de lista
   (categorías, cupones, membresías, etc.) intentaba caber en una sola línea:
   texto/inputs a la izquierda y botones de acción a la derecha, sin
   permiso para pasar a otra línea — así se veía todo encimado y cortado.
   Ahora, por debajo de 640px, cada fila se acomoda en columna: primero la
   info (nombre/foto/cantidad) ocupando todo el ancho, y debajo los botones
   de acción también a todo el ancho, en una cuadrícula de 2 columnas para
   que se puedan tocar cómodamente con el dedo. */
@media(max-width:640px){
  .zy-list-item > span{flex:1 1 100%; min-width:0; justify-content:flex-start !important;}
  .zy-list-item > span[style*="justify-content:flex-end"],
  .zy-cat-actions{justify-content:flex-start !important;}
  .zy-list-item > span[style*="display:flex"] a,
  .zy-list-item > span[style*="display:flex"] button,
  .zy-list-item > span[style*="display:flex"] label{flex:1 1 calc(50% - 6px); text-align:center; padding-top:8px; padding-bottom:8px;}
}

/* [MÓVIL — CATEGORÍAS] Fila de cada categoría del panel: antes era una
   sola línea con imagen + nombre + contador + 6 botones, todo comprimido.
   Ahora separa claramente "info" (arriba) de "acciones" (abajo, en
   cuadrícula) en pantallas angostas. */
.zy-cat-row{display:flex; flex-wrap:wrap; align-items:center; gap:10px; padding:10px 0; border-bottom:1px solid var(--line);}
.zy-cat-info{display:flex; align-items:center; gap:10px; flex:1 1 220px; min-width:0;}
.zy-cat-thumb{width:40px; height:40px; border-radius:var(--r-md); overflow:hidden; flex-shrink:0; background:var(--surface-dim); display:flex; align-items:center; justify-content:center;}
.zy-cat-thumb img{width:100%; height:100%; object-fit:cover;}
.zy-cat-name-input{width:100%; max-width:220px;}
.zy-cat-count{color:var(--steel); font-size:11px; white-space:nowrap;}
.zy-cat-actions{display:flex; gap:6px; flex-wrap:wrap; justify-content:flex-end; flex:1 1 auto;}
@media(max-width:640px){
  .zy-cat-row{flex-direction:column; align-items:stretch;}
  .zy-cat-info{flex:1 1 auto; width:100%;}
  .zy-cat-name-input{max-width:none; flex:1;}
  .zy-cat-actions{width:100%;}
  .zy-cat-actions button, .zy-cat-actions label{flex:1 1 calc(50% - 6px); text-align:center; padding-top:8px; padding-bottom:8px;}
}

/* ---------- FOOTER ---------- */
footer{border-top:1px solid var(--line); margin-top:60px; padding:56px 32px 30px;}
.foot-grid{max-width:1360px; margin:0 auto; display:grid; grid-template-columns:1.4fr repeat(3,1fr); gap:40px; margin-bottom:50px;}
.foot-brand .logo{margin-bottom:14px;}
.foot-brand p{font-size:13px; color:var(--steel); max-width:280px; line-height:1.6;}
.foot-contact{margin-top:16px; font-size:13px;}
.foot-contact a{color:var(--text); font-weight:600; transition:color .15s;}
.foot-contact a:hover{color:var(--signal);}
.foot-email-btn{display:inline-flex; align-items:center; gap:8px; margin-top:16px; padding:11px 20px;
  border:1px solid var(--signal); border-radius:var(--r-lg); font-size:13px; font-weight:700; color:#fff;
  transition:all .15s; background:var(--signal); box-shadow:0 2px 8px rgba(47,95,255,0.25);}
.foot-email-btn:hover{background:var(--text); border-color:var(--text); color:var(--bg); transform:translateY(-1px);}
.foot-email-btn svg{color:#fff;}
.foot-email-btn:hover svg{color:var(--bg);}
.foot-email-btn svg{width:16px; height:16px; flex-shrink:0;}
.foot-social{display:flex; gap:10px; margin-top:16px;}
.foot-social a{width:34px; height:34px; border:1px solid var(--line); border-radius:50%; display:flex; align-items:center; justify-content:center; color:var(--text); transition:all .15s;}
.foot-social a:hover{border-color:var(--signal); color:var(--signal);}
.foot-social svg{width:16px; height:16px;}

/* ---------- AVISO DE DROP EN VIVO (captura de datos en el hero) ---------- */
.drop-notify{margin-top:22px; padding:16px 18px; border:1px solid var(--line); border-radius:var(--r-md); background:var(--surface-dim); max-width:440px;}
.drop-notify-head{display:flex; align-items:center; gap:8px; font-size:13px; font-weight:700; margin-bottom:12px;}
.drop-notify-head svg{width:18px; height:18px; flex-shrink:0; color:var(--signal);}
.drop-notify-form{display:flex; gap:8px; flex-wrap:wrap;}
.drop-notify-form input{flex:1 1 130px; min-width:0; padding:10px 12px; border:1px solid var(--line); border-radius:var(--r-sm);
  background:var(--surface); color:var(--text); font-family:inherit; font-size:13px;}
.drop-notify-form input:focus{outline:none; border-color:var(--signal);}
.drop-notify-form .btn{flex:0 0 auto; padding:10px 18px; font-size:13px;}
.drop-notify-note{margin-top:8px; font-size:11px; color:var(--steel);}
.drop-notify-push-btn{margin-top:10px; width:100%; background:transparent; border:1px dashed var(--line); color:var(--text);
  padding:9px 10px; border-radius:var(--r-md); font-size:11px; font-weight:600; cursor:pointer;}
.drop-notify-push-btn:hover{border-color:var(--signal); color:var(--signal);}
.drop-notify-push-btn:disabled{opacity:.6; cursor:default; border-style:solid; border-color:var(--up); color:var(--up);}
@media(max-width:600px){ .drop-notify{max-width:none;} .drop-notify-form input{flex:1 1 100%;} .drop-notify-form .btn{flex:1 1 100%;} }

/* [WHATSAPP] El botón flotante de WhatsApp que vivía aquí se quitó del
   sitio completo — ahora solo aparece dentro de la sección de Ayuda (ver
   .policy-wa-btn) y dentro del chat ZAYDE Bot. Como ya no ocupa el
   right:20px/bottom:20px de abajo a la derecha, el botón del chatbot
   (.zybot-float, justo abajo) bajó a esa misma posición en vez de quedar
   apilado arriba de él. */

/* ---------- INTERRUPTOR ZAYDE / ZAYDE G (arriba a la izquierda) ----------
   Pastilla de dos segmentos en el encabezado, junto al botón de menú
   móvil, para saltar entre la tienda ZAYDE y ZAYDE G con un solo toque
   (estilo selector de marca tipo app de tienda: segmento de texto activo
   en blanco/superficie + segmento circular con la letra "G"). Los textos
   de cada segmento ("ZAYDE" y "G") son editables desde el panel privado,
   pestaña "ZAYDE G · Página" (ver zySettings.ropagSettings.switchLabelZayde
   / switchLabelG y zyApplyHeaderSwitchLabels()). El estado activo se
   actualiza solo, en cada navigate(), vía zyUpdateHeaderSwitch(). */
.zy-header-switch{display:flex; align-items:center; gap:2px; padding:3px; border-radius:var(--r-pill);
  background:var(--surface-dim); border:1px solid var(--line); flex-shrink:0;}
.zy-hswitch-seg{border:none; background:transparent; cursor:pointer; display:flex; align-items:center;
  justify-content:center; color:var(--steel); font-weight:800; letter-spacing:.02em; transition:background .15s, color .15s;
  height:28px; padding:0 12px; border-radius:var(--r-pill); font-size:11px; text-transform:uppercase; white-space:nowrap;}
.zy-hswitch-seg:hover{color:var(--text);}
.zy-hswitch-seg.active{background:var(--bg); color:var(--text); box-shadow:0 1px 3px rgba(0,0,0,.12);}
.zy-hswitch-seg--circle{width:28px; height:28px; padding:0; flex:none; border-radius:50%; font-size:12px;}
.zy-hswitch-seg--circle.active{background:var(--signal); color:#fff;}
@media(max-width:900px){
  .zy-hswitch-seg:not(.zy-hswitch-seg--circle){padding:0 9px; font-size:10px;}
}
@media(max-width:480px){
  .zy-header-switch{gap:1px; padding:2px;}
  .zy-hswitch-seg:not(.zy-hswitch-seg--circle){padding:0 7px; font-size:10px;}
  .zy-hswitch-seg--circle{width:26px; height:26px;}
}

/* ---------- CHATBOT DE AYUDA (ZAYDE Bot) ----------
   Burbuja flotante abajo a la derecha (right:20px, bottom:20px) — ahora
   sola en ese lugar, ya que el botón flotante de WhatsApp se quitó del
   sitio. [FIX — "se abre solo el chatbot"] Antes se abría sola la
   primera vez que el visitante entraba a cualquier sección de Ayuda
   (Sobre ZAYDE, Guía de tallas, Devoluciones, Verificación, Términos,
   Privacidad), lo cual el cliente reportó como un comportamiento
   inesperado que "pasaba de repente al hacer clic en cualquier cosa".
   Se quitó ese auto-apertura por completo: ahora el chat SOLO se abre
   cuando el visitante toca la burbuja o el botón del chat a propósito. */
.zybot-float{
  position:fixed; right:20px; bottom:20px; z-index:81; width:56px; height:56px; border-radius:50%;
  background:var(--signal); color:#fff; border:none; cursor:pointer;
  display:flex; align-items:center; justify-content:center; box-shadow:0 4px 18px -2px rgba(47,95,255,.45);
  transition:transform .15s ease;
}
.zybot-float:hover{transform:scale(1.07);}
.zybot-float svg{width:26px; height:26px;}
.zybot-float .zybot-float-dot{position:absolute; top:2px; right:2px; width:12px; height:12px; border-radius:50%; background:var(--down); border:2px solid var(--bg); display:none;}
.zybot-float.has-unread .zybot-float-dot{display:block;}
@media(max-width:760px){ .zybot-float{right:14px; bottom:calc(84px + env(safe-area-inset-bottom)); width:50px; height:50px; z-index:210;} .zybot-float svg{width:23px;height:23px;} }
/* [FIX — "el chatbot tapa el subtotal (MXN)"] En celular la burbuja del
   chatbot tiene z-index alto a propósito (para quedar sobre la barra
   inferior), pero eso hacía que también quedara ENCIMA del carrito, el
   checkout y cualquier otro panel — tapando texto como "$2,250 MXN".
   Ahora se oculta sola mientras haya un panel/modal abierto (carrito,
   checkout, zoom de foto, etc. — ver body.zy-panel-open, activado desde
   el mismo lock de scroll que ya detecta esos paneles) y reaparece al
   cerrarlo. Aplica solo en celular: en escritorio el carrito ya queda
   por encima del botón sin este ajuste. */
@media(max-width:760px){ body.zy-panel-open .zybot-float{ display:none; } }

.zybot-panel{
  position:fixed; right:20px; bottom:86px; z-index:220; width:360px; max-width:calc(100vw - 28px);
  height:min(560px, calc(100vh - 190px)); background:var(--surface); border-radius:var(--r-lg); box-shadow:var(--shadow);
  border:1px solid var(--line); display:flex; flex-direction:column; overflow:hidden;
  opacity:0; transform:translateY(16px) scale(.98); pointer-events:none; transition:opacity .18s ease, transform .18s ease;
}
.zybot-panel.open{opacity:1; transform:translateY(0) scale(1); pointer-events:auto;}
@media(max-width:760px){
  .zybot-panel{right:10px; left:10px; width:auto; bottom:calc(96px + env(safe-area-inset-bottom)); height:min(72vh, 560px);}
}
.zybot-head{
  background:var(--signal); color:#fff; padding:13px 14px; display:flex; align-items:center; justify-content:space-between; gap:8px; flex:none;
}
.zybot-head-title{font-size:14px; font-weight:800; letter-spacing:-0.01em;}
.zybot-head-btns{display:flex; align-items:center; gap:4px; position:relative;}
.zybot-head-btn{background:none; border:none; color:#fff; opacity:.85; cursor:pointer; width:28px; height:28px; border-radius:var(--r-md); display:flex; align-items:center; justify-content:center; transition:background .12s, opacity .12s;}
.zybot-head-btn:hover{opacity:1; background:rgba(255,255,255,.12);}
.zybot-head-btn svg{width:18px; height:18px;}
.zybot-login-btn{
  background:#fff; color:var(--signal); border:none; cursor:pointer;
  font-size:12px; font-weight:700; letter-spacing:-0.01em;
  padding:6px 12px; border-radius:var(--r-pill); white-space:nowrap; flex:none;
  transition:opacity .12s, transform .12s;
}
.zybot-login-btn:hover{opacity:.85;}
.zybot-login-btn:active{transform:scale(.96);}
.zybot-menu{position:absolute; top:34px; left:0; background:var(--surface); color:var(--text); border:1px solid var(--line); border-radius:var(--r-md); box-shadow:var(--shadow); min-width:190px; padding:6px; display:none; z-index:5;}
.zybot-menu.open{display:block;}
.zybot-menu button{width:100%; text-align:left; background:none; border:none; color:var(--text); font-size:12px; font-weight:600; padding:9px 10px; border-radius:var(--r-md); cursor:pointer;}
.zybot-menu button:hover{background:var(--surface-dim);}
.zybot-body{flex:1; overflow-y:auto; padding:14px; display:flex; flex-direction:column; gap:10px; background:var(--bg);}
.zybot-sep{text-align:center; font-size:10px; color:var(--steel); font-weight:700; text-transform:uppercase; letter-spacing:.04em; margin:4px 0;}
.zybot-sys{text-align:center; font-size:10px; color:var(--steel);}
.zybot-msg{max-width:86%; padding:10px 12px; border-radius:var(--r-lg); font-size:13px; line-height:1.45;}
.zybot-msg.bot{align-self:flex-start; background:var(--surface); border:1px solid var(--line); border-bottom-left-radius:3px;}
.zybot-msg.user{align-self:flex-end; background:var(--signal); color:#fff; border-bottom-right-radius:3px;}
.zybot-msg-meta{font-size:10px; color:var(--steel); margin-top:3px; align-self:flex-start;}
.zybot-quick{display:flex; flex-direction:column; gap:7px; align-self:stretch;}
.zybot-quick-btn{
  width:100%; text-align:left; background:var(--surface); border:1px solid var(--line); color:var(--signal);
  font-size:12px; font-weight:700; padding:10px 12px; border-radius:var(--r-md); cursor:pointer; transition:border-color .12s, background .12s;
}
.zybot-quick-btn:hover{border-color:var(--signal); background:var(--signal-dim);}
/* [CHATBOT · TALLAS] Las tallas se muestran en cuadrícula compacta (4 por fila) en vez de una lista larga */
.zybot-quick.zybot-quick-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:6px;}
.zybot-quick.zybot-quick-grid .zybot-quick-btn{text-align:center; padding:9px 4px;}
/* ---------- Tarjetas de producto recomendadas dentro del chat (flujo de
   "Guía de tallas" con venta asistida): mini-cards clicables que abren la
   ficha del producto (openPDP), opcionalmente con la talla ya seleccionada
   — ver zyBotShowRecommendations / zyBotMiniCardHTML / zyBotViewProduct. ---------- */
.zybot-cards{display:flex; flex-direction:column; gap:8px; align-self:stretch;}
.zybot-card{display:flex; gap:10px; align-items:stretch; background:var(--surface); border:1px solid var(--line); border-radius:var(--r-md); padding:8px; cursor:pointer; transition:border-color .12s, background .12s;}
.zybot-card:hover{border-color:var(--signal); background:var(--signal-dim);}
.zybot-card-media{flex:none; width:52px; height:52px; border-radius:var(--r-md); overflow:hidden; background:var(--surface-dim); position:relative; display:flex; align-items:center; justify-content:center;}
.zybot-card-ph{width:100%; height:100%; display:flex; align-items:center; justify-content:center; opacity:.35;}
.zybot-card-ph svg{width:22px; height:22px;}
.zybot-card-badge{position:absolute; top:2px; left:2px; background:var(--signal); color:#fff; font-size:10px; font-weight:800; padding:1px 4px; border-radius:var(--r-sm);}
.zybot-card-info{flex:1; min-width:0; display:flex; flex-direction:column; justify-content:center; gap:2px;}
.zybot-card-brand{font-size:10px; color:var(--steel); font-weight:700; text-transform:uppercase; letter-spacing:.02em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.zybot-card-name{font-size:12px; font-weight:700; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;}
.zybot-card-price{font-size:12px; font-weight:800; color:var(--signal);}
.zybot-card-note{font-size:10px; color:var(--steel); font-weight:600; margin-top:1px;}
.zybot-typing{align-self:flex-start; display:flex; gap:4px; padding:11px 13px; background:var(--surface); border:1px solid var(--line); border-radius:var(--r-lg); border-bottom-left-radius:3px;}
.zybot-typing span{width:6px; height:6px; border-radius:50%; background:var(--steel); animation:zybotTyping 1.1s infinite ease-in-out;}
.zybot-typing span:nth-child(2){animation-delay:.15s;} .zybot-typing span:nth-child(3){animation-delay:.3s;}
@keyframes zybotTyping{0%,60%,100%{opacity:.3; transform:translateY(0);} 30%{opacity:1; transform:translateY(-2px);}}
.zybot-foot{flex:none; display:flex; align-items:center; gap:8px; padding:10px 12px; border-top:1px solid var(--line); background:var(--surface);}
.zybot-foot input{flex:1; border:1px solid var(--line); background:var(--surface-dim); border-radius:var(--r-pill); padding:9px 14px; font-size:12px; color:var(--text); font-family:inherit;}
.zybot-foot input:focus{outline:none; border-color:var(--signal);}
.zybot-send{flex:none; width:32px; height:32px; border-radius:50%; background:var(--signal); border:none; color:#fff; display:flex; align-items:center; justify-content:center; cursor:pointer;}
.zybot-send svg{width:15px; height:15px;}
.zybot-ended{padding:14px; text-align:center; font-size:12px; color:var(--steel); border-top:1px solid var(--line); background:var(--surface);}
.zybot-ended button{margin-top:8px; background:var(--signal); color:#fff; border:none; border-radius:var(--r-md); padding:8px 16px; font-size:12px; font-weight:700; cursor:pointer;}

/* ---------- BOTÓN Y HOJA DE COMPARTIR PRODUCTO ---------- */
.card-share{position:absolute; top:10px; right:46px; z-index:15; width:28px; height:28px; border-radius:50%; background:var(--surface); pointer-events:auto;
  display:flex; align-items:center; justify-content:center; border:1px solid var(--line); color:var(--text);
  transition:background .15s, border-color .15s, transform .1s; box-shadow:var(--shadow);}
.card-share:hover{border-color:var(--signal); color:var(--signal); transform:scale(1.06);}
.card-share svg{width:14px; height:14px;}
@media(max-width:760px){ .card-share{width:34px; height:34px; right:50px;} }
.share-sheet-overlay{position:fixed; inset:0; background:rgba(14,14,16,0.5); z-index:198; opacity:0; pointer-events:none; transition:opacity .2s;}
.share-sheet-overlay.open{opacity:1; pointer-events:auto;}
.share-sheet{position:fixed; left:50%; bottom:0; transform:translate(-50%,100%); width:100%; max-width:420px;
  background:var(--surface); border-radius:14px 14px 0 0; z-index:199; padding:20px; box-shadow:var(--shadow); transition:transform .25s ease;}
.share-sheet.open{transform:translate(-50%,0);}
@media(min-width:640px){
  .share-sheet{bottom:auto; top:50%; transform:translate(-50%,-46%); border-radius:var(--r-lg); opacity:0; pointer-events:none; transition:opacity .2s, transform .2s;}
  .share-sheet.open{transform:translate(-50%,-50%); opacity:1; pointer-events:auto;}
}
.share-sheet h4{font-size:14px; font-weight:700; margin-bottom:14px;}
.share-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:10px;}
.share-opt{display:flex; flex-direction:column; align-items:center; gap:8px; padding:10px 4px; border-radius:var(--r-md); font-size:11px; font-weight:600; text-align:center; color:var(--text); transition:background .15s;}
.share-opt:hover{background:var(--surface-dim);}
.share-opt .share-ico{width:44px; height:44px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff;}
.share-opt .share-ico svg{width:20px; height:20px;}
.share-opt.copy .share-ico{background:var(--steel);}
.share-opt.wa .share-ico{background:#25D366;}
.share-opt.wab .share-ico{background:#075E54; position:relative;}
.share-opt.wab .share-ico .wab-badge{position:absolute; bottom:-3px; right:-3px; width:15px; height:15px; background:#fff; border-radius:var(--r-sm); padding:1px; color:#075E54;}
.share-opt.fb .share-ico{background:#1877F2;}
.share-opt.tw .share-ico{background:#000;}
.share-opt.tg .share-ico{background:#26A5E4;}
.share-opt.mail .share-ico{background:var(--signal);}
.share-sheet-close{position:absolute; top:14px; right:14px; width:28px; height:28px; display:flex; align-items:center; justify-content:center; color:var(--steel);}
.share-sheet-close svg{width:16px; height:16px;}
.foot-col h6{font-size:12px; text-transform:uppercase; letter-spacing:.06em; margin-bottom:16px; font-weight:700;}
.foot-col a{display:block; font-size:13px; color:var(--steel); margin-bottom:10px;}
.foot-col a:hover{color:var(--text);}
/* [CONVERSIÓN] Métodos de pago aceptados (carrito, checkout y footer). Solo se listan
   los que el checkout realmente cobra hoy: tarjeta vía Stripe. */
.zy-pay-badges{display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin:12px 0 0;}
.zy-pay-badges.zy-pay-center{justify-content:center;}
.zy-pay-chip{display:inline-flex; align-items:center; gap:5px; height:24px; padding:0 9px; border:1px solid var(--line); border-radius:6px;
  background:var(--surface); color:var(--steel); font-size:10.5px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; line-height:1;}
.zy-pay-chip svg{width:11px; height:11px; flex-shrink:0;}
.foot-brand .zy-pay-badges{margin-top:16px;}
.ck-h + .zy-pay-badges{margin:0 0 14px;}
.foot-bottom{max-width:1360px; margin:0 auto; padding-top:24px; border-top:1px solid var(--line); display:flex; justify-content:space-between;
  font-size:12px; color:var(--steel); flex-wrap:wrap; gap:10px;}

/* ---------- SELECTOR DE IDIOMA Y MONEDA (pie de página) ---------- */
.foot-region{max-width:1360px; margin:0 auto 28px; padding-top:28px; border-top:1px solid var(--line);
  display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:16px;}
.foot-region-label{font-size:11px; text-transform:uppercase; letter-spacing:.06em; font-weight:700; color:var(--steel);}
.foot-region-controls{display:flex; align-items:center; gap:10px; flex-wrap:wrap;}
.region-select{display:flex; align-items:center; gap:8px; background:var(--surface-dim); border:1px solid var(--line);
  border-radius:var(--r-lg); padding:8px 14px;}
.region-select svg{width:14px; height:14px; color:var(--steel); flex-shrink:0;}
.region-select select{appearance:none; -webkit-appearance:none; background:none; border:none; color:var(--text);
  font-family:var(--font-body); font-size:12px; font-weight:600; cursor:pointer; padding-right:14px;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%237C7E88' stroke-width='2'><path d='M6 9l6 6 6-6'/></svg>");
  background-repeat:no-repeat; background-position:right center; background-size:13px;}
.region-select select:focus{outline:none;}
.region-note{font-size:11px; color:var(--steel); flex-basis:100%; line-height:1.6; margin-top:2px;}
@media(max-width:760px){
  .foot-region{flex-direction:column; align-items:flex-start;}
}

/* ---------- MODAL DE POLÍTICAS (Devoluciones / Verificación / Términos) ---------- */
.policy-panel{background:var(--surface); border-radius:var(--r-md); width:640px; max-width:92vw; max-height:86vh; overflow-y:auto;
  transform:translateY(14px); box-shadow:var(--shadow); padding:0;}
.checkout-modal.open .policy-panel{transform:translateY(0);}
.policy-head{position:sticky; top:0; background:var(--surface); z-index:2; padding:22px 26px 0;
  border-bottom:1px solid var(--line);}
.policy-title-row{display:flex; align-items:center; gap:10px; margin-bottom:16px;}
.policy-title-row h3{flex:1; font-size:18px; font-weight:800; letter-spacing:-.01em;}
/* [WHATSAPP] Botón de contacto, único en todo el sitio: vive solo dentro
   de la sección de Ayuda (este modal), no como flotante global. */
.policy-wa-btn{flex:none; display:flex; align-items:center; gap:6px; padding:7px 12px; border-radius:var(--r-pill);
  background:#25D366; color:#fff; font-size:12px; font-weight:700; white-space:nowrap;}
.policy-wa-btn:hover{filter:brightness(1.05);}
@media(max-width:480px){ .policy-wa-btn span{display:none;} .policy-wa-btn{padding:8px;} }
.policy-close{flex:none; background:none; border:none; color:var(--steel); padding:4px;}
.policy-close svg{width:20px; height:20px;}
/* [FIX-POLICY-TABS-OVERFLOW] Son 7 pestañas (Sobre ZAYDE, Guía de tallas,
   Devoluciones, Verificación, FAQ, Términos, Privacidad) puestas en una sola
   fila sin overflow ni wrap. En escritorio caben porque el panel mide 640px,
   pero en celular el panel es "max-width:92vw" (≈360px en un iPhone estándar)
   y las 7 pestañas no caben ni de cerca: las últimas quedaban invisibles,
   recortadas por el overflow-x:hidden del <body>, sin ninguna forma de
   deslizar para alcanzarlas. Ahora la fila es un carrusel horizontal propio
   (con scrollbar oculta, como el resto del sitio) y cada pestaña no se
   encoge, así siempre se puede llegar a todas deslizando con el dedo. */
.policy-tabs{display:flex; gap:4px; overflow-x:auto; -webkit-overflow-scrolling:touch; scrollbar-width:none; padding-bottom:1px;}
.policy-tabs::-webkit-scrollbar{display:none;}
.policy-tab{background:none; border:none; padding:10px 4px 12px; margin-right:22px; font-size:12px; font-weight:700;
  color:var(--steel); border-bottom:2px solid transparent; letter-spacing:.01em; flex:none; white-space:nowrap;}
.policy-tab.active{color:var(--text); border-bottom-color:var(--signal);}
@media(max-width:480px){
  .policy-tab{margin-right:16px; padding:9px 2px 11px; font-size:12px;}
}
.policy-body{padding:24px 26px 30px; font-size:13px; line-height:1.75; color:var(--text);}
.policy-body h4{font-size:13px; text-transform:uppercase; letter-spacing:.04em; font-weight:700; margin:22px 0 8px;
  color:var(--steel);}
.policy-body h4:first-child{margin-top:0;}
.policy-body p{margin-bottom:10px; color:var(--text);}
.policy-body ul{margin:0 0 10px 18px;}
.policy-body li{margin-bottom:6px;}
/* ---- [GUÍA DE TALLAS] tablas de conversión (Ropa / Zapatos) ---- */
.size-table-wrap{overflow-x:auto; margin:2px 0 16px; border:1px solid var(--line); border-radius:var(--r-md);}
.size-table{width:100%; border-collapse:collapse; font-size:12px; white-space:nowrap;}
.size-table th, .size-table td{padding:8px 12px; text-align:center; border-bottom:1px solid var(--line);}
.size-table thead th{background:var(--surface-dim); font-weight:800; text-transform:uppercase; font-size:10px; letter-spacing:.04em; color:var(--steel);}
.size-table tbody tr:last-child td{border-bottom:none;}
.size-table tbody tr:hover{background:var(--surface-dim);}
.size-table td:first-child, .size-table th:first-child{font-weight:700; color:var(--text);}
.size-subhead{margin:16px 0 6px; font-size:12px; font-weight:800; letter-spacing:.04em; text-transform:uppercase; color:var(--steel);}
/* Resalte breve al llegar desde el botón "Guía de tallas" del PDP, para que
   sea obvio a qué sección se hizo scroll dentro del modal. */
.size-guide-flash{animation:zySizeGuideFlash 1.6s ease;}
@keyframes zySizeGuideFlash{
  0%{background:var(--signal-dim);}
  100%{background:transparent;}
}
/* ---- [GORRAS] imágenes compartidas por tipo (Cerrada / Ajustable) y guía de tallas con imagen ---- */
.zy-cap-slot{display:flex; gap:12px; align-items:center; margin:0 0 12px; padding:10px; border:1px solid var(--line); border-radius:var(--r-md); background:var(--surface-dim);}
.zy-cap-thumb{width:76px; height:76px; flex:none; border-radius:var(--r-md); border:1px dashed var(--line); background:var(--bg); display:flex; align-items:center; justify-content:center; overflow:hidden; font-size:10px; color:var(--steel); text-align:center; padding:2px;}
.zy-cap-thumb img{width:100%; height:100%; object-fit:contain; display:block;}
.zy-cap-slot-info{flex:1; min-width:0;}
.zy-cap-slot-info b{display:block; font-size:12px; margin-bottom:6px;}
.zy-cap-slot-actions{display:flex; gap:10px; flex-wrap:wrap; align-items:center;}
.zy-cap-slot-info .zy-hint{margin:6px 0 0;}
.pdp-gorra-pic{margin:6px 0 0; padding-bottom:4px;}
.pdp-gorra-pic img, .size-guide-img img{display:block; width:100%; height:auto; border-radius:var(--r-md); border:1px solid var(--line);}
.size-guide-img{margin:2px 0 16px;}
.policy-lead{font-size:14px; color:var(--text); margin-bottom:18px; padding-bottom:18px; border-bottom:1px solid var(--line);}
.policy-badge-row{display:flex; gap:10px; margin:16px 0 20px; flex-wrap:wrap;}
.policy-badge{display:flex; align-items:center; gap:8px; background:var(--surface-dim); border:1px solid var(--line);
  border-radius:var(--r-md); padding:10px 14px; font-size:12px; font-weight:700; flex:1 1 160px;}
.policy-badge svg{width:16px; height:16px; color:var(--signal); flex-shrink:0;}
.policy-steps{counter-reset:pstep; margin:0 0 10px;}
.policy-step{counter-increment:pstep; position:relative; padding-left:30px; margin-bottom:14px;}
.policy-step::before{content:counter(pstep); position:absolute; left:0; top:0; width:20px; height:20px; border-radius:50%;
  background:var(--signal); color:#fff; font-size:11px; font-weight:700; display:flex; align-items:center; justify-content:center;}
.policy-step b{display:block; font-size:13px; margin-bottom:2px;}
.faq-item{border:1px solid var(--line); border-radius:var(--r-md); margin-bottom:8px; overflow:hidden;}
.faq-item summary{padding:13px 15px; font-size:13px; font-weight:600; cursor:pointer; list-style:none; display:flex; align-items:center; justify-content:space-between; gap:10px;}
.faq-item summary::-webkit-details-marker{display:none;}
.faq-item summary::after{content:'+'; font-size:18px; font-weight:400; color:var(--steel); flex-shrink:0;}
.faq-item[open] summary::after{content:'–';}
.faq-item[open] summary{border-bottom:1px solid var(--line);}
.faq-item p{padding:12px 15px; font-size:13px; line-height:1.6; color:var(--steel); margin:0;}
.faq-empty-hint{font-size:12px; color:var(--steel); padding:6px 2px;}
@media(max-width:560px){
  .policy-panel{width:100%; max-width:100vw; border-radius:0; max-height:100vh;}
  #policyModal{padding:0;}
}

/* responsive */
/* filtro móvil (botón + panel colapsable) */
.filter-toggle-btn{display:none; align-items:center; gap:6px; background:var(--surface-dim); border:1px solid var(--line); border-radius:var(--radius);
  padding:12px 16px; font-size:13px; font-weight:700; color:var(--text); height:40px; box-sizing:border-box; cursor:pointer; transition:border-color .18s ease;}
.filter-toggle-btn:hover{border-color:var(--steel);}
.filter-toggle-btn svg{width:15px; height:15px; flex-shrink:0;}
.header-icon-desktop{display:inline-flex;}

@media(max-width:1180px){
  .nav-links-row{display:none;}
  .mobile-menu-btn{display:flex;}
}
@media(max-width:1000px){
  .grid{grid-template-columns:repeat(2,1fr);}
  /* [FIX "ZAYDE G se ve de dos en dos"] La regla ".grid{2 columnas}" de
     arriba es para los carruseles chicos del inicio (En tendencia, Recién
     llegados) donde 2 columnas está bien porque son pocas piezas curadas.
     Pero "Explorar catálogo" de ZAYDE G (#zgCatalogGrid) usa esa misma
     clase ".grid" y es un listado completo — igual que el catálogo
     principal, ahí sí se espera ver una hilera más llena en vez de solo
     pares. Se le da su propia cantidad de columnas, igual que ya tiene
     .catalog-grid (3 aquí, 2 solo en celular chico más abajo). */
  #zgCatalogGrid{grid-template-columns:repeat(3,1fr);}
  .trust{flex-wrap:wrap;} .trust-item{flex:1 1 50%; border-bottom:1px solid var(--line);}
  .catalog-body{grid-template-columns:1fr;} .filters{border-right:none; border-bottom:1px solid var(--line); padding-bottom:20px;}
  .catalog-grid{grid-template-columns:repeat(2,1fr);} .pdp-grid{grid-template-columns:1fr;}
  .upcoming-row{grid-template-columns:1fr;} .foot-grid{grid-template-columns:1fr 1fr;}
}
@media(max-width:560px){
  .grid{grid-template-columns:repeat(2,1fr); gap:14px;} .catalog-grid{grid-template-columns:repeat(2,1fr); gap:14px;}
  /* [FIX "se ven muy chicos los botones de Explorar catálogo en ZAYDE G"]
     #zgCatalogGrid tenía su propia regla a 3 columnas (ver arriba, a partir
     de 1000px) que por ser un ID pesa más que ".grid{2 columnas}" de esta
     misma sección — así que en celular chico (donde ya caben apenas ~115px
     por columna) se quedaba en 3 columnas angostas en vez de bajar a 2 como
     el resto del catálogo. Se agrega aquí, al final de la cascada, para que
     en pantallas de celular gane 2 columnas como toda la demás cuadrícula. */
  #zgCatalogGrid{grid-template-columns:repeat(2,1fr); gap:14px;}
  .wrap,.section,.catalog-head,.catalog-body,.pdp,.search-page-body{padding-left:16px; padding-right:16px;}
  .size-grid{grid-template-columns:repeat(4,1fr);} .foot-grid{grid-template-columns:1fr;}
}
/* ============================================================
   [FIX] "Los productos salen de 2 en 2 y hacen más largo el scroll" —
   en el cel, las secciones curadas del inicio (En tendencia/Más
   vendidos, Recién llegados, Visto recientemente) y sus equivalentes en
   ZAYDE G se acomodaban en una cuadrícula de 2 columnas que crecía hacia
   abajo sin límite. Ahora, igual que StockX/Nike, cada sección se
   muestra en UNA sola hilera horizontal que se recorre deslizando el
   dedo — las 6 piezas de la sección caben ahí, sin alargar el scroll
   vertical de la página. La cuadrícula normal (catálogo completo,
   "Elige tu línea", mayoreo, explorar ZAYDE G) NO se toca: sigue en
   columnas, porque ahí sí se espera ver/recorrer todo el listado.
   ============================================================ */
@media(max-width:760px){
  #homeTabPanelTrending.active, #homeTabPanelBestsellers.active,
  #zgHomeTabPanelTrending.active, #zgHomeTabPanelBestsellers.active,
  #grid-new, #zgNewGrid,
  #grid-recently-viewed, #zgGridRecentlyViewed,
  #pdpRelated{
    display:flex;
    grid-template-columns:none;
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
    scroll-snap-type:x mandatory;
    gap:12px;
    padding-bottom:6px;
    scrollbar-width:none;
  }
  #homeTabPanelTrending::-webkit-scrollbar, #homeTabPanelBestsellers::-webkit-scrollbar,
  #zgHomeTabPanelTrending::-webkit-scrollbar, #zgHomeTabPanelBestsellers::-webkit-scrollbar,
  #grid-new::-webkit-scrollbar, #zgNewGrid::-webkit-scrollbar,
  #grid-recently-viewed::-webkit-scrollbar, #zgGridRecentlyViewed::-webkit-scrollbar,
  #pdpRelated::-webkit-scrollbar{ display:none; }
  #homeTabPanelTrending .card, #homeTabPanelBestsellers .card,
  #zgHomeTabPanelTrending .card, #zgHomeTabPanelBestsellers .card,
  #grid-new .card, #zgNewGrid .card,
  #grid-recently-viewed .card, #zgGridRecentlyViewed .card,
  #pdpRelated .card{
    flex:0 0 44%;
    scroll-snap-align:start;
  }
}
@media(max-width:760px){
  nav.main{gap:10px; padding:12px 16px;}
  .header-searchbox{display:none;}
  /* [FIX "elimina la lupa de arriba en el cel"] Antes esta regla mostraba
     el botón de lupa (.mobile-search-btn) en el header móvil; ahora se
     quita de ahí porque la pestaña "Explorar" de la barra inferior ya abre
     la búsqueda. El interruptor de tema se quitó del encabezado por pedido
     del cliente y ahora solo vive en Perfil → Preferencias (ver
     zyToggleThemeFromProfile en el JS). */
  .mobile-search-btn{display:none !important;}
  .navicons{gap:10px;}
  .nav-left-icons{gap:8px;}
  /* [PEDIDO CLIENTE] La línea fija de promociones (barra negra arriba de
     todo, ver .marquee-bar) se quita solo en celular; en computadora/tablet
     se conserva igual que antes. */
  .marquee-bar{display:none !important;}
  /* la barra inferior ya da acceso a cuenta/carrito: se ocultan del header para look de app */
  .header-icon-desktop{display:none !important;}

  /* [PANDORA-HERO] En celular el video/foto sigue ocupando toda la
     pantalla (100dvh, ver .hero--pandora), solo se ajusta un poco el
     mínimo para que quepa bien en pantallas chicas con barra de
     direcciones del navegador. */
  .hero.hero--pandora{min-height:520px;}
  .trust{margin-top:32px;}
  .trust-item{padding:16px;}
  .section{padding:48px 16px;}
  .section-head{margin-bottom:20px;}

  /* tarjetas de producto: más cómodas al tacto */
  .card-name{font-size:12px; min-height:2.6em;}
  .card-brand{font-size:14px;}
  .card-price{font-size:16px;}
  .card-fav{width:32px; height:32px;}

  /* estilo app de marketplace en celular: foto a color sobre fondo blanco,
     etiqueta "Precio ZAYDE" y sello "Envío Xpress" bajo el precio.
     [Punto 5 — auditoría] Antes decía "Oferta Más Baja" (calco de
     "Lowest Ask" de StockX), que implica un mercado de pujas P2P que
     ZAYDE no tiene — ZAYDE vende de inventario propio a precio fijo, no
     hay "ofertas" que competir ni negociar. "Precio ZAYDE" comunica lo
     mismo (un precio, claro) sin prometer algo que el negocio no ofrece. */
  .card-media{background:#fff;}
  .card-media img{filter:none;}
  .card:hover .card-media img{transform:none;}
  .card-offer-label{display:block;}
  .card-shipping{display:inline-flex;}

  /* [SUSTITUIDO] La regla de scroll horizontal para "Más vendidos",
     "Recién llegados" y "Tendencias" que vivía aquí (solo en celular) se
     unificó en una sola regla global (#grid-trending, #grid-bestsellers,
     etc., ver el <style> del home) que aplica en todos los tamaños de
     pantalla y también cubre "Visto recientemente" y ambas secciones de
     ZAYDE G — así no hay dos reglas distintas haciendo lo mismo. */

  /* filtros de catálogo colapsables */
  .filter-toggle-btn{display:flex;}
  .catalog-titlebar h1{font-size:24px;}
  .filters{display:none; background:var(--surface); border:1px solid var(--line); border-radius:var(--r-md); padding:18px; margin-bottom:8px;}
  .filters.open{display:block;}
  .catalog-grid{grid-template-columns:repeat(2,1fr); gap:12px;}

  /* botones y tallas: objetivos táctiles ≥44px */
  .btn{padding:16px 24px; font-size:13px;}
  .size-opt{padding:14px 0; font-size:13px;}
  .chip{padding:10px 0; width:48px;}



  /* checkout / login modals a pantalla completa en celular, como una app */
  .checkout-panel, .login-panel{width:100%; max-width:100vw; border-radius:0; max-height:100vh; max-height:100dvh;}
  .checkout-modal{padding:0;}
  /* [FIX — "ENVÍO Y PAGO no se ve completo hasta arriba"] En pantalla
     completa, el título vivía pegado al borde superior sin contar el
     notch/status bar del celular (ni la barra de direcciones del
     navegador), así que quedaba tapado. Ahora respeta el área segura
     arriba y queda fijo (sticky) mientras se hace scroll del formulario,
     para que siempre esté completamente visible. */
  .checkout-panel .cart-head, .login-panel .cart-head{
    padding-top:calc(18px + env(safe-area-inset-top));
    position:sticky; top:0; z-index:2; background:var(--surface);
  }
}
@media (prefers-reduced-motion: reduce){
  *{animation-duration:0.001ms !important; transition-duration:0.001ms !important;}
}

/* [CLUB OCULTO] ZAYDE Club / membresías no se ven hasta activarlo en Panel > Membresías */
html:not(.zy-club-on) .zy-club-ui{display:none !important;}

/* ---------- MOBILE BOTTOM TAB BAR (estilo app, tipo Nike/StockX) ----------
   [NAV-FLOTANTE] Antes era una barra plana pegada de borde a borde, como
   una toolbar de navegador. Ahora flota con margen a los lados y esquinas
   redondeadas — el mismo lenguaje visual que usan las apps de Nike/Jordan
   para su barra inferior — y queda apoyada sobre una sombra suave en vez
   de solo un borde superior. */
.mobile-tabbar{
  display:none; position:fixed; left:10px; right:10px; bottom:calc(10px + env(safe-area-inset-bottom)); z-index:120;
  background:var(--surface); border:1px solid var(--line); border-radius:var(--r-pill);
  padding:8px 4px;
  box-shadow:0 10px 28px rgba(0,0,0,0.14);
}
[data-theme="dark"] .mobile-tabbar{ box-shadow:0 10px 28px rgba(0,0,0,0.55); }
.mobile-tabbar-inner{display:flex; align-items:center; justify-content:space-around;}
.tab-btn{
  position:relative; display:flex; flex-direction:column; align-items:center; gap:3px;
  background:none; border:none; color:var(--steel); padding:6px 4px; font-size:10px; font-weight:600;
  letter-spacing:.01em; flex:1; min-width:0; white-space:nowrap; border-radius:var(--r-pill); transition:background .15s ease, color .15s ease;
}
.tab-btn svg{width:20px; height:20px;}
@media(max-width:360px){
  .tab-btn{font-size:10px;}
  .tab-btn svg{width:19px; height:19px;}
}
/* [SIN BRILLO] El botón activo solo cambia de color (a azul de marca):
   sin luz, sin sombra y sin haz de luz sobre la barra. */
.tab-btn.active{color:var(--signal); background:none;}
.tab-btn .tab-dot{position:absolute; top:2px; right:calc(50% - 16px); width:6px; height:6px; border-radius:50%; background:var(--signal);}
.tab-btn .tab-badge{position:absolute; top:0; right:calc(50% - 18px); background:var(--signal); color:#fff; font-size:10px; font-weight:700;
  min-width:15px; height:15px; border-radius:var(--r-md); display:flex; align-items:center; justify-content:center; padding:0 3px;}
@media(max-width:760px){
  .mobile-tabbar{display:block;}
  body{padding-bottom:86px;}
  /* [FIX — "no se ven los botones de pausa/sonido en celular"] La causa real
     no era falta de aire: la barra flotante de navegación inferior
     (.mobile-tabbar, position:fixed, z-index:120) se dibuja literalmente
     ENCIMA del hero de Inicio (que ocupa toda la pantalla), tapando por
     completo la fila de controles de video (comprar + pausa/mute) que vive
     pegada al borde de abajo del hero — por eso en el celular esos botones
     no se alcanzaban a ver ni un poco. Aquí se le da a esa fila un padding
     inferior extra (del tamaño de la tabbar: ~62px de alto + 10px de
     separación del borde + su propio safe-area, más un respiro) para que
     quede siempre POR ENCIMA de la tabbar flotante, nunca tapada por ella.
     Este ajuste manda sobre el padding-bottom más chico del media query de
     abajo (max-width:640px) porque aparece después en el CSS. */
  .hero-bottom{padding-bottom:calc(96px + env(safe-area-inset-bottom));}
}

/* ============================================================
   [MARQUEE] Barra de anuncios — antes era una cinta con scroll continuo
   (texto en movimiento sin parar); ahora muestra un solo mensaje a la vez,
   centrado, con transición suave entre uno y otro (conserva el "movimiento"
   pero limpio, sin efecto de letrero corrido) y flechas a los lados para
   pasar manualmente. Toda la línea es un botón real (100% clickeable), no
   solo la palabra subrayada. Ver zyRenderMarquee()/zyMarqueeNext()/
   zyMarqueePrev() en el JS.
   ============================================================ */
.marquee-bar{
  background:var(--surface-dim); color:var(--text); position:relative;
  border-bottom:1px solid var(--line);
  display:flex; align-items:stretch; justify-content:center; gap:2px;
  max-height:0; opacity:0; overflow:hidden; transition:max-height .25s ease, opacity .25s ease;
}
.marquee-bar.is-ready{ max-height:60px; opacity:1; overflow:visible; }
/* [FIX-HERO-OVERLAP] Mientras el header flota transparente encima del
   video/foto de pantalla completa del inicio (.header-overlay activo —
   ver updateHeaderOverlay() en el JS), esta franja de anuncios se oculta
   por completo. Antes se quedaba fija arriba del todo mientras el header
   AHORA está en position:absolute (para flotar sobre el video) también
   arriba del todo — los dos peleaban por el mismo espacio y se veían
   encimados (texto de la franja cruzado con el logo/buscador del header),
   y esa altura extra de la franja empujaba el fondo del hero (donde
   viven los botones de play/pausa y mute) fuera de la pantalla, cortados.
   Al ocultarla justo en ese momento, el video ocupa toda la pantalla sin
   nada más peleando por ese espacio — igual que en pandora.net. En
   cuanto se hace scroll (o se sale del inicio) vuelve a aparecer normal. */
.marquee-bar.zy-hide-on-hero{ max-height:0 !important; opacity:0 !important; overflow:hidden !important; border-bottom-color:transparent; }
[data-theme="dark"] .marquee-bar{ background:var(--surface); color:var(--text); }
.marquee-nav{
  flex:none; width:40px; display:flex; align-items:center; justify-content:center;
  background:none; border:none; color:var(--steel); cursor:pointer; padding:0;
  transition:color .15s ease;
}
.marquee-nav:hover{ color:var(--text); }
.marquee-nav svg{width:15px; height:15px;}
.marquee-track{
  flex:1; min-width:0; position:relative; height:42px; overflow:hidden;
}
.marquee-item{
  position:absolute; inset:0; display:flex; align-items:center; justify-content:center; gap:6px;
  padding:0 12px; font-size:12px; font-weight:500; letter-spacing:0; text-transform:none;
  cursor:pointer; background:none; border:none; color:inherit; font-family:inherit;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:100%;
  opacity:0; transform:translateY(6px); transition:opacity .35s ease, transform .35s ease;
  pointer-events:none;
}
.marquee-item.active{ opacity:1; transform:translateY(0); pointer-events:auto; }
.marquee-item-link{ text-decoration:underline; text-underline-offset:2px; font-weight:700; }
.marquee-item .dot{ display:none; }
@media(prefers-reduced-motion: reduce){ .marquee-item{ transition:none; } }
@media(max-width:520px){
  .marquee-item{ font-size:11px; padding:0 4px; }
  .marquee-nav{ width:32px; }
}

/* ============================================================
   [HOME TABS] Selector tipo píldora "En tendencia | Más vendidos"
   ============================================================ */
.home-tab-switch{display:inline-flex; padding:4px; background:var(--surface-dim); border-radius:var(--r-pill); gap:2px; margin-top:2px;}
.home-tab-btn{
  border:none; background:none; padding:9px 18px; border-radius:var(--r-pill); font-size:12px; font-weight:700;
  letter-spacing:.02em; color:var(--steel); cursor:pointer; transition:background .2s ease, color .2s ease;
}
.home-tab-btn.active{background:var(--text); color:var(--bg);}
.home-tab-panel{display:none;}
.home-tab-panel.active{display:grid;}

/* ============================================================
   [FAVORITOS] Encabezado personalizado tipo "board" privado
   ============================================================ */
.fav-hero{
  position:relative; overflow:hidden; border-radius:var(--r-lg); padding:32px 28px;
  background:linear-gradient(135deg, var(--surface) 0%, var(--surface-dim) 100%);
  border:1px solid var(--line); margin:8px 0 28px; display:flex; align-items:center;
  justify-content:space-between; gap:24px; flex-wrap:wrap;
}
.fav-hero::before{
  content:''; position:absolute; top:-60%; right:-10%; width:280px; height:280px; border-radius:50%;
  background:radial-gradient(circle, var(--signal-dim) 0%, transparent 70%); pointer-events:none;
}
.fav-hero-greet{position:relative; z-index:1;}
.fav-hero-greet .eyebrow{font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--signal); font-weight:700;}
.fav-hero-greet h2{font-size:24px; margin:6px 0 8px; letter-spacing:-.01em;}
.fav-hero-greet p{font-size:13px; color:var(--steel); max-width:420px; line-height:1.5;}
.fav-stats{display:flex; gap:26px; position:relative; z-index:1;}
.fav-stat b{display:block; font-size:20px; font-weight:800; letter-spacing:-.01em;}
.fav-stat span{font-size:11px; color:var(--steel); text-transform:uppercase; letter-spacing:.06em;}
.fav-hero-actions{display:flex; gap:10px; position:relative; z-index:1; flex-wrap:wrap;}

/* ============================================================
   [CUENTA] Panel privado de preferencias (colores / marcas / tallas)
   ---- Rediseño "futurista": fondo oscuro fijo (no depende de
   var(--text)/var(--bg), que se invertían entre claro/oscuro y
   dejaban el texto ilegible), borde con brillo de acento y anillo
   con degradado alrededor del avatar en vez de un círculo plano
   translúcido que se perdía contra el fondo. ============================================================ */
.acct-dash-hero{
  position:relative; overflow:hidden; border-radius:var(--r-lg); padding:28px; margin-bottom:24px;
  background:
    radial-gradient(circle at 12% -20%, rgba(74,95,199,.35) 0%, transparent 55%),
    radial-gradient(circle at 105% 120%, rgba(201,162,39,.18) 0%, transparent 50%),
    linear-gradient(135deg, #0A0B10 0%, #14151D 100%);
  border:1px solid rgba(255,255,255,.08);
  box-shadow:0 1px 0 rgba(255,255,255,.06) inset, 0 20px 40px -24px rgba(0,0,0,.55);
  color:#F3F2ED;
  display:flex; align-items:center; gap:18px;
}
.acct-dash-hero::after{
  content:''; position:absolute; inset:0; pointer-events:none; opacity:.5;
  background-image:linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
  background-size:26px 26px; mask-image:linear-gradient(180deg, rgba(0,0,0,.6), transparent 75%);
}
.acct-dash-avatar-wrap{position:relative; flex:none; z-index:1;}
.acct-dash-avatar{
  width:64px; height:64px; border-radius:50%; display:flex; align-items:center;
  justify-content:center; font-size:24px; font-weight:800; flex:none; overflow:hidden;
  color:#fff; background:linear-gradient(150deg, #4A5FC7 0%, #7A6BE0 100%);
  box-shadow:0 0 0 3px rgba(74,95,199,.22), 0 0 0 1px rgba(255,255,255,.14) inset, 0 8px 18px -6px rgba(74,95,199,.55);
}
.acct-dash-avatar img{width:100%; height:100%; object-fit:cover; display:block;}
.acct-dash-avatar-edit{
  position:absolute; bottom:-2px; right:-2px; width:24px; height:24px; border-radius:50%;
  background:#F3F2ED; color:#0A0B10; border:2px solid #0A0B10; display:flex; align-items:center;
  justify-content:center; cursor:pointer; padding:0; box-shadow:0 2px 6px rgba(0,0,0,.35);
}
.acct-dash-avatar-edit:hover{background:#fff;}
.acct-dash-photo-remove{
  margin-top:7px; background:none; border:none; padding:0; font-size:11px; font-weight:700; text-decoration:underline;
  color:#C7C9D6; opacity:.9; cursor:pointer; font-family:inherit;
}
.acct-dash-hero-body{position:relative; z-index:1; min-width:0;}
.acct-dash-hero h2{font-size:20px; margin-bottom:3px; color:#F8F7F2; letter-spacing:-.01em;}
.acct-dash-membersince{font-size:11px; color:var(--brass); font-weight:700; letter-spacing:.03em; text-transform:uppercase; margin-bottom:6px;}
.acct-dash-hero p{font-size:12px; color:#B9BBC8; line-height:1.5;}
.pref-block{margin-bottom:28px;}
.pref-block h3{font-size:14px; margin-bottom:6px; line-height:1.3;}
.pref-block .hint{font-size:12px; color:var(--steel); margin-bottom:14px; line-height:1.5;}
.pref-chip-row{display:flex; flex-wrap:wrap; gap:8px;}
.pref-chip{
  border:1px solid var(--line); background:var(--surface); border-radius:var(--r-pill); padding:8px 15px;
  font-size:12px; font-weight:600; cursor:pointer; color:var(--text); transition:all .15s ease;
}
.pref-chip.active{background:var(--text); color:var(--bg); border-color:var(--text);}

/* ============================================================
   [CUENTA-NIKE] Lista de secciones del apartado "Mi cuenta", estilo
   Nike App (Pedidos, Favoritos, Membresía, etc. como filas separadas
   con ícono + texto + chevron, en vez de un solo bloque largo).
   ============================================================ */
/* [CUENTA · REDISEÑO] Antes estas tarjetas eran bloques planos (borde
   fino + fondo liso) que contrastaban con el hero de arriba (que sí
   tiene degradado, brillo y textura). Ahora llevan sombra elevada,
   esquinas más suaves y un leve degradado de fondo para que toda la
   página se sienta de una sola pieza, más "producto premium" que
   formulario. Los íconos pasan de una caja gris plana a un chip con
   tinte del color de acento — más fácil de escanear de un vistazo. */
.acct-section-group{
  margin-bottom:22px; border:1px solid var(--line); border-radius:var(--r-lg); overflow:hidden;
  background:linear-gradient(180deg, var(--surface) 0%, var(--surface-dim) 180%);
  box-shadow:0 1px 0 rgba(255,255,255,.03) inset, 0 14px 30px -22px rgba(0,0,0,.35);
}
.acct-section-title{font-size:10px; text-transform:uppercase; letter-spacing:.1em; color:var(--steel); font-weight:800;
  margin:0; padding:16px 18px 10px;}
.acct-row{display:flex; align-items:center; gap:14px; width:100%; padding:16px 18px; border:none; border-top:1px solid var(--line);
  background:none; text-align:left; font-family:inherit; cursor:pointer; color:var(--text); position:relative;
  transition:background .15s ease, padding-left .15s ease;}
.acct-section-title + .acct-row{border-top:none;}
.acct-row-icon{
  width:36px; height:36px; border-radius:var(--r-lg); display:flex; align-items:center; justify-content:center; flex:none;
  background:var(--signal-dim); color:var(--signal); transition:color .15s ease, background .15s ease, transform .15s ease;
}
.acct-row-icon svg{width:18px; height:18px; stroke-width:1.9;}
/* Bug corregido: título y subtítulo son <span> hermanos dentro de
   acct-row-body; sin display:block quedaban en la misma línea, uno
   pegado al otro ("FavoritosGuarda las piezas..."). */
.acct-row-body{flex:1; min-width:0; display:flex; flex-direction:column; gap:3px;}
.acct-row-title{display:block; font-size:14px; font-weight:700; line-height:1.35; letter-spacing:.005em;}
.acct-row-sub{display:block; font-size:12px; color:var(--steel); line-height:1.4;}
.acct-row-value{font-size:12px; color:var(--signal); font-weight:700; flex:none; white-space:nowrap; margin-left:8px;}
.acct-row-chevron{flex:none; color:var(--steel); margin-left:4px; transition:transform .15s ease;}
.acct-row.logout .acct-row-icon{color:#B23A3A;}
.acct-row.logout .acct-row-title{color:#B23A3A;}
/* Fila informativa (ej. "Correo de acceso"): mismo look que .acct-row pero
   sin cursor de botón ni hover de navegación, porque no lleva a ningún
   lado — solo muestra un dato. */
.acct-row-static{cursor:default;}
/* [FIX] "Ese color azul que se marca al querer cliquear algo": en
   celular no existe un mouse pasando por encima, así que el navegador
   simula el estado :hover con el primer TOQUE — y como no hay mouse que
   "se vaya" después, ese azul se queda pegado ahí hasta que tocas otra
   fila. Por eso los recuadros de ícono se veían azules solos. La
   solución es que estos estilos de :hover solo existan en dispositivos
   que de verdad tienen un cursor (mouse/trackpad) — en touch, el botón
   simplemente no cambia de color al tocarlo.  */
@media (hover:hover) and (pointer:fine){
  .acct-row:hover{background:var(--signal-dim); padding-left:22px;}
  .acct-row:hover .acct-row-icon{transform:scale(1.06); background:var(--signal); color:#fff;}
  .acct-row:hover .acct-row-chevron{transform:translateX(2px); color:var(--signal);}
  .acct-row.logout:hover{background:rgba(178,58,58,.08);}
  .acct-row-static:hover{background:none; padding-left:18px;}
  .acct-row-static:hover .acct-row-icon{transform:none;}
}

/* ---- Tarjetas de dirección / método de pago dentro de los paneles
   desplegables de "Mi cuenta" ---- */
.acct-addr-card{border:1px solid var(--line); border-radius:var(--r-md); padding:14px; margin-bottom:10px; background:var(--surface);}
.acct-addr-card-head{display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:6px;}
.acct-addr-card-head b{font-size:13px;}
.acct-addr-card p{font-size:12px; color:var(--steel); line-height:1.5; margin:0 0 10px;}
.acct-addr-default-badge{font-size:10px; font-weight:800; text-transform:uppercase; letter-spacing:.04em; color:var(--signal); background:var(--signal-dim); padding:3px 8px; border-radius:var(--r-pill); flex:none;}
.acct-addr-mini-link{background:none; border:none; padding:0; font-size:11px; font-weight:700; text-decoration:underline; color:var(--steel); cursor:pointer; font-family:inherit; flex:none;}
.acct-addr-mini-link.danger{color:#B23A3A;}
.acct-addr-card-actions{display:flex; align-items:center; gap:14px; flex-wrap:wrap;}
.acct-addr-card-actions .btn{padding:8px 14px; font-size:12px; width:auto;}

/* ---- Switch on/off para preferencias de notificaciones ---- */
.acct-notif-row{display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 4px; border-bottom:1px solid var(--line);}
.acct-notif-row:last-child{border-bottom:none;}
.acct-notif-row div{display:flex; flex-direction:column; gap:2px;}
.acct-notif-row b{font-size:13px; font-weight:700;}
.acct-notif-row span{font-size:11px; color:var(--steel);}
.acct-toggle{position:relative; width:42px; height:24px; border-radius:var(--r-pill); border:1px solid var(--line); background:var(--surface-dim);
  cursor:pointer; flex:none; padding:0; transition:background .15s ease, border-color .15s ease;}
.acct-toggle-dot{position:absolute; top:2px; left:2px; width:18px; height:18px; border-radius:50%; background:var(--steel); transition:transform .15s ease, background .15s ease;}
.acct-toggle.active{background:var(--text); border-color:var(--text);}
.acct-toggle.active .acct-toggle-dot{transform:translateX(18px); background:var(--bg);}
[data-theme="dark"] .pref-chip.active{background:var(--signal); border-color:var(--signal); color:#fff;}

/* ============================================================
   [CUENTA-ZAYDE · REDISEÑO PLANO] Accesos rápidos (Pedidos, ZAYDE ID,
   Favoritos, Buzón, Lanzamientos). Antes cada uno era una tarjeta con
   borde, fondo, sombra y un chip de ícono con degradado — se sentía
   recargado y poco serio. Ahora es una franja plana sin recuadros:
   solo ícono (color heredado, sin caja) + etiqueta, separados por
   líneas finas verticales y con una sola línea horizontal debajo de
   toda la franja — el mismo lenguaje "editorial" y sobrio que usa el
   resto del sitio, en vez de botones grandes y coloridos.
   ============================================================ */
.acct-quick-scroll{display:flex; gap:0; overflow-x:auto; padding:2px 0 18px; margin-bottom:6px; border-bottom:1px solid var(--line); scrollbar-width:none;}
.acct-quick-scroll::-webkit-scrollbar{display:none;}
.acct-quick-tile{flex:1 0 82px; min-width:82px; display:flex; flex-direction:column; align-items:center; gap:9px; padding:6px 8px;
  border:none; border-right:1px solid var(--line); background:none; cursor:pointer; position:relative;
  font-family:inherit; color:var(--text); transition:color .15s ease;}
.acct-quick-tile:last-child{border-right:none;}
.acct-quick-tile:hover{color:var(--signal);}
.acct-quick-tile-icon{width:22px; height:22px; display:flex; align-items:center; justify-content:center; color:inherit; flex:none;}
.acct-quick-tile-icon svg{width:22px; height:22px; stroke-width:1.6;}
.acct-quick-tile-label{font-size:10px; font-weight:700; letter-spacing:.03em; text-transform:uppercase; text-align:center; line-height:1.3;
  width:100%; overflow-wrap:break-word; word-break:break-word; hyphens:auto; color:var(--text);}
.acct-quick-tile-badge{position:absolute; top:0; right:14px; min-width:15px; height:15px; padding:0 4px; border-radius:var(--r-pill);
  background:var(--down); color:#fff; font-size:10px; font-weight:800; display:flex; align-items:center; justify-content:center;
  box-shadow:0 0 0 2px var(--surface);}

/* ---- ZAYDE ID (equivalente al "Pass" de Nike): tarjeta de socio con
   código propio. En vez de la tarjeta blanca lisa de Nike, usamos un
   fondo oscuro con brillo dorado (--brass) — la misma paleta "editorial
   de lujo" del resto del sitio — y mostramos el código en texto debajo
   del patrón para que el staff en tienda pueda teclearlo si el escaneo
   falla, algo que la pantalla de Nike no ofrece. ---- */
.zy-pass-card{border-radius:var(--radius); background:linear-gradient(155deg,#0E0E12,#1B1B22); border:1px solid var(--brass);
  padding:32px 26px 26px; text-align:center; color:#F4F1E8; position:relative; overflow:hidden;}
.zy-pass-card::before{content:''; position:absolute; inset:0; background:radial-gradient(circle at 15% -10%, rgba(201,162,39,.28), transparent 55%); pointer-events:none;}
.zy-pass-kicker{font-size:10px; letter-spacing:.16em; text-transform:uppercase; color:var(--brass); font-weight:800; margin-bottom:12px; position:relative;}
.zy-pass-name{font-size:18px; font-weight:800; position:relative;}
.zy-pass-sub{font-size:12px; color:#B7B4AA; margin-top:3px; margin-bottom:22px; position:relative;}
.zy-pass-code-wrap{background:#fff; border-radius:var(--radius); padding:14px; display:inline-block; position:relative; line-height:0;}
.zy-pass-tier{display:inline-block; margin-top:18px; padding:5px 14px; border:1px solid var(--brass); border-radius:var(--r-pill);
  font-size:10px; font-weight:800; letter-spacing:.05em; text-transform:uppercase; color:var(--brass); position:relative;}
.zy-pass-idtext{font-family:ui-monospace,'SF Mono',Consolas,monospace; font-size:12px; letter-spacing:.08em; margin-top:16px;
  color:#F4F1E8; position:relative; display:flex; align-items:center; justify-content:center; gap:10px;}
.zy-pass-idtext button{background:none; border:1px solid rgba(244,241,232,.3); color:#F4F1E8; border-radius:var(--radius);
  padding:5px 8px; cursor:pointer; display:flex; align-items:center;}
.zy-pass-hint{font-size:11px; color:var(--steel); margin-top:18px; text-align:center;}
.zy-pass-hint a{color:var(--signal); font-weight:700;}

/* ---- Buzón (equivalente a la "Bandeja de entrada" de Nike): a
   diferencia de Nike, que solo enseña el número de mensajes sin poder
   leerlos ahí mismo, el buzón de ZAYDE se abre, se lee y se marca solo
   como leído al cerrarse. Cada mensaje trae su propio ícono. ---- */
.zy-inbox-item{display:flex; gap:12px; padding:14px 4px; border-bottom:1px solid var(--line);}
.zy-inbox-item:last-child{border-bottom:none;}
.zy-inbox-icon{width:34px; height:34px; border-radius:var(--radius); background:var(--surface-dim); display:flex; align-items:center; justify-content:center; flex:none; color:var(--text);}
.zy-inbox-icon svg{width:16px; height:16px;}
.zy-inbox-body{flex:1; min-width:0;}
.zy-inbox-title-row{display:flex; align-items:center; gap:6px;}
.zy-inbox-title{font-size:13px; font-weight:700;}
.zy-inbox-dot{width:7px; height:7px; border-radius:var(--r-pill); background:var(--signal); flex:none;}
.zy-inbox-msg{font-size:12px; color:var(--steel); margin-top:3px; line-height:1.4;}
.zy-inbox-date{font-size:10px; color:var(--steel); margin-top:5px; text-transform:uppercase; letter-spacing:.04em;}
.zy-inbox-empty{text-align:center; padding:40px 10px; color:var(--steel); font-size:13px;}

/* ============================================================
   [ENVÍO GRATIS] Barra de progreso en el carrito
   ============================================================ */
.ship-progress-wrap{padding:12px 0 4px;}
.ship-progress-text{font-size:12px; margin-bottom:8px; text-align:center;}
.ship-progress-text b{color:var(--signal);}
.ship-progress-bar{height:5px; border-radius:var(--r-sm); background:var(--surface-dim); overflow:hidden;}
.ship-progress-fill{height:100%; background:var(--signal); border-radius:var(--r-sm); transition:width .4s ease;}
.ship-progress-fill.full{background:var(--up);}

/* ============================================================
   [CUPÓN / TARJETA DE REGALO]
   ============================================================ */
.promo-box{border:1px solid var(--line); border-radius:var(--r-md); padding:14px; margin:14px 0; background:var(--surface-dim);}
.promo-label{font-size:12px; font-weight:700; color:var(--text); margin:0 0 8px;}
/* [FIX-PROMO-ROW-COLLISION] Antes esta fila usaba la clase genérica ".promo-row",
   la MISMA clase que usan los carruseles de banners de la home (línea ~909:
   display:flex; overflow-x:auto; scroll-snap-type:x mandatory; scrollbar oculta).
   Como ambas reglas comparten selector y esta venía después en la cascada, solo
   pisaba display/gap/margin — pero heredaba "overflow-x:auto" y "scrollbar-width:
   none" de la regla del carrusel, convirtiendo el renglón del cupón en un
   contenedor con scroll horizontal SIN scrollbar visible. Resultado: el botón
   "Aplicar" quedaba empujado fuera de la pantalla y parecía cortado, sin ninguna
   pista visual de que había que deslizar para verlo. Se renombra a una clase
   propia y sin overflow-x para que el input y el botón compartan el renglón
   normal, sin scroll oculto. */
.promo-code-row{display:flex; gap:8px; margin:0 0 10px; overflow:visible; flex-wrap:nowrap;}
.promo-code-row input{flex:1; min-width:0; width:auto;}
.promo-code-row button{white-space:nowrap;}
/* Fix: la regla ".cart-foot .btn{width:100%}" (pensada para el botón grande
   de "Continuar con el envío") también le pegaba al botón "Aplicar" de aquí
   adentro por ser genérica sobre .btn — como es un item flex sin flex-grow,
   ese width:100% lo hacía pelear por el ancho completo del cajón y aplastaba
   el input de al lado, dejándolo casi invisible/cortado. Se anula ese ancho
   solo dentro de .promo-code-row para que input y botón compartan el renglón. */
.promo-code-row .btn{width:auto; flex:0 0 auto;}
@media(max-width:380px){
  .promo-code-row{flex-wrap:wrap;}
  .promo-code-row input, .promo-code-row .btn{flex:1 1 100%;}
}
.promo-applied{
  display:flex; align-items:center; justify-content:space-between; background:var(--signal-dim);
  border:1px solid var(--signal); border-radius:var(--r-md); padding:9px 12px; font-size:12px; font-weight:700; margin:14px 0;
}
.promo-applied button{background:none; border:none; color:var(--signal); cursor:pointer; font-weight:700;}

/* ============================================================
   [ZAYDE CLUB] Membresía estilo Nike
   ============================================================ */
.club-hero{
  border-radius:var(--r-lg); padding:64px 32px 56px; text-align:center; margin:8px 0 40px;
  background:radial-gradient(circle at 30% 15%, rgba(74,95,199,0.32), transparent 55%),
             radial-gradient(circle at 80% 85%, rgba(184,148,74,0.14), transparent 50%),
             linear-gradient(160deg, #0A0A12, #131320);
  color:#F3F2ED; position:relative; overflow:hidden; border:1px solid rgba(255,255,255,0.07);
  box-shadow:0 1px 2px rgba(0,0,0,0.4), 0 24px 48px rgba(0,0,0,0.35);
}
.club-hero::before{
  content:''; position:absolute; inset:0; pointer-events:none; opacity:.5;
  background:linear-gradient(180deg, rgba(255,255,255,0.05), transparent 30%);
}
.club-hero .eyebrow{
  display:inline-flex; align-items:center; gap:8px; font-size:11px; letter-spacing:.16em;
  text-transform:uppercase; color:var(--brass); font-weight:800; position:relative;
}
.club-hero .eyebrow::before, .club-hero .eyebrow::after{content:''; width:18px; height:1px; background:var(--brass); opacity:.55;}
.club-hero h1{
  font-size:40px; margin:16px auto 14px; max-width:640px; letter-spacing:-.025em;
  line-height:1.12; color:#FBFAF7; position:relative;
}
.club-hero p{max-width:460px; margin:0 auto 28px; opacity:.72; font-size:14px; line-height:1.65; color:#F3F2ED; position:relative;}
.club-hero .btn{position:relative; padding:14px 30px; font-size:13px; letter-spacing:.02em;}
.club-hero .skiplink{
  display:inline-block; margin-top:16px; font-size:12px; color:#B9B8C4; position:relative;
  border-bottom:1px solid transparent; transition:border-color .15s, color .15s;
}
.club-hero .skiplink:hover{color:#F3F2ED; border-color:rgba(243,242,237,0.4);}
.club-perks{display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin:24px 0;}
.club-perk{border:1px solid var(--line); border-radius:var(--r-lg); padding:24px 22px; background:var(--surface); box-shadow:var(--shadow); transition:transform .15s, box-shadow .15s;}
.club-perk:hover{transform:translateY(-2px); box-shadow:0 4px 8px rgba(14,14,16,0.06), 0 16px 32px rgba(14,14,16,0.08);}
.club-perk svg{color:var(--signal); margin-bottom:14px;}
.club-perk h3{font-size:14px; margin-bottom:6px; font-family:inherit; font-weight:700;}
.club-perk p{font-size:12px; color:var(--steel); line-height:1.55;}
.club-tiers{display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px; margin-top:8px;}
.club-tier{border:1px solid var(--line); border-radius:var(--r-lg); padding:28px 26px; position:relative; background:var(--surface); box-shadow:var(--shadow); transition:transform .15s, box-shadow .15s;}
.club-tier:hover{transform:translateY(-2px); box-shadow:0 4px 8px rgba(14,14,16,0.06), 0 20px 36px rgba(14,14,16,0.09);}
.club-tier.is-featured{border-color:var(--signal); box-shadow:0 0 0 1px var(--signal), var(--shadow);}
.club-tier .tier-badge{position:absolute; top:-11px; left:22px; background:var(--signal); color:#fff; font-size:10px;
  font-weight:800; letter-spacing:.06em; text-transform:uppercase; padding:4px 12px; border-radius:var(--r-pill);}
.club-tier h4{font-size:16px; margin-bottom:4px; font-weight:700; letter-spacing:-.01em;}
.club-tier .price{font-size:13px; color:var(--steel); margin-bottom:18px; padding-bottom:18px; border-bottom:1px solid var(--line);}
.club-tier ul{list-style:none; padding:0; margin:0 0 22px; font-size:12px; color:var(--steel); line-height:2;}
.club-tier ul li::before{content:'✓ '; color:var(--up); font-weight:800;}
.club-tier .btn{font-size:13px; padding:12px 18px;}
@media(max-width:560px){
  .club-hero{padding:44px 22px 40px; border-radius:var(--r-lg);}
  .club-hero h1{font-size:28px;}
  .club-perks{grid-template-columns:1fr 1fr; gap:12px;}
  .club-perk{padding:16px;}
}

/* ============================================================
   [NAV-CTA] Resalta el link "ZAYDE G" del menú principal con el
   mismo azul de marca (var(--signal)) que usa "ZAYDE Club" — solo
   color y peso de fuente, sin fondo ni píldora.
   ============================================================ */
.nav-link-cta{ color:var(--signal) !important; font-weight:800 !important; }

/* ============================================================
   [ROPA G] "ZAYDE G" — línea de Generación.
   Arquitectura deliberadamente distinta a la del catálogo estándar
   (ROPA AUTÉNTICA usa .grid/.card, rejilla uniforme y esquinas
   redondeadas). ROPA G usa un bento asimétrico, esquinas rectas,
   tipografía enorme superpuesta sobre la imagen y una franja
   diagonal de acento — mismo azul de marca (var(--signal)) para
   que se sienta parte de ZAYDE, pero se reconoce a simple vista
   que es una sección distinta.
   ============================================================ */
/* [ZAYDE G · MISMA IDENTIDAD DE ZAYDE] Por pedido del cliente, esta
   sección ya NO usa un acento dorado/violeta propio — usa el mismo azul
   de marca (var(--signal)) que el resto de ZAYDE, para sentirse
   claramente parte de la misma tienda, no una marca aparte.
   [PEDIDO CLIENTE] Se quitó el recuadro/rectángulo azul de fondo de este
   banner (antes era un degradado oscuro-a-azul a todo lo ancho). Ahora
   es un encabezado simple, sin caja de color, con los mismos colores de
   texto que el resto del sitio — solo un separador delgado abajo, igual
   que cualquier otro encabezado de sección. */
.ropag-band{
  position:relative; margin:8px 0 28px; padding:0 0 28px; border-bottom:1px solid var(--line);
}
.ropag-band::after{ content:none; }
.ropag-band::before{ content:none; }
/* [ZG-BG-SIZE] Cuando SÍ hay foto de fondo (zySettings.heroBgImageG), el
   encabezado de ZAYDE G pasa a ocupar el mismo tamaño de recuadro que el
   hero de inicio de ZAYDE: ancho completo (100vw, mismo truco de margen
   negativo que .hero) y el mismo alto mínimo (680px), con el texto
   pegado abajo igual que en ZAYDE. Sin foto, se queda exactamente como
   antes (encabezado compacto, sin caja vacía gigante) — la clase
   "has-bg" la agrega/quita zyRenderRopagBg() en el JS según haya o no
   una foto guardada. */
.ropag-band.has-bg{
  width:100vw; margin-left:calc(50% - 50vw); margin-right:calc(50% - 50vw);
  min-height:680px; display:flex; align-items:flex-end; overflow:hidden;
  padding:0; margin-top:0; margin-bottom:28px; border-bottom:none; background:var(--surface-dim);
}
.ropag-band.has-bg .ropag-inner{
  position:relative; z-index:1; width:100%; max-width:1360px; margin:0 auto; padding:0 32px 56px;
}
.ropag-band.has-bg .ropag-bg{ border-radius:0; }
.ropag-band.has-bg .ropag-bg::after{
  background:linear-gradient(0deg, rgba(0,0,0,.78) 0%, rgba(0,0,0,.35) 42%, rgba(0,0,0,.05) 68%);
}
.ropag-band.has-bg .eyebrow{ color:#fff; }
.ropag-band.has-bg h1{ color:#fff; }
.ropag-band.has-bg h1 em{ color:rgba(255,255,255,.6); }
.ropag-band.has-bg p{ color:rgba(255,255,255,.85); }
.ropag-band.has-bg .ropag-tldr li{ color:rgba(255,255,255,.85); }
/* [PEDIDO CLIENTE] Fondo editable del encabezado de ZAYDE G — mismo patrón
   que el fondo del hero de inicio de ZAYDE (zySettings.heroBgImageG). Vacío
   por defecto (encabezado sin foto, como ya estaba); en cuanto el admin
   sube una foto desde el panel privado, se dibuja aquí detrás del texto,
   con un degradado para que el texto se siga leyendo. */
.ropag-bg{ position:absolute; inset:0; z-index:0; overflow:hidden; border-radius:var(--r-sm); }
.ropag-bg img, .ropag-bg video{ width:100%; height:100%; object-fit:cover; display:block; }
.ropag-bg::after{ content:''; position:absolute; inset:0; background:linear-gradient(100deg, var(--bg) 0%, var(--bg) 18%, rgba(0,0,0,.55) 55%, rgba(0,0,0,.15) 100%); }
/* [ZAYDE G · MISMO RECUADRO DE INICIO QUE ZAYDE] Controles de video del
   encabezado — mismo componente .hero-ctrl-btn del hero de inicio, aquí
   flotando arriba a la derecha del recuadro. Solo se muestran cuando el
   encabezado tiene fondo (ver .ropag-band.has-bg y zyRenderRopagBg()). */
.ropag-bg-actions{ position:absolute; top:18px; right:18px; z-index:2; display:none; align-items:center; gap:10px; }
.ropag-band.has-bg .ropag-bg-actions{ display:flex; }
.ropag-band .eyebrow{
  position:relative; z-index:1; display:inline-flex; align-items:center; gap:8px; font-size:11px; letter-spacing:.18em; text-transform:uppercase;
  font-weight:800; color:var(--signal);
}
.ropag-band h1{
  position:relative; z-index:1; font-size:clamp(32px,5vw,56px); line-height:.98; margin:16px 0 12px; letter-spacing:-.03em; text-transform:uppercase;
  max-width:640px; color:var(--text);
}
.ropag-band h1 em{font-style:normal; color:var(--text); opacity:.6;}
.ropag-band p{max-width:460px; font-size:14px; line-height:1.7; color:var(--steel); position:relative; z-index:1;}

/* [ZG-DROP] Aviso "Drop en vivo" propio de ZAYDE G: misma información que
   #dropEyebrow de ZAYDE pero con tratamiento visual distinto (píldora con
   borde y punto pulsante) para que se note que es otra arquitectura. */
.ropag-drop{
  position:relative; z-index:1; display:inline-flex; align-items:center; gap:8px; margin-bottom:14px;
  font-size:10px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; color:var(--text);
  border:1px solid var(--line); border-radius:var(--r-pill); padding:6px 14px 6px 11px;
  background:var(--surface-dim); font-variant-numeric:tabular-nums;
}
.ropag-drop::before{
  content:''; width:6px; height:6px; border-radius:50%; background:var(--signal); flex-shrink:0;
  box-shadow:0 0 0 0 rgba(47,95,255,0.7); animation:ropagPulse 1.8s ease-out infinite;
}
@keyframes ropagPulse{
  0%{box-shadow:0 0 0 0 rgba(47,95,255,0.55);}
  70%{box-shadow:0 0 0 7px rgba(47,95,255,0);}
  100%{box-shadow:0 0 0 0 rgba(47,95,255,0);}
}
.ropag-cta-row{display:flex; flex-wrap:wrap; align-items:center; gap:12px; position:relative; z-index:1;}
.ropag-band .btn-primary{border-radius:var(--r-sm); letter-spacing:.02em;}
.ropag-btn-ghost{
  border-radius:var(--r-sm);
}
.ropag-tldr{
  position:relative; z-index:1; margin-top:24px; padding-top:18px; border-top:1px solid var(--line);
  display:flex; flex-wrap:wrap; gap:10px 22px;
}
.ropag-tldr li{color:var(--steel); font-size:12px;}
.ropag-tldr li svg{color:var(--signal);}

.ropag-bento{
  display:grid; grid-template-columns:repeat(6,1fr); grid-auto-rows:190px; gap:14px; margin:0 0 20px;
}
.ropag-tile{
  position:relative; grid-column:span 2; grid-row:span 1; border-radius:0; overflow:hidden; cursor:pointer;
  background:var(--surface-dim); border:1px solid var(--line); isolation:isolate;
}
.ropag-tile.g-big{grid-column:span 4; grid-row:span 2;}
.ropag-tile.g-tall{grid-row:span 2;}
.ropag-tile img{width:100%; height:100%; object-fit:cover; transition:transform .5s cubic-bezier(.2,.8,.2,1); display:block;}
.ropag-tile:hover img{transform:scale(1.06);}
.ropag-tile::before{
  content:''; position:absolute; inset:0; z-index:1;
  background:linear-gradient(0deg, rgba(6,7,12,0.88) 0%, rgba(6,7,12,0.25) 45%, transparent 70%);
}
.ropag-tile-tag{
  position:absolute; top:12px; left:0; z-index:2; background:linear-gradient(90deg,#2F5FFF,#5C7CFF); color:#fff; font-size:10px; font-weight:800;
  letter-spacing:.08em; text-transform:uppercase; padding:5px 12px 5px 14px; box-shadow:0 0 16px rgba(74,95,199,0.7);
}
.ropag-tile{transition:box-shadow .3s ease, transform .3s ease;}
.ropag-tile:hover{box-shadow:0 0 0 1px var(--signal), 0 12px 30px -8px rgba(47,95,255,0.45); transform:translateY(-2px);}
.ropag-tile-info{position:absolute; left:0; right:0; bottom:0; z-index:2; padding:16px 18px; color:#F3F2ED;}
.ropag-tile-info .brand{font-size:10px; letter-spacing:.1em; text-transform:uppercase; color:var(--signal); font-weight:800; margin-bottom:4px;}
.ropag-tile.g-big .brand{color:#fff;}
.ropag-tile-info .name{font-size:14px; font-weight:700; line-height:1.25; margin-bottom:6px; text-transform:uppercase; letter-spacing:-.01em;}
.ropag-tile.g-big .name{font-size:20px;}
.ropag-tile-info .price{font-size:13px; font-weight:800; color:#fff;}
.ropag-empty{
  border:1px dashed var(--line); padding:40px 20px; text-align:center; color:var(--steel); font-size:13px; grid-column:1/-1;
}
.ropag-strip{
  display:flex; align-items:center; gap:10px; margin:36px 0 18px; padding:14px 0; border-top:1px solid var(--line); border-bottom:1px solid var(--line);
}
.ropag-strip svg{color:var(--signal); flex-shrink:0;}

/* [ZAYDE G · ESTRUCTURA PROPIA] */
.zg-toolbar{display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin-bottom:18px;}
.zg-toolbar select{border:1px solid var(--line); border-radius:var(--r-md); padding:9px 10px; font-size:13px; background:var(--surface); color:var(--text);}
.zg-intro{max-width:560px; margin:-10px 0 18px; color:var(--steel); font-size:13px; line-height:1.7;}

/* ============================================================
   [ZY-SORT] Menú "Ordenar por" — reemplaza el <select> nativo (cuya
   lista desplegada la dibuja el sistema operativo, no el sitio) por un
   botón + lista construidos en HTML, para que se vea igual en cualquier
   navegador y con la tipografía/colores propios de ZAYDE.
   ============================================================ */
.zy-sort{position:relative; display:inline-block;}
.zy-sort-btn{
  display:flex; align-items:center; gap:10px; appearance:none; cursor:pointer;
  background:var(--surface-dim); border:1px solid var(--line); border-radius:var(--radius);
  padding:12px 16px; height:40px; box-sizing:border-box; font-size:13px; font-weight:700; letter-spacing:.02em; color:var(--text);
  transition:border-color .18s ease, box-shadow .18s ease;
}
.zy-sort-btn svg{flex-shrink:0; color:var(--steel); transition:transform .18s ease;}
.zy-sort-btn:hover{border-color:var(--steel);}
.zy-sort.open .zy-sort-btn{border-color:var(--signal); box-shadow:0 0 0 3px var(--signal-dim);}
.zy-sort.open .zy-sort-btn svg{transform:rotate(180deg);}
.zy-sort-menu{
  position:absolute; top:calc(100% + 6px); right:0; z-index:40; min-width:230px;
  background:var(--surface); border:1px solid var(--line); border-radius:var(--radius);
