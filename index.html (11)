/* =====================================================================
   [MODO CLARO · PERSONALIDAD ZAYDE]
   Antes el modo claro era blanco y negro plano. Ahora: papel cálido con
   destellos azul eléctrico y latón de la marca, esquinas más suaves,
   tarjetas con profundidad, botones con degradado, etiquetas de sección
   con acento, barra de anuncios azul y pie de página oscuro que da
   contraste. Todo vive bajo html:not([data-theme="dark"]) — el modo oscuro no se toca.
   ===================================================================== */
html:not([data-theme="dark"]){
  --bg:#F5F2EA; --surface:#FFFFFF; --surface-dim:#ECE8DD; --steel:#5A5C66;
  --line:rgba(40,32,12,.12); --signal-dim:rgba(47,95,255,.10);
  --radius:8px; --r-sm:8px; --r-md:12px; --r-lg:18px;
  --shadow:0 1px 2px rgba(30,24,8,.05), 0 14px 34px rgba(47,95,255,.12);
  scrollbar-color:#2F5FFF #ECE8DD;
}
html:not([data-theme="dark"]) body{
  background:
    radial-gradient(900px 540px at 6% -6%, rgba(47,95,255,.11), transparent 60%),
    radial-gradient(820px 540px at 104% 16%, rgba(201,162,39,.13), transparent 60%),
    radial-gradient(760px 620px at 50% 112%, rgba(47,95,255,.08), transparent 60%),
    var(--bg);
}
@media (min-width:900px){ html:not([data-theme="dark"]) body{ background-attachment:fixed; } }
html:not([data-theme="dark"]) header:not(.header-overlay){ background:rgba(245,242,234,.82); -webkit-backdrop-filter:blur(14px) saturate(1.5); backdrop-filter:blur(14px) saturate(1.5); box-shadow:0 1px 0 rgba(47,95,255,.14); }
html:not([data-theme="dark"]) .nav-links-row a, html:not([data-theme="dark"]) .nav-links-row button{ position:relative; }
html:not([data-theme="dark"]) .nav-links-row a::after, html:not([data-theme="dark"]) .nav-links-row button::after{ content:""; position:absolute; left:0; right:0; bottom:-6px; height:2px; border-radius:2px; background:var(--signal); transform:scaleX(0); transform-origin:left; transition:transform .22s ease; }
html:not([data-theme="dark"]) .nav-links-row a:hover::after, html:not([data-theme="dark"]) .nav-links-row button:hover::after{ transform:scaleX(1); }
/* barra de anuncios */
html:not([data-theme="dark"]) .marquee-bar{ background:linear-gradient(90deg,#1A3BD1 0%,#2F5FFF 50%,#1A3BD1 100%); color:#fff; border-bottom:0; }
html:not([data-theme="dark"]) .marquee-bar .marquee-nav, html:not([data-theme="dark"]) .marquee-bar .marquee-nav:hover{ color:#fff; }
/* títulos de sección */
html:not([data-theme="dark"]) .section-head .st{ display:inline-block; background:var(--signal-dim); color:var(--signal); padding:5px 12px; border-radius:999px; }
html:not([data-theme="dark"]) .section-head h2{ position:relative; padding-bottom:14px; }
html:not([data-theme="dark"]) .section-head h2::after{ content:""; position:absolute; left:0; bottom:0; width:46px; height:4px; border-radius:4px; background:linear-gradient(90deg,var(--signal),var(--brass)); }
/* tarjetas de producto */
html:not([data-theme="dark"]) .card{ border:1px solid rgba(40,32,12,.07); border-radius:var(--r-md); box-shadow:0 1px 2px rgba(30,24,8,.04), 0 10px 24px rgba(30,24,8,.07); }
html:not([data-theme="dark"]) .card:hover{ border-color:rgba(47,95,255,.35); box-shadow:0 2px 4px rgba(30,24,8,.06), 0 20px 44px rgba(47,95,255,.20); }
html:not([data-theme="dark"]) .card-price{ color:#1E44D6; }
html:not([data-theme="dark"]) .card-price-old{ color:var(--steel); }
/* botones y selectores */
html:not([data-theme="dark"]) .btn-primary{ background:linear-gradient(135deg,#0E0E10 0%,#1B2652 100%); color:#fff; box-shadow:0 6px 18px rgba(14,14,40,.25); transition:transform .15s ease, box-shadow .2s ease; }
html:not([data-theme="dark"]) .btn-primary:hover{ transform:translateY(-1px); box-shadow:0 10px 26px rgba(47,95,255,.38); }
html:not([data-theme="dark"]) .btn-ghost{ background:#fff; border-color:rgba(47,95,255,.28); }
html:not([data-theme="dark"]) .btn-ghost:hover{ border-color:var(--signal); color:var(--signal); }
html:not([data-theme="dark"]) .chip.active, html:not([data-theme="dark"]) .size-opt.active{ background:var(--signal); border-color:var(--signal); color:#fff; box-shadow:0 4px 12px rgba(47,95,255,.35); }
html:not([data-theme="dark"]) .size-opt:hover:not(.disabled){ border-color:var(--signal); }
html:not([data-theme="dark"]) input:focus, html:not([data-theme="dark"]) select:focus, html:not([data-theme="dark"]) textarea:focus{ border-color:var(--signal); box-shadow:0 0 0 3px var(--signal-dim); outline:none; }
/* franja de confianza */
html:not([data-theme="dark"]) .trust{ background:linear-gradient(90deg, rgba(47,95,255,.07), rgba(201,162,39,.10)); border-radius:var(--r-lg); overflow:hidden; }
html:not([data-theme="dark"]) .trust-item svg{ box-sizing:border-box; width:40px; height:40px; padding:9px; background:#fff; border-radius:12px; box-shadow:0 4px 12px rgba(47,95,255,.18); }
/* pie de página oscuro para dar contraste */
html:not([data-theme="dark"]) footer{ --text:#ECE9E0; --steel:#A3A7B5; --line:rgba(236,233,224,.16); --surface:#16161C; --bg:#0B0B10; --surface-dim:#1B1B22; --signal-dim:rgba(74,95,199,.18);
  background:linear-gradient(180deg,#10101A,#07070B); color:var(--text); border-top:0; margin-top:80px; position:relative; }
html:not([data-theme="dark"]) footer::before{ content:""; position:absolute; left:0; right:0; top:0; height:3px; background:linear-gradient(90deg,var(--signal),var(--brass),var(--signal)); }

/* [VELOCIDAD] Los modales cerrados (admin, políticas, login...) solo estaban ocultos con opacity:0, así que el navegador
   los calculaba y dibujaba completos aunque nadie los viera (~40 % de los elementos de la página). content-visibility:hidden
   hace que se salte su contenido mientras están cerrados; al abrirlos se ven igual que siempre. La transición "allow-discrete"
   mantiene la animación de cierre. */
.checkout-modal{ transition:opacity .25s, content-visibility .25s allow-discrete; }
.zy-modal{ transition:opacity .2s, content-visibility .2s allow-discrete; }
.checkout-modal:not(.open), .zy-modal:not(.open){ content-visibility:hidden; contain-intrinsic-size:auto 100vh; }

