.ck-row{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:10px;}
/* [FIX — "que se vean más limpios y profesionales Avísenme por correo/
   WhatsApp"] Se reemplaza el checkbox nativo (chico, distinto en cada
   navegador) por una fila tipo "ajustes de app": ícono propio del canal
   en una burbuja, texto, y un switch/toggle de verdad a la derecha en
   vez de una casilla. El checkbox original sigue existiendo (mismo id)
   pero se oculta visualmente y se dibuja como switch con :checked +
   ::after, así no se tocó nada del JS que ya lee ckNotifyEmail/
   ckNotifyWhatsapp. */
.ck-notify-row{display:flex; flex-direction:column; gap:8px; margin:-2px 0 16px;}
.ck-notify-row label, .ck-save-addr-row{
  display:flex; align-items:center; gap:12px; font-size:13px; color:var(--text); font-weight:600;
  padding:13px 14px; border:1px solid var(--line); border-radius:var(--r-md); background:var(--surface-dim);
  cursor:pointer; transition:border-color .15s ease, background .15s ease;
}
.ck-notify-row label:hover, .ck-save-addr-row:hover{ border-color:var(--signal); }
.ck-notify-icon{width:30px; height:30px; border-radius:50%; flex:none; display:flex; align-items:center; justify-content:center;
  background:var(--surface); border:1px solid var(--line); color:var(--steel);}
.ck-notify-icon svg{width:15px; height:15px;}
.ck-notify-row label span.ck-notify-text{flex:1;}
/* Switch: el <input> real queda invisible pero funcional (encima del
   track), y el track/perilla se dibujan con ::after — sigue siendo un
   <input type=checkbox> normal para el JS y accesibilidad, solo cambia
   el look. */
.ck-notify-row label input[type="checkbox"], .ck-save-addr-row input[type="checkbox"]{
  appearance:none; -webkit-appearance:none; position:relative; flex:none; width:38px; height:22px;
  border-radius:var(--r-pill); background:var(--line); border:1px solid var(--line); cursor:pointer;
  transition:background .18s ease, border-color .18s ease; margin:0;
}
.ck-notify-row label input[type="checkbox"]::after, .ck-save-addr-row input[type="checkbox"]::after{
  content:''; position:absolute; top:1px; left:1px; width:18px; height:18px; border-radius:50%;
  background:#fff; box-shadow:0 1px 2px rgba(0,0,0,.25); transition:transform .18s ease;
}
.ck-notify-row label input[type="checkbox"]:checked, .ck-save-addr-row input[type="checkbox"]:checked{
  background:var(--signal); border-color:var(--signal);
}
.ck-notify-row label input[type="checkbox"]:checked::after, .ck-save-addr-row input[type="checkbox"]:checked::after{
  transform:translateX(16px);
}
.ck-save-addr-row{margin:-2px 0 14px;}
