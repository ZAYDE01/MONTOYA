/* checkout modal */
/* [FIX-TABBAR] z-index subido de 99 a 122 (por encima de .mobile-tabbar,
   120). Esta clase la comparten checkoutModal, loginModal, accountModal,
   trackingModal, zyPassModal, inboxModal y policyModal — todos se veían
   con su botón inferior tapado por la barra de navegación en celular
   ("Confirmar pedido", "Buscar pedido", etc.), porque la barra nunca se
   ocultaba al abrir estos modales y tenía un z-index más alto que ellos. */
.checkout-modal{position:fixed; inset:0; z-index:122; display:flex; align-items:center; justify-content:center;
  opacity:0; pointer-events:none; transition:opacity .25s; padding:24px 16px; overflow-y:auto;}
.checkout-modal.open{opacity:1; pointer-events:auto;}

/* ---------- [ZOOM] Lightbox de zoom de fotos de producto ---------- */
.zoom-lightbox{position:fixed; inset:0; z-index:210; background:rgba(8,8,10,0.96);
  display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none;
  transition:opacity .2s; touch-action:none;}
.zoom-lightbox.open{opacity:1; pointer-events:auto;}
.zoom-stage{position:relative; width:100%; height:100%; display:flex; align-items:center; justify-content:center; overflow:hidden; touch-action:none;}
.zoom-stage img{max-width:96vw; max-height:calc(100vh - 150px); object-fit:contain; will-change:transform; user-select:none; -webkit-user-drag:none; touch-action:none;}
/* Sin miniaturas la foto usa casi toda la pantalla; con zoom se ocultan miniaturas/puntos/ayuda para no tapar la foto */
.zoom-lightbox.thumbs-hidden .zoom-stage img{max-height:94vh;}
.zoom-lightbox.is-zoomed .zoom-thumbs,.zoom-lightbox.is-zoomed .zoom-dots,.zoom-lightbox.is-zoomed .zoom-hint{opacity:0; pointer-events:none;}
.zoom-stage.zoomed img{cursor:grab;}
.zoom-stage.zoomed.dragging img{cursor:grabbing;}
.zoom-close{position:absolute; top:16px; right:16px; width:40px; height:40px; border-radius:50%; border:none;
  background:rgba(255,255,255,0.1); color:#fff; display:flex; align-items:center; justify-content:center;
  cursor:pointer; z-index:2; transition:background .15s;}
.zoom-close:hover{background:rgba(255,255,255,0.2);}
.zoom-close svg{width:18px; height:18px;}
.zoom-arrow{position:absolute; top:50%; transform:translateY(-50%); width:44px; height:44px; border-radius:50%;
  border:none; background:rgba(255,255,255,0.1); color:#fff; display:flex; align-items:center; justify-content:center;
  cursor:pointer; z-index:2; transition:background .15s;}
.zoom-arrow:hover{background:rgba(255,255,255,0.2);}
.zoom-arrow svg{width:20px; height:20px;}
.zoom-arrow-left{left:14px;}
.zoom-arrow-right{right:14px;}
.zoom-hint{position:absolute; bottom:18px; left:50%; transform:translateX(-50%); font-size:11px; color:rgba(255,255,255,0.6);
  white-space:nowrap; letter-spacing:.02em; pointer-events:none;}
.zoom-dots{position:absolute; bottom:44px; left:50%; transform:translateX(-50%); display:flex; gap:6px;}
.zoom-dots span{width:5px; height:5px; border-radius:50%; background:rgba(255,255,255,0.35);}
.zoom-dots span.active{background:#fff;}
/* [MINIATURAS DENTRO DEL ZOOM] Al entrar al zoom se ven de una vez las
   demás fotos del producto abajo, como una tira de recuadros chicos —
   tocar cualquiera salta directo a esa foto. El botón de arriba a la
   izquierda (zoomThumbsToggle) las oculta, dejando solo la foto grande
   con un acercamiento más limpio; los puntitos (.zoom-dots) toman su
   lugar como referencia mínima de en qué foto vas. */
.zoom-thumbs{position:absolute; bottom:64px; left:50%; transform:translateX(-50%); display:flex; gap:8px;
  max-width:92vw; overflow-x:auto; padding:4px 2px; z-index:2;}
.zoom-thumbs::-webkit-scrollbar{display:none;}
.zoom-thumbs img{width:54px; height:54px; object-fit:cover; border-radius:var(--r-md); border:2px solid transparent;
  opacity:.55; cursor:pointer; flex:0 0 auto; transition:opacity .15s ease, border-color .15s ease;}
.zoom-thumbs img:hover{opacity:.85;}
.zoom-thumbs img.active{border-color:#fff; opacity:1;}
.zoom-lightbox.thumbs-hidden .zoom-thumbs{display:none;}
.zoom-lightbox:not(.thumbs-hidden) .zoom-dots{display:none;}
.zoom-thumbs-toggle{position:absolute; top:16px; left:16px; width:40px; height:40px; border-radius:50%; border:none;
  background:rgba(255,255,255,0.08); color:#fff; display:flex; align-items:center; justify-content:center;
  cursor:pointer; z-index:3; transition:background .15s ease;}
.zoom-thumbs-toggle:hover{background:rgba(255,255,255,0.2);}
.zoom-thumbs-toggle.active{background:rgba(255,255,255,0.28);}
.zoom-thumbs-toggle svg{width:18px; height:18px;}
@media (max-width:640px){
  .zoom-arrow{display:none;}
  .zoom-hint{font-size:10px; padding:0 20px; text-align:center; white-space:normal;}
}
