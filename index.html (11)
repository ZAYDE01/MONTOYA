.verify-home-step h3{font-size:14.5px; margin-bottom:6px; font-family:inherit; font-weight:inherit;}
.verify-home-step p{font-size:12.5px; line-height:1.5; color:var(--steel);}
.verify-home-guarantee{display:flex; align-items:center; gap:12px; width:100%; text-align:left; padding:16px 18px; border:1px solid var(--line); border-radius:8px; background:var(--surface); cursor:pointer; transition:border-color .15s;}
.verify-home-guarantee:hover{border-color:var(--signal);}
.verify-home-guarantee svg{width:22px; height:22px; color:var(--signal); flex-shrink:0;}
