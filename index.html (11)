<!-- ============================================================
     [MONITOREO DE ERRORES] Sentry — gratis hasta 5,000 errores/mes.
     Sin esto, si algo se rompe en producción (como el bug de CallMeBot que
     tardamos horas en encontrar a mano) solo te enteras si un cliente se
     queja. Con Sentry, cualquier error del navegador de CUALQUIER cliente
     te llega a un dashboard al instante, con la línea de código exacta.

     CONFIGURACIÓN REQUERIDA (una sola vez, gratis, sin tarjeta):
     1) Crea una cuenta en sentry.io
     2) Crea un proyecto tipo "Browser JavaScript"
     3) Copia el DSN que te dan (una URL larga tipo
        "https://xxxxx@xxxxx.ingest.sentry.io/xxxxx")
     4) Reemplaza SENTRY_DSN abajo por ese valor.
     Mientras SENTRY_DSN siga en placeholder, este script simplemente no
     hace nada (no rompe el sitio, solo no reporta nada todavía). ----->
<script defer src="https://browser.sentry-cdn.com/8.9.2/bundle.tracing.min.js" crossorigin="anonymous"></script>
<script defer>
(function(){
  const SENTRY_DSN = "https://66015226e2d084d348a0d2c5598cd8df@o4511911661207552.ingest.us.sentry.io/4511928659410944"; // <- pega aquí tu DSN de sentry.io
  if (typeof Sentry !== 'undefined' && SENTRY_DSN.indexOf('TU_SENTRY_DSN') === -1) {
    Sentry.init({
      dsn: SENTRY_DSN,
      tracesSampleRate: 0.1, // 10% de las sesiones, suficiente para monitoreo sin gastar tu cuota gratis rápido
      environment: 'production'
    });
    window.zyReportError = function(err, context){
      try{ Sentry.captureException(err, { extra: { context } }); }catch(e){}
    };
    // [CLAVE] En vez de editar cada uno de los ~35 catch(e){ console.error(...) }
    // que ya existen en el sitio (uno por uno, con riesgo de romper algo),
    // interceptamos console.error UNA sola vez aquí. Así CUALQUIER error que
    // ya se registraba en consola (visible solo si tú abrías F12 tú mismo)
    // ahora también llega a tu dashboard de Sentry automáticamente — pasado
    // y futuro, sin tocar el resto del código.
    const originalConsoleError = console.error.bind(console);
    console.error = function(...args){
      originalConsoleError(...args);
      try{
        const errArg = args.find(a => a instanceof Error);
        Sentry.captureException(errArg || new Error(args.map(a => typeof a === 'string' ? a : JSON.stringify(a)).join(' ')));
      }catch(e){}
    };
  } else {
    // Sin DSN configurado: se queda igual que antes (solo consola), para
    // no romper nada mientras activas Sentry.
    window.zyReportError = function(err, context){
      console.error('[sin Sentry configurado]', context, err);
    };
  }
})();
</script>

