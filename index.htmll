  if(!box) return;
  const url = zySettings.heroBgVideo;
  box.innerHTML = url
    ? `<div class="zy-thumb" style="width:96px;"><video src="${zyEscapeHtml(url)}" muted playsinline></video><button type="button" class="zy-thumb-x" onclick="zyRemoveHeroBgVideo()" aria-label="Quitar video">&times;</button></div>`
    : `<p class="zy-hint" style="padding:4px 0;">Sin video todavía — el hero usa la foto de arriba (o el respaldo automático).</p>`;
}
