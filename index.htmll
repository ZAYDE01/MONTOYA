  Relojes: ["Cronógrafo Acero","Automático 40mm","Field Watch Piel","Dress Watch Piel","Diver Cerámica 200m"],
  "Zapatos": ["Runner Low","Trail Mid","Court Vintage","Basketball High","Knit Racer","Terrain High","Slip-On Low","Basketball '04"],
  "Joyería": ["Cadena Cubana","Anillo Sello Grabado","Aretes Argolla","Pulsera Eslabón","Dije Piedra Natural","Collar Capas"],
  Gorras: ["Gorra Snapback Bordada","Gorra Trucker Malla","Gorra Beisbolera Curva","Gorra Dad Hat Algodón","Gorra Fitted Lisa","Beanie Tejido Logo"],
  Otros: ["Cinturón Piel Hebilla Logo","Cartera Piel Bifold","Set Llavero y Correa","Paraguas Automático Logo","Calcetines Pack 3","Guantes Piel Forrados"]
};
/* [PERFUMES] Presentaciones disponibles en el panel: 10 ml a 250 ml, de 5 en 5. */
const PERFUME_ML_SIZES = Array.from({length:49}, (_,i)=>(10+i*5)+' ml');
const PERFUME_FILTER_SIZES = ["10 ml","30 ml","50 ml","75 ml","100 ml","150 ml","200 ml","250 ml"];
/* [GORRAS] Tallas New Era (fitted): talla en pulgadas -> circunferencia en cm. */
const CAP_NEWERA = [
  ["6 7/8","54.9"],["7","55.8"],["7 1/8","56.8"],["7 1/4","57.7"],["7 3/8","58.7"],["7 1/2","59.6"],
  ["7 5/8","60.6"],["7 3/4","61.5"],["7 7/8","62.5"],["8","63.5"],["8 1/8","64.5"],["8 1/4","65.4"]
];
const CAP_CM = Object.fromEntries(CAP_NEWERA);
const CAT_SIZES = {
  Ropa: ["XS","S","M","L","XL","XXL"],
  Perfumes: ["30 ml","50 ml","75 ml","100 ml","125 ml","150 ml","200 ml"],
  Bolsos: ["Mini","Pequeño","Mediano","Grande","Maxi","Unitalla"],
  Lentes: ["Chico","Mediano","Grande","Única"],
  Relojes: ["28 mm","32 mm","36 mm","38 mm","40 mm","42 mm","44 mm","46 mm","Única"],
  "Joyería": ["Única","Ajustable","Anillo 5","Anillo 6","Anillo 7","Anillo 8","Anillo 9","Anillo 10","Anillo 11","Anillo 12","Anillo 13","Pulsera S","Pulsera M","Pulsera L","Collar 40 cm","Collar 45 cm","Collar 50 cm","Collar 60 cm"],
  Gorras: [...CAP_NEWERA.map(x=>x[0]),"Única","Ajustable"],
  Otros: ["Única"]
};
/* Tallas de Zapatos segmentadas por género/edad, cada una con su talla máxima */
const SNEAKER_GENDERS = ["Hombre","Mujer","Niños"];
/* [ZAPATOS] Tallas de medio en medio (7, 7.5, 8, 8.5…). Se guardan como texto. */
const zyHalfSteps = (from, to)=>{ const out=[]; for(let v=from; v<=to+1e-9; v+=0.5) out.push(String(v)); return out; };
const SNEAKER_SIZES_BY_GENDER = {
  Hombre: zyHalfSteps(6, 15),
  Mujer: zyHalfSteps(5, 12),
  "Niños": zyHalfSteps(1, 7)
};
/* ============================================================
   [TALLAS MX] Los zapatos se GUARDAN con la escala US (stock, carrito, pedidos),
   pero al cliente se le MUESTRAN en talla MX: "26" + "MX" en chico.
   Hombre: MX = US + 18 · Mujer: MX = US + 16.5 · Niños: tabla propia.
   ============================================================ */
const ZY_MX_KIDS = {"1":"20","1.5":"20.5","2":"21","2.5":"21.5","3":"22","3.5":"22.5","4":"23","4.5":"23.5","5":"23.5","5.5":"24","6":"24","6.5":"24.5","7":"25"};
function zyShoeMx(p, size){
  try{
    if(!p || p.category!=='Zapatos' || size==null) return null;
    const k = String(size).trim().replace(/y$/i,''); const n = parseFloat(k); if(!isFinite(n)) return null;
    let mx;
    if(p.gender==='Niños') mx = ZY_MX_KIDS[String(n)];
    else if(p.gender==='Mujer') mx = n + 16.5;
    else mx = n + 18;
    return mx==null ? null : String(mx);
  }catch(e){ return null; }
}
function zyProdById(id){ try{ return (typeof PRODUCTS!=='undefined' && PRODUCTS.find(x=>String(x.id)===String(id))) || null; }catch(e){ return null; } }
/* texto plano: "26 MX" (zapatos) o la talla tal cual (ropa, etc.) */
function zyTallaTxt(p, size){ const m = zyShoeMx(p, size); return m ? (m + ' MX') : String(size); }
/* HTML: "26" + MX en chico */
function zyTallaHtml(p, size){ const m = zyShoeMx(p, size); return m ? (m + '<small class="zy-mx">MX</small>') : String(size); }
/* valores del filtro de talla: zapatos = "26 MX" */
function zyFilterSizeVals(p){ return (p.sizes||[]).map(x=>{ const m = zyShoeMx(p, x); return m ? (m + ' MX') : String(x); }); }
/* etiqueta de filtro con "MX" en chico */
function zyMxLabHtml(t){ const e = String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); return e.replace(/^(.*?) MX$/, '$1<small class="zy-mx">MX</small>'); }
