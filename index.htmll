    "Fear of God Essentials","Hermès","Chrome Hearts","Carolina Herrera"]
};
const BRANDS = Object.values(BRANDS_BY_CAT).flat();
const CATS_DEFAULT = ["Ropa","Perfumes","Bolsos","Lentes","Relojes","Zapatos","Joyería","Gorras","Otros"];
/* [CATEGORÍAS] CATS ya no es fija: se carga desde AdminStore en init() (ver
   zyApplyCategorySettings) y se puede agregar/quitar/renombrar/reordenar
   desde la pestaña "Categorías" del panel admin. Empieza con el set por
   defecto mientras carga lo guardado, para que la primera pintura del sitio
   nunca se vea vacía. */
let CATS = CATS_DEFAULT.slice();
let zyCategoryImages = {}; // { "NombreCategoria": "https://... o data:image/..." } — portada manual opcional por categoría
// [ZAYDE G · PORTADAS DE CATEGORÍA] Portadas manuales de las categorías del INICIO de ZAYDE G. Van aparte de
// zyCategoryImages a propósito: el almacén de ZAYDE G está separado del de ZAYDE, así que una foto subida
// para uno nunca aparece en el otro.
let zyCategoryImagesG = {};
let zyCatRenameMap = {}; // { "NombreDeFábrica": "NombreActual" } — para que los 42 productos de muestra sigan su categoría tras un renombrado, incluso después de recargar la página
const NAMES = {
