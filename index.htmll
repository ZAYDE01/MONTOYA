<style>
/* ===== tarjeta animada ===== */
.zc-wrap{perspective:1000px;display:flex;justify-content:center;margin:6px 0 18px;}
.zc-card{position:relative;width:300px;max-width:100%;aspect-ratio:1.586;transition:transform .5s cubic-bezier(.2,.8,.2,1);}
.zc-card.act:not(.flip){transform:rotateX(4deg) rotateY(-5deg) scale(1.02);}
.zc-glow{position:absolute;inset:0;border-radius:18px;box-shadow:0 0 0 0 transparent;transition:box-shadow .4s;}
.zc-card.ok .zc-glow{box-shadow:0 0 26px 4px #1fb573,0 0 62px 18px rgba(31,181,115,.35);}
.zc-card.bad .zc-glow{box-shadow:0 0 26px 4px #e5484d,0 0 62px 18px rgba(229,72,77,.3);}
.zc-card.busy .zc-glow{box-shadow:0 0 30px 6px var(--signal);animation:zcPulse 1s ease-in-out infinite;}
@keyframes zcPulse{50%{opacity:.35}}
.zc-inner{position:absolute;inset:0;transform-style:preserve-3d;transition:transform .7s cubic-bezier(.2,.8,.2,1);}
.zc-card.flip .zc-inner{transform:rotateY(180deg);}
.zc-face{position:absolute;inset:0;border-radius:18px;padding:20px;box-sizing:border-box;backface-visibility:hidden;-webkit-backface-visibility:hidden;color:#fff;overflow:hidden;
  background:linear-gradient(135deg,#0b1230 0%,#1b2f8f 55%,#2F5FFF 100%);box-shadow:0 14px 34px rgba(10,20,70,.35);}
.zc-face::before{content:'';position:absolute;inset:0;background:repeating-linear-gradient(115deg,rgba(255,255,255,.06) 0 2px,transparent 2px 14px);pointer-events:none;}
.zc-back{transform:rotateY(180deg);padding:0;}
.zc-front{display:flex;flex-direction:column;justify-content:space-between;}
.zc-top{display:flex;justify-content:space-between;align-items:center;}
.zc-top b{font-size:13px;letter-spacing:.16em;}
.zc-chip{width:40px;height:30px;border-radius:6px;background:linear-gradient(135deg,#f3dc9b,#b8963f);}
.zc-num{font:600 19px/1 'Courier New',monospace;letter-spacing:.1em;text-shadow:0 1px 0 rgba(0,0,0,.4);opacity:.9;}
.zc-card.has .zc-num{opacity:1;}
.zc-bot{display:flex;justify-content:space-between;gap:10px;font-size:12px;letter-spacing:.06em;}
.zc-bot small{display:block;font-size:8px;opacity:.65;margin-bottom:3px;}
.zc-bot span{font-weight:600;}
.zc-mag{height:44px;background:#05070f;margin-top:26px;}
.zc-sig{margin:18px 20px 0;padding:10px 12px;background:rgba(255,255,255,.92);color:#111;border-radius:6px;display:flex;justify-content:space-between;align-items:center;}
.zc-sig small{font-size:9px;letter-spacing:.1em;}
.zc-state{position:absolute;inset:0;display:none;align-items:center;justify-content:center;border-radius:18px;background:rgba(5,10,40,.55);color:#fff;}
.zc-state svg{display:none;width:54px;height:54px;color:#1fb573;}
.zc-spin{display:none;width:34px;height:34px;border:3px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:zcSp .7s linear infinite;}
@keyframes zcSp{to{transform:rotate(360deg);}}
.zc-card.busy .zc-state,.zc-card.paid .zc-state{display:flex;}
.zc-card.busy .zc-spin{display:block;}
.zc-card.paid .zc-state svg{display:block;}
.zc-card.paid .zc-glow{box-shadow:0 0 26px 4px #1fb573,0 0 62px 18px rgba(31,181,115,.35);}
.zc-fields label{display:block;font-size:10.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--steel);margin-bottom:10px;}
.zc-fields .stripe-card-element{margin-top:6px;}
.zc-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
@media(prefers-reduced-motion:reduce){.zc-card,.zc-inner{transition:none;}.zc-card.busy .zc-glow,.zc-spin{animation:none;}}
</style>

<style>
.zy-help{max-width:1360px;margin:0 auto;padding:36px 32px 28px;border-top:1px solid var(--line);}
.zy-help-head h3{font-size:15px;letter-spacing:.14em;margin:0 0 6px;}
.zy-help-head p{font-size:13.5px;color:var(--steel);margin:0 0 22px;max-width:560px;}
.zy-help-grid{display:grid;grid-template-columns:340px 1fr;gap:32px;align-items:start;}
.zy-help-card{padding:24px;border:1px solid var(--line);border-radius:var(--r-md);background:var(--surface);}
.zy-help-card h4{font-size:12px;letter-spacing:.08em;text-transform:uppercase;margin:0 0 10px;}
.zy-help-tel{display:block;font-size:24px;font-weight:800;color:var(--text);margin-bottom:8px;}
.zy-help-card p{font-size:13px;color:var(--steel);margin:0 0 16px;}
.zy-help-btns{display:flex;gap:10px;margin-bottom:14px;}.zy-help-btns .btn{flex:1;justify-content:center;text-align:center;}
.zy-help-link{all:unset;cursor:pointer;font-size:13px;font-weight:700;color:var(--signal);margin:2px 16px 2px 0;}
.zy-help-link:hover{text-decoration:underline;}
.zy-help-faq details{border-bottom:1px solid var(--line);}
.zy-help-faq summary{cursor:pointer;list-style:none;padding:16px 0;font-size:14px;font-weight:700;display:flex;justify-content:space-between;}
.zy-help-faq summary::-webkit-details-marker{display:none;}
.zy-help-faq summary::after{content:'+';font-size:18px;color:var(--steel);}
.zy-help-faq details[open] summary::after{content:'–';}
.zy-help-faq details>p{font-size:13.5px;color:var(--steel);margin:0 0 12px;line-height:1.6;}
.zy-help-faq details[open]{padding-bottom:16px;}
.zy-help-form{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:6px;}
.zy-help-form input,.zy-help-form select,.zy-help-form textarea{box-sizing:border-box;width:100%;padding:11px 12px;font:inherit;font-size:13px;color:var(--text);background:var(--surface-dim);border:1px solid var(--line);border-radius:var(--r-sm);}
.zy-help-form input:focus,.zy-help-form select:focus,.zy-help-form textarea:focus{outline:none;border-color:var(--signal);box-shadow:0 0 0 3px var(--signal-dim);}
.zy-help-form textarea,.zy-help-form .btn,.zy-help-form #zfRazon,.zy-help-form #zfMail{grid-column:1/-1;}
.zy-help-legal{padding-top:16px;}
@media(max-width:900px){.zy-help{padding:28px 16px 20px;}.zy-help-grid{grid-template-columns:1fr;}.zy-help-form{grid-template-columns:1fr;}}
</style>
<script>
function zyHelpSend(kind){
  const v=id=>(document.getElementById(id)?.value||'').trim(); let msg;
  {
    if(!v('zqNombre')||v('zqMsg').length<10){showToast('Escribe tu nombre y un mensaje',true);return;}
    msg=`Hola, soy ${v('zqNombre')}. ${v('zqTipo')} sobre ${v('zqPedido')?'mi pedido '+v('zqPedido'):'ZAYDE'}:\n${v('zqMsg')}`;
  }
  window.open('https://wa.me/523332539967?text='+encodeURIComponent(msg),'_blank');
}
</script>


<!-- ============================================================
     [MODAL DE POLÍTICAS] Devoluciones · Verificación · Términos
     Contenido formal inspirado en los estándares de la industria
     de piezas auténticas (StockX, Nike). Se abre desde el pie de
     página; nunca desde datos de contacto personales.
     ============================================================ -->
<div class="overlay" id="overlayPolicy" onclick="closePolicyModal()"></div>
<div class="checkout-modal" id="policyModal">
  <div class="policy-panel">
    <div class="policy-head">
      <div class="policy-title-row">
        <h3 id="policyModalTitle" data-zt="policy.head.title" data-zg="Modal de políticas">Políticas ZAYDE</h3>
        <!-- [WHATSAPP] Por pedido del cliente (2ª ronda): se quita también
             este botón directo a WhatsApp dentro de Ayuda. Ahora el ÚNICO
             camino para que el cliente escriba por WhatsApp es que el
             chatbot se lo mande (según su propia lógica/flujo), nunca un
             botón visible que el cliente pueda tocar por su cuenta. -->
        <button class="policy-close" onclick="closePolicyModal()" aria-label="Cerrar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="policy-tabs">
        <button class="policy-tab" id="ptab-sobre" onclick="showPolicyTab('sobre')" data-zt="policy.tab.sobre" data-zg="Modal de políticas">Sobre ZAYDE</button>
        <button class="policy-tab" id="ptab-tallas" onclick="zyApplySizeGuideFilter(null); showPolicyTab('tallas')" data-zt="policy.tab.tallas" data-zg="Modal de políticas">Guía de tallas</button>
        <button class="policy-tab" id="ptab-devoluciones" onclick="showPolicyTab('devoluciones')" data-zt="policy.tab.devoluciones" data-zg="Modal de políticas">Devoluciones</button>
        <button class="policy-tab" id="ptab-verificacion" onclick="showPolicyTab('verificacion')" data-zt="policy.tab.verificacion" data-zg="Modal de políticas">Verificación</button>
        <button class="policy-tab" id="ptab-faq" onclick="showPolicyTab('faq')" data-zt="policy.tab.faq" data-zg="Modal de políticas">FAQ</button>
        <button class="policy-tab" id="ptab-terminos" onclick="showPolicyTab('terminos')" data-zt="policy.tab.terminos" data-zg="Modal de políticas">Términos</button>
        <button class="policy-tab" id="ptab-privacidad" onclick="showPolicyTab('privacidad')" data-zt="policy.tab.privacidad" data-zg="Modal de políticas">Privacidad</button>
      </div>
    </div>
    <div class="policy-body">

      <!-- ---- SOBRE ZAYDE ---- -->
      <div class="policy-section" id="psec-sobre">
        <p class="policy-lead" data-zt="policy.sob.lead" data-zg="Modal de políticas">ZAYDE es una plataforma mexicana de reventa de piezas nuevas de lujo y streetwear, verificadas antes de salir de nuestro centro de distribución — pensada para comprar marcas de alta gama con la misma confianza y trazabilidad de las principales plataformas de reventa autenticada del mundo.</p>

        <div class="policy-badge-row">
          <div class="policy-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg><span data-zt="policy.sob.badge1" data-zg="Modal de políticas">100% verificado</span></div>
          <div class="policy-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg><span data-zt="policy.sob.badge2" data-zg="Modal de políticas">Envío asegurado</span></div>
          <div class="policy-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span data-zt="policy.sob.badge3" data-zg="Modal de políticas">5 días de devolución</span></div>
        </div>

        <h4 data-zt="policy.sob.h1" data-zg="Modal de políticas">Qué encuentras en ZAYDE</h4>
        <p data-zt="policy.sob.p1" data-zg="Modal de políticas">Manejamos nueve categorías: Ropa, Perfumes, Bolsos, Lentes, Relojes, Zapatos, Joyería, Gorras y Otros, con marcas que van desde streetwear y zapatos hasta lujo clásico, entre muchas otras. Todas las piezas son <b>Nuevas</b>, con empaque y accesorios originales, verificadas antes de publicarse.</p>

        <h4 data-zt="policy.sob.h2" data-zg="Modal de políticas">Cómo compramos y vendemos</h4>
        <ul>
          <li data-zt="policy.sob.c1" data-zg="Modal de políticas">Cada pieza pasa por nuestro proceso de verificación de múltiples puntos antes de publicarse o enviarse — ver el apartado de Verificación para el detalle completo.</li>
          <li data-zt="policy.sob.c5" data-zg="Modal de políticas">ZAYDE vende de inventario propio a precio fijo: el precio que ves es el precio final, sin ofertas ni contraofertas que negociar. Nuestra ventaja frente a otras plataformas está en la curaduría de cada pieza y la velocidad de entrega, no en el volumen de listados.</li>
          <li data-zt="policy.sob.c2" data-zg="Modal de políticas">El pago se hace directo en el sitio con tarjeta, de forma segura, a través de Stripe.</li>
          <li data-zt="policy.sob.c3" data-zg="Modal de políticas">Envíos a todo México por Estafeta, FedEx o DHL Express, directo a tu domicilio.</li>
          <li data-zt="policy.sob.c4" data-zg="Modal de políticas">También manejamos pedidos de mayoreo para revendedores; puedes solicitar información de precios por volumen desde la sección "Elige tu línea · Mayoreo" del catálogo.</li>
        </ul>

        <h4 data-zt="policy.sob.h3" data-zg="Modal de políticas">Confianza ante todo</h4>
        <p data-zt="policy.sob.p2" data-zg="Modal de políticas">No respaldamos ni estamos afiliados a las marcas que vendemos: revendemos piezas auténticas de terceros bajo un estándar de verificación propio. Si algo no corresponde a su descripción, se reembolsa el 100% de tu compra.</p>
      </div>

      <!-- ---- GUÍA DE TALLAS ---- -->
      <div class="policy-section" id="psec-tallas">
        <p class="policy-lead" data-zt="policy.tal.lead" data-zg="Modal de políticas">Cada categoría en ZAYDE usa su propio sistema de tallas. Si tienes duda entre dos tallas, elige la mayor — la mayoría de nuestras piezas son de corte regular de fábrica.</p>

        <div data-sizecat="Ropa">
          <h4 id="sizeGuideRopa" data-zt="policy.tal.h1" data-zg="Modal de políticas">Ropa</h4>
          <p data-zt="policy.tal.p1" data-zg="Modal de políticas">Tallas disponibles: XS, S, M, L, XL, XXL. El corte varía según cada pieza: algunas líneas de streetwear vienen en corte oversize, mientras que otras líneas más clásicas mantienen un corte regular. Consulta la ficha de cada producto para el detalle de su corte específico.</p>
          <p class="zy-hint" style="margin:-4px 0 10px;">Medidas de referencia (corte regular). Si tu talla queda entre dos números, o la pieza es oversize, te conviene bajar una talla.</p>
          <div class="size-table-wrap">
            <table class="size-table">
              <thead><tr><th>Talla</th><th>Pecho (cm)</th><th>Cintura (cm)</th><th>Cadera (cm)</th></tr></thead>
              <tbody>
                <tr><td>XS</td><td>84–88</td><td>68–72</td><td>90–94</td></tr>
                <tr><td>S</td><td>89–93</td><td>73–77</td><td>95–99</td></tr>
                <tr><td>M</td><td>94–98</td><td>78–83</td><td>100–104</td></tr>
                <tr><td>L</td><td>99–104</td><td>84–90</td><td>105–110</td></tr>
                <tr><td>XL</td><td>105–111</td><td>91–98</td><td>111–117</td></tr>
                <tr><td>XXL</td><td>112–119</td><td>99–106</td><td>118–125</td></tr>
              </tbody>
            </table>
          </div>
        </div>

        <div data-sizecat="Zapatos">
          <h4 id="sizeGuideSneakers" data-zt="policy.tal.h2" data-zg="Modal de políticas">Zapatos</h4>
          <p data-zt="policy.tal.p2b" data-zg="Modal de políticas">Las tallas de los zapatos se muestran en numeración MX (México), con medios números (26, 26.5, 27…). Aquí abajo tienes su equivalencia en US, UK y EU, según el género de la pieza.</p>
          <p class="zy-hint" style="margin:-4px 0 10px;" data-zt="policy.tal.p2c" data-zg="Modal de políticas">MX es la numeración mexicana (el número en centímetros de la etiqueta de la caja). Pie (cm) es el largo real de tu pie, del talón al dedo más largo. Equivalencias basadas en la guía oficial de Nike; pueden variar media talla según la marca y el modelo.</p>

          <h5 class="size-subhead" data-zt="policy.tal.sh1" data-zg="Modal de políticas">Hombre · US 6 a 15</h5>
          <div class="size-table-wrap">
            <table class="size-table">
              <thead><tr><th>US Hombre</th><th>MX</th><th>UK</th><th>EU</th><th>Pie (cm)</th></tr></thead>
              <tbody>
                <tr><td>6</td><td>24</td><td>5.5</td><td>38.5</td><td>23.7</td></tr>
                <tr><td>6.5</td><td>24.5</td><td>6</td><td>39</td><td>24.1</td></tr>
