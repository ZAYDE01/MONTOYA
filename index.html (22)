function zyFixShipAmount(v){
  const nuevo = '$' + Number(ZY_FREE_SHIP_THRESHOLD).toLocaleString('en-US');
  if(typeof v === 'string'){
    if(!/env[ií]o|shipping/i.test(v)) return v;
    return v.replace(/\$\s?1,?(?:000|800)(?!\d|,\d)/g, nuevo);
  }
  if(Array.isArray(v)) return v.map(zyFixShipAmount);
  if(v && typeof v === 'object'){ const o = {}; Object.keys(v).forEach(k=>{ o[k] = zyFixShipAmount(v[k]); }); return o; }
  return v;
}
