   updateCheckoutTotals(). */
function zyRenderCheckoutSummaryItems(){
  const wrap = document.getElementById('ckSummaryItems');
  if(!wrap) return;
  const html = cart.map(c=>{
    if(c.isMembership || c.isGiftCard){
      const isBlackTier = c.isMembership && /black/i.test(c.tierName || '');
      const imgClass = c.isGiftCard ? 'ci-img-giftcard' : `ci-img-membership${isBlackTier ? ' ci-img-membership-black' : ''}`;
      return `
      <div class="ck-summary-item">
        <div class="ci-img ${imgClass}">
          ${c.isMembership ? `<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l2.9 6.3L22 9l-5 5.1L18.2 22 12 18.4 5.8 22 7 14.1 2 9l7.1-.7L12 2z"/></svg>` : ''}
        </div>
        <div class="ci-info">
          <div class="ci-name">${zyEscapeHtml(c.name)}</div>
          <div class="ci-meta">${c.isMembership ? 'Membresía digital' : 'Tarjeta de regalo digital'}</div>
        </div>
        <div class="ci-price mono">${fmt(c.price*c.qty)}</div>
      </div>`;
    }
    const p = PRODUCTS.find(x=>x.id===c.id);
    const realImg = p && p.images && p.images[0];
    return `
    <div class="ck-summary-item">
      <div class="ci-img${realImg ? '' : ' is-fallback'}">${realImg ? `<img src="${realImg}" alt="${zyEscapeHtml(c.name)}" onerror="this.parentElement.classList.add('is-fallback'); this.remove();">` : ''}</div>
      <div class="ci-info">
        <div class="ci-name">${zyEscapeHtml(c.brand)} — ${zyEscapeHtml(c.name)}</div>
        <div class="ci-meta">Talla ${zyEscapeHtml(zyTallaTxt(zyProdById(c.id),c.size))} · Cant. ${c.qty}</div>
      </div>
      <div class="ci-price mono">${fmt(c.price*c.qty)}</div>
    </div>`;
  }).join('');
  wrap.innerHTML = html;
  const rv = document.getElementById('ckReviewItems');   // [CHECKOUT 3 PASOS] mismo listado dentro del paso RESUMEN
  if(rv) rv.innerHTML = html;
}
