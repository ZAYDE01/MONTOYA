/* [TARJETA DE REGALO · CAMPO ÚNICO + SALDO EN EL PEDIDO + MIS TARJETAS]
   Un solo campo (carrito y PAGO): si el texto es un cupón se aplica el descuento; si no, se canjea como
   tarjeta de regalo y su saldo se descuenta del pedido (lo que sobra queda guardado en la cuenta). */
var zyGiftOptOut = false;   // el cliente decidió NO usar su saldo en este pedido
var zyGiftCards = [];
function zyGiftToUse(base){
  base = Number(base)||0;
  if(zyGiftOptOut || cart.some(zyIsDigitalItem)) return 0;       // el saldo no se usa para comprar membresías ni otras tarjetas de regalo
  let g = Math.max(0, Math.min(Number(zyGiftBalance)||0, base));
  if(base - g > 0 && base - g < 10) g = Math.max(0, base - 10);   // Stripe no cobra menos de $10 MXN: si sobraría menos, se deja $10 para la tarjeta
  return g;
}
function zyCkTotalDue(){
  const subtotal = cart.reduce((a,c)=>a+c.price*c.qty,0);
  const after = Math.max(0, subtotal - zyCouponDiscount(subtotal));
  const base = after + computeShippingCost();
  return Math.max(0, base - zyGiftToUse(base));
}
function zyGiftCoversAll(){ return cart.length>0 && zyGiftToUse(1e12)>0 && zyCkTotalDue() < 0.5; }
