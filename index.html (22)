/* Muestra/oculta el panel de preferencias (marcas/colores/tallas) dentro
   de "Mi cuenta", en vez de tenerlo siempre visible ocupando toda la
   página — se abre solo si el cliente de verdad quiere tocarlo. */
function zyToggleAcctPrefs(){
  const panel = document.getElementById('acctPrefsPanel');
  const chevron = document.getElementById('acctPrefsChevron');
  if(!panel) return;
  const open = panel.style.display !== 'none';
  panel.style.display = open ? 'none' : 'block';
  if(chevron) chevron.style.transform = open ? '' : 'rotate(90deg)';
