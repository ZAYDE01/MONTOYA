function zyBotAudTest(tok, p){
  const g = normText(p.gender), br = normText(p.brand);
  const tx = normText([p.name,p.style,p.occasion,p.line,p.category].join(' '));
  if(tok==='mujer')  return /mujer|dama|femen|nina\b|ninas\b/.test(g) || /\b(mujer|dama)\b/.test(tx);
  if(tok==='hombre') return /hombre|caballero|mascul/.test(g) || /\b(hombre|caballero)\b/.test(tx);
  if(tok==='kids')   return /nin|infant|kid|junior|bebe/.test(g) || /\b(nino|nina|ninos|ninas|infantil|kids|junior|bebe)\b/.test(tx);
  if(tok==='lux')    return ZYBOT_LUX.indexOf(br) >= 0;
  if(tok==='sport')  return ZYBOT_SPORT.indexOf(br) >= 0 || /deport|running|basquet|basket|training|futbol|gym|trail|golf|tenis/.test(tx);
  return true;
}
function zyBotStoreOK(p){
  const cs = (typeof currentStore !== 'undefined' && currentStore === 'clothesg') ? 'clothesg' : 'zayde';
  return (p.store || 'zayde') === cs;
}
function zyBotHasAnyStock(p){
  const totalStock = p.stock ? Object.values(p.stock).reduce((a,b)=>a+(Number(b)||0),0) : 1;
  return totalStock>0;
}
// [FIX tallas] Las tallas de Zapatos se guardan como TEXTO ("8.5"), no como
// número. Antes se comparaba contra un número y la talla "no existía" aunque
// sí hubiera stock. Ahora todo se compara como texto.
function zyBotSizeKey(s){
  let k = String(s==null?'':s).trim().toUpperCase().replace(',', '.').replace(/\s+/g,' ');
  if(/^\d+(\.\d+)?$/.test(k)) k = String(Number(k));   // "8.0" == "8"
  return k;
}
function zyBotHasSize(p, sz){
  const k = zyBotSizeKey(sz);
  const real = (p.sizes || []).map(String).find(s=>zyBotSizeKey(s)===k);
  if(real===undefined) return false;
  return p.stock ? (Number(p.stock[real]) || 0) > 0 : true;
}
function zyBotSortForSelling(list){
  return list.slice().sort((a,b)=>{
    const da = a.discountPct||0, db = b.discountPct||0;
    if(db!==da) return db-da;
    const ta = a.trend==='up' ? (a.trendPct||0) : 0, tb = b.trend==='up' ? (b.trendPct||0) : 0;
    return tb-ta;
  });
}
// Piezas de la categoría y línea pedidas (sin filtrar talla).
function zyBotPool(cat, aud, gender){
  return (PRODUCTS||[]).filter(p=>{
    if(p.category !== cat) return false;
    if(!zyBotStoreOK(p)) return false;
    if(cat==='Ropa' || cat==='Zapatos'){
      if(gender && !zyBotAudTest(ZYBOT_GENDER_TOKEN[gender], p)) return false;
      if(aud==='lux' || aud==='sport'){ if(!zyBotAudTest(aud, p)) return false; }
    }
    return true;
  });
}
function zyBotSizesFor(cat, gender){
  let base = [];
  if(cat==='Zapatos') base = (SNEAKER_SIZES_BY_GENDER[gender] || []).slice();
  else if(cat==='Ropa'){
    if(gender==='Niños'){
      zyBotPool('Ropa', 'kids', 'Niños').forEach(p=>(p.sizes||[]).map(String).forEach(x=>{ if(!base.includes(x)) base.push(x); }));
    }
    if(!base.length) base = CAT_SIZES.Ropa.slice();
  } else return [];
  // [CHATBOT · TALLAS REALES] Además de la escala fija, se suman las tallas que de verdad existen en tus
  // productos (ej. pantalones 28/30/32). Antes el bot contestaba "no manejo la talla X" aunque sí la tuvieras.
  try{
    const have = new Set(base.map(zyBotSizeKey)), extra = [];
    zyBotPool(cat, null, gender||null).forEach(p=>(p.sizes||[]).map(String).forEach(x=>{
      const k = zyBotSizeKey(x); if(!have.has(k)){ have.add(k); extra.push(x); }
    }));
    extra.sort((a,b)=>{ const na=parseFloat(a), nb=parseFloat(b); return (!isNaN(na)&&!isNaN(nb)) ? na-nb : String(a).localeCompare(String(b)); });
    base = base.concat(extra);
  }catch(e){}
  return base;
}
function zyBotDescribe(cat, aud, gender){
  const a = {mujer:'de mujer', hombre:'de hombre', kids:'infantiles', lux:'de diseñador', sport:'deportivos'}[aud] || '';
  const g = ((aud==='lux' || aud==='sport') && gender) ? ' (' + gender + ')' : '';
  return (String(cat).toLowerCase() + ' ' + a + g).trim();
}
function zyBotFindMatches(cat, size, aud, gender){
  return zyBotSortForSelling(zyBotPool(cat, aud, gender).filter(p=> size!=null ? zyBotHasSize(p, size) : zyBotHasAnyStock(p))).slice(0,4);
}
// Talla más cercana en stock dentro de la MISMA categoría y línea
// (Zapatos: ±1 talla US; Ropa: la talla de al lado).
function zyBotFindNearbySizeMatches(cat, size, aud, gender){
  if(size==null) return [];
  const scale = zyBotSizesFor(cat, gender);
  const idx = scale.indexOf(String(size));
  if(idx < 0) return [];
  const maxSteps = (cat==='Zapatos') ? 2 : 1;
  const out = [];
  zyBotSortForSelling(zyBotPool(cat, aud, gender)).forEach(p=>{
    if(out.length>=4) return;
    let best = null, bestD = Infinity;
    scale.forEach((sc,i)=>{
      if(i===idx) return;
      const d = Math.abs(i-idx);
      if(d>maxSteps || d>=bestD) return;
      if(zyBotHasSize(p, sc)){ best = sc; bestD = d; }
    });
    if(best!=null) out.push({product:p, size:best});
  });
  return out;
}
function zyBotFindCategoryMatches(cat, aud, gender){
  return zyBotSortForSelling(zyBotPool(cat, aud, gender).filter(zyBotHasAnyStock)).slice(0,4);
}

/* ================================================================
   [CHATBOT · INVENTARIO EN VIVO] Consulta por PRODUCTO concreto.
   Cuando el cliente nombra una pieza (marca/modelo) y pregunta por talla,
   disponibilidad o stock, el bot responde directo de PRODUCTS — el mismo
   arreglo que se mantiene sincronizado con Firestore (inventory/stock) —
   en el instante de la pregunta. No pasa por la IA, así nunca inventa
   que "no cuenta con X talla" ni que "no tiene X producto".
   ================================================================ */
const ZYBOT_STOPWORDS = new Set(['de','la','el','los','las','un','una','unos','unas','para','que','con','me','mi','mis','por','favor','hola','buenas','buenos','dias','tardes','noches','tienen','tienes','tiene','hay','talla','tallas','numero','disponible','disponibles','busco','quiero','necesito','en','y','o','a','al','del','lo','se','si','como','cual','cuales','cuanto','esta','estan','este','esa','ese','stock','queda','quedan','quedaron','existencia','agotado','agotada','piezas','pieza','modelo','color','precio','venden','vende','manejan','maneja','todavia','aun','ahorita','hoy','mx','us','cm','mm','tu','su','sus','mas','muy','algun','alguna','tipo','medida','es','son','un','le','les','ver','saber','puedo','puede','podria','ayuda']);
function zyBotSizesInStock(p){
  const sizes = (p.sizes||[]).map(String);
  if(!p.stock) return sizes;
  return sizes.filter(s=>(Number(p.stock[s])||0)>0);
}
function zyBotSoldOutSizes(p){
  if(!p.stock) return [];
  return (p.sizes||[]).map(String).filter(s=>!((Number(p.stock[s])||0)>0));
}
// Catálogo compacto con el stock del MOMENTO: se manda a la IA con cada mensaje para que responda con datos frescos.
function zyBotLiveCatalog(){
  try{
    return (PRODUCTS||[]).filter(zyBotStoreOK).slice(0,300).map(p=>({
      id:p.id, brand:p.brand||'', name:p.name||'', category:p.category||'', gender:p.gender||'', price:p.price||0,
      inStock: zyBotHasAnyStock(p),
      sizesInStock: zyBotSizesInStock(p),
      soldOutSizes: zyBotSoldOutSizes(p)
    }));
  }catch(e){ return []; }
}
function zyBotExtractSize(q){
  let m = q.match(/(?:talla|numero|num|#|mx|us)\s*(?:de\s*|es\s*)?(\d{1,2}(?:[.,]\d)?)\b/) || q.match(/\ben\s+(?:talla\s+)?(\d{1,2}(?:[.,]\d)?)\b/);
  if(m) return String(Number(m[1].replace(',','.')));
  m = q.match(/talla\s*(xxl|xl|xs|s|m|l)\b/) || q.match(/\ben\s+(xxl|xl|xs|s|m|l)\b/);
  if(m) return m[1].toUpperCase();
  return null;
}
function zyBotProductLookup(raw){
  const q = zyBotNormalize(raw);
  if(/guia de tallas|tabla de tallas|como medir|como se mide|equivalenc|devol|cambio|reembolso|envio|rastre|pedido|pago|factura|mayoreo/.test(q)) return null;
  const size = zyBotExtractSize(q);
  const wantsAvail = size!=null || /talla|numero|medida|tienen|tienes|\bhay\b|disponible|stock|queda|existencia|agotad|todavia|aun /.test(q);
  if(!wantsAvail) return null;
  const cleaned = q
    .replace(/(?:talla|numero|num|mx|us|en)\s*#?\s*\d{1,2}(?:[.,]\d)?\b/g,' ')
    .replace(/(?:talla\s*|\ben\s+)(?:xxl|xl|xs|s|m|l)\b/g,' ');
  const tokens = cleaned.replace(/[^a-z0-9\s]/g,' ').split(/\s+/).filter(t=>t && t.length>=2 && !ZYBOT_STOPWORDS.has(t));
  if(!tokens.length) return null;
  const scored = [];
  (PRODUCTS||[]).forEach(p=>{
    if(!zyBotStoreOK(p)) return;
    const brandWords = normText(p.brand).replace(/[^a-z0-9\s]/g,' ').split(/\s+/).filter(Boolean);
    const words = new Set(normText([p.brand,p.name,p.sku].join(' ')).replace(/[^a-z0-9\s]/g,' ').split(/\s+/).filter(Boolean));
    let score = 0, brandHit = false;
    tokens.forEach(t=>{
      const hit = words.has(t) || (t.length>=4 && [...words].some(w=>w.startsWith(t)));
      if(hit){ score++; if(brandWords.includes(t) || (t.length>=4 && brandWords.some(w=>w.startsWith(t)))) brandHit = true; }
    });
    if(score>=2 || (score>=1 && brandHit)) scored.push({p, score});
  });
  if(!scored.length) return null;
  scored.sort((a,b)=> b.score-a.score || (zyBotHasAnyStock(b.p)?1:0)-(zyBotHasAnyStock(a.p)?1:0));
  const top = scored[0].score;
  const list = scored.filter(x=>x.score===top).map(x=>x.p).slice(0,4);
  return {list, size};
}
function zyBotSizeListText(arr){
  if(!arr.length) return '';
  return arr.length>8 ? arr.slice(0,8).join(', ')+'…' : arr.join(', ');
}
function zyBotShowProductAvailability(list, size){
  zyBotTypingShow();
  setTimeout(()=>{
    zyBotTypingHide();
    // Se lee el stock AQUÍ, en el momento de responder (no al armar el flujo).
    const nm = zyBotGreetName();
    const rows = list.map(p=>{
      const ins = zyBotSizesInStock(p);
      const has = size!=null ? zyBotHasSize(p, size) : null;
      return {p, ins, has};
    });
    const anyStock = rows.some(r=>r.ins.length>0);
    const sizeLbl = size!=null ? `talla ${size}` : '';
    let head;
    if(size!=null){
      const withSize = rows.filter(r=>r.has);
      if(withSize.length) head = `¡Sí${nm}! Revisé el inventario ahorita y tengo ${sizeLbl} disponible 👇`;
      else if(anyStock) head = `Revisé el inventario ahorita${nm}: en ${sizeLbl} no me queda, pero sí tengo otras tallas disponibles 👇`;
      else head = `Revisé el inventario ahorita${nm}: por el momento está agotado 😕`;
    } else {
      head = anyStock ? `Revisé el inventario en este momento${nm}. Esto es lo que tengo, con sus tallas disponibles 👇`
                      : `Revisé el inventario ahorita${nm}: por el momento está agotado 😕`;
    }
    zyBotAppendMsg('bot', head, zyBotNowLabel(), {anchorStart:true});
    const cards = rows.map(r=>{
      let note;
      if(size!=null){
        if(r.has) note = `Talla ${size}: disponible ✅` + (r.ins.length>1 ? ` · Otras: ${zyBotSizeListText(r.ins.filter(s=>zyBotSizeKey(s)!==zyBotSizeKey(size)))}` : '');
        else note = r.ins.length ? `Talla ${size}: agotada · Disponibles: ${zyBotSizeListText(r.ins)}` : 'Agotado por ahora';
      } else {
        note = r.ins.length ? `Tallas disponibles: ${zyBotSizeListText(r.ins)}` : 'Agotado por ahora';
      }
      return zyBotMiniCardHTML(r.p, (size!=null && r.has) ? size : null, note);
    }).join('');
    zyBotAppendHTML(`<div class="zybot-cards">${cards}</div>`, {scroll:false});
    const needNotify = size!=null ? !rows.some(r=>r.has) : !anyStock;
    if(needNotify){
      const desc = String(((rows[0].p.brand||'')+' '+(rows[0].p.name||'')).trim()).replace(/['"<>]/g,'');
      zyBotAppendMsg('bot', 'Si quieres, te aviso en cuanto vuelva a entrar.', zyBotNowLabel(), {scroll:false});
      zyBotAppendHTML(`<div class="zybot-quick">${zyBotNotifyBtnHTML('pieza', size, desc)}</div>`, {scroll:false, scrollCap:true});
    } else {
      zyBotAppendMsg('bot', 'Dale clic a la que te guste para ver todos los detalles y comprarla. ¿Te ayudo con algo más?', zyBotNowLabel(), {scroll:false, scrollCap:true});
    }
    zyBotAppendQuick({scroll:false});
  }, 500);
}

// ---- Entrada en texto libre ----
function zyBotParseShop(raw, ctxCat){
  const q = zyBotNormalize(raw);
  const out = {};
  if(/zapat|tenis|sneaker|calzado|zapatill|\bbotas?\b|tennis|air force|dunk|yeezy|jordan/.test(q)) out.cat = 'Zapatos';
  else if(/\b(ropa|playera|playeras|camisa|camisas|sudadera|sudaderas|hoodie|hoodies|chamarra|chamarras|pantalon|pantalones|jeans|short|shorts|vestido|blusa|polo|sueter|jogger|conjunto)\b/.test(q)) out.cat = 'Ropa';
  const cat = out.cat || ctxCat;
  let gender = null;
  if(/\b(nino|nina|ninos|ninas|infantil|infantiles|kids|bebe|junior)/.test(q)) gender = 'Niños';
  else if(/\b(mujer|mujeres|dama|damas|femenin)/.test(q)) gender = 'Mujer';
  else if(/\b(hombre|hombres|caballero|caballeros|masculin)/.test(q)) gender = 'Hombre';
  let special = null;
  if(/disenador|disenadores|lujo|luxury|gucci|prada|dior|balenciaga|louis vuitton|off-?white|amiri|rick owens|margiela/.test(q)) special = 'lux';
  else if(/deportiv|deporte|sport|running|correr|basquet|basket|futbol|gym|entrenar/.test(q)) special = 'sport';
  if(gender) out.gender = gender;
  out.aud = special || (gender ? ({'Hombre':'hombre','Mujer':'mujer','Niños':'kids'})[gender] : null);
  if(!out.aud) delete out.aud;
  const q2 = q.replace(/\d+\s*(anos|ano|meses|dias|pesos|mxn|ml|mm|cm|piezas)/g,'');
  if(cat==='Ropa'){
    let m = raw.match(/\b(XXL|XL|XS|S|M|L)\b/) || q.match(/talla\s*(xxl|xl|xs|s|m|l)\b/);
    if(m) out.size = m[1].toUpperCase();
    else if(/\bchica\b/.test(q)) out.size = 'S';
    else if(/\bmediana\b/.test(q)) out.size = 'M';
    else if(/\bgrande\b/.test(q)) out.size = 'L';
    else { const mn = q2.match(/(?:talla|numero|num|medida|cintura)\s*(?:de\s*|es\s*)?(\d{2}(?:\/\d{2})?)\b/); if(mn) out.size = mn[1]; }
  } else if(cat==='Zapatos' || /talla|calzo/.test(q)){
    let m = q2.match(/(?:talla|numero|num|#|calzo|uso|mx|us)\s*(?:de\s*|es\s*)?(\d{1,2}(?:[.,]\d)?)\b/);
    if(!m && cat==='Zapatos') m = q2.match(/\b(\d{1,2}(?:[.,]5)?)\b/);
    if(m){ const n = Number(m[1].replace(',','.')); if(!Number.isNaN(n)) out.size = String(n); }
  }
  return out;
}
function zyBotIsShopIntent(raw, parsed){
  const q = zyBotNormalize(raw);
  if(/guia de tallas|tabla de tallas|como medir|como se mide|equivalenc|devol|cambio|reembolso|envio|rastre|pedido|pago|factura|mayoreo/.test(q)) return false;
  if(parsed.cat) return !!(parsed.size || parsed.aud || /busco|quiero|necesito|tienen|tienes|\bhay\b|disponible|talla|mostrar|recomiend|comprar|me gustaria|ver /.test(q));
  return /talla|calzo/.test(q) && !!(parsed.size || /busco|quiero|necesito|tienen|tienes|\bhay\b|disponible|mi talla|mis tallas|que tallas/.test(q));
}

