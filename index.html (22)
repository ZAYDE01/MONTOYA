/* ================= RASTREO DE PEDIDO =================
   Busca el pedido guardado en este navegador por número de pedido o teléfono,
   y muestra una línea de tiempo. El estado YA NO avanza solo por tiempo:
   lo cambias tú manualmente desde el panel privado (pestaña Pedidos), y
   cada cambio dispara un aviso por email y WhatsApp al cliente. */
const ORDER_STAGES = [
  { key:'recibido',    label:'Pedido recibido' },
  { key:'verificando', label:'Verificando autenticidad' },
  { key:'preparando',  label:'Preparando envío' },
  { key:'camino',      label:'En camino' },
  { key:'entregado',   label:'Entregado' }
];
function zyComputeStageIndex(order){
  const idx = ORDER_STAGES.findIndex(s=>s.key === order.status);
  return idx === -1 ? 0 : idx;
}
// Ícono por etapa del stepper de rastreo — trazo simple (24×24, currentColor)
// para que herede el color blanco/gris/azul que le pone .zy-step-dot según
// esté cumplida, en curso o pendiente.
function zyStageIconSVG(key){
  const icons = {
    recibido: '<path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/>',
    verificando: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
    preparando: '<path d="M21 8L12 3 3 8l9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/>',
    camino: '<rect x="1" y="6" width="14" height="11" rx="1"/><path d="M15 10h4l3 3.5V17h-7z"/><circle cx="6" cy="19" r="2"/><circle cx="17" cy="19" r="2"/>',
    entregado: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9"/>'
  };
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[key]||icons.recibido}</svg>`;
}
// [RASTREO — ENTREGA ESTIMADA] Calcula un rango de fecha estimado a partir
// de la fecha del pedido y la forma de entrega — mismos plazos que ya se le
// comunican al cliente en el resto del sitio (3–5 días hábiles a domicilio,
// 1–2 días para recolección en sucursal). No es rastreo satelital real (ZAYDE
// no tiene integración con paquetería todavía): es una estimación con el
// mismo criterio que Mercado Libre/Amazon muestran antes de que el paquete
// tenga guía escaneada por la paquetería.
function zyOrderETAInfo(order){
  const stageIdx = zyComputeStageIndex(order);
  const isSucursal = order.shipMode === 'sucursal';
  const fmtDay = d => d.toLocaleDateString('es-MX', {weekday:'long', day:'numeric', month:'short'});
  if(order.status === 'entregado'){
    const hist = (order.statusHistory||[]).slice().reverse().find(h=>h.status==='entregado');
    const when = hist ? new Date(hist.at) : new Date(order.date);
    return { done:true,
      title: isSucursal ? 'Recogido en sucursal' : 'Entregado',
      sub: `Tu pedido quedó ${isSucursal?'recogido':'entregado'} el ${fmtDay(when)}, a las ${when.toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'})}.`
    };
  }
  const start = new Date(order.date);
  const addDays = n => { const d = new Date(start); d.setDate(d.getDate()+n); return d; };
  const [minD,maxD] = isSucursal ? [addDays(1), addDays(2)] : [addDays(3), addDays(5)];
  const rangeText = fmtDay(minD).split(',')[1] && fmtDay(minD)!==fmtDay(maxD)
    ? `entre el ${minD.getDate()} y el ${maxD.getDate()} de ${maxD.toLocaleDateString('es-MX',{month:'long'})}`
    : `el ${fmtDay(maxD)}`;
  const subByStage = {
    recibido: 'Ya registramos tu pedido y estamos por empezar a prepararlo.',
    verificando: 'Nuestro equipo está verificando la autenticidad de tu pieza antes de empacarla.',
    preparando: isSucursal ? 'Estamos preparando tu pedido para que lo recojas.' : 'Estamos empacando tu pedido para enviarlo.',
    camino: isSucursal ? 'Tu pedido está listo, o a punto de estarlo, para recolección.' : 'Tu pedido va en camino.',
  };
  return { done:false,
    title: isSucursal ? `Listo para recoger ${rangeText}` : `Entrega estimada ${rangeText}`,
    sub: subByStage[ORDER_STAGES[stageIdx].key] || ''
  };
}
// [RASTREO — STEPPER HORIZONTAL] Arma la fila de íconos conectados
// (recibido → verificando → preparando → en camino → entregado), con la
// barra y el ícono ya cumplidos en verde y el de la etapa actual "respirando"
// en azul de marca — mismo lenguaje visual que el rastreo de Mercado Libre/
// Amazon (ver captura de referencia del cliente), pero con el detalle propio
// del anillo pulsante en vez de solo un punto estático.
const ZY_STEP_SHORT_LABELS = { recibido:'Recibido', verificando:'Verificando', preparando:'Preparando', camino:'En camino', entregado:'Entregado' };
function zyTrackingStepperHTML(order){
  const stageIdx = zyComputeStageIndex(order);
  return `<div class="zy-stepper">${ORDER_STAGES.map((s,i)=>{
    const filled = i < stageIdx, current = i === stageIdx;
    return `<div class="zy-step${filled?' filled':''}${current?' current':''}">
      <span class="zy-step-line"></span>
      <span class="zy-step-dot">${zyStageIconSVG(s.key)}</span>
      <span class="zy-step-label">${ZY_STEP_SHORT_LABELS[s.key]}</span>
    </div>`;
  }).join('')}</div>`;
}
// [RASTREO — DETALLE CRONOLÓGICO] Lista de "Detalles de rastreo" con fecha y
// hora real de cada cambio de estado (más reciente arriba), igual que la
// tabla de eventos de Mercado Libre/Amazon. Usa order.statusHistory, que se
// va llenando solo cada vez que tú avanzas la etapa desde el panel privado
// (ver zyAdminAdvanceOrderStatus). Pedidos de antes de este cambio no tienen
// historial guardado, así que se muestra solo el estado actual conocido.
const ORDER_STAGE_EVENT_LABELS = { recibido:'Pedido recibido', verificando:'Autenticidad en verificación', preparando:'Pedido preparado para envío', camino:'Pedido en camino', entregado:'Pedido entregado' };
function zyTrackingDetailsHTML(order){
  let hist = Array.isArray(order.statusHistory) && order.statusHistory.length ? order.statusHistory.slice() : [{status: order.status||'recibido', at: order.date}];
  hist = hist.slice().sort((a,b)=>b.at-a.at);
  return `<div class="zy-track-details">
    <div class="order-card-section-title">Detalles de rastreo</div>
    ${hist.map((h,i)=>{
      const when = new Date(h.at);
      const timeText = `${when.toLocaleDateString('es-MX',{weekday:'long', day:'numeric', month:'short'})}, ${when.toLocaleTimeString('es-MX',{hour:'2-digit',minute:'2-digit'})}`;
      return `<div class="zy-track-detail-row${i===0?' is-latest':''}">
        <span class="zy-track-detail-dot"></span>
        <span class="zy-track-detail-time">${timeText}</span>
        <span class="zy-track-detail-label">${ORDER_STAGE_EVENT_LABELS[h.status]||h.status}</span>
      </div>`;
    }).join('')}
  </div>`;
}
// [MEMBRESÍAS/GIFT CARD · SIN SEGUIMIENTO FÍSICO] Un pedido "100% digital"
// (solo membresía y/o tarjeta de regalo, sin ninguna prenda/producto real)
// no tiene nada que armar, verificar o enviar — por eso en varios lugares
// se trata distinto a un pedido físico normal.
function zyIsDigitalOnlyOrder(order){
  return (order.items||[]).length>0 && (order.items||[]).every(it=>it.isMembership || it.isGiftCard);
}
// Caso más estrecho: SOLO membresía, sin tarjeta de regalo de por medio.
// Aquí ni siquiera hay un código de regalo que guardar, así que este tipo
// de "pedido" no necesita aparecer como tal en ningún lado — el aviso de
// bienvenida a la membresía ya lo dice todo.
function zyIsMembershipOnlyOrder(order){
  return zyIsDigitalOnlyOrder(order) && (order.items||[]).some(it=>it.isMembership) && !(order.items||[]).some(it=>it.isGiftCard);
}

/* Arma la tarjeta completa de un pedido (usada tanto para "tu pedido más
   reciente" como para el resultado de una búsqueda de rastreo), con estado,
   línea de tiempo, productos, entrega y totales — todo en un solo lugar
   con look profesional, en vez de solo una línea de tiempo suelta. */
function zyRenderOrderCard(order, opts){
  opts = opts || {};
  const stageIdx = zyComputeStageIndex(order);
  const stageLabel = ORDER_STAGES[stageIdx].label;
  const isDigitalOrder = (order.items||[]).length>0 && (order.items||[]).every(it=>it.isMembership || it.isGiftCard);
  const deliverHTML = isDigitalOrder
    ? `Compra digital — sin envío<br>Tu membresía y/o tarjeta de regalo ya están activas en tu cuenta.`
    : order.shipMode === 'sucursal'
    ? `Recoger en <b>${order.branch ? order.branch.name : 'sucursal'}</b><br>${order.branch ? order.branch.addr : ''}`
    : `Envío a domicilio<br>${order.address || ''}, ${order.city || ''}, ${order.state || ''}${order.zip ? ', CP '+order.zip : ''}`;
  /* [PEDIDOS-NIKE] Cada pieza se muestra con su foto real (buscada en
     PRODUCTS por id, igual que hace el carrito) en vez de solo texto. */
  const itemsHTML = (order.items || []).map(it => {
    const p = (typeof PRODUCTS !== 'undefined') ? PRODUCTS.find(x=>x.id===it.id) : null;
    const img = p && p.images && p.images[0];
    const descBits = [];
    if(it.isMembership) descBits.push(`Membresía ${zyEscapeHtml(it.tierName || '')}`);
    else if(it.isGiftCard) descBits.push('Tarjeta de regalo digital');
    else { if(it.brand) descBits.push(zyEscapeHtml(it.brand)); if(it.size) descBits.push('Talla '+zyEscapeHtml(zyTallaTxt(zyProdById(it.id),it.size))); }
    // [FIX] Igual que la tarjeta de regalo, una membresía tampoco tiene
    // foto de producto que buscar en PRODUCTS — antes caía sin querer en
    // el mismo placeholder genérico de "foto no disponible" (ícono roto)
    // que un producto real con la imagen caída. Ahora usa su propio
    // distintivo, igual que en el carrito y en el checkout.
    return `
