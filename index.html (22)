/* ================= [CHECKOUT EN 3 PASOS] ENVÍO · PAGO · RESUMEN =================
   1 ENVÍO: contacto + domicilio/sucursal.  2 PAGO: tarjeta (Stripe, aún sin cobrar).
   3 RESUMEN: revisión de todo y botón "Confirmar pedido", que es el único que cobra
   (confirmOrder sigue siendo el mismo, con sus mismas validaciones de respaldo). */
let zyCkStep = 1;
function zyCkValidateEnvio(){
  const v = id => ((document.getElementById(id) || {}).value || '').trim();
  if(!v('ckName') || !v('ckPhone')){ showToast('Completa tus datos de contacto para continuar', true); return false; }
  const email = v('ckEmail');
  if(email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ showToast('Ese correo no se ve válido — revísalo o déjalo en blanco', true); return false; }
  if(!cart.length){ showToast('Tu carrito está vacío', true); return false; }
  if(cart.every(zyIsDigitalItem)) return true;   // compra 100% digital: no lleva envío
  if(shipMode === 'sucursal'){
    if(!selectedBranch){ showToast('Elige la sucursal donde quieres recoger tu pedido', true); return false; }
    return true;
  }
  if(!v('ckAddress') || !v('ckCity') || !v('ckZip') || !v('ckState')){ showToast('Completa tu dirección de envío para continuar', true); return false; }
  if(!/^\d{5}$/.test(v('ckZip'))){ showToast('El código postal debe tener 5 dígitos', true); return false; }
  if(!MX_STATES.includes(v('ckState'))){ showToast('Por ahora solo enviamos dentro de México', true); return false; }
  { const mxErr = zyMexicoAddressError(); if(mxErr){ showToast(mxErr, true); return false; } }
  return true;
}
function zyCkValidatePago(){
  if(zyGiftCoversAll()) return true;   // el saldo de la tarjeta de regalo cubre todo: no se pide tarjeta de crédito/débito
  if(stripeCardElement && !window.zyCardComplete){
    const errEl = document.getElementById('stripeCardErrors');
    if(errEl && !errEl.textContent) errEl.textContent = 'Completa los datos de tu tarjeta para continuar.';
    showToast('Completa los datos de tu tarjeta para continuar', true);
    return false;
  }
  return true;
}
function zyCkGoStep(n){
  n = Math.max(1, Math.min(3, n));
  if(n >= 2 && zyCkStep < 2 && !zyCkValidateEnvio()) return;
  if(n >= 3 && zyCkStep < 3 && !zyCkValidatePago()) n = 2;
  zyCkStep = n;
  [1,2,3].forEach(i=>{
    const pane = document.getElementById('ckPane' + i);
    if(pane) pane.classList.toggle('page-hidden', i !== n);
    const b = document.getElementById('ckStepBtn' + i);
    if(b){ b.classList.toggle('active', i === n); b.classList.toggle('done', i < n); }
  });
  const acc = document.getElementById('ckSummaryAcc');
  if(acc) acc.classList.toggle('page-hidden', n === 3);   // en RESUMEN ya se ve todo completo
  if(n === 3) zyRenderCheckoutReview();
  if(n === 1){
    setTimeout(()=>{ [typeof zyDeliveryMap !== 'undefined' && zyDeliveryMap, typeof estafetaMap !== 'undefined' && estafetaMap].forEach(m=>{ if(m && m.invalidateSize) m.invalidateSize(); }); }, 60);
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
function zyRenderCheckoutReview(){
  const box = document.getElementById('ckReview');
  if(!box) return;
  const esc = zyEscapeHtml;
  const v = id => ((document.getElementById(id) || {}).value || '').trim();
  const allDigital = cart.length > 0 && cart.every(zyIsDigitalItem);
  const contact = [v('ckName'), v('ckPhone'), v('ckEmail')].filter(Boolean).map(esc).join('<br>');
  let delivery;
  if(allDigital){
    delivery = 'Compra digital — sin envío.';
  } else if(shipMode === 'sucursal' && selectedBranch){
    delivery = `Recoger en sucursal<br><b>${esc(CARRIERS[selectedCarrier].label)} · ${esc(selectedBranch.name)}</b><br><span>${esc(selectedBranch.addr)}</span>`;
  } else {
    const opt = SHIP_OPTIONS.find(o=>o.id===selectedShip);
    const method = zyIsFreeShipping() ? 'Envío gratis' : (opt ? opt.name : '');
    delivery = `Envío a domicilio${method ? ' · ' + esc(method) : ''}<br><b>${esc(v('ckAddress'))}</b><br><span>${esc(v('ckCity'))}, ${esc(v('ckState'))}, CP ${esc(v('ckZip'))}</span>`
      + (zyDeliveryCoords ? '<br><span>Pin de entrega marcado en el mapa</span>' : '');
  }
  const block = (title, body, step)=>`<div class="ck-review-block"><div class="ck-review-head"><h5 class="ck-h">${title}</h5><button type="button" class="ck-edit" onclick="zyCkGoStep(${step})">Editar</button></div><div class="ck-review-body">${body}</div></div>`;
