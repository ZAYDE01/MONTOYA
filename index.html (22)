    </article>`;
  };
  const active = cards.filter(c=>Number(c.balance)>0), used = cards.filter(c=>!(Number(c.balance)>0));
  const total = active.reduce((a,c)=>a+(Number(c.balance)||0),0);
  box.innerHTML = (active.length
      ? `<div class="zy-gc-total"><div><small>Saldo disponible</small><b>${fmt(total)}</b></div><span>${active.length} ${active.length===1?'tarjeta activa':'tarjetas activas'}</span></div><div class="zy-gc-grid">${active.map(mk).join('')}</div>`
