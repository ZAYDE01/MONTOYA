   Canal de email propio (a diferencia de WhatsApp, que es un canal
   prestado). Aparece una sola vez por navegador, después de un momento de
   lectura, y no vuelve a mostrarse tras cerrarse o suscribirse — se
   recuerda con Store igual que dropNotify. */
function zyOpenNewsletterPopup(){
  document.getElementById('nlOverlay').classList.add('open');
  document.getElementById('nlPopup').classList.add('open');
}
async function zyCloseNewsletterPopup(){
  document.getElementById('nlOverlay').classList.remove('open');
  document.getElementById('nlPopup').classList.remove('open');
  try{ await Store.set('zayde:newsletterPopupSeen', true); }catch(e){}
