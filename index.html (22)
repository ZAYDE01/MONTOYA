function zyRenderGiftCards(){
  const sec = document.getElementById('giftCardsMine'), box = document.getElementById('giftCardsList');
  if(!sec || !box) return;
  sec.style.display = 'block';
  let cards = zyGiftCards.slice();
  const tracked = cards.reduce((a,c)=>a+(Number(c.balance)||0),0);
  if(zyGiftBalance - tracked > 0.5) cards.push({ balance: zyGiftBalance - tracked });   // saldo de antes de la lista por tarjeta
