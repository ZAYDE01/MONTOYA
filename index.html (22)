  if(currentPage === 'account'){ navigate('home'); }
  if(hadRealAccount && typeof firebase !== 'undefined' && firebaseReady){ try{ await firebase.auth().signOut(); }catch(e){} }
}

let toastTimer;
// [UX] Los avisos de confirmación (recuadro blanco con palomita) ya no se
// muestran — se pidió que solo aparezcan los avisos de ERROR (rojos), por
// ejemplo cuando algo falla o falta llenar un campo obligatorio. Por eso,
// si showToast() se llama sin isError=true, ahora no hace nada.
function showToast(msg, isError){
  if(!isError) return;
  const t = document.getElementById('toast');
  const icon = document.getElementById('toastIcon');
  document.getElementById('toastMsg').textContent = msg;
  t.classList.toggle('toast-error', !!isError);
  if(icon){
    icon.innerHTML = isError
      ? '<circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/>'
      : '<path d="M20 6L9 17l-5-5"/>';
  }
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 2600);
}

/* ================= COMPARTIR PRODUCTO =================
   Botón de compartir en cada tarjeta de producto y en la ficha de producto.
   - En celular, si el navegador soporta la Web Share API nativa (compartir a
     cualquier app instalada: WhatsApp, Instagram, Mensajes, correo, etc.) se
     usa esa directamente.
   - Si no está disponible (la mayoría de navegadores de escritorio), se abre
     una hoja propia con accesos directos a WhatsApp, Facebook, X, Telegram,
     correo y "copiar enlace", para poder compartir en todos lados. */
let zyShareTarget = null;
function zyProductShareData(id){
  const p = PRODUCTS.find(x=>x.id===id) || (typeof UPCOMING!=='undefined' ? UPCOMING.find(x=>x.id===id) : null);
  if(!p) return null;
  const canonical = document.querySelector('link[rel="canonical"]');
  const base = canonical ? canonical.href.replace(/\/$/,'').replace(/\/(catalogo|producto|favoritos|mayoreo)(\/.*)?$/,'') : (location.origin || '');
  const url = `${base}/producto/${p.id}`;
  const title = `${p.brand} ${p.name}`;
  const text = `Mira esta pieza en ZAYDE: ${title} — ${fmt(p.price)}`;
  return { p, url, title, text };
}
async function shareProduct(id, event){
  if(event){ event.preventDefault(); event.stopPropagation(); }
  if(!id) return;
  const data = zyProductShareData(id);
  if(!data) return;
  zyShareTarget = data;
  if(navigator.share){
    try{
      await navigator.share({ title: data.title, text: data.text, url: data.url });
      return;
    }catch(e){
      // El usuario canceló el share nativo, o el navegador lo rechazó: caemos
      // a la hoja propia de todas formas para no dejarlo sin opciones.
      if(e && e.name === 'AbortError') return;
    }
  }
  openShareSheet(data);
}
function openShareSheet(data){
  const { url, text } = data;
  const enc = encodeURIComponent;
  document.getElementById('shareOptWa').href = `https://wa.me/?text=${enc(text + ' ' + url)}`;
  document.getElementById('shareOptWaBusiness').href = `https://wa.me/${ZY_WHATSAPP_NUMBER}?text=${enc('Hola, me interesa esta pieza y quisiera más información: ' + text + ' ' + url)}`;
  document.getElementById('shareOptFb').href = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
  document.getElementById('shareOptTw').href = `https://twitter.com/intent/tweet?text=${enc(text)}&url=${enc(url)}`;
  document.getElementById('shareOptTg').href = `https://t.me/share/url?url=${enc(url)}&text=${enc(text)}`;
  document.getElementById('shareOptMail').href = `mailto:?subject=${enc(data.title)}&body=${enc(text + '\n\n' + url)}`;
  document.getElementById('shareSheet').classList.add('open');
  document.getElementById('shareSheetOverlay').classList.add('open');
}
function closeShareSheet(){
  document.getElementById('shareSheet').classList.remove('open');
  document.getElementById('shareSheetOverlay').classList.remove('open');
}
async function zyCopyShareLink(){
  if(!zyShareTarget) return;
  try{
    await navigator.clipboard.writeText(zyShareTarget.url);
    showToast('Enlace copiado');
  }catch(e){
    showToast(zyShareTarget.url);
  }
  closeShareSheet();
}
document.getElementById('shareOptCopy').addEventListener('click', zyCopyShareLink);

/* ================= THEME ================= */
function toggleTheme(){
  const html = document.documentElement;
  html.setAttribute('data-theme', html.getAttribute('data-theme')==='dark' ? 'light':'dark');
}
/* [PERFIL-TEMA] Igual que toggleTheme(), pero además actualiza en vivo el
   switch y el texto ("Modo oscuro"/"Modo claro") de la fila en Perfil →
   Preferencias, sin tener que volver a dibujar toda la página de cuenta. */
function zyToggleThemeFromProfile(btn){
  toggleTheme();
  const isDark = document.documentElement.getAttribute('data-theme')==='dark';
  if(btn){
    btn.classList.toggle('active', isDark);
    const label = btn.parentElement.querySelector('b');
    const sub = document.getElementById('acctThemeSub');
    if(label) label.textContent = `Modo ${isDark?'oscuro':'claro'}`;
    if(sub) sub.textContent = isDark ? 'Fondo oscuro, texto claro' : 'Fondo claro, texto oscuro';
  }
}

