  if(zybotFlow && zybotFlow.type==='askName'){
    zyBotHandleNameInput(val);
    return;
  }
  // [ZAYDE Bot con IA] Todo lo que el cliente escribe libremente (no los
  // botones de opciones, que ya tienen respuesta exacta) se manda a la
  // función en la nube para que la IA responda cualquier pregunta sobre
  // ZAYDE, incluido el rastreo de un pedido real si el cliente da su
  // número de pedido y teléfono.
  // [CHATBOT · TALLAS] Primero: si el flujo guiado está esperando un dato
  // (línea, género o talla) y el texto lo trae, se usa. Después: si el
  // cliente está buscando ropa/zapatos/tallas, arranca el flujo guiado
  // (preguntando solo lo que falte) en vez de mandarlo a la IA.
  if(zyBotFlowHandleText(val)) return;
  // [CHATBOT · INVENTARIO EN VIVO] ¿Pregunta por una pieza concreta (marca/modelo) + talla/stock? Se responde con el stock actual.
  const prodHit = zyBotProductLookup(val);
  if(prodHit){ zyBotShowProductAvailability(prodHit.list, prodHit.size); return; }
  const shop = zyBotParseShop(val, null);
  if(zyBotIsShopIntent(val, shop)){
    zybotFlow = {type:'cat', cat:shop.cat||null, aud:shop.aud||null, gender:shop.gender||null, size:(shop.size!=null?shop.size:null)};
    zyBotFlowNext();
    return;
  }
  zyBotAskAI(val);
}
// Llama a la Cloud Function "zybotAsk" (Gemini + Firestore) para que la
// IA responda EN LENGUAJE NATURAL cualquier pregunta del cliente sobre
// ZAYDE. Si la función no está disponible (sin internet, aún no
// desplegada, Firebase bloqueado, etc.), cae de vuelta a las respuestas
// locales de siempre (zyBotFindAnswer) para que el chat nunca se quede
// sin contestar.
function zyBotAskAI(message){
  zyBotTypingShow();
  const historySnapshot = zybotAiHistory.slice();
  zybotAiHistory.push({role:'user', text: message});
  if(zybotAiHistory.length > 20) zybotAiHistory = zybotAiHistory.slice(-20);

  if(!zyBotFns){
    zyBotTypingHide();
    zyBotReply(zyBotFindAnswer(message));
    return;
  }
  const askFn = zyBotFns.httpsCallable('zybotAsk');
  askFn({ message, history: historySnapshot, catalog: zyBotLiveCatalog(), catalogAt: Date.now() })
    .then(res=>{
      zyBotTypingHide();
      const text = res && res.data && res.data.text;
      if(!text) throw new Error('Respuesta vacía de zybotAsk');
      zybotAiHistory.push({role:'model', text});
      zyBotAppendMsg('bot', text, zyBotNowLabel(), {anchorStart:true});
      zyBotAppendQuick({scroll:false});
    })
    .catch(err=>{
      zyBotTypingHide();
      console.error('zybotAsk falló, usando respuestas locales de respaldo:', err);
      zyBotReply(zyBotFindAnswer(message));
    });
}
