/* ============================================================
   [ZAYDE ID] Equivalente al "Pass" de Nike Member — con QR REAL y
   escaneable (vía qrcode.js, cargado arriba en el <head>). El código de
   socio (zyMemberCode) es real y único por cuenta: sale de un hash
   determinístico del uid de Firebase de esa cuenta, así que siempre es
   el mismo para esa persona en cualquier dispositivo donde inicie
   sesión, y nadie más obtiene ese mismo código (para eso se requiere
   haber iniciado sesión — ver openZaydePass). El texto codificado en el
   QR lleva el prefijo ZY_MEMBER_QR_PREFIX para que el escáner del panel
   (zyScanMemberQR) distinga un ZAYDE ID de cualquier otro QR que la
   cámara pudiera leer por error.
   Si por lo que sea la librería de QR no cargó (sin internet, bloqueada,
   etc.), se cae de vuelta al patrón visual determinístico de antes —
   ver zyRenderRealQR() — para que la tarjeta nunca se quede vacía. En
   ambos casos el código en texto de abajo sigue siendo la referencia
   real que el staff puede teclear a mano si el escaneo falla.
   ============================================================ */
const ZY_MEMBER_QR_PREFIX = 'ZYMEMBER:';
/* Dibuja el QR dentro de containerId. Usa QRCode.js si cargó (QR real,
   escaneable con cualquier cámara); si no, cae al patrón SVG decorativo
   de respaldo para que la tarjeta del socio nunca se vea rota. */
function zyRenderRealQR(containerId, text, size){
  size = size || 168;
  const el = document.getElementById(containerId);
  if(!el) return;
  el.innerHTML = '';
  if(typeof QRCode !== 'undefined'){
    try{
      new QRCode(el, { text, width: size, height: size, colorDark:'#0E0E12', colorLight:'#ffffff', correctLevel: QRCode.CorrectLevel.M });
      return;
    }catch(e){ console.error('No se pudo generar el QR real, se usa el patrón de respaldo:', e); }
  }
  el.innerHTML = zyGenIdPatternSVG(text);
}
function zyHashStr(s){
  let h = 0;
  for(let i=0;i<s.length;i++){ h = (h<<5) - h + s.charCodeAt(i); h |= 0; }
  return Math.abs(h);
}
function zyMemberCode(key){
  // Sin argumento, usa la cuenta actual (uso normal en el ZAYDE ID propio).
  // Con argumento (un ownerKey de un pedido), recalcula el código de
  // CUALQUIER cliente — así el escáner del panel puede reconocer a quién
  // pertenece un QR sin necesitar una tabla aparte de "usuarios".
  const h = zyHashStr(key || userKey()).toString(36).toUpperCase().padStart(8,'0').slice(0,8);
  return 'ZY-'+h;
}
function zySeededRandom(seed){
  let s = seed % 2147483647; if(s<=0) s += 2147483646;
  return function(){ s = (s*16807) % 2147483647; return (s-1)/2147483646; };
}
function zyGenIdPatternSVG(seed){
  const n = 21, cell = 8, pad = 8, size = n*cell + pad*2;
  const rand = zySeededRandom(zyHashStr(seed)||1);
  const isFinder = (r,c)=> (r<7&&c<7) || (r<7&&c>=n-7) || (r>=n-7&&c<7);
  let mods = '';
  for(let r=0;r<n;r++){
    for(let c=0;c<n;c++){
      if(isFinder(r,c)) continue;
      if(rand() < 0.48) mods += `<rect x="${pad+c*cell}" y="${pad+r*cell}" width="${cell}" height="${cell}" fill="#0E0E12"/>`;
    }
  }
  const finder = (fr,fc)=>`
    <rect x="${pad+fc*cell}" y="${pad+fr*cell}" width="${cell*7}" height="${cell*7}" fill="#0E0E12"/>
    <rect x="${pad+(fc+1)*cell}" y="${pad+(fr+1)*cell}" width="${cell*5}" height="${cell*5}" fill="#fff"/>
    <rect x="${pad+(fc+2)*cell}" y="${pad+(fr+2)*cell}" width="${cell*3}" height="${cell*3}" fill="#0E0E12"/>`;
  return `<svg viewBox="0 0 ${size} ${size}" width="168" height="168" xmlns="http://www.w3.org/2000/svg">
    <rect width="${size}" height="${size}" fill="#fff"/>
    ${mods}${finder(0,0)}${finder(0,n-7)}${finder(n-7,0)}
  </svg>`;
}
async function zyMemberSinceDate(){
