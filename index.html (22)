  }).catch(()=>{
    if(readout) readout.innerHTML = '<span class="geo-empty">No pudimos buscar la dirección ahora. Intenta con «Usar mi ubicación».</span>';
  });
}

/* ---------- Mapa de sucursales: Leaflet + teselas CARTO Voyager ----------
   Sin clave de API ni tarjeta. Se crea UNA sola vez; al cambiar de paquetería solo
   se actualizan los pines (del color de cada paquetería). Arranca centrado en la
   zona de Guadalajara (o en la ubicación/ciudad buscada) y solo muestra las
   sucursales cercanas. La librería se precarga al abrir el checkout y, si un CDN
   falla, prueba con otros dos. */
let mapsLoading = false, mapsReady = false;
let estafetaMap = null, userMarker = null, userAccCircle = null;
let branchMarkers = {};
let zyLeafletLoading = false, zyLeafletQueue = [];
const ZY_LEAFLET_SOURCES = [
  { css:'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css', js:'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js' },
  { css:'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css', js:'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js' },
  { css:'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css', js:'https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js' }
];
function zyEnsureLeaflet(cb, onFail){
  if(window.L){ cb(); return; }
  zyLeafletQueue.push({ cb, onFail });
  if(zyLeafletLoading) return;
  zyLeafletLoading = true;
  const flush = ok=>{ const q = zyLeafletQueue; zyLeafletQueue = []; zyLeafletLoading = false; q.forEach(x=>{ if(ok) x.cb(); else if(x.onFail) x.onFail(); }); };
  const tryLoad = i=>{
    if(i >= ZY_LEAFLET_SOURCES.length){ flush(false); return; }
    const src = ZY_LEAFLET_SOURCES[i];
    if(!document.querySelector('link[data-zy-leaflet]')){
      const link = document.createElement('link');
      link.rel = 'stylesheet'; link.href = src.css; link.setAttribute('data-zy-leaflet', '1');
      link.onerror = ()=>{ link.remove(); };
      document.head.appendChild(link);
    }
    const s = document.createElement('script');
    let settled = false;
    const next = ()=>{ if(settled) return; settled = true; s.remove(); tryLoad(i + 1); };
    const timer = setTimeout(next, 9000);
    s.src = src.js; s.async = true;
    s.onload = ()=>{ if(settled) return; settled = true; clearTimeout(timer); flush(!!window.L); };
    s.onerror = ()=>{ clearTimeout(timer); next(); };
    document.head.appendChild(s);
  };
  tryLoad(0);
}
function loadGoogleMaps(){ // se conserva el nombre para no romper el resto del código
