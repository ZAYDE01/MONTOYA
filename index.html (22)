    console.error(err);
    let msg = 'No se pudo completar el acceso. Intenta de nuevo.';
    if(err.code === 'auth/email-already-in-use') msg = 'Ese correo ya tiene una cuenta. Inicia sesión en vez de crear una nueva.';
    else if(err.code === 'auth/invalid-credential' || err.code === 'auth/wrong-password') msg = 'Correo o contraseña incorrectos.';
    else if(err.code === 'auth/user-not-found') msg = 'No existe una cuenta con ese correo. Créala primero.';
    else if(err.code === 'auth/weak-password') msg = 'La contraseña debe tener al menos 6 caracteres.';
    else if(err.code === 'auth/invalid-email') msg = 'Ese correo no es válido.';
    else if(err.code === 'auth/too-many-requests') msg = 'Demasiados intentos. Espera un momento e intenta de nuevo.';
    showToast(msg, true);
  } finally {
    zyExplicitAuthInProgress = false;
    if(btn){ btn.disabled = false; btn.textContent = loginMode==='signup' ? 'Crear cuenta' : 'Iniciar sesión'; }
  }
}
