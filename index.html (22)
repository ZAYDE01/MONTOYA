  cards.sort((a,b)=> ((Number(b.balance)>0)-(Number(a.balance)>0)) || (zyGcMillis(b.createdAt)-zyGcMillis(a.createdAt)));
  const mk = c=>{
    const bal = Number(c.balance)||0, orig = Number(c.original)||0, ms = zyGcMillis(c.createdAt), on = bal>0;
    const last4 = String(c.last4 || c.code || '').replace(/[^A-Za-z0-9]/g,'').slice(-4).toUpperCase();
    const date = ms ? new Date(ms).toLocaleDateString('es-MX',{day:'numeric',month:'long',year:'numeric'}) : '';
    return `<article class="zy-gc-tile${on?'':' off'}">
      <div class="zy-gc-tile-top"><span class="zy-gc-tile-brand">ZA<i>Y</i>DE</span><span class="zy-gc-badge${on?'':' off'}">${on?'Activa':'Usada'}</span></div>
