// [FIX] "La respuesta se va muy abajo y solo se ven las opciones" — antes
// CADA bloque agregado (mensaje, tarjetas de producto, botones rápidos)
// hacía scroll hasta el fondo del chat; en respuestas largas (guía de
// tallas con tarjetas + varios mensajes + botones) eso dejaba el inicio
// de la respuesta del bot oculto arriba y solo visibles los botones del
// final. Ahora, cuando arranca una respuesta nueva del bot, se hace scroll
// justo hasta el PRINCIPIO de ese mensaje (no hasta el fondo) — así el
// cliente siempre ve primero lo que el bot le contestó, en vez de aterrizar
// de golpe en los botones del final sin haber leído la respuesta.
//
// [FIX 2] "No hace scroll al mandar la respuesta / la respuesta se queda
// abajo oculta, hay que arrastrar el dedo" — el anclado de arriba se
// quedaba fijo ahí para siempre: si la respuesta tenía tarjetas o botones
// después del mensaje, esos bloques quedaban por debajo del área visible
// y nada volvía a mover el scroll, así que el cliente (sobre todo el de
// mayor edad, que no intuye que el cuadro del chat también se arrastra)
// nunca se enteraba de que había más. Ahora, tras mostrar el inicio de la
// respuesta, se le da un instante para leerlo y LUEGO el chat baja solo
// (con scroll suave) hasta el final, una vez que toda la respuesta
// (mensaje + tarjetas + botones) ya terminó de pintarse — sin que el
// cliente tenga que tocar nada. Si llega una respuesta nueva antes de que
// ese autoscroll se dispare, se reinicia el conteo para no interrumpir al
// cliente a media lectura.
function zyBotScrollToStart(el){
  const body = document.getElementById('zybotBody');
  if(!body || !el) return;
  body.scrollTop = Math.max(0, el.offsetTop - 6);
  zybotAutoScrollTargetEl = null; // cada respuesta nueva arranca sin tope fijo
  clearTimeout(zybotAutoScrollTimer);
  zybotAutoScrollTimer = setTimeout(()=>{
    const body2 = document.getElementById('zybotBody');
    if(!body2) return;
    // Si algún bloque de esta misma respuesta marcó un tope (p.ej. el final
    // de las tarjetas de producto), bajamos solo hasta ahí; si no, hasta el
    // fondo real del chat (comportamiento de siempre).
    const maxScroll = Math.max(0, body2.scrollHeight - body2.clientHeight);
    let top = body2.scrollHeight;
    if(zybotAutoScrollTargetEl){
      const targetBottom = zybotAutoScrollTargetEl.offsetTop + zybotAutoScrollTargetEl.offsetHeight;
      top = Math.min(maxScroll, Math.max(0, targetBottom - body2.clientHeight + 14));
    }
    body2.scrollTo({top, behavior:'smooth'});
  }, 1100);
}
function zyBotAppendHTML(html, opts){
  opts = opts || {};
  const body = document.getElementById('zybotBody');
  if(!body) return null;
  const wrap = document.createElement('div');
  wrap.innerHTML = html;
  const added = Array.from(wrap.childNodes);
  added.forEach(n => body.appendChild(n));
  const firstEl = added.find(n => n.nodeType === 1) || null;
  if(opts.scrollCap){
    // Este bloque (p.ej. tarjetas de producto) marca hasta dónde debe
    // llegar como máximo el autoscroll diferido de esta respuesta.
    const elements = added.filter(n => n.nodeType === 1);
    zybotAutoScrollTargetEl = elements[elements.length - 1] || firstEl || zybotAutoScrollTargetEl;
  }
  if(opts.anchorStart && firstEl){
    zyBotScrollToStart(firstEl);
  } else if(opts.scroll !== false){
    zyBotScrollDown();
  }
  return firstEl;
}
