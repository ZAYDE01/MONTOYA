/* ================= ADMINSTORE: AHORA SÍ COMPARTIDO ENTRE TODOS LOS VISITANTES =================
   Antes, todo lo que guardaba el panel privado (productos, ediciones,
   textos, reseñas de clientes) vivía SOLO en el navegador donde se hizo el
   cambio. Fuera de claude.ai (por ejemplo ya en Vercel) eso significa que
   si agregas un producto desde tu celular, alguien que entra desde el
   suyo NO lo ve — cada quien tenía "su propia versión" del sitio.

   Ahora, si Firestore está disponible (el mismo proyecto que ya usa el
   login de Google, arriba), los datos se guardan también ahí, para que
   cualquier visitante vea los mismos productos, textos y reseñas. Si
   Firestore no carga (sin conexión, bloqueador, etc.) todo se sigue
   guardando en el navegador como respaldo, así nunca se pierde nada.

   'zayde:admin:products' y 'zayde:admin:overrides' agrupan MUCHOS
   productos con fotos (guardadas como texto base64), y Firestore no
   permite documentos de más de 1 MB — una lista completa de productos
   con fotos lo supera muy rápido si se guarda como una sola pieza. Por
   eso esas dos claves se reparten: un documento por producto / por
   edición, en vez de todo junto en uno solo. El resto de las claves
   (textos, ajustes del inicio, reseñas por producto) son ligeras y se
   guardan tal cual, una por documento.

   IMPORTANTE: para que esto funcione necesitas permitir en las reglas de
   seguridad de Firestore (Firebase Console > Firestore Database > Reglas)
   lectura y escritura en las colecciones admin_products, admin_overrides
   y admin_meta — igual que ya lo permites para "orders". */
const AdminStore = {
  async get(key){
    if(typeof db !== 'undefined' && db){
      try{
        if(key === 'zayde:admin:products'){
          const snap = await db.collection('admin_products').get();
          const list = []; snap.forEach(doc=>list.push(doc.data()));
          if(list.length) return list;
        } else if(key === 'zayde:admin:overrides'){
          const snap = await db.collection('admin_overrides').get();
          const obj = {}; snap.forEach(doc=>{ obj[doc.id] = doc.data(); });
          if(Object.keys(obj).length) return obj;
        } else {
          const doc = await db.collection('admin_meta').doc(encodeURIComponent(key)).get();
          if(doc.exists) return doc.data().value;
        }
      }catch(e){ console.error('No se pudo leer de Firestore, se usa el respaldo local:', key, e); }
    }
    try{
      if(window.storage){ const r = await window.storage.get(key, true); return r ? JSON.parse(r.value) : null; }
    }catch(e){ /* sin window.storage: usamos localStorage abajo */ }
    try{ const raw = localStorage.getItem(key); return raw ? JSON.parse(raw) : null; }catch(e){ return null; }
  },
  async set(key, value){
    if(typeof db !== 'undefined' && db){
      try{
        if(key === 'zayde:admin:products'){
          const snap = await db.collection('admin_products').get();
          const batch = db.batch();
          snap.forEach(doc=>{ if(!value.find(p=>String(p.id)===doc.id)) batch.delete(doc.ref); });
          value.forEach(p=>{ batch.set(db.collection('admin_products').doc(String(p.id)), p); });
          await batch.commit();
        } else if(key === 'zayde:admin:overrides'){
          const snap = await db.collection('admin_overrides').get();
          const batch = db.batch();
          snap.forEach(doc=>{ if(!(doc.id in value)) batch.delete(doc.ref); });
          Object.keys(value).forEach(id=>{ batch.set(db.collection('admin_overrides').doc(id), value[id] || {}); });
          await batch.commit();
        } else {
          await db.collection('admin_meta').doc(encodeURIComponent(key)).set({ value });
        }
        // [EN VIVO] Avisa a cualquier pantalla abierta que hay cambios nuevos.
        if(String(key).indexOf('zayde:admin:') === 0 && key !== ZY_LIVE_VERSION_KEY) zyLiveBump();
      }catch(e){
        console.error('No se pudo guardar en Firestore (puede ser por fotos muy pesadas o reglas de seguridad):', key, e);
        if(typeof showToast === 'function') showToast('No se pudo sincronizar con la nube; se guardó solo en este navegador.', true);
      }
    }
    try{
      if(window.storage){ await window.storage.set(key, JSON.stringify(value), true); return; }
    }catch(e){ /* sin window.storage: usamos localStorage abajo */ }
    try{ localStorage.setItem(key, JSON.stringify(value)); }catch(e){}
  }
};
