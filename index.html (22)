async function zyNewsletterSignup(event){
  if(event) event.preventDefault();
  const emailEl = document.getElementById('nlEmail');
  const email = emailEl.value.trim();
  if(!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ showToast('Escribe un correo válido', true); return; }
  const emailKey = encodeURIComponent(email.toLowerCase());

  // [FIX — "BIENVENIDO10 se puede volver a canjear"] BIENVENIDO10 es un
  // código único compartido por todos (a diferencia de los cupones de
  // socio, que son aleatorios por cliente), así que la única forma real de
  // que sea "una vez por cliente" es revisar aquí, contra Firestore, si
  // ese correo ya se registró antes — el flag local del navegador
  // (zayde:newsletterPopupSeen) no sirve para esto porque se resetea en
  // otro navegador, en modo incógnito, o si se borra el storage. Si el
  // correo ya existe en newsletterSubscribers, no se le vuelve a mostrar
  // ni aplicar el código, sin importar desde dónde lo intente.
  let alreadySubscribed = false;
  try{
    if(db){
      const existing = await db.collection('newsletterSubscribers').doc(emailKey).get();
      alreadySubscribed = existing.exists;
    }
  }catch(e){ console.error('No se pudo revisar si el correo ya estaba registrado:', e); }

  if(alreadySubscribed){
    document.getElementById('nlPopup').innerHTML = `
      <button type="button" class="nl-popup-close" onclick="zyCloseNewsletterPopup()" aria-label="Cerrar">×</button>
      <h4>Ya estás registrado</h4>
      <p>Este correo ya usó su código de bienvenida antes — BIENVENIDO10 es válido una sola vez por cliente.</p>`;
    try{ await Store.set('zayde:newsletterPopupSeen', true); }catch(e){}
    showToast('Ese correo ya se había registrado antes', true);
    return;
  }

  // [SEGURIDAD] Igual que "reviews": va en su propia colección de Firestore,
  // no por AdminStore (admin_meta), porque admin_meta está bloqueado para
  // quien no sea admin — ver el comentario junto a zyGetReviews(). El id del
  // documento es el email para que suscribirse dos veces solo actualice el
  // registro en vez de duplicarlo.
  try{
    if(db) await db.collection('newsletterSubscribers').doc(emailKey).set({ email, date: Date.now() }, { merge:true });
  }catch(e){ console.error('No se pudo guardar el correo del newsletter:', e); }

  // El código ya existe como cupón real (ZY_COUPONS_DEFAULT) — se aplica
  // directo al carrito para que esté listo en cuanto compren, además de
  // mostrarse en el popup. (La verificación de que no se re-use ya pasó
  // arriba; el checkout vuelve a validar por si acaso — ver confirmOrder.)
  try{
    zyCoupon = { code:'BIENVENIDO10', ...zyCouponsData['BIENVENIDO10'] };
    await Store.set('zayde:coupon:'+userKey(), zyCoupon);
    if(typeof renderCart==='function') renderCart();
  }catch(e){}

  document.getElementById('nlPopup').innerHTML = `
    <button type="button" class="nl-popup-close" onclick="zyCloseNewsletterPopup()" aria-label="Cerrar">×</button>
    <h4>¡Listo!</h4>
    <p>Ya quedó aplicado a tu carrito. Tu código, por si lo necesitas de nuevo:</p>
    <div class="nl-code">BIENVENIDO10</div>`;
  try{ await Store.set('zayde:newsletterPopupSeen', true); }catch(e){}
  showToast('10% aplicado a tu carrito');
}
/* Se muestra una sola vez por navegador, 8s después de cargar, y solo si
   no se ha visto/usado antes en este navegador ni hay ya un cupón activo. */
(function zyInitNewsletterPopup(){
  setTimeout(async ()=>{
    try{
      const seen = await Store.get('zayde:newsletterPopupSeen');
      if(seen) return;
      // [10% SOLO POR INVITACIÓN] El popup "10% en tu primera compra" queda apagado; el 10% llega
      // por invitación (?ref). Se vuelve a prender desde el panel: Cupones > interruptor del popup.
      if(zySettings.nlPopupEnabled !== true) return;
      if(zyCoupon) return; // ya trae un cupón aplicado (p.ej. de un link de campaña)
      zyOpenNewsletterPopup();
    }catch(e){}
  }, 8000);
})();

