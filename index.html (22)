async function setUser(name, provider, uid, email, createdAt){
  // [FIX LOGIN] Se guarda la llave de invitado de ESTE navegador ANTES de
  // cambiar de cuenta — así, más abajo, solo se transfieren/borran los
  // datos que de verdad son de quien está iniciando sesión ahora mismo, y
  // no los de cualquier otro invitado que haya usado este dispositivo.
  const prevGuestKey = userKey();
  currentUser = { name, provider, uid: uid || null, email: email || null, createdAt: createdAt || null };
  document.getElementById('accountSlot').innerHTML = accountChipHTML(currentUser);
  closeLogin();
  resetLoginForm();
  showToast(`Sesión iniciada con ${provider}`);
  // [CHATBOT-LOGIN] Si el chat de ayuda estaba abierto cuando el visitante
  // inició sesión (ej. tocó "Iniciar sesión" desde el propio chat), oculta
  // ese botón de inmediato sin esperar a que se cierre y reabra el chat.
  const zybotLoginBtn = document.getElementById('zybotLoginBtn');
  if(zybotLoginBtn) zybotLoginBtn.style.display = 'none';
  await Store.set('zayde:session', currentUser);
  zyEnsureReferralCodeRegistered(); // [REFERIDOS] deja su código buscable para quien lo escriba al registrarse
  await loadAccountData(true); // trae el carrito/favoritos guardados de esta cuenta y fusiona lo que traías como invitado
  // [FIX] Antes, lo que traías como invitado se copiaba a tu cuenta pero
  // nunca se borraba del almacenamiento de "invitado" — así que al cerrar
  // sesión, esos mismos productos volvían a aparecer como si fueran de un
  // invitado nuevo. Ahora que ya se fusionó todo a tu cuenta, se vacía el
  // carrito/favoritos de ESE invitado (prevGuestKey) para que no se repita.
  try{
    await Store.set('zayde:cart:'+prevGuestKey, []);
    await Store.set('zayde:cart:cg:'+prevGuestKey, []);
    await Store.set('zayde:favorites:'+storeKeyPrefix()+prevGuestKey, []);
  }catch(e){}
  // [FIX] Mismo problema con los pedidos: los que hiciste como invitado en
  // este navegador (antes de iniciar sesión) ahora pasan a pertenecer a tu
  // cuenta, para que "Pedidos y rastreo" y el contador del header los
  // sigan mostrando — y para que un invitado nuevo en este mismo navegador
  // no los vea como propios después. Solo se reasignan los pedidos que
  // tenían EXACTAMENTE la llave de invitado de este navegador (prevGuestKey),
  // nunca los de otro invitado/dispositivo.
  try{
    const allOrders = (await Store.get('zayde:orders')) || [];
    let changed = false;
    allOrders.forEach(o=>{ if((o.ownerKey || 'guest') === prevGuestKey){ o.ownerKey = userKey(); changed = true; } });
    if(changed) await Store.set('zayde:orders', allOrders);
  }catch(e){}
  zyUpdateOrderBadge();
  zyLoadRecentOrder();
}
