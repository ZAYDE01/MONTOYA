/* Si la sucursal (p. ej. una de OpenStreetMap) no trae el estado en su dirección, se
   consulta una vez y se agrega, porque el costo de recolección depende del estado. */
function zyResolveBranchState(b){
  if(!b || b.lat == null || zyStateFromBranchAddr(b.addr)) return;
  fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=5&lat=${b.lat}&lon=${b.lng}&addressdetails=1`, { headers:{ 'Accept-Language':'es' } })
    .then(r=>r.json())
    .then(d=>{
      const s = (d.address && d.address.state) || '';
      let abbr = '';
      Object.keys(ZY_ABBR_TO_STATE).forEach(ab=>{ const full = ZY_ABBR_TO_STATE[ab]; if(!abbr && s && (s===full || s.startsWith(full))) abbr = ab; });
      if(s === 'México') abbr = 'Edomex';
      if(abbr && !zyStateFromBranchAddr(b.addr)){
        b.addr = b.addr + ', ' + abbr;
        if(selectedBranch && selectedBranch.id === b.id){
          const sa = document.getElementById('branchSummaryAddr');
          if(sa) sa.textContent = b.addr + (branchRef && b.lat != null ? ` · a ${haversineKm(branchRef,b).toFixed(1)} km de ${branchRef.label}` : '');
          updateCheckoutTotals();
        }
        renderBranchList();
      }
    }).catch(()=>{});
}
function selectBranch(id){
