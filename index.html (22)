/* ============================================================
   [MÉTODOS DE PAGO GUARDADOS] Tarjetas guardadas de verdad, vía la
   bóveda de Stripe (Customer + SetupIntent) — NUNCA se guarda un
   número de tarjeta en este sitio ni en Firestore, solo el ID de
   método de pago que devuelve Stripe (lo mismo que ya declara tu
   aviso de privacidad). Requiere 3 endpoints nuevos en /api, mismo
   patrón que /api/create-payment-intent.js (usan STRIPE_SECRET_KEY,
   ya configurada en tu Vercel si Stripe ya cobra en el sitio):
     - /api/create-setup-intent.js   → crea/reusa el Customer y regresa
       un clientSecret para capturar la tarjeta sin cobrar nada.
     - /api/list-payment-methods.js  → regresa marca/últimos 4 dígitos
       de las tarjetas guardadas de ese Customer.
     - /api/delete-payment-method.js → desvincula una tarjeta guardada.
   ============================================================ */
let zySavedCards = [];
async function zyGetStripeCustomerId(){
  let id = await Store.get('zayde:stripeCustomer:'+userKey());
  return id || null;
}
async function zyLoadSavedCards(){
  zySavedCards = [];
  const customerId = await zyGetStripeCustomerId();
  if(!customerId) return;
  try{
    const res = await fetch('/api/list-payment-methods', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ customerId })
    });
    const data = await res.json().catch(()=>({}));
    if(res.ok && Array.isArray(data.cards)) zySavedCards = data.cards;
  }catch(e){ console.error('No se pudieron cargar las tarjetas guardadas:', e); }
}
function zyToggleCardsPanel(){
  const panel = document.getElementById('acctCardsPanel');
  const chevron = document.getElementById('acctCardsChevron');
  if(!panel) return;
  const open = panel.style.display !== 'none';
  panel.style.display = open ? 'none' : 'block';
  if(chevron) chevron.style.transform = open ? '' : 'rotate(90deg)';
}
// Abre un Stripe Card Element embebido dentro del panel de la cuenta
// para capturar la tarjeta nueva (mismo Elements que ya usa el
// checkout) y la vincula al Customer vía SetupIntent — el número de
// tarjeta nunca pasa por nuestro servidor, solo por Stripe.
let zyCardSetupElement = null;
async function zyOpenAddCardForm(){
  const box = document.getElementById('acctCardSetupBox');
  if(!box) return;
  box.style.display = 'block';
  if(!stripeClient){ box.innerHTML = '<div class="zy-quickhint" style="color:#8A1F1F;">El pago con tarjeta no está configurado todavía en este sitio.</div>'; return; }
  box.innerHTML = `
    <div id="acctCardElement" class="stripe-card-element"></div>
    <div class="stripe-card-errors" id="acctCardErrors"></div>
    <button type="button" class="btn btn-primary" style="width:100%;margin-top:8px;" onclick="zyConfirmAddCard()">Guardar tarjeta</button>
  `;
  const elements = stripeClient.elements();
  zyCardSetupElement = elements.create('card', { style:{ base:{ fontSize:'15px' } } });
  zyCardSetupElement.mount('#acctCardElement');
  zyCardSetupElement.on('change', (event)=>{
    document.getElementById('acctCardErrors').textContent = event.error ? event.error.message : '';
  });
}
async function zyConfirmAddCard(){
  showToast('Guardando tarjeta…');
  try{
    let customerId = await zyGetStripeCustomerId();
    const res = await fetch('/api/create-setup-intent', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ customerId, email: currentUser ? (currentUser.email||'') : '', name: currentUser ? currentUser.name : '' })
    });
    const data = await res.json();
    if(!res.ok) throw new Error(data.error || 'No se pudo iniciar el guardado de la tarjeta');
    if(data.customerId) await Store.set('zayde:stripeCustomer:'+userKey(), data.customerId);
    const result = await stripeClient.confirmCardSetup(data.clientSecret, { payment_method: { card: zyCardSetupElement } });
    if(result.error) throw new Error(result.error.message);
    showToast('Tarjeta guardada ✓');
    document.getElementById('acctCardSetupBox').style.display = 'none';
    await zyLoadSavedCards();
    renderAccountPage();
  }catch(e){
    console.error('Error guardando tarjeta:', e);
    showToast(e.message || 'No se pudo guardar la tarjeta', true);
  }
}
async function zyDeleteSavedCard(paymentMethodId){
  try{
    const res = await fetch('/api/delete-payment-method', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ paymentMethodId })
    });
    if(!res.ok){ const data = await res.json().catch(()=>({})); throw new Error(data.error || 'No se pudo eliminar'); }
    showToast('Tarjeta eliminada');
    await zyLoadSavedCards();
    renderAccountPage();
  }catch(e){
    console.error('Error eliminando tarjeta:', e);
    showToast(e.message || 'No se pudo eliminar la tarjeta', true);
  }
}
/* ============================================================
   [FOTO DE PERFIL] Se guarda como imagen recomprimida (máx 300x300,
   JPEG) en la misma Store (window.storage con fallback a localStorage)
   que usa el resto del sitio, bajo una llave por usuario
   ("zayde:profilePhoto:"+userKey()) — así cada cuenta tiene la suya y
   sobrevive a recargar la página / volver a iniciar sesión en el mismo
   navegador. No sube nada a ningún servidor.
   ============================================================ */
let zyProfilePhotoUrl = null;
async function zyGetProfilePhotoUrl(){
  try{ zyProfilePhotoUrl = await Store.get('zayde:profilePhoto:'+userKey()); }
  catch(e){ zyProfilePhotoUrl = null; }
  return zyProfilePhotoUrl;
}
// Dibuja el avatar dentro de cualquier elemento contenedor: foto si hay,
// si no la inicial de siempre. Se usa tanto en la página "Mi cuenta"
// como en el modal rápido de cuenta.
function zySetAvatarEl(el, name){
  if(!el) return;
  const initial = (name||'').trim().charAt(0).toUpperCase() || '?';
  if(zyProfilePhotoUrl){
    el.innerHTML = `<img src="${zyProfilePhotoUrl}" alt="Foto de perfil" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;">`;
  } else {
    el.textContent = initial;
  }
}
function zyPickProfilePhoto(){
  const input = document.getElementById('acctPhotoInput');
  if(input) input.click();
}
// Redimensiona la imagen elegida a máx 300x300 vía <canvas> antes de
// guardarla (evita fotos de varios MB directo de la cámara del celular,
// que harían lenta la carga de la página y podrían pasar el límite de
// tamaño de la Store).
async function zyOnProfilePhotoSelected(input){
  const file = input.files && input.files[0];
  if(!file) return;
  if(!file.type.startsWith('image/')){ showToast('Elige un archivo de imagen', true); return; }
  try{
    const dataUrl = await new Promise((resolve, reject)=>{
      const reader = new FileReader();
      reader.onload = ()=>{
        const img = new Image();
        img.onload = ()=>{
          const size = 300;
          const canvas = document.createElement('canvas');
          canvas.width = size; canvas.height = size;
          const ctx = canvas.getContext('2d');
          // recorte centrado cuadrado, para que la foto de perfil siempre
          // salga circular sin deformarse
          const side = Math.min(img.width, img.height);
          const sx = (img.width - side) / 2, sy = (img.height - side) / 2;
          ctx.drawImage(img, sx, sy, side, side, 0, 0, size, size);
          resolve(canvas.toDataURL('image/jpeg', 0.85));
        };
        img.onerror = reject;
        img.src = reader.result;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
    await Store.set('zayde:profilePhoto:'+userKey(), dataUrl);
    zyProfilePhotoUrl = dataUrl;
    showToast('Foto de perfil actualizada');
    zySetAvatarEl(document.getElementById('acctDashAvatar'), currentUser ? currentUser.name : 'Invitado');
    zySetAvatarEl(document.getElementById('accountModalAvatar'), currentUser ? currentUser.name : 'Invitado');
  }catch(e){
    console.error('No se pudo procesar la foto de perfil:', e);
    showToast('No se pudo procesar esa imagen, intenta con otra', true);
  } finally {
    input.value = ''; // permite volver a elegir el mismo archivo después
  }
}
async function zyRemoveProfilePhoto(){
  try{ await Store.set('zayde:profilePhoto:'+userKey(), null); }catch(e){}
  zyProfilePhotoUrl = null;
  showToast('Foto de perfil eliminada');
  zySetAvatarEl(document.getElementById('acctDashAvatar'), currentUser ? currentUser.name : 'Invitado');
  zySetAvatarEl(document.getElementById('accountModalAvatar'), currentUser ? currentUser.name : 'Invitado');
}
