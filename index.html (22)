   compara en el navegador. Aquí solo se le pide al servidor
   (/api/send-email, type "otp") que genere el código y lo mande al correo
   de la sesión de Firebase actual (se identifica con el token, no con un
   "to" que mande el navegador). El servidor guarda solo el hash del código,
   con vigencia de 10 min, y la verificación se hace en nkVerifySignupCode()
   contra type "otp-verify". Ya no existe "modo demo": si el envío falla se
   muestra un aviso y se puede reintentar, pero el código nunca sale en pantalla. */
async function nkSendCode(email){
  nkPendingCode = ''; // el navegador ya no conoce ningún código
  const hint = document.getElementById('nkDemoCodeHint');
  hint.style.display = 'none';
  try{
    const user = firebase.auth().currentUser;
    if(!user) throw new Error('sin-sesion');
    const token = await user.getIdToken();
    const res = await fetch('/api/send-email', {
      method:'POST',
      headers:{'Content-Type':'application/json', 'Authorization':'Bearer ' + token},
      body: JSON.stringify({ type:'otp' })
    });
    if(!res.ok){
      const data = await res.json().catch(()=>({}));
      const err = new Error(data.error || `HTTP ${res.status}`);
      err.status = res.status;
      throw err;
    }
  }catch(e){
    console.error('No se pudo enviar el código por correo:', e);
    hint.style.display = '';
    hint.textContent = (e && e.status === 429)
      ? 'Espera unos segundos antes de pedir otro código.'
      : 'No pudimos enviar el código a tu correo. Espera un momento y toca "Reenviar código".';
  }
  nkStartResendTimer();
}
function nkStartResendTimer(){
  clearInterval(nkResendTimer);
  let secs = 30;
  const wrap = document.getElementById('nkResendWrap');
  const label = document.getElementById('nkResendSecs');
  wrap.style.display = '';
  wrap.innerHTML = 'Reenviar el código en <span id="nkResendSecs">'+secs+'</span>s';
  nkResendTimer = setInterval(()=>{
    secs--;
    const s = document.getElementById('nkResendSecs');
    if(s) s.textContent = secs;
    if(secs <= 0){
      clearInterval(nkResendTimer);
      wrap.innerHTML = '<a onclick="nkSendCode(nkPendingEmail)">Reenviar código</a>';
    }
  }, 1000);
}
