        ${stage ? `<span class="zy-hist-stage">${zyEscapeHtml(stage)}</span>` : ''}
        <span class="zy-hist-total">${fmt(o.total||0)}</span>
        <svg class="zy-hist-chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
      </summary>
      <div class="zy-hist-body"></div>
    </details>`;
  }).join('');
  return `<div class="zy-hist"><div class="zy-hist-title">Historial de pedidos (${older.length})</div>${rows}</div>`;
}
// Pedidos de esta cuenta/navegador, del más nuevo al más viejo, sin los 100% digitales (no se rastrean).
async function zyMyTrackableOrders(){
  const all = (await Store.get('zayde:orders')) || [];
  return zyMyOrders(all).filter(o=>!zyIsDigitalOnlyOrder(o)).slice().sort((a,b)=>(b.date||0)-(a.date||0));
