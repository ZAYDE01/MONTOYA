async function zgRenderFeaturedReviews(){
  const section = document.getElementById('zgFeaturedReviewsSection');
  const row = document.getElementById('zgFeaturedReviewsRow');
  const toggle = document.getElementById('zgFrStoreToggle');
  if(!section || !row || !db) return;
  // [RESEÑAS SEPARADAS] Botón ZAYDE G / ZAYDE propio de esta sección: cada
  // lado muestra PURAS reseñas de esa tienda, sin mezclarlas. El botón
  // solo aparece si ambas tiendas tienen productos (si no, no habría nada
  // que alternar del otro lado).
  if(toggle) toggle.style.display = (zyClothesGProducts().length && zyBrowsable().length) ? '' : 'none';
  const storeIds = new Set((zgActiveReviewStore==='zayde' ? zyBrowsable() : zyClothesGProducts()).map(p=>String(p.id)));
  try{
    const snap = await db.collection('reviews').orderBy('date','desc').limit(40).get();
    let reviews = snap.docs.map(d=>d.data());
    reviews = reviews.filter(r => r.stars >= 4 && r.text && r.text.trim().length >= 15 && storeIds.has(String(r.productId)));
    reviews.sort((a,b)=>{
      const scoreA = ((a.images&&a.images.length)?2:0) + (a.verifiedPurchase?1:0);
      const scoreB = ((b.images&&b.images.length)?2:0) + (b.verifiedPurchase?1:0);
      if(scoreB !== scoreA) return scoreB - scoreA;
      return (b.date||0) - (a.date||0);
    });
    reviews = reviews.slice(0, 8);
    if(!reviews.length){
