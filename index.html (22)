/* Email de confirmación INMEDIATO al momento de comprar (no espera a que
   cambies la etapa desde el panel) — solo se manda si el cliente dejó su
   correo en el checkout. Usa el mismo endpoint que los avisos de estatus. */
async function zySendOrderConfirmationEmail(order){
  if(!order.email || order.notifyEmail===false) return;
  try{
    // [FIX] El correo automático usaba SIEMPRE el texto de "pedido"
    // ("¡Pedido confirmado y pagado!"), incluso cuando la compra era
    // 100% digital (solo membresía y/o tarjeta de regalo) — el cliente
    // recibía un correo que sonaba a cotización de un pedido físico en
    // vez de un aviso claro de que ya tiene su membresía activa. Ahora
    // el texto refleja lo que de verdad se compró, con el mismo
    // criterio (zyIsDigitalOnlyOrder) usado en el resto del checkout.
    // [FIX 2] Esto solo arreglaba el mensaje DENTRO de la caja — el
    // envoltorio del correo (armado en /api/send-email.js) seguía
    // diciendo siempre "tu pedido X tiene una actualización", sonando
    // a aviso de envío incluso en compras 100% digitales. Por eso ahora
    // también se manda isDigitalOnly, para que el backend use un
    // envoltorio sin la palabra "pedido" en ese caso (ver send-email.js).
    const membershipItem = (order.items||[]).find(it=>it.isMembership);
    const giftItem = (order.items||[]).find(it=>it.isGiftCard);
    let paidNote;
    if(zyIsDigitalOnlyOrder(order)){
      if(membershipItem && giftItem) paidNote = '¡Tu membresía y tu tarjeta de regalo ZAYDE ya están activas!';
      else if(membershipItem) paidNote = `¡Bienvenido a ZAYDE Club! Tu membresía ${zyEscapeHtml(membershipItem.tierName || '')} ya está activa.`;
      else paidNote = '¡Tu tarjeta de regalo ZAYDE ya está activa y lista para usarse!';
    } else {
      paidNote = order.paymentMethod === 'stripe' && order.paymentStatus === 'pagado'
        ? '¡Pedido confirmado y pagado!'
        : '¡Pedido recibido! Coordinamos el pago por WhatsApp.';
    }
    const res = await fetch('/api/send-email', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        type: 'status',
        to: order.email,
        name: order.name,
        orderNum: order.orderNum,
        statusLabel: paidNote,
        isDigitalOnly: zyIsDigitalOnlyOrder(order),
        confirmation: true // [CORREO DUPLICADO] el servidor evita que el respaldo del webhook mande uno igual
      })
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok){
      console.error('No se pudo enviar el email de confirmación:', data);
      // No mostramos toast aquí: el cliente ya está viendo su confirmación
      // en pantalla, y no queremos alarmarlo por un email que es un bono.
    }
  }catch(e){ console.error('No se pudo conectar con el servidor de email:', e); }
}

/* ================= CAMBIO MANUAL DE ETAPA + AVISOS AL CLIENTE =================
   Tú avanzas la etapa a mano desde el panel (pestaña Pedidos). Cada cambio:
   1) Guarda el nuevo status en Firestore y en el respaldo local.
   2) Manda un email automático de verdad si el cliente dejó su correo
      (vía /api/send-status-email, necesita RESEND_API_KEY en Vercel).
   3) Abre WhatsApp con el mensaje ya redactado para el cliente — no es
      100% automático (WhatsApp no permite mandarle mensajes a cualquier
      cliente sin una cuenta de WhatsApp Business API de pago), pero solo
      tienes que darle "Enviar". */
async function zyAdminAdvanceOrderStatus(orderNum, newStatusKey){
  const stage = ORDER_STAGES.find(s=>s.key===newStatusKey);
  if(!stage) return;

  // [RASTREO — HISTORIAL CON HORA REAL] Cada avance de etapa queda anotado
  // con su fecha/hora real, para que "Detalles de rastreo" (ver
  // zyTrackingDetailsHTML) muestre un historial cronológico de verdad en
  // vez de solo el estado actual. Si el admin retrocede o repite una
  // etapa, se agrega igual — así el historial refleja lo que de verdad
  // pasó, sin ocultar correcciones.
  const nowAt = Date.now();
  let order = null;
  let cloudOk = false, cloudErr = '';

  // [FIX] 1) PRIMERO la nube (Firestore): es lo que ve el cliente en su
  // celular. Antes el resultado de este guardado se ignoraba y siempre se
  // avisaba "marcado como…" aunque Firestore hubiera fallado — el cliente
  // nunca veía el cambio y tú no te enterabas. Se usa update() (no set con
  // merge) para NO crear un documento incompleto si el pedido no existe.
  if(db){
    try{
      await db.collection('orders').doc(orderNum).update({
        status: newStatusKey,
        statusHistory: firebase.firestore.FieldValue.arrayUnion({ status:newStatusKey, at:nowAt })
      });
      cloudOk = true;
    }catch(e){
      cloudErr = (e && (e.code || e.message)) || 'error desconocido';
      console.error('No se pudo actualizar el pedido en Firestore:', e);
    }
  } else {
    cloudErr = 'Firestore no está disponible en este navegador';
  }

  // 2) Respaldo local (solo afecta a este navegador).
  try{
    await zyWithOrdersLock(async ()=>{
      const all = (await Store.get('zayde:orders')) || [];
      order = all.find(x=>x.orderNum===orderNum) || null;
      if(order){
        order.status = newStatusKey;
        if(!Array.isArray(order.statusHistory)) order.statusHistory = [];
        order.statusHistory.push({ status:newStatusKey, at:nowAt });
        await Store.set('zayde:orders', all);
      }
    });
  }catch(e){ console.error('No se pudo actualizar el pedido localmente:', e); }

  // Si en la nube no existía el documento pero este navegador tiene el pedido
  // completo, se sube completo (no un documento a medias).
  if(!cloudOk && db && order && /not-found/i.test(cloudErr)){
    try{
      await db.collection('orders').doc(orderNum).set(zyPublicOrder(order));
      cloudOk = true; cloudErr = '';
    }catch(e){ cloudErr = (e && (e.code || e.message)) || cloudErr; console.error('No se pudo subir el pedido completo a Firestore:', e); }
  }

  if(!cloudOk && db){
    showToast(`El pedido ${orderNum} NO se actualizó en la nube (${cloudErr}), así que el cliente no verá el cambio. Revisa tu sesión de admin y las Reglas de Firestore.`, true);
    zyRenderOrdersAdmin(); // repinta con lo que realmente hay guardado
    return; // no se manda email/WhatsApp de un cambio que el cliente no puede ver
  }

  // [VENDEDORES] Las ventas de vendedor de este pedido avanzan a la misma etapa.
  // Si falla, el pedido ya quedó bien; solo se avisa para corregir la venta a mano.
  try{ await zySyncSellerSales(orderNum, newStatusKey, nowAt); }
  catch(e){
    console.error('No se pudo actualizar la venta del vendedor:', e);
    showToast('El pedido se actualizó, pero no se pudo actualizar la venta del vendedor. Corrígela en la pestaña "Ventas vendedores".', true);
  }

  if(!order){
    try{
      const doc = db ? await db.collection('orders').doc(orderNum).get() : null;
      if(doc && doc.exists) order = doc.data();
    }catch(e){}
  }

  showToast(`Pedido ${orderNum} marcado como "${stage.label}"`);
  zyRenderOrdersAdmin();
  if(order) zyNotifyOrderStatus(order, stage);
}

/* Dispara los 2 avisos al cliente (email automático real + WhatsApp
   semi-automático con mensaje prellenado) cuando cambia la etapa. */
async function zyNotifyOrderStatus(order, stage){
  // ---- 1) Email automático real — se manda solo, sin que tengas que
  // tocar nada, en cuanto cambias la etapa del pedido (ej. "En camino" →
  // "Entregado"). Requiere que el cliente haya dejado su correo y que
  // /api/send-status-email esté desplegado en tu backend de Vercel con
  // RESEND_API_KEY configurada — si algo de eso falla, se avisa con un
  // toast para que no pase inadvertido, pero el cambio de estatus ya
  // quedó guardado de todas formas. ----
  if(order.email && order.notifyEmail!==false){
    try{
      const emailRes = await fetch('/api/send-email', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
          type: 'status',
          to: order.email,
          name: order.name,
          orderNum: order.orderNum,
          statusLabel: stage.label
        })
      });
      const emailData = await emailRes.json().catch(()=>({}));
      if(!emailRes.ok){
        showToast(`No se pudo enviar el email: ${emailData.error || 'error desconocido'}`, true);
        console.error('Error enviando email de estatus:', emailData);
      }
    }catch(e){
      showToast('No se pudo conectar con el servidor de email', true);
      console.error('No se pudo enviar el email de estatus:', e);
    }
  }

  // ---- 2) WhatsApp: se abre YA REDACTADO con un mensaje formal, listo
  // para que tú nada más le des "Enviar" — a propósito no se manda 100%
  // solo (WhatsApp no deja mandarle mensajes a cualquier cliente sin una
  // cuenta de WhatsApp Business API de paga), pero así el cliente recibe
  // el correo automático al instante y, encima, tu mensaje personal por
  // WhatsApp con un clic tuyo — se ve más cuidado que un aviso 100%
  // robotizado. ----
  if(order.phone && order.notifyWhatsapp!==false){
    const waText = encodeURIComponent(
      `Hola ${order.name || ''}, te escribimos de ZAYDE ✅\n\nTu pedido *${order.orderNum}* cambió de estatus a: *${stage.label}*.\n\nTambién te llegó la confirmación a tu correo. Cualquier duda, quedo al pendiente por aquí.\n\n¡Gracias por tu compra!`
    );
    const waPhone = order.phone.replace(/\D/g,'');
    const fullPhone = waPhone.length === 10 ? '52' + waPhone : waPhone; // asume MX si son 10 dígitos
    window.open(`https://wa.me/${fullPhone}?text=${waText}`, '_blank');
  }
}

/* Arma el texto formal de la cotización que llega por WhatsApp */
function zyBuildOrderMessage(order){
  const lines = [];
  lines.push(`*NUEVO PEDIDO ZAYDE — ${order.orderNum}*`);
  lines.push(`Fecha: ${new Date(order.date).toLocaleString('es-MX')}`);
  lines.push('');
  lines.push('*Cliente*');
  lines.push(`${order.name} · ${order.phone}${order.email ? ' · ' + order.email : ''}`);
  lines.push('');
  lines.push('*Productos*');
  order.items.forEach(it=>{
    lines.push(`• ${it.qty}x ${it.brand} ${it.name}${it.size?' · Talla '+zyTallaTxt(zyProdById(it.id),it.size)+(zyShoeMx(zyProdById(it.id),it.size)?' (US '+it.size+')':''):''} — ${fmt(it.price*it.qty)}`);
  });
  lines.push('');
  lines.push('*Entrega*');
  if(order.items.every(it=>it.isMembership || it.isGiftCard)){
    lines.push('Digital — sin envío: activación de membresía y/o emisión de tarjeta de regalo en la cuenta del cliente.');
  } else if(order.shipMode==='sucursal'){
    lines.push(`Recoger en sucursal: ${order.branch.name}`);
    lines.push(order.branch.addr);
  } else {
    lines.push(`Domicilio: ${order.address}, ${order.city}, ${order.state}, CP ${order.zip}`);
    if(order.deliveryCoords) lines.push(`Pin de entrega: https://www.google.com/maps?q=${order.deliveryCoords.lat},${order.deliveryCoords.lng}`);
  }
  lines.push('');
  lines.push('*Totales*');
  lines.push(`Productos: ${fmt(order.subtotal)}`);
  lines.push(`Envío: ${fmt(order.shipping)}`);
  lines.push(`*Total: ${fmt(order.total)}*`);
  lines.push('');
  lines.push(order.paymentMethod === 'stripe' && order.paymentStatus === 'pagado'
    ? `*Pago:* ya pagado con tarjeta vía Stripe (ref. ${order.stripePaymentIntentId || ''}).`
    : '*Pago:* pendiente de confirmar.');
  return lines.join('\n');
}

/* Envía la cotización por WhatsApp de forma silenciosa: nunca muestra nada
   al cliente, ni siquiera si falla el envío (solo queda registrado en consola).
   [FIX CORS] Ya no llama a CallMeBot directo desde el navegador (el navegador
   lo bloqueaba por CORS, por eso nunca llegaba el mensaje) — ahora pasa por
   /api/send-order-whatsapp.js, que lo manda desde el servidor. */
async function zySendOrderWhatsApp(order){
  try{
    const text = zyBuildOrderMessage(order);
    await fetch('/api/send-order-whatsapp', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ text })
    });
  }catch(e){
    console.error('No se pudo enviar la cotización por WhatsApp', e);
  }
}

/* Guarda el pedido en dos lugares:
   1) Firestore (colección "orders", doc = número de pedido) — para que el
      rastreo funcione desde cualquier celular o computadora.
   2) Store local del navegador — respaldo por si Firestore no está disponible
      (adblocker, sin conexión, o mientras activas Firestore por primera vez). */
// [PRIVACIDAD] El pedido se puede consultar con su número, así que el pin exacto de entrega (GPS de la casa) no va ahí:
// se guarda aparte, en una colección que solo lee el admin.
function zyPublicOrder(o){ const c = Object.assign({}, o); delete c.deliveryCoords; return c; }
async function zySaveOrder(order){
  let fsOk = true; // [SEGURIDAD] true si se guardó en Firestore (o si no hay Firestore)
  try{
    if(db){ await db.collection('orders').doc(order.orderNum).set(zyPublicOrder(order)); }
  }catch(e){ fsOk = false; console.error('No se pudo guardar el pedido en Firestore:', e); }
  if(fsOk && db && order.deliveryCoords){
    try{ await db.collection('orderPrivate').doc(order.orderNum).set({ orderNum: order.orderNum, deliveryCoords: order.deliveryCoords }); }
    catch(e){ console.warn('No se pudo guardar el pin de entrega:', e); }
  }
  if(order.email) zyMarkCartRecovered(order.email);
  try{
    await zyWithOrdersLock(async ()=>{
      const all = (await Store.get('zayde:orders')) || [];
      const idx = all.findIndex(o=>o.orderNum===order.orderNum);
      if(idx >= 0) all[idx] = order; else all.unshift(order); // evita duplicados si se guarda 2 veces (pendiente -> pagado)
      await Store.set('zayde:orders', all.slice(0, 100));
    });
  }catch(e){ console.error('No se pudo guardar el pedido localmente:', e); }
  zyStartLiveOrderSync(); // [FIX] empieza a escuchar este pedido en vivo
  return fsOk;
}

/* [FIX historial de precios] Guarda solo precio + producto + fecha de cada
   pieza vendida, en una colección aparte y pública ("priceHistory") — a
   propósito SIN nombre, teléfono ni dirección del cliente, para que
   cualquier visitante pueda ver la gráfica de precios de un producto sin
   que eso reabra el hueco de privacidad que teníamos antes (leer TODOS los
   pedidos completos desde el navegador). Solo se llama una vez, cuando el
   pago con Stripe ya se confirmó. */
async function zyLogPriceHistory(order){
  // [SEGURIDAD] Ya NO se escribe desde el navegador: cualquiera podía inventar precios en
  // la gráfica pública. Ahora el webhook de Stripe (servidor) registra el historial de cada
  // pedido solo cuando el pago se confirma de verdad. Se deja la función vacía a propósito
  // para no tocar los lugares que aún la llaman.
  return;
}

async function confirmOrder(){
  const name = document.getElementById('ckName').value.trim();
  const phone = document.getElementById('ckPhone').value.trim();
  const email = document.getElementById('ckEmail').value.trim();
  const notifyEmail = document.getElementById('ckNotifyEmail') ? document.getElementById('ckNotifyEmail').checked : true;
  const notifyWhatsapp = document.getElementById('ckNotifyWhatsapp') ? document.getElementById('ckNotifyWhatsapp').checked : true;
  if(!name || !phone){ showToast('Completa tus datos de contacto para continuar', true); return; }
  if(email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ showToast('Ese correo no se ve válido — revísalo o déjalo en blanco', true); return; }

  if(!cart.length){ showToast('Tu carrito está vacío', true); return; }

  // [MEMBRESÍA / TARJETA DE REGALO — NO SON UN PEDIDO] Comprar una
  // membresía ZAYDE Club y/o una tarjeta de regalo es un servicio/función
  // que ofrece ZAYDE, no una compra de mercancía: un carrito 100% digital
  // (solo membresía y/o tarjeta de regalo, sin ningún producto físico)
  // nunca debe convertirse en un "pedido" (nada de orderNum, nada guardado
  // en la colección "orders", nada en "Pedidos y rastreo"). Se corta aquí
  // mismo, antes de armar ningún objeto de pedido, y se resuelve con su
  // propio flujo — ver zyConfirmDigitalOnlyPurchase(). Antes esto solo
  // aplicaba a "cart.every(c=>c.isGiftCard)" (tarjeta de regalo sola); las
  // membresías seguían generando un pedido de verdad más abajo. Ahora
  // cualquier carrito 100% digital (zyIsDigitalItem) entra por aquí,
  // incluyendo membresía sola o membresía + tarjeta de regalo combinadas.
  const digitalOnlyNoOrder = cart.every(zyIsDigitalItem);
  if(digitalOnlyNoOrder){
    if(paymentMethod !== 'stripe'){
      showToast('Tu compra digital se paga con tarjeta para activarse al instante', true);
      switchPaymentMethod('stripe');
      return;
    }
    await zyConfirmDigitalOnlyPurchase({ name, phone, email });
    return;
  }

  // [DIGITAL] Un carrito 100% digital (solo membresía y/o tarjeta de
  // regalo) ya se resolvió arriba, en digitalOnlyNoOrder, y esta función
  // ya terminó (return) antes de llegar aquí. Lo que sigue es SIEMPRE un
  // pedido de mercancía física — puede traer una membresía combinada con
  // un producto real (ese caso sí necesita envío, por eso hasDigital se
  // sigue usando más abajo para exigir pago con tarjeta si trae algo
  // digital), pero nunca es 100% digital.
  const hasDigital = cart.some(zyIsDigitalItem);

  let dest, branch=null, address=null, city=null, zip=null, state=null;
  if(shipMode === 'sucursal'){
    if(!selectedBranch){ showToast('Elige la sucursal donde quieres recoger tu pedido', true); return; }
    branch = selectedBranch;
    dest = `recogerás en ${selectedBranch.name}`;
  } else {
    address = document.getElementById('ckAddress').value.trim();
    city = document.getElementById('ckCity').value.trim();
    zip = document.getElementById('ckZip').value.trim();
    state = document.getElementById('ckState').value;
    if(!address || !city || !zip || !state){ showToast('Completa tu dirección de envío para continuar', true); return; }
    if(!MX_STATES.includes(state)){ showToast('Por ahora solo enviamos dentro de México', true); return; }
    { const mxErr = zyMexicoAddressError(); if(mxErr){ showToast(mxErr, true); return; } }
    dest = 'lo recibirás en tu domicilio con rastreo de paquetería';
  }

  // Las membresías y tarjetas de regalo solo se activan/emiten con un pago
  // confirmado al instante — nunca por WhatsApp, donde el pago no queda
  // confirmado en el momento.
  if(hasDigital && paymentMethod !== 'stripe'){
    showToast('Tu producto digital se paga con tarjeta para activarse al instante', true);
    switchPaymentMethod('stripe');
    return;
  }

  // [FIX — "BIENVENIDO10 se puede volver a canjear"] Última verificación,
  // justo antes de cobrar: cubre el caso de que el cliente haya escrito el
  // código a mano en el cupón del carrito (en vez de pasar por el popup
  // del newsletter, que ya lo revisa) o que lo haya aplicado en un
  // dispositivo y compre en otro. Si el correo del pedido ya redimió
  // BIENVENIDO10 antes, se quita el cupón y se le pide confirmar de nuevo
  // — nunca se cobra con el descuento aplicado dos veces al mismo cliente.
  if(zyCoupon && zyCoupon.code === 'BIENVENIDO10' && email && db){
    try{
      const subDoc = await db.collection('newsletterSubscribers').doc(encodeURIComponent(email.toLowerCase())).get();
      if(subDoc.exists && subDoc.data().welcomeCouponRedeemed){
        await zyRemoveCoupon();
        showToast('El código BIENVENIDO10 ya fue usado con este correo — se quitó del pedido. Confirma de nuevo para continuar sin el descuento.', true);
        return;
      }
    }catch(e){ console.error('No se pudo verificar el cupón de bienvenida:', e); }
  }

  const btn = document.getElementById('payBtn');
  btn.disabled = true;
  btn.innerHTML = paymentMethod==='stripe'
    ? '<span class="pay-spinner"></span><span>Procesando pago…</span>'
    : '<span class="pay-spinner"></span><span>Confirmando…</span>';

  const subtotal = cart.reduce((a,c)=>a+c.price*c.qty,0);
  const discount = zyCouponDiscount(subtotal);
  const shipping = computeShippingCost();
  const giftUsed = zyGiftToUse(Math.max(0, subtotal - discount) + shipping);
  const total = Math.max(0, subtotal - discount) + shipping - giftUsed;

  const order = {
    orderNum: zyGenerateOrderNum(),
    date: Date.now(),
    name, phone, email,
    notifyEmail, notifyWhatsapp,
    shipMode, branch, address, city, zip, state,
    deliveryCoords: (shipMode==="domicilio" && zyDeliveryCoords) ? { lat:+zyDeliveryCoords.lat.toFixed(6), lng:+zyDeliveryCoords.lng.toFixed(6) } : null,   // pin de entrega marcado en el mapa
    items: cart.map(c=>({ id:c.id, ...zyItemSellerInfo(c.id), name:c.name, brand:c.brand, size:c.size, price:c.price, qty:c.qty, isMembership:!!c.isMembership, tierName:c.tierName||null, isGiftCard:!!c.isGiftCard, giftAmount:c.giftAmount||null, giftEmail:c.giftEmail||null })),
    subtotal, shipping, total,
    coupon: zyCoupon ? { code: zyCoupon.code, discount } : null,
    giftCardUsed: giftUsed,
    paymentMethod, // 'whatsapp' | 'stripe'
    paymentStatus: 'pendiente',
    status: 'recibido',
    // [RASTREO — HISTORIAL CON HORA REAL] Cada cambio de etapa se agrega
    // aquí con su fecha/hora real (ver zyAdminAdvanceOrderStatus), para
    // que "Detalles de rastreo" muestre un historial de verdad en vez de
    // solo el estado actual — igual que Mercado Libre/Amazon.
    statusHistory: [{ status:'recibido', at: Date.now() }],
    // [FIX] "Pedidos de una cuenta aparecen para otra / siguen tras cerrar
    // sesión": cada pedido guarda de qué cuenta (o "guest") era al
    // momento de comprar, para que el panel personal de "Pedidos y
    // rastreo" y el contador del header solo muestren lo que le
    // corresponde a quien está viendo la página — ver zyMyOrders().
    // El rastreo manual por número/teléfono (zyTrackOrder) NO usa este
    // filtro a propósito: cualquiera con el número de pedido debe poder
    // rastrearlo, tenga cuenta o no.
    ownerKey: userKey(),
    store: (function(){ try{ const st=new Set(cart.filter(c=>!c.isMembership).map(c=>{ const pr=PRODUCTS.find(x=>x.id===c.id); return (pr&&pr.store)||'zayde'; })); if(st.size>1) return 'mixed'; if(st.size===1) return Array.from(st)[0]; }catch(e){} return currentStore; })(), // [APARTADO ZAYDE G] (mixed = carrito con piezas de ambas tiendas) a qué almacén/tienda pertenece este pedido — ver zyMyOrders()
    verification: { status:'pendiente', code: zyGenVerificationCode(), verifiedAt:null, verifiedBy:null }
  };

  // [DIRECCIONES] Si el cliente marcó "Guardar esta dirección" y compró
  // envío a domicilio, la guarda en su cuenta para la próxima compra.
  const saveAddrChk = document.getElementById('ckSaveAddress');
  if(currentUser && saveAddrChk && saveAddrChk.checked && shipMode==='domicilio' && address){
    try{
      await zySaveAddress({ label:'Mi dirección', name, phone, street:address, city, zip, state, isDefault:false });
    }catch(e){ console.error('No se pudo guardar la dirección:', e); }
  }
  // [NOTIFICACIONES] Si el cliente tiene sesión, la elección que hizo en
  // este checkout también queda como su preferencia general para la
  // próxima vez.
  if(currentUser){
    try{ await Store.set('zayde:notifPrefs:'+userKey(), { email:notifyEmail, whatsapp:notifyWhatsapp }); }catch(e){}
  }

  const resetBtn = ()=>{
    btn.disabled = false;
    btn.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg><span id="payBtnLabel">Confirmar pedido</span>';
  };

  // ---- Inventario en tiempo real: reserva/descuenta el stock ANTES de
  // cobrar, así nunca se cobra una pieza que alguien más acaba de comprar.
  // Las membresías y tarjetas de regalo son digitales y no tienen stock
  // físico, así que se excluyen de la reserva. ----
  const physicalItems = order.items.filter(it=>!it.isMembership && !it.isGiftCard);
  const reservation = await zyReserveStock(physicalItems, order.orderNum);
  if(!reservation.ok){
    showToast(reservation.error, true);
    resetBtn();
    return;
  }

  // ---- Fiabilidad del pago: el pedido se guarda en Firestore como
  // "pendiente" ANTES de cobrar la tarjeta, no después. Así, si el
  // navegador se cierra o pierde conexión justo después de que Stripe
  // cobra pero antes de que termine el resto del flujo, el pedido YA
  // existe con su número real — y el webhook de Stripe (que corre en el
  // servidor, no en el navegador del cliente) lo puede encontrar por su
  // orderNum y marcarlo "pagado" de forma confiable, sin depender de que
  // el navegador del cliente siga vivo. ----
  if(paymentMethod === 'stripe'){
    // [SEGURIDAD] Las reglas de Firestore solo permiten CREAR pedidos como "pendiente"
    // (ya no se puede crear uno que diga "pagado"), así que el pedido tiene que
    // quedar guardado ANTES de cobrar. Si no se pudo guardar, NO se cobra.
    const savedOk = await zySaveOrder(order);
    if(!savedOk){
      await zyReleaseStock(reservation.reservationId, order.orderNum);
      showToast('No pudimos registrar tu pedido. Revisa tu conexión e inténtalo de nuevo — no se te cobró nada.', true);
      resetBtn();
      return;
    }
  }

  // ---- Cobro real con tarjeta (Stripe) ----
  if(paymentMethod === 'stripe'){
    const charge = (giftUsed > 0 && total < 0.5)
      ? await zyPayWithGift(order.orderNum)   // el saldo de la tarjeta cubre todo: se cierra en el servidor, sin Stripe
      : await zyChargeWithStripe(total, `Pedido ${order.orderNum} — ZAYDE`, name, order.orderNum);
    if(!charge.success){
      document.getElementById('stripeCardErrors').textContent = charge.error;
      showToast(charge.error, true);
      await zyReleaseStock(reservation.reservationId, order.orderNum); // el cobro falló: regresamos el stock reservado

      // [FIX] Antes, si el pago era rechazado, el cliente solo veía el
      // mensaje de error y no volvía a saber nada de su pedido: no se le
      // mostraba el número de pedido, y aunque el pedido SÍ quedaba
      // guardado en Firestore como "pendiente" (se guarda antes de
      // cobrar, ver arriba), nada en pantalla se lo decía ni le daba
      // forma de seguirlo. Además, no dependemos solo del webhook de
      // Stripe para marcarlo — lo actualizamos aquí mismo, directo desde
      // el navegador, como primera capa (el webhook lo vuelve a
      // confirmar del lado del servidor por si el navegador se cierra
      // justo en este momento).
      order.paymentStatus = 'fallido';
      order.paymentFailReason = charge.error || 'motivo no especificado';
      zySaveOrder(order);

      const box = document.getElementById('stripePaymentFailedBox');
      box.style.display = 'block';
      box.innerHTML = `
        <div><b>Tu pedido ${zyEscapeHtml(order.orderNum)} no se pudo pagar.</b></div>
        <div style="margin-top:4px;">No se te cobró nada. Tu pedido quedó guardado — puedes corregir los datos de tu tarjeta e intentar de nuevo, o coordinar por WhatsApp.</div>
        <div class="spf-actions">
          <button type="button" onclick="navigator.clipboard.writeText('${zyEscapeHtml(order.orderNum)}').then(()=>showToast('Número de pedido copiado')).catch(()=>{})">Copiar número de pedido</button>
          <button type="button" onclick="window.open('https://wa.me/${ZY_WHATSAPP_NUMBER}?text=' + encodeURIComponent('Hola, mi pago para el pedido ${zyEscapeHtml(order.orderNum)} de ZAYDE no se pudo procesar, ¿me ayudan a completarlo?'), '_blank')">Escribir por WhatsApp</button>
        </div>`;

      resetBtn();
      return;
    }
    order.paymentStatus = 'pagado';
    if(charge.gift) order.paidWithGift = true;
    order.stripePaymentIntentId = charge.paymentIntentId;
    order.cardBrand = charge.cardBrand || null;
    order.cardLast4 = charge.cardLast4 || null;
  }

  document.getElementById('stripePaymentFailedBox').style.display = 'none';
  zySaveOrder(order);
  try{ zyMeta('track','Purchase',{ content_ids:order.items.map(i=>String(i.id)), content_type:'product', num_items:order.items.reduce((a,i)=>a+(i.qty||1),0), value:Number(order.total)||0, currency:'MXN' }, { eventID: order.orderNum }); }catch(e){}   // [META] eventID = número de pedido (evita duplicados)
  if(order.paymentStatus === 'pagado') zyLogPriceHistory(order);
  zyNotifySellerLowStock(physicalItems); // [VENDEDORES] "queda 1 unidad" / "se agotó la talla"


  // ---- Se descuenta el saldo de tarjeta de regalo usado y se libera el
  // cupón aplicado, ya que el pedido quedó registrado (independientemente
  // del método de pago elegido) — así no se pueden reutilizar en un
  // pedido futuro. ----
  if(giftUsed > 0){
    // El saldo real lo descuenta el servidor (webhook) cuando Stripe confirma el pago; aquí solo se refleja en pantalla.
    zyGiftBalance = Math.max(0, zyGiftBalance - giftUsed);
  }
  if(zyCoupon){
    await zyRedeemCouponIfSingleUse(zyCoupon.code, order.orderNum);
    if(zyCoupon.birthday){ try{ await Store.set('zayde:bdayUsed:'+userKey(), zyCoupon.year || new Date().getFullYear()); }catch(e){} }
    // [FIX — "BIENVENIDO10 se puede volver a canjear"] A diferencia de los
    // cupones singleUse normales (que se apagan para TODO MUNDO en cuanto
    // los usa cualquiera), BIENVENIDO10 debe seguir funcionando para otros
    // clientes — solo se apaga para ESTE correo. Se marca en su propio
    // documento de newsletterSubscribers, y tanto zyNewsletterSignup como
    // la verificación de más arriba en confirmOrder revisan este flag.
    if(zyCoupon.code === 'BIENVENIDO10' && email && db){
      try{
        await db.collection('newsletterSubscribers').doc(encodeURIComponent(email.toLowerCase())).set({
          welcomeCouponRedeemed: true,
          welcomeCouponRedeemedAt: Date.now(),
          welcomeCouponRedeemedOrderNum: order.orderNum,
        }, { merge:true });
      }catch(e){ console.error('No se pudo marcar el cupón de bienvenida como canjeado:', e); }
    }
    await zyRemoveCoupon();
  }
  // [REFERIDOS] Si quien acaba de comprar fue traído por el código de otra
  // persona, aquí se le acredita a esa persona su 10% de recompensa — solo
  // la primera vez, zyCreditReferralReward ya se encarga de no repetirlo.
  zyCreditReferralReward(order.orderNum);

  // [FIX — "Al comprar una membresía me llega una cotización a mi bot de
  // WhatsApp y un correo de 'pedido confirmado' en vez de un aviso de
  // membresía"] zySendOrderWhatsApp() arma un mensaje de COTIZACIÓN
  // pensado para un pedido físico (productos, talla, envío/domicilio,
  // "coordinar por WhatsApp"). Una membresía (o tarjeta de regalo) es
  // 100% digital, se activa sola con el pago y no hay nada que armar,
  // enviar ni cotizar — por eso ese aviso a tu WhatsApp de negocio
  // (vía CallMeBot) ahora se omite para pedidos 100% digitales. El
  // mismo criterio (zyIsDigitalOnlyOrder) que ya se usaba para ocultar
  // la cotización y el botón de WhatsApp en el banner de confirmación
  // en pantalla (ver zyShowOrderConfirmation) ahora también aplica aquí.
  if(!zyIsDigitalOnlyOrder(order)){
    zySendOrderWhatsApp(order); // intento silencioso vía CallMeBot (bono si está activo, pero no es el método principal)
  }
  zySendOrderConfirmationEmail(order); // email real e inmediato al cliente, si dejó su correo

  // [MEMBRESÍAS] Recién AQUÍ, con el pago ya confirmado (order.paymentStatus
  // === 'pagado', que solo ocurre en la rama de Stripe arriba), se activa
  // cualquier membresía del pedido y se muestra el aviso de bienvenida —
  // nunca antes de este punto.
  if(order.paymentStatus === 'pagado'){
    zyActivatePaidMemberships(order);
    zyActivatePaidGiftCards(order);
  }

  cart = []; renderCart(); persistCart(); navigate('home');
  resetBtn();
  selectedBranch = null;
  const bs = document.getElementById('branchSummary');
  if(bs) bs.classList.remove('show');

  // El aviso ya NO es solo un toast de 2 segundos: se abre el panel de
  // "Pedidos y rastreo" con un aviso permanente (se cierra solo a mano)
  // y la tarjeta completa del pedido recién hecho, para que el número
  // de pedido nunca se pierda de vista. Se muestra PRIMERO, antes de
  // abrir WhatsApp, para que la confirmación de compra (sobre todo si
  // ya se pagó con tarjeta) sea lo primero que ve el cliente.
  zyShowOrderConfirmation(order, dest);
  if(order.paymentStatus === 'pagado') zyShowPurchaseSuccess(order); // [COMPRA EXITOSA] animación + botón "Ver mis pedidos"

  // ANTES aquí se intentaba abrir WhatsApp automático con setTimeout —
  // eso NO funciona de forma confiable: los navegadores (Chrome, Safari)
  // bloquean como "pop-up" cualquier window.open() que no venga
  // directamente de un clic real, y un setTimeout rompe esa cadena.
  // Por eso ahora es un botón real y visible en el banner de confirmación
  // ("Abrir WhatsApp con tu pedido") — un clic de verdad nunca se bloquea.
}
function zyOpenOrderWhatsApp(){
  if(!zyLastOrder){ showToast('No se encontró el pedido para enviar', true); return; }
  window.open(`https://wa.me/${ZY_WHATSAPP_NUMBER}?text=${encodeURIComponent(zyBuildOrderMessage(zyLastOrder))}`, '_blank');
}

/* [TARJETA DE REGALO — SIN PEDIDO] Flujo de pago dedicado para un carrito
   100% tarjetas de regalo: cobra con Stripe y emite la(s) tarjeta(s) al
   instante (zyIssueGiftCards), pero a propósito NUNCA arma un "order", NUNCA
   llama zyGenerateOrderNum/zySaveOrder y NUNCA pasa por zyShowOrderConfirmation
   — porque comprar una tarjeta de regalo es un servicio de ZAYDE, no un
   pedido de mercancía. Por eso tampoco aparece en "Pedidos y rastreo" ni
   en el contador de pedidos del header. */
// [SIN PEDIDO] Antes esta función (zyConfirmGiftCardOnlyPurchase) solo
// atendía carritos 100% tarjeta de regalo. Ahora atiende CUALQUIER carrito
// 100% digital (membresía sola, tarjeta de regalo sola, o ambas
// combinadas) — ver el nuevo criterio "digitalOnlyNoOrder" en
// confirmOrder(). Nunca genera orderNum, nunca guarda nada en la
// colección "orders" ni pasa por zyShowOrderConfirmation: cobra con
// Stripe, activa/emite lo que corresponda, y muestra su propia
// confirmación en pantalla.
function zyGenConfirmationCode(){
  return 'ZY-' + Math.random().toString(36).slice(2,6).toUpperCase() + '-' + Math.random().toString(36).slice(2,6).toUpperCase();
}
async function zyConfirmDigitalOnlyPurchase(contact){
  const btn = document.getElementById('payBtn');
  const resetBtn = ()=>{
    btn.disabled = false;
    btn.innerHTML = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg><span id="payBtnLabel">Confirmar pedido</span>';
  };
  btn.disabled = true;
  btn.innerHTML = '<span class="pay-spinner"></span><span>Procesando pago…</span>';

  const membershipItems = cart.filter(c=>c.isMembership);
  const giftItems = cart.filter(c=>c.isGiftCard);
  const total = cart.reduce((a,c)=>a+c.price*c.qty,0);
  const description = membershipItems.length && giftItems.length
    ? 'Membresía + tarjeta de regalo ZAYDE'
    : membershipItems.length ? 'Membresía ZAYDE Club' : 'Tarjeta de regalo ZAYDE';
  // Referencia puramente interna (soporte/logs de Stripe) — nunca se
  // muestra al cliente como "número de pedido", porque no es un pedido.
  const purchaseRef = 'DIG-' + Date.now().toString(36).toUpperCase() + '-' + Math.random().toString(36).slice(2,5).toUpperCase();

  const digitalPayload = {
    items: cart.filter(zyIsDigitalItem).map(c => ({ id:c.id, isMembership:!!c.isMembership, tierName:c.tierName || null, isGiftCard:!!c.isGiftCard, giftEmail:c.giftEmail || null, price:c.price, qty:c.qty })),
    contact: { name: contact.name || '', email: contact.email || '' }
  };
  const charge = await zyChargeWithStripe(total, description, contact.name, purchaseRef, digitalPayload);
  if(!charge.success){
    const errBox = document.getElementById('stripeCardErrors');
    if(errBox) errBox.textContent = charge.error;
    showToast(charge.error, true);
    resetBtn();
    return;
  }

  // ---- Membresías: cada una se activa de inmediato y genera su propio
  // código de confirmación (nunca un número de pedido). Se respalda en
  // Firestore (colección "digitalConfirmations") para que el correo pueda
  // verificarse contra ese código y para que quede en la cola de
  // confirmaciones por WhatsApp del panel privado. ----
  const membershipConfirmations = [];
  for(const m of membershipItems){
    const code = zyGenConfirmationCode();
    // La membresía la activa el servidor (webhook de Stripe); aquí solo se espera a que quede registrada.
    const srv = await zyWaitForServerMembership(m.tierName);
    if(srv){ currentMembership = srv; }   // refleja el envío gratis de inmediato en esta misma sesión
    else showToast('Recibimos tu pago. Tu membresía se activará en unos minutos; si no ves tus beneficios, escríbenos.', true);
    membershipConfirmations.push({ code, tierName: m.tierName });
    if(db){
      try{
        await db.collection('digitalConfirmations').doc(code).set({
          type: 'membership', code, tierName: m.tierName,
          name: contact.name || null, phone: contact.phone || null, email: contact.email || null,
          createdAt: Date.now(), whatsappSent: false
        });
      }catch(e){ console.error('No se pudo respaldar la confirmación de membresía en Firestore:', e); }
    }
    // El correo de bienvenida de la membresía lo manda el servidor (webhook) al confirmarse el pago.
  }
  if(membershipItems.length){ zyRenderClubStatus(); zyRenderClubTiers(); }

  await zyIssueGiftCards(giftItems.map(c=>({ giftAmount:c.giftAmount, giftEmail:c.giftEmail })), { name: contact.name, email: contact.email, purchaseRef });

  cart = []; renderCart(); persistCart();
  const failBox = document.getElementById('stripePaymentFailedBox');
  if(failBox) failBox.style.display = 'none';
  resetBtn();
  navigate('home');

  if(membershipItems.length) zyShowMembershipPurchaseModal(membershipConfirmations, giftItems, contact.email);
  else zyShowGiftCardPurchaseModal(giftItems, contact.email);
}
/* Confirmación de compra de membresía (y, si aplica, tarjeta de regalo
   combinada) — deliberadamente sin número de pedido: usa el mismo fondo
   de marca que la confirmación de tarjeta de regalo y muestra el código
   de confirmación real, nunca un "pedido". */
function zyShowMembershipPurchaseModal(confirmations, giftItems, buyerEmail){
  const m = confirmations && confirmations[0];
  const tierEl = document.getElementById('membershipSuccessTier');
  const textEl = document.getElementById('membershipSuccessText');
  const codeEl = document.getElementById('membershipSuccessCode');
  if(tierEl) tierEl.textContent = m ? m.tierName : 'ZAYDE Club';
  if(codeEl) codeEl.textContent = m ? m.code : '';
  if(textEl){
    let base = m ? `Tu membresía ${m.tierName} ya está activa en tu cuenta ZAYDE.` : '';
    if(giftItems && giftItems.length){
