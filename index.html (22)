    ? `<img src="${p.images[0]}" alt="${zyEscapeHtml(p.brand+' '+p.name)}" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;">`
    : `<div class="zybot-card-ph">${ZY_PLACEHOLDER_MARK}</div>`;
  const discountHTML = (p.discountPct && p.discountPct>0) ? `<span class="zybot-card-badge">${p.discountPct}% OFF</span>` : '';
  const sizeArg = size!=null ? `,'${String(size).replace(/'/g,"\\'")}'` : '';
  const noteHTML = note ? `<div class="zybot-card-note">${zyEscapeHtml(note)}</div>` : '';
  return `
  <div class="zybot-card" onclick="zyBotViewProduct(${p.id}${sizeArg})">
    <div class="zybot-card-media">${img}${discountHTML}</div>
    <div class="zybot-card-info">
