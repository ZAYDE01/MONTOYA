function showPolicyTab(tab){
  ['sobre','tallas','devoluciones','verificacion','faq','terminos','privacidad'].forEach(t=>{
    const sec = document.getElementById('psec-'+t);
    const btn = document.getElementById('ptab-'+t);
    if(sec) sec.style.display = (t===tab) ? '' : 'none';
    if(btn) btn.classList.toggle('active', t===tab);
  });
  const POLICY_TITLES_ES = { sobre:'Sobre ZAYDE', tallas:'Guía de tallas', devoluciones:'Política de devoluciones', verificacion:'Proceso de verificación', faq:'Preguntas frecuentes', terminos:'Términos y condiciones', privacidad:'Aviso de privacidad' };
  const titleMap = (currentLocale==='en')
    ? { sobre: I18N.en['policy.title.sobre'], tallas: I18N.en['policy.title.tallas'], devoluciones: I18N.en['policy.title.devoluciones'], verificacion: I18N.en['policy.title.verificacion'], faq: (I18N.en['policy.title.faq'] || 'Frequently asked questions'), terminos: I18N.en['policy.title.terminos'], privacidad: (I18N.en['policy.title.privacidad'] || 'Privacy notice') }
    : POLICY_TITLES_ES;
  const titleEl = document.getElementById('policyModalTitle');
  // [MODAL DE POLÍTICAS · ZAYDE G] Para las 4 pestañas de marca, en español
  // el título del modal se toma del texto YA AJUSTADO por tienda de su
  // propio botón de pestaña (ver zyApplyPolicyTextsForStore) en vez del
  // mapa fijo de arriba, para que diga "Sobre ZAYDE G" estando en ZAYDE G
  // sin necesitar un segundo mapa de títulos por tienda.
  const brandedTabs = {sobre:1, verificacion:1, terminos:1, privacidad:1};
  if(titleEl && currentLocale!=='en' && brandedTabs[tab]){
    const tabBtn = document.getElementById('ptab-'+tab);
    titleEl.textContent = (tabBtn && tabBtn.textContent.trim()) || titleMap[tab];
  } else if(titleEl && titleMap[tab]) titleEl.textContent = titleMap[tab];
  const panel = document.querySelector('#policyModal .policy-panel');
  if(panel) panel.scrollTop = 0;
  // [FIX — "el modal de políticas se ve todo corrido/cortado a la derecha
  // en celular al abrir FAQ u otra pestaña de más adelante"] activeBtn.
  // scrollIntoView({inline:'center'}) no solo desliza la fila de pestañas
  // (.policy-tabs, que sí tiene su propio scroll horizontal a propósito —
  // ver [FIX-POLICY-TABS-OVERFLOW] arriba): al pedir "center" en el eje
  // horizontal, el navegador sigue subiendo por los ancestros y termina
  // moviendo el scroll horizontal de TODA LA PÁGINA para intentar centrar
  // ese botón en la pantalla — aunque <html>/<body> tengan
  // "overflow-x:hidden" (eso solo oculta la barra de scroll, no evita que
  // se le pueda mover la posición). Resultado: el panel entero (textos,
  // pestañas, hasta la barra inferior de atrás) se ve desplazado hacia la
  // derecha, con todo cortado del lado izquierdo. Ahora se mueve a mano
  // SOLO el scroll interno de .policy-tabs (el contenedor real con el
  // carrusel de pestañas), sin tocar el scroll de la página.
  const activeBtn = document.getElementById('ptab-'+tab);
  if(activeBtn){
    const tabsRow = activeBtn.closest('.policy-tabs');
    if(tabsRow){
      const target = activeBtn.offsetLeft - (tabsRow.clientWidth - activeBtn.offsetWidth) / 2;
      tabsRow.scrollTo({ left: Math.max(0, target), behavior:'smooth' });
    } else {
      activeBtn.scrollIntoView({block:'nearest', inline:'center', behavior:'smooth'});
    }
  }
}
async function zyTrackOrder(){
  const raw = document.getElementById('trackInput').value.trim();
  const q = raw.toLowerCase();
  const box = document.getElementById('trackResult');
  if(!q){ box.innerHTML = '<p class="zy-hint">Escribe un número de pedido o teléfono.</p>'; return; }
  box.innerHTML = '<p class="zy-hint">Buscando…</p>';

  let order = null;

  // 1) Si parece un número de pedido (ZY-XXXXXX), lo buscamos en Firestore:
  //    funciona desde cualquier celular o computadora, no solo el que compró.
  const looksLikeOrderNum = /^zy-?\d+$/i.test(raw.replace(/\s+/g,''));
  if(looksLikeOrderNum && db){
    const orderNum = raw.replace(/\s+/g,'').toUpperCase().replace(/^ZY-?/, 'ZY-');
    try{
      const snap = await db.collection('orders').doc(orderNum).get();
      if(snap.exists){
        const d = snap.data();
        if(d && d.orderNum && Array.isArray(d.items)) order = d; // ignora documentos incompletos
      }
    }catch(e){ console.error('No se pudo consultar Firestore:', e); }
  }

  // 2) Respaldo: pedidos guardados en este mismo navegador (por número o teléfono),
  //    por si Firestore no está disponible o el cliente busca por teléfono.
  if(!order){
    const all = (await Store.get('zayde:orders')) || [];
    const qDigits = q.replace(/\D/g,'');
    order = all.find(o => (o.orderNum||'').toLowerCase()===q || (qDigits.length >= 7 && String(o.phone||'').replace(/\D/g,'')===qDigits));
  }

  if(!order){
    box.innerHTML = '<p class="zy-hint">No encontramos ese pedido. Revisa que el número esté bien escrito (ej. ZY-123456789012), o si buscaste por teléfono, hazlo desde el mismo celular donde compraste.</p>';
    return;
  }
  box.innerHTML = zyRenderOrderCard(order, {withActions:false});
  // [FIX] Lo que se ve aquí se actualiza solo cuando cambia la etapa, y si es
  // un pedido de este navegador también se refresca su copia local.
  zyWatchTrackedOrder(order.orderNum);
  zyApplyRemoteOrder(order);
}

