}
/* ================= [PANEL PRIVADO] Cola de confirmaciones por WhatsApp =================
   Membresías (y tarjetas de regalo) se pagan y activan solas, y el correo
   ya sale automático — pero WhatsApp no deja mandarle mensajes a
   cualquier cliente sin una cuenta de WhatsApp Business API de pago. Esta
   cola muestra cada confirmación digital pendiente (colección
   "digitalConfirmations", nunca "orders") con un botón que abre WhatsApp
   ya con el mensaje redactado — un clic tuyo para enviarlo. */
async function zyRenderDigitalConfirmationsQueue(){
  const box = document.getElementById('zyDigitalConfirmList');
  if(!box) return;
  box.innerHTML = `<div class="zy-list-item" style="color:var(--steel);">Cargando…</div>`;
  let items = [];
  try{
    if(db){
      // [ÍNDICE DE FIRESTORE] Esta consulta combina un "where" con un
      // "orderBy" en un campo distinto, así que Firestore pedirá crear un
      // índice compuesto la primera vez que se ejecute en producción — la
      // consola del navegador (F12) te va a mostrar un link directo para
      // crearlo con un clic (tarda ~1 minuto en activarse). Mientras tanto
      // esta lista se queda vacía sin romper nada más del panel.
      const snap = await db.collection('digitalConfirmations').where('whatsappSent','==', false).orderBy('createdAt','desc').limit(30).get();
      items = snap.docs.map(d=>d.data());
    }
  }catch(e){
    console.error('No se pudieron cargar las confirmaciones digitales pendientes (¿falta crear el índice de Firestore? revisa el link en este mismo error):', e);
  }
  if(!items.length){
    box.innerHTML = `<div class="zy-list-item" style="color:var(--steel);">No hay confirmaciones pendientes por WhatsApp.</div>`;
    return;
  }
  box.innerHTML = items.map(it=>`
    <div class="zy-list-item">
      <span>${zyEscapeHtml(it.name||'Cliente')} — ${it.type==='membership' ? `Membresía ${zyEscapeHtml(it.tierName||'')}` : 'Tarjeta de regalo'} <span class="zy-hint">(${zyEscapeHtml(it.code)})</span></span>
      <span style="display:flex; gap:6px; flex-wrap:wrap;">
        ${it.phone ? `<button onclick="zyOpenDigitalConfirmationWhatsApp('${zyEscapeHtml(it.code)}')">Enviar por WhatsApp</button>` : `<span class="zy-hint">Sin teléfono</span>`}
      </span>
    </div>`).join('');
}
async function zyOpenDigitalConfirmationWhatsApp(code){
  let data = null;
  try{
    if(db){ const doc = await db.collection('digitalConfirmations').doc(code).get(); if(doc.exists) data = doc.data(); }
  }catch(e){ console.error('No se pudo cargar la confirmación digital:', e); }
  if(!data || !data.phone){ showToast('No se encontró el teléfono de este cliente', true); return; }
  const what = data.type==='membership' ? `tu membresía *${data.tierName||''}*` : 'tu tarjeta de regalo';
  const waText = encodeURIComponent(
    `Hola ${data.name || ''}, te escribimos de ZAYDE ✅\n\n¡Gracias por tu compra! ${what} ya está activa.\n\nTu código de confirmación es *${data.code}*.\n\nTambién te llegó la confirmación a tu correo. Cualquier duda, quedo al pendiente por aquí.`
  );
  const waPhone = data.phone.replace(/\D/g,'');
  const fullPhone = waPhone.length === 10 ? '52' + waPhone : waPhone; // asume MX si son 10 dígitos
  window.open(`https://wa.me/${fullPhone}?text=${waText}`, '_blank');
  try{
    if(db) await db.collection('digitalConfirmations').doc(code).set({ whatsappSent:true, whatsappSentAt: Date.now() }, { merge:true });
  }catch(e){ console.error('No se pudo marcar la confirmación como enviada:', e); }
  zyRenderDigitalConfirmationsQueue();
}
/* Confirmación de compra de tarjeta(s) de regalo — deliberadamente sin
   número de pedido ni botón para "rastrear": usa el fondo de marca
