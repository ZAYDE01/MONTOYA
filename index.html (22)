// [MOTOR DE RECOMENDACIÓN v2] Cascada, SIEMPRE dentro de la categoría y línea
// que pidió el cliente: 1) talla exacta → 2) tallas cercanas → 3) misma línea
// en otras tallas → 4) aviso por WhatsApp. Ya no se ofrecen otras categorías.
function zyBotShowRecommendations(cat, size, aud, gender){
  zybotLast = {cat, aud, gender, size};
  zyBotTypingShow();
  setTimeout(()=>{
    zyBotTypingHide();
    const nm = zyBotGreetName();
    const desc = zyBotDescribe(cat, aud, gender);
    const sizeLbl = size!=null ? `talla ${cat==='Zapatos' ? ((zyShoeMx({category:'Zapatos',gender:gender||'Hombre'},size)||size)+' MX') : size}` : '';
    const notify = zyBotNotifyBtnHTML(cat, size, desc);
    const retry = zyBotRetryBtnsHTML(cat, size, aud);

    const exact = zyBotFindMatches(cat, size, aud, gender);
    if(exact.length){
      const head = size!=null
        ? `¡Sí tenemos tu ${sizeLbl}${nm}! 🙌 Esto es lo disponible en ${desc} 👇`
        : `¡Mira${nm}! Esto es lo que tenemos disponible de ${desc} 👇`;
      zyBotAppendMsg('bot', head, zyBotNowLabel(), {anchorStart:true});
      zyBotAppendHTML(`<div class="zybot-cards">${exact.map(p=>zyBotMiniCardHTML(p, size)).join('')}</div>`, {scroll:false});
      zyBotAppendMsg('bot', 'Dale clic a cualquiera para ver todos los detalles y comprarla. ¿Te ayudo con algo más?', zyBotNowLabel(), {scroll:false, scrollCap:true});
      zyBotAppendQuick({scroll:false});
      return;
    }

    const nearby = zyBotFindNearbySizeMatches(cat, size, aud, gender);
    if(nearby.length){
      zyBotAppendMsg('bot', `La ${sizeLbl} exacta en ${desc} no la tengo disponible ahorita${nm}, pero sí tengo estas con tallas muy cercanas 👇`, zyBotNowLabel(), {anchorStart:true});
      zyBotAppendHTML(`<div class="zybot-cards">${nearby.map(m=>zyBotMiniCardHTML(m.product, m.size, `Disponible en talla ${m.size}`)).join('')}</div>`, {scroll:false});
      zyBotAppendMsg('bot', 'Si prefieres esperar tu talla exacta, te aviso en cuanto entre.', zyBotNowLabel(), {scroll:false});
      zyBotAppendHTML(`<div class="zybot-quick">${notify}</div>`, {scroll:false, scrollCap:true});
      zyBotAppendQuick({scroll:false});
      return;
    }

    const sameLine = zyBotFindCategoryMatches(cat, aud, gender);
    if(sameLine.length){
      zyBotAppendMsg('bot', `No tengo ${size!=null?'la '+sizeLbl+' en ':''}${desc} disponible ahorita${nm}. Esto sí está disponible en otras tallas, por si te sirve:`, zyBotNowLabel(), {anchorStart:true});
      zyBotAppendHTML(`<div class="zybot-cards">${sameLine.map(p=>zyBotMiniCardHTML(p, null)).join('')}</div>`, {scroll:false});
      zyBotAppendMsg('bot', 'También puedo avisarte en cuanto llegue tu talla, sin compromiso.', zyBotNowLabel(), {scroll:false});
      zyBotAppendHTML(`<div class="zybot-quick">${notify}</div>` + retry, {scroll:false, scrollCap:true});
      zyBotAppendQuick({scroll:false});
      return;
    }

    zyBotAppendMsg('bot', `Por ahora no tengo ${desc}${size!=null?' en '+sizeLbl:''} disponible${nm}. Puedo avisarte en cuanto llegue, o puedes probar con otra talla o línea.`, zyBotNowLabel(), {anchorStart:true});
    zyBotAppendHTML(`<div class="zybot-quick">${notify}</div>` + retry, {scroll:false});
    zyBotAppendQuick({scroll:false});
  }, 650);
}

