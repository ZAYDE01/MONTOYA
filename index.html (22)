/* ============================================================
   [NOTIFICACIONES] Preferencias de aviso, por cuenta — el equivalente
   al "Notification Preferences" del perfil de Nike. A diferencia de
   Nike (que separa avisos transaccionales de marketing), aquí se
   guarda una sola preferencia por canal (correo / WhatsApp) que se
   prellena en el checkout y viaja en cada pedido nuevo (order.notifyEmail
   / order.notifyWhatsapp) — así el aviso de "tu pedido va en camino"
   respeta lo que el cliente eligió, sin que el admin tenga que
   consultar la cuenta de cada quien (los pedidos ya cargan la
   preferencia consigo). Pedidos de invitados (sin cuenta) siempre
   quedan en "sí" por default, igual que antes de este cambio. */
let zyNotifPrefs = { email:true, whatsapp:true, drop:false };
async function zyLoadNotifPrefs(){
  zyNotifPrefs = (await Store.get('zayde:notifPrefs:'+userKey())) || { email:true, whatsapp:true, drop:false };
  if(typeof zyNotifPrefs.drop === 'undefined') zyNotifPrefs.drop = false; // cuentas viejas guardadas antes de que existiera este switch
}
async function zyToggleNotifPref(channel, btn){
  zyNotifPrefs[channel] = !zyNotifPrefs[channel];
  await Store.set('zayde:notifPrefs:'+userKey(), zyNotifPrefs);
  if(btn) btn.classList.toggle('active', zyNotifPrefs[channel]);
}
/* ============================================================
   [DROP-NOTIF] Interruptor "Aviso de Drop en vivo" — el panel admin
   (pestaña "Drop & ticker") ya mostraba el conteo de "Clientes que
   pidieron aviso del Drop", pero esa lista (colección dropSubscribers)
   solo la llenaba el admin a mano (zyAdminAddDropSubscriber): nunca
   existió, del lado del cliente, una forma real de apuntarse solo. Este
   switch vive junto a los otros dos de "Preferencias de notificaciones"
   pero, a diferencia de esos (que solo guardan una preferencia local),
   este SÍ escribe/borra en vivo en la misma colección pública
   dropSubscribers que ya lee el panel admin — así, en cuanto el cliente
   lo prende, aparece de inmediato en esa lista (con el correo de la
   cuenta con la que inició sesión), y al apagarlo se quita. Por eso
   solo vive dentro del bloque `${!currentUser ? '' : ...}` del panel de
   cuenta: sin sesión iniciada no hay a qué correo avisarle.
   [LÍMITE CONOCIDO] Si el admin vacía la lista a mano (zyClearDropSubscribers,
   normalmente después de cada Drop), el switch del cliente se queda
   marcado como "activado" aunque su registro ya no exista en Firestore
   — se resuelve solo la próxima vez que lo apague y prenda. */
async function zyToggleDropNotifPref(btn){
  if(!currentUser){ showToast('Inicia sesión para activar el aviso del Drop en vivo', true); openLogin(); return; }
  const fbUser = (typeof firebase !== 'undefined' && firebaseReady) ? firebase.auth().currentUser : null;
  const email = fbUser ? (fbUser.email || '') : '';
  if(!email){ showToast('Tu cuenta no tiene un correo asociado — no se pudo activar el aviso', true); return; }
  if(typeof db === 'undefined' || !db){ showToast('El aviso del Drop necesita conexión a la nube (Firestore) — intenta de nuevo en un momento.', true); return; }
  const turningOn = !zyNotifPrefs.drop;
  const docId = encodeURIComponent(email.toLowerCase());
  try{
    if(turningOn){
      const phone = (zyAddresses[0] && zyAddresses[0].phone) || '';
      await db.collection('dropSubscribers').doc(docId).set({ name: currentUser.name || '', phone, email, date: Date.now() }, { merge:true });
      showToast('Listo — te avisaremos en cuanto el Drop esté en vivo');
    } else {
      await db.collection('dropSubscribers').doc(docId).delete();
      showToast('Ya no recibirás el aviso del Drop en vivo');
    }
    zyNotifPrefs.drop = turningOn;
    await Store.set('zayde:notifPrefs:'+userKey(), zyNotifPrefs);
    if(btn) btn.classList.toggle('active', zyNotifPrefs.drop);
  }catch(e){
    console.error('No se pudo actualizar el aviso de Drop en vivo:', e);
    showToast('No se pudo guardar el cambio, intenta de nuevo', true);
  }
}
function zyToggleNotifPanel(){
