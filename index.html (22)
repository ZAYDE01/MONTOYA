function openCheckout(){
  if(!cart.length){ showToast('Tu carrito está vacío', true); return; }
  try{ zyMeta('track','InitiateCheckout',{ content_ids:cart.map(c=>String(c.id)), content_type:'product', num_items:cart.reduce((a,c)=>a+(c.qty||1),0), value:cart.reduce((a,c)=>a+(Number(c.price)||0)*(c.qty||1),0), currency:'MXN' }); }catch(e){}   // [META]
  // [CHECKOUT — SECCIÓN PROPIA] Ya no es una ventana/modal flotante: es su
  // propia página completa (como el checkout de la app de Nike), a la que
  // se llega navegando desde la Bolsa.
  navigate('checkout');
  zyCkGoStep(1);   // [CHECKOUT 3 PASOS] siempre se entra por ENVÍO
  zyEnsureLeaflet(function(){});   // precarga la librería del mapa para que «Ubicarme» responda al instante
  zyRenderCheckoutSummaryItems();
  const hasDigital = cart.some(zyIsDigitalItem);
  zyToggleDigitalCheckoutUI();
  // Las membresías y tarjetas de regalo se pagan con tarjeta para
  // activarse/emitirse al instante — no por WhatsApp, donde el pago no
  // está confirmado en el momento.
  switchPaymentMethod(hasDigital ? 'stripe' : 'whatsapp');
  renderShipOptions(); // [FIX] refleja el envío gratis (por monto o cupón) cada vez que se abre el checkout, no solo al cargar la página
  updateCheckoutTotals();
  const errEl = document.getElementById('stripeCardErrors');
  if(errEl) errEl.textContent = '';
  const failBox = document.getElementById('stripePaymentFailedBox');
  if(failBox){ failBox.style.display = 'none'; failBox.innerHTML = ''; }
  // [DIRECCIONES / NOTIFICACIONES] Si el cliente tiene sesión, prellena
  // con su dirección predeterminada y sus preferencias de aviso guardadas
  // — así no tiene que volver a teclear todo en cada compra.
  zyPrefillCheckoutFromAccount();
}
/* [RESUMEN — CHECKOUT] Dibuja la lista de productos dentro del acordeón
   "Resumen" de la página de checkout (estilo Nike: foto, nombre, talla/
