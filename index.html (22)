/* Pestaña "Contraseña": entra directo con la contraseña que la persona
   eligió al registrarse (ver nkVerifyCode → createUserWithEmailAndPassword
   más abajo). Si escribe mal, o si es una cuenta vieja de cuando la
   contraseña se generaba sola y nunca la vio, la mandamos a la pestaña de
   código en vez de dejarla atorada. */
async function nkLoginWithPassword(){
  const pass = document.getElementById('nkLoginPassword').value;
  if(!pass){ showToast('Escribe tu contraseña', true); return; }
  const btn = document.getElementById('nkPassSubmitBtn');
  btn.disabled = true; btn.textContent = 'Un momento...';
  zyExplicitAuthInProgress = true;
  try{
    const cred = await firebase.auth().signInWithEmailAndPassword(nkPendingEmail, pass);
    const name = cred.user.displayName || nkPendingEmail.split('@')[0];
    await setUser(name, 'correo', cred.user.uid, cred.user.email, cred.user.metadata && cred.user.metadata.creationTime ? new Date(cred.user.metadata.creationTime).toISOString() : null);
  }catch(err){
    console.error(err);
    let msg = 'No se pudo iniciar sesión.';
    if(err.code === 'auth/wrong-password' || err.code === 'auth/invalid-credential') msg = 'Contraseña incorrecta. Revísala e intenta de nuevo.';
    else if(err.code === 'auth/user-not-found') msg = 'No encontramos una cuenta con ese correo. Toca "Crear cuenta" para darte de alta.';
    else if(err.code === 'auth/too-many-requests') msg = 'Demasiados intentos. Espera un momento e intenta de nuevo.';
    showToast(msg, true);
  } finally {
    zyExplicitAuthInProgress = false;
    btn.disabled = false; btn.textContent = 'Iniciar sesión';
  }
}
/* [PEDIDO CLIENTE] "Crear cuenta" ya no depende de adivinar si el correo es
   nuevo o no: la cuenta se crea de una vez con createUserWithEmailAndPassword.
   Esa es la fuente de verdad real de Firebase — si el correo YA tiene cuenta,
   esta llamada falla al instante con auth/email-already-in-use, se muestra
   solo ese error, y el flujo se detiene ahí mismo: nunca se envía ningún
   código de verificación a un correo que ya está registrado (por seguridad,
   tanto de quien intenta registrarse como del dueño real de esa cuenta). Solo
   si el correo SÍ es nuevo pasamos al paso 4 y mandamos el código, para
   confirmar que la persona de verdad tiene acceso a ese correo. */
async function nkCreateAccount(){
  const signupEmail = (document.getElementById('nkSignupEmailInput').value || '').trim();
  if(!signupEmail || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(signupEmail)){ showToast('Ingresa un correo válido', true); return; }
  nkPendingEmail = signupEmail;
  const first = document.getElementById('nkFirstName').value.trim();
  const last = document.getElementById('nkLastName').value.trim();
  const termsOk = document.getElementById('nkOptInTerms').checked;
  const newPassword = document.getElementById('nkNewPassword').value;
  const newPassword2 = document.getElementById('nkNewPasswordConfirm').value;
  if(!first || !last){ showToast('Ingresa tu nombre y apellido', true); return; }
  if(!newPassword || newPassword.length < 6){ showToast('Tu contraseña debe tener al menos 6 caracteres', true); return; }
  if(newPassword !== newPassword2){ showToast('Las contraseñas no coinciden', true); return; }
  if(!termsOk){ showToast('Debes aceptar los Términos de uso y la Política de privacidad', true); return; }
  const dobRaw = {
    d: (document.getElementById('nkDobDay')||{}).value, m: (document.getElementById('nkDobMonth')||{}).value, y: (document.getElementById('nkDobYear')||{}).value
  };
  const dob = zyParseDob(dobRaw.d, dobRaw.m, dobRaw.y);
  if(!dob){ showToast('Ingresa una fecha de nacimiento válida (día, mes y año)', true); return; }
  nkPendingDob = dob;
  const typedName = (first+' '+last).trim();

  const btn = document.getElementById('nkCreateBtn');
  btn.disabled = true; btn.textContent = 'Un momento...';
  zyExplicitAuthInProgress = true;
  try{
    const cred = await firebase.auth().createUserWithEmailAndPassword(nkPendingEmail, newPassword);
    if(typedName){ try{ await cred.user.updateProfile({ displayName: typedName }); }catch(e){} }
    await zyApplyPendingReferral(cred.user.uid); // [REFERIDOS] cuenta nueva de verdad: aplica el 10% si venía de un link/código de invitación
    nkPendingSignupName = typedName;
    nkPendingSignupUid = cred.user.uid;
    nkPendingSignupCreated = cred.user.metadata && cred.user.metadata.creationTime ? new Date(cred.user.metadata.creationTime).toISOString() : null;
    document.getElementById('nkCodeSentEmail').textContent = nkPendingEmail;
    document.getElementById('nkCode').value = '';
    nkCodeSent = true;
    nkShowStep('nkStep4');
    await nkSendCode(nkPendingEmail);
  }catch(err){
    console.error(err);
    let msg = 'No se pudo crear la cuenta. Intenta de nuevo.';
    if(err.code === 'auth/email-already-in-use') msg = 'Ese correo ya está registrado en ZAYDE. Inicia sesión en su lugar.';
    else if(err.code === 'auth/weak-password') msg = 'Tu contraseña es muy débil. Usa al menos 6 caracteres.';
    else if(err.code === 'auth/too-many-requests') msg = 'Demasiados intentos. Espera un momento e intenta de nuevo.';
    else if(err.code === 'auth/invalid-email') msg = 'Ese correo no es válido.';
    showToast(msg, true);
    zyExplicitAuthInProgress = false;
  } finally {
    btn.disabled = false; btn.textContent = 'Crear cuenta';
  }
}
/* Paso 4: la cuenta ya existe en Firebase (creada en nkCreateAccount); este
   código solo confirma que la persona tiene acceso real a ese correo antes
   de abrir su sesión en ZAYDE. */
async function nkVerifySignupCode(){
  const code = document.getElementById('nkCode').value.trim();
  if(!code || code.length < 6){ showToast('Ingresa el código de 6 dígitos que te enviamos', true); return; }
  const btn = document.getElementById('nkSubmitBtn');
  btn.disabled = true; btn.textContent = 'Un momento...';
  zyExplicitAuthInProgress = true;
  try{
    // [FIX #2] La verificación la hace el SERVIDOR (type "otp-verify"): compara
    // el código contra su hash, limita a 5 intentos y, si es correcto, marca
    // la cuenta como emailVerified. El navegador ya no puede "adivinar" ni
    // saltarse esta comprobación comparando contra una variable local.
    let vres, vdata = {};
    try{
      const u = firebase.auth().currentUser;
      if(!u) throw new Error('sin-sesion');
      const token = await u.getIdToken();
      vres = await fetch('/api/send-email', {
        method:'POST',
        headers:{'Content-Type':'application/json', 'Authorization':'Bearer ' + token},
        body: JSON.stringify({ type:'otp-verify', code })
      });
      vdata = await vres.json().catch(()=>({}));
    }catch(e){
      console.error(e);
      showToast('No se pudo verificar el código. Revisa tu conexión e inténtalo de nuevo.', true);
      return;
    }
    if(!vres.ok){
      let msg = 'No se pudo verificar el código. Inténtalo de nuevo.';
      if(vdata.error === 'invalid-code') msg = 'Ese código no es correcto. Revisa tu correo e inténtalo de nuevo.' + (vdata.remaining != null ? ' (' + vdata.remaining + ' intento(s) restante(s))' : '');
      else if(vdata.error === 'code-expired') msg = 'Ese código ya venció. Toca "Reenviar código" para recibir uno nuevo.';
      else if(vdata.error === 'too-many-attempts') msg = 'Demasiados intentos con ese código. Toca "Reenviar código" para recibir uno nuevo.';
      showToast(msg, true);
      return;
    }
    // Refresca el token para que ya incluya email_verified = true.
    try{ await firebase.auth().currentUser.getIdToken(true); }catch(e){ console.error('No se pudo refrescar el token:', e); }
    const user = firebase.auth().currentUser;
    const name = nkPendingSignupName || (user && user.displayName) || nkPendingEmail.split('@')[0];
    await setUser(name, 'correo', (user && user.uid) || nkPendingSignupUid, nkPendingEmail, nkPendingSignupCreated);
    if(nkPendingDob){ try{ if(!(await zyGetDob())) await zyPersistDobOnce(nkPendingDob); }catch(e){} nkPendingDob = null; zyBirthdayCheck(); }
  }catch(err){
    console.error(err);
    showToast('Tu cuenta ya fue creada, pero no se pudo abrir la sesión automáticamente. Cierra esta ventana e inicia sesión con tu contraseña.', true);
  } finally {
    zyExplicitAuthInProgress = false;
    btn.disabled = false; btn.textContent = 'Confirmar y entrar';
  }
}
