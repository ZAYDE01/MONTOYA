/* ================= CARRITO ABANDONADO =================
   Guarda una foto del carrito ligada al correo en cuanto el cliente lo
   escribe en el checkout (aunque no termine la compra) — es lo único que
   nos avisa que un carrito se quedó a medias, ya que aquí una orden solo
   se registra hasta que se confirma. Un cron aparte (ver
   /api/send-abandoned-cart-emails.js) manda el recordatorio horas después
   si esa orden nunca se completó. */
async function zySaveAbandonedCart(){
  try{
    const emailEl = document.getElementById('ckEmail');
    const email = emailEl ? emailEl.value.trim() : '';
    if(!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return;
    if(!cart.length || !db) return;
    const items = cart.map(c=>({ name:c.name, brand:c.brand, size:c.size||null, price:c.price, qty:c.qty }));
    const total = cart.reduce((sum,c)=>sum + c.price*c.qty, 0);
    await db.collection('abandonedCarts').doc(encodeURIComponent(email.toLowerCase())).set({
      email, items, total, updatedAt: Date.now(), status:'pending', emailSent:false
    }, { merge:true });
  }catch(e){ console.error('No se pudo guardar el carrito abandonado:', e); }
}
/* Se llama al confirmar una orden con éxito — saca ese correo de la cola
   de recordatorios para no mandarle un "olvidaste algo" de algo que ya
   compró. */
async function zyMarkCartRecovered(email){
  try{
    if(!email || !db) return;
    await db.collection('abandonedCarts').doc(encodeURIComponent(email.toLowerCase())).set({ status:'recovered' }, { merge:true });
  }catch(e){ console.error('No se pudo marcar el carrito como recuperado:', e); }
}
