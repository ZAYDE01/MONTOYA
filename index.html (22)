function zyWipeLocalAccountData(){
  const uk = userKey();
  const keys = ['zayde:session'];
  ['', 'cg:'].forEach(pre=>{
    ['cart','favorites','coupon'].forEach(k=> keys.push('zayde:'+k+':'+pre+uk));
  });
  ['addresses','bdayUsed','club','dob','inbox','memberSince','notifPrefs','prefs','profilePhoto','restockWatch','returns','sizeprofile','stripeCustomer','coupon']
    .forEach(k=> keys.push('zayde:'+k+':'+uk));
  keys.forEach(k=>{
    try{ if(window.storage && window.storage.delete) window.storage.delete(k, false); }catch(e){}
    try{ localStorage.removeItem(k); }catch(e){}
  });
}
async function zyRunDeleteAccount(){
  const m = document.getElementById('zyDeleteAccModal');
  const err = document.getElementById('zyDeleteAccErr');
  const go = document.getElementById('zyDeleteAccGo');
  const no = document.getElementById('zyDeleteAccNo');
  if(!m || !currentUser || m.dataset.busy) return;
  const uid = currentUser.uid;
  const fbUser = (uid && typeof firebase !== 'undefined' && firebaseReady) ? firebase.auth().currentUser : null;
  const passEl = document.getElementById('zyDeleteAccPass');
  const pass = passEl ? passEl.value : '';
  if(fbUser && currentUser.provider !== 'Google' && !pass){ err.textContent = 'Escribe tu contraseña para continuar.'; return; }
  err.textContent = '';
  m.dataset.busy = '1'; go.disabled = true; no.disabled = true; go.textContent = 'Eliminando…';
  zyExplicitAuthInProgress = true; // evita que el listener de sesión reaccione a mitad del proceso
  try{
    // 1) Reautenticar (Firebase lo exige para borrar una cuenta)
    if(fbUser){
      if(currentUser.provider === 'Google'){
        await fbUser.reauthenticateWithPopup(new firebase.auth.GoogleAuthProvider());
      } else {
        const cred = firebase.auth.EmailAuthProvider.credential(fbUser.email, pass);
        await fbUser.reauthenticateWithCredential(cred);
      }
    }
    // 2) Datos en la nube que el cliente puede borrar (si las reglas no lo permiten, se omite sin romper el flujo)
    const email = (fbUser && fbUser.email) || currentUser.email || '';
    if(typeof db !== 'undefined' && db && email){
      try{ await db.collection('dropSubscribers').doc(encodeURIComponent(email.toLowerCase())).delete(); }catch(e){}
    }
    // 3) Borrar el usuario de Firebase Auth
    if(fbUser){ await fbUser.delete(); }
    // 4) Borrar datos locales y cerrar sesión
    zyWipeLocalAccountData();
    currentUser = null;
    currentStore = 'zayde';
    zyProfilePhotoUrl = null;
    const slot = document.getElementById('accountSlot');
    if(slot) slot.innerHTML = accountGuestHTML();
    try{ await loadAccountData(false); }catch(e){}
    try{ zyUpdateOrderBadge(); zyLoadRecentOrder(); }catch(e){}
    delete m.dataset.busy;
    zyProfileModal('zyDeleteAccModal', `
      <h3 style="margin:0 0 8px; font-size:17px;">Tu cuenta fue eliminada</h3>
      <p style="margin:0 0 16px; font-size:13px; line-height:1.5; color:var(--steel);">Borramos tu cuenta y tus datos. Gracias por haber sido parte de ZAYDE.</p>
      <button type="button" class="btn btn-primary" style="width:100%;" onclick="zyCloseProfileModal('zyDeleteAccModal')">Cerrar</button>`);
    navigate('home');
  }catch(e){
    console.error('No se pudo eliminar la cuenta:', e);
    let msg = 'No se pudo eliminar la cuenta. Intenta de nuevo en un momento.';
    const c = e && e.code;
    if(c === 'auth/wrong-password' || c === 'auth/invalid-credential' || c === 'auth/invalid-login-credentials') msg = 'La contraseña no es correcta.';
    else if(c === 'auth/too-many-requests') msg = 'Demasiados intentos. Espera unos minutos e inténtalo de nuevo.';
    else if(c === 'auth/popup-closed-by-user' || c === 'auth/cancelled-popup-request') msg = 'Cerraste la ventana de Google antes de confirmar.';
    else if(c === 'auth/popup-blocked') msg = 'Tu navegador bloqueó la ventana de Google. Permite ventanas emergentes e intenta de nuevo.';
    else if(c === 'auth/user-mismatch') msg = 'Esa no es la cuenta con la que iniciaste sesión.';
    else if(c === 'auth/network-request-failed') msg = 'Sin conexión. Revisa tu internet e intenta de nuevo.';
    if(err){ err.textContent = msg; }
    delete m.dataset.busy;
    if(go){ go.disabled = false; go.textContent = 'Sí, eliminar todo'; }
    if(no){ no.disabled = false; }
  }finally{
    zyExplicitAuthInProgress = false;
  }
}

