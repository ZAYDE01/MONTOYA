async function zySaveName(){
  const input = document.getElementById('zyEditNameInput');
  const err = document.getElementById('zyEditNameErr');
  const btn = document.getElementById('zyEditNameSave');
  if(!input || !currentUser) return;
  const newName = input.value.replace(/\s+/g,' ').trim();
  if(newName.length < 2){ err.textContent = 'Escribe un nombre de al menos 2 caracteres.'; return; }
  if(newName.length > 40){ err.textContent = 'El nombre es demasiado largo (máximo 40 caracteres).'; return; }
  if(newName === currentUser.name){ zyCloseProfileModal('zyEditNameModal'); return; }
  btn.disabled = true; btn.textContent = 'Guardando…';
  try{
    // Se mantiene la misma llave de datos: userKey() usa el uid, no el nombre
    // (solo las cuentas sin uid dependen del nombre, y esas no se pueden renombrar).
    if(!currentUser.uid){
      err.textContent = 'Esta cuenta no se puede renombrar. Inicia sesión de nuevo e inténtalo.'; btn.disabled = false; btn.textContent = 'Guardar'; return;
    }
    const fbUser = (typeof firebase !== 'undefined' && firebaseReady) ? firebase.auth().currentUser : null;
    if(fbUser){ await fbUser.updateProfile({ displayName: newName }); }
    currentUser.name = newName;
    await Store.set('zayde:session', currentUser);
    const slot = document.getElementById('accountSlot');
    if(slot) slot.innerHTML = accountChipHTML(currentUser);
    try{ zySetAvatarEl(document.getElementById('accountModalAvatar'), newName); }catch(e){}
    zyCloseProfileModal('zyEditNameModal');
    if(currentPage === 'account') renderAccountPage();
  }catch(e){
    console.error('No se pudo actualizar el nombre:', e);
    err.textContent = 'No se pudo guardar el cambio. Revisa tu conexión e intenta de nuevo.';
    btn.disabled = false; btn.textContent = 'Guardar';
  }
}

