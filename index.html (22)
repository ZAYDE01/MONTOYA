/* ================= [ZAYDE CLUB] Membresía =================
   Los niveles de pago (cualquier tier cuyo precio tenga un monto, ej. "$149
   MXN / mes") YA NO se activan con solo hacer clic: se agregan al carrito
   como un ítem digital y el "¡Bienvenido!" solo aparece hasta que el pago
   se cobra de verdad en el checkout (ver confirmOrder() / zyActivatePaidMemberships()).
   Un nivel sin monto (ej. "Gratis") se sigue activando al instante, porque
   no hay nada que cobrar. */
// [MEMBRESÍAS DE PAGA · INTERRUPTOR] true = se venden Icon / Icon Black. Pon false para pausarlas por ahora: el nivel gratuito
// Member sigue funcionando y los miembros de paga actuales conservan su beneficio hasta que venza su mes.
const ZY_PAID_MEMBERSHIPS_ENABLED = false;   // PAUSADAS por ahora (pon true para volver a venderlas)
function zyParseTierAmount(priceStr){
  if(!priceStr) return 0;
  const digits = String(priceStr).replace(/[^\d]/g, '');
  return digits ? parseInt(digits, 10) : 0;
}
// [MEMBRESÍAS · NIVELES] Devuelve el monto ($) del nivel por NOMBRE, buscando
// en zySettings.clubTiers — así comparamos "de qué nivel a qué nivel" es un
// cambio (subida o bajada) usando el precio real configurado en el panel,
// en vez de asumir un orden fijo de nombres (que el admin puede editar).
function zyClubTierAmount(tierName){
  const t = (zySettings.clubTiers||[]).find(x=>x.name===tierName);
  return t ? zyParseTierAmount(t.price) : 0;
}
// [MEMBRESÍAS · RENOVACIÓN] Un nivel de PAGA (Icon, Icon Black, etc.) dura
// un mes desde que se activó (joinedAt); al cumplirse, se debe volver a
// "Member" automáticamente — nunca se queda "vencido" cobrando de más ni
// hay que pedirle al cliente que baje él mismo de nivel. ~30 días porque el
// sitio no maneja meses de calendario con distinta duración.
const ZY_CLUB_CYCLE_MS = 30*24*60*60*1000;
// [MEMBRESÍAS · RENOVACIÓN] Punto único que TODO el sitio usa para leer la
// membresía del cliente: si el nivel es de paga y ya pasó su mes, aquí mismo
// se regresa a "Member" (se guarda y se refleja de inmediato) antes de
// devolver el registro — así ninguna pantalla (Club, Cuenta, ZAYDE ID,
// carrito) puede mostrar por accidente un nivel de paga ya vencido.
/* [MEMBRESÍAS · EN EL SERVIDOR] Una membresía de PAGA solo vale si la otorgó el servidor (memberships/{uid}, escrita por
   el webhook cuando Stripe confirma el pago). Lo que haya en el navegador solo se acepta para el nivel GRATUITO:
   así nadie puede darse Icon / Icon Black desde la consola. */
async function zyCheckClubExpiry(){
  if(!currentUser) return null;
  const key = 'zayde:club:'+userKey();
  let membership = null;
  if(db && currentUser.uid){
    try{ const d = await db.collection('memberships').doc(currentUser.uid).get(); if(d.exists) membership = d.data(); }
    catch(e){ console.warn('No se pudo leer la membresía del servidor:', e); }
  }
  if(!membership){
    const local = await Store.get(key);
    if(local && zyClubTierAmount(local.tier) <= 0) membership = local;   // solo nivel gratuito
  }
  if(!membership) return null;
  const amount = zyClubTierAmount(membership.tier);
  if(amount > 0 && membership.joinedAt && (Date.now() - membership.joinedAt >= ZY_CLUB_CYCLE_MS)){
    const rec = { tier:'Member', joinedAt: Date.now() };
    await Store.set(key, rec);
    currentMembership = rec;
    return rec;
  }
  currentMembership = membership;
  return membership;
}
// Espera (unos segundos) a que el webhook registre la membresía recién pagada. Devuelve el registro del servidor o null.
async function zyWaitForServerMembership(tierName){
  if(!db || !currentUser || !currentUser.uid) return null;
  for(let i = 0; i < 10; i++){
    try{
      const d = await db.collection('memberships').doc(currentUser.uid).get();
      if(d.exists && d.data().tier === tierName) return d.data();
    }catch(e){ console.warn('Esperando la membresía:', e); }
    await new Promise(r => setTimeout(r, 1500));
  }
  return null;
}
// [TARJETAS DE REGALO · SALDO EN EL SERVIDOR] giftBalances/{uid}: solo lo escribe el servidor.
async function zyReadGiftBalance(){
  if(!db || !currentUser || !currentUser.uid) return 0;
  try{ const d = await db.collection('giftBalances').doc(currentUser.uid).get(); return d.exists ? (Number(d.data().balance) || 0) : 0; }
  catch(e){ console.warn('No se pudo leer el saldo de tarjetas de regalo:', e); return 0; }
}
async function zyWaitForGiftBalance(before){
  for(let i = 0; i < 10; i++){
    const b = await zyReadGiftBalance();
    if(b > before){ zyGiftBalance = b; return b; }
    await new Promise(r => setTimeout(r, 1500));
  }
  return before;
}
async function zyRenderClubTiers(){
  const box = document.getElementById('clubTiersBox');
  if(!box) return;
  const tiers = ((zySettings.clubTiers && zySettings.clubTiers.length) ? zySettings.clubTiers : []).filter(t => ZY_PAID_MEMBERSHIPS_ENABLED || zyParseTierAmount(t.price) <= 0);
  // [FIX] Antes no se checaba aquí el nivel actual del cliente, así que
  // aunque ya fuera miembro de un nivel, el botón de ESE mismo nivel se
  // veía igual de "clickeable" que los demás (el bloqueo real ocurría
  // después, dentro de zyJoinClub). Ahora si ya tiene exactamente ese
  // nivel, el botón lo dice y queda deshabilitado — los demás niveles
  // (upgrade/downgrade) siguen disponibles para agregar al carrito.
  const membership = currentUser ? await zyCheckClubExpiry() : null;
  box.innerHTML = tiers.map(t=>{
    const btnClass = t.featured ? 'btn-primary' : 'btn-ghost';
    const amount = zyParseTierAmount(t.price);
