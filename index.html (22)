async function googleLogin(){
  if(!firebaseReady) zyTryInitFirebase();
  if(!firebaseReady || typeof firebase === 'undefined'){
    showToast('No se pudo conectar con el servicio de cuentas' + (zyFirebaseLastError ? (': ' + zyFirebaseLastError) : '.') + ' Revisa tu conexión o bloqueador de anuncios/privacidad, y recarga la página.', true);
    return;
  }
  const btn = document.getElementById('nkGoogleBtn');
  if(btn){ btn.disabled = true; }
  zyExplicitAuthInProgress = true;
  try{
    const provider = new firebase.auth.GoogleAuthProvider();
    provider.setCustomParameters({ prompt: 'select_account' }); // siempre deja elegir la cuenta
    const cred = await firebase.auth().signInWithPopup(provider);
    // [PEDIDO CLIENTE] Se quitó el recuadro de aviso "Estás volviendo a acceder a ZAYDE":
    // al elegir la cuenta en la ventana de Google se entra directo.
    // [REFERIDOS] Firebase marca isNewUser cuando la cuenta se acaba de crear
    if(cred.additionalUserInfo && cred.additionalUserInfo.isNewUser){
      await zyApplyPendingReferral(cred.user.uid);
    }
    const name = cred.user.displayName || (cred.user.email ? cred.user.email.split('@')[0] : 'Cliente');
    try{ localStorage.setItem('zayde:lastGoogle', JSON.stringify({ name, email: cred.user.email || '' })); }catch(e){}
    await setUser(name, 'Google', cred.user.uid, cred.user.email, cred.user.metadata && cred.user.metadata.creationTime ? new Date(cred.user.metadata.creationTime).toISOString() : null);
  }catch(err){
    console.error(err);
    let msg = 'No se pudo completar el acceso con Google. Intenta de nuevo.';
    if(err.code === 'auth/popup-closed-by-user') msg = 'Cerraste la ventana de Google antes de terminar.';
    else if(err.code === 'auth/popup-blocked') msg = 'Tu navegador bloqueó la ventana de Google. Permite ventanas emergentes e intenta de nuevo.';
    else if(err.code === 'auth/account-exists-with-different-credential') msg = 'Ese correo ya tiene una cuenta creada con otro método. Inicia sesión con correo.';
    showToast(msg, true);
  } finally {
    zyExplicitAuthInProgress = false;
    if(btn){ btn.disabled = false; }
  }
}

/* ============================================================
   [PERFIL] Editar nombre + Eliminar cuenta y datos (con doble confirmación)
   - Editar nombre: actualiza el displayName de Firebase Auth, la sesión
     local y todo lo que muestra el nombre (chip del encabezado, Mi cuenta).
   - Eliminar cuenta: 1) aviso con el botón rojo  2) segunda pregunta de
     confirmación (para correo pide la contraseña; para Google se vuelve a
     autenticar con la ventana de Google)  3) borra datos locales y de la
     nube que el cliente puede borrar, elimina el usuario de Firebase Auth
     y cierra la sesión. Los pedidos ya hechos se conservan en el servidor
     (registro de ventas/envíos) — no se tocan desde aquí.
   ============================================================ */
function zyProfileModal(id, inner){
  let m = document.getElementById(id);
  if(!m){
    m = document.createElement('div');
    m.className = 'zy-modal'; m.id = id; m.style.zIndex = 700;
    m.addEventListener('click', e=>{ if(e.target===m && !m.dataset.busy) zyCloseProfileModal(id); });
    document.body.appendChild(m);
  }
  delete m.dataset.busy;
  m.innerHTML = `<div class="zy-panel" style="width:380px;">${inner}</div>`;
  requestAnimationFrame(()=>m.classList.add('open'));
  return m;
}
function zyCloseProfileModal(id){
  const m = document.getElementById(id);
  if(m){ m.classList.remove('open'); setTimeout(()=>{ if(!m.classList.contains('open')) m.remove(); }, 250); }
}
function zyProfileInputStyle(){
  return 'width:100%; box-sizing:border-box; background:var(--surface-dim); border:1px solid var(--line); border-radius:var(--r-sm); padding:12px; font-size:14px; color:var(--text); font-family:inherit; margin-bottom:6px;';
}

