const CARRIERS = {
  estafeta: { label:"Estafeta",    color:"#2F5FFF", branches: ESTAFETA_BRANCHES },
  fedex:    { label:"FedEx",       color:"#4D148C", branches: FEDEX_BRANCHES },
  dhl:      { label:"DHL Express", color:"#FFCC00", branches: DHL_BRANCHES }
};
/* Sucursales reales encontradas cerca del usuario vía OpenStreetMap (ver
   fetchNearbySucursales más abajo). Se llenan solo al presionar "Ubicarme"
   y se combinan con la lista curada de arriba, así "Ubicarme" muestra
   TODAS las sucursales que existen alrededor del usuario, no solo las
   precargadas por ciudad. */
let liveBranches = { estafeta:[], fedex:[], dhl:[] };
/* [SUCURSALES] Las entradas "genéricas" (centro de cada ciudad con un nombre como
   "Zona Centro", "Punto FedEx, <ciudad>" o "Centro de Servicio DHL Express, <ciudad>")
   eran coordenadas representativas, NO sucursales reales — llevaban al cliente a un
   punto que no existe. Ya no se ofrecen para elegir. Las sucursales ahora salen de:
   (1) la lista registrada de la zona metropolitana de Guadalajara, (2) las que
   existen de verdad alrededor de la ubicación o ciudad/CP buscados (OpenStreetMap)
   y (3) la sucursal que el cliente escriba a mano. */
function zyIsPlaceholderBranch(b){ return /^(Sucursal Estafeta, Zona Centro|Punto FedEx,|Centro de Servicio DHL Express,)/.test((b && b.addr) || ''); }
const BRANCH_MAX_KM = 60;
let branchRef = null;        // punto de referencia: «Ubicarme» o ciudad/CP buscado
let zyManualBranch = null;   // sucursal escrita a mano por el cliente
function currentBranches(){
  const base = CARRIERS[selectedCarrier].branches.filter(b=>!zyIsPlaceholderBranch(b));
  const live = liveBranches[selectedCarrier] || [];
  const manual = (zyManualBranch && zyManualBranch.carrier === selectedCarrier) ? [zyManualBranch] : [];
  // si una sucursal real de OpenStreetMap cae a menos de 100 m de una registrada, se queda la registrada
  const liveOnly = live.filter(l=>!base.some(b=>haversineKm(b,l) < 0.1));
  const pool = base.concat(liveOnly);
  const ref = branchRef;
  if(!ref) return pool.concat(manual);
  return pool.map(b=>({ b, d:haversineKm(ref,b) })).filter(x=>x.d <= BRANCH_MAX_KM).sort((a,b)=>a.d-b.d).slice(0,40).map(x=>x.b).concat(manual);
}

