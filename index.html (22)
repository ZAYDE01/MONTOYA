/* Comparte el comprobante de pago. Prioriza el share nativo del navegador
   (permite elegir WhatsApp, correo, etc. y en móvil puede incluir la captura
   de pantalla que el cliente adjunte); si el navegador no soporta share nativo,
   cae directo a WhatsApp hacia el número del negocio con los datos del pedido,
   ya que es el canal que preferimos para confirmar pagos. */
async function zyShareReceipt(orderNum){
  let order = null;
  try{
    const all = (await Store.get('zayde:orders')) || [];
    order = all.find(o=>o.orderNum===orderNum);
  }catch(e){}
  const text = order
    ? `Comprobante de pago — Pedido ${order.orderNum}\nMonto pagado: ${fmt(order.total)}\nFecha: ${new Date(order.date).toLocaleString('es-MX')}${order.cardLast4 ? `\nPago: ${(order.cardBrand||'Tarjeta').toUpperCase()} •••• ${order.cardLast4}` : ''}\nReferencia: ${order.stripePaymentIntentId || '—'}`
    : `Comprobante de pago — Pedido ${orderNum}`;
  if(navigator.share){
    try{
      await navigator.share({ title: 'Comprobante de pago', text });
      return;
    }catch(e){
      if(e && e.name === 'AbortError') return;
    }
  }
  window.open(`https://wa.me/${ZY_WHATSAPP_NUMBER}?text=${encodeURIComponent(text)}`, '_blank');
}
function zyCopyVerificationCode(code, silent){
  if(!code) return;
  if(navigator.clipboard && navigator.clipboard.writeText){
    navigator.clipboard.writeText(code)
      .then(()=>{ if(!silent) showToast('Código de verificación copiado'); })
      .catch(()=>{ if(!silent) showToast('No se pudo copiar — usa el botón junto al código', true); });
  }
}

/* Filtra la caché local de pedidos a solo los que pertenecen a quien está
   viendo la página ahora mismo (cuenta actual, o este invitado si no hay
   sesión) — ver comentario en confirmOrder() sobre order.ownerKey.
   Los pedidos guardados ANTES de este fix no tienen ownerKey todavía, o
   tienen la llave genérica antigua 'guest' (compartida por cualquier
   invitado) — a un invitado de este navegador se le siguen mostrando esos
   también, para no "perder" pedidos viejos de antes del fix. */
function zyMyOrders(all){
  const key = userKey();
  return (all||[]).filter(o => {
    const ownerKey = o.ownerKey || 'guest';
    const belongsToMe = (ownerKey === key) || (!currentUser && ownerKey === 'guest'); // compatibilidad con pedidos de invitado guardados antes de este fix
    if(!belongsToMe) return false;
    const orderStore = o.store || 'zayde'; // pedidos de antes de este cambio se tratan como de ZAYDE
    return orderStore === currentStore || orderStore === 'mixed';
  });
}

/* ============================================================
   [FIX — SEGUIMIENTO EN VIVO] Antes, "Tu pedido más reciente" solo leía la
   copia guardada en el navegador del cliente (Store 'zayde:orders'), que
   NADIE actualizaba cuando tú cambiabas la etapa desde el panel: el cambio
   se guardaba en Firestore, pero el celular del cliente seguía mostrando
   la etapa vieja hasta que tecleaba su código (zyTrackOrder sí consulta
   Firestore).
   Ahora cada pedido del cliente se "escucha" en Firestore con onSnapshot
   (mismo permiso de lectura por documento que ya usa el rastreo por
   código): en cuanto cambias la etapa, la tarjeta se actualiza sola, sin
   recargar. Si el navegador bloquea la conexión en tiempo real, se cae a
   consultar cada 30 s, y también al volver a la pestaña/app.
   ============================================================ */
let zyOrdersLock = Promise.resolve();
// Serializa las lecturas-escrituras de 'zayde:orders' para que dos procesos
// (guardar pedido / recibir cambio de etapa) no se pisen entre sí.
function zyWithOrdersLock(fn){
  const run = zyOrdersLock.then(fn);
  zyOrdersLock = run.catch(()=>{});
  return run;
}

/* ============================================================
   [CANCELAR PEDIDO · estilo Amazon]
   Solo mientras el pedido está en "recibido" o "verificando". El servidor (/api/send-email, type "order-cancel")
   vuelve a revisar el estado: desde "preparando" lo rechaza aunque alguien intente saltarse el botón.
   ============================================================ */
const ZY_CANCEL_REASONS = [
  'Me equivoqué de talla o producto',
  'Encontré un mejor precio',
  'Cambié de opinión',
  'Tardó más de lo esperado',
  'Quiero cambiar la dirección o el método de pago',
  'Otro motivo'
];
function zyOpenCancelOrder(orderNum){
  let m = document.getElementById('zyCancelOrderModal');
  if(m) m.remove();
  m = document.createElement('div');
  m.id = 'zyCancelOrderModal'; m.className = 'zy-modal'; m.style.zIndex = 900;
  document.body.appendChild(m);
  m.addEventListener('click', e=>{ if(e.target===m && !m.dataset.busy) zyCloseCancelOrder(); });
  m.innerHTML = `<div class="zy-panel" style="width:400px;">
    <button type="button" class="zy-close" onclick="zyCloseCancelOrder()" aria-label="Cerrar">×</button>
    <h3 style="margin:0 0 6px;font-size:17px;">Cancelar pedido</h3>
    <p style="margin:0 0 14px;font-size:13px;color:var(--steel);line-height:1.5;">Pedido <b>${zyEscapeHtml(orderNum)}</b>. Cuéntanos por qué lo cancelas (opcional). Si ya pagaste, te reembolsamos al método de pago original en 5 a 10 días hábiles.</p>
    <select id="zyCancelReason" style="${zyProfileInputStyle()}">
      ${ZY_CANCEL_REASONS.map(r=>`<option>${zyEscapeHtml(r)}</option>`).join('')}
    </select>
    <p id="zyCancelErr" style="margin:6px 0 12px;font-size:12px;color:#D45A5A;min-height:16px;"></p>
    <div style="display:flex;gap:8px;">
      <button type="button" class="btn btn-ghost" style="flex:1;" onclick="zyCloseCancelOrder()">Conservar pedido</button>
      <button type="button" class="btn btn-primary" id="zyCancelGo" style="flex:1;background:#B23A3A;border-color:#B23A3A;color:#fff;" onclick="zyConfirmCancelOrder('${zyEscapeHtml(orderNum)}')">Sí, cancelar</button>
    </div>
  </div>`;
  requestAnimationFrame(()=>m.classList.add('open'));
}
function zyCloseCancelOrder(){
  const m = document.getElementById('zyCancelOrderModal');
  if(m){ m.classList.remove('open'); setTimeout(()=>{ if(!m.classList.contains('open')) m.remove(); }, 250); }
}
async function zyConfirmCancelOrder(orderNum){
  const m = document.getElementById('zyCancelOrderModal'); if(!m) return;
  const btn = document.getElementById('zyCancelGo'), err = document.getElementById('zyCancelErr');
  const reason = (document.getElementById('zyCancelReason')||{}).value || '';
  m.dataset.busy = '1'; if(btn){ btn.disabled = true; btn.textContent = 'Cancelando…'; } if(err) err.textContent = '';
  try{
    const all = (await Store.get('zayde:orders')) || [];
    const local = all.find(o=>o.orderNum===orderNum);
    const headers = { 'Content-Type':'application/json' };
    try{
      const fu = (typeof firebase !== 'undefined' && firebaseReady) ? firebase.auth().currentUser : null;
      if(fu && !zyIsAdminAuthUser(fu)) headers['Authorization'] = 'Bearer ' + await fu.getIdToken();
    }catch(e){}
    const r = await fetch('/api/send-email', { method:'POST', headers, body: JSON.stringify({ type:'order-cancel', orderNum, reason, email: (local && local.email) || (currentUser && currentUser.email) || '' }) });
    const data = await r.json().catch(()=>({}));
    if(!r.ok || !data.ok){ throw new Error(data.error || 'No se pudo cancelar el pedido.'); }
    // Refleja de inmediato la cancelación en este navegador y repinta
    try{
      let remote = null;
      if(db){ const snap = await db.collection('orders').doc(orderNum).get(); if(snap.exists) remote = snap.data(); }
      if(remote) await zyApplyRemoteOrder(remote);
      else await zyWithOrdersLock(async ()=>{
        const arr = (await Store.get('zayde:orders')) || [];
        const o = arr.find(x=>x.orderNum===orderNum);
        if(o){ o.status='cancelado'; o.cancelledAt=Date.now(); o.refund = data.refundPending ? {status:'pendiente'} : {status:'no_aplica'}; await Store.set('zayde:orders', arr); }
      });
    }catch(e){}
    delete m.dataset.busy; zyCloseCancelOrder();
    const hist = document.querySelector('.zy-hist-body'); if(hist && hist.closest('.zy-modal')) hist.closest('.zy-modal').classList.remove('open');
    try{ zyLoadRecentOrder(); }catch(e){}
    try{ zyUpdateOrderBadge(); }catch(e){}
    zyInfoToast('Pedido cancelado' + (data.refundPending ? '. Tu reembolso va en camino.' : '.'));
  }catch(e){
    delete m.dataset.busy;
    if(btn){ btn.disabled = false; btn.textContent = 'Sí, cancelar'; }
    if(err) err.textContent = e.message || 'No se pudo cancelar el pedido.';
  }
}

function zyStatusHistorySig(h){ return (Array.isArray(h) ? h : []).map(x=>(x.status||'')+'@'+(x.at||'')).join('|'); }
// Copia a la versión local los campos que cambian desde el panel/servidor.
// Devuelve true si algo cambió.
function zyMergeRemoteOrder(local, remote){
  let changed = false;
  if(remote.status && remote.status !== local.status){ local.status = remote.status; changed = true; }
  if(Array.isArray(remote.statusHistory) && remote.statusHistory.length &&
     zyStatusHistorySig(remote.statusHistory) !== zyStatusHistorySig(local.statusHistory)){
    local.statusHistory = remote.statusHistory; changed = true;
  }
  const rv = remote.verification, lv = local.verification || {};
  if(rv && (rv.status !== lv.status || rv.verifiedAt !== lv.verifiedAt || (rv.code && rv.code !== lv.code))){
    local.verification = rv; changed = true;
  }
  // [CANCELACIÓN] Datos de una cancelación hecha desde el servidor
  ['cancelledAt','cancelReason','cancelledBy','refund'].forEach(k=>{
    if(remote[k] !== undefined && JSON.stringify(remote[k]) !== JSON.stringify(local[k])){ local[k] = remote[k]; changed = true; }
  });
  // Pago: nunca se "baja" a pendiente una vez que ya está pagado/fallido.
  if(remote.paymentStatus && remote.paymentStatus !== 'pendiente' && remote.paymentStatus !== local.paymentStatus){
    local.paymentStatus = remote.paymentStatus;
    ['stripePaymentIntentId','cardBrand','cardLast4','paymentFailReason'].forEach(k=>{ if(remote[k] !== undefined) local[k] = remote[k]; });
    changed = true;
  }
  return changed;
}
// Notificación discreta (showToast solo muestra errores, así que se usa su
// mismo elemento pero para un aviso informativo).
function zyInfoToast(msg){
  try{
    const t = document.getElementById('toast');
    if(!t) return;
    const icon = document.getElementById('toastIcon');
    document.getElementById('toastMsg').textContent = msg;
    t.classList.remove('toast-error');
    if(icon) icon.innerHTML = '<path d="M20 6L9 17l-5-5"/>';
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(()=>t.classList.remove('show'), 4200);
  }catch(e){}
}
// Recibe la versión de Firestore de un pedido y la refleja en el navegador
// del cliente + repinta la pantalla si está viendo su pedido.
function zyApplyRemoteOrder(remote){
  // Un documento incompleto (sin productos) no es un pedido real: se ignora
  // para no pisar la copia buena del cliente.
  if(!remote || !remote.orderNum || !Array.isArray(remote.items)) return Promise.resolve(false);
  return zyWithOrdersLock(async ()=>{
    const all = (await Store.get('zayde:orders')) || [];
    const local = all.find(o=>o.orderNum === remote.orderNum);
    if(!local) return null;
    const prevStatus = local.status || 'recibido';
    if(!zyMergeRemoteOrder(local, remote)) return null;
    await Store.set('zayde:orders', all);
    return { orderNum: local.orderNum, prevStatus, newStatus: local.status || 'recibido' };
  }).then(res=>{
    if(!res) return false;
    if(currentPage === 'tracking') zyLoadRecentOrder();
    if(res.newStatus !== res.prevStatus){
      const st = ORDER_STAGES.find(s=>s.key === res.newStatus);
      if(st) zyInfoToast(`Tu pedido ${res.orderNum}: ${st.label}`);
    }
    return true;
  }).catch(e=>{ console.warn('No se pudo aplicar la actualización del pedido:', e); return false; });
}

const zyOrderUnsubs = {};   // orderNum -> función para dejar de escuchar
let zyOrderPollTimer = null;
let zyLiveSyncWaiting = false;
async function zyGetMyTrackableOrders(){
  const all = (await Store.get('zayde:orders')) || [];
  return zyMyOrders(all)
    .filter(o=>!zyIsDigitalOnlyOrder(o))
    .sort((a,b)=>(b.date||0)-(a.date||0))
    .slice(0,10); // los 10 más recientes bastan
}
async function zyPullMyOrdersOnce(){
  if(!db) return;
  try{
    const mine = await zyGetMyTrackableOrders();
    for(const o of mine){
      try{
        const snap = await db.collection('orders').doc(o.orderNum).get();
        if(snap.exists) await zyApplyRemoteOrder(snap.data());
      }catch(e){}
    }
  }catch(e){}
}
function zyEnsureOrderPolling(){
  if(zyOrderPollTimer) return;
  zyOrderPollTimer = setInterval(()=>{ if(!document.hidden) zyPullMyOrdersOnce(); }, 30000);
}
async function zyStartLiveOrderSync(){
  try{
    if(!db){
      if(zyLiveSyncWaiting) return; // ya hay una espera de Firebase en curso
      zyLiveSyncWaiting = true;
      const ok = await zyWaitForFirebase(8000);
      zyLiveSyncWaiting = false;
      if(!ok || !db) return;
    }
    const mine = await zyGetMyTrackableOrders();
    const wanted = new Set(mine.map(o=>o.orderNum));
    // deja de escuchar pedidos que ya no son de esta sesión (cambio de cuenta, etc.)
    Object.keys(zyOrderUnsubs).forEach(n=>{
      if(!wanted.has(n)){ try{ zyOrderUnsubs[n](); }catch(e){} delete zyOrderUnsubs[n]; }
    });
    mine.forEach(o=>{
      if(zyOrderUnsubs[o.orderNum]) return;
      zyOrderUnsubs[o.orderNum] = db.collection('orders').doc(o.orderNum).onSnapshot(
        snap=>{ if(snap.exists) zyApplyRemoteOrder(snap.data()); },
        err=>{
          console.warn('No se pudo escuchar el pedido en vivo, se usará consulta periódica:', o.orderNum, err && err.code);
          delete zyOrderUnsubs[o.orderNum];
          zyEnsureOrderPolling();
        }
      );
    });
  }catch(e){ console.warn('No se pudo iniciar el seguimiento en vivo:', e); }
}
// Al volver a la pestaña/app (en celular las conexiones en tiempo real se
// suspenden en segundo plano) se refresca de inmediato.
document.addEventListener('visibilitychange', ()=>{
  if(!document.hidden){ zyStartLiveOrderSync(); zyPullMyOrdersOnce(); }
});

// Rastreo por código: el resultado que se ve en pantalla también se
// actualiza en vivo mientras esté abierto.
let zyTrackUnsub = null;
function zyStopTrackWatch(){
  if(zyTrackUnsub){ try{ zyTrackUnsub(); }catch(e){} zyTrackUnsub = null; }
  const box = document.getElementById('trackResult');
  if(box) box.dataset.watching = '';
}
function zyWatchTrackedOrder(orderNum){
  zyStopTrackWatch();
  const box = document.getElementById('trackResult');
  if(!db || !box || !orderNum) return;
  box.dataset.watching = orderNum;
  zyTrackUnsub = db.collection('orders').doc(orderNum).onSnapshot(snap=>{
    if(!snap.exists) return;
    const o = snap.data();
    if(!o || !o.orderNum || !Array.isArray(o.items)) return;
    const b = document.getElementById('trackResult');
    if(b && currentPage === 'tracking' && b.dataset.watching === orderNum){
      b.innerHTML = zyRenderOrderCard(o, {withActions:false});
    }
    zyApplyRemoteOrder(o); // y de paso se actualiza su copia local si es un pedido suyo
  }, ()=>{});
}

