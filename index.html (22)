// "Cambiar talla" / "Cambiar línea" después de una búsqueda sin resultados.
function zyBotFlowRedo(step){
  const l = zybotLast || {};
  if(step==='size'){
    zyBotAppendMsg('user', 'Cambiar talla');
    zybotFlow = {type:'size', cat:l.cat, aud:l.aud, gender:l.gender, size:null};
  } else {
    zyBotAppendMsg('user', 'Cambiar línea');
    zybotFlow = {type:'aud', cat:l.cat, aud:null, gender:null, size:null};
  }
  zyBotFlowNext();
}
// Texto escrito mientras el flujo espera una respuesta: si trae el dato
// que falta (línea, género o talla) se usa; si no, pasa a la IA como siempre.
function zyBotFlowHandleText(val){
  const f = zybotFlow;
  if(!f || ['cat','aud','gender','size'].indexOf(f.type) < 0) return false;
  const p = zyBotParseShop(val, f.cat);
  let changed = false;
  if(!f.cat && p.cat){ f.cat = p.cat; changed = true; }
  if(f.cat && !f.aud && p.aud){ f.aud = p.aud; if(p.gender) f.gender = p.gender; changed = true; }
  if(f.aud && !f.gender && p.gender){ f.gender = p.gender; changed = true; }
  if(f.cat && f.size==null && p.size!=null){ f.size = p.size; changed = true; }
  if(changed) zyBotFlowNext();
  return changed;
}
function zyBotMiniCardHTML(p, size, note){
