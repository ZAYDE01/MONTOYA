    const isCurrent = membership && membership.tier === t.name;
    // [FIX] El botón de un nivel inferior ya no dice "Nivel inferior — se
    // ajusta solo al mes" ni queda deshabilitado: se ve exactamente igual
    // que cualquier otro ("Unirme a X"), para que los botones se vean
    // limpios y parejos. La bajada manual se sigue bloqueando igual —
    // zyJoinClub() avisa con un mensaje si de verdad se intenta bajar de
    // nivel — solo que ya no se anuncia de antemano en el botón mismo.
    let label;
    if(isCurrent) label = 'Tu nivel actual ✓';
    else if(inCart) label = 'Ya está en tu carrito';
    else label = amount>0 ? `Unirme a ${zyEscapeHtml(t.name)}` : 'Unirme gratis';
    return `
    <div class="club-tier ${t.featured?'is-featured':''}">
      ${t.featured ? `<span class="tier-badge">Más popular</span>` : ''}
      <h4>${zyEscapeHtml(t.name)}</h4>
      <div class="price">${zyEscapeHtml(t.price)}</div>
      <ul>${(t.benefits||[]).map(b=>`<li>${zyEscapeHtml(b)}</li>`).join('')}</ul>
      <button class="btn ${btnClass}" style="width:100%;" ${(inCart||isCurrent)?'disabled':''} onclick="zyJoinClub('${t.name.replace(/'/g,"\\'")}')">${label}</button>
    </div>`;
