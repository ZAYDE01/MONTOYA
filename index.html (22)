/* ---------- Geolocalización del cliente (rápida y precisa) ----------
   Problema anterior: se esperaba hasta 25 s a una lectura de GPS muy fina (en laptop
   nunca llega) y el botón parecía congelado. AHORA: (1) una lectura por red/caché que
   suele llegar en 1–2 s se usa YA para mostrar el pin y la dirección; (2) en paralelo
   el GPS afina en segundo plano (máx. 12 s) y, si logra una lectura bastante mejor,
   mueve el pin solo — a menos que el cliente ya lo haya arrastrado él mismo. Para
   «recoger en sucursal» basta la lectura rápida (las sucursales se buscan a decenas
   de km, no a metros). */
let zyGeoWatchId = null, zyPinTouched = false;
function zyGetPreciseLocation(onFirst, onRefine, onFail, opts){
  opts = opts || {};
  const TARGET_M = 15, REFINE_MS = 12000, GIVEUP_MS = 15000;
  let first = false, best = null, ended = false, refineTimer = null, giveUp = null;
  const stop = ()=>{ ended = true; if(zyGeoWatchId !== null){ navigator.geolocation.clearWatch(zyGeoWatchId); zyGeoWatchId = null; } clearTimeout(refineTimer); clearTimeout(giveUp); };
  const fail = err=>{ if(!first && !ended){ stop(); onFail(err); } };
  const gotFix = pos=>{
    if(ended) return;
    if(!first){
      first = true; best = pos; clearTimeout(giveUp);
      onFirst(pos);
      if(opts.fast || pos.coords.accuracy <= TARGET_M){ stop(); return; }
      refineTimer = setTimeout(stop, REFINE_MS);
      return;
    }
    if(pos.coords.accuracy < best.coords.accuracy * 0.7){
      best = pos;
      if(onRefine) onRefine(pos);
      if(pos.coords.accuracy <= TARGET_M) stop();
    }
  };
  stop(); ended = false;
  navigator.geolocation.getCurrentPosition(gotFix, err=>{ if(err && err.code === 1) fail(err); }, { enableHighAccuracy:false, timeout:7000, maximumAge:30000 });
  if(!opts.fast) zyGeoWatchId = navigator.geolocation.watchPosition(gotFix, err=>{ if(err && err.code === 1) fail(err); }, { enableHighAccuracy:true, timeout:20000, maximumAge:0 });
  giveUp = setTimeout(()=>fail({ code:3 }), GIVEUP_MS);
}
function showBranchStatus(msg, loading){
  const el = document.getElementById('branchStatus');
  if(!el) return;
  el.textContent = msg || '';
  el.classList.toggle('loading', !!loading);
}
function zyGeoBtnLoading(btn, on){
  if(!btn) return;
  if(on){ if(!btn.dataset.orig) btn.dataset.orig = btn.innerHTML; btn.innerHTML = '<span class="zy-spin"></span> Ubicando…'; btn.classList.add('is-loading'); }
  else { if(btn.dataset.orig){ btn.innerHTML = btn.dataset.orig; delete btn.dataset.orig; } btn.classList.remove('is-loading'); }
}
function useMyLocation(forMap){
  if(!navigator.geolocation){ showToast('Tu navegador no permite obtener tu ubicación', true); return; }
  const btn = document.getElementById(forMap ? 'geoBtnMap' : 'geoBtn');
  const readout = document.getElementById('geoReadout');
  zyGeoBtnLoading(btn, true);
  zyPinTouched = false;
  if(forMap) showBranchStatus('Detectando tu ubicación…', true);
  else if(readout) readout.innerHTML = '<span><span class="zy-spin"></span> Detectando tu ubicación…</span>';
  const onFirst = (pos)=>{
    userCoords = { lat:pos.coords.latitude, lng:pos.coords.longitude };
    zyGeoBtnLoading(btn, false);
    if(forMap){
      branchRef = { lat:userCoords.lat, lng:userCoords.lng, label:'tu ubicación' };
      selectedBranch = null;
      const bs = document.getElementById('branchSummary'); if(bs) bs.classList.remove('show');
      placeUserMarkerOnMap();
      renderBranchList();
      renderBranchMarkers();
      fetchNearbySucursales(branchRef);
    } else {
      zyShowDeliveryMap(userCoords, pos.coords.accuracy);
      reverseGeocodeIntoForm(userCoords, pos.coords.accuracy);
    }
  };
  const onRefine = (pos)=>{
    if(forMap || zyPinTouched) return;   // si el cliente ya movió el pin, se respeta su ajuste
    userCoords = { lat:pos.coords.latitude, lng:pos.coords.longitude };
    zyShowDeliveryMap(userCoords, pos.coords.accuracy);
    reverseGeocodeIntoForm(userCoords, pos.coords.accuracy);
  };
  const onFail = (err)=>{
    zyGeoBtnLoading(btn, false);
    if(err && err.code === 1){
      showToast('El permiso de ubicación está bloqueado. Revisa los permisos de este sitio en tu navegador (ícono de candado junto a la URL) y vuelve a intentar.', true);
    } else {
      showToast(forMap ? 'No pudimos obtener tu ubicación. Busca por ciudad o código postal.' : 'No pudimos obtener tu ubicación. Escribe tu dirección y usa «Ubicar la dirección que escribí en el mapa».', true);
    }
    if(forMap) showBranchStatus('No pudimos obtener tu ubicación. Busca por ciudad o código postal.');
    else if(readout) readout.innerHTML = '<span class="geo-empty">Sin coordenadas capturadas — escribe tu dirección y usa «Ubicar la dirección que escribí en el mapa»</span>';
  };
  zyGetPreciseLocation(onFirst, onRefine, onFail, { fast: !!forMap });
}

/* ---------- Sucursales reales alrededor del punto elegido ----------
   Datos abiertos de OpenStreetMap vía Overpass. Antes: un solo servidor, tres radios
   uno tras otro (hasta 25 s cada uno) y un aviso de error cuando se saturaba — por eso
   decía que «no se pudo cargar». AHORA: se consultan 3 servidores espejo a la vez y
   gana el primero que responde (máx. 12 s), primero a 25 km y solo si salen pocas
   se amplía a 60 km; el resultado se guarda 6 h en el navegador para que la siguiente
   búsqueda en la misma zona sea instantánea; y si todo falla, no se muestra un error:
   quedan las sucursales registradas y la opción de escribir la tuya. */
const NEARBY_RADII_KM = [25, 60];
const OVERPASS_URLS = ['https://overpass-api.de/api/interpreter', 'https://overpass.kumi.systems/api/interpreter', 'https://overpass.private.coffee/api/interpreter'];
let liveBranchesLoading = false, liveSearchSeq = 0;
function zyOverpass(query){
  return new Promise((resolve, reject)=>{
    let pending = OVERPASS_URLS.length, done = false;
    const ctrls = [];
    OVERPASS_URLS.forEach(u=>{
      const c = new AbortController(); ctrls.push(c);
      const to = setTimeout(()=>c.abort(), 12000);
      fetch(u, { method:'POST', body:'data=' + encodeURIComponent(query), signal:c.signal })
        .then(r=>{ if(!r.ok) throw new Error('http ' + r.status); return r.json(); })
        .then(d=>{ clearTimeout(to); if(done) return; done = true; ctrls.forEach(x=>{ if(x !== c) x.abort(); }); resolve(d); })
        .catch(()=>{ clearTimeout(to); if(--pending === 0 && !done) reject(new Error('overpass')); });
    });
  });
}
function zyParseBranches(data){
  const found = { estafeta:[], fedex:[], dhl:[] };
  const seen = new Set();
  (data.elements || []).forEach(el=>{
    const tags = el.tags || {};
    const label = ((tags.name||'') + ' ' + (tags.brand||'') + ' ' + (tags.operator||'')).toLowerCase();
    // Fuera bodegas, hubs y centros logísticos: no son sucursales donde se recoge un paquete.
    if(/supply chain|\bhub\b|centro de distribuci|cedis|bodega|warehouse|freight|logistic|log[ií]stica|cargo/i.test(label)) return;
    let carrier = null;
    if(label.includes('estafeta')) carrier = 'estafeta';
    else if(label.includes('fedex')) carrier = 'fedex';
    else if(label.includes('dhl')) carrier = 'dhl';
    if(!carrier) return;
    const lat = el.lat || (el.center && el.center.lat);
    const lng = el.lon || (el.center && el.center.lon);
    if(lat == null || lng == null) return;
    const key = carrier + ':' + lat.toFixed(4) + ',' + lng.toFixed(4);
    if(seen.has(key)) return;
    seen.add(key);
    const streetAddr = [tags['addr:street'], tags['addr:housenumber']].filter(Boolean).join(' ');
    const cityAddr = [tags['addr:suburb'], tags['addr:city']].filter(Boolean).join(', ');
    found[carrier].push({
      id: 900000 + found[carrier].length + (carrier==='estafeta' ? 0 : carrier==='fedex' ? 1000 : 2000),
      name: tags.name || (CARRIERS[carrier].label + ' · sucursal cercana'),
      addr: [streetAddr, cityAddr].filter(Boolean).join(', ') || 'Ubicación en el mapa (sin dirección registrada)',
      lat, lng
    });
  });
  return found;
}
function zyBranchCacheKey(c){ return 'zy:branches:' + c.lat.toFixed(2) + ',' + c.lng.toFixed(2); }
function zyApplyLiveBranches(found){
  liveBranches = found;
  renderBranchList();
  if(mapsReady) renderBranchMarkers();
  const shown = currentBranches().length;
  showBranchStatus(shown
    ? `Mostrando ${shown} sucursal${shown===1?'':'es'} de ${CARRIERS[selectedCarrier].label} cerca de ${branchRef ? branchRef.label : 'ti'}.`
    : `No encontramos sucursales de ${CARRIERS[selectedCarrier].label} cerca. Prueba con otra ciudad o código postal, o escribe tu sucursal abajo.`);
}
function fetchNearbySucursales(coords){
  const seq = ++liveSearchSeq;
  liveBranchesLoading = true;
  try{
    const c = JSON.parse(localStorage.getItem(zyBranchCacheKey(coords)) || 'null');
    if(c && Date.now() - c.at < 6*3600*1000){ liveBranchesLoading = false; zyApplyLiveBranches(c.found); return; }
  }catch(e){}
  showBranchStatus('Buscando sucursales cerca de ' + (branchRef ? branchRef.label : 'ti') + '…', true);
  const run = (i)=>{
    const R = NEARBY_RADII_KM[i] * 1000;
    const q = `[out:json][timeout:12];nwr(around:${R},${coords.lat},${coords.lng})[~"^(name|brand|operator)$"~"Estafeta|FedEx|DHL",i];out center tags 80;`;
    zyOverpass(q).then(data=>{
      if(seq !== liveSearchSeq) return;
      const found = zyParseBranches(data);
      const total = found.estafeta.length + found.fedex.length + found.dhl.length;
      if(total < 3 && i < NEARBY_RADII_KM.length - 1){ run(i + 1); return; }
      liveBranchesLoading = false;
      try{ localStorage.setItem(zyBranchCacheKey(coords), JSON.stringify({ at:Date.now(), found })); }catch(e){}
      zyApplyLiveBranches(found);
    }).catch(()=>{
      if(seq !== liveSearchSeq) return;
      liveBranchesLoading = false;
      const shown = currentBranches().length;
      showBranchStatus(shown
        ? `Mostrando ${shown} sucursal${shown===1?'':'es'} registrada${shown===1?'':'s'} de ${CARRIERS[selectedCarrier].label} cerca de ${branchRef ? branchRef.label : 'ti'}.`
        : 'No pudimos consultar más sucursales ahora. Intenta de nuevo en un momento o escribe tu sucursal abajo.');
    });
  };
  run(0);
}
/* ---------- Dirección a partir de la ubicación (geocodificación inversa) ----------
   Nominatim (OpenStreetMap), gratis y sin clave. Ahora pide el nivel de detalle
   más fino (zoom 19) y NO pisa lo que el cliente ya escribió si el pin sigue en
   la misma calle (así no se pierde el número exterior). */
function zyNormTxt(s){ return String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9 ]/g,' ').replace(/\s+/g,' ').trim(); }
function reverseGeocodeIntoForm(coords, accuracy){
  const readout = document.getElementById('geoReadout');
  const accHtml = (accuracy != null) ? `<span><b>Precisión</b> ±${Math.round(accuracy)} m</span>` : '';
  const base = `<span><b>Lat</b> ${coords.lat.toFixed(5)}</span><span><b>Lng</b> ${coords.lng.toFixed(5)}</span>${accHtml}`;
  readout.innerHTML = base + '<span>Buscando dirección…</span>';
  const url = `https://nominatim.openstreetmap.org/reverse?format=jsonv2&zoom=19&lat=${coords.lat}&lon=${coords.lng}&addressdetails=1`;
  fetch(url, { headers:{ 'Accept-Language':'es' } })
    .then(r=>r.json())
    .then(data=>{
      const a = data.address || {};
      // [SOLO MÉXICO] Si el geocodificador dice que el pin está en otro país, no se acepta.
      window.zyForeignPin = !!(a.country_code && String(a.country_code).toLowerCase() !== 'mx');
      if(window.zyForeignPin){
        readout.innerHTML = base + '<span class="geo-empty">Esa ubicación está fuera de México. Solo enviamos dentro de México.</span>';
        showToast('Solo enviamos dentro de México', true);
        return;
      }
      const colonia = a.suburb || a.neighbourhood || a.quarter || a.city_district || '';
      const addrEl = document.getElementById('ckAddress');
      const prev = addrEl.value.trim();
      const sameStreet = prev && a.road && zyNormTxt(prev).includes(zyNormTxt(a.road));
      if(!sameStreet){
        const street = [a.road, a.house_number].filter(Boolean).join(' ');
        addrEl.value = [street, colonia].filter(Boolean).join(', ') || (data.display_name || '').split(',').slice(0,2).join(',');
      }
      const city = a.city || a.town || a.village || a.municipality || '';
      if(city) document.getElementById('ckCity').value = city;
      if(a.postcode) document.getElementById('ckZip').value = a.postcode;
      const state = a.state || '';
      if(state){
        const stSel = document.getElementById('ckState');
        [...stSel.options].forEach(o=>{ if(o.value && (o.value===state || state.includes(o.value))) stSel.value = o.value; });
      }
      const hint = (accuracy != null && accuracy > 60)
        ? 'Precisión baja (probablemente por WiFi): arrastra el pin hasta tu puerta'
        : (a.house_number || sameStreet ? 'Dirección cargada. Si hace falta, mueve el pin' : 'Dirección cargada. Agrega tu número exterior y ajusta el pin si hace falta');
      readout.innerHTML = base + `<span>${hint}</span>`;
      renderShipOptions();
    })
    .catch(()=>{
      readout.innerHTML = base + '<span class="geo-empty">No se encontró una dirección automática: complétala manualmente y mueve el pin a tu puerta</span>';
    });
}

/* ---------- Pines y mapas ---------- */
function zyPinIcon(color, active){
  const s = active ? 46 : 36;
  return L.divIcon({
    className: 'zy-pin-wrap',
    html: `<div class="zy-pin${active ? ' active' : ''}"><svg viewBox="0 0 24 24" width="${s}" height="${s}"><path d="M12 2C7.6 2 4 5.5 4 9.8c0 5.6 6.6 11.4 7.3 12a1 1 0 0 0 1.4 0C13.4 21.2 20 15.4 20 9.8 20 5.5 16.4 2 12 2z" fill="${color}" stroke="#fff" stroke-width="1.6"/><circle cx="12" cy="9.8" r="3.3" fill="#fff"/></svg></div>`,
    iconSize: [s, s], iconAnchor: [s/2, s - 2], tooltipAnchor: [0, -s + 6]
  });
}
function zyBaseLayers(map){
  /* Mapa a todo color estilo Google Maps (calles amarillas/blancas, parques verdes, agua azul, nombres de
     colonias y comercios): «World Street Map» de Esri, gratis y sin clave. «Satélite» = fotografía real +
     nombres de calles y colonias encima. (Los mapas de Google como tal exigen clave de API con tarjeta
     y no permiten pines propios en iframes.) */
  const calles = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}', { maxZoom:19, attribution:'Esri, HERE, Garmin, © OpenStreetMap contributors' });
  const satelite = L.layerGroup([
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', { maxZoom:19, attribution:'Imágenes © Esri, Maxar, Earthstar Geographics' }),
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}', { maxZoom:19 })
  ]);
  calles.addTo(map);
  L.control.layers({ 'Mapa':calles, 'Satélite':satelite }, null, { position:'topright', collapsed:true }).addTo(map);
}
function zyNewMap(el, view, zoom){
  const map = L.map(el, { zoomControl:false, attributionControl:false, tap:true }).setView(view, zoom);
  L.control.zoom({ position:'bottomright' }).addTo(map);
  L.control.attribution({ prefix:false, position:'bottomleft' }).addTo(map);
  zyBaseLayers(map);
  return map;
}

/* ---------- Mapa de entrega (pin arrastrable + vista satélite) ---------- */
let zyDeliveryMap = null, zyDeliveryMarker = null, zyDeliveryCircle = null, zyDeliveryCoords = null, zyRevTimer = null;
function zyShowDeliveryMap(coords, accuracy){
  const wrap = document.getElementById('deliveryMapWrap');
  if(wrap) wrap.classList.remove('page-hidden');
  zyEnsureLeaflet(()=>{
    const el = document.getElementById('deliveryMap');
    if(!el) return;
    if(!zyDeliveryMap){
      zyDeliveryMap = zyNewMap(el, [coords.lat, coords.lng], 18);
      zyDeliveryMap.on('click', e=>zyMoveDeliveryPin(e.latlng.lat, e.latlng.lng));
    }
    zyDeliveryMap.invalidateSize();
    if(zyDeliveryMarker) zyDeliveryMap.removeLayer(zyDeliveryMarker);
    if(zyDeliveryCircle){ zyDeliveryMap.removeLayer(zyDeliveryCircle); zyDeliveryCircle = null; }
    zyDeliveryMarker = L.marker([coords.lat, coords.lng], { draggable:true, icon:zyPinIcon('#2F5FFF', true) }).addTo(zyDeliveryMap);
    zyDeliveryMarker.on('dragend', ()=>{ const p = zyDeliveryMarker.getLatLng(); zyMoveDeliveryPin(p.lat, p.lng); });
    zyDeliveryCoords = { lat:coords.lat, lng:coords.lng };
    if(accuracy != null && accuracy > 0){
      zyDeliveryCircle = L.circle([coords.lat, coords.lng], { radius:accuracy, color:'#2F5FFF', weight:1, fillOpacity:0.1 }).addTo(zyDeliveryMap);
    }
    zyDeliveryMap.setView([coords.lat, coords.lng], accuracy != null && accuracy > 150 ? 16 : 18);
  });
}
function zyMoveDeliveryPin(lat, lng){
  if(!zyDeliveryMap || !zyDeliveryMarker) return;
  zyPinTouched = true;   // el cliente ajustó el pin: ninguna lectura de GPS posterior lo mueve
  zyDeliveryMarker.setLatLng([lat, lng]);
  if(zyDeliveryCircle){ zyDeliveryMap.removeLayer(zyDeliveryCircle); zyDeliveryCircle = null; }
  zyDeliveryCoords = { lat, lng };
  userCoords = { lat, lng };
  clearTimeout(zyRevTimer);
  zyRevTimer = setTimeout(()=>reverseGeocodeIntoForm({ lat, lng }, null), 450);
}
/* Coloca el pin a partir de la dirección que el cliente escribió (búsqueda directa). */
function zyLocateTypedAddress(){
  const v = id => ((document.getElementById(id) || {}).value || '').trim();
  if(!v('ckAddress') && !v('ckZip') && !v('ckCity')){ showToast('Escribe primero tu calle, colonia y código postal', true); return; }
  const headers = { headers:{ 'Accept-Language':'es' } };
  const q1 = [v('ckAddress'), v('ckCity'), v('ckZip'), v('ckState'), 'México'].filter(Boolean).join(', ');
  const q2 = [v('ckZip'), v('ckCity'), v('ckState'), 'México'].filter(Boolean).join(', ');
  const search = q => fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=mx&q=' + encodeURIComponent(q), headers).then(r=>r.json());
  const readout = document.getElementById('geoReadout');
  if(readout) readout.innerHTML = '<span><span class="zy-spin"></span> Buscando tu dirección en el mapa…</span>';
  search(q1).then(r=> r.length ? { r, exacta:true } : search(q2).then(r2=>({ r:r2, exacta:false }))).then(({ r, exacta })=>{
    if(!r.length){
      if(readout) readout.innerHTML = '<span class="geo-empty">No encontramos esa dirección en el mapa. Revisa los datos o usa «Usar mi ubicación».</span>';
      showToast('No encontramos esa dirección en el mapa', true);
      return;
    }
