/* [FIX] Devuelve si el pedido actual ya califica para envío gratis (por
   monto mínimo o por cupón de envío gratis), para poder ocultar las
   opciones de paquetería PAGADA en el checkout cuando ya no aplican —
   antes se seguían mostrando "Estafeta Terrestre $149 / Rápido $329" como
   si hubiera que elegir y pagar, aunque el envío ya fuera gratis. */
// [MEMBRESÍAS-ENVÍO] Antes las membresías de ZAYDE Club prometían "envío
// gratis siempre" (niveles Icon/Icon Black) pero el checkout nunca revisaba
// si el cliente era miembro — solo el monto mínimo de $1,800 MXN, igual que
// un invitado. Cualquier nivel de pago (precio distinto de "Gratis" en
// zySettings.clubTiers) desbloquea envío gratis sin mínimo; el nivel Member
// (gratis) sigue funcionando con el mínimo de siempre, tal como se promete
// en su propia tarjeta de beneficios.
function zyMembershipHasFreeShipping(){
  if(!currentMembership || !currentMembership.tier) return false;
  const tierDef = (zySettings.clubTiers||[]).find(t=>t.name===currentMembership.tier);
  if(!tierDef) return false;
  return String(tierDef.price||'').trim().toLowerCase() !== 'gratis';
}
// [MEMBRESÍAS · MÍNIMO POR NIVEL] Mínimo de envío gratis que le toca a ESTE cliente:
// - sin nivel de pago (o Member): el público (ZY_FREE_SHIP_THRESHOLD).
// - nivel de pago con "freeShipMin" definido en el panel (ej. Icon $1,300): ese monto.
// - nivel de pago sin "freeShipMin" (niveles guardados antes de este cambio): 0 = sin mínimo, como antes.
function zyFreeShipThreshold(){
  if(!zyMembershipHasFreeShipping()) return ZY_FREE_SHIP_THRESHOLD;
  const t = (zySettings.clubTiers||[]).find(x=>x.name===(currentMembership&&currentMembership.tier));
  const m = t && t.freeShipMin !== undefined && t.freeShipMin !== '' ? Number(t.freeShipMin) : 0;
  return isFinite(m) && m >= 0 ? m : 0;
}
function zyIsFreeShipping(){
  if(cart.length && cart.every(zyIsDigitalItem)) return false; // no aplica: no hay envío que cobrar ni regalar
  if(zyMembershipHasFreeShipping() && zyFreeShipThreshold() === 0) return true;
  const physicalSubtotal = zyPhysicalSubtotal();
  if(physicalSubtotal >= zyFreeShipThreshold()) return true;
  if(zyCoupon && zyCoupon.type==='freeship') return true;
  return false;
}
function computeShippingCost(){
  // Carrito 100% digital (membresías ZAYDE Club y/o tarjetas de regalo): no hay nada que enviar.
  if(cart.length && cart.every(zyIsDigitalItem)) return 0;
  if(zyIsFreeShipping()) return 0;
  return shipMode === 'sucursal' ? shippingPriceForSucursal(selectedCarrier) : shippingPriceForOption(selectedShip);
}
function updateCheckoutTotals(){
  const subtotal = cart.reduce((a,c)=>a+c.price*c.qty,0);
