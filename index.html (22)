async function zyRenderClubStatus(){
  const btn = document.getElementById('clubJoinBtn');
  if(!btn) return;
  if(!currentUser){ btn.textContent = 'Iniciar sesión para unirme'; btn.disabled = false; return; }
  const membership = await zyCheckClubExpiry();
  // [FIX] Este botón solo debía confirmar que ya eres miembro cuando tu
  // nivel actual es justo el que este botón ofrece (Member); si ya tienes
  // OTRO nivel (ej. Icon) no debe decir "ya eres miembro" de forma
  // ambigua — con los niveles de abajo (zyRenderClubTiers) ya puedes
  // subir de nivel con total normalidad (la bajada a Member es siempre
  // automática, al cumplirse el mes — ver zyCheckClubExpiry()).
  if(membership && membership.tier === 'Member'){ btn.textContent = `Ya eres miembro ${membership.tier} ✓`; btn.disabled = true; }
  else if(membership){ btn.textContent = `Ya eres miembro ${membership.tier} ✓ — elige otro nivel abajo`; btn.disabled = true; }
  else { btn.textContent = 'Unirme a ZAYDE Club'; btn.disabled = false; }
}
async function zyJoinClub(tierName){
  if(!(zySettings && zySettings.clubPublic)){ showToast('ZAYDE Club estará disponible pronto', true); return; }
  tierName = tierName || 'Member';
  if(!currentUser){ showToast('Inicia sesión para unirte a ZAYDE Club', true); openLogin(); return; }
  const existing = await zyCheckClubExpiry();
  // [FIX] "Al agregar la membresía solo aparece que ya soy miembro, en
  // lugar de agregar la membresía al carrito": antes, si el cliente YA
  // tenía CUALQUIER membresía (incluso la gratuita "Member" por
  // default), este botón bloqueaba TODOS los niveles con "Ya eres
  // miembro ✓" — incluyendo los de PAGO, que nunca llegaban al carrito
  // ni se podían comprar como upgrade. Ahora solo bloquea si ya tiene
  // EXACTAMENTE ese mismo nivel; cualquier nivel de mayor precio (upgrade)
  // sí se agrega al carrito para pagarlo normal.
  if(existing && existing.tier === tierName){ showToast(`Ya eres miembro ${existing.tier} ✓`); return; }

  const tierDef = (zySettings.clubTiers||[]).find(t=>t.name===tierName) || { name:tierName, price:'Gratis' };
  const amount = zyParseTierAmount(tierDef.price);
  if(amount > 0 && !ZY_PAID_MEMBERSHIPS_ENABLED){ showToast('Las membresías de paga estarán disponibles pronto', true); return; }

  // [MEMBRESÍAS · SOLO SUBIR DE NIVEL] No se permite bajar de nivel a mano
  // (ej. de Icon a Member, o de Icon Black a Icon) — el botón ya viene
  // deshabilitado para esto en zyRenderClubTiers(), pero se revalida aquí
  // por si se llama esta función de otra forma. La única bajada posible es
  // automática, al cumplirse el mes de un nivel de paga (ver
  // zyCheckClubExpiry()), nunca por elección manual del cliente.
  if(existing && amount < zyClubTierAmount(existing.tier)){
    showToast(`No puedes bajar de nivel manualmente — ${existing.tier} se ajusta solo a Member al cumplir el mes`, true);
    return;
  }

  if(amount <= 0){
    // Nivel gratuito (ej. "Member" en $0/Gratis): no hay nada que cobrar,
    // así que se activa al instante. Solo se llega hasta aquí si el
    // cliente no tenía ya un nivel de mayor precio (eso lo bloquea el
    // guard de arriba) — típicamente es unirse por primera vez.
    const rec = { tier: tierName, joinedAt: Date.now() };
    await Store.set('zayde:club:'+userKey(), rec);
    // [FIX — "me pide volver a comprarla" al bajar de Icon a Member]
    // currentMembership (la variable en memoria que usa TODO el sitio,
    // ej. envío gratis en el checkout) solo se actualizaba aquí para
    // niveles de PAGA, dentro de zyActivatePaidMemberships() — nunca en
    // este camino gratuito. Se quedaba con el nivel viejo (Icon) hasta
    // recargar la página, así que el resto de la sesión seguía tratando
    // al cliente como si aún tuviera Icon (o pidiéndole completar un
    // pago que ya no aplicaba) en vez de reflejar el cambio a Member de
    // inmediato. Ahora se actualiza aquí mismo, igual que en el pago.
    currentMembership = rec;
    // Por si había quedado en el carrito un intento de compra de OTRO
    // nivel de paga sin terminar (ej. Icon Black a medio pagar), se
    // quita al bajar a un nivel gratuito para no dejar un pendiente de
    // pago que ya no corresponde a la membresía activa.
    const hadStaleCartItem = cart.some(c=>c.isMembership);
    if(hadStaleCartItem){
      cart = cart.filter(c=>!c.isMembership);
      renderCart();
      persistCart();
    }
    showToast(existing ? `Cambiaste a ${tierName} ✓` : `¡Bienvenido a ${tierName}!`);
    zyRenderClubStatus();
    zyRenderClubTiers();
    return;
  }

  // Nivel de paga: se agrega al carrito como ítem digital. El botón "Unirme"
  // ya NO otorga la membresía ni muestra "Bienvenido" — eso solo ocurre
  // después de que el pago se complete de verdad en el checkout.
  if(cart.some(c=>c.isMembership && c.tierName===tierName)){
    showToast(`${tierName} ya está en tu carrito`);
    openCart();
    return;
  }
  cart.push({
    id: 'membership-'+tierName.toLowerCase().replace(/\s+/g,'-'),
    isMembership: true,
    tierName,
    name: `Membresía ${tierName}`,
    brand: 'ZAYDE Club',
    category: 'Membresía',
    price: amount,
    size: null,
    imgSeed: null,
    qty: 1
  });
  renderCart();
  persistCart();
  zyRenderClubTiers();
  showToast(`${tierName} añadido al carrito — paga para activar tu membresía`);
  openCart();
}
/* Se llama justo después de que un pedido se paga de verdad (paymentStatus
   === 'pagado'). Recorre los ítems del pedido, activa cualquier membresía
   que haya en él y muestra el aviso de bienvenida — nunca antes de este
   punto. */
async function zyActivatePaidMemberships(order){
  const memberships = (order.items||[]).filter(it=>it.isMembership);
  if(!memberships.length) return;
  for(const m of memberships){
    // La membresía la activa el servidor (webhook de Stripe); aquí solo se espera a que quede registrada.
    const srv = await zyWaitForServerMembership(m.tierName);
    if(srv){
      currentMembership = srv;   // [MEMBRESÍAS-ENVÍO] refleja el envío gratis de inmediato en esta misma sesión
      showToast(`¡Pago confirmado! Bienvenido a ${m.tierName} ✓`);
    }else{
      showToast('Recibimos tu pago. Tu membresía se activará en unos minutos; si no ves tus beneficios, escríbenos.', true);
    }
  }
  zyRenderClubStatus();
  zyRenderClubTiers();
}
/* Se llama junto con zyActivatePaidMemberships, justo después de que el
   pedido se paga de verdad. Recorre las tarjetas de regalo del pedido y
   recién AQUÍ genera el código real de cada una — antes esto se creaba
   gratis, sin pasar por ningún pago, al hacer clic en "Comprar tarjeta de
   regalo". Si quien compró es también el destinatario (mismo correo de su
   cuenta), el saldo se agrega directo a su cuenta ZAYDE sin necesidad de
   canjear el código a mano. */
// [SIN PEDIDO] Antes esta función recibía el "order" completo y guardaba
// order.orderNum dentro de cada tarjeta — eso ató la emisión de tarjetas
// de regalo a que existiera un pedido, aunque nunca se mostraba ese
// número en ningún lado útil (el código real que se canjea es "code",
// generado aquí mismo, no el número de pedido). Ahora recibe solo lo que
// de verdad necesita (los ítems de tarjeta de regalo + quién compró) para
// poder emitirse SIN depender de ningún pedido — ver
// zyConfirmDigitalOnlyPurchase(), que ya no crea ningún "order".
// purchaseRef es opcional y puramente interno (soporte/logs) — nunca se
// muestra al cliente como "número de pedido".
async function zyIssueGiftCards(giftItems, buyerInfo){
  // [TARJETAS DE REGALO · EN EL SERVIDOR] El código lo genera el servidor (webhook) cuando Stripe confirma el pago y se
  // manda por correo al destinatario; si te la regalas a ti mismo, el saldo se suma solo a tu cuenta. Aquí solo se avisa.
  if(!giftItems || !giftItems.length) return;
  const me = currentUser && currentUser.email ? currentUser.email.toLowerCase() : '';
  let toSelf = 0;
  for(const it of giftItems){
    const amount = it.giftAmount || it.price;
    if(me && it.giftEmail && it.giftEmail.toLowerCase() === me){ toSelf += Number(amount) || 0; continue; }
    showToast(`¡Pago confirmado! Tu tarjeta de ${fmt(amount)} se enviará a ${it.giftEmail} en unos segundos.`);
  }
  if(toSelf > 0){
    const before = zyGiftBalance;
    const after = await zyWaitForGiftBalance(before);
    if(after > before) showToast(`¡Pago confirmado! Se añadieron ${fmt(after - before)} de saldo a tu cuenta`);
    else showToast('Recibimos tu pago. Tu saldo se verá en unos minutos.', true);
  }
}
// Compatibilidad: cuando una tarjeta de regalo se compra MEZCLADA con una
// membresía en el mismo carrito (combo que sí sigue generando un pedido
// digital, ver confirmOrder/zyIsDigitalOnlyOrder), se emite igual con
// zyIssueGiftCards, usando el número de ese pedido solo como referencia
// interna (purchaseRef) — el correo al destinatario (que puede ser
// alguien distinto de quien compró) ya no depende de ese número.
async function zyActivatePaidGiftCards(order){
  const giftItems = (order.items||[]).filter(it=>it.isGiftCard);
  await zyIssueGiftCards(giftItems, { name: order.name, email: order.email, purchaseRef: order.orderNum });
}

