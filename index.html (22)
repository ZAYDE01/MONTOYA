// Decide qué falta preguntar y lo pregunta; si ya hay todo, recomienda.
function zyBotFlowNext(){
  const f = zybotFlow; if(!f) return;
  const nm = zyBotGreetName();
  if(!f.cat){
    f.type = 'cat';
    zyBotPrompt(`Va${nm} 🙌 Para recomendarte justo lo que buscas, ¿qué tipo de pieza es?`, zyBotBtnsHTML([
      {label:'Ropa', fn:"zyBotFlowPickCat('Ropa')"},
      {label:'Zapatos', fn:"zyBotFlowPickCat('Zapatos')"},
      {label:'Otra categoría', fn:"zyBotFlowPickCat('otras')"}
    ]));
    return;
  }
  if(f.cat!=='Ropa' && f.cat!=='Zapatos'){
    zybotFlow = null;
    zyBotShowRecommendations(f.cat, null, null, null);
    return;
  }
  if(!f.aud){
    f.type = 'aud';
    zyBotPrompt(`¿Qué ${f.cat==='Zapatos'?'zapatos':'ropa'} buscas${nm}? Elige la línea:`, zyBotBtnsHTML(
      ZYBOT_AUDS.map(a=>({label:a.label, fn:`zyBotFlowPickAud('${a.key}')`}))
    ));
    return;
  }
  if(!f.gender && ZYBOT_AUD_GENDER[f.aud]) f.gender = ZYBOT_AUD_GENDER[f.aud];
  if(!f.gender){
    f.type = 'gender';
    const lbl = (ZYBOT_AUDS.find(a=>a.key===f.aud)||{}).label || '';
    zyBotPrompt(`Perfecto, ${lbl.toLowerCase()}. ¿Son para hombre, mujer o niños? Así te muestro la talla correcta.`, zyBotBtnsHTML(
      ['Hombre','Mujer','Niños'].map(g=>({label:g, fn:`zyBotFlowPickGender('${g}')`}))
    ));
    return;
  }
  const scale = zyBotSizesFor(f.cat, f.gender);
  if(f.cat==='Zapatos' && f.size!=null && scale.length && !scale.includes(String(f.size))){ const _us = scale.find(x=>zyShoeMx({category:'Zapatos',gender:f.gender},x)===String(parseFloat(f.size))); if(_us) f.size = _us; }   // si escribió su talla en MX, se convierte
  if(f.size!=null && scale.length && !scale.includes(String(f.size))){
    const bad = f.size; f.size = null; f.type = 'size';
    const note = f.cat==='Zapatos'
      ? `La talla ${bad} no está en nuestra escala (manejamos tallas MX de ${zyShoeMx({category:'Zapatos',gender:f.gender},scale[0])} a ${zyShoeMx({category:'Zapatos',gender:f.gender},scale[scale.length-1])} para ${f.gender.toLowerCase()}). ¿Cuál es tu talla en MX?`
      : `No manejo la talla ${bad}. ¿Cuál de estas es la tuya?`;
    zyBotPrompt(note, zyBotBtnsHTML(scale.map(x=>({label:(f.cat==='Zapatos' ? zyShoeMx({category:'Zapatos',gender:f.gender},x)+' MX' : x), fn:`zyBotFlowPickSize('${x}')`})), true));
    return;
  }
  if(f.size==null){
    f.type = 'size';
    const q = f.cat==='Zapatos' ? `¿Qué talla usas${nm}? (talla MX, el número en cm de la caja)` : `¿Qué talla usas normalmente${nm}?`;
    zyBotPrompt(q, zyBotBtnsHTML(scale.map(x=>({label:(f.cat==='Zapatos' ? zyShoeMx({category:'Zapatos',gender:f.gender},x)+' MX' : x), fn:`zyBotFlowPickSize('${x}')`})), true));
    return;
  }
  const done = {cat:f.cat, size:f.size, aud:f.aud, gender:f.gender};
  zybotFlow = null;
  zyBotShowRecommendations(done.cat, done.size, done.aud, done.gender);
}
function zyBotFlowPickCat(v){
