  if(elDisc) elDisc.textContent = '-'+fmt(discount);
  if(elShip) elShip.textContent = allDigital ? 'No aplica' : (shipping===0 ? 'Gratis' : fmt(shipping));
  if(elGiftRow) elGiftRow.style.display = giftUsed>0 ? 'flex' : 'none';
  if(elGift) elGift.textContent = '-'+fmt(giftUsed);
  if(elTotal) elTotal.textContent = fmt(total);

  // [RESUMEN — CHECKOUT] Mismos números, reflejados en el acordeón
  // "Resumen" de arriba de la página (encabezado colapsado + desglose).
  const count = cart.reduce((a,c)=>a+c.qty,0);
  const elHeadTotal = document.getElementById('ckSummaryHeaderTotal');
  if(elHeadTotal) elHeadTotal.textContent = `${fmt(total)} (${count} ${count===1?'producto':'productos'})`;
  const elSumSub = document.getElementById('ckSummarySubtotal');
  const elSumDiscRow = document.getElementById('ckSummaryDiscountRow');
  const elSumDisc = document.getElementById('ckSummaryDiscountLine');
  const elSumShip = document.getElementById('ckSummaryShippingLine');
  const elSumGiftRow = document.getElementById('ckSummaryGiftRow');
  const elSumGift = document.getElementById('ckSummaryGiftLine');
  const elSumTotal = document.getElementById('ckSummaryTotalLine');
  if(elSumSub) elSumSub.textContent = fmt(subtotal);
  if(elSumDiscRow) elSumDiscRow.style.display = discount>0 ? 'flex' : 'none';
  if(elSumDisc) elSumDisc.textContent = '-'+fmt(discount);
  if(elSumShip) elSumShip.textContent = allDigital ? 'No aplica' : (shipping===0 ? 'Gratis' : fmt(shipping));
  if(elSumGiftRow) elSumGiftRow.style.display = giftUsed>0 ? 'flex' : 'none';
  if(elSumGift) elSumGift.textContent = '-'+fmt(giftUsed);
  if(elSumTotal) elSumTotal.textContent = fmt(total);
  {
    const covers = giftUsed > 0 && total < 0.5;
    const sp = document.getElementById('stripeCardPreview'); if(sp) sp.style.display = covers ? 'none' : '';
    const pn = document.getElementById('payMethodNote'); if(pn) pn.style.display = covers ? 'none' : '';
    const cn = document.getElementById('ckGiftCoversNote'); if(cn) cn.style.display = covers ? 'flex' : 'none';
  }
  zyRenderAppliedCodes();
  return total;
}

