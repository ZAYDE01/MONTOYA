  const afterDiscount = Math.max(0, subtotal - discount);
  const giftUsed = zyGiftToUse(afterDiscount + shipping);
  const total = afterDiscount + shipping - giftUsed;
  const allDigital = cart.length>0 && cart.every(zyIsDigitalItem);
  const elSub = document.getElementById('ckSubtotalLine');
  const elDiscRow = document.getElementById('ckDiscountRow');
