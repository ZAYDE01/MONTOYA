  document.getElementById('branchSummaryName').textContent = `${CARRIERS[selectedCarrier].label} · ${b.name}`;
  document.getElementById('branchSummaryAddr').textContent = b.addr + (branchRef && b.lat != null ? ` · a ${haversineKm(branchRef,b).toFixed(1)} km de ${branchRef.label}` : '');
  if(estafetaMap && window.L){
    const color = CARRIERS[selectedCarrier].color;
    Object.keys(branchMarkers).forEach(k=>{
      const act = String(k) === String(id);
      branchMarkers[k].setIcon(zyPinIcon(color, act));
      branchMarkers[k].setZIndexOffset(act ? 1000 : 0);
    });
    if(b.lat != null) estafetaMap.setView([b.lat, b.lng], 15);
  }
  zyResolveBranchState(b);
