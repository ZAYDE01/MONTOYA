/* Carga y muestra el pedido más reciente de este navegador dentro del panel,
   para que siempre esté a la vista sin tener que buscarlo. */
async function zyLoadRecentOrder(){
  const box = document.getElementById('myOrderRecent');
  if(!box) return;
  try{
    const all = (await Store.get('zayde:orders')) || [];
    // [FIX] "Aparece un pedido con pasos de envío cuando compro una
    // membresía": esta tarjeta es para dar SEGUIMIENTO (verificando,
    // preparando, en camino...), algo que no aplica a una compra 100%
    // membresía. Se ignoran esos pedidos aquí y se muestra el más
    // reciente que sí sea rastreable (físico, o con tarjeta de regalo).
    // [FIX] Antes solo se ocultaban aquí los pedidos 100% membresía
    // (zyIsMembershipOnlyOrder) — un combo de membresía + tarjeta de
    // regalo (o tarjeta de regalo sola) seguía colándose como pedido
    // "rastreable" con pasos de envío que nunca aplicaban. Ahora se oculta
    // cualquier pedido 100% digital, sin importar la combinación —
    // igual que ya no se crea NINGÚN pedido nuevo para estos casos (ver
    // confirmOrder/zyIsDigitalOnlyOrder). Esto también limpia pedidos
    // viejos que se hayan guardado antes de ese fix.
    const mine = zyMyOrders(all).filter(o=>!zyIsDigitalOnlyOrder(o)).slice().sort((a,b)=>(b.date||0)-(a.date||0));
    if(!mine.length){
      box.innerHTML = '<div class="order-empty">Aún no tienes pedidos en este navegador. Cuando confirmes uno, aparecerá aquí de inmediato.</div>';
      return;
    }
    // [HISTORIAL] Se recuerdan los pedidos que el cliente tenía abiertos, porque esta tarjeta se
    // vuelve a dibujar sola cada vez que cambia la etapa de un pedido.
    const openNums = Array.from(box.querySelectorAll('details[data-ordnum][open]')).map(d=>d.dataset.ordnum);
    const older = mine.slice(1);
    window.zyHistMap = {}; older.forEach(o=>{ window.zyHistMap[o.orderNum] = o; });
    box.innerHTML = `<div class="order-card-section-title" style="margin-bottom:10px;">Tu pedido más reciente</div>` + zyRenderOrderCard(mine[0]) + zyOrderHistoryHTML(older);
    openNums.forEach(num=>{ const d = Array.from(box.querySelectorAll('details[data-ordnum]')).find(x=>x.dataset.ordnum === num); if(d) d.open = true; });
  }catch(e){
    box.innerHTML = '<div class="order-empty">No se pudo cargar tu pedido más reciente.</div>';
  }
}

/* Se llama justo al confirmar un pedido: abre el panel de "Pedidos y
   rastreo" con un aviso permanente (no un toast de 2 segundos) y la
   tarjeta completa del pedido recién hecho, siempre visible hasta que
   el cliente lo cierre a mano. */
let zyLastOrderNum = null;
let zyLastOrder = null;
function zyShowOrderConfirmation(order, destText){
  zyLastOrderNum = order.orderNum;
  zyLastOrder = order;
  openTracking(true);
  const banner = document.getElementById('orderConfirmBanner');
  const emailNote = order.email ? ` Te enviamos un correo de confirmación a ${order.email}.` : '';
  // [FIX] "Se hace una cotización y se manda un correo de pedido en
  // camino": esta línea de WhatsApp/cotización se mostraba SIEMPRE, hasta
  // en pedidos 100% digitales (membresía / tarjeta de regalo) donde no se
  // abre ningún WhatsApp ni hay cotización que enviar — ver
  // zyToggleDigitalCheckoutUI(), que oculta esa pestaña para pedidos
  // digitales. Ahora solo se muestra cuando de verdad aplica.
  const allDigitalOrder = (order.items||[]).length>0 && (order.items||[]).every(it=>it.isMembership||it.isGiftCard);
  const waNote = allDigitalOrder ? '' : ' Se abrió WhatsApp con tu cotización lista para enviar; si no se abrió, usa el botón de abajo.';

  // [FIX] "Al pagar la membresía manda una cotización y un número de
  // pedido, en vez de una confirmación de membresía": una compra 100%
  // digital ya pagada no es una cotización pendiente de nadie — el título
  // del aviso, la referencia y el botón de WhatsApp (pensado para mandar
  // la cotización de un pedido físico que aún no se paga) ahora reflejan
  // que es una confirmación de membresía/tarjeta de regalo, no un pedido
  // en proceso.
  const membershipItem = (order.items||[]).find(it=>it.isMembership);
  const giftItem = (order.items||[]).find(it=>it.isGiftCard);
  // [FIX] "Al pagar una membresía sigue apareciendo un número para
  // copiar en el sitio": una membresía no es un pedido con seguimiento —
  // no hay nada que rastrear ni ninguna referencia que el cliente
  // necesite guardar. Se quita el botón de copiar cuando la compra es
  // SOLO membresía (sin tarjeta de regalo mezclada). La tarjeta de
  // regalo sí conserva su número de referencia, porque ese código es el
  // que se usa para canjearla más adelante.
  const membershipOnly = allDigitalOrder && membershipItem && !giftItem;
  let title = '¡Pedido confirmado!';
  let refLabel = 'Copiar código de pedido';
  if(allDigitalOrder){
    if(membershipItem && giftItem) title = '¡Membresía y tarjeta de regalo confirmadas!';
    else if(membershipItem) title = `¡Membresía ${zyEscapeHtml(membershipItem.tierName || '')} confirmada!`;
    else title = '¡Tarjeta de regalo confirmada!';
    refLabel = 'Copiar número de referencia';
  }
  document.getElementById('orderConfirmBannerTitle').textContent = title;
  zyHaptic(15); // [DETALLE] golpecito táctil al confirmar el pedido (Android)
  document.getElementById('ocbCopyBtnLabel').textContent = refLabel;
  document.getElementById('ocbCopyBtn').style.display = membershipOnly ? 'none' : '';
  document.getElementById('ocbWaBtn').style.display = allDigitalOrder ? 'none' : '';
  document.getElementById('orderConfirmBannerText').textContent =
    allDigitalOrder ? ` ${destText}.${emailNote}` : `Pedido ${order.orderNum} — ${destText}.${emailNote}${waNote}`;
  banner.classList.remove('page-hidden');
  const box = document.getElementById('myOrderRecent');
  // [FIX] "Aparece un pedido con pasos de envío al comprar una membresía":
  // cuando la compra es SOLO membresía (sin tarjeta de regalo), el banner
  // verde de arriba ya dice todo lo que hay que decir — no hay número de
  // pedido que guardar ni nada que rastrear, así que aquí ya no se agrega
  // ninguna tarjeta debajo. Si además hay tarjeta de regalo de por medio,
  // sí se muestra (sin timeline de envío) porque ese código de regalo se
  // necesita para canjearlo después.
  if(membershipOnly){
    box.innerHTML = '';
  } else {
    box.innerHTML = `<div class="order-card-section-title" style="margin-bottom:10px;">Tu pedido más reciente</div>` + zyRenderOrderCard(order, {showQuoteLink:true});
    zyAppendOrderHistory(box, order.orderNum); // [HISTORIAL] pedidos anteriores debajo del nuevo
  }
  zyUpdateOrderBadge();
  // Copia el código de verificación al portapapeles de inmediato, en el mismo
  // instante en que se genera y se muestra — sin que el cliente tenga que
  // tocar nada. Si el navegador bloquea la copia automática, el botón junto
  // al código sigue ahí como respaldo.
  if(order.verification && order.verification.code){
    zyCopyVerificationCode(order.verification.code, true);
  }
}

