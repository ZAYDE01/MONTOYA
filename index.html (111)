// varias páginas en hacerlo.
function zyCapturePendingReferral(){
  try{
    const ref = new URLSearchParams(location.search).get('ref');
    if(ref) localStorage.setItem('zayde:pendingRef', ref.toUpperCase().trim());
  }catch(e){}
}
zyCapturePendingReferral(); // se ejecuta de inmediato, no espera a Firebase ni a ningún otro init
// Se llama justo después de crear una cuenta nueva (nunca en un login
// normal) desde los 3 flujos de alta. Es a prueba de auto-referidos y de
// códigos inválidos: si algo no cuadra, simplemente no pasa nada — nunca
// bloquea ni ensucia el registro de la cuenta nueva.
async function zyApplyPendingReferral(newUid){
  try{
    let code = '';
    try{ code = localStorage.getItem('zayde:pendingRef') || ''; }catch(e){}
    if(!code) return;
    const referrerUid = await zyResolveReferralCode(code);
    if(!referrerUid || referrerUid === newUid) return; // código inválido, o alguien se puso su propio código
    if(db){
