/* ================= PERSISTENCIA (carrito / favoritos / sesión) =================
   Usa el almacenamiento persistente de Claude (window.storage) cuando está
   disponible; si el sitio se aloja fuera de claude.ai, cae automáticamente
   a localStorage del navegador. Así el carrito y los favoritos de tu cuenta
   no se pierden al recargar o "reiniciar" el sitio. */
const Store = {
  async get(key){
    try{
      if(window.storage){
        const r = await window.storage.get(key, false);
        return r ? JSON.parse(r.value) : null;
      }
    }catch(e){ /* window.storage no disponible en este entorno: caemos a localStorage abajo */ }
    try{
      const raw = localStorage.getItem(key);
      return raw ? JSON.parse(raw) : null;
    }catch(e){ return null; }
  },
  async set(key, value){
    try{
      if(window.storage){ await window.storage.set(key, JSON.stringify(value), false); return; }
    }catch(e){ /* window.storage no disponible en este entorno: caemos a localStorage abajo */ }
    try{
      localStorage.setItem(key, JSON.stringify(value));
    }catch(e){ console.error('No se pudo guardar', key, e); }
  }
};
/* ================= [PRESENCIA EN VIVO] "X personas viendo esta pieza" =================
   Prueba social REAL, no un número decorativo: cada navegador que tiene
   esta ficha de producto abierta manda un "latido" con su hora a
   Firestore (productPresence/{productId}/viewers/{sessionId}). Al
   abrirla, se cuenta cuántos latidos de OTROS navegadores hay en los
   últimos 90 segundos — si Firestore no está disponible (sin conexión,
   adblocker, o el sitio corriendo sin Firebase configurado), el aviso
   simplemente no aparece; nunca se rellena con un número inventado.
   IMPORTANTE (mantenimiento): configura una política de TTL en Firestore
   Console (pestaña "TTL" de la base de datos) sobre el campo "at" de la
   colección productPresence, así los latidos viejos se borran solos y la
   colección no crece sin límite — si no la configuras, el sitio sigue
   funcionando igual (el corte de 90s ya filtra a los que ya se fueron),
   solo acumularás documentos viejos en Firestore. */
let zyViewerHeartbeatInterval = null;
function zyGetSessionId(){
  try{
    let id = sessionStorage.getItem('zayde:sessionId');
    if(!id){ id = 'sx-' + Date.now().toString(36) + '-' + Math.random().toString(36).slice(2,8); sessionStorage.setItem('zayde:sessionId', id); }
    return id;
  }catch(e){ return 'sx-fallback-' + Math.random().toString(36).slice(2,8); } // navegación privada muy restrictiva: no persiste entre recargas, pero no rompe nada
}
async function zyStartViewerPresence(productId){
  if(zyViewerHeartbeatInterval){ clearInterval(zyViewerHeartbeatInterval); zyViewerHeartbeatInterval = null; }
  const el = document.getElementById('pdpViewers');
  if(!db){ if(el) el.style.display = 'none'; return; } // sin Firestore no hay dato real que mostrar
  const beat = async ()=>{
    try{
      await db.collection('productPresence').doc(String(productId)).collection('viewers').doc(zyGetSessionId()).set({ at: Date.now() });
    }catch(e){ console.error('No se pudo actualizar la presencia en vivo:', e); }
    zyRenderViewerCount(productId);
  };
  beat();
  zyViewerHeartbeatInterval = setInterval(beat, 45000);
}
async function zyStopViewerPresence(){
  if(zyViewerHeartbeatInterval){ clearInterval(zyViewerHeartbeatInterval); zyViewerHeartbeatInterval = null; }
  const el = document.getElementById('pdpViewers');
  if(el) el.style.display = 'none';
  // Se borra el propio latido al salir de la ficha, para no seguir
  // contando a alguien que ya se fue durante los 90s de margen.
  if(db && currentProduct){
    try{ await db.collection('productPresence').doc(String(currentProduct.id)).collection('viewers').doc(zyGetSessionId()).delete(); }catch(e){}
  }
}
async function zyRenderViewerCount(productId){
  const el = document.getElementById('pdpViewers');
  if(!el || !db) return;
  try{
    const cutoff = Date.now() - 90000; // 90s sin latido = ya no está viendo la ficha
    const snap = await db.collection('productPresence').doc(String(productId)).collection('viewers').where('at','>',cutoff).get();
    const others = Math.max(0, snap.size - 1); // se resta uno mismo — solo interesa avisar de OTRAS personas
    if(others >= 1){
      el.style.display = '';
      el.textContent = others===1 ? 'Otra persona está viendo esta pieza ahora' : `${others} personas están viendo esta pieza ahora`;
    } else {
      el.style.display = 'none';
    }
  }catch(e){ console.error('No se pudo leer la presencia en vivo:', e); el.style.display = 'none'; }
}
