    zyStartLiveOrderSync();
  }
  // [BÚSQUEDA — SECCIÓN PROPIA] Al entrar a /buscar (o volver a ella con
  // atrás/adelante del navegador) se repinta con lo que ya haya escrito
  // en el campo de la página; si está vacío, muestra recientes/populares.
  if(page==='search') handleSearchPage(document.getElementById('searchInputPage') ? document.getElementById('searchInputPage').value : '');
  zyUpdateHeaderSwitch();
  // [FIX "Explorar no sale nada"] navigate('catalog') nunca llamaba a
  // renderCatalog() — solo pasaba cuando se entraba por navCatName() o
  // navLine() (clic en una categoría), que sí lo llaman aparte. Por eso la
  // pestaña "Explorar" de la barra móvil (que llama a navigate('catalog')
  // directo) mostraba la página vacía.
  if(page==='catalog') renderCatalog();
