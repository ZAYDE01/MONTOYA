/* [STOCK POR TALLA] Devuelve cuántas unidades reales quedan de una talla
   específica. Si el producto no trae stock por talla (ej. ítems viejos
   sin ese dato), se trata como "sin límite conocido" para no bloquear
   compras por error de datos faltantes. */
function zyStockForSize(product, size){
  if(!product || !product.stock || typeof product.stock[size] !== 'number') return Infinity;
  return product.stock[size];
}
/* [CROSS-SELL — Completa el look] Guarda las 3 piezas mostradas en la
   sección "Completa el look" del PDP actual, para que el botón "Agregar
   todo el look" sepa exactamente qué añadir sin tener que volver a
   calcularlas (y para que sigan siendo las mismas que la persona vio,
   aunque el catálogo cambie mientras está en la página). */
let zyCompleteLookItems = [];
function zyRenderCompleteLook(p){
  const section = document.getElementById('completeLookSection');
  if(!section) return;
  // Cross-sell real (no solo "más de lo mismo"): misma marca, CATEGORÍA
  // DISTINTA a la que se está viendo — así se arma un outfit (ej. sneaker
  // + ropa + lentes de la misma marca) en vez de repetir la categoría de
  // la pieza actual, que es justo lo que ya hace "También te puede
  // interesar" más abajo. Si la marca no alcanza para 3 piezas, se
  // completa con otras piezas del catálogo (misma lógica de respaldo que
  // ya usa el sitio en otras partes, ver zyOpenNotifyStock "similar").
  const pool = zyBrowsable().filter(x=>x.id!==p.id && x.category!==p.category);
  let sameBrand = pool.filter(x=>x.brand===p.brand);
  let picks;
  if(sameBrand.length >= 3){
    picks = sameBrand.sort(()=>0.5-seedRand(p.id+3)).slice(0,3);
  } else {
    const extra = pool.filter(x=>!sameBrand.includes(x)).sort(()=>0.5-seedRand(p.id+3));
    picks = sameBrand.concat(extra).slice(0,3);
  }
  zyCompleteLookItems = picks;
  if(!picks.length){ section.style.display = 'none'; return; }
  section.style.display = '';
  document.getElementById('completeLookBrandName').textContent = p.brand;
  document.getElementById('completeLookGrid').innerHTML = picks.map(cardHTML).join('');
  const totalPrice = picks.reduce((a,x)=>a+x.price, 0) + p.price;
  document.getElementById('completeLookAddAllBtn').textContent = `Agregar todo el look — ${fmt(totalPrice)}`;
}
/* Agrega las piezas de "Completa el look" al carrito de una sola vez.
   Respeta el stock real por talla (igual que addToCart): a cada pieza le
   toca automáticamente la talla más chica que SÍ tenga stock; si un
   producto no maneja tallas (bolsos, lentes, perfumes, etc.) se agrega sin
   talla. Si alguna pieza ya no tiene ninguna talla disponible, se salta
   sin tronar el resto del look. */
function zyAddCompleteLookToCart(){
  if(!zyCompleteLookItems.length) return;
  let added = 0, skipped = 0;
  zyCompleteLookItems.forEach(item=>{
    let size = null;
    if(item.sizes && item.sizes.length){
      size = item.sizes.find(s => zyStockForSize(item, s) > 0) || null;
      if(!size){ skipped++; return; }
    }
    const stockForSize = size ? zyStockForSize(item, size) : Infinity;
    const existing = cart.find(c=>c.id===item.id && c.size===size);
    const qtyAlreadyInCart = existing ? existing.qty : 0;
    if(qtyAlreadyInCart + 1 > stockForSize){ skipped++; return; }
    if(existing) existing.qty++;
    else cart.push({ id:item.id, name:item.name, brand:item.brand, category:item.category, price:zyPriceForSize(item, size), size, imgSeed:item.imgSeed, qty:1 });
    added++;
  });
  if(added){ renderCart(); persistCart(); zyHaptic(10); }
  if(added && !skipped) showToast(`Se añadieron ${added} pieza${added===1?'':'s'} del look al carrito`);
  else if(added && skipped) showToast(`Se añadieron ${added} pieza${added===1?'':'s'} — ${skipped} sin stock disponible ahora mismo`);
  else showToast('Esas piezas ya no tienen stock disponible ahora mismo', true);
}
function addToCart(silent){
  if(!requireSize()) return;
  const stockForSize = zyStockForSize(currentProduct, currentSize);
  const existing = cart.find(c=>c.id===currentProduct.id && c.size===currentSize);
  const qtyAlreadyInCart = existing ? existing.qty : 0;
  // [FIX — última unidad] Antes se podía seguir agregando la misma talla
  // aunque solo quedara 1 (o cualquier cantidad limitada) en el stock real,
  // permitiendo que el carrito llevara más piezas de las que en verdad
  // existen de esa talla. Ahora se topa exactamente al stock disponible.
  if(qtyAlreadyInCart + 1 > stockForSize){
    showToast(stockForSize<=0 ? 'Esa talla ya no tiene stock disponible' : `Solo queda${stockForSize===1?'':'n'} ${stockForSize} unidad${stockForSize===1?'':'es'} de esta talla — ya la${stockForSize===1?'':'s'} tienes en tu carrito`, true);
    return;
  }
  if(existing) existing.qty++;
  else cart.push({ id:currentProduct.id, name:currentProduct.name, brand:currentProduct.brand, category:currentProduct.category, price:zyPriceForSize(currentProduct, currentSize), size:currentSize, imgSeed:currentProduct.imgSeed, qty:1 });
  renderCart();
  persistCart();
  zyFlyToCart();
  zyHaptic(10); // [DETALLE] pequeño golpecito táctil en Android al agregar — ver zyHaptic()
  try{ zyMeta('track','AddToCart',{ content_ids:[String(currentProduct.id)], content_name:currentProduct.name, content_type:'product', value:Number(zyPriceForSize(currentProduct, currentSize))||0, currency:'MXN' }); }catch(e){}   // [META]
  if(!silent) showToast('Añadido al carrito');
}
// [DETALLE FINO] navigator.vibrate() no hace nada en iOS/escritorio (no
// existe la API o el navegador la ignora), así que este helper es
// puramente un "bonus" para Android — de ahí el try/catch silencioso: si
// falla o no existe, no debe romper el flujo de compra por nada del mundo.
function zyHaptic(ms){
  try{ if(navigator.vibrate) navigator.vibrate(ms || 10); }catch(e){}
}
// [DETALLE FINO — "precargar el PDP cuando el dedo se acerca al card"] La
// Speculation Rules API real (prerender de documento completo) está pensada
// para sitios de varias páginas con <a href>; ZAYDE es una SPA de una sola
// página (el "cambio de página" ya es 100% instantáneo, sin red, porque
// PRODUCTS ya vive en memoria) — ahí Speculation Rules no tendría nada que
// prerenderizar. Lo que sí cuesta tiempo real es la FOTO del producto, así
// que este es el equivalente práctico: en cuanto el dedo/mouse toca la
// tarjeta (pointerdown/touchstart disparan bastantes ms antes que el click
// que de verdad abre el PDP), se adelanta la descarga de esa foto a la
// resolución que va a usar el PDP — así, para cuando openPDP() la pinta,
// lo más probable es que ya esté en la caché del navegador.
const zyPdpPreloaded = new Set();
function zyPreloadPDP(id){
  if(zyPdpPreloaded.has(id)) return;
  const p = PRODUCTS.find(x=>x.id===id) || (typeof UPCOMING!=='undefined' && UPCOMING.find(x=>x.id===id));
  if(!p || !p.images || !p.images.length) return;
  zyPdpPreloaded.add(id);
  const img = new Image();
  img.src = zyCdnWidth(p.images[0], 1200);
}

/* [MICRO-INTERACCIÓN] "Fly to cart": clona la foto principal de la ficha
   de producto y la anima volando hacia el ícono del carrito (el que esté
   visible: barra superior en escritorio, tab inferior en celular). Al
   llegar, el ícono rebota y el conteo hace un pequeño "pulso" — esto es lo
   que hace que agregar algo se sienta con peso y confirmación visual, en
   vez de un simple toast de texto. Se degrada sin romper nada si falta
   algún elemento (ej. reduced motion, o si no hay foto de producto). */
function zyFlyToCart(){
  if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const sourceImg = document.querySelector('.pdp-gallery-main .swipe-slide.has-photo img, .pdp-gallery-main img');
  const cartBtn = (document.getElementById('cartIconBtn') && document.getElementById('cartIconBtn').offsetParent !== null)
    ? document.getElementById('cartIconBtn')
    : document.getElementById('tabCart');
  if(!sourceImg || !cartBtn) { zyBumpCartIcon(cartBtn); return; }
  const srcRect = sourceImg.getBoundingClientRect();
  const dstRect = cartBtn.getBoundingClientRect();
  if(!srcRect.width || !dstRect.width){ zyBumpCartIcon(cartBtn); return; }

  const clone = sourceImg.cloneNode(true);
  clone.className = 'zy-fly-clone';
  clone.style.cssText = `
    position:fixed; z-index:9999; pointer-events:none; border-radius:8px;
    top:${srcRect.top}px; left:${srcRect.left}px; width:${srcRect.width}px; height:${srcRect.height}px;
    object-fit:cover; box-shadow:var(--shadow); will-change:transform,opacity;
    transition:transform .55s cubic-bezier(.3,.1,.2,1), opacity .55s ease .1s;
  `;
  document.body.appendChild(clone);

  const dx = (dstRect.left + dstRect.width/2) - (srcRect.left + srcRect.width/2);
  const dy = (dstRect.top + dstRect.height/2) - (srcRect.top + srcRect.height/2);
  const scale = Math.max(0.08, (dstRect.width*0.9) / srcRect.width);

  requestAnimationFrame(()=>{
    clone.style.transform = `translate(${dx}px, ${dy}px) scale(${scale})`;
    clone.style.opacity = '0.15';
  });
  setTimeout(()=>{ clone.remove(); zyBumpCartIcon(cartBtn); }, 560);
}
function zyBumpCartIcon(cartBtn){
  if(!cartBtn) return;
  cartBtn.classList.remove('zy-cart-bump');
  void cartBtn.offsetWidth; // reinicia la animación si se dispara seguido
  cartBtn.classList.add('zy-cart-bump');
  setTimeout(()=>cartBtn.classList.remove('zy-cart-bump'), 420);
}
function buyNow(){
  if(!requireSize()) return;
  addToCart(true);
  openCart();
