  if(!reviews.length){
    summaryEl.innerHTML = `<span>Sé la primera persona en dejar una reseña de esta pieza.</span>`;
    listEl.innerHTML = `<div class="reviews-empty">Todavía no hay reseñas para este producto.</div>`;
    return;
  }
  const avg = reviews.reduce((a,r)=>a+r.stars,0) / reviews.length;
  const fullStars = Math.round(avg);
  summaryEl.innerHTML = `
