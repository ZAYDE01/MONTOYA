  document.getElementById('pdpSizes').innerHTML = (p.sizes||[]).filter(s=>!(p.category==='Gorras' && s==='Única')).map(s=>{
    const stock = p.stock ? p.stock[s] : 1;
    // [FIX — "hacer más grande el botón de campana"] Antes solo la
