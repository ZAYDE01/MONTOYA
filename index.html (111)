  const pdpSizeBlockEl = document.getElementById('pdpSizeBlock');
  if(pdpSizeBlockEl) pdpSizeBlockEl.style.display = (p.category==='Bolsos' && (p.sizes||[]).length<=1) ? 'none' : '';
  document.getElementById('buyNowBtn').disabled = false;
  const pdpStickyBuyBtnEl = document.getElementById('pdpStickyBuyBtn');
  if(pdpStickyBuyBtnEl) pdpStickyBuyBtnEl.disabled = false;

  // [PRESENCIA EN VIVO] Arranca el latido de "estoy viendo esta ficha"
  // para el contador de "X personas viendo esta pieza ahora" — ver
  // zyStartViewerPresence() más abajo.
  zyStartViewerPresence(p.id);

  // [GUÍA DE TALLAS] Solo tiene sentido mostrarla en categorías con
  // conversión real de medidas (Ropa y Zapatos) — Bolsos/Lentes/Relojes/
  // Perfumes/Joyería son talla única o mililitros, no aplica.
  const sizeGuideBtn = document.getElementById('pdpSizeGuideBtn');
  if(sizeGuideBtn){
    const hasRealSizeGuide = p.category === 'Ropa' || p.category === 'Zapatos' || zyIsGorraCat(p.category);
    sizeGuideBtn.style.display = hasRealSizeGuide ? '' : 'none';
    sizeGuideBtn.dataset.cat = p.category || '';
  }

  const pdpGalleryMainEl = document.querySelector('.pdp-gallery-main');
  const pdpImgCount = p.images ? (p.imageCount||p.images.length) : 5;
  const pdpHasRealPhoto = !!(p.images && p.images.length);
  // [SKELETON] Se activa antes de pintar el HTML nuevo (para que se vea
  // desde el primer frame) y se desactiva sola en cuanto la foto principal
  // dispara onload/onerror — ver zyMediaLoaded().
  pdpGalleryMainEl.classList.toggle('zy-loading', pdpHasRealPhoto);
  const pdpVideos = Array.isArray(p.videos) ? p.videos.filter(Boolean) : [];
  pdpGalleryMainEl.innerHTML = swipeGalleryHTML(p.id, pdpImgCount, p.images, `${p.brand} ${p.name}`, {zoom:true, eagerFirst:true, contain:true, videos:pdpVideos, order:p.mediaOrder});
  pdpGalleryMainEl.classList.toggle('has-photo', pdpHasRealPhoto || pdpVideos.length > 0);
  pdpGalleryMainEl.querySelectorAll('img.zy-slide-main').forEach(im=>{ if(im.complete && im.naturalWidth) zyRevealBg(im); });

  const pdpThumbsEl = document.getElementById('pdpThumbs');
  if(pdpThumbsEl){
    const pdpOrder = zyNormalizeMediaOrder(p.mediaOrder, pdpImgCount, pdpVideos.length);
    let _ti = 0, _tv = 0;
    pdpThumbsEl.innerHTML = pdpOrder.map((t, pos)=>{
      if(t === 'v'){
        const url = pdpVideos[_tv++];
        return `<button type="button" class="pdp-thumb pdp-thumb-video${pos===0?' active':''}" onclick="zyPdpGoToSlide(${pos})" aria-label="Ver video ${_tv}"><video src="${zyEscapeHtml(url)}#t=0.1" muted playsinline preload="metadata"></video><span class="pdp-thumb-play" aria-hidden="true">▶</span></button>`;
      }
      const i = _ti++;
      const img = p.images && p.images[i];
      return `<button type="button" class="pdp-thumb${pos===0?' active':''}" onclick="zyPdpGoToSlide(${pos})" aria-label="Ver foto ${i+1}">${img ? `<img src="${img}" srcset="${zyCdnSrcset(img)}" sizes="64px" alt="${zyEscapeHtml(p.brand+' '+p.name)} — foto ${i+1}" loading="lazy">` : `<span class="ph"></span>`}</button>`;
    }).join('');
  }

  const related = PRODUCTS.filter(x=>x.category===p.category && x.id!==p.id && (x.store||'zayde')===(p.store||'zayde')).sort(()=>0.5-seedRand(p.id+1)).slice(0,4);
  document.getElementById('pdpRelated').innerHTML = related.map(cardHTML).join('');
  zyRenderCompleteLook(p);
  const pdpRelatedViewAllEl = document.getElementById('pdpRelatedViewAll');
  if(pdpRelatedViewAllEl){
    pdpRelatedViewAllEl.onclick = function(e){ e.preventDefault(); navCatName(p.category); };
  }
  document.getElementById('pdpFavBtn').classList.toggle('faved', favorites.has(p.id));
  initSwipeGalleries();
  zyRenderReviews(p.id);
  zyRenderPriceHistory(p.id);
