function zyNorm(t){ return String(t||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim(); }
function zyMakeCombo(inputId, getItems, opts){
  opts = opts || {};
  const input = document.getElementById(inputId);
  if(!input || input.__combo) return;
  input.__combo = true;
  const wrap = document.createElement('div'); wrap.className = 'zy-combo';
  input.parentNode.insertBefore(wrap, input); wrap.appendChild(input);
  const list = document.createElement('div'); list.className = 'zy-combo-list'; wrap.appendChild(list);
  let items = [];
  function swatchOf(name){ if(!opts.swatch) return ''; const d = ZY_COLOR_DEFS.find(x=>x[0]===name); return d ? `<span class="zy-sw" style="background:${d[1]}"></span>` : ''; }
  function render(filter){
    const all = getItems();
    const q = zyNorm(filter);
    items = q ? all.filter(v=>zyNorm(v).includes(q)) : all.slice();
    const cur = input.value.trim();
    let html = `<div class="zy-combo-count">${items.length} ${items.length===1?'opción':'opciones'}${q?' para “'+zyEscapeHtml(filter.trim())+'”':''}</div>`;
    html += items.map(v=>`<div class="zy-combo-opt${v===cur?' sel':''}" data-v="${zyEscapeHtml(v)}">${swatchOf(v)}<span>${zyEscapeHtml(v)}</span></div>`).join('');
    if(!items.length) html += `<div class="zy-combo-empty">Sin resultados.</div>`;
    if(q && !all.some(v=>zyNorm(v)===q)) html += `<div class="zy-combo-opt" data-v="${zyEscapeHtml(filter.trim())}"><span>Usar “${zyEscapeHtml(filter.trim())}”</span></div>`;
    list.innerHTML = html;
  }
  function open(filter){ render(filter||''); wrap.classList.add('open'); }
  function close(){ wrap.classList.remove('open'); }
  input.addEventListener('focus', ()=>{ input.select(); open(''); });
  input.addEventListener('click', ()=>{ if(!wrap.classList.contains('open')) open(''); });
  input.addEventListener('input', ()=> open(input.value));
  input.addEventListener('keydown', e=>{
    if(e.key==='Escape'){ close(); input.blur(); }
    else if(e.key==='Enter'){ e.preventDefault(); const f = list.querySelector('.zy-combo-opt'); if(f && input.value.trim() && !items.includes(input.value.trim())){ input.value = f.dataset.v; } close(); }
  });
  list.addEventListener('mousedown', e=>{
    const o = e.target.closest('.zy-combo-opt'); if(!o) return;
    e.preventDefault(); input.value = o.dataset.v; close();
    input.dispatchEvent(new Event('change',{bubbles:true}));
  });
  input.addEventListener('blur', ()=> setTimeout(close, 120));
  input.__refresh = ()=>{ if(wrap.classList.contains('open')) render(input.value); };
}
