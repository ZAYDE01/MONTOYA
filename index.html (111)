    // Cinta manual: la definió el admin desde el panel, así que se respeta tal cual.
    tickHTML = zySettings.tickerItems.map(t=>`
      <div class="tick"><b>${t.brand}</b> ${t.name} <span class="price" style="color:#EDEBE4;">${fmt(t.price)}</span></div>`).join('');
  } else {
    const tickerItems = [...PRODUCTS].sort((a,b)=>b.views-a.views).slice(0,14);
    tickHTML = tickerItems.map(p=>`
      <div class="tick"><b>${p.brand}</b> ${p.name.split('"')[0]} <span class="price" style="color:#EDEBE4;">${fmt(p.price)}</span></div>`).join('');
  }
  document.getElementById('tickerTrack').innerHTML = tickHTML + tickHTML;
}

function updateCountdowns(){
  document.querySelectorAll('.up-countdown').forEach(el=>{
    const target = parseInt(el.dataset.release);
    const diff = Math.max(0, target - Date.now());
    const d = Math.floor(diff/86400000);
    const h = Math.floor((diff%86400000)/3600000);
    const m = Math.floor((diff%3600000)/60000);
    el.innerHTML = `<span>D<b>${String(d).padStart(2,'0')}</b></span><span>H<b>${String(h).padStart(2,'0')}</b></span><span>M<b>${String(m).padStart(2,'0')}</b></span>`;
  });
}
setInterval(updateCountdowns, 60000);

/* ================= [ZY-SORT] Menú "Ordenar por" =================
   Sustituye el <select> nativo por un botón + lista propios (ver CSS
   .zy-sort). El <select> original se queda oculto en el DOM y se
   mantiene sincronizado, así renderCatalog()/zgRenderCatalog() y
   cualquier otro código que lea "sortSelect"/"zgSortSelect".value
   siguen funcionando exactamente igual, sin tocar esa lógica. */
function zyToggleSortMenu(wrapId){
  document.querySelectorAll('.zy-sort.open').forEach(w=>{ if(w.id!==wrapId) w.classList.remove('open'); });
  const wrap = document.getElementById(wrapId);
  if(!wrap) return;
  const willOpen = !wrap.classList.contains('open');
  wrap.classList.toggle('open', willOpen);
  const btn = wrap.querySelector('.zy-sort-btn');
  if(btn) btn.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
}
function zyPickSort(wrapId, value, label){
  const wrap = document.getElementById(wrapId);
  if(!wrap) return;
  const sel = wrap.querySelector('select');
  const labelEl = wrap.querySelector('[id$="Label"]');
  if(labelEl) labelEl.textContent = label;
  wrap.querySelectorAll('.zy-sort-opt').forEach(o=>o.classList.toggle('active', o.dataset.value===value));
  wrap.classList.remove('open');
  if(sel){
    sel.value = value;
    sel.dispatchEvent(new Event('change'));
  }
}
document.addEventListener('click', function(e){
  if(!e.target.closest('.zy-sort')){
    document.querySelectorAll('.zy-sort.open').forEach(w=>{
      w.classList.remove('open');
      const btn = w.querySelector('.zy-sort-btn');
      if(btn) btn.setAttribute('aria-expanded','false');
    });
  }
});
document.addEventListener('keydown', function(e){
  if(e.key==='Escape') document.querySelectorAll('.zy-sort.open').forEach(w=>w.classList.remove('open'));
});

/* Cuenta regresiva real del aviso "Drop en vivo" del hero, editable desde
   el panel admin (pestaña "Drop & ticker"). Si ya pasó la fecha, se queda
   en 00:00:00 en vez de mostrar números negativos.
   [PEDIDO CLIENTE — v3] En cuanto el conteo llega a cero (o el admin lo
   fuerza con "DROP EN VIVO AHORA!"), pasan DOS cosas automáticamente:
   1) se manda el correo de aviso a todos los que se registraron (ver
      zyAutoNotifyDropLiveByEmail más abajo), para que entren al sitio a
      ver el en vivo; 2) en cuanto quien sea ya está DENTRO del sitio con
      el Drop en vivo, le aparece el popup "VER DROP EN VIVO" (ver
      zyMaybeShowDropLivePopup), que al tocarlo lo manda a Facebook. */
/* [PEDIDO CLIENTE] En cuanto el Drop pasa de "todavía no" a "en vivo"
   (llega a 00:00:00 o el admin lo fuerza con "DROP EN VIVO AHORA!") se
   manda automáticamente un correo a todos los que se registraron en el
   formulario "Avísenme del Drop en vivo" — usa la misma ruta
   /api/send-email (Gmail, GMAIL_USER/GMAIL_APP_PASSWORD en Vercel) que
   ya usa el botón manual "Avisar a todos por correo" del panel admin,
   así que no hace falta configurar nada aparte de lo que ya usa el sitio
   para los correos de pedidos.
   zyDropWasLive guarda el estado del segundo anterior: solo se dispara
   el aviso automático UNA vez, justo en el instante que cambia de
   false→true (no cada segundo mientras sigue en vivo). Si el admin
   cambia la fecha a una futura, isLive vuelve a false solo y el próximo
   "en vivo" real dispara el aviso otra vez. */
let zyDropWasLive = false;
function updateDropCountdown(){
  const el = document.getElementById('dropEyebrow');
  const elG = document.getElementById('dropEyebrowG');
  // [PEDIDO CLIENTE] Si nadie ha programado todavía una fecha real (ni
  // forzado el "DROP EN VIVO AHORA!"), el aviso del hero se queda oculto
  // por completo — no se cuenta ningún reloj de fábrica, no se muestra el
  // popup "VER DROP EN VIVO" y no se manda ningún correo automático.
  if(!zySettings.dropScheduled){
    if(el) el.style.display = 'none';
    if(elG) elG.style.display = 'none';
    if(zyDropWasLive) zyHideDropLivePopup(); // el admin pudo haber desprogramado el Drop con el popup ya abierto
    zyDropWasLive = false;
    return;
  }
  if(el) el.style.display = '';
  if(elG) elG.style.display = '';
  const diff = Math.max(0, zySettings.dropEndsAt - Date.now());
  const isLive = !!(zySettings.dropForceLive || diff <= 0);
  if(el || elG){
    const h = String(Math.floor(diff/3600000)).padStart(2,'0');
    const m = String(Math.floor((diff%3600000)/60000)).padStart(2,'0');
    const s = String(Math.floor((diff%60000)/1000)).padStart(2,'0');
    const txt = `${zySettings.dropText} · ${h}:${m}:${s}`;
    if(el) el.textContent = txt;
    if(elG) elG.textContent = txt;
  }
  // [PEDIDO CLIENTE] En cuanto el Drop está en vivo (llegó a cero o se
  // forzó), a quien ya esté DENTRO del sitio le aparece de inmediato el
  // recuadro "VER DROP EN VIVO" — no hace falta recargar la página.
  zyMaybeShowDropLivePopup(isLive);
  if(isLive && !zyDropWasLive){
    zyAutoNotifyDropLiveByEmail();
  }
  // [FIX — "le doy en apagar y no se apaga"] Si el Drop pasa de en vivo a
  // NO en vivo (el admin apaga "DROP EN VIVO AHORA!" o desprograma antes
  // de que la fecha real llegara), el recuadro "VER DROP EN VIVO" que ya
  // estaba abierto en pantalla no se cerraba solo — se quedaba ahí hasta
  // que la persona lo cerraba a mano. Ahora se oculta de inmediato apenas
  // isLive vuelve a false.
  if(!isLive && zyDropWasLive){
    zyHideDropLivePopup();
  }
  zyDropWasLive = isLive;
}
/* Prende/apaga zySettings.dropForceLive desde el botón "DROP EN VIVO
   AHORA!" del panel — fuerza el popup "VER DROP EN VIVO" a mostrarse de
   inmediato en el sitio, sin esperar a que la cuenta regresiva llegue a
   cero. Actualiza también el punto verde + texto de estado del panel. */
function zyToggleDropForceLive(){
  zySettings.dropForceLive = !zySettings.dropForceLive;
  // [PEDIDO CLIENTE] Forzar "DROP EN VIVO AHORA!" también cuenta como
  // programar el Drop — si el admin nunca guardó una fecha pero usa este
  // botón, el aviso/recuadro debe poder mostrarse igual, no quedarse oculto.
  if(zySettings.dropForceLive){
    zySettings.dropScheduled = true;
  } else {
    // [FIX — "le doy en apagar y no se apaga"] Si la fecha programada
    // (zySettings.dropEndsAt) ya quedó en el pasado, apagar SOLO el
    // forzado no alcanza: isLive sigue dando true porque la cuenta llegó
    // a cero, y el botón "Apagar" parecía no hacer nada. Al apagar el
    // forzado con la fecha ya vencida, se desprograma el Drop por
    // completo (vuelve a ocultarse hasta que el admin guarde una fecha
    // nueva a futuro) — así "Apagar" sí apaga de verdad.
    if(zySettings.dropEndsAt <= Date.now()) zySettings.dropScheduled = false;
  }
  AdminStore.set('zayde:admin:homeSettings', zySettings);
  zyRenderLiveToggleUI();
  updateDropCountdown();
  showToast(zySettings.dropForceLive ? 'Drop en vivo activado' : 'Drop en vivo desactivado');
}
function zyRenderLiveToggleUI(){
  const dot = document.getElementById('zyLiveDot');
  const label = document.getElementById('zyLiveToggleLabel');
  const btn = document.getElementById('zyLiveToggleBtn');
  if(!dot || !label || !btn) return;
  const on = !!zySettings.dropForceLive;
  // [FIX] Antes este punto/etiqueta solo reflejaba el interruptor manual
  // (dropForceLive), así que si el Drop estaba "en vivo" por la cuenta
  // regresiva real (o atorado por una fecha vieja) el panel seguía
  // mostrando "apagado" y confundía al admin. Ahora muestra el estado
  // REAL (isLive de verdad), calculado igual que updateDropCountdown().
  const diff = zySettings.dropScheduled ? Math.max(0, zySettings.dropEndsAt - Date.now()) : Infinity;
  const isLive = !!(zySettings.dropScheduled && (zySettings.dropForceLive || diff <= 0));
  dot.classList.toggle('zy-live-dot-on', isLive);
  btn.classList.toggle('zy-live-btn-on', isLive);
  if(!zySettings.dropScheduled){
    label.textContent = 'En vivo: no — todavía no hay fecha programada';
  } else if(isLive){
    label.textContent = on ? 'En vivo: SÍ (forzado a mano)' : 'En vivo: SÍ (la cuenta ya llegó a cero)';
  } else {
    label.textContent = 'En vivo: no — esperando la cuenta regresiva';
  }
  btn.textContent = on ? 'Apagar drop en vivo' : 'DROP EN VIVO AHORA!';
}
