  const thumbsEl = document.getElementById('reviewThumbs'); if(thumbsEl) thumbsEl.innerHTML = '';

  listEl.innerHTML = `<div class="reviews-empty">Cargando reseñas…</div>`;
  const barsEl = document.getElementById('reviewsBars');
  if(barsEl) barsEl.innerHTML = '';
