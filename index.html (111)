/* ================= [FILTRO PRO · estilo Palacio de Hierro] =================
   Un mismo componente para ZAYDE (catálogo) y ZAYDE G (Explorar catálogo):
   secciones plegables, buscador propio en cada sección, conteos, y botones
   "Aplicar filtro" / "Limpiar filtro". Los cambios se hacen en un estado
   pendiente (pend) y solo se aplican al pulsar "Aplicar filtro". */
const ZFP_SETS=['cats','brands','sizes','colors','genders','ropaGroups','materials','occasions','styles','line'];
const ZFP_FACETS=[
 ['cats','Categoría',p=>p.category],
 ['brands','Marca',p=>p.brand],
 ['sizes','Talla / Tamaño',p=>zyFilterSizeVals(p),'chip'],
 ['colors','Color',p=>p.color],
 ['genders','Género',p=>p.gender],
 ['ropaGroups','Sección de ropa',p=>p.category==='Ropa'?zyRopaGroupOf(p):null],
 ['materials','Material',p=>p.material],
 ['occasions','Ocasión',p=>p.occasion],
 ['styles','Estilo',p=>p.style],
 ['line','Línea',p=>p.line]
];
const ZFP_OPEN={};
const ZFP={};
function zfpCopy(F){const c={};ZFP_SETS.forEach(k=>c[k]=new Set((F&&F[k])||[]));c.pMin=(F&&F.pMin!=null)?F.pMin:null;c.pMax=(F&&F.pMax!=null)?F.pMax:null;c.disc=(F&&F.disc)||0;return c;}
function zfpLab(k,v){return k==='ropaGroups'?((ZY_ROPA_GROUPS.find(g=>g.key===v)||{}).label||v):v;}
function zfpIsRopa(P){return P.cats.size===1&&P.cats.has('Ropa');}
function zfpMatch(F,p){
  for(const f of ZFP_FACETS){const k=f[0]; if(F[k]&&F[k].size){ if(k==='ropaGroups'&&!zfpIsRopa(F)) continue; const v=[].concat(f[2](p)).map(String); if(!v.some(x=>F[k].has(x))) return false; }}
  if(F.pMin!=null&&p.price<F.pMin) return false;
  if(F.pMax!=null&&p.price>F.pMax) return false;
  if(F.disc&&(p.discountPct||0)<F.disc) return false;
  return true;
}
function zfpRender(c){
  const root=document.getElementById(c.mount); if(!root) return;
  const P=c.pend, pool=c.pool();
  const scope=P.cats.size?pool.filter(p=>P.cats.has(p.category)):pool;
  const chev='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M6 9l6 6 6-6"/></svg>';
  let h='<div class="zfp-top"><b>Filtrar</b><span class="zy-hint" id="'+c.id+'Cnt"></span></div><div class="zfp-body">';
  ZFP_FACETS.forEach(f=>{
    const k=f[0], title=f[1], kind=f[3];
    if(k==='ropaGroups'&&!zfpIsRopa(P)) return;
    const m=new Map();
    (k==='cats'?pool:scope).forEach(p=>{[].concat(f[2](p)).forEach(v=>{if(v!=null&&v!=='')m.set(String(v),(m.get(String(v))||0)+1);});});
    P[k].forEach(v=>{if(!m.has(v))m.set(v,0);});
    if(!m.size) return;
    const items=[...m].sort((a,b)=>String(zfpLab(k,a[0])).localeCompare(String(zfpLab(k,b[0])),'es',{numeric:true}));
    const open=ZFP_OPEN[c.id+k]!==undefined?ZFP_OPEN[c.id+k]:['cats','brands','sizes'].includes(k);
    h+=`<section class="zfp-sec ${open?'open':''}"><button type="button" class="zfp-h" onclick="zfpTog('${c.id}','${k}',this)"><span>${title}</span>${P[k].size?`<em>${P[k].size}</em>`:''}${chev}</button><div class="zfp-c"><div class="zfp-s"><input type="search" placeholder="Buscar ${title.toLowerCase()}…" oninput="zfpQ(this)" aria-label="Buscar en ${title}"></div><div class="zfp-l ${kind==='chip'?'zfp-chips':''}">`+
      items.map(([v,n])=>`<label class="filter-opt" data-t="${zyEscapeHtml(normText(zfpLab(k,v)))}"><input type="checkbox" data-v="${zyEscapeHtml(v)}" ${P[k].has(v)?'checked':''} onchange="zfpPick('${c.id}','${k}',this)">${zyMxLabHtml(zfpLab(k,v))}<span class="zfp-n">(${n})</span></label>`).join('')+
      `<div class="zfp-e" hidden>Sin resultados</div></div></div></section>`;
  });
  const po=ZFP_OPEN[c.id+'price'];
  h+=`<section class="zfp-sec ${po!==false?'open':''}"><button type="button" class="zfp-h" onclick="zfpTog('${c.id}','price',this)"><span>Precio</span>${(P.pMin!=null||P.pMax!=null)?'<em>1</em>':''}${chev}</button><div class="zfp-c"><div class="zfp-price"><input type="number" min="0" inputmode="numeric" placeholder="Mín $" value="${P.pMin!=null?P.pMin:''}" oninput="zfpPrice('${c.id}','pMin',this)" aria-label="Precio mínimo"><span>–</span><input type="number" min="0" inputmode="numeric" placeholder="Máx $" value="${P.pMax!=null?P.pMax:''}" oninput="zfpPrice('${c.id}','pMax',this)" aria-label="Precio máximo"></div></div></section>`;
  const dobj=ZFP_OPEN[c.id+'disc'];
  h+=`<section class="zfp-sec ${dobj?'open':''}"><button type="button" class="zfp-h" onclick="zfpTog('${c.id}','disc',this)"><span>Descuento</span>${P.disc?'<em>1</em>':''}${chev}</button><div class="zfp-c"><div class="zfp-l">`+
    [10,20,30,50].map(d=>`<label class="filter-opt"><input type="radio" name="${c.id}disc" ${P.disc===d?'checked':''} onclick="zfpDisc('${c.id}',${d},this)">${d}% o más</label>`).join('')+`</div></div></section>`;
  h+=`</div><div class="zfp-act"><button type="button" class="btn btn-ghost" onclick="zfpClear('${c.id}')">Limpiar filtro</button><button type="button" class="btn btn-primary" id="${c.id}Ap" onclick="zfpApply('${c.id}')">Aplicar filtro</button></div>`;
  root.innerHTML='<div class="zfp">'+h+'</div>';
  zfpBadge(c);
}
function zfpN(P){let n=P.disc?1:0; if(P.pMin!=null||P.pMax!=null)n++; ZFP_SETS.forEach(k=>n+=P[k].size); return n;}
function zfpBadge(c){const b=document.getElementById(c.id+'Ap'); if(b){const n=zfpN(c.pend); b.textContent=n?`Aplicar filtro (${n})`:'Aplicar filtro';}}
function zfpTog(id,k,btn){const s=btn.parentNode; s.classList.toggle('open'); ZFP_OPEN[id+k]=s.classList.contains('open');}
function zfpQ(inp){
  const q=normText(inp.value.trim()), box=inp.closest('.zfp-c'); let any=0;
  box.querySelectorAll('.filter-opt').forEach(l=>{const ok=!q||l.dataset.t.includes(q); l.style.display=ok?'':'none'; if(ok)any++;});
  box.querySelector('.zfp-e').hidden=any>0;
}
function zfpPick(id,k,el){const c=ZFP[id], s=c.pend[k], v=el.dataset.v; if(el.checked)s.add(v); else s.delete(v);
  if(k==='cats'){zfpRender(c); return;}
  zfpBadge(c);}
function zfpPrice(id,k,el){const c=ZFP[id], v=parseInt(el.value,10); c.pend[k]=isNaN(v)?null:Math.max(0,v); zfpBadge(c);}
function zfpDisc(id,d,el){const c=ZFP[id]; if(c.pend.disc===d){c.pend.disc=0; el.checked=false;} else c.pend.disc=d; zfpBadge(c);}
function zfpApply(id){
  const c=ZFP[id], P=c.pend;
  if(P.pMin!=null&&P.pMax!=null&&P.pMin>P.pMax){const x=P.pMin;P.pMin=P.pMax;P.pMax=x;}
  if(!zfpIsRopa(P)) P.ropaGroups.clear();
  c.commit(P); c.refresh();
  document.getElementById(c.aside).classList.remove('open');
  if(c.scroll) c.scroll();
}
function zfpClear(id){const c=ZFP[id]; c.clear(); document.getElementById(c.aside).classList.remove('open');}
function zfpChips(c){
  const el=document.getElementById(c.chips); if(!el) return;
  const F=c.F(), o=[];
  const add=(k,v,l)=>o.push(`<button type="button" class="zfp-chip" data-k="${k}" data-v="${zyEscapeHtml(v)}" onclick="zfpDrop('${c.id}',this)">${zyEscapeHtml(l)} ✕</button>`);
  ZFP_FACETS.forEach(f=>{ if(f[0]==='ropaGroups'&&!zfpIsRopa(F)) return; (F[f[0]]||[]).forEach(v=>add(f[0],v,f[1]+': '+zfpLab(f[0],v)));});
  if(F.pMin!=null||F.pMax!=null) add('price','', 'Precio: '+(F.pMin!=null?'$'+F.pMin.toLocaleString():'$0')+' – '+(F.pMax!=null?'$'+F.pMax.toLocaleString():'sin límite'));
  if(F.disc) add('disc','', 'Descuento: '+F.disc+'% o más');
  el.innerHTML=o.length?o.join('')+`<button type="button" class="zfp-chip all" onclick="zfpClear('${c.id}')">Limpiar todo</button>`:'';
}
function zfpDrop(id,btn){
  const c=ZFP[id], F=c.F(), k=btn.dataset.k;
  if(k==='price'){F.pMin=null;F.pMax=null;} else if(k==='disc'){F.disc=0;} else F[k].delete(btn.dataset.v);
  c.refresh();
}
