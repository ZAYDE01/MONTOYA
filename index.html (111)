}
function removeFromCart(idx){
  // [FIX "se queda congelada la sección al eliminar del carrito"] Antes, si
  // CUALQUIER paso de aquí abajo (renderCart, persistCart, o sobre todo
  // zyRenderClubTiers — que depende de que la página del Club ya se haya
  // pintado antes) lanzaba un error a la mitad, la función se detenía ahí
  // mismo y nunca llegaba a la línea de zySyncScrollLock() de al final. El
  // candado de scroll se podía quedar trabado (o cualquier otro estado a
  // medio limpiar) y el resto del sitio dejaba de responder a clics, aunque
  // visualmente el producto ya hubiera desaparecido del carrito. Ahora todo
  // el cuerpo va en try/catch, y el aviso de "sincroniza candado de scroll"
  // vive en un finally: pase lo que pase (éxito o un error a medias), la
  // página nunca puede quedar congelada por esta acción.
  //
  // [FIX "se queda TODO bugueado en el celular tras tocar el bote de
  // basura, y ningún otro botón responde después"] Esto es un bug conocido
  // de Safari/iOS (y de algunos WebView de Android): si el elemento que
  // acabas de TOCAR se elimina del DOM de forma síncrona, dentro de ese
  // mismo evento de touch/click (que es justo lo que hacía renderCart():
  // reescribía cartItems.innerHTML y con eso borraba el propio botón que
  // el dedo seguía tocando), el sistema de touch del navegador se puede
  // quedar "atorado" y deja de mandar taps al resto de la página hasta que
  // el usuario toca en otro lado o hace scroll — se ve exactamente como
  // "todo se congeló". Por eso ahora el repintado (renderCart/persistCart/
  // zyRenderClubTiers) se difiere con setTimeout(...,0): se ejecuta recién
  // el navegador terminó de procesar el toque, no a mitad de él.
  try{
    const wasMembership = cart[idx] && cart[idx].isMembership;
    cart.splice(idx,1);
    setTimeout(function(){
      try{ renderCart(); }catch(e){ console.error('removeFromCart: renderCart falló', e); }
      try{ persistCart(); }catch(e){ console.error('removeFromCart: persistCart falló', e); }
      if(wasMembership){
        try{ zyRenderClubTiers(); }catch(e){ console.error('removeFromCart: zyRenderClubTiers falló', e); } // re-habilita el botón "Unirme" del nivel quitado
      }
      if(window.zySyncScrollLock) window.zySyncScrollLock();
    }, 0);
  }catch(e){
    console.error('removeFromCart: error inesperado al quitar del carrito', e);
    showToast('Se quitó el producto, pero hubo un detalle al actualizar la vista', true);
  }finally{
    // Se ejecuta SIEMPRE, incluso si algo de arriba falló: nunca deja el
    // scroll/los clics del sitio trabados por esta acción.
    if(window.zySyncScrollLock) window.zySyncScrollLock();
  }
}
/* [BOLSA — CANTIDAD] Selector de cantidad en la propia página de la
   Bolsa (como el "Cant. 1 ⌄" de la app de Nike). Solo aplica a piezas
   físicas — las membresías y tarjetas de regalo siempre son cantidad 1. */
function zyChangeCartQty(idx, newQty){
  // [FIX "se queda congelada la sección"] Mismo refuerzo que removeFromCart:
  // todo el cuerpo protegido, y renderCart()/persistCart() nunca pueden
  // dejar la página a medio actualizar si algo falla.
  try{
    newQty = parseInt(newQty, 10);
    if(!cart[idx]) return;
    if(!newQty || newQty < 1){ removeFromCart(idx); return; }
    const c = cart[idx];
    // [FIX — última unidad] Tope la cantidad elegida en la Bolsa al stock
    // real de esa talla, para que nunca se pueda dejar en el carrito (y
    // mucho menos pagar) más piezas de las que en verdad existen.
    if(!zyIsDigitalItem(c)){
      const p = PRODUCTS.find(x=>x.id===c.id);
      const stockForSize = zyStockForSize(p, c.size);
      if(newQty > stockForSize){
        newQty = Math.max(1, stockForSize);
        showToast(`Solo queda${stockForSize===1?'':'n'} ${stockForSize} unidad${stockForSize===1?'':'es'} de esta talla`, true);
      }
    }
    cart[idx].qty = newQty;
    // [FIX "se queda TODO bugueado en el celular"] Mismo motivo que en
    // removeFromCart: los botones +/- que se acaban de tocar se reescriben
    // dentro de renderCart(), así que el repintado se difiere con
    // setTimeout(...,0) para no tocar el DOM del botón a mitad del propio
    // evento de touch en iOS/Android.
    setTimeout(function(){
      try{ renderCart(); }catch(e){ console.error('zyChangeCartQty: renderCart falló', e); }
      try{ persistCart(); }catch(e){ console.error('zyChangeCartQty: persistCart falló', e); }
      if(window.zySyncScrollLock) window.zySyncScrollLock();
    }, 0);
  }catch(e){
    console.error('zyChangeCartQty: error inesperado', e);
  }finally{
    if(window.zySyncScrollLock) window.zySyncScrollLock();
  }
}
// Ítems digitales: membresías Y tarjetas de regalo. Ambos se pagan al
// instante con tarjeta (sin dirección de envío) — ver zyToggleDigitalCheckoutUI().
function zyIsDigitalItem(c){ return !!(c && (c.isMembership || c.isGiftCard)); }
// Subtotal de solo productos físicos (zapatos, ropa, etc). Las membresías y
// tarjetas de regalo no cuentan para desbloquear el envío gratis, ya que no
// se envían — ver zyToggleDigitalCheckoutUI() y computeShippingCost().
function zyPhysicalSubtotal(){
  return cart.reduce((a,c)=>a+(zyIsDigitalItem(c) ? 0 : c.price*c.qty),0);
}
function renderCart(){
 // [FIX "se queda congelada la sección"] Todo el cuerpo de renderCart va
 // protegido: si algo inesperado truena a la mitad del repintado (un
 // producto que ya no existe en PRODUCTS, un elemento del DOM que todavía
 // no existe, etc.), ya no deja el candado de scroll ni la interacción del
 // resto del sitio a medias — se registra el error en consola y se sigue.
 try{
  // [FIX — última unidad] Corrige de una vez cualquier carrito que ya
  // traiga más piezas de una talla que las que en verdad hay en stock
  // (por ejemplo, si se agregó antes de este arreglo, o si el stock bajó
  // mientras el producto seguía en el carrito).
  let zyCartAutoAdjusted = false;
  cart.forEach(c=>{
    if(zyIsDigitalItem(c)) return;
    const p = PRODUCTS.find(x=>x.id===c.id);
    const stockForSize = zyStockForSize(p, c.size);
    if(isFinite(stockForSize) && c.qty > Math.max(0, stockForSize)){
      c.qty = Math.max(0, stockForSize);
      zyCartAutoAdjusted = true;
    }
  });
  if(zyCartAutoAdjusted){
    const before = cart.length;
    cart = cart.filter(c=>zyIsDigitalItem(c) || c.qty>0);
    if(cart.length!==before) showToast('Ajustamos tu carrito: una pieza ya no tenía stock suficiente', true);
    persistCart();
  }
  const count = cart.reduce((a,c)=>a+c.qty,0);
  const badge = document.getElementById('cartCount');
  badge.textContent = count;
  badge.style.display = count>0 ? 'flex' : 'none';
  const badgeMobile = document.getElementById('cartCountMobile');
  if(badgeMobile){ badgeMobile.textContent = count; badgeMobile.style.display = count>0 ? 'flex' : 'none'; }

  const itemsEl = document.getElementById('cartItems');
  if(!cart.length){
    itemsEl.innerHTML = `<div class="cart-empty"><p>Tu carrito está vacío.<br>Explora el catálogo y encuentra tu próxima pieza.</p><button type="button" class="btn btn-primary btn-pill-solid" onclick="navigate('catalog')">Ver catálogo</button></div>`;
  } else {
    itemsEl.innerHTML = cart.map((c,i)=>{
      if(c.isMembership){
        // Ítem digital (membresía ZAYDE Club): sin talla, sin producto real
        // que buscar en PRODUCTS, y con un ícono propio en vez de foto.
        // [FIX] El recuadro del ícono ya tenía fondo (.ci-img-membership,
        // azul), pero era el MISMO para cualquier nivel — "Icon" e "Icon
        // Black" se veían idénticos en el carrito. Ahora "Icon Black" usa
        // un fondo oscuro propio (ci-img-membership-black), acorde a su
        // nombre, y el resto de los niveles conserva el azul de siempre.
        const isBlackTier = /black/i.test(c.tierName || '');
        return `
        <div class="cart-item" onclick="closeCart();navigate('club');return false;" style="cursor:pointer;">
          <button class="ci-delete" onclick="event.stopPropagation(); removeFromCart(${i})" aria-label="Quitar del carrito">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
          </button>
          <div class="ci-img ci-img-membership${isBlackTier ? ' ci-img-membership-black' : ''}">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2l2.9 6.3L22 9l-5 5.1L18.2 22 12 18.4 5.8 22 7 14.1 2 9l7.1-.7L12 2z"/></svg>
          </div>
          <div class="ci-info">
            <div class="ci-name">${c.brand} — ${c.name}</div>
            <div class="ci-meta">Membresía digital · Se activa al pagar</div>
            <div class="ci-price mono">${fmt(c.price*c.qty)}</div>
          </div>
        </div>`;
      }
      if(c.isGiftCard){
        // Ítem digital (tarjeta de regalo): igual que la membresía, sin
        // talla ni producto real — ícono propio y se genera/envía al pagar.
        return `
        <div class="cart-item" onclick="closeCart();navigate('giftcard');return false;" style="cursor:pointer;">
          <button class="ci-delete" onclick="event.stopPropagation(); removeFromCart(${i})" aria-label="Quitar del carrito">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
          </button>
          <div class="ci-img ci-img-giftcard"></div>
          <div class="ci-info">
            <div class="ci-name">${c.name}</div>
            <div class="ci-meta">Tarjeta de regalo digital · Para ${c.giftEmail}</div>
            <div class="ci-price mono">${fmt(c.price*c.qty)}</div>
          </div>
        </div>`;
      }
      const p = PRODUCTS.find(x=>x.id===c.id);
      const realImg = p && p.images && p.images[0];
      // [FIX — última unidad] El selector de cantidad ya no ofrece siempre
      // 1–8: se topa al stock real de esa talla, así nunca se puede elegir
      // (ni mucho menos pagar) más piezas de las que existen. Si el stock
      // bajó por debajo de lo que ya había en el carrito (ej. alguien más
      // compró mientras tanto), la cantidad visible también se ajusta sola.
      const stockForSize = zyStockForSize(p, c.size);
      const maxQtyOption = Math.max(1, Math.min(8, isFinite(stockForSize) ? stockForSize : 8));
      const qtyOptions = Array.from({length:maxQtyOption}, (_,k)=>k+1);
      const lowStockNote = isFinite(stockForSize) && stockForSize<=3 ? `<span class="ci-qty-low">${stockForSize===1?'Última unidad':'Quedan '+stockForSize}</span>` : '';
      return `
      <div class="cart-item" onclick="openCartItem(${c.id})" style="cursor:pointer;">
        <button class="ci-delete" onclick="event.stopPropagation(); removeFromCart(${i})" aria-label="Quitar del carrito">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
        </button>
        <div class="ci-img${realImg ? '' : ' is-fallback'}" id="ciImg${i}">${realImg ? `<img src="${realImg}" alt="${c.name}" onerror="document.getElementById('ciImg${i}').classList.add('is-fallback'); this.remove();">` : ''}</div>
        <div class="ci-info">
          <div class="ci-name">${c.brand} — ${c.name}</div>
          <div class="ci-meta">Talla ${zyTallaTxt(zyProdById(c.id),c.size)} ${lowStockNote}</div>
          <div class="ci-qty" onclick="event.stopPropagation()">Cant.
            <div class="qty-stepper">
              <button type="button" class="qty-stepper-btn" onclick="event.stopPropagation(); zyChangeCartQty(${i}, ${c.qty-1})" ${c.qty<=1?'disabled':''} aria-label="Reducir cantidad">−</button>
              <span class="qty-stepper-val">${c.qty}</span>
              <button type="button" class="qty-stepper-btn" onclick="event.stopPropagation(); zyChangeCartQty(${i}, ${c.qty+1})" ${c.qty>=maxQtyOption?'disabled':''} aria-label="Aumentar cantidad">+</button>
            </div>
          </div>
          <div class="ci-price mono">${fmt(c.price*c.qty)}</div>
        </div>
      </div>`;
    }).join('');
  }
  const subtotal = cart.reduce((a,c)=>a+c.price*c.qty,0);
  const discount = zyCouponDiscount(subtotal);
  document.getElementById('cartSubtotal').textContent = fmt(subtotal);
  {
    const gUsed = zyGiftToUse(Math.max(0, subtotal - discount));
    const setRow = (rowId, lineId, show, txt)=>{ const r=document.getElementById(rowId), l=document.getElementById(lineId); if(r) r.style.display = show ? 'flex' : 'none'; if(l) l.textContent = txt; };
    setRow('cartDiscountRow','cartDiscountLine', discount>0, '-'+fmt(discount));
    setRow('cartGiftRow','cartGiftLine', gUsed>0, '-'+fmt(gUsed));
    setRow('cartTotalRow','cartTotalLine', discount>0 || gUsed>0, fmt(Math.max(0, subtotal - discount - gUsed)));
  }

  /* ---- barra de envío gratis ($1,800 MXN) — solo cuenta productos físicos,
     las membresías y tarjetas de regalo no se envían ---- */
  const physicalSubtotal = zyPhysicalSubtotal();
  const shipThr = zyFreeShipThreshold();
  const memAlways = zyMembershipHasFreeShipping() && shipThr === 0;
  const remain = Math.max(0, shipThr - physicalSubtotal);
  const pct = shipThr > 0 ? Math.min(100, Math.round((physicalSubtotal/shipThr)*100)) : 100;
  const textEl = document.getElementById('shipProgressText');
  const fillEl = document.getElementById('shipProgressFill');
  if(textEl && fillEl){
    // [MEMBRESÍAS-ENVÍO] Si la cuenta tiene un nivel de pago (Icon/Icon
    // Black), el envío ya es gratis sin importar el monto — mostrar la
    // barra de "te faltan $X" aquí sería confuso/falso para ese cliente.
    if(memAlways) textEl.innerHTML = `Envío gratis en todos tus pedidos · Miembro ${zyEscapeHtml(currentMembership.tier)}`;
    else if(physicalSubtotal<=0) textEl.innerHTML = `Agrega productos para desbloquear <b>envío gratis</b> desde ${fmt(shipThr)}`;
    else if(remain>0) textEl.innerHTML = `Estás a <b>${fmt(remain)}</b> de obtener envío gratis`;
    else textEl.innerHTML = `Envío gratis desbloqueado`;
    fillEl.style.width = memAlways ? '100%' : pct+'%';
    fillEl.classList.toggle('full', memAlways || (remain<=0 && physicalSubtotal>0));
  }

  /* ---- código / tarjeta aplicados (carrito y PAGO) ---- */
  zyRenderAppliedCodes();
 }catch(e){
  console.error('renderCart: error inesperado al repintar el carrito', e);
 }finally{
  if(window.zySyncScrollLock) window.zySyncScrollLock();
 }
}
function zyCouponDiscount(subtotal){
  if(!zyCoupon) return 0;
  if(zyCoupon.type==='pct') return Math.round(subtotal * zyCoupon.value/100);
  if(zyCoupon.type==='fixed') return Math.min(subtotal, zyCoupon.value);
  return 0;
}
async function zyApplyCoupon(){
  const input = document.getElementById('cartCouponInput');
  const code = input.value.trim().toUpperCase();
  if(!code){ showToast('Escribe un código', true); return; }
  const c = zyCouponsData[code];
  if(!c){ showToast('Ese código no es válido', true); return; }
  // [CUPONES DE UN SOLO USO] En cuanto alguien lo canjea una vez (ver el
  // checkout, donde se marca c.redeemed=true al confirmar el pedido), el
  // código deja de funcionar para siempre — sin importar quién lo intente.
  if(c.singleUse && c.redeemed){ showToast('Este cupón ya fue utilizado y ya no está disponible', true); return; }
  zyCoupon = { code, ...c };
  await Store.set('zayde:coupon:'+userKey(), zyCoupon);
  input.value = '';
  renderCart();
  showToast(`Código ${code} aplicado`);
}
/* [CUPONES DE UN SOLO USO] Se llama al confirmar un pedido (cualquier
   método de pago). Si el cupón usado está marcado como singleUse, lo
   desactiva de inmediato para TODO MUNDO — no solo para quien acaba de
   comprar — guardando el cambio en AdminStore para que quede así aunque
   se recargue la página o lo intente otra persona desde otro dispositivo. */
async function zyRedeemCouponIfSingleUse(code, orderNum){
  const c = zyCouponsData[code];
  if(!c || !c.singleUse || c.redeemed) return;
  c.redeemed = true;
  c.redeemedAt = Date.now();
  c.redeemedOrderNum = orderNum || null;
  try{ await AdminStore.set('zayde:admin:coupons', zyCouponsData); }catch(e){ console.error('No se pudo marcar el cupón como canjeado:', e); }
}
async function zyRemoveCoupon(){
  zyCoupon = null;
  await Store.set('zayde:coupon:'+userKey(), null);
  renderCart();
  if(typeof updateCheckoutTotals==='function') updateCheckoutTotals();
}
/* [BOLSA — SECCIÓN PROPIA] El carrito ya no es un panel/ventana encima
   del sitio: es su propia página (como la Bolsa de la app de Nike), así
   que abrirlo es simplemente navegar a ella. closeCart() se deja como
   función vacía (no como no-op peligroso) porque muchas partes del código
   la llaman justo antes de navegar a otra página (ej. closeCart();navigate('club')) —
   con el sistema de páginas, navigate() ya se encarga de ocultar/mostrar. */
function openCart(){ navigate('cart'); }
/* [BOLETÍN DE PIE DE PÁGINA] Guarda el correo en newsletterSubscribers con id propio ("footer:") para no gastar el cupón BIENVENIDO10 */
async function zyNewsSubscribe(){
  const el = document.getElementById('zyNewsEmail'); if(!el) return;
  const email = (el.value||'').trim();
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)){ showToast('Escribe un correo válido', true); return; }
  try{
    if(db) await db.collection('newsletterSubscribers').doc('footer:'+encodeURIComponent(email.toLowerCase())).set({ email, source:'footer', date: Date.now() }, { merge:true });
    el.value=''; showToast('¡Gracias! Ya estás registrado');
  }catch(e){ console.error(e); showToast('No pudimos registrarte, intenta de nuevo', true); }
}

