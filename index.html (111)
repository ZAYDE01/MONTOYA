/* [HOME-FEED-MOVIL] Arma el feed del inicio en celular: alterna un
   recuadro de publicidad con una fila de 2 productos reales, 3 veces.
   Publicidad: usa primero las Vitrinas reales (panel privado); si faltan,
   completa con categorías reales del catálogo, alternando "Ver más" y
   "Comprar" como texto del botón. Productos: mismos criterios que ya usa
   el resto del inicio (más vendidos, recién llegados, en tendencia), solo
   que aquí se muestran 2 por fila en vez de una fila larga con scroll. */
function zyRenderHomeFeedMobile(){
  const wrap = document.getElementById('grid-home-feed-mobile');
  if(!wrap) return;
  const realAds = (zyPromoBanners||[]).filter(b=>b.store!=='clothesg' && b.visible!==false && zyPromoSlides(b).length).slice(0,3);
  const ads = realAds.map(b=>({
    img: (zyPromoSlides(b)[0]||{}).url,
    tag: b.tag || 'ZAYDE',
    title: b.title,
    desc: b.desc,
    cta: b.ctaLabel || 'Ver más',
    onclick: `navCatName('${(b.ctaCat||'').replace(/'/g,"\\'")}')`
  }));
  const fallbackLabels = ['Ver más','Comprar','Ver más'];
  const fallbackDescs = {
    default: 'Piezas verificadas, listas para enviarse.'
  };
  let ci = 0, guard = 0;
  while(ads.length < 3 && CATS.length && guard < 20){
    const cat = CATS[ci % CATS.length];
    const items = zyBrowsable().filter(p=>p.category===cat).sort((a,b)=>b.views-a.views);
    const pick = items[0];
    const img = zyCategoryImages[cat] || (pick && pick.images && pick.images[0]);
    ads.push({
      img,
      tag: cat.toUpperCase(),
      title: `Descubre ${cat}`,
      desc: fallbackDescs.default,
      cta: fallbackLabels[ads.length % fallbackLabels.length],
      onclick: `navCatName('${cat.replace(/'/g,"\\'")}')`
    });
    ci++; guard++;
  }
  const bySeed = [...zyBrowsable()].sort((a,b)=>b.views-a.views);
  const groups = [
    zyPickSection('bestsellers',2,()=>bySeed.slice(0,2)),
    zyPickSection('new',2,()=>[...zyBrowsable()].slice(-2)),
    zyPickSection('trending',2,()=>zyBrowsable().filter(p=>p.trend==='up').slice(0,2))
  ];
  let html = '';
  ads.forEach((ad,i)=>{
    html += zyHomeFeedAdHTML(ad);
    if(groups[i] && groups[i].length) html += `<div class="hf-products">${groups[i].map(cardHTML).join('')}</div>`;
  });
  wrap.innerHTML = html;
  initSwipeGalleries();
}
/* ============================================================
   [HOME-VITRINAS-HERO] Estado y funciones del carrusel de publicidad a
   pantalla completa del inicio (ver CSS .vh-*). Cada vitrina visible se
   dibuja como una diapositiva de ancho completo: video si el admin
   cargó uno (se reproduce solo, sin sonido, en bucle), o si no la
   primera foto. Debajo va el título/descripción/botón en un bloque
   blanco, y abajo a la derecha los controles: pausa, puntitos y
   flechas — igual que el carrusel de la home de Nike.
   ============================================================ */
let zyVh = { slides: [], index: 0, playing: true, timer: null };

/* Arma el HTML del fondo (foto o video) de una diapositiva. Prioriza el
   video si el admin cargó uno; si no reconoce el enlace de video, cae
   de vuelta a la primera foto para nunca dejar la diapositiva vacía. */
function zyVhMediaHTML(b){
  const firstImg = (b.images && b.images[0]) || '';
  const url = (b.videoUrl||'').trim();
  if(url){
    const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|shorts\/|embed\/))([\w-]{6,})/);
    if(yt){
      return `<iframe src="https://www.youtube.com/embed/${yt[1]}?autoplay=1&mute=1&loop=1&playlist=${yt[1]}&controls=0&playsinline=1&modestbranding=1&rel=0" allow="autoplay; encrypted-media" loading="lazy"></iframe>`;
    }
    if(/\.(mp4|webm|mov)(\?|$)/i.test(url) || url.startsWith('data:video')){
      return `<video src="${zyEscapeHtml(url)}" autoplay muted loop playsinline poster="${zyEscapeHtml(firstImg)}"></video>`;
    }
  }
  if(firstImg) return `<img src="${firstImg}" alt="${zyEscapeHtml(b.title||'ZAYDE')}" loading="lazy" decoding="async">`;
  return '';
}
function zyVhSlideHTML(b, i){
  const media = zyVhMediaHTML(b);
  if(!media) return '';
  // [ZG-VITRINAS-HERO] Igual que zyPromoCardHTML: si la vitrina es de
  // ZAYDE G, el botón manda a zgSelectLine() (filtro dentro de ZAYDE G)
  // en vez de navCatName() (catálogo de ZAYDE) — así esta misma función
  // se reutiliza para armar el carrusel de ambas tiendas.
  const ctaOnclick = b.store==='clothesg'
    ? `zgSelectLine('${(b.ctaCat||'').replace(/'/g,"\\'")}');return false;`
    : `navCatName('${(b.ctaCat||'').replace(/'/g,"\\'")}');return false;`;
  return `<div class="vh-slide${i===0?' active':''}" data-vh-idx="${i}">
    <div class="vh-media">${media}</div>
    <div class="vh-body">
      ${b.tag ? `<span class="vh-tag">${zyEscapeHtml(b.tag)}</span>` : ''}
      <h2 class="vh-title">${zyEscapeHtml(b.title||'')}</h2>
      ${b.desc ? `<p class="vh-desc">${zyEscapeHtml(b.desc)}</p>` : ''}
      <a href="#" class="vh-cta" onclick="${ctaOnclick}">${zyEscapeHtml(b.ctaLabel||'Ver más')}</a>
    </div>
