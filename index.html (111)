  navigate('pdp', true);
  const slug = zySlugify(`${p.brand}-${p.name}`);
  const title = `${p.brand} ${p.name} — ${fmt(p.price)} | ZAYDE`;
  const desc = (p.desc ? p.desc.slice(0,150) : `${p.brand} ${p.name}, pieza verificada disponible en ZAYDE.`);
  const image = (p.images && p.images[0]) ? p.images[0] : undefined;
  // Los metadatos (título, descripción, og:image, canonical) se actualizan
  // siempre — incluso al llegar por un enlace directo o al usar atrás/adelante
  // del navegador — porque eso es justo cuando Google y las redes sociales
  // leen la página; zyPushURL ya evita duplicar el historial si la URL no cambió.
  zyPushURL(`/producto/${p.id}-${slug}`, title, desc, image);
}
// [VIEW TRANSITIONS] "openPDP" pasó a ser un wrapper delgado alrededor de
// zyOpenPDPCore (que tiene toda la lógica de siempre, intacta). Este wrapper
// solo se encarga de la animación: si el navegador soporta la View
// Transitions API y la persona no pidió "reducir movimiento", la foto de la
// tarjeta que se tocó y la foto grande de la ficha comparten el mismo
// view-transition-name (por eso usamos el id del producto, único por
// tarjeta) — el navegador las interpola automáticamente en tamaño y
// posición, sin que tengamos que animar nada a mano. Si no hay soporte
// (o ya hay una transición en curso, ver zyRunWithViewTransition), esto se
// comporta exactamente igual que antes: llama directo a zyOpenPDPCore.
function openPDP(id, skipPush, event){
  // [SIN-BORROSO] Antes la foto de la tarjeta (miniatura de ~400px) "viajaba" hasta la ficha agrandándose
  // con View Transitions: mientras cargaba la foto grande se veía la miniatura estirada, o sea borrosa.
  // Ahora solo hay el desvanecido suave entre páginas; la foto de la ficha aparece directo, nítida
  // (zyPreloadPDP ya la va descargando desde que se toca la tarjeta).
  zyRunWithViewTransition(function(){
    zyOpenPDPCore(id, skipPush);
  });
}
