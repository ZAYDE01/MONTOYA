  document.getElementById('filterCats').innerHTML = CATS.map(c=>`
    <label class="filter-opt"><input type="checkbox" ${filters.cats.has(c)?'checked':''} onchange="toggleFilter('cats','${c}');buildFilterUI()">${c}</label>`).join('');

  const genderEl = document.getElementById('filterGender');
  if(genderEl){
    const showGender = singleCat ? singleCat==='Zapatos' : activeCats.includes('Zapatos');
    genderEl.closest('.filter-group').style.display = showGender ? '' : 'none';
    genderEl.innerHTML = SNEAKER_GENDERS.map(g=>`
      <label class="filter-opt"><input type="checkbox" ${filters.genders.has(g)?'checked':''} onchange="toggleFilter('genders','${g}')">${g} (hasta talla ${zyShoeMx({category:'Zapatos',gender:g},SNEAKER_SIZES_BY_GENDER[g][SNEAKER_SIZES_BY_GENDER[g].length-1])} MX)</label>`).join('');
  }

