  document.getElementById('pdpSku').textContent = p.sku;
  document.getElementById('pdpDate').textContent = p.releaseDate;
  zyRenderPerfumeFacts(p);
  zyRenderRelojFacts(p);
  zyRenderPdpSpecs(p);
  zyRenderPdpDetails(p);
  // Detalles y Ficha técnica siempre arrancan cerradas al abrir un producto
  ['pdpSpecsItem','pdpDetailsItem','pdpFactsItem'].forEach(id=>{ const el = document.getElementById(id); if(el) el.classList.remove('open'); });
  const totalStock = Object.values(p.stock||{}).reduce((a,b)=>a+b,0);
  // [URGENCIA REAL] "Solo queda 1" usa el stock total real del producto,
  // no un contador decorativo — igual que el badge por talla de abajo.
  document.getElementById('pdpStock').innerHTML = totalStock>0
    ? (totalStock===1 ? `<span class="pdp-stock-low">Solo queda 1 unidad</span>` : `${totalStock} unidades disponibles`)
    : 'Agotado';
