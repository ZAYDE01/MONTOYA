async function loadAccountData(mergeCurrent){
  const key = storeKeyPrefix()+userKey();
  const savedCart = (await Store.get('zayde:cart:'+userKey())) || [];
  // [CARRITO COMPARTIDO] Migración: si quedó un carrito viejo de ZAYDE G (clave 'cg:'), se une una sola vez al carrito común.
  try{
    const legacyKey = 'zayde:cart:cg:'+userKey();
    const legacy = (await Store.get(legacyKey)) || [];
    if(legacy.length){
      legacy.forEach(item=>{
        const ex = savedCart.find(c=>c.id===item.id && c.size===item.size);
        if(ex) ex.qty += item.qty; else savedCart.push(item);
      });
      await Store.set(legacyKey, []);
    }
  }catch(e){}
  const savedFavs = (await Store.get('zayde:favorites:'+key)) || [];
  if(mergeCurrent){
    cart.forEach(item=>{
      const existing = savedCart.find(c=>c.id===item.id && c.size===item.size);
      if(existing) existing.qty += item.qty; else savedCart.push(item);
    });
    favorites.forEach(id=>{ if(!savedFavs.includes(id)) savedFavs.push(id); });
  }
  cart = savedCart;
  favorites = new Set(savedFavs);
  zyCoupon = (await Store.get('zayde:coupon:'+key)) || null;
  zyGiftBalance = currentUser ? await zyReadGiftBalance() : 0;   // el saldo vive en el servidor
  // [MEMBRESÍAS-ENVÍO] La membresía se guarda por cuenta (no por tienda, no
  // lleva storeKeyPrefix) — igual que en zyRenderClubTiers/renderAccountPage.
  currentMembership = currentUser ? (await zyCheckClubExpiry()) : null;
  renderCart();
  syncFavButtons();
  updateFavBadge();
  if(currentPage==='favorites') renderFavorites();
  persistCart();
  persistFavorites();
  zyBirthdayCheck(); // [CUMPLEAÑOS · 5%]
}

/* ================= [CUMPLEAÑOS · 5%] =================
   Miembros Icon / Icon Black: cupón de 5% durante el MES de su cumpleaños, una vez al año.
   - La fecha se guarda al registrarse (o desde Mi cuenta > Cumpleaños) en 'zayde:dob:'+userKey() y
     una vez guardada ya no se puede cambiar desde la tienda (evita pedir el cupón cuando uno quiera).
   - zyBirthdayCheck() corre al cargar la cuenta: si toca, deja el cupón CUMPLE5-AÑO aplicado en la bolsa.
   - Al confirmar el pedido con ese cupón se marca 'zayde:bdayUsed:' con el año y no se vuelve a dar ese año.
   Para cambiar quién recibe el beneficio, edita ZY_BDAY_TIERS; para el porcentaje, ZY_BDAY_PCT. */
/* [FIX CUMPLEAÑOS] Antes solo lo recibían los miembros Icon / Icon Black, y en el registro se promete la
   recompensa a cualquiera que ponga su fecha: a todos los demás nunca les llegaba nada. Ahora lo recibe
   TODA cuenta con fecha de cumpleaños guardada. Para volver a limitarlo a ciertos niveles, pon por ejemplo
   ['Icon','Icon Black']; null = todas las cuentas. */
const ZY_BDAY_TIERS = null;
function zyBdayTierOk(){ return !ZY_BDAY_TIERS || !!(currentMembership && ZY_BDAY_TIERS.includes(currentMembership.tier)); }
const ZY_BDAY_PCT = 5;
function zyParseDob(d,m,y){
  d = parseInt(d,10); m = parseInt(m,10); y = parseInt(y,10);
  if(!d || !m || !y || y < 1900) return null;
  const t = new Date(y, m-1, d);
  if(t.getFullYear()!==y || t.getMonth()!==m-1 || t.getDate()!==d) return null;
  if(t.getTime() > Date.now()) return null;
  return { d, m, y };
}
/* [CUMPLEAÑOS · SOLO 1 VEZ] La fecha se guarda en el dispositivo (Store) y también en la nube
   (Firestore: userDob/{uid}, solo se crea una vez). zyGetDob() revisa las dos, así que cambiar de
   celular, borrar datos del navegador o volver a iniciar sesión ya no permite capturarla otra vez.
   Si Firestore no deja leer/escribir (reglas sin publicar), cae al candado local de siempre. */
async function zyGetDob(){
  let dob = await Store.get('zayde:dob:'+userKey());
  if(dob && dob.d && dob.m && dob.y) return dob;
  try{
    if(currentUser && currentUser.uid && typeof db!=='undefined' && db){
      const d = await db.collection('userDob').doc(currentUser.uid).get();
      if(d.exists){
        const x = d.data() || {};
        if(x.d && x.m && x.y){ dob = { d:Number(x.d), m:Number(x.m), y:Number(x.y) }; await Store.set('zayde:dob:'+userKey(), dob); return dob; }
      }
    }
  }catch(e){ /* sin permiso o sin conexión: se queda el candado local */ }
  return null;
}
async function zyPersistDobOnce(dob){
  await Store.set('zayde:dob:'+userKey(), dob);
  try{
    if(currentUser && currentUser.uid && typeof db!=='undefined' && db){
      await db.collection('userDob').doc(currentUser.uid).set({ d:dob.d, m:dob.m, y:dob.y, createdAt:Date.now() });
    }
  }catch(e){ console.warn('No se pudo guardar el cumpleaños en la nube (se conserva el candado local):', e && e.message); }
}
/* [CUMPLEAÑOS] El servidor valida el cupón con la fecha guardada en la nube (userDob/{uid}). Quien la puso antes de
   existir ese respaldo solo la tenía en su dispositivo: aquí se copia una vez (la regla solo permite crearla). */
async function zySyncDobCloud(dob){
  try{
    if(!dob || !currentUser || !currentUser.uid || typeof db==='undefined' || !db) return;
    const ref = db.collection('userDob').doc(currentUser.uid), d = await ref.get();
    if(!d.exists) await ref.set({ d:Number(dob.d), m:Number(dob.m), y:Number(dob.y), createdAt:Date.now() });
  }catch(e){ /* sin permiso o sin conexión: se intenta en la próxima carga */ }
}
async function zyBirthdayCheck(){
  try{
    if(!currentUser || !currentUser.uid) return;
    const yr = new Date().getFullYear();
    let eligible = false;
    if(zyBdayTierOk()){
      const dob = await zyGetDob();
      zySyncDobCloud(dob);
      const used = await Store.get('zayde:bdayUsed:'+userKey());
      eligible = !!dob && (new Date().getMonth()+1) === Number(dob.m) && used !== yr;
    }
    if(zyCoupon && zyCoupon.birthday && (!eligible || zyCoupon.year !== yr)){
      zyCoupon = null; await Store.set('zayde:coupon:'+userKey(), null); renderCart();
    }
    if(eligible && !zyCoupon){
      zyCoupon = { code:'CUMPLE5-'+yr, type:'pct', value:ZY_BDAY_PCT, birthday:true, year:yr };
      await Store.set('zayde:coupon:'+userKey(), zyCoupon);
      renderCart();
      showToast('🎂 ¡Feliz cumpleaños! Tienes '+ZY_BDAY_PCT+'% de descuento en tu compra este mes');
    }
  }catch(e){ console.error('No se pudo revisar el cupón de cumpleaños:', e); }
}
