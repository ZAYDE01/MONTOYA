/* [HOME-RESEÑAS] Trae reseñas de varios productos (no solo uno) y muestra
   las mejores en el inicio, como prueba social. Prioriza reseñas con 4-5
   estrellas, texto real, y de preferencia con foto y compra verificada —
   así la sección no se llena con reseñas de 1-2 estrellas o comentarios
   de una sola palabra. Si todavía no hay reseñas reales, la sección
   entera se oculta (nunca se inventan reseñas de ejemplo). */
/* [FR-TOGGLE] Tienda que se está mostrando en las reseñas destacadas del
   inicio: 'zayde' (default) o 'clothesg'. Ver frSetStore() más abajo. */
let frActiveStore = 'zayde';
function frSetStore(store){
  frActiveStore = store;
  const btnZ = document.getElementById('frStoreBtnZayde');
  const btnG = document.getElementById('frStoreBtnClothesG');
  if(btnZ) btnZ.classList.toggle('active', store==='zayde');
  if(btnG) btnG.classList.toggle('active', store==='clothesg');
  renderFeaturedReviews();
}
async function renderFeaturedReviews(){
  const section = document.getElementById('section-featured-reviews');
  const grid = document.getElementById('grid-featured-reviews');
  const toggle = document.getElementById('frStoreToggle');
  if(!section || !grid || !db) return;
  // [FR-TOGGLE] El botón ZAYDE / ZAYDE G solo se muestra si ya hay
  // piezas cargadas en el almacén de ZAYDE G — si no, no habría nada
  // que ver del lado de ZAYDE G y el botón no tendría sentido.
  if(toggle) toggle.style.display = zyClothesGProducts().length ? '' : 'none';
  const storeIds = new Set((frActiveStore==='clothesg' ? zyClothesGProducts() : zyBrowsable()).map(p=>String(p.id)));
  try{
    const snap = await db.collection('reviews').orderBy('date','desc').limit(40).get();
    let reviews = snap.docs.map(d=>d.data());
    reviews = reviews.filter(r => r.stars >= 4 && r.text && r.text.trim().length >= 15 && storeIds.has(String(r.productId)));
    reviews.sort((a,b)=>{
      const scoreA = ((a.images&&a.images.length)?2:0) + (a.verifiedPurchase?1:0);
      const scoreB = ((b.images&&b.images.length)?2:0) + (b.verifiedPurchase?1:0);
      if(scoreB !== scoreA) return scoreB - scoreA;
      return (b.date||0) - (a.date||0);
    });
    reviews = reviews.slice(0, 8);
    // [FR-TOGGLE] Si no hay reseñas para la tienda elegida, ocultamos la
    // sección entera solo cuando el botón ZAYDE/ZAYDE G tampoco aplica
    // (no hay nada que alternar). Si el botón sí está disponible, dejamos
    // la sección visible con un mensaje vacío para no "atrapar" a quien
    // acaba de darle clic a ZAYDE G sin reseñas todavía.
    if(!reviews.length){
      if(toggle && toggle.style.display !== 'none'){
        section.style.display = '';
        grid.innerHTML = `<p class="zy-hint" style="padding:8px 0;">Todavía no hay reseñas destacadas de ${frActiveStore==='clothesg'?'ZAYDE G':'ZAYDE'}.</p>`;
      } else {
        section.style.display = 'none';
      }
      return;
    }
    section.style.display = '';
    grid.innerHTML = reviews.map(r=>{
      const product = PRODUCTS.find(p=>String(p.id)===String(r.productId));
      const stars = '★'.repeat(r.stars) + '☆'.repeat(5-r.stars);
      const thumb = (r.images && r.images[0]) ? `<img class="fr-thumb" src="${r.images[0]}" alt="Foto de reseña" loading="lazy">` : '';
      const verifiedBadge = r.verifiedPurchase ? `<span class="fr-badge">Compra verificada</span>` : '';
      const clickable = product ? `onclick="openPDP(${product.id})" style="cursor:pointer;"` : '';
      return `
      <div class="fr-card" ${clickable}>
        ${thumb}
        <div class="fr-stars">${stars}</div>
        <div class="fr-text">"${zyEscapeHtml(r.text)}"</div>
        <div class="fr-foot">
          <span>${zyEscapeHtml(r.name||'Cliente ZAYDE')}${product?` · ${zyEscapeHtml(product.name)}`:''}</span>
          ${verifiedBadge}
        </div>
        <div class="fr-date">${r.date ? new Date(r.date).toLocaleDateString('es-MX',{year:'numeric',month:'long',day:'numeric'}) : ''}</div>
      </div>`;
    }).join('');
  }catch(e){
    console.error('No se pudieron cargar las reseñas destacadas:', e);
    section.style.display = 'none';
  }
}

/* [HOME-HERO] Llena el hero de pantalla completa con una foto real:
   usa la pieza más vista del catálogo (mismo criterio que "Más
   vendidos") como fondo. Antes esta caja (.hero-visual) se quedaba
   siempre vacía porque nada la llenaba, y además mostraba un chip fijo
   con "Nimbus / Runner '98 Low Vault" — a pedido directo, ya no se
   muestra ningún chip de producto sobre la foto, solo la imagen. */
function zyRenderHeroVisual(bySeed){
  const bg = document.getElementById('heroBg');
  if(!bg) return;
  // [PANDORA-HERO] Prioridad del fondo del hero: 1) video propio del admin
  // (zySettings.heroBgVideo) — igual que el banner principal de
  // pandora.net; 2) foto propia del admin (zySettings.heroBgImage); 3)
  // respaldo automático de siempre (la pieza más vista del catálogo).
  const playBtn = document.getElementById('heroPlayBtn');
  const muteBtn = document.getElementById('heroMuteBtn');
  if(zySettings.heroBgVideo){
    bg.innerHTML = `<video id="heroBgVideoEl" src="${zyEscapeHtml(zySettings.heroBgVideo)}" autoplay muted loop playsinline webkit-playsinline="true" preload="auto"></video>`;
    if(playBtn) playBtn.style.display = '';
    if(muteBtn) muteBtn.style.display = '';
    // [FIX-VIDEO-AUTOPLAY] En algunos navegadores (sobre todo Safari/iOS)
    // no basta con los atributos autoplay/muted del HTML cuando el <video>
    // se inserta dinámicamente vía innerHTML — hay que fijar la propiedad
    // .muted en JS y pedir .play() explícitamente, si no el video se queda
    // "pegado" en el primer cuadro (como si no hubiera cargado). También
    // se deja un aviso en la consola si el navegador rechaza el video
    // (enlace roto, formato no soportado, CORS, etc.) para poder
    // diagnosticarlo desde las herramientas de desarrollador.
    const vEl = document.getElementById('heroBgVideoEl');
    if(vEl){
      vEl.muted = true;
      vEl.play().catch(err=>console.warn('[hero video] no se pudo autoreproducir todavía (normal antes de la primera interacción):', err && err.message));
      vEl.addEventListener('error', ()=>{
        console.error('[hero video] el navegador no pudo cargar la URL guardada en zySettings.heroBgVideo:', zySettings.heroBgVideo);
      });
    }
    zyRenderHeroControlIcons();
  } else {
    if(playBtn) playBtn.style.display = 'none';
    if(muteBtn) muteBtn.style.display = 'none';
    if(zySettings.heroBgImage){
      bg.innerHTML = `<img src="${zyEscapeHtml(zySettings.heroBgImage)}" alt="ZAYDE">`;
    } else {
      const featured = (bySeed && bySeed[0]) || null;
      const img = featured && featured.images && featured.images[0];
      bg.innerHTML = img ? `<img src="${img}" alt="${featured.name}">` : '';
    }
  }
  // [PANDORA-HERO] Texto corto opcional abajo a la izquierda (tag + título)
  // y la etiqueta del link de compra — todo editable desde el panel
  // privado, pestaña "Drop & ticker". Si el admin deja el campo vacío, esa
  // línea simplemente no se muestra (el hero puede quedar solo con video).
  const tagEl = document.getElementById('heroTagEl');
  const titleEl = document.getElementById('heroTitleEl');
  const ctaEl = document.getElementById('heroCtaEl');
  if(tagEl){ tagEl.textContent = zySettings.heroTag || ''; tagEl.style.display = zySettings.heroTag ? '' : 'none'; }
  if(titleEl){ titleEl.textContent = zySettings.heroTitle || ''; titleEl.style.display = zySettings.heroTitle ? '' : 'none'; }
  if(ctaEl){ ctaEl.textContent = zySettings.heroCtaLabel || 'Comprar la colección'; }
}
