/* ================= [FIX] BÚSQUEDA POR FOTO — visión real ====================
   Reemplaza el viejo "tono de color promedio" (zyImageAvgHue/zyProductHue,
   ver historial) por embeddings de MobileNet (TensorFlow.js): un vector de
   ~1000 rasgos visuales por imagen (forma, textura, tipo de objeto) que sí
   distingue una sudadera Essentials de unos Crocs, aunque compartan color.
   Todo corre en el navegador del cliente (nada se sube a un servidor), y
   las librerías (~1-2MB) solo se cargan la primera vez que alguien abre
   "Buscar por foto", no en el resto del sitio.
   ================================================================ */
let zyVisionModelPromise = null;
function zyLoadVisionModel(onProgress){
  if(zyVisionModelPromise) return zyVisionModelPromise;
  zyVisionModelPromise = new Promise((resolve, reject)=>{
    const loadScript = (src)=> new Promise((res, rej)=>{
      if(document.querySelector(`script[src="${src}"]`)){ res(); return; }
      const s = document.createElement('script');
      s.src = src; s.async = true;
      s.onload = ()=>res();
      s.onerror = ()=>rej(new Error('No se pudo cargar '+src));
      document.head.appendChild(s);
    });
    (async ()=>{
      try{
        if(onProgress) onProgress('Cargando motor de visión…');
        if(!window.tf) await loadScript('https://cdn.jsdelivr.net/npm/@tensorflow/tfjs@4.20.0/dist/tf.min.js');
        if(!window.mobilenet) await loadScript('https://cdn.jsdelivr.net/npm/@tensorflow-models/mobilenet@2.1.1/dist/mobilenet.min.js');
        if(onProgress) onProgress('Preparando el modelo…');
        const model = await window.mobilenet.load({ version: 2, alpha: 1.0 });
        resolve(model);
      }catch(err){
        zyVisionModelPromise = null; // permite reintentar en la próxima búsqueda
        reject(err);
      }
    })();
  });
  return zyVisionModelPromise;
}
// Embedding (vector de rasgos) de una <img> ya cargada, usando la penúltima
// capa de MobileNet (infer(img, true)) en vez de la clasificación final —
// así comparamos "qué tan parecida se ve" y no solo "a qué clase de
// ImageNet pertenece".
async function zyEmbedImage(model, imgEl){
  const embedding = model.infer(imgEl, true); // tensor
  const arr = await embedding.data();
  embedding.dispose();
  return arr;
}
function zyCosineSim(a, b){
  let dot=0, na=0, nb=0;
  for(let i=0;i<a.length;i++){ dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
  if(na===0||nb===0) return 0;
  return dot / (Math.sqrt(na)*Math.sqrt(nb));
}
// Caché en memoria: una foto de producto no vuelve a analizarse dos veces
// en la misma sesión, aunque el usuario haga varias búsquedas por foto.
const zyEmbedCache = new Map(); // url -> Promise<Float32Array>
function zyLoadImgEl(url){
  return new Promise((resolve, reject)=>{
    const img = new Image();
    img.crossOrigin = 'anonymous';
    img.onload = ()=>resolve(img);
    img.onerror = ()=>reject(new Error('No se pudo cargar la imagen'));
    img.src = url;
  });
}
function zyGetProductEmbedding(model, p){
  const url = p.images && p.images[0];
  if(!url) return null;
  if(!zyEmbedCache.has(url)){
    zyEmbedCache.set(url, zyLoadImgEl(url).then(imgEl=>zyEmbedImage(model, imgEl)).catch(()=>null));
  }
  return zyEmbedCache.get(url);
}
function zyHandleImageFile(file){
  if(!file) return;
  const reader = new FileReader();
  reader.onload = (e)=>{
    const dataUrl = e.target.result;
    const previewBox = document.getElementById('imgSearchPreviewBox');
    const previewImg = document.getElementById('imgSearchPreview');
    previewImg.src = dataUrl;
    previewBox.style.display = '';
    const statusEl = document.getElementById('imgSearchStatus');
    statusEl.textContent = 'Analizando tu foto…';
    document.getElementById('imgSearchResults').innerHTML = '';
    previewImg.onload = async ()=>{
      try{
        const model = await zyLoadVisionModel(msg=>{ statusEl.textContent = msg; });
        const queryEmbedding = await zyEmbedImage(model, previewImg);
        await zyRunVisualSearch(model, queryEmbedding);
      }catch(err){
        console.error('Búsqueda por foto:', err);
        statusEl.textContent = 'No se pudo analizar la foto (revisa tu conexión a internet e intenta de nuevo).';
      }
    };
  };
  reader.readAsDataURL(file);
}
async function zyRunVisualSearch(model, queryEmbedding){
  const statusEl = document.getElementById('imgSearchStatus');
  const resultsEl = document.getElementById('imgSearchResults');
  // Solo se compara contra piezas con foto REAL — no tiene sentido
  // "reconocer" un ícono de placeholder (ver comentario del modal arriba).
  const candidates = zyBrowsable().filter(p=>p.images && p.images[0]);
  if(!candidates.length){
    statusEl.textContent = 'Todavía no hay piezas con foto real en el catálogo para comparar.';
    resultsEl.innerHTML = '';
    return;
  }
  let done = 0;
  statusEl.textContent = `Comparando con el catálogo… (0/${candidates.length})`;
  // Se procesan en tandas pequeñas para no congelar la página mientras se
  // analizan varias fotos del catálogo a la vez.
  const BATCH = 6;
  const scored = [];
  for(let i=0;i<candidates.length;i+=BATCH){
    const batch = candidates.slice(i, i+BATCH);
    const embeddings = await Promise.all(batch.map(p=>zyGetProductEmbedding(model, p)));
    embeddings.forEach((emb, idx)=>{
      if(emb) scored.push({ p: batch[idx], sim: zyCosineSim(queryEmbedding, emb) });
    });
    done += batch.length;
    statusEl.textContent = `Comparando con el catálogo… (${Math.min(done,candidates.length)}/${candidates.length})`;
  }
  const ranked = scored.sort((a,b)=>b.sim-a.sim).slice(0,8);
  if(!ranked.length){
    statusEl.textContent = 'No se encontraron piezas parecidas. Intenta con otra foto, más de frente y con buena luz.';
    resultsEl.innerHTML = '';
    return;
  }
  statusEl.textContent = `${ranked.length} piezas visualmente parecidas a tu foto:`;
  resultsEl.innerHTML = ranked.map(x=>cardHTML(x.p)).join('');
}

