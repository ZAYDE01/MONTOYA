/* ================= [TARJETA ANIMADA] =================
   Stripe nunca entrega los dígitos (PCI), así que la tarjeta reacciona a lo que SÍ informa:
   marca, estado completo/error, foco en CVC (voltea), cobro en curso y pago aprobado. */
const ZC_BRANDS={visa:'VISA',mastercard:'MASTERCARD',amex:'AMEX',discover:'DISCOVER',diners:'DINERS',jcb:'JCB',unionpay:'UNIONPAY',unknown:'ZAYDE'};
function zyCardAnim(eN,eE,eC){
  const card=document.getElementById('zcCard'); if(!card) return;
  const S={}, E={}, err=document.getElementById('stripeCardErrors');
  const on=(el,k,fn)=>el.on('change',ev=>{S[k]=ev.complete;E[k]=ev.error?ev.error.message:'';if(err)err.textContent=E.n||E.e||E.c||'';
    card.setAttribute('data-'+k, ev.complete?'ok':(ev.error?'err':''));
    card.classList.toggle('bad',!!(E.n||E.e||E.c)); if(fn)fn(ev);
    window.zyCardComplete=!!(S.n&&S.e&&S.c); card.classList.toggle('ok',window.zyCardComplete);});
  on(eN,'n',ev=>{card.dataset.brand=ev.brand||'unknown';document.getElementById('zcBrand').textContent=ZC_BRANDS[ev.brand]||'ZAYDE';card.classList.toggle('has',!ev.empty);});
  on(eE,'e'); on(eC,'c');
  [eN,eE].forEach(e=>{e.on('focus',()=>{card.classList.add('act');card.classList.remove('flip');}); e.on('blur',()=>card.classList.remove('act'));});
  eC.on('focus',()=>card.classList.add('flip')); eC.on('blur',()=>card.classList.remove('flip'));
  const nm=document.getElementById('ckName'), tn=document.getElementById('zcName');
  const sync=()=>{tn.textContent=((nm&&nm.value.trim())||'NOMBRE APELLIDO').toUpperCase().slice(0,24);};
  if(nm){nm.addEventListener('input',sync);} sync();
}
const _zcCharge=zyChargeWithStripe;
zyChargeWithStripe=async function(...a){
  const c=document.getElementById('zcCard'); if(c){c.classList.remove('paid','bad');c.classList.add('busy');}
  let r; try{ r=await _zcCharge.apply(this,a); } finally { if(c)c.classList.remove('busy'); }
  if(c){ c.classList.toggle('paid',!!(r&&r.success)); c.classList.toggle('bad',!(r&&r.success)); }
  return r;
};
