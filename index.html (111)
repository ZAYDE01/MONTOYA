/* [FIX-VIDEO-TAMAÑO] Cloudinary, en cuentas gratis, tiene un tope DURO de
   100MB por video — no hay forma de subir más pesado que eso ni
   subiéndolo en pedazos, así que la única solución real es achicar el
   video ANTES de mandarlo. Esta función lo hace sola, dentro del propio
   navegador (sin subir nada a ningún lado todavía): reproduce el video
   original en segundo plano, va dibujando cada cuadro en un canvas más
   chico (máximo 1280px de ancho — de sobra para un fondo de pantalla) y
   graba ese canvas con MediaRecorder en formato WebM, sin audio (el
   video del hero siempre está muted, así que el audio ni falta). El
   resultado casi siempre pesa una fracción de lo que pesaba el archivo
   original (un video grabado en 4K desde el celular que pesa 300-500MB
   fácil termina pesando unos cuantos MB). No necesita ninguna librería
   externa ni configurar nada en Cloudinary.
   Si el navegador de quien administra el sitio no soporta esto (muy raro
   hoy en día) o algo falla a medio camino, se sube el archivo original
   tal cual, sin romper nada. */
function zyCompressHeroVideo(file, onStatus){
  return new Promise((resolve)=>{
    if(typeof MediaRecorder === 'undefined' || !document.createElement('canvas').captureStream){
      resolve(file); return;
    }
    const srcUrl = URL.createObjectURL(file);
    const video = document.createElement('video');
    video.src = srcUrl; video.muted = true; video.playsInline = true;
    const cleanupAndFallback = ()=>{ try{ URL.revokeObjectURL(srcUrl); }catch(e){} resolve(file); };
    const failSafeTimer = setTimeout(cleanupAndFallback, 90000); // por si un video rarísimo nunca dispara 'ended'
    video.addEventListener('error', cleanupAndFallback, { once:true });
    video.addEventListener('loadedmetadata', ()=>{
      try{
        const maxW = 1280;
        const scale = Math.min(1, maxW / (video.videoWidth || maxW));
        const w = Math.max(2, Math.round((video.videoWidth || maxW) * scale));
        const h = Math.max(2, Math.round((video.videoHeight || 720) * scale));
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        const ctx = canvas.getContext('2d');
        const stream = canvas.captureStream(30);
        let recorder;
        try{ recorder = new MediaRecorder(stream, { mimeType:'video/webm;codecs=vp9', videoBitsPerSecond:2200000 }); }
        catch(e1){
          try{ recorder = new MediaRecorder(stream, { mimeType:'video/webm', videoBitsPerSecond:2200000 }); }
          catch(e2){ clearTimeout(failSafeTimer); cleanupAndFallback(); return; }
        }
        const chunks = [];
        recorder.ondataavailable = (e)=>{ if(e.data && e.data.size) chunks.push(e.data); };
        let raf;
        const draw = ()=>{
          if(video.paused || video.ended) return;
          try{ ctx.drawImage(video, 0, 0, w, h); }catch(e){}
          raf = requestAnimationFrame(draw);
        };
        recorder.onstop = ()=>{
          clearTimeout(failSafeTimer);
          try{ URL.revokeObjectURL(srcUrl); }catch(e){}
          const blob = new Blob(chunks, { type:'video/webm' });
          if(blob.size > 0 && blob.size < file.size){
            resolve(new File([blob], 'hero-comprimido.webm', { type:'video/webm' }));
          } else {
            resolve(file); // si por lo que sea salió más pesado, se sube el original
          }
        };
        video.addEventListener('play', ()=>{ if(typeof onStatus==='function') onStatus('Comprimiendo video…'); draw(); });
        video.addEventListener('ended', ()=>{ cancelAnimationFrame(raf); try{ recorder.stop(); }catch(e){} });
        recorder.start();
        video.play().catch(()=>{ clearTimeout(failSafeTimer); try{ recorder.stop(); }catch(e){} cleanupAndFallback(); });
      }catch(err){
        clearTimeout(failSafeTimer);
        cleanupAndFallback();
      }
    }, { once:true });
  });
}
/* [PANDORA-HERO] Mismo patrón que zyPreviewHeroBg(), pero para el VIDEO
   de fondo del hero — reutiliza zyUploadVideoFile() (mismo preset de
   Cloudinary "unsigned" que ya usan las Vitrinas), así no hace falta
   configurar nada nuevo en Cloudinary. Antes de subir, si el archivo
   pesa más de 15MB se comprime solo en el navegador (ver
   zyCompressHeroVideo arriba) — así prácticamente nunca vuelve a chocar
   con el límite de 100MB de Cloudinary, sin importar qué tan pesado sea
   el video que grabes con el celular. */
async function zyPreviewHeroBgVideoFile(){
  const input = document.getElementById('zyHeroBgVideoFile');
  const file = input.files && input.files[0];
  if(!file) return;
  const box = document.getElementById('zyHeroBgVideoPreview');
  const setStatus = (msg)=>{ box.innerHTML = `<div class="zy-thumb" style="width:96px; display:flex; align-items:center; justify-content:center; font-size:10.5px; text-align:center; color:var(--steel); padding:2px;">${msg}</div>`; };
  setStatus('Subiendo video…');
  try{
    await zyAssertHomeVideoMax15(file);   // [INICIO] máximo 15 segundos
    let toUpload = file;
    if(file.size > 15 * 1024 * 1024){
      setStatus('Comprimiendo video, un momento…');
      toUpload = await zyCompressHeroVideo(file, setStatus);
      setStatus('Subiendo video…');
    }
    const url = await zyUploadVideoFile(toUpload);
    zySettings.heroBgVideo = url;
    document.getElementById('zyHeroBgVideoUrl').value = url;
    AdminStore.set('zayde:admin:homeSettings', zySettings);
    zyRenderHeroBgVideoPreview();
    try{ if(typeof renderHome === 'function') renderHome(); }catch(e){}
    showToast('Video del hero actualizado');
  }catch(e){
    console.error('No se pudo subir el video del hero:', e);
    zyRenderHeroBgVideoPreview();
    const pesoMB = (file.size / (1024*1024)).toFixed(1);
    showToast(`No se pudo subir el video (pesa ${pesoMB}MB): ` + (e.message || 'error desconocido'), true);
  } finally {
    input.value = '';
  }
}
