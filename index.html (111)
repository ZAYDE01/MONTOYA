<!-- ============================================================
     [PWA] Registro del service worker (/sw.js) — habilita que el sitio se
     pueda instalar como app y que reciba notificaciones push reales.
     Se registra siempre (no requiere permiso), el permiso de notificación
     se pide aparte, solo cuando el cliente le da clic a "Activar
     notificaciones" — nunca automático, para no ganarse un bloqueo del
     navegador por pedir permiso sin que el cliente lo busque.
     ============================================================ -->
<script>
/* [FIX — intro al reabrir] Si el navegador/app restaura la página congelada
   en memoria (sin volver a cargar) tras haber estado fuera >30 s, se recarga
   para que vuelva a verse la intro como en una apertura nueva. */
(function(){
  var hiddenAt = 0;
  window.addEventListener('pagehide', function(){ hiddenAt = Date.now(); });
  window.addEventListener('pageshow', function(e){
    if(e.persisted && hiddenAt && (Date.now() - hiddenAt) > 30000){ location.reload(); }
  });
})();
if('serviceWorker' in navigator){
  window.addEventListener('load', ()=>{
    navigator.serviceWorker.register('/sw.js').then(reg=>{
      // [FIX] Sin esto, un service worker viejo puede seguir sirviendo el
      // index.html cacheado en el teléfono aunque el deploy en Vercel ya
      // tenga la versión nueva — el usuario ve "cambios que no llegan"
      // aunque el código sí se subió bien. Forzamos: 1) checar de
      // inmediato si hay una versión nueva del sw.js, 2) si el sw.js nuevo
      // llama a self.skipWaiting()/clients.claim() (o escucha el mensaje
      // SKIP_WAITING de abajo), recargar la página automáticamente en
      // cuanto esa versión tome el control, para que el cambio se vea sin
      // que el usuario tenga que borrar caché a mano.
      reg.update();
      if(reg.waiting){ reg.waiting.postMessage('SKIP_WAITING'); }
      reg.addEventListener('updatefound', ()=>{
        const nw = reg.installing;
        if(!nw) return;
        nw.addEventListener('statechange', ()=>{
          if(nw.state==='installed' && navigator.serviceWorker.controller){
            nw.postMessage('SKIP_WAITING');
          }
        });
      });
    }).catch(e=>console.warn('No se pudo registrar el service worker:', e));
    let zyReloadedForSW = false;
    // [FIX] En la PRIMERA visita (no había service worker controlando la
    // página) el SW toma el control solo; recargar ahí era innecesario y era
    // lo que repetía la intro. Solo se recarga cuando es una ACTUALIZACIÓN.
    let zyHadController = !!navigator.serviceWorker.controller;
    navigator.serviceWorker.addEventListener('controllerchange', ()=>{
      if(!zyHadController){ zyHadController = true; return; }
      if(zyReloadedForSW) return;
      zyReloadedForSW = true;
      try{ sessionStorage.setItem('zy:swReload','1'); }catch(e){}
      window.location.reload();
    });
  });
}

/* Llave pública VAPID — es pública a propósito (así funciona el estándar
   Web Push), la llave PRIVADA nunca va en el frontend, solo vive en las
   variables de entorno de Vercel para /api/send-push.js. */
const ZY_VAPID_PUBLIC_KEY = 'BAMpGF2q6k-dOvtsH25QQox2Dw5ZT6r1zxi1yQeLVUc_SZ4WMPQtlKg5tDFCkbmmoWZSXa_AElgcO5MNv5xdWrM';

function zyUrlBase64ToUint8Array(base64String){
  const padding = '='.repeat((4 - base64String.length % 4) % 4);
  const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/');
  const rawData = atob(base64);
  return Uint8Array.from([...rawData].map(c=>c.charCodeAt(0)));
}

/* Activa las notificaciones push en este dispositivo: pide permiso, crea
   la suscripción del navegador y la guarda en Firestore (colección
   push_subscriptions) para que puedas mandarle avisos desde el panel
   admin. Necesita Firestore activo (mismo `db` que usa el resto del
   sitio) porque, a diferencia del correo, aquí SÍ hace falta guardar la
   suscripción en la nube para poder alcanzar ese dispositivo después. */
async function zySubscribePush(btnEl){
  if(!('serviceWorker' in navigator) || !('PushManager' in window)){
    showToast('Tu navegador no soporta notificaciones push. Prueba con Chrome, Edge o Safari reciente.', true);
    return;
  }
  if(!db){
    showToast('Las notificaciones push necesitan conexión a la nube (Firestore) — intenta de nuevo en un momento.', true);
    return;
  }
  try{
    const permission = await Notification.requestPermission();
    if(permission !== 'granted'){
      showToast('No se activaron las notificaciones — diste "Bloquear" o cerraste el aviso.', true);
      return;
    }
    const reg = await navigator.serviceWorker.ready;
    let sub = await reg.pushManager.getSubscription();
    if(!sub){
      sub = await reg.pushManager.subscribe({
        userVisibleOnly: true,
        applicationServerKey: zyUrlBase64ToUint8Array(ZY_VAPID_PUBLIC_KEY)
      });
    }
    const subJson = sub.toJSON();
    // El endpoint es único por dispositivo/navegador, así que se usa como
    // ID del documento — evita duplicados si el cliente activa dos veces.
    const docId = btoa(subJson.endpoint).replace(/[^a-zA-Z0-9]/g,'').slice(0,180);
    await db.collection('push_subscriptions').doc(docId).set({
      subscription: subJson,
      createdAt: Date.now()
    });
    showToast('¡Notificaciones activadas en este dispositivo!');
    if(btnEl){ btnEl.textContent = 'Notificaciones activadas'; btnEl.disabled = true; }
  }catch(e){
    console.error('No se pudo activar la suscripción push:', e);
    showToast('No se pudieron activar las notificaciones. Intenta de nuevo.', true);
  }
}
</script>

