}
/* ============================================================
   [DIRECCIONES] Direcciones de envío guardadas, por cuenta — el
   equivalente al "Shipping Information" del perfil de Nike. Viven en
   la misma Store que el resto de datos de cuenta ("zayde:addresses:"+
   userKey()), como una lista simple. Una puede marcarse "predeterminada"
   y esa es la que se usa para prellenar el checkout automáticamente
   (ver openCheckout()).
  ============================================================ */
let zyAddresses = [];
async function zyLoadAddresses(){
  zyAddresses = (await Store.get('zayde:addresses:'+userKey())) || [];
}
function zyAddressDefault(){
  return zyAddresses.find(a=>a.isDefault) || zyAddresses[0] || null;
}
async function zySaveAddress(addr){
  addr.id = 'addr_' + Date.now().toString(36);
  if(!zyAddresses.length) addr.isDefault = true; // la primera se marca predeterminada sola
  zyAddresses.push(addr);
  await Store.set('zayde:addresses:'+userKey(), zyAddresses);
}
async function zyDeleteAddress(id){
  const wasDefault = zyAddresses.find(a=>a.id===id && a.isDefault);
  zyAddresses = zyAddresses.filter(a=>a.id!==id);
  if(wasDefault && zyAddresses.length) zyAddresses[0].isDefault = true;
  await Store.set('zayde:addresses:'+userKey(), zyAddresses);
  showToast('Dirección eliminada');
  renderAccountPage();
}
async function zySetDefaultAddress(id){
  zyAddresses.forEach(a=> a.isDefault = (a.id===id));
  await Store.set('zayde:addresses:'+userKey(), zyAddresses);
  showToast('Dirección predeterminada actualizada');
  renderAccountPage();
}
function zyToggleAddressPanel(){
  const panel = document.getElementById('acctAddrPanel');
  const chevron = document.getElementById('acctAddrChevron');
  if(!panel) return;
  const open = panel.style.display !== 'none';
  panel.style.display = open ? 'none' : 'block';
  if(chevron) chevron.style.transform = open ? '' : 'rotate(90deg)';
}
function zyShowAddAddressForm(){
  const form = document.getElementById('acctAddrForm');
  if(form) form.style.display = 'block';
}
function zyHideAddAddressForm(){
  const form = document.getElementById('acctAddrForm');
  if(form) form.style.display = 'none';
  ['addrLabel','addrName','addrPhone','addrStreet','addrCity','addrZip'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
  const st = document.getElementById('addrState'); if(st) st.value = '';
}
async function zySubmitAddressForm(){
  const label = document.getElementById('addrLabel').value.trim() || 'Mi dirección';
  const name = document.getElementById('addrName').value.trim();
  const phone = document.getElementById('addrPhone').value.trim();
  const street = document.getElementById('addrStreet').value.trim();
  const city = document.getElementById('addrCity').value.trim();
  const zip = document.getElementById('addrZip').value.trim();
  const state = document.getElementById('addrState').value;
  if(!name || !phone || !street || !city || !zip || !state){ showToast('Completa todos los campos de la dirección', true); return; }
  await zySaveAddress({ label, name, phone, street, city, zip, state, isDefault:false });
  showToast('Dirección guardada');
  zyHideAddAddressForm();
  renderAccountPage();
}
// Llena el formulario de checkout con una dirección guardada — se usa
// tanto desde "Mi cuenta" (botón "Usar en mi próxima compra") como
// automáticamente al abrir el checkout si hay una predeterminada.
function zyFillCheckoutFromAddress(addr){
  if(!addr) return;
  const set = (id, val)=>{ const el = document.getElementById(id); if(el) el.value = val; };
  set('ckName', addr.name);
  set('ckPhone', addr.phone);
  set('ckAddress', addr.street);
  set('ckCity', addr.city);
  set('ckZip', addr.zip);
  set('ckState', addr.state);
  if(typeof renderShipOptions === 'function') renderShipOptions();
}
function zyUseAddressInCheckout(id){
  const addr = zyAddresses.find(a=>a.id===id);
  if(!addr) return;
  zyFillCheckoutFromAddress(addr);
  showToast('Datos rellenados — revisa y continúa tu compra cuando quieras');
}
