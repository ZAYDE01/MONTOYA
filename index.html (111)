  el.innerHTML = `<option value="">${placeholder || '— Sin especificar —'}</option>` + opts.map(v=>`<option value="${zyEscapeHtml(v)}">${zyEscapeHtml(v)}</option>`).join('');
  el.value = current || '';
}
