  if(window.zyUpdateHeaderOverlay) window.zyUpdateHeaderOverlay();

  if(!skipPush){
    const ROUTES = {
      home: ['/', 'ZAYDE — Zapatos, ropa, perfumes y accesorios', 'Zapatos, ropa, perfumes, bolsos, lentes, relojes y joyería, con envío asegurado y rastreo a todo México.'],
      catalog: ['/catalogo', 'Catálogo — ZAYDE', 'Explora zapatos, ropa, perfumes, bolsos, lentes, relojes y joyería nuevos, verificados por ZAYDE.'],
      favorites: ['/favoritos', 'Tus favoritos — ZAYDE', 'Las piezas que has guardado en ZAYDE.'],
      mayoreo: ['/mayoreo', 'Precios de mayoreo para revendedores | ZAYDE', 'Catálogo de mayoreo ZAYDE para revendedores.'],
      account: ['/cuenta', 'Mi cuenta — ZAYDE', 'Tu panel privado y preferencias en ZAYDE.'],
      club: ['/club', 'ZAYDE Club — Membresía', 'Beneficios exclusivos para miembros ZAYDE.'],
      giftcard: ['/tarjeta-de-regalo', 'Compra o canjea tu gift card | ZAYDE', 'Compra o canjea una tarjeta de regalo ZAYDE.'],
      ropag: ['/clothes-g', 'ZAYDE G — Ropa auténtica por línea', 'Otra arquitectura de escaparate para piezas de ropa auténtica ZAYDE, organizadas por línea.'],
      search: ['/buscar', 'Buscar — ZAYDE', 'Busca marca, modelo, categoría o SKU entre las piezas verificadas de ZAYDE.'],
      cart: ['/carrito', 'Carrito — ZAYDE', 'Tu carrito de compras en ZAYDE.'],
      checkout: ['/pagar', 'Pagar — ZAYDE', 'Finaliza tu compra en ZAYDE.'],
      contacto: ['/contacto', 'Contacto — ZAYDE', 'Llámanos o escríbenos: dudas de pedidos, quejas y sugerencias de ZAYDE.'],
      tracking: ['/pedidos', 'Pedidos y rastreo — ZAYDE', 'Consulta tu pedido más reciente o rastrea cualquier pedido de ZAYDE por número o teléfono.']
    };
    // 'pdp' se maneja aparte en openPDP() con su propia URL por producto
    if(ROUTES[page]) zyPushURL(ROUTES[page][0], ROUTES[page][1], ROUTES[page][2]);
