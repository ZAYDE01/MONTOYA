  const ropaWrap = document.getElementById('filterRopaGroupWrap');
  if(ropaWrap){
    const showRopa = singleCat === 'Ropa';
    ropaWrap.style.display = showRopa ? '' : 'none';
    if(showRopa){
      document.getElementById('filterRopaGroups').innerHTML = ZY_ROPA_GROUPS.map(g=>{
        const n = PRODUCTS.filter(p=>p.category==='Ropa' && zyRopaGroupOf(p)===g.key).length;
        return `<label class="filter-opt"><input type="checkbox" ${filters.ropaGroups.has(g.key)?'checked':''} onchange="toggleFilter('ropaGroups','${g.key}')">${g.label} <span style="color:var(--steel);">(${n})</span></label>`;
      }).join('');
    }
