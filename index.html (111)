/* ================= PDP ================= */
/* [SEO] Rellena el <script id="zyProductSchema"> con los datos reales de la
   pieza (precio, disponibilidad, marca, SKU) para resultados enriquecidos
   en Google. Se vuelve a llamar cada vez que se abre una ficha de producto. */
async function zyUpdateProductSchema(p){
  const el = document.getElementById('zyProductSchema');
  if(!el) return;
  const totalStock = Object.values(p.stock||{}).reduce((a,b)=>a+b,0);

  // AggregateRating: le dice a Google que muestre las estrellitas ⭐ en el
  // resultado de búsqueda. Se calcula de las reseñas reales del producto —
  // si todavía no tiene ninguna, se omite por completo (Google penaliza el
  // schema con ratings inventados o de productos sin reseñas de verdad).
  let aggregateRating;
  try{
    const reviews = await zyGetReviews(p.id);
    if(reviews && reviews.length){
      const avg = reviews.reduce((a,r)=>a+r.stars,0) / reviews.length;
      aggregateRating = {
        "@type": "AggregateRating",
        "ratingValue": avg.toFixed(1),
        "reviewCount": reviews.length
      };
    }
  }catch(e){ /* sin reseñas todavía o sin conexión: se omite aggregateRating */ }

  const schema = {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": `${p.brand} ${p.name}`,
    "image": (p.images && p.images[0]) ? [p.images[0]] : undefined,
    "description": p.desc || undefined,
    "sku": p.sku || undefined,
    "brand": { "@type": "Brand", "name": p.brand },
    "aggregateRating": aggregateRating,
    "offers": {
      "@type": "Offer",
      "url": `https://zayde-kappa.vercel.app/producto/${p.id}`,
      "priceCurrency": "MXN",
      "price": p.price,
      "availability": totalStock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
      "itemCondition": p.line === 'Nuevo' ? "https://schema.org/NewCondition" : "https://schema.org/UsedCondition"
    }
  };
  el.textContent = JSON.stringify(schema);
}
function zyClearProductSchema(){
  const el = document.getElementById('zyProductSchema');
  if(el) el.textContent = '';
}
/* [PERFUMES] Llena ESPECIFICACIONES (Presentación de fragancia, Notas) y DETALLES (Aroma,
   Colección, Género) de la ficha técnica. Cada fila se oculta si no tiene dato, y cada
   encabezado se oculta si todas sus filas están vacías. */
function zyRenderPerfumeFacts(p){
  const body = document.getElementById('pdpFragBody');
  if(!body) return;
  if(!p || !zyIsPerfumeCat(p.category)){ body.style.display = 'none'; return; }
  const notes = Array.isArray(p.fragNotes) ? p.fragNotes.filter(Boolean) : [];
  const rows = [
    ['pdpFragPresentation', p.fragPresentation || ''],
    ['pdpFragNotes',        notes.join(', ')]
  ];
  rows.forEach(([id, val])=>{
    const td = document.getElementById(id);
    td.textContent = val;
    td.closest('.fact-row').style.display = val ? '' : 'none';
  });
  const hasSpec = !!(rows[0][1] || rows[1][1]);
  document.getElementById('pdpFragSpecHead').style.display = hasSpec ? '' : 'none';
  body.style.display = hasSpec ? '' : 'none';
}
/* [DETALLES] Acordeón "Detalles" del producto: ropa (tipo de prenda, corte, cuello, manga, diseño…) o
   perfumes (aroma, colección, género). Cada fila solo sale si tiene dato; sin datos, el acordeón se oculta. */
function zyRenderRelojFacts(p){
  const body = document.getElementById('pdpRelojDisplayBody');
  if(!body) return;
  const d = (p && zyIsRelojCat(p.category) && p.relojDisplay) || {};
  const vals = [['pdpRelojDiametro', Number(d.diametro) > 0 ? Number(d.diametro) + ' mm' : ''], ['pdpRelojDispMaterial', d.material || '']];
  vals.forEach(([id, v])=>{ const td = document.getElementById(id); td.textContent = v; td.closest('.fact-row').style.display = v ? '' : 'none'; });
  body.style.display = (vals[0][1] || vals[1][1]) ? '' : 'none';
}
function zyRenderPdpSpecs(p){
  const item = document.getElementById('pdpSpecsItem'), body = document.getElementById('pdpSpecsBody');
  if(!item || !body) return;
  const sp = (p && zyIsRelojCat(p.category) && p.relojSpecs) || {};
  const rows = [['Tipo de cristal', sp.cristal], ['Resistente al agua', sp.agua], ['Carátula', sp.caratula], ['Movimiento', sp.movimiento], ['Extensible', sp.extensible]].filter(([, v])=> v);
  body.innerHTML = rows.map(([l, v])=> `<tr class="fact-row"><th scope="row">${zyEscapeHtml(l)}</th><td>${zyEscapeHtml(v)}</td></tr>`).join('');
  item.style.display = rows.length ? '' : 'none';
}
function zyRenderPdpDetails(p){
  const item = document.getElementById('pdpDetailsItem');
  const body = document.getElementById('pdpDetailsBody');
  if(!item || !body) return;
  const rows = [];   // [etiqueta, valor]; ['__group', título] = encabezado de bloque
  if(p && zyIsPerfumeCat(p.category)){
    [['Aroma', p.fragAroma], ['Colección', p.fragCollection], ['Género', p.fragGender]].forEach(([l, v])=>{ if(v) rows.push([l, v]); });
  } else if(p && zyIsRopaCat(p.category)){
    const d = p.ropaDetails || {};
    ZY_ROPA_DETAIL_ORDER.forEach(k=>{ if(d[k]) rows.push([ZY_ROPA_FIELDS[k].label, d[k]]); });
  } else if(p && zyIsBolsoCat(p.category)){
    const b = p.bolsoDetails || {};
    const dims = [['Alto', b.alto], ['Ancho', b.ancho], ['Profundo', b.profundo]].filter(([, v])=> Number(v) > 0);
    if(dims.length){
      rows.push(['__group', 'Dimensiones']);
      dims.forEach(([l, v])=> rows.push([l, Number(v) + ' cm']));   // el número se muestra siempre en cm
    }
    [['Silueta', b.silueta], ['Colección', b.coleccion], ['Ocasión', b.ocasion], ['Género', b.genero], ['Estilo', b.estilo], ['Compartimentos', b.compartimentos]]
      .forEach(([l, v])=>{ if(v) rows.push([l, v]); });
  } else if(p && zyIsRelojCat(p.category)){
    const r = p.relojDetails || {};
    [['Colección', r.coleccion], ['Género', r.genero]].forEach(([k, v])=>{ if(v) rows.push([k, v]); });
  } else if(p && zyIsLentesCat(p.category)){
    const l = p.lentesDetails || {};
    [['Tipo de lentes', l.tipo], ['Género', l.genero]].forEach(([k, v])=>{ if(v) rows.push([k, v]); });
  } else if(p && zyIsJoyCat(p.category)){
    const j = p.joyDetails || {};
    const dims = [['Largo', Number(j.largo) > 0 ? Number(j.largo) + ' cm' : ''], ['Ancho / Grosor', Number(j.grosor) > 0 ? Number(j.grosor) + ' mm' : '']].filter(([, v])=> v);
    if(dims.length){ rows.push(['__group', 'Dimensiones']); dims.forEach(([l, v])=> rows.push([l, v])); }
    if(Number(j.peso) > 0) rows.push(['Peso', Number(j.peso) + (j.pesoUnit === 'kg' ? ' kg' : ' g')]);
    if(Number(j.kilataje) > 0) rows.push(['Kilataje', Number(j.kilataje) + 'k']);
    [['Tipo de Joyería', j.tipo], ['Broche', j.broche], ['Género', j.genero], ['Tipo de piedra', j.piedra]].forEach(([l, v])=>{ if(v) rows.push([l, v]); });
  } else if(p && zyIsSneakerCat(p.category)){
    const s = zySneakerResolve(p);
    [['Tipo de Calzado', s.tipo], ['Suela', s.suela], ['Género', s.genero], ['Estilo', s.estilo]].forEach(([k, v])=>{ if(v) rows.push([k, v]); });
  } else if(p && zyIsGorraCat(p.category)){
    const g = p.gorraDetails || {};
    [['Colección', g.coleccion], ['Género', g.genero], ['Tipo de gorra', g.tipo]].forEach(([k, v])=>{ if(v) rows.push([k, v]); });
  }
  body.innerHTML = rows.map(([l, v])=> l === '__group'
    ? `<tr class="fact-group"><th colspan="2" scope="colgroup">${zyEscapeHtml(v)}</th></tr>`
    : `<tr class="fact-row"><th scope="row">${zyEscapeHtml(l)}</th><td>${zyEscapeHtml(v)}</td></tr>`).join('');
  item.style.display = rows.length ? '' : 'none';
  zyRenderGorraPics(p);   // [GORRAS] imagen de silueta + "Cómo saber tu talla" (se oculta sola en otras categorías)
}
function zyOpenPDPCore(id, skipPush){
