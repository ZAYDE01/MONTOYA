    // Sin lanzamientos reales configurados todavía: se oculta toda la
    // sección en vez de mostrar productos de ejemplo/inventados — así el
    // catálogo de "Próximos lanzamientos" solo muestra piezas reales tuyas.
    if(upcomingSection) upcomingSection.style.display = 'none';
