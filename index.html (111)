/* ============================================================
   [AUTH REAL] Firebase Auth es la fuente de verdad de la sesión.
   Este listener se dispara solo al cargar la página (con el usuario
   real, si Firebase ya lo tenía guardado) y cada vez que alguien
   inicia/cierra sesión real (correo+contraseña o Google) desde
   cualquier pestaña. Así el carrito/favoritos de CADA cuenta quedan
   separados de verdad por su uid único de Firebase, en vez de
   adivinarse por nombre escrito a mano como antes.

   [FIX] "El login no funciona / al cerrar sesión siguen apareciendo
   los productos y pedidos de antes": este listener y las funciones
   emailLogin()/googleLogin() estaban haciendo el MISMO trabajo dos
   veces en paralelo — ambos llaman a setUser(), que fusiona el
   carrito de invitado a la cuenta y borra el de invitado. Firebase
   dispara este listener en un momento que no está garantizado
   (a veces ANTES de que emailLogin/googleLogin terminen), así que
   podían pisarse entre sí: el listener cargaba el carrito de la
   cuenta (sin fusionar) ANTES de que emailLogin alcanzara a fusionar
   el carrito de invitado, y para cuando emailLogin corría su propia
   fusión, la variable `cart` ya no tenía los artículos de invitado
   originales — se perdían en la fusión y, según el orden exacto,
   el carrito/pedidos de una sesión anterior podían quedar pegados.

   La corrección: mientras un login EXPLÍCITO (el usuario tocó
   "Iniciar sesión" o "Google") está en curso, este listener se hace
   a un lado por completo (ver zyExplicitAuthInProgress) y deja que
   emailLogin()/googleLogin() sean la ÚNICA fuente de verdad para esa
   fusión. El listener solo actúa por su cuenta cuando NO hay un login
   explícito en curso: al cargar la página con una sesión ya guardada
   por Firebase, o si la sesión se cierra/expira desde otra pestaña.
   ============================================================ */
  if(typeof firebase !== 'undefined' && firebaseReady){
    firebase.auth().onAuthStateChanged(async (user)=>{
      if(zyExplicitAuthInProgress) return; // emailLogin()/googleLogin() ya se están encargando de este mismo cambio de sesión
      // [FIX — "al avanzar el pedido desde el panel, al cliente se le borra"]
      // Entrar al panel privado hace signInWithEmailAndPassword con la cuenta
      // ADMIN de Firebase. Este listener no distinguía eso de un cliente que
      // inicia sesión: convertía la sesión del admin en la "cuenta" de quien
      // estaba navegando, cambiaba userKey() y, como zyMyOrders() filtra por
      // dueño, los pedidos hechos como invitado dejaban de mostrarse (parecía
      // que se "eliminaban"). Ahora la sesión admin se ignora aquí.
      if(user && zyIsAdminAuthUser(user)) return;
      if(user){
        if(currentUser && currentUser.uid === user.uid) return; // ya reflejado, evita recargar de más
        const name = user.displayName || (user.email ? user.email.split('@')[0] : 'Cliente');
        const provider = (user.providerData[0] && user.providerData[0].providerId === 'google.com') ? 'Google' : 'correo';
        currentUser = { name, provider, uid: user.uid, email: user.email || null, createdAt: (user.metadata && user.metadata.creationTime) ? new Date(user.metadata.creationTime).toISOString() : null };
        const slot = document.getElementById('accountSlot');
        if(slot) slot.innerHTML = accountChipHTML(currentUser);
        await Store.set('zayde:session', currentUser);
        await loadAccountData(false);
        zyUpdateOrderBadge();
        zyLoadRecentOrder();
      } else if(currentUser && currentUser.uid){
        // Firebase ya no tiene sesión activa (expiró o se cerró en otro dispositivo)
        currentUser = null;
        const slot = document.getElementById('accountSlot');
        if(slot) slot.innerHTML = accountGuestHTML();
        await Store.set('zayde:session', null);
        await loadAccountData(false);
        zyUpdateOrderBadge();
        zyLoadRecentOrder();
      }
    });
  }
}
// El documento puede terminar de parsearse (y disparar 'DOMContentLoaded')
