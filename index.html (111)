        <span class="review-item-date">${new Date(r.date).toLocaleDateString('es-MX')}</span>
      </div>
      <div class="review-item-stars">${'★'.repeat(r.stars)}${'☆'.repeat(5-r.stars)}</div>
      <div class="review-item-text">${zyEscapeHtml(r.text)}</div>
      ${(r.images && r.images.length) ? `<div class="review-item-photos">${r.images.map(src=>`<div class="review-photo" onclick="event.stopPropagation();zyOpenReviewPhoto('${src.replace(/'/g,"\\'")}')"><img src="${src}" alt="Foto del pedido enviada por ${zyEscapeHtml(r.name)}" loading="lazy"></div>`).join('')}</div>` : ''}
    </div>`).join('');
}
let zyReviewSubmitting = false;
async function zySubmitReview(){
  if(!currentProduct) return;
  // [FIX doble envío] Sin este bloqueo, si la red iba lenta y alguien le
  // daba clic dos veces a "Publicar reseña" (algo muy común mientras se
  // espera), se mandaban dos peticiones y quedaban dos reseñas duplicadas.
  if(zyReviewSubmitting) return;
  const name = document.getElementById('reviewName').value.trim();
  const phone = document.getElementById('reviewPhone').value.trim();
  const text = document.getElementById('reviewText').value.trim();
  if(!zyCurrentReviewStars){ showToast('Selecciona una calificación en estrellas', true); return; }
  if(!name){ showToast('Escribe tu nombre para publicar la reseña', true); return; }
  if(!text){ showToast('Escribe unas palabras sobre la pieza', true); return; }

  zyReviewSubmitting = true;
  const submitBtn = document.getElementById('reviewSubmitBtn');
  const originalBtnText = submitBtn ? submitBtn.textContent : '';
  if(submitBtn){ submitBtn.disabled = true; submitBtn.style.opacity = '.6'; submitBtn.style.cursor = 'not-allowed'; submitBtn.textContent = 'Publicando…'; }

  try{
    // [SEGURIDAD] La reseña se manda al servidor (/api/submit-review), que:
    //   1) checa ahí mismo (con la llave privada de Firebase, nunca en el
    //      navegador) si el teléfono coincide con un pedido real de esta
    //      pieza, para poner la bandera "Compra verificada", y
    //   2) guarda la reseña en Firestore.
    // Esto evita DOS problemas del diseño anterior: (a) que el navegador
    // tuviera que descargar los 500 pedidos más recientes —con nombre,
    // teléfono y dirección de TODOS los clientes— nada más para comparar un
    // teléfono, y (b) que alguien con las herramientas de desarrollador
    // pudiera escribir una reseña marcada como "verificada" sin haber
    // comprado nada (si el navegador escribe directo a Firestore, nada le
    // impide mandar verifiedPurchase:true él mismo).
    const reviewDoc = { productId:String(currentProduct.id), name, text, stars: zyCurrentReviewStars, images: zyReviewImages.slice(0,6) };
    let verifiedPurchase = false;
    let savedOk = false;
    try{
      const resp = await fetch('/api/submit-review', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(Object.assign({}, reviewDoc, { phone }))
      });
      const data = await resp.json().catch(()=>({}));
      if(resp.ok && data.success){ savedOk = true; verifiedPurchase = !!data.verified; }
    }catch(e){ console.error('No se pudo contactar /api/submit-review:', e); }

    if(!savedOk){
      // Respaldo local si el endpoint no está desplegado todavía o falló la red —
      // así no se pierde la reseña, pero no se puede confiar en "verificada" aquí.
      const reviews = await AdminStore.get('zayde:reviews:'+currentProduct.id) || [];
      reviews.push(Object.assign({}, reviewDoc, { date: Date.now(), verifiedPurchase:false }));
      await AdminStore.set('zayde:reviews:'+currentProduct.id, reviews);
    }

    document.getElementById('reviewName').value = '';
    document.getElementById('reviewPhone').value = '';
    document.getElementById('reviewText').value = '';
    zyReviewImages = [];
    document.getElementById('reviewImages').value = '';
    document.getElementById('reviewThumbs').innerHTML = '';
    zySetReviewStars(0);
    showToast(verifiedPurchase ? '¡Gracias por tu reseña! Se marcó como compra verificada ✓' : '¡Gracias por tu reseña!');
    zyRenderReviews(currentProduct.id);
  } finally {
    // [FIX doble envío] Pase lo que pase (éxito o error), siempre se
    // libera el bloqueo y se reactiva el botón — así nunca se queda
    // "trabado" en Publicando… para siempre.
    zyReviewSubmitting = false;
    if(submitBtn){ submitBtn.disabled = false; submitBtn.style.opacity = ''; submitBtn.style.cursor = ''; submitBtn.textContent = originalBtnText; }
  }
}

