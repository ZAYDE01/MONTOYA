/* Crea el PaymentIntent en el backend (/api/create-payment-intent.js) y confirma
   el cobro con los datos de la tarjeta capturados por el Card Element de Stripe.
   Devuelve {success:true, paymentIntentId} o {success:false, error}. */
// [SESIÓN VERIFICADA] Token de Firebase de la cuenta actual: el servidor lo comprueba para saber de verdad quién compra
// (membresías y saldo de tarjetas de regalo ya no se confían al navegador).
async function zyGetIdToken(){
  try{
    const u = (typeof firebase !== 'undefined' && firebase.auth) ? firebase.auth().currentUser : null;
    return u ? await u.getIdToken() : null;
  }catch(e){ return null; }
}
async function zyChargeWithStripe(amountMXN, description, billingName, orderNum, digital){
  if(!stripeClient || !stripeCardElement){
    return { success:false, error:'El pago con tarjeta no está configurado todavía en este sitio (falta la llave pública de Stripe).' };
  }
  try{
    const resp = await fetch('/api/create-payment-intent', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ amount: Math.round(amountMXN*100), currency:'mxn', description, orderNum, digital: digital || undefined, idToken: await zyGetIdToken() })
    });
    const data = await resp.json();
    if(!resp.ok || !data.clientSecret){
      return { success:false, error: data.error || 'No se pudo iniciar el cobro. Intenta de nuevo.' };
    }
    const result = await stripeClient.confirmCardPayment(data.clientSecret, {
      payment_method: { card: stripeCardElement, billing_details: { name: billingName || undefined } }
    });
    if(result.error){
      return { success:false, error: result.error.message || 'Tu pago no pudo completarse.' };
    }
    if(result.paymentIntent && result.paymentIntent.status === 'succeeded'){
      // [NUEVO] Consulta la marca y últimos 4 dígitos de la tarjeta usada,
      // para poder mostrarlos luego en "Datos del pedido" (ej. "VISA ····9578"),
      // igual que hacen apps como Nike. Si esta consulta falla por lo que
      // sea, el pago YA se completó de todas formas — solo no se mostrará
      // el detalle de la tarjeta, nada se rompe.
      let cardBrand = null, cardLast4 = null;
      try{
        const cardRes = await fetch('/api/create-payment-intent?paymentIntentId=' + encodeURIComponent(result.paymentIntent.id));
        const cardData = await cardRes.json();
        if(cardRes.ok){ cardBrand = cardData.brand || null; cardLast4 = cardData.last4 || null; }
      }catch(e){ console.error('No se pudo obtener marca/últimos 4 de la tarjeta:', e); }
      return { success:true, paymentIntentId: result.paymentIntent.id, cardBrand, cardLast4 };
    }
    return { success:false, error:'El pago quedó pendiente de confirmación. Intenta con otro método.' };
  }catch(e){
    console.error('Error al cobrar con Stripe:', e);
    return { success:false, error:'No se pudo conectar con el servidor de pagos. Revisa tu conexión.' };
  }
}
</script>

