let zyExperiences = [];
function zyExpEmbedHTML(url){
  url = (url||'').trim();
  const yt = url.match(/(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|shorts\/|embed\/))([\w-]{6,})/);
  if(yt){
    return `<iframe src="https://www.youtube.com/embed/${yt[1]}?autoplay=1&playsinline=1" style="width:100%;height:100%;border:0;" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>`;
  }
  if(/\.(mp4|webm|mov)(\?|$)/i.test(url) || url.startsWith('data:video')){
    return `<video src="${zyEscapeHtml(url)}" style="width:100%;height:100%;object-fit:contain;" controls autoplay playsinline></video>`;
  }
  return `<div style="color:#fff; display:flex; align-items:center; justify-content:center; height:100%; padding:24px; text-align:center; font-size:13px;">No se pudo reproducir este video. <a href="${zyEscapeHtml(url)}" target="_blank" rel="noopener" style="color:var(--signal); margin-left:4px;">Abrir enlace</a></div>`;
}
