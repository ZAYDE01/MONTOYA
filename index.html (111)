function zySlugify(text){
  return (text||'').toString()
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'') // quita acentos (Hermès -> Hermes)
    .toLowerCase()
    .replace(/[^a-z0-9]+/g,'-')
    .replace(/^-+|-+$/g,'')
    .slice(0,60) || 'producto';
}
const ZY_DEFAULT_OG_IMAGE = 'https://zayde-kappa.vercel.app/zayde-og-v3.jpg';
function zySetMeta(title, description, image){
  document.title = title;
  const desc = document.querySelector('meta[name="description"]');
  if(desc) desc.setAttribute('content', description);
  const ogTitle = document.querySelector('meta[property="og:title"]');
  if(ogTitle) ogTitle.setAttribute('content', title);
  const ogDesc = document.querySelector('meta[property="og:description"]');
  if(ogDesc) ogDesc.setAttribute('content', description);
  const ogImage = document.querySelector('meta[property="og:image"]');
  if(ogImage) ogImage.setAttribute('content', image || ZY_DEFAULT_OG_IMAGE);
}
function zyPushURL(path, title, description, image){
  zySetMeta(title, description, image);
  const canonical = document.querySelector('link[rel="canonical"]');
  const base = canonical ? canonical.href.replace(/\/$/,'').replace(/\/(catalogo|producto|favoritos|mayoreo)(\/.*)?$/,'') : '';
  if(canonical) canonical.href = base + path;
  const ogUrl = document.querySelector('meta[property="og:url"]');
  if(ogUrl) ogUrl.setAttribute('content', base + path);
  // try/catch: si el archivo se abre directo desde el disco (file://) en vez de
  // desde un servidor, el navegador bloquea pushState — el sitio debe seguir
  // funcionando igual, solo sin cambiar la URL visible.
  try{
    if(location.pathname !== path) history.pushState({ zyPath:path }, '', path);
  }catch(e){ /* file:// u otro contexto sin permiso para cambiar la URL */ }
}
/* Interpreta la URL actual (al cargar el sitio o al usar atrás/adelante del
   navegador) y muestra la vista correspondiente. Devuelve true si reconoció
   la ruta, para que quien la llame sepa si debe hacer algo por default. */
function zyRouteFromLocation(){
  const path = location.pathname.replace(/\/+$/,'') || '/';
  const productMatch = path.match(/^\/producto\/(\d+)/);
  if(productMatch){
    const id = Number(productMatch[1]);
    if(PRODUCTS.find(p=>p.id===id)){ openPDP(id, true); return true; }
    navigate('404', true); return true;
  }
  const catMatch = path.match(/^\/catalogo\/([a-z0-9-]+)/);
  if(catMatch){
    const cat = CATS.find(c=>zySlugify(c)===catMatch[1]);
    navCatName(cat || null, true);
    return true;
  }
  if(path === '/catalogo'){ navCatName(null, true); return true; }
  if(path === '/favoritos'){ navigate('favorites', true); return true; }
  if(path === '/mayoreo'){ navigate('mayoreo', true); return true; }
  if(path === '/cuenta'){ navigate('account', true); return true; }
  if(path === '/club'){ navigate('club', true); return true; }
  // [FIX 404 ZAYDE G] La URL real que se empuja al navegador para esta
  // página es '/clothes-g' (ver ROUTES.ropag más abajo), pero aquí se
  // seguía comparando contra '/ropa-g' — un nombre de ruta viejo que ya
  // no se usa en ningún otro lado. Como nunca hacía match, cualquier
  // recarga, link compartido, o atrás/adelante del navegador sobre
  // /clothes-g caía directo al 404 en vez de mostrar ZAYDE G.
  if(path === '/clothes-g'){ navigate('ropag', true); return true; }
  if(path === '/tarjeta-de-regalo'){ navigate('giftcard', true); return true; }
  if(path === '/buscar'){ navigate('search', true); return true; }
  if(path === '/pedidos'){ navigate('tracking', true); return true; }
  if(path === '/contacto'){ navigate('contacto', true); return true; }
  { const s=path.replace(/^\//,''); const tab=Object.keys(ZY_INFO).find(k=>ZY_INFO[k][0]===s); if(tab){ zyOpenInfo(tab,true); return true; }
    const cat=(typeof CATS!=='undefined'?CATS:[]).find(c=>zySlug(c)===s); if(cat){ navCatName(cat); return true; } }
  if(path === '/' || path === ''){ navigate('home', true); return true; }
  // [FIX 404] Antes cualquier URL no reconocida caía aquí como "false" y
  // el arranque del sitio la mandaba al inicio en silencio (ver más abajo),
  // sin avisarle a nadie que el link al que entraron no existe. Ahora
  // muestra la página 404 en vez de fingir que todo está bien.
  navigate('404', true);
  return true;
}
