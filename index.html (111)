/* ================= RANGO DE PRECIO DOBLE (mín. y máx.) =================
   Reemplaza al slider de un solo extremo (que solo dejaba poner un precio
   "máximo"). Son dos <input type="range"> superpuestos con un track común
   pintado por debajo (.dual-range-bg / .dual-range-fill); "changed" es el
   input que disparó el evento, para saber cuál empujar si se cruzan. */
function zyUpdatePriceRange(changed){
  const minEl = document.getElementById('priceRangeMin');
  const maxEl = document.getElementById('priceRangeMax');
  if(!minEl || !maxEl) return;
  const step = parseInt(minEl.step) || 100;
  let minV = parseInt(minEl.value), maxV = parseInt(maxEl.value);
  if(changed === minEl && minV > maxV - step){ minV = maxV - step; minEl.value = minV; }
  if(changed === maxEl && maxV < minV + step){ maxV = minV + step; maxEl.value = maxV; }
  zyRenderPriceRangeUI(minV, maxV);
  if(document.getElementById('catalogGrid')) renderCatalog();
}
function zyRenderPriceRangeUI(minV, maxV){
  const minEl = document.getElementById('priceRangeMin');
  const maxEl = document.getElementById('priceRangeMax');
  const lo = minEl ? parseInt(minEl.min) : 500;
  const hi = minEl ? parseInt(minEl.max) : PRICE_RANGE_NO_LIMIT_AT + 100;
  const minValEl = document.getElementById('priceValMin');
  const maxValEl = document.getElementById('priceValMax');
  if(minValEl) minValEl.textContent = '$'+Number(minV).toLocaleString();
  if(maxValEl){
    const cappedMax = zyPriceRangeValue(maxV);
    maxValEl.textContent = cappedMax === Infinity ? 'Sin límite' : ('$'+Number(cappedMax).toLocaleString());
  }
  const fill = document.getElementById('dualRangeFill');
  if(fill){
    const pctMin = ((minV-lo)/(hi-lo))*100;
    const pctMax = ((maxV-lo)/(hi-lo))*100;
    fill.style.left = pctMin+'%';
    fill.style.right = (100-pctMax)+'%';
  }
}
