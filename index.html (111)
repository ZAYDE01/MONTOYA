function zyMaterialsForSection(sec){
  const nrm = t => String(t||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim();
  const c = nrm(sec);
  const uniq = arr => Array.from(new Set(arr));
  if(/^ropa/.test(c)) return uniq(ZY_MAT_ROPA);
  if(/perfum|fragan/.test(c)) return uniq(ZY_MAT_PERFUMES);
  if(/^bols/.test(c)) return uniq(ZY_MAT_BOLSOS);
  if(/^tenis|^sneaker|^zapato|^calzado/.test(c)) return uniq(ZY_MAT_OTHER["Zapatos"]);
  if(/^joy/.test(c)) return uniq(["Bañado de oro","Oro"].concat(ZY_MAT_OTHER["Joyería"]));
  if(/^gafa/.test(c)) return uniq(ZY_MAT_OTHER["Lentes"]);
