/* ============================================================
   [SEGURIDAD] Las reseñas viven en su PROPIA colección de Firestore
   ("reviews"), separada de admin_meta a propósito: cualquier cliente
   (sin iniciar sesión) puede publicar una reseña, pero NO debe poder
   escribir en admin_meta/admin_products/admin_overrides (eso es solo
   para el panel admin). Con reviews en su propia colección, las Reglas
   de Firestore pueden permitir "create" público en "reviews" sin abrir
   nada más. Ver firestore.rules.
   ============================================================ */
async function zyGetReviews(productId){
  if(db){
    try{
      const snap = await db.collection('reviews').where('productId','==',String(productId)).get();
      const list = snap.docs.map(d=>d.data());
      list.sort((a,b)=>(b.date||0)-(a.date||0));
      return list;
    }catch(e){ console.error('No se pudieron leer las reseñas de Firestore, se usa el respaldo local:', e); }
  }
  const all = await AdminStore.get('zayde:reviews:'+productId);
  return Array.isArray(all) ? all : [];
}
async function zyRenderReviews(productId){
