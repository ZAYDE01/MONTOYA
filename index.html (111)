function zyRopaGroupDef(key){ return ZY_ROPA_GROUPS.find(g=>g.key===key) || null; }
/* Para productos que ya existían sin sección: se deduce por el nombre (Playera…, Pants…, Hoodie…). */
function zyRopaGroupOf(p){
  if(!p || !zyIsRopaCat(p.category)) return '';
  if(p.ropaGroup) return p.ropaGroup;
  const n = (typeof normText === 'function' ? normText(p.name) : String(p.name||'').toLowerCase());
  const rules = [
    [/calcet|calceta|pantimedia/, 'Calcetines'],
    [/boxer|brief|calzon|ropa interior|tanga/, 'Calzones / Boxers'],
    [/traje de bano|bikini|rashguard/, 'Trajes de baño'],
    [/(^|\s)polo(\s|$)/, 'Polos'],
    [/playera|camiseta|t-?shirt|(^|\s)tee(\s|$)|henley|tank/, 'Playeras'],
    [/camisa|blusa|guayabera|overshirt/, 'Camisas'],
    [/hoodie|sudadera|crewneck|sweatshirt/, 'Sudaderas y hoodies'],
    [/sueter|cardigan|tejid|jersey|pullover/, 'Suéteres y tejidos'],
    [/chaqueta|chamarra|bomber|windbreaker|rompevientos|parka|abrigo|gabardina|blazer|(^|\s)saco(\s|$)|chaleco|jacket|coat|puffer/, 'Chamarras y abrigos'],
    [/pantalon|jean|jogger|cargo|pants|chino|short|bermuda|legging/, 'Pantalones'],
    [/vestido|falda/, 'Vestidos y faldas'],
    [/traje|conjunto/, 'Trajes y conjuntos']
  ];
  for(const [re, g] of rules){ if(re.test(n)) return g; }
  return '';
}

