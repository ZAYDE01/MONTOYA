// asumir que el evento todavía no ocurrió.
if(document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', zyBootFirebase);
} else {
  zyBootFirebase();
}

/* ============================================================
   [FOTOS] Subida de imágenes con Cloudinary (gratis, sin tarjeta) en vez
   de guardarlas como base64 en Firestore o de usar Firebase Storage
   (que desde feb-2026 exige el plan de pago Blaze).

   Hay TRES caminos distintos a propósito:

   1) Fotos de RESEÑA (folder === 'reviews'): cualquier visitante puede
      publicar una reseña sin cuenta, así que la foto se sube directo
      desde el navegador a Cloudinary usando un "upload preset" sin firmar
      (unsigned). Esto es público por diseño — igual que ya era público
      escribir una reseña — pero configura el preset en Cloudinary con
      límites de tamaño/formato para evitar abuso (ver LEEME-SEGURIDAD.md).

   2) Fotos de PRODUCTO y de EXPERIENCIAS (solo panel admin): estas NO se
      suben directo a Cloudinary desde el navegador, porque un preset
      "unsigned" es público para cualquiera que vea el código fuente, sin
      importar si tiene tu contraseña o no. En vez de eso, se manda al
      endpoint /api/admin-upload-image, que primero verifica tu sesión de
      Firebase Auth (el mismo login del panel admin) y solo entonces sube
      la imagen a Cloudinary usando la llave privada (que vive únicamente
      en el servidor, nunca en este archivo).

   3) Video de VITRINAS (solo panel admin, pestaña "Vitrinas"): un video
      pesa demasiado para viajar como texto base64 dentro de una petición
      a una función serverless de Vercel (tope de ~4.5MB por petición), así
      que NO puede seguir el mismo camino que las fotos de producto. Se
      sube directo del navegador a Cloudinary con su propio preset
      "unsigned" — igual que las fotos de reseña — protegido en la
      práctica porque el campo para subirlo solo vive dentro del panel
      admin (ya detrás de tu login). Aun así, igual que con el preset de
      reseñas, cualquiera que vea el código fuente podría encontrar el
      nombre de este preset y subir un video directo a tu cuenta sin pasar
      por tu sitio — por eso, al crear el preset en Cloudinary, configúralo
      con un límite de tamaño (50-60MB recomendado) y solo formatos de
      video (mp4/mov/webm) para acotar el posible abuso.

   CONFIGURACIÓN REQUERIDA (ver LEEME-SEGURIDAD.md para el paso a paso):
   - Crea una cuenta gratuita en cloudinary.com (no pide tarjeta).
   - Copia tu "Cloud name" y reemplaza ZY_CLOUDINARY_CLOUD_NAME abajo.
   - Crea un "Upload preset" en modo "Unsigned" solo para reseñas y
     reemplaza ZY_CLOUDINARY_UPLOAD_PRESET_REVIEWS por su nombre.
   - Crea OTRO "Upload preset" en modo "Unsigned", con resource type
     "Video" y un límite de tamaño (50-60MB), solo para las vitrinas del
     inicio, y reemplaza ZY_CLOUDINARY_UPLOAD_PRESET_VIDEOS por su nombre.
   - En Vercel, agrega las variables de entorno CLOUDINARY_CLOUD_NAME,
     CLOUDINARY_API_KEY y CLOUDINARY_API_SECRET (las dos últimas son
     privadas, solo las usa /api/admin-upload-image.js).
   ============================================================ */
const ZY_CLOUDINARY_CLOUD_NAME = "jaxxxdbq"; // <- tu "Cloud name" de Cloudinary
const ZY_CLOUDINARY_UPLOAD_PRESET_REVIEWS = "zayde_reviews_unsigned"; // <- preset "Unsigned" creado solo para fotos de reseña
const ZY_CLOUDINARY_UPLOAD_PRESET_VIDEOS = "zayde_promo_videos_unsigned"; // <- preset "Unsigned" (resource type Video) creado solo para video de vitrinas

/* Redimensiona y comprime una imagen en el navegador antes de guardarla como
   data URL. Se usa para portadas de categoría (varias viven juntas en un
   solo documento de Firestore, así que deben pesar poco — a diferencia de
   las fotos de producto, que van a Cloudinary). */
function zyCompressImageFile(file, maxWidth, quality){
  return new Promise((resolve, reject)=>{
    const img = new Image();
    const reader = new FileReader();
    reader.onload = ()=>{ img.onload = ()=>{
      const scale = Math.min(1, (maxWidth||640) / img.width);
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(img.width * scale);
      canvas.height = Math.round(img.height * scale);
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
      resolve(canvas.toDataURL('image/jpeg', quality||0.75));
    }; img.onerror = ()=>reject(new Error('No se pudo procesar la imagen.')); img.src = reader.result; };
    reader.onerror = ()=>reject(new Error('No se pudo leer el archivo.'));
    reader.readAsDataURL(file);
  });
}
function zyFileToDataUrl(file){
  return new Promise((resolve, reject)=>{
    const reader = new FileReader();
    reader.onload = ()=>resolve(reader.result);
    reader.onerror = ()=>reject(new Error('No se pudo leer el archivo.'));
    reader.readAsDataURL(file);
  });
}

// [PERF] Cloudinary puede servir cada foto en WebP/AVIF automáticamente
// (según lo que acepte el navegador de quien la ve) y con compresión de
// calidad automática, sin necesidad de guardar una segunda copia — basta con
// insertar la transformación f_auto,q_auto en la URL de entrega. Antes se
// guardaba/mostraba la URL cruda de Cloudinary, que sirve el archivo tal
// cual se subió (típicamente JPEG/PNG), dejando ese ahorro de peso fuera.
// No se hace la conversión a mano en el navegador: Cloudinary decide el
// mejor formato por request según el header Accept, con fallback automático
// en navegadores que no soportan WebP/AVIF.
function zyCdnAuto(url){
  if(!url || typeof url !== 'string') return url;
  if(url.indexOf('res.cloudinary.com') === -1) return url; // no es Cloudinary, se deja tal cual (data URL, etc.)
  if(url.indexOf('/upload/f_auto') !== -1) return url; // ya trae la transformación
  return url.replace('/upload/', '/upload/f_auto,q_auto/');
}
// [PERF — srcset] Igual que arriba con f_auto/q_auto, pero para el ANCHO:
// hoy toda foto sale de Cloudinary a su resolución completa, así que un
// celular descarga lo mismo que un monitor 4K. Esta función inserta w_<N>
// (con c_limit, para nunca AGRANDAR una foto más chica que N) en la misma
// transformación que ya trae la URL. Cubre tanto fotos nuevas (que ya
// llegan con /upload/f_auto,q_auto/...) como fotos viejas subidas antes de
// que existiera esa transformación (URL "cruda" de Cloudinary): a esas
// también se les agrega f_auto,q_auto de paso, sin tener que volver a
// subir nada.
function zyCdnWidth(url, width){
  if(!url || typeof url !== 'string' || url.indexOf('res.cloudinary.com') === -1) return url;
  if(url.indexOf('/upload/f_auto,q_auto/') !== -1){
    return url.replace('/upload/f_auto,q_auto/', `/upload/f_auto,q_auto,w_${width},c_limit/`);
  }
  if(url.indexOf('/upload/') !== -1 && url.indexOf('/upload/f_auto') === -1){
    return url.replace('/upload/', `/upload/f_auto,q_auto,w_${width},c_limit/`);
  }
  return url; // ya trae su propia transformación con ancho — no la tocamos
}
// [PERF — srcset] Arma el atributo srcset completo (3 anchos) para una URL
// de Cloudinary; devuelve '' para todo lo que no sea Cloudinary (data URLs,
// placeholders) para que el <img> simplemente no lleve srcset en esos casos.
function zyCdnSrcset(url){
  if(!url || typeof url !== 'string' || url.indexOf('res.cloudinary.com') === -1) return '';
  return [400,800,1200].map(w=>`${zyCdnWidth(url,w)} ${w}w`).join(', ');
}

async function zyUploadImageFile(file, folder, nameHint){
  if(!file || !file.type || !file.type.startsWith('image/')) throw new Error('El archivo no es una imagen válida.');

  if(folder === 'reviews'){
    // ---- Camino público: sube directo a Cloudinary, sin pasar por
    // nuestro servidor (así funciona hoy el formulario de reseñas, sin
    // cuenta). El límite de tamaño real lo debes fijar en el preset de
    // Cloudinary; aquí solo hay un tope de sanidad en el navegador. ----
    if(file.size > 8 * 1024 * 1024) throw new Error('La imagen pesa más de 8MB — comprímela e intenta de nuevo.');
    if(ZY_CLOUDINARY_CLOUD_NAME.indexOf('TU_CLOUD_NAME') !== -1 || ZY_CLOUDINARY_UPLOAD_PRESET_REVIEWS.indexOf('TU_UPLOAD_PRESET') !== -1){
      throw new Error('Falta configurar Cloudinary en el código (ZY_CLOUDINARY_CLOUD_NAME / ZY_CLOUDINARY_UPLOAD_PRESET_REVIEWS).');
    }
    const fd = new FormData();
    fd.append('file', file);
    fd.append('upload_preset', ZY_CLOUDINARY_UPLOAD_PRESET_REVIEWS);
    fd.append('folder', 'zayde/reviews');
    const resp = await fetch(`https://api.cloudinary.com/v1_1/${ZY_CLOUDINARY_CLOUD_NAME}/image/upload`, { method:'POST', body: fd });
    const data = await resp.json().catch(()=>({}));
    if(!resp.ok || !data.secure_url) throw new Error((data.error && data.error.message) || 'No se pudo subir la imagen.');
    return zyCdnAuto(data.secure_url);
  }

  // ---- Camino admin (products / experiences): pasa por nuestro propio
  // endpoint, que exige la sesión de Firebase Auth del admin antes de
  // hablar con Cloudinary. Límite más bajo (3MB) porque viaja como texto
  // base64 dentro del cuerpo de la petición, y las funciones serverless
  // de Vercel tienen un tope de ~4.5MB por petición. ----
  if(file.size > 3 * 1024 * 1024) throw new Error('La imagen pesa más de 3MB — comprímela e intenta de nuevo.');
  if(typeof firebase === 'undefined' || !firebaseReady || !firebase.auth().currentUser){
    throw new Error('Debes iniciar sesión como admin para subir esta foto.');
  }
  const idToken = await firebase.auth().currentUser.getIdToken();
  const dataUrl = await zyFileToDataUrl(file);
  const resp = await fetch('/api/admin-upload-image', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + idToken },
    body: JSON.stringify({ folder, image: dataUrl, name: nameHint || '' })
  });
  const data = await resp.json().catch(()=>({}));
  if(!resp.ok || !data.success) throw new Error(data.error || 'No se pudo subir la imagen.');
  return zyCdnAuto(data.url);
}

/* Sube un archivo de video (solo se usa desde la pestaña "Vitrinas" del
   panel admin) directo del navegador a Cloudinary, con su propio preset
   "unsigned" — ver la nota de arriba sobre por qué el video no puede
   pasar por /api/admin-upload-image como las fotos. Exige sesión de
   Firebase Auth antes de intentarlo (no evita que alguien use el preset
   fuera del sitio, pero sí evita que un visitante normal lo use desde
   aquí sin querer). */
/* POST con barra de progreso (fetch no da progreso de subida). Devuelve {ok,status,body}. */
function zyXhrPost(url, formData, onProgress){
  return new Promise((resolve, reject)=>{
    const x = new XMLHttpRequest();
    x.open('POST', url);
    x.upload.onprogress = e=>{ if(e.lengthComputable) onProgress(e.loaded / e.total); };
    x.onload = ()=>{ let body = {}; try{ body = JSON.parse(x.responseText || '{}'); }catch(_){} resolve({ ok: x.status>=200 && x.status<300, status: x.status, body }); };
    x.onerror = ()=>reject(new Error('network'));
    x.ontimeout = ()=>reject(new Error('timeout'));
    x.timeout = 10 * 60 * 1000;
    x.send(formData);
  });
}
async function zyUploadVideoFile(file, onProgress){
  // [FIX] Antes esto exigía que file.type empezara con "video/" — pero
  // hay navegadores/celulares que entregan un file.type vacío o raro
  // para ciertos videos (sobre todo .mov de iPhone), y eso lo rechazaba
  // de entrada aunque el archivo fuera un video perfectamente válido.
  // Ahora, si el tipo no viene claro, se revisa la extensión del
  // archivo como respaldo antes de rechazarlo.
  const looksLikeVideo = file && (
    (file.type && file.type.startsWith('video/')) ||
    /\.(mp4|mov|webm|m4v|avi|mkv|3gp|ogv)$/i.test(file.name || '')
  );
  if(!file || !looksLikeVideo) throw new Error('El archivo no parece ser un video (revisa que sea .mp4, .mov o .webm).');
  // [PEDIDO CLIENTE] Se subió el tope de 60MB a 100MB (el máximo que
  // aceptan las cuentas gratis de Cloudinary por archivo) porque el
  // video del hero de pantalla completa venía pesando más de 60MB.
  // OJO: si tu preset "zayde_promo_videos_unsigned" en Cloudinary tiene
  // su PROPIO límite de tamaño configurado más abajo de esto (lo
  // recomendado cuando se creó fue 50-60MB), el navegador va a pasar
  // este límite de aquí pero Cloudinary va a rechazarlo igual con su
  // propio error — en ese caso hay que entrar a cloudinary.com →
  // Settings → Upload → el preset "zayde_promo_videos_unsigned" y subirle
  // el límite ahí también (o subir un video más ligero, ver hint del
  // campo en el admin).
  if(file.size > 100 * 1024 * 1024) throw new Error('El video pesa más de 100MB — comprímelo, o pega un enlace externo (YouTube o .mp4 ya subido) en su lugar.');
  if(ZY_CLOUDINARY_CLOUD_NAME.indexOf('TU_CLOUD_NAME') !== -1 || ZY_CLOUDINARY_UPLOAD_PRESET_VIDEOS.indexOf('TU_UPLOAD_PRESET') !== -1){
    throw new Error('Falta configurar Cloudinary en el código (ZY_CLOUDINARY_UPLOAD_PRESET_VIDEOS).');
  }
  if(typeof firebase === 'undefined' || !firebaseReady || !firebase.auth().currentUser){
    throw new Error('Debes iniciar sesión como admin para subir este video.');
  }
  const fd = new FormData();
  fd.append('file', file, file.name || 'video.mp4');
  fd.append('upload_preset', ZY_CLOUDINARY_UPLOAD_PRESET_VIDEOS);
  fd.append('folder', 'zayde/promobanners');
  // [FIX-DIAGNÓSTICO] Antes, si fetch fallaba por una causa de RED (sin
  // internet, un adblocker/extensión bloqueando la petición a Cloudinary,
  // CORS, etc.) el error genérico del navegador ("Failed to fetch") se
  // colaba tal cual al mensaje, sin explicar qué pasó. Ahora se detecta
  // ese caso aparte y se explica en español. También se deja en la
  // consola SIEMPRE la respuesta completa de Cloudinary (status +
  // cuerpo), para poder diagnosticar cualquier otro rechazo de un vistazo.
  let resp;
  try{
    const vUrl = `https://api.cloudinary.com/v1_1/${ZY_CLOUDINARY_CLOUD_NAME}/video/upload`;
    if(typeof onProgress === 'function'){
      const xr = await zyXhrPost(vUrl, fd, onProgress);
      resp = { ok: xr.ok, status: xr.status, json: ()=>Promise.resolve(xr.body) };
    } else {
      resp = await fetch(vUrl, { method:'POST', body: fd });
    }
  }catch(networkErr){
    console.error('[zyUploadVideoFile] fetch a Cloudinary falló de plano (red/CORS/extensión del navegador):', networkErr);
    throw new Error('No se pudo conectar con Cloudinary (revisa tu internet o si algún bloqueador de anuncios/extensión está frenando la subida).');
  }
  const data = await resp.json().catch(()=>({}));
  console.log('[zyUploadVideoFile] respuesta de Cloudinary — status', resp.status, data);
  if(!resp.ok || !data.secure_url) throw new Error((data.error && data.error.message) || `No se pudo subir el video (Cloudinary respondió ${resp.status}).`);
  return data.secure_url;
}


