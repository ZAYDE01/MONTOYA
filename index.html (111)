  document.getElementById('filterMaterials').innerHTML = ZY_MATERIALS.concat([...new Set(PRODUCTS.map(p=>p.material).filter(Boolean))].filter(m=>!ZY_MATERIALS.includes(m)).sort((a,b)=>a.localeCompare(b,'es'))).map(m=>`
    <label class="filter-opt"><input type="checkbox" ${filters.materials.has(m)?'checked':''} onchange="toggleFilter('materials','${m}')">${m}</label>`).join('');
