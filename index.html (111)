/* ================= [Punto 3 — Tipografía por producto] =================
   El reporte de auditoría señalaba que TODO el sitio usa una sola familia
   (Montserrat) para todo, y que meter una segunda fuente solo para
   títulos/h1 le daría personalidad de marca sin tocar el resto.

   Se implementa como una selección CURADA de fuentes (no "todas las de
   Google Fonts": son más de 1,800 y cargarlas todas de golpe repetiría
   exactamente el problema de performance del Punto 1). Esta lista cubre
   los estilos que de verdad usan marcas de moda/lujo — editorial serif,
   condensada, display — para que cada producto pueda tener su propio
   toque sin arriesgar el peso de la página.

   Cada producto puede guardar (opcional, ambos quedan vacíos por
   defecto = usa Montserrat + color de texto normal del sitio):
     p.titleFont  -> nombre de familia tipográfica (string)
     p.titleColor -> color hex para el nombre del producto (string)
   Se aplican SOLO al nombre del producto (tarjeta + PDP), nunca al resto
   de la UI — así se gana personalidad por pieza sin romper la jerarquía
   general del sitio que pedía el reporte. */
const ZY_TITLE_FONTS = [
  { id:'', label:'Predeterminada (Montserrat)', family:"'Montserrat',sans-serif", google:null },
  { id:'Playfair Display', label:'Playfair Display — serif editorial', family:"'Playfair Display',serif", google:'Playfair+Display:wght@600;700;800;900' },
  { id:'DM Serif Display', label:'DM Serif Display — serif elegante', family:"'DM Serif Display',serif", google:'DM+Serif+Display:wght@400' },
  { id:'Bodoni Moda', label:'Bodoni Moda — serif de lujo', family:"'Bodoni Moda',serif", google:'Bodoni+Moda:wght@600;700;800;900' },
  { id:'Cormorant Garamond', label:'Cormorant Garamond — serif fina', family:"'Cormorant Garamond',serif", google:'Cormorant+Garamond:wght@600;700' },
  { id:'Fraunces', label:'Fraunces — serif editorial moderna', family:"'Fraunces',serif", google:'Fraunces:wght@600;700;800;900' },
  { id:'Abril Fatface', label:'Abril Fatface — display serif', family:"'Abril Fatface',serif", google:'Abril+Fatface' },
  { id:'Oswald', label:'Oswald — condensada', family:"'Oswald',sans-serif", google:'Oswald:wght@500;600;700' },
  { id:'Bebas Neue', label:'Bebas Neue — condensada display', family:"'Bebas Neue',sans-serif", google:'Bebas+Neue' },
  { id:'Anton', label:'Anton — ultra bold condensada', family:"'Anton',sans-serif", google:'Anton' },
  { id:'Archivo Black', label:'Archivo Black — sans bold', family:"'Archivo Black',sans-serif", google:'Archivo+Black' },
  { id:'Space Grotesk', label:'Space Grotesk — sans moderna', family:"'Space Grotesk',sans-serif", google:'Space+Grotesk:wght@500;600;700' }
];
const zyLoadedFonts = new Set(['']); // '' = Montserrat, ya cargada desde <head>
function zyFontById(id){ return ZY_TITLE_FONTS.find(f=>f.id===id) || ZY_TITLE_FONTS[0]; }
/* Inyecta el <link> de Google Fonts SOLO la primera vez que una fuente
   concreta hace falta (una tarjeta la usa, o el admin la elige en el
   selector) — mismo patrón de carga bajo demanda que zyEnsureChartJs(),
   así ninguna fuente que nadie usó pesa en la carga inicial. */
function zyEnsureFont(fontId){
  if(!fontId || zyLoadedFonts.has(fontId)) return;
  const def = zyFontById(fontId);
  if(!def || !def.google) return;
  zyLoadedFonts.add(fontId);
  const link = document.createElement('link');
  link.rel = 'stylesheet';
  link.href = `https://fonts.googleapis.com/css2?family=${def.google}&display=swap`;
  document.head.appendChild(link);
}
/* Genera el CSS inline (sin envoltura style="") para el nombre del
   producto a partir de p.titleFont/p.titleColor. Devuelve '' si el
   producto no personalizó nada. */
function zyTitleCss(p){
  if(!p.titleFont && !p.titleColor) return '';
  const parts = [];
  if(p.titleFont){ zyEnsureFont(p.titleFont); parts.push(`font-family:${zyFontById(p.titleFont).family}`); }
  if(p.titleColor) parts.push(`color:${p.titleColor}`);
  return parts.join(';');
}
/* Misma info que zyTitleCss(), lista para insertar directo en una plantilla
   HTML: ' style="..."' o '' si no hay nada que aplicar. */
function zyTitleStyle(p){
  const css = zyTitleCss(p);
  return css ? ` style="${css}"` : '';
}

/* ================= [Tipografía global del sitio] =================
   A diferencia de ZY_TITLE_FONTS (que solo cambia el nombre de UN
   producto), esto cambia la tipografía de TODO el sitio: body, precios,
   botones, menús, el panel admin, etc. — todo lo que ya apunta a
   var(--font-body) en el CSS. Reutiliza la misma lista curada de
   fuentes (ZY_TITLE_FONTS) para no duplicar catálogo ni pesos de
   Google Fonts, así el sitio no crece en dependencias nuevas. */
const ZY_BODY_WEIGHTS = [
  { id:'400', label:'Regular (400)' },
  { id:'500', label:'Medium (500)' },
  { id:'600', label:'Semibold (600)' },
  { id:'700', label:'Bold (700)' }
];
/* Aplica zySettings.siteFont a las variables CSS --font-body/--font-display/
   --font-body-weight en <html>, cargando la(s) fuente(s) de Google si
   hace falta. Se llama: (a) al iniciar el sitio, en cuanto zySettings
   termina de leerse de Firestore, y (b) cada vez que el admin guarda un
   cambio en la pestaña "Tipografía", para verlo reflejado al instante
   sin recargar la página.
   [Punto 3 — auditoría] titleId es independiente de id: si el admin no
   lo definió (null/vacío), --font-display cae de vuelta a la misma
   fuente que --font-body (sitio con una sola tipografía, como pediste
   originalmente). Si SÍ lo definió, --font-display usa esa fuente
   distinta SOLO para h1/h2 .display — el body no se toca. */
function zyApplySiteFont(){
  const sf = (zySettings && zySettings.siteFont) || { id:'', weight:'400', titleId:null };
  const def = zyFontById(sf.id);
  if(sf.id) zyEnsureFont(sf.id);
  const titleDef = sf.titleId ? zyFontById(sf.titleId) : def;
  if(sf.titleId) zyEnsureFont(sf.titleId);
  const root = document.documentElement.style;
  root.setProperty('--font-body', def.family);
  root.setProperty('--font-display', titleDef.family);
  root.setProperty('--font-body-weight', sf.weight || '400');
}
/* ================= [Colores globales del sitio] =================
   Igual que zyApplySiteFont(), pero para color. No se puede usar
   document.documentElement.style.setProperty aquí porque eso pisaría el
   valor tanto en modo claro como oscuro a la vez — en vez de eso se
   escribe una hoja <style> aparte con reglas :root{} y
   [data-theme="dark"]{} que solo incluyen los campos que el admin sí
   definió, dejando el resto en su valor original (variables.css de
   arriba). Se llama al iniciar el sitio y cada vez que se guarda un
   cambio en el panel privado > pestaña "Colores". Aplica igual en ZAYDE
   y ZAYDE G porque ambas tiendas comparten el mismo tema. */
const ZY_COLOR_VARMAP = { bg:'--bg', surface:'--surface', text:'--text', signal:'--signal', brass:'--brass' };
function zyApplySiteColors(){
  const sc = (zySettings && zySettings.siteColors) || { light:{}, dark:{} };
  const buildBlock = (selector, vals)=>{
    if(!vals) return '';
    const rules = Object.keys(ZY_COLOR_VARMAP)
      .filter(k=>vals[k])
      .map(k=>`${ZY_COLOR_VARMAP[k]}:${vals[k]};`)
      .join('');
    return rules ? `${selector}{${rules}}` : '';
  };
  const css = buildBlock(':root', sc.light) + buildBlock('[data-theme="dark"]', sc.dark);
  let tag = document.getElementById('zySiteColorOverrides');
  if(!tag){ tag = document.createElement('style'); tag.id = 'zySiteColorOverrides'; document.head.appendChild(tag); }
  const tc = (zySettings && zySettings.tagColors) || {};
  const tcVars = [['new','bg'],['new','fg'],['trend','bg'],['trend','fg'],['discount','bg'],['discount','fg']]
    .filter(([k,m])=>tc[k] && tc[k][m]).map(([k,m])=>`--zy-tag-${k}-${m}:${tc[k][m]};`).join('');
  tag.textContent = css + (tcVars ? `:root,[data-theme="dark"]{${tcVars}}` : '');
}
function swipeGalleryHTML(seed, count, images, label, opts){
  opts = opts || {};
  const enableZoom = !!opts.zoom;
  const eagerFirst = !!opts.eagerFirst;
  // [FIX] "Imágenes siguen sin aparecer completas": en la ficha de
  // producto (PDP) queremos la foto COMPLETA, sin recortar — ahí se pasa
  // opts.contain:true. En las tarjetas de catálogo se deja "cover" como
  // antes, porque ya se ajustan con zyFitCardMedia() a la proporción
  // exacta de cada foto (ver ese comentario más abajo).
  // [AJUSTE-AUTOMÁTICO] Tarjetas: "cover" (llenan el recuadro, todas del mismo tamaño). Ficha de
  // producto (opts.contain): "contain" para ver la pieza completa al inspeccionarla.
  const mediaFit = opts.contain ? 'contain' : 'cover';
  count = count || 4;
  const videos = Array.isArray(opts.videos) ? opts.videos.filter(Boolean) : [];
  const mediaOrder = zyNormalizeMediaOrder(opts.order, count, videos.length);
  // [PERF — srcset] "sizes" describe cuánto va a medir la foto EN PANTALLA
  // según el layout real: en el PDP (contain:true) es casi el ancho de la
  // pantalla en celular y hasta 600px en escritorio; en las tarjetas del
  // catálogo/inicio (grid de 2 o 3 columnas) es una fracción del ancho.
  // Con esto el navegador elige sola cuál de las 3 fotos de zyCdnSrcset
  // (400/800/1200) descargar — nunca la más grande si no la necesita.
  const gallerySizes = opts.contain
    ? '(max-width:768px) 100vw, 600px'
    : '(max-width:560px) 46vw, (max-width:1000px) 31vw, 340px';
  const altBase = label ? zyEscapeHtml(label) : 'Producto ZAYDE';
  const slides = Array.from({length:count}).map((_,i)=>{
    if(images && images[i]){
      // [FIX] Solo la PRIMERA foto (i===0) lleva el onload que ajusta el
      // tamaño del recuadro (zyFitCardMedia) — es la que se ve por
      // defecto en la tarjeta. Ajustar el recuadro cada vez que el
      // usuario desliza a otra foto se vería como un salto raro, así que
      // el resto de las fotos simplemente se acomodan dentro de ese
      // mismo tamaño ya fijado.
      const onloadAttr = i===0 ? ` onload="zyFitCardMedia(this);zyMediaLoaded(this);zyRevealBg(this)"` : (opts.contain ? ` onload="zyRevealBg(this)"` : '');
      // [PERF] La primera foto de la ficha de producto es el elemento LCP
      // (lo primero grande que el usuario ve) — cargarla en "lazy" retrasa
      // esa métrica sin necesidad, porque el navegador la ve visible desde
      // el primer momento. Solo esa foto, en ese contexto, va "eager" y con
      // prioridad alta; el resto de fotos (miniaturas siguientes, tarjetas
      // de catálogo fuera de pantalla) se quedan en "lazy" como antes.
      const loadingAttr = (eagerFirst && i===0) ? ` loading="eager" fetchpriority="high"` : ` loading="lazy"`;
      const cursorStyle = enableZoom ? 'cursor:zoom-in;' : '';
      const zoomClickAttr = enableZoom ? ` onclick="event.stopPropagation();zyOpenZoom(${i})"` : '';
      const onerrorAttr = i===0 ? `zyImgFallback(this, ${i+1}, ${count});zyMediaLoaded(this)` : `zyImgFallback(this, ${i+1}, ${count})`;
      const srcsetVal = zyCdnSrcset(images[i]);
      const srcsetAttr = srcsetVal ? ` srcset="${srcsetVal}" sizes="${gallerySizes}"` : '';
      // [SIN-BARRAS] Ficha de producto: fondo = la misma foto desenfocada; encima la foto completa.
      const bgImg = opts.contain ? `<img class="zy-slide-bg" src="${zyCdnWidth(images[i], 160)}" alt="" aria-hidden="true" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;filter:blur(24px) saturate(1.15);transform:scale(1.2);opacity:0;transition:opacity .35s ease;pointer-events:none;" onerror="this.remove()">` : '';
      const mainCls = opts.contain ? ' class="zy-slide-main"' : '';
      const mainPos = opts.contain ? 'position:relative;z-index:1;' : '';
      return `<div class="swipe-slide has-photo" style="padding:0;">${bgImg}<img${mainCls} src="${images[i]}"${srcsetAttr} alt="${altBase} — foto ${i+1} de ${count}"${loadingAttr} decoding="async" style="width:100%;height:100%;object-fit:${mediaFit};display:block;${mainPos}${cursorStyle}"${zoomClickAttr} onerror="${onerrorAttr}"${onloadAttr}></div>`;
    }
    // [FIX] [Punto 2 — Fotografía] Antes cada placeholder llevaba un
    // filter:hue-rotate aleatorio por producto (mancha de color distinta
    // en cada tarjeta), lo que se veía inconsistente. Ahora TODOS los
    // placeholders del sitio comparten el mismo fondo neutro (ver CSS de
    // .swipe-slide:not(.has-photo)) — más parecido al "sin foto todavía"
    // uniforme de un marketplace serio que a una mancha de color.
    return `<div class="swipe-slide">${ZY_PLACEHOLDER_MARK}<span class="swipe-slide-label">Foto próxima&shy;mente</span></div>`;
  });
  // [VIDEOS] Los videos del producto van como diapositivas extra, después de las fotos.
  const videoSlides = videos.map((url, k)=>
    `<div class="swipe-slide has-photo zy-video-slide"><video src="${zyEscapeHtml(url)}#t=0.1" controls playsinline preload="metadata" controlsList="nodownload" aria-label="Video ${k+1} — ${altBase}"></video></div>`
  );
  const total = count + videos.length;
  // [ORDEN] Fotos y videos mezclados en el orden que eligió el admin (por defecto: fotos y luego videos).
  let _ii = 0, _vv = 0;
  const mergedSlides = mediaOrder.map(t => t==='v' ? videoSlides[_vv++] : slides[_ii++]).join('');
  const dots = Array.from({length:total}).map((_,i)=>`<span class="${i===0?'active':''}"></span>`).join('');
  return `
    <div class="swipe-gallery" data-count="${total}">
      <div class="swipe-track">${mergedSlides}</div>
      <button type="button" class="swipe-arrow swipe-arrow-left" aria-label="Foto anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button type="button" class="swipe-arrow swipe-arrow-right" aria-label="Foto siguiente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 5l7 7-7 7"/></svg>
      </button>
      <div class="swipe-dots">${dots}</div>
    </div>`;
}
/* [FIX] "Recuadros de producto no muestran la imagen completa": el
   recuadro (.card-media) tenía una proporción fija (4/5) y la foto se
   recortaba con object-fit:cover para rellenarla. Aquí, en cuanto la
   primera foto de cada tarjeta termina de cargar, se le da al recuadro
   la proporción EXACTA de esa foto — así se ve completa, sin recortarse,
   y sin dejar franjas de fondo vacías a los costados (el recuadro ya no
   "pelea" con una forma distinta a la de la imagen real). Aplica tanto a
   las tarjetas de catálogo (.card-media, incluyendo ahora ZAYDE G, que
   usa la misma tarjeta) como a la foto grande de la ficha de producto
   (.pdp-gallery-main): ahí el recuadro venía fijo en 1/1 con
   object-fit:contain, y cualquier foto que no fuera cuadrada dejaba
   bordes grises (var(--surface-dim)) arriba/abajo o a los lados — ahora
   el recuadro también toma la proporción real de la foto, así que esos
   bordes grises desaparecen y la imagen se ve completa.
   Nota: si el navegador sirve la imagen desde caché, "onload" puede no
   disparar en navegadores muy antiguos — por eso también se revisa
   img.complete al vuelo como respaldo. */
function zyFitCardMedia(img){
  if(!img) return;
  const w = img.naturalWidth, h = img.naturalHeight;
  if(!w || !h) return;
  /* [FIX-TAMAÑO-UNIFORME] Ya NO se cambia la proporción del recuadro según la
     foto: antes cada tarjeta tomaba la medida de su imagen y por eso unas se
     veían más chicas y otras más grandes. Ahora todos los recuadros miden
     exactamente lo mismo en tarjetas (4:5). En la ficha de producto el recuadro sí se adapta a la
     foto activa para que se vea completa sin barras (ver zyFitPdpFrame). */
  if(img.closest && img.closest('.pdp-gallery-main')) zyFitPdpFrame(img);
  return;
}
/* [SIN-BARRAS] Ajusta la proporción del recuadro grande de la ficha a la de la foto que se está
   viendo (limitada entre 2:3 y 3:2 para no alargar demasiado la página). */
function zyFitPdpFrame(img){
  if(!img) return;
  const frame = img.closest('.pdp-gallery-main');
  const w = img.naturalWidth, h = img.naturalHeight;
  if(!frame || !w || !h) return;
  const r = Math.min(1.5, Math.max(0.66, w / h));
  frame.style.aspectRatio = String(Math.round(r * 1000) / 1000);
}
/* [SKELETON] Quita el shimmer de carga en cuanto la foto principal de la
   tarjeta o de la ficha de producto termina de cargar (éxito o error). */
/* [FIX borroso] El fondo desenfocado (.zy-slide-bg) solo aparece cuando la foto principal ya cargó,
   así nunca se ve una versión borrosa antes de la foto real. */
function zyRevealBg(img){
  if(!img || !img.parentNode) return;
  const bg = img.parentNode.querySelector('.zy-slide-bg');
  if(bg) bg.style.opacity = .85;
}
function zyMediaLoaded(img){
  if(!img) return;
  const media = img.closest('.card-media') || img.closest('.pdp-gallery-main');
  if(media) media.classList.remove('zy-loading');
}
function zyPdpGoToSlide(i){
  const gallery = document.querySelector('#pdpThumbs')?.closest('.pdp-media')?.querySelector('.swipe-gallery');
  if(gallery && gallery.__goTo) gallery.__goTo(i);
}

/* ---------- [ZOOM] Lightbox de zoom de fotos de producto (PDP) ----------
   Doble clic/tap o rueda del mouse acerca la imagen; con la imagen
   acercada se arrastra (mouse o dedo) para recorrerla; deslizar sin
   estar acercado cambia de foto. Pensado para que el cliente pueda
   inspeccionar de cerca costuras, sellos y desgaste real — clave en
   piezas pre-owned/verificadas. */
let zyZoomImages = [];
let zyZoomIndex = 0;
let zyZoomScale = 1;
let zyZoomTX = 0, zyZoomTY = 0;
/* [ORDEN] Devuelve la secuencia final de diapositivas ('i' foto / 'v' video) con exactamente
   nImg fotos y nVid videos. Si no hay orden guardado (productos viejos) o no cuadra, fotos primero y videos después. */
function zyNormalizeMediaOrder(order, nImg, nVid){
  const out = []; let i = 0, v = 0;
  (Array.isArray(order) ? order : []).forEach(t=>{
    if(t === 'i' && i < nImg){ out.push('i'); i++; }
    else if(t === 'v' && v < nVid){ out.push('v'); v++; }
  });
  while(i < nImg){ out.push('i'); i++; }
  while(v < nVid){ out.push('v'); v++; }
  return out;
}
function zyOpenZoom(index){
  if(!currentProduct || !currentProduct.images || !currentProduct.images.length) return;
  zyZoomImages = currentProduct.images;
  zyZoomIndex = index || 0;
  zyRenderZoomImage();
  const lb = document.getElementById('zoomLightbox');
  lb.classList.add('open');
  // Cada vez que se abre el zoom, las miniaturas empiezan visibles.
  lb.classList.remove('thumbs-hidden');
  const toggleBtn = document.getElementById('zoomThumbsToggle');
  if(toggleBtn) toggleBtn.classList.add('active');
  document.body.style.overflow = 'hidden';
}
function zyToggleZoomThumbs(){
  const lb = document.getElementById('zoomLightbox');
  const toggleBtn = document.getElementById('zoomThumbsToggle');
  if(!lb) return;
  const hidden = lb.classList.toggle('thumbs-hidden');
  if(toggleBtn) toggleBtn.classList.toggle('active', !hidden);
}
function zyCloseZoom(){
  document.getElementById('zoomLightbox').classList.remove('open');
  document.body.style.overflow = '';
  zyResetZoomTransform();
}
function zyRenderZoomImage(){
  const img = document.getElementById('zoomImg');
  if(!img) return;
  const label = currentProduct ? `${currentProduct.brand} ${currentProduct.name}` : 'Producto ZAYDE';
  img.src = zyZoomImages[zyZoomIndex] || '';
  img.alt = `${zyEscapeHtml(label)} — foto ${zyZoomIndex+1} de ${zyZoomImages.length}`;
  zyResetZoomTransform();
  const dotsEl = document.getElementById('zoomDots');
  if(dotsEl) dotsEl.innerHTML = zyZoomImages.map((_,i)=>`<span class="${i===zyZoomIndex?'active':''}"></span>`).join('');
  // [MINIATURAS] Tira de recuadros con las demás fotos del producto,
  // igual que el visor de referencia — tocar una salta directo a esa foto.
  const thumbsEl = document.getElementById('zoomThumbs');
  const toggleBtn = document.getElementById('zoomThumbsToggle');
  if(thumbsEl){
    thumbsEl.innerHTML = zyZoomImages.map((src,i)=>`<img src="${src}" alt="${zyEscapeHtml(label)} — miniatura ${i+1}" class="${i===zyZoomIndex?'active':''}" onclick="zyZoomIndex=${i};zyRenderZoomImage();">`).join('');
  }
  // Con una sola foto no hay nada que alternar ni mostrar en una tira.
  const hasMultiple = zyZoomImages.length>1;
  if(toggleBtn) toggleBtn.style.display = hasMultiple ? '' : 'none';
  if(thumbsEl) thumbsEl.style.display = hasMultiple ? '' : 'none';
}
function zyResetZoomTransform(){
  zyZoomScale = 1; zyZoomTX = 0; zyZoomTY = 0;
  const img = document.getElementById('zoomImg');
  const stage = document.getElementById('zoomStage');
  if(img) img.style.transform = '';
  if(stage) stage.classList.remove('zoomed');
  const lbz = document.getElementById('zoomLightbox');
  if(lbz) lbz.classList.remove('is-zoomed');
}
function zyZoomNav(delta){
  if(!zyZoomImages.length) return;
  zyZoomIndex = (zyZoomIndex + delta + zyZoomImages.length) % zyZoomImages.length;
  zyRenderZoomImage();
}
function zyApplyZoomTransform(){
  const img = document.getElementById('zoomImg');
  const stage = document.getElementById('zoomStage');
  if(!img || !stage) return;
  // [FIX] Antes no había límite al arrastrar la foto acercada: se podía
  // sacar por completo de la pantalla y quedaba "atorada" fuera de vista,
  // con espacio vacío alrededor — eso era el zoom que "se traba y no se
  // ve bien". Ahora se acota el desplazamiento al tamaño real de la foto
  // ya escalada, para que siempre quede al menos un borde visible sin
  // importar cuánto se arrastre o hacia dónde.
  const baseW = img.offsetWidth, baseH = img.offsetHeight;
  // [FIX-ZOOM] translate() va ANTES de scale(), o sea en píxeles de pantalla: el límite es
  // (tamaño ampliado − pantalla)/2, SIN dividir entre la escala. Dividir entre la escala dejaba
  // el recorrido en solo ~40% de lo necesario y los bordes de la foto nunca se alcanzaban a ver.
  const maxTX = Math.max(0, (baseW*zyZoomScale - stage.clientWidth)/2);
  const maxTY = Math.max(0, (baseH*zyZoomScale - stage.clientHeight)/2);
  zyZoomTX = Math.min(maxTX, Math.max(-maxTX, zyZoomTX));
  zyZoomTY = Math.min(maxTY, Math.max(-maxTY, zyZoomTY));
  img.style.transform = `translate(${zyZoomTX}px, ${zyZoomTY}px) scale(${zyZoomScale})`;
  stage.classList.toggle('zoomed', zyZoomScale>1);
  const lbz = document.getElementById('zoomLightbox');
  if(lbz) lbz.classList.toggle('is-zoomed', zyZoomScale>1);
}
function zyToggleZoomAt(clientX, clientY){
  const stage = document.getElementById('zoomStage');
  if(!stage) return;
  const rect = stage.getBoundingClientRect();
  if(zyZoomScale > 1){
    zyZoomScale = 1; zyZoomTX = 0; zyZoomTY = 0;
  } else {
    zyZoomScale = 2;
    // Centra el acercamiento justo en el punto donde se hizo doble tap/clic
    const offsetX = clientX - (rect.left + rect.width/2);
    const offsetY = clientY - (rect.top + rect.height/2);
    zyZoomTX = -offsetX * (zyZoomScale - 1);
    zyZoomTY = -offsetY * (zyZoomScale - 1);
  }
  zyApplyZoomTransform();
}
(function initZoomLightbox(){
  document.addEventListener('DOMContentLoaded', function(){
    const stage = document.getElementById('zoomStage');
    if(!stage) return;

    document.addEventListener('keydown', e=>{
      const lb = document.getElementById('zoomLightbox');
      if(!lb || !lb.classList.contains('open')) return;
      if(e.key==='Escape') zyCloseZoom();
      else if(e.key==='ArrowRight') zyZoomNav(1);
      else if(e.key==='ArrowLeft') zyZoomNav(-1);
    });

    // [SIMPLIFICADO] Antes el zoom se podía activar de 3 formas distintas
    // (doble clic, rueda del mouse, pellizco con dos dedos), y esa mezcla
    // era justo lo que causaba el comportamiento raro/atorado. Ahora la
    // ÚNICA forma de acercar o alejar es doble clic (escritorio) / doble
    // tap (celular) — igual que el visor de fotos de referencia: dos
    // toques para acercar, dos toques más para volver a alejar.
    stage.addEventListener('dblclick', e=>{ zyToggleZoomAt(e.clientX, e.clientY); });

    // Arrastrar con mouse para recorrer la imagen ya acercada
    let dragging=false, startX=0, startY=0, startTX=0, startTY=0;
    stage.addEventListener('mousedown', e=>{
      if(zyZoomScale<=1) return;
      dragging=true; startX=e.clientX; startY=e.clientY; startTX=zyZoomTX; startTY=zyZoomTY;
      stage.classList.add('dragging');
    });
    window.addEventListener('mousemove', e=>{
      if(!dragging) return;
      zyZoomTX = startTX + (e.clientX-startX);
      zyZoomTY = startTY + (e.clientY-startY);
      zyApplyZoomTransform();
    });
    window.addEventListener('mouseup', ()=>{ dragging=false; stage.classList.remove('dragging'); });

    // Touch: doble tap para acercar/alejar, arrastre para recorrer la foto
    // ya acercada, y deslizar (con un dedo, sin zoom) para cambiar de foto.
    let lastTapTime=0, panStartX=0, panStartY=0, panStartTX=0, panStartTY=0, swipeStartX=0;
    stage.addEventListener('touchstart', e=>{
      if(e.touches.length===1){
        const now = Date.now();
        const isDoubleTap = (now - lastTapTime < 300);
        lastTapTime = now;
        if(isDoubleTap){
          zyToggleZoomAt(e.touches[0].clientX, e.touches[0].clientY);
          // [FIX "tengo que dejar el dedo pegado"] Antes este mismo toque
          // (el segundo tap del doble tap) también armaba el arrastre, así
          // que para mover la foto había que hacerlo sin soltar el dedo
          // justo después de tocar dos veces. Ahora el doble tap SOLO
          // hace zoom — el arrastre empieza limpio la próxima vez que se
          // toca la pantalla, sin tener que mantener el dedo presionado.
          return;
        }
        panStartX = e.touches[0].clientX; panStartY = e.touches[0].clientY;
        panStartTX = zyZoomTX; panStartTY = zyZoomTY;
        swipeStartX = e.touches[0].clientX;
      }
    }, {passive:true});
    stage.addEventListener('touchmove', e=>{
      if(e.touches.length===1 && zyZoomScale>1){
        e.preventDefault();
        zyZoomTX = panStartTX + (e.touches[0].clientX - panStartX);
        zyZoomTY = panStartTY + (e.touches[0].clientY - panStartY);
        zyApplyZoomTransform();
      }
    }, {passive:false});
    stage.addEventListener('touchend', e=>{
      if(zyZoomScale<=1 && e.changedTouches.length===1){
        const deltaX = e.changedTouches[0].clientX - swipeStartX;
        if(Math.abs(deltaX) > 50) zyZoomNav(deltaX>0 ? -1 : 1);
      }
    });
  });
})();
function initSwipeGalleries(root){
  (root||document).querySelectorAll('.swipe-gallery:not([data-bound])').forEach(gallery=>{
    gallery.setAttribute('data-bound','1');
    const track = gallery.querySelector('.swipe-track');
    const dots = gallery.querySelectorAll('.swipe-dots span');
    const count = parseInt(gallery.getAttribute('data-count'),10) || track.children.length;
    let index = 0, startX = 0, startY = 0, dragging = false, deltaX = 0, isSwipe = false, width = gallery.clientWidth || 1;

    function render(animate){
      track.style.transition = animate===false ? 'none' : '';
      track.style.transform = `translateX(-${index*100}%)`;
      dots.forEach((d,i)=>d.classList.toggle('active', i===index));
      // [VIDEOS] al pasar a otra foto/video, pausa los videos que quedaron fuera de vista
      Array.from(track.children).forEach((s,i)=>{ if(i!==index){ const v = s.querySelector('video'); if(v && !v.paused) v.pause(); } });
      const pdpFrame = gallery.closest('.pdp-gallery-main');
      if(pdpFrame){
        const curSlide = track.children[index];
        const curImg = curSlide && curSlide.querySelector('img.zy-slide-main');
        if(curImg){
          if(curImg.complete && curImg.naturalWidth) zyFitPdpFrame(curImg);
          else curImg.addEventListener('load', ()=>{ if(track.children[index]===curSlide) zyFitPdpFrame(curImg); }, {once:true});
        }
      }
      const media = gallery.closest('.pdp-media');
      if(media) media.querySelectorAll('.pdp-thumb').forEach((t,i)=>t.classList.toggle('active', i===index));
    }
    function go(delta){
      index = (index + delta + count) % count;
      render();
    }
    gallery.__goTo = function(i){ index = ((i%count)+count)%count; render(); };

    // [VIDEOS] la barra de controles del video (abajo) no debe iniciar un deslizamiento
    function inVideoControls(e, pt){
      const t = e.target;
      if(!t || t.tagName !== 'VIDEO') return false;
      return pt.clientY > t.getBoundingClientRect().bottom - 56;
    }
    function onStart(e){
      const pt = e.touches ? e.touches[0] : e;
      if(inVideoControls(e, pt)){ dragging = false; return; }
      startX = pt.clientX; startY = pt.clientY; dragging = true; isSwipe = false; deltaX = 0;
      width = gallery.clientWidth || 1;
    }
    function onMove(e){
      if(!dragging) return;
      const pt = e.touches ? e.touches[0] : e;
      deltaX = pt.clientX - startX;
      const deltaY = pt.clientY - startY;
      if(!isSwipe && Math.abs(deltaX) > 8 && Math.abs(deltaX) > Math.abs(deltaY)) isSwipe = true;
      if(isSwipe){
        if(e.cancelable) e.preventDefault();
        gallery.classList.add('dragging');
        const pct = (deltaX / width) * 100;
        track.style.transform = `translateX(calc(-${index*100}% + ${pct}%))`;
      }
    }
    function onEnd(){
      if(!dragging) return;
      dragging = false;
      gallery.classList.remove('dragging');
      if(isSwipe && Math.abs(deltaX) > width*0.15){
        deltaX < 0 ? go(1) : go(-1);
      } else {
        render();
      }
      deltaX = 0;
    }
    gallery.addEventListener('touchstart', onStart, {passive:true});
    gallery.addEventListener('touchmove', onMove, {passive:false});
    gallery.addEventListener('touchend', onEnd);
    gallery.addEventListener('touchcancel', onEnd);
    // soporte de arrastre con mouse en escritorio
    gallery.addEventListener('mousedown', e=>{ onStart(e); if(!(e.target && e.target.tagName === 'VIDEO')) e.preventDefault(); });
    window.addEventListener('mousemove', e=>{ if(dragging) onMove(e); });
    window.addEventListener('mouseup', onEnd);
    // flechas: solo visibles (vía CSS) en computadora; en celular quedan ocultas
    // y no reciben clicks, así que el celular se mantiene 100% táctil.
    const arrowLeft = gallery.querySelector('.swipe-arrow-left');
    const arrowRight = gallery.querySelector('.swipe-arrow-right');
    if(arrowLeft) arrowLeft.addEventListener('click', e=>{ e.stopPropagation(); go(-1); });
    if(arrowRight) arrowRight.addEventListener('click', e=>{ e.stopPropagation(); go(1); });

    render(false);
  });
}

/* Dibuja los 3 bloques de enlaces del pie de página. Desde que ZAYDE G
   tiene su propio pie de página, lee de zySettings.footerLinks (ZAYDE) o
   zySettings.footerLinksG (ZAYDE G) según currentStore — así agregar/quitar
   enlaces desde el panel admin se refleja al instante en la tienda que
   corresponda, sin mezclarse con la otra. */
function renderFooterLinks(){
  const linkHTML = (item)=>{
    if(item.action==='contacto') return `<a href="#" onclick="navigate('contacto');return false;">${zyEscapeHtml(item.label)}</a>`;
    if(item.action==='tracking') return `<a href="#" onclick="openTracking();return false;">${zyEscapeHtml(item.label)}</a>`;
    if(item.action && item.action.indexOf('policy:')===0){
      const tab = item.action.split(':')[1];
      return `<a href="#" onclick="zyOpenInfo('${tab}');return false;">${zyEscapeHtml(item.label)}</a>`;
    }
    if(item.cat) return `<a href="#" onclick="navCatName('${item.cat.replace(/'/g,"\\'")}');return false;">${zyEscapeHtml(item.label)}</a>`;
    const href = item.href || '#';
    const ext = /^https?:\/\//.test(href);
    return `<a href="${zyEscapeHtml(href)}"${ext?' target="_blank" rel="noopener"':''}>${zyEscapeHtml(item.label)}</a>`;
  };
  const source = (currentStore==='clothesg' ? zySettings.footerLinksG : zySettings.footerLinks) || {};
  ['comprar','ayuda','compania'].forEach(col=>{
    const box = document.getElementById('footCol-'+col);
    if(box){ let items=(source[col]||[]).slice();
      // [ZAYDE G · SIN VÍNCULO CON ZAYDE] la verificación de autenticidad es de ZAYDE: nunca se enlaza desde el pie de ZAYDE G, aunque venga de una configuración guardada antes
      // [ZAYDE G] Verificación vuelve a estar, pero con su propio texto (clave "G"), sin heredar el de ZAYDE
      if(currentStore==='clothesg' && col==='compania' && !items.some(i=>i.action==='policy:verificacion')) items.splice(1,0,{id:'verificacion',label:'Verificación',action:'policy:verificacion'}); if(col==='ayuda'&&!items.some(i=>i.action==='contacto')) items.push({id:'contacto',label:'Contacto',action:'contacto'}); box.innerHTML = items.map(linkHTML).join(''); }
  });
}
/* [FOOTER — ZAYDE G] Los textos del pie de página (descripción de marca,
   títulos de columna, copyright y nota de precios) se editan con el mismo
   sistema de "Edición en vivo" / panel de Textos que el resto del sitio
   (data-zt), pero cuando estás en ZAYDE G cada uno usa una clave separada
   (con sufijo "G") para que editarlos ahí nunca sobrescriba el texto de
   ZAYDE, y viceversa. Se llama al cargar el sitio y cada vez que cambias
   de tienda (zySwitchStore). */
const ZY_FOOTER_TEXT_BASE_KEYS = ['footer.brand.desc','footer.comprar.title','footer.ayuda.title','footer.compania.title','footer.copy','footer.pricing'];
function zyApplyFooterForStore(){
  const inG = currentStore==='clothesg';
  ZY_FOOTER_TEXT_BASE_KEYS.forEach(baseKey=>{
    const el = document.querySelector(`footer [data-zt-base="${baseKey}"]`);
    if(!el) return;
    // Guarda el texto de fábrica de ZAYDE una sola vez, la primera vez que
    // se corre esta función (en ese momento el elemento todavía trae el
    // texto/override correcto de ZAYDE, porque currentStore empieza en 'zayde').
    if(el.dataset.zyFooterZaydeDefault === undefined) el.dataset.zyFooterZaydeDefault = el.textContent;
    const key = inG ? baseKey + 'G' : baseKey;
    el.setAttribute('data-zt', key);
    const fallback = el.dataset.zyFooterZaydeDefault;
    // [ZAYDE G · SIN VÍNCULO CON ZAYDE] sin override propio, ZAYDE G no hereda los textos de ZAYDE (ni su "autenticidad verificada")
    const gDefault = {'footer.brand.desc':'Ropa seleccionada para la nueva generación, enviada con rastreo a todo México.','footer.pricing':'Precios en MXN · IVA incluido'}[baseKey];
    const gFallback = gDefault || zyPolicyGFallback(fallback);
    el.textContent = zyTextOverrides.hasOwnProperty(key) ? zyTextOverrides[key] : (inG ? gFallback : fallback);
  });
  renderFooterLinks();
}

/* [MODAL DE POLÍTICAS · ZAYDE G] Igual patrón que zyApplyFooterForStore():
   "Sobre ZAYDE", "Verificación", "Términos" y "Aviso de privacidad" (los 4
   apartados de marca dentro del modal de Ayuda — no toca Guía de tallas ni
   Devoluciones, que siguen siendo genéricos/compartidos) usan una clave
   data-zt separada con sufijo "G" mientras currentStore==='clothesg', para
   que se puedan editar aparte con "Edición en vivo" sin tocar el texto de
   ZAYDE, y viceversa. Se llama al arrancar el sitio y cada vez que cambias
   de tienda (zySwitchStore). */
const ZY_POLICY_BRANDED_PREFIXES = ['policy.sob.','policy.ver.','policy.ter.','policy.priv.'];
const ZY_POLICY_BRANDED_EXACT = ['policy.tab.sobre','policy.tab.verificacion','policy.tab.terminos','policy.tab.privacidad'];
function zyPolicyKeyIsBranded(key){
  return ZY_POLICY_BRANDED_EXACT.indexOf(key)!==-1 || ZY_POLICY_BRANDED_PREFIXES.some(p=>key.indexOf(p)===0);
}
// Texto por default de ZAYDE G: el mismo de ZAYDE con la marca ajustada
// ("ZAYDE" -> "ZAYDE G"), para que ninguna sección se vea vacía o "copiada
// literal" la primera vez que entras — sigue siendo 100% editable aparte.
function zyPolicyGFallback(text){
  return (text || '').replace(/ZAYDE(?!\s*G\b)/g, 'ZAYDE G');
}
function zyApplyPolicyTextsForStore(){
  const inG = currentStore==='clothesg';
  document.querySelectorAll('#policyModal [data-zt]').forEach(el=>{
    const zt = el.getAttribute('data-zt');
    const baseKey = (zt.slice(-1)==='G' && zyPolicyKeyIsBranded(zt.slice(0,-1))) ? zt.slice(0,-1) : zt;
    if(!zyPolicyKeyIsBranded(baseKey)) return; // tallas/devoluciones/faq: sin cambios, siguen compartidos
    if(el.dataset.zyPolicyDefault === undefined) el.dataset.zyPolicyDefault = el.textContent;
    const key = inG ? baseKey + 'G' : baseKey;
    el.setAttribute('data-zt', key);
    if(zyTextOverrides.hasOwnProperty(key)) el.textContent = zyTextOverrides[key];
    else el.textContent = inG ? zyPolicyGFallback(el.dataset.zyPolicyDefault) : el.dataset.zyPolicyDefault;
  });
}

