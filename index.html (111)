/* [MARQUEE] Estado del carrusel de anuncios: qué mensaje está activo y el
   temporizador de auto-avance (cada 5s, en vez del scroll continuo de
   antes). Las flechas prev/next llaman a lo mismo y reinician el
   temporizador para que no "salte" justo después de que la persona
   navegó a mano. */
let zyMarquee = { items: [], index: 0, timer: null };
function zyRenderMarquee(){
  const track = document.getElementById('marqueeTrack');
  const bar = document.getElementById('marqueeBar');
  const btnPrev = document.getElementById('marqueeBtnPrev');
  const btnNext = document.getElementById('marqueeBtnNext');
  if(!track) return;
  const items = ((zySettings.marqueeItems && zySettings.marqueeItems.length) ? zySettings.marqueeItems : []).filter(it => zySettings.clubPublic || it.action !== 'club');   // [CLUB OCULTO]
  clearInterval(zyMarquee.timer);
  zyMarquee.items = items; zyMarquee.index = 0;
  if(!items.length){ track.innerHTML = ''; if(bar) bar.classList.remove('is-ready'); return; }
  track.innerHTML = items.map((it,i)=>`<button type="button" class="marquee-item${i===0?' active':''}" onclick="zyMarqueeGo('${(it.action||'').replace(/'/g,"\\'")}')">${zyEscapeHtml(it.text)}${it.discountPct>0?` <b>-${it.discountPct}%</b>`:''}</button>`).join('');
  if(bar) bar.classList.add('is-ready');
  const showNav = items.length > 1;
  if(btnPrev) btnPrev.style.visibility = showNav ? 'visible' : 'hidden';
  if(btnNext) btnNext.style.visibility = showNav ? 'visible' : 'hidden';
  if(showNav) zyMarqueeStartAutoplay();
}
function zyMarqueeStartAutoplay(){
  clearInterval(zyMarquee.timer);
  if(zyMarquee.items.length < 2) return;
  zyMarquee.timer = setInterval(()=>zyMarqueeGoTo(zyMarquee.index + 1), 5000);
}
function zyMarqueeGoTo(i){
  if(!zyMarquee.items.length) return;
  zyMarquee.index = ((i % zyMarquee.items.length) + zyMarquee.items.length) % zyMarquee.items.length;
  const track = document.getElementById('marqueeTrack');
  if(!track) return;
  track.querySelectorAll('.marquee-item').forEach((el,idx)=>el.classList.toggle('active', idx===zyMarquee.index));
}
function zyMarqueeNext(){ zyMarqueeGoTo(zyMarquee.index + 1); zyMarqueeStartAutoplay(); }
function zyMarqueePrev(){ zyMarqueeGoTo(zyMarquee.index - 1); zyMarqueeStartAutoplay(); }
function zyHomeTab(which){
