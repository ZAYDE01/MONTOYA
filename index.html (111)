  if(barsEl){
    const counts = [5,4,3,2,1].map(star => reviews.filter(r=>r.stars===star).length);
    barsEl.innerHTML = [5,4,3,2,1].map((star,i)=>{
      const count = counts[i];
      const pct = reviews.length ? Math.round((count/reviews.length)*100) : 0;
