/* ================= RENDER HELPERS ================= */
function fmt(n){
  const rate = (typeof EXCHANGE_RATES!=='undefined' && EXCHANGE_RATES[currentCurrency]) ? EXCHANGE_RATES[currentCurrency] : 1;
  const cur = (typeof currentCurrency!=='undefined') ? currentCurrency : 'MXN';
  const converted = Math.round(n * rate);
  const localeCode = (typeof currentLocale!=='undefined' && currentLocale==='en') ? 'en-US' : 'es-MX';
  const symbol = (typeof CURRENCY_SYMBOLS!=='undefined' && CURRENCY_SYMBOLS[cur]) ? CURRENCY_SYMBOLS[cur] : '$';
  return symbol+converted.toLocaleString(localeCode)+' '+cur;
}

