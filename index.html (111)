function toggleFilter(group, val, isChip){
  if(filters[group].has(val)) filters[group].delete(val); else filters[group].add(val);
  if(isChip) buildFilterUI();
  renderCatalog();
}
function clearFilters(silent){
  filters = { ropaGroups:new Set(), brands:new Set(), cats:new Set(), sizes:new Set(), cond:new Set(), line:new Set(), genders:new Set(), colors:new Set(), materials:new Set(), occasions:new Set(), styles:new Set(), minPrice:0, maxPrice:Infinity, q:'', featured:null, pMin:null, pMax:null, disc:0 };
  const prMin = document.getElementById('priceRangeMin');
  const prMax = document.getElementById('priceRangeMax');
  if(prMin && prMax){
    prMin.value = prMin.min;
    prMax.value = prMax.max;
    zyRenderPriceRangeUI(parseInt(prMin.value), parseInt(prMax.value));
  }
  buildFilterUI();
  if(!silent) renderCatalog();
}
function normText(s){ return (s||'').toString().normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase(); }
function productHaystack(p){
  return normText([p.brand,p.name,p.sku,p.category,p.gender,p.line,p.desc,zyRopaGroupOf(p),p.ropaType].filter(Boolean).join(' '));
}
function renderCatalog(){
  filters.minPrice = filters.pMin!=null ? filters.pMin : parseInt(document.getElementById('priceRangeMin').value);
  filters.maxPrice = filters.pMax!=null ? filters.pMax : zyPriceRangeValue(document.getElementById('priceRangeMax').value);
  // [FIX — "no quiero que se mezcle nada de ZAYDE con ZAYDE G"] Antes,
  // en cuanto había texto de búsqueda (filters.q), esta página buscaba en
  // TODO PRODUCTS (las dos tiendas mezcladas) sin importar en cuál
  // estuvieras — así "Explorar" desde ZAYDE G mostraba piezas de ZAYDE
  // también. Ahora, con o sin búsqueda, solo se muestran piezas de la
  // tienda en la que estás (currentStore) — cada tienda tiene su propio
  // buscador de verdad, sin mezclar resultados entre ambas.
  const pool = currentStore==='clothesg' ? zyClothesGProducts() : zyBrowsable();
  let list = pool.filter(p=>{
    if(filters.brands.size && !filters.brands.has(p.brand)) return false;
    if(filters.cats.size && !filters.cats.has(p.category)) return false;
    if(filters.line.size && !filters.line.has(p.line)) return false;
    if(filters.genders.size && !filters.genders.has(p.gender)) return false;
    // [ROPA] la sección solo filtra cuando se está viendo únicamente la categoría Ropa
    if(filters.ropaGroups.size && filters.cats.size===1 && filters.cats.has('Ropa') && !filters.ropaGroups.has(zyRopaGroupOf(p))) return false;
    if(filters.sizes.size && !(zyFilterSizeVals(p).some(v=>filters.sizes.has(v)) || p.sizes.some(s=>filters.sizes.has(String(s)) || (p.category==='Bolsos' && String(s)==='Única' && filters.sizes.has('Unitalla'))))) return false;
    if(filters.colors.size && !filters.colors.has(p.color)) return false;
    if(filters.materials.size && !filters.materials.has(p.material)) return false;
    if(filters.occasions.size && !filters.occasions.has(p.occasion)) return false;
    if(filters.styles.size && !filters.styles.has(p.style)) return false;
    if(filters.q && (filters.q.charAt(0)==='@' ? !zctMatch(filters.q,p) : !productHaystack(p).includes(normText(filters.q)))) return false; // '@mujer', '@lux'... = recuadros de subsección por defecto
    if(filters.featured && !(p.featured && p.featured[filters.featured])) return false;
    if(filters.disc && (p.discountPct||0) < filters.disc) return false;
    if(p.price > filters.maxPrice) return false;
    if(p.price < filters.minPrice) return false;
    return true;
  });
  const sort = document.getElementById('sortSelect').value;
  const zyModeCompare = (a,b)=>{
    if(sort==='price-asc') return a.price-b.price;
    if(sort==='price-desc') return b.price-a.price;
    if(sort==='new') return b.id-a.id;
    if(sort==='discount') return (b.discountPct||0)-(a.discountPct||0);
    return b.views-a.views;
  };
  list.sort(zyModeCompare);

  document.getElementById('catCount').textContent = list.length + (list.length===1?' resultado':' resultados');
  // [SCROLL INFINITO] Antes se pintaban TODAS las tarjetas del resultado de
  // una sola vez (list.map(cardHTML).join('')) — con un catálogo grande eso
  // significa montar de golpe decenas de galerías con sus imágenes. Ahora
  // solo se guarda la lista completa ya filtrada/ordenada, y quien de verdad
  // pinta las tarjetas (en tandas) es zyRenderCatalogPage(), más abajo.
  zyCatalogFullList = list;
  zyRenderCatalogPage(true);
}
// [SCROLL INFINITO — CATÁLOGO] Cuántas tarjetas se pintan por tanda. Cada
// vez que el "sentinel" (ver CSS .catalog-sentinel) se acerca a la pantalla,
// se pinta una tanda más — así nunca se monta el catálogo completo si la
// persona no ha bajado tanto, y el catálogo puede crecer sin límite sin que
// el navegador se ponga lento de entrada.
const ZY_CATALOG_PAGE_SIZE = 12;
let zyCatalogFullList = [];
let zyCatalogRenderedCount = 0;
let zyCatalogIO = null;
function zyRenderCatalogPage(reset){
  const grid = document.getElementById('catalogGrid');
  if(!grid) return;
  const list = zyCatalogFullList;
  if(reset) zyCatalogRenderedCount = 0;
  if(!list.length){
    grid.innerHTML = `<div class="empty-state"><h3>No encontramos coincidencias</h3><p>Prueba a quitar algún filtro o ampliar tu rango de precio.</p></div>`;
    zyCatalogObserveSentinel(null);
    return;
  }
  const from = zyCatalogRenderedCount;
  const to = Math.min(from + ZY_CATALOG_PAGE_SIZE, list.length);
  const html = list.slice(from, to).map(cardHTML).join('');
  if(reset){
    grid.innerHTML = html;
  } else {
    grid.insertAdjacentHTML('beforeend', html);
  }
  zyCatalogRenderedCount = to;
  initSwipeGalleries(grid);
  if(zyCatalogRenderedCount < list.length){
    let sentinel = document.getElementById('catalogSentinel');
    if(!sentinel){
      sentinel = document.createElement('div');
      sentinel.id = 'catalogSentinel';
      sentinel.className = 'catalog-sentinel';
      sentinel.innerHTML = '<span class="catalog-sentinel-spinner" aria-hidden="true"></span>';
      sentinel.setAttribute('role','status');
      sentinel.setAttribute('aria-label','Cargando más piezas');
    }
    grid.appendChild(sentinel); // siempre al final, aunque ya existiera
    zyCatalogObserveSentinel(sentinel);
  } else {
    zyCatalogObserveSentinel(null);
  }
}
function zyCatalogObserveSentinel(el){
  if(zyCatalogIO){ zyCatalogIO.disconnect(); zyCatalogIO = null; }
  const oldSentinel = document.getElementById('catalogSentinel');
  if(!el && oldSentinel) oldSentinel.remove();
  if(!el) return;
  if(!('IntersectionObserver' in window)){
    // Sin soporte: no hay scroll infinito, pero tampoco dejamos el catálogo
    // a medias — se pinta todo de una vez, como se comportaba el sitio antes.
    zyRenderCatalogPage_renderAllFallback();
    return;
  }
  zyCatalogIO = new IntersectionObserver((entries)=>{
    if(entries.some(e=>e.isIntersecting)) zyRenderCatalogPage(false);
  }, {rootMargin:'900px 0px 900px 0px'});
  zyCatalogIO.observe(el);
}
function zyRenderCatalogPage_renderAllFallback(){
  const grid = document.getElementById('catalogGrid');
  if(!grid) return;
  const oldSentinel = document.getElementById('catalogSentinel');
  if(oldSentinel) oldSentinel.remove();
  grid.insertAdjacentHTML('beforeend', zyCatalogFullList.slice(zyCatalogRenderedCount).map(cardHTML).join(''));
  zyCatalogRenderedCount = zyCatalogFullList.length;
  initSwipeGalleries(grid);
}
/* [Punto 3 — Toggle cuadrícula/lista] Guarda la preferencia en este
   navegador (localStorage) — es una preferencia de visualización, no un
   dato de cuenta, así que no hace falta sincronizarla en Firestore. */
function zySetCatalogView(mode){
  const grid = document.getElementById('catalogGrid');
  if(!grid) return;
  grid.classList.toggle('list-view', mode==='list');
  document.getElementById('viewToggleGrid').classList.toggle('active', mode!=='list');
  document.getElementById('viewToggleList').classList.toggle('active', mode==='list');
  try{ localStorage.setItem('zayde:catalogView', mode); }catch(e){}
}
function zyInitCatalogView(){
  let mode = 'grid';
  try{ mode = localStorage.getItem('zayde:catalogView') || 'grid'; }catch(e){}
  zySetCatalogView(mode);
}

/* ================= MAYOREO (catálogo mayorista) =================
   Muestra todos los productos que el admin marcó con el destacado
   "Elige tu línea · Mayoreo" desde el panel privado. No hay límite
   de cuántos se pueden agregar — a diferencia de la vista previa de
   2 piezas en el inicio, aquí se listan todos. */
function renderMayoreoPage(){
  const list = PRODUCTS.filter(p=>p.store==='clothesg' && p.featured && p.featured.mayoreo);
  const box = document.getElementById('grid-mayoreo-full');
  document.getElementById('mayoreoCount').textContent = list.length
    ? `${list.length} pieza${list.length===1?'':'s'} disponible${list.length===1?'':'s'} para pedidos por volumen`
    : 'Pedidos por volumen para tiendas y revendedores.';
  if(!list.length){
    box.innerHTML = `<div class="empty-state" style="grid-column:1/-1;">
      <h3>Todavía no hay piezas de mayoreo publicadas</h3>
      <p>Agrégalas desde tu panel privado: pestaña <b>Productos</b> → marca la casilla <b>"Elige tu línea · Mayoreo"</b> en "Destacar en secciones del inicio" al crear o editar un producto.</p>
    </div>`;
    return;
  }
  box.innerHTML = list.map(cardHTML).join('');
  initSwipeGalleries();
}

/* ================= SEARCH ================= */
/* ================= BUSCADOR: recientes + populares =================
   Recientes: últimos términos buscados en este navegador (borrables uno
   por uno o todos). Populares: lista curada de búsquedas frecuentes, cada
   una con sus productos debajo, igual que el patrón de sitios grandes de
   moda. ============= */
let zyRecentSearches = [];
const POPULAR_SEARCHES = ['Essentials','Nike','Bolsos','Perfumes','Relojes','Lentes de sol','Zapatos','Joyería'];
async function zyLoadSearchRecents(){
  zyRecentSearches = (await Store.get('zayde:recentSearches')) || [];
}
function zyAddRecentSearch(term){
  term = (term||'').trim();
  if(!term) return;
  zyRecentSearches = zyRecentSearches.filter(t=>t.toLowerCase()!==term.toLowerCase());
  zyRecentSearches.unshift(term);
  zyRecentSearches = zyRecentSearches.slice(0,8);
  Store.set('zayde:recentSearches', zyRecentSearches);
}
function zyRemoveRecentSearch(term, boxId){
  zyRecentSearches = zyRecentSearches.filter(t=>t!==term);
  Store.set('zayde:recentSearches', zyRecentSearches);
  zyRenderSearchPanel(boxId);
}
function zyClearRecentSearches(boxId){
  zyRecentSearches = [];
  Store.set('zayde:recentSearches', zyRecentSearches);
  zyRenderSearchPanel(boxId);
}
/* [BÚSQUEDA — SECCIÓN PROPIA] Antes solo existían dos cajas flotantes
   (escritorio/celular), ahora también existe 'searchPageResults', el
   contenedor de la página /buscar — esta función centraliza a qué
   input pertenece cada caja para no repetir el mismo ternario en cada
   función de búsqueda. */
function zySearchInputId(boxId){
  if(boxId==='suggestBoxMobile') return 'searchInputMobile';
  if(boxId==='searchPageResults') return 'searchInputPage';
  return 'searchInput';
}
function zyRenderSearchPanel(boxId){
  boxId = boxId || 'suggestBox';
  const inputId = zySearchInputId(boxId);
  const box = document.getElementById(boxId);
  if(!box) return;
  const recentHTML = zyRecentSearches.length ? `
    <div class="suggest-panel-row">
      <span class="suggest-panel-title">Búsquedas recientes</span>
      <button type="button" class="suggest-panel-clear" onclick="event.stopPropagation();zyClearRecentSearches('${boxId}')">Borrar todo</button>
    </div>
    ${zyRecentSearches.map(t=>`
      <div class="suggest-recent-item">
        <span class="rtext" onclick="document.getElementById('${inputId}').value='${t.replace(/'/g,"\\'")}';runSearchAll('${t.replace(/'/g,"\\'")}')"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:13px;height:13px;vertical-align:-2px;margin-right:6px;"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>${zyEscapeHtml(t)}</span>
        <button type="button" class="rdel" onclick="event.stopPropagation();zyRemoveRecentSearch('${t.replace(/'/g,"\\'")}','${boxId}')" aria-label="Borrar">&times;</button>
      </div>`).join('')}
  ` : '';
  const popularHTML = `
    <div class="suggest-panel-row" style="margin-top:${zyRecentSearches.length?'16px':'0'};">
      <span class="suggest-panel-title">Búsquedas populares</span>
    </div>
    <div class="suggest-popular-chips">${POPULAR_SEARCHES.map(t=>`<button type="button" class="suggest-popular-chip" onclick="event.stopPropagation();document.getElementById('${inputId}').value='${t}';runSearchAll('${t}')">${t}</button>`).join('')}</div>`;

  // Tres columnas estilo Fashion Nova: Más buscado / Tendencias / Ofertas —
  // cada una una lista numerada con miniatura, tomadas de datos reales del catálogo.
  // [PRIORIDAD DE TIENDA] Se arma primero con las piezas de la tienda en la
  // que estás ahora (currentStore) y solo se completa con las de la otra
  // tienda si hacen falta — así el buscador se siente "de la tienda en la
  // que estoy" sin necesitar un cuadro de búsqueda aparte para ZAYDE G.
  // [FIX — "no quiero que se mezcle nada de ZAYDE con ZAYDE G"] Antes
  // completaba con piezas de la OTRA tienda si la actual no tenía
  // suficientes — ahora solo usa las piezas de la tienda en la que estás,
  // sin completar con la otra.
  const zyStorePool = currentStore==='clothesg' ? zyClothesGProducts() : zyBrowsable();
  const zyHasRealImg = p => !!(p.images && p.images[0]);
  const zyTopN = (predicate, compareFn, n)=>{
    const withImg = zyStorePool.filter(p=>predicate(p) && zyHasRealImg(p)).sort(compareFn);
    const withoutImg = zyStorePool.filter(p=>predicate(p) && !zyHasRealImg(p)).sort(compareFn);
    return withImg.concat(withoutImg).slice(0, n);
  };
  // [FIX — foto no aparece] Cada pieza de estas tres columnas ahora
  // muestra siempre SU PROPIA foto real (buscada en p.images, igual que
  // en el carrito y el checkout). Si por algún motivo la foto no carga
  // (URL rota, sin conexión, etc.), cae al mismo relleno de color de
  // marca del resto del sitio en vez de dejar el ícono roto del
  // navegador, que antes se veía como si "no tuviera foto".
  const numList = (title, items)=> items.length ? `
    <div class="suggest-panel-col">
      <div class="suggest-panel-col-title">${title}</div>
      <div class="suggest-panel-numlist">${items.map((p,i)=>{
        const domId = 'snThumb-' + boxId + '-' + title.replace(/[^a-zA-Z0-9]/g,'') + '-' + p.id;
        const hasImg = p.images && p.images[0];
        return `
        <div class="suggest-panel-numitem" onclick="closeMobileSearch();document.getElementById('${boxId}').classList.add('page-hidden');openPDP(${p.id})">
          <span class="num">${i+1}</span>
          <div class="sn-thumb${hasImg ? '' : ' is-fallback'}" id="${domId}">${hasImg ? `<img src="${p.images[0]}" alt="${zyEscapeHtml((p.brand?p.brand+' ':'')+(p.name||''))}" loading="lazy" onerror="document.getElementById('${domId}').classList.add('is-fallback'); this.remove();">` : ''}</div>
          <span class="lbl">${zyEscapeHtml(p.category || p.brand)}</span>
        </div>`;
      }).join('')}</div>
    </div>` : '';
  const topViewed = zyTopN(()=>true, (a,b)=>b.views-a.views, 4);
  const trending = zyTopN(p=>p.trend==='up', (a,b)=>(b.trendPct||0)-(a.trendPct||0), 4);
  const onSale = zyTopN(p=>p.discountPct>0, (a,b)=>(b.discountPct||0)-(a.discountPct||0), 4);
  const colsHTML = (topViewed.length || trending.length || onSale.length) ? `
    <div class="suggest-panel-cols">
      ${numList('Búsquedas Principales', topViewed)}
      ${numList('Tendencias', trending)}
      ${numList('Ofertas', onSale.length ? onSale : topViewed)}
    </div>` : '';
  box.innerHTML = `<div class="suggest-panel">${recentHTML}${popularHTML}${colsHTML}</div>`;
  box.classList.remove('page-hidden');
}
/* ===== [BUSCADOR PRO] =====
   Antes: buscaba la frase completa pegada, mostraba filas de texto sin foto, no toleraba errores de
   dedo, no se podía navegar con el teclado y "sin resultados" era una sola línea.
   Ahora:
   - Cada palabra se busca por separado ("dunk nike" encuentra "Nike Dunk Low"), sin acentos ni mayúsculas.
   - Tolera 1 error de dedo en palabras de 4+ letras ("adiddas" -> Adidas).
   - Ordena por relevancia (marca/nombre primero, populares después, agotados al final).
   - Resultados con foto, marca, nombre resaltado, precio y descuento; en la página de búsqueda salen en
     cuadrícula con filtros por categoría y contador.
   - Teclado: ↑ ↓ para moverte, Enter para abrir, Esc para limpiar.
   - "Sin resultados" con ayuda: categorías sugeridas y búsqueda por foto. */
let zyLastSearch = null;
function zsEsc(s){ return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }
function zySearchWords(q){ return normText(q).split(/[^a-z0-9]+/).filter(Boolean); }
function zyWithin1(a, b){
  if(a === b) return true;
  const la = a.length, lb = b.length; if(Math.abs(la - lb) > 1) return false;
  let i = 0, j = 0, edits = 0;
  while(i < la && j < lb){
    if(a[i] === b[j]){ i++; j++; continue; }
    if(++edits > 1) return false;
    if(la > lb) i++; else if(lb > la) j++; else { i++; j++; }
  }
  return edits + (la - i) + (lb - j) <= 1;
}
function zySearchRank(p, tokens){
  const hay = productHaystack(p), hw = hay.split(/[^a-z0-9]+/).filter(Boolean);
  const head = normText([p.brand, p.name].filter(Boolean).join(' ')), headW = head.split(/[^a-z0-9]+/).filter(Boolean);
  let score = 0;
  for(const t of tokens){
    if(headW.some(w => w.startsWith(t))) score += 6;
    else if(head.includes(t)) score += 4;
    else if(hay.includes(t)) score += 2;
    else if(t.length >= 4 && hw.some(w => zyWithin1(w, t))) score += 1;
    else return 0;
  }
  if(head.startsWith(tokens[0])) score += 3;
  score += Math.min(2, Math.log10((p.views || 0) + 1) / 3);
  const stk = p.stock ? Object.values(p.stock).reduce((a, b) => a + (Number(b) || 0), 0) : null;
  if(stk === 0) score -= 5;
  return Math.max(score, 0.1);
}
function zySearchResults(q){
  const tokens = zySearchWords(q); if(!tokens.length) return [];
  const pool = currentStore === 'clothesg' ? zyClothesGProducts() : zyBrowsable();
  return pool.map(p => ({ p, s: zySearchRank(p, tokens) })).filter(x => x.s > 0).sort((a, b) => b.s - a.s).map(x => x.p);
}
function zyHighlight(text, tokens){
  const raw = String(text == null ? '' : text), n = normText(raw);
  if(n.length !== raw.length) return zsEsc(raw);
  const mark = new Array(raw.length).fill(false);
  tokens.forEach(t => { let i = n.indexOf(t); while(i >= 0){ for(let k = i; k < i + t.length; k++) mark[k] = true; i = n.indexOf(t, i + t.length); } });
  let out = '', open = false;
  for(let k = 0; k < raw.length; k++){
    if(mark[k] && !open){ out += '<mark class="zs-hl">'; open = true; }
    if(!mark[k] && open){ out += '</mark>'; open = false; }
    out += zsEsc(raw[k]);
  }
  return open ? out + '</mark>' : out;
}
function zsThumb(p){ const s = p.images && p.images[0]; return s ? `<img src="${zsEsc(s)}" alt="" loading="lazy" decoding="async">` : '<span class="zs-noimg"></span>'; }
function zsPrice(p){
  const old = (p.discountPct && p.discountPct > 0) ? `<s>${fmt(Math.round(p.price / (1 - p.discountPct / 100)))}</s>` : '';
  return `<span class="zs-price mono">${old}${fmt(p.price)}</span>`;
}
function zsBadges(p){
  const stk = p.stock ? Object.values(p.stock).reduce((a, b) => a + (Number(b) || 0), 0) : null;
  return (stk === 0 ? '<span class="zs-tag zs-out">Agotado</span>' : '') + ((p.discountPct && p.discountPct > 0) ? `<span class="zs-tag zs-off">${p.discountPct}% OFF</span>` : '');
}
function zsOpen(id){
  if(zyLastSearch && zyLastSearch.q) zyAddRecentSearch(zyLastSearch.q);
  const a = document.getElementById('suggestBox'); if(a) a.classList.add('page-hidden');
  const b = document.getElementById('suggestBoxMobile'); if(b) b.classList.add('page-hidden');
  closeMobileSearch(); openPDP(id);
}
function zsChip(btn, cat){
  const box = btn.closest('.zs-wrap'); if(!box) return;
  box.querySelectorAll('.zs-chip').forEach(c => c.classList.toggle('on', c === btn));
  box.querySelectorAll('.zs-card').forEach(c => { c.hidden = !!cat && c.getAttribute('data-cat') !== cat; });
}
function handleSearch(q, boxId){
  boxId = boxId || 'suggestBox';
  const box = document.getElementById(boxId); if(!box) return;
  q = (q || '').trim();
  if(q.length < 2){ zyRenderSearchPanel(boxId); return; }
  const tokens = zySearchWords(q), results = zySearchResults(q), isPage = boxId === 'searchPageResults';
  zyLastSearch = { q, results };
  const qa = zsEsc(q);
  if(!results.length){
    box.innerHTML = `<div class="zs-empty ${isPage ? 'zs-wrap' : ''}"><div class="zs-empty-t">No encontramos “${qa}”</div>
      <p>Revisa la ortografía o prueba con la marca, el modelo o la categoría.</p>
      <div class="zs-chips">${CATS.slice(0, 8).map(c => `<button type="button" class="zs-chip" data-q="${zsEsc(c)}" onclick="runSearchAll(this.dataset.q)">${zsEsc(c)}</button>`).join('')}</div>
      <button type="button" class="zs-photo" onclick="openImageSearchModal()">Buscar por foto</button></div>`;
    box.classList.remove('page-hidden'); return;
  }
  if(!isPage){
    box.innerHTML = results.slice(0, 6).map(p => `
      <div class="zs-row" data-zs onclick="zsOpen(${p.id})">
        <div class="zs-th">${zsThumb(p)}</div>
        <div class="zs-tx"><small>${zyHighlight(p.brand || '', tokens)}</small><span>${zyHighlight(p.name || '', tokens)}</span></div>
        ${zsPrice(p)}
      </div>`).join('') + (results.length > 6 ? `<div class="suggest-item suggest-all" data-zs onclick="runSearchAll(this.dataset.q)" data-q="${qa}">Ver los ${results.length} resultados para “${qa}”</div>` : '');
    box.classList.remove('page-hidden'); return;
  }
  const counts = {}; results.forEach(p => { const c = p.category || 'Otros'; counts[c] = (counts[c] || 0) + 1; });
  const cats = Object.keys(counts).sort((a, b) => counts[b] - counts[a]).slice(0, 8);
  box.innerHTML = `<div class="zs-wrap">
    <div class="zs-head"><div><b>${results.length}</b> ${results.length === 1 ? 'resultado' : 'resultados'} para “${qa}”</div>
      <button type="button" class="zs-all" data-q="${qa}" onclick="runSearchAll(this.dataset.q)">Ver en el catálogo con filtros →</button></div>
    ${cats.length > 1 ? `<div class="zs-chips"><button type="button" class="zs-chip on" onclick="zsChip(this,'')">Todo <i>${results.length}</i></button>${cats.map(c => `<button type="button" class="zs-chip" onclick="zsChip(this,this.dataset.c)" data-c="${zsEsc(c)}">${zsEsc(c)} <i>${counts[c]}</i></button>`).join('')}</div>` : ''}
    <div class="zs-grid">${results.slice(0, 48).map(p => `
      <div class="zs-card" data-zs data-cat="${zsEsc(p.category || 'Otros')}" onclick="zsOpen(${p.id})">
        <div class="zs-ph">${zsThumb(p)}<div class="zs-tags">${zsBadges(p)}</div></div>
        <div class="zs-info"><small>${zyHighlight(p.brand || '', tokens)}</small><span>${zyHighlight(p.name || '', tokens)}</span>${zsPrice(p)}</div>
      </div>`).join('')}</div>
    ${results.length > 48 ? `<div style="text-align:center;margin-top:20px;"><button type="button" class="zs-all" data-q="${qa}" onclick="runSearchAll(this.dataset.q)">Ver los ${results.length} resultados →</button></div>` : ''}
  </div>`;
  box.classList.remove('page-hidden');
}
/* Teclado: ↑ ↓ mueven la selección, Enter abre la pieza seleccionada, Esc limpia el campo. */
document.addEventListener('keydown', e => {
  const id = e.target && e.target.id;
  if(id !== 'searchInputPage' && id !== 'searchInputMobile') return;
  const box = document.getElementById(id === 'searchInputPage' ? 'searchPageResults' : 'suggestBoxMobile'); if(!box) return;
  if(e.key === 'Escape'){ e.target.value = ''; handleSearch('', id === 'searchInputPage' ? 'searchPageResults' : 'suggestBoxMobile'); return; }
  const items = Array.prototype.slice.call(box.querySelectorAll('[data-zs]')).filter(x => !x.hidden); if(!items.length) return;
  let i = items.findIndex(x => x.classList.contains('zs-active'));
  if(e.key === 'ArrowDown' || e.key === 'ArrowUp'){
    e.preventDefault(); items.forEach(x => x.classList.remove('zs-active'));
    i = e.key === 'ArrowDown' ? (i + 1) % items.length : (i <= 0 ? items.length - 1 : i - 1);
    items[i].classList.add('zs-active'); items[i].scrollIntoView({ block: 'nearest' });
  } else if(e.key === 'Enter' && i >= 0){ e.preventDefault(); e.stopImmediatePropagation(); items[i].click(); }
}, true);

