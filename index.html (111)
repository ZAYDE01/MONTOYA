/* ================= [GORRAS] Detalles (colección, género, tipo) + imágenes compartidas =================
   Cerrada / Ajustable: la imagen de "Características de silueta" y la de "Cómo saber tu talla" se suben una
   sola vez por tipo desde el panel privado y se muestran solas en TODAS las gorras de ese tipo. Cada imagen
   vive en su propia clave de AdminStore (zayde:admin:cap:<tipo>) para no acercarse al límite de 1 MB por
   documento de Firestore, y solo se leen cuando alguien abre una gorra, la guía de tallas o el panel de gorras. */
function zyIsGorraCat(c){ return /^gorra/i.test(String(c || '').trim()); }
const ZY_GORRA_TIPOS = ["Cerrada","Ajustable"];
const ZY_GORRA_GENEROS = ["Mujer","Hombre","Niña","Niño","Unisex"];
const ZY_CAP_IMG_KEYS = ['silueta:Cerrada','silueta:Ajustable','talla:Cerrada','talla:Ajustable','guia'];
let zyCapImgs = {};
let zyCapPromise = null;
let zyGorraTipo = '';
function zyCapKey(kind, tipo){ return kind === 'guia' ? 'guia' : kind + ':' + tipo; }
function zyCapLoad(){
  if(!zyCapPromise){
    zyCapPromise = Promise.all(ZY_CAP_IMG_KEYS.map(k=>
      AdminStore.get('zayde:admin:cap:' + k).catch(()=>null).then(v=>{ zyCapImgs[k] = (typeof v === 'string') ? v : (zyCapImgs[k] || ''); })
    )).then(()=>zyCapImgs);
  }
  return zyCapPromise;
}
function zyGorraSetForm(p){
  const g = (p && p.gorraDetails) || {};
  const col = document.getElementById('zyGorraColeccion'); if(col) col.value = g.coleccion || '';
  zyRopaFillSelect(document.getElementById('zyGorraGenero'), ZY_GORRA_GENEROS, g.genero || '');
  zyGorraTipo = ZY_GORRA_TIPOS.includes(g.tipo) ? g.tipo : '';
  zyRenderGorraSlots();
}
function zyGetGorraDetails(){
  const out = {};
  const col = document.getElementById('zyGorraColeccion').value.trim(); if(col) out.coleccion = col;
  const gen = document.getElementById('zyGorraGenero').value; if(gen) out.genero = gen;
  if(zyGorraTipo) out.tipo = zyGorraTipo;
  return out;
}
function zySetGorraTipo(t){
  zyGorraTipo = (zyGorraTipo === t) ? '' : t;
  zyRenderGorraSlots();
}
async function zyRenderGorraSlots(){
  const chips = document.getElementById('zyGorraTipoChips');
  if(chips) chips.innerHTML = ZY_GORRA_TIPOS.map(t=>`<button type="button" class="size-opt ${t===zyGorraTipo?'active':''}" onclick="zySetGorraTipo('${t}')">${t}</button>`).join('');
  const box = document.getElementById('zyGorraSlots'), det = document.getElementById('zyGorraDetails');
  if(!box || !det || det.style.display === 'none') return;   // solo trabaja (y lee imágenes) cuando se está en la sección Gorras
  const imgs = await zyCapLoad();
  const slot = (kind, label, tipo, hint)=>{
    const url = imgs[zyCapKey(kind, tipo)] || '';
    return `<div class="zy-cap-slot">
      <div class="zy-cap-thumb">${url ? `<img src="${url}" alt="">` : 'Sin imagen'}</div>
      <div class="zy-cap-slot-info"><b>${label}${tipo ? ' · ' + tipo : ''}</b>
        <div class="zy-cap-slot-actions">
          <label class="btn btn-ghost" style="padding:4px 10px; font-size:11px; cursor:pointer;">${url ? 'Cambiar imagen' : 'Subir imagen'}<input type="file" accept="image/*" style="display:none;" onchange="zyCapUpload('${kind}', this)"></label>
          ${url ? `<button type="button" class="zy-select-all" style="margin-left:0; color:var(--down);" onclick="zyCapRemove('${kind}')">Quitar</button>` : ''}
        </div>
        <p class="zy-hint">${hint}</p>
      </div></div>`;
  };
  box.innerHTML = zyGorraTipo
    ? slot('silueta', 'Características de silueta', zyGorraTipo, `Se guarda una sola vez y sale en todas las gorras ${zyGorraTipo.toLowerCase() === 'cerrada' ? 'Cerradas' : 'Ajustables'}.`)
      + slot('talla', 'Cómo saber tu talla', zyGorraTipo, `Se guarda una sola vez y sale en todas las gorras ${zyGorraTipo.toLowerCase() === 'cerrada' ? 'Cerradas' : 'Ajustables'}.`)
      + (zyGorraTipo === 'Cerrada' ? slot('guia', 'Imagen de la guía de tallas', 'Cerrada', 'Solo para gorras cerradas. Se ve en la guía de tallas, dentro de Gorra cerrada. Las ajustables no llevan imagen de guía.') : '')
    : '<p class="zy-hint" style="margin:0 0 12px;">Elige Cerrada o Ajustable para ver o subir sus imágenes.</p>';
}
async function zyCapUpload(kind, input){
  const f = input.files && input.files[0];
  if(!f) return;
  const tipo = zyGorraTipo;
  if(kind !== 'guia' && !tipo){ showToast('Primero elige Cerrada o Ajustable.', true); input.value = ''; return; }
  try{
    let url = await zyCompressImageFile(f, 1400, 0.8);
    if(url.length > 900000) url = await zyCompressImageFile(f, 1000, 0.7);
    if(url.length > 950000){ showToast('La imagen es demasiado pesada. Prueba con una más pequeña.', true); input.value = ''; return; }
    await zyCapLoad();
    const key = zyCapKey(kind, tipo);
    await AdminStore.set('zayde:admin:cap:' + key, url);
    zyCapImgs[key] = url;
    zyRenderGorraSlots();
    showToast(kind === 'guia' ? 'Guía de tallas de gorras actualizada.' : `Imagen guardada: se verá en todas las gorras ${tipo === 'Cerrada' ? 'Cerradas' : 'Ajustables'}.`);
  }catch(e){ console.error(e); showToast('No se pudo procesar la imagen.', true); }
  input.value = '';
}
async function zyCapRemove(kind){
  const tipo = zyGorraTipo;
  if(kind !== 'guia' && !tipo) return;
  const key = zyCapKey(kind, tipo);
  try{
    await zyCapLoad();
    await AdminStore.set('zayde:admin:cap:' + key, '');
    zyCapImgs[key] = '';
    zyRenderGorraSlots();
    showToast('Imagen eliminada.');
  }catch(e){ console.error(e); showToast('No se pudo eliminar la imagen.', true); }
}
