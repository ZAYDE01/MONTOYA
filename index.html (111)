/* [VITRINAS POR DEFECTO — ESTILO NIKE] Si el admin todavía no cargó
   ninguna Vitrina real desde su panel privado (#psec-vitrinas), el
   carrusel de publicidad del inicio se quedaba vacío y oculto — el
   sitio se veía "sin publicidad" hasta que alguien entrara a
   configurarlo a mano. Ahora, mientras no haya vitrinas reales, se
   arman recuadros de respaldo con las fotos y categorías que ya existen
   en el catálogo (misma lógica que ya usaba el feed de publicidad
   móvil en zyRenderHomeFeedMobile), para que el recuadro grande de
   publicidad del inicio SIEMPRE tenga contenido, igual que en Nike.
   En cuanto el admin agregue una vitrina real, esta reemplaza a las
   de respaldo automáticamente (ver renderPromoBanners). */
/* [MÁS RECUADROS] Antes tope de 4 vitrinas de respaldo -> ahora 8, para
   que el carrusel de arriba y la fila de 2 de abajo (zyRenderPromoRow)
   siempre tengan contenido variado, igual que la portada de Nike, que
   nunca se queda con una sola vitrina. Los textos también rotan entre
   varias frases en vez de repetir siempre la misma. */
const ZY_PROMO_DESC_VARIANTS = [
  'Piezas nuevas y verificadas, con autenticidad garantizada en cada envío.',
  'Lo más buscado de la temporada, listo para enviarse hoy mismo.',
  'Autenticidad verificada pieza por pieza antes de llegar a tu puerta.',
  'La selección que se está agotando primero — entra antes que se acabe.'
];
function zyDefaultPromoBanners(limit){
  limit = limit || 8;
  if(!CATS || !CATS.length) return [];
  const pool = zyBrowsable();
  const picks = [];
  let i = 0;
  for(const cat of CATS){
    const item = pool.find(p=>p.category===cat && p.images && p.images[0]);
    const img = zyCategoryImages[cat] || (item && item.images[0]);
    if(!img){ i++; continue; }
    picks.push({
      title: `Colección ${cat}`,
      tag: cat.toUpperCase(),
      desc: ZY_PROMO_DESC_VARIANTS[i % ZY_PROMO_DESC_VARIANTS.length],
      images: [img],
      ctaLabel: 'Explorar',
      ctaCat: cat
    });
    i++;
    if(picks.length >= limit) break;
  }
  return picks;
}
/* [VITRINAS PRECARGADAS — ZAYDE Y ZAYDE G] Antes, los recuadros de
   "Colección Ropa / Descubre Ropa / Descubre Perfumes / Descubre Bolsos"
   que se veían en el inicio eran puro relleno automático (zyDefaultPromoBanners
   / zyRenderHomeFeedMobile): no existían como vitrinas reales, así que no
   aparecían en "Vitrinas agregadas" del panel privado y no se podían editar
   ni con texto ni con foto — para cambiarlos había que crear una vitrina
   desde cero. Esta función los convierte en vitrinas reales (con id,
   fotos e imagen editables desde el panel) para Ropa, Perfumes y Bolsos,
   tanto en ZAYDE como en ZAYDE G, la primera vez que el sitio carga sin
   ninguna vitrina guardada. Solo corre una vez por sitio (usa la bandera
   'zayde:admin:promobanners:seeded' para no revivir vitrinas que el admin
   haya borrado a propósito más adelante). */
const ZY_PROMO_SEED_CATS = ['Ropa','Perfumes','Bolsos'];
async function zySeedDefaultPromoBanners(){
  try{
    const already = await (window.__zySeededP || AdminStore.get('zayde:admin:promobanners:seeded').catch(()=>null));
    if(already) return false;
    const seeded = [];
    let n = 0;
    // ---- ZAYDE: una vitrina real por categoría, con la foto que ya
    // tiene esa categoría en el catálogo (portada manual o la más vista).
    ZY_PROMO_SEED_CATS.filter(cat=>CATS.includes(cat)).forEach(cat=>{
      const pool = zyBrowsable().filter(p=>p.category===cat && p.images && p.images[0]);
      const img = zyCategoryImages[cat] || (pool[0] && pool[0].images[0]);
      if(!img) return;
      seeded.push({
        id: Date.now()+(n++), title: `Descubre ${cat}`, store: 'zayde',
        tag: cat.toUpperCase(), desc: ZY_PROMO_DESC_VARIANTS[n % ZY_PROMO_DESC_VARIANTS.length],
        images: [img], videoUrl: '', ctaLabel: 'Explorar', ctaCat: cat, visible: true
      });
    });
    // ---- ZAYDE G: mismas 3 categorías, con foto propia de ZAYDE G si ya
    // tiene piezas cargadas en esa categoría; si no, usa de respaldo la
    // misma foto que ZAYDE para no quedar vacía (el admin puede cambiarla
    // cuando quiera desde el panel).
    const zgItems = (typeof zyClothesGProducts==='function') ? zyClothesGProducts() : [];
    ZY_PROMO_SEED_CATS.forEach(cat=>{
      const pick = zgItems.filter(p=>p.category===cat && p.images && p.images[0])[0];
      const img = (pick && pick.images[0]) || zyCategoryImages[cat];
      if(!img) return;
      seeded.push({
        id: Date.now()+1000+(n++), title: `Descubre ${cat}`, store: 'clothesg',
        tag: cat.toUpperCase(), desc: ZY_PROMO_DESC_VARIANTS[n % ZY_PROMO_DESC_VARIANTS.length],
        images: [img], videoUrl: '', ctaLabel: 'Explorar', ctaCat: cat, visible: true
      });
    });
    if(seeded.length){
      zyPromoBanners = zyPromoBanners.concat(seeded);
      await AdminStore.set('zayde:admin:promobanners', zyPromoBanners);
    }
    await AdminStore.set('zayde:admin:promobanners:seeded', true);
    return seeded.length > 0;
  }catch(e){ console.error('No se pudieron precargar las vitrinas por defecto:', e); return false; }
}
function renderPromoBanners(){
