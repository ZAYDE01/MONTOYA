  // [FIX "se queda congelada la sección"] Ver zySyncScrollLock más abajo en
  // el archivo: si algún panel se cerró sin limpiar bien su estado, esto
  // libera el scroll del body ANTES de cambiar de página, para que
  // cambiar de sección nunca se quede trabado por un candado viejo.
  if(window.zySyncScrollLock) window.zySyncScrollLock();
  ['home','catalog','pdp','favorites','contacto','info','mayoreo','account','club','giftcard','ropag','search','cart','checkout','tracking','404'].forEach(p=>document.getElementById('page-'+p).classList.add('page-hidden'));
  document.getElementById('page-'+page).classList.remove('page-hidden');
  currentPage = page;
  if(page!=='pdp') zyClearProductSchema();
