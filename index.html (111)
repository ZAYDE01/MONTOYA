// [VIEW TRANSITIONS] Helper compartido por navigate() y openPDP(). Se pidió
// específicamente evitar que, al abrir un producto (que internamente llama a
// navigate('pdp', true)), se disparen DOS transiciones anidadas — el
// navegador no soporta iniciar una View Transition mientras otra sigue en
// curso, así que zyVTRunning actúa como candado: quien llegue primero
// (siempre openPDP, cuando aplica) hace la animación completa, y la
// navigate() interna que sigue solo actualiza el DOM sin pedir otra.
let zyVTRunning = false;
function zySupportsViewTransitions(){
  return typeof document.startViewTransition === 'function'
    && !(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
}
function zyRunWithViewTransition(fn, cleanup){
  if(!zySupportsViewTransitions() || zyVTRunning){
    fn();
    if(cleanup) cleanup();
    return;
  }
  zyVTRunning = true;
  let t;
  try{ t = document.startViewTransition(fn); }
  catch(e){ zyVTRunning = false; if(cleanup) cleanup(); return; }
  t.finished.catch(function(){}).finally(function(){
    zyVTRunning = false;
    if(cleanup) cleanup();
  });
}
function navigate(page, skipPush){
