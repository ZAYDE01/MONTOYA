    if(stock<=0) return `<button type="button" class="size-opt disabled has-bell" onclick="zyOpenNotifyStock(${p.id},'${s.replace(/'/g,"\\'")}')" aria-label="Talla ${zyTallaTxt(p,s)} agotada — avísame cuando llegue" data-us="${s}">${zyTallaHtml(p,s)}<span class="size-bell-btn" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:12px;height:12px;"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span></button>`;
    // [URGENCIA REAL] Solo se marca "Última" cuando el stock real de esa
    // talla es 1 — nunca un texto fijo ni un número aleatorio.
    const lowBadge = stock===1 ? `<span class="size-low-stock">Última</span>` : '';
    return `<button type="button" class="size-opt${stock===1?' size-opt-low':''}" onclick="selectSize('${s}',this)" data-us="${s}"${(p.category==='Gorras' && CAP_CM[s]) ? ` title="${CAP_CM[s]} cm"` : ''}>${zyTallaHtml(p,s)}${(p.category==='Gorras' && CAP_CM[s]) ? `<small style="display:block;font-size:10px;opacity:.65;font-weight:500;">${CAP_CM[s]} cm</small>` : ''}${lowBadge}</button>`;
  }).join('');
  // [BOLSOS] Talla única: no hay nada que elegir, así que se oculta el selector y se
