/* Devuelve los productos de una sección del home: si el admin marcó productos
   como "destacados" para esa sección desde el panel privado, se usan esos
   (en el orden en que fueron marcados); si no hay ninguno marcado, se usa el
   criterio automático que ya traía el sitio (fallback). */
/* [HOME-CATEGORIAS] Fila "Compra por categorías" — una pieza real de cada
   categoría (la más vista) sirve de foto redonda; si una categoría todavía
   no tiene fotos reales, se usa un color de respaldo, nunca queda vacía. */
/* [HOME-CATEGORIAS — REDISEÑO] Arma el mosaico estilo Fashion Nova a partir
   de una lista de categorías + una función que devuelve la foto de cada
   una. Se comparte entre ZAYDE (zyRenderCatShopGrid) y ZAYDE G
   (zgRenderCatShopGrid) para que el mosaico se vea igual en los dos, sin
   duplicar el HTML de cada tamaño de recuadro. */
function zyBuildCatShopMosaic(cats, getImg, onclickFn){
  const tile = (cat, sizeClass) => {
    const img = getImg(cat);
    return `
    <button type="button" class="cat-shop-tile ${sizeClass}" onclick="${onclickFn}('${cat.replace(/'/g,"\\'")}')">
      ${img ? `<img src="${img}" alt="${zyEscapeHtml(cat)}" loading="lazy">` : ''}
      <span class="cat-shop-label">${zyEscapeHtml(cat)}</span>
    </button>`;
  };
  if(!cats.length) return '';
  // 1ra categoría: recuadro grande. 2da y 3ra: medianas apiladas al lado.
  // El resto: fila de recuadros chicos parejos debajo (como en la referencia).
  const big = cats[0];
  const meds = cats.slice(1,3);
  const smalls = cats.slice(3);
  let html = `<div class="cat-shop-top">${tile(big,'is-big')}`;
  if(meds.length){
    html += `<div class="cat-shop-side">${meds.map(c=>tile(c,'is-med')).join('')}</div>`;
  }
  html += `</div>`;
  if(smalls.length){
    html += `<div class="cat-shop-small-row">${smalls.map(c=>tile(c,'is-small')).join('')}</div>`;
  }
  return html;
}

