function zyVhInitSwipe(){
  const grid = document.getElementById('grid-promobanners');
  if(!grid) return;
  if(window.matchMedia('(max-width:760px)').matches) return; /* en celular ya es un scroll horizontal nativo con snap, no hace falta simularlo por JS */
  let startX = 0, startY = 0, tracking = false;
  grid.ontouchstart = (e)=>{ if(!e.touches||!e.touches[0]) return; startX = e.touches[0].clientX; startY = e.touches[0].clientY; tracking = true; };
  grid.ontouchend = (e)=>{
    if(!tracking) return; tracking = false;
    const t = (e.changedTouches && e.changedTouches[0]); if(!t) return;
    const dx = t.clientX - startX, dy = t.clientY - startY;
