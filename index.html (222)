/* [REPORTES CSV] Celda segura: evita que Excel/Sheets ejecuten como fórmula un texto que empiece con = + - @
   (números y teléfonos tipo +52 33… pasan tal cual). */
function zyCsvCell(v){
  if(typeof v === 'number') return isFinite(v) ? String(v) : '';
  let s = String(v == null ? '' : v);
  if(/^[=+\-@\t\r]/.test(s) && !/^[+\-]?[\d\s().-]+$/.test(s)) s = "'" + s;
  return '"' + s.replace(/"/g, '""') + '"';
}
function zyCsvDownload(filename, rows){
  const blob = new Blob(['\ufeff' + rows.map(r => r.map(zyCsvCell).join(',')).join('\r\n')], { type:'text/csv;charset=utf-8' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob); a.download = filename;
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 4000);
}
