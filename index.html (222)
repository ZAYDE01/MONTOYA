      el.dataset.zyBound = '1';
      el.addEventListener('blur', ()=>{
        const key = el.getAttribute('data-zt');
        zySaveTextOverride(key, el.textContent.trim());
      });
      el.addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); el.blur(); } });
    }
  });
}
