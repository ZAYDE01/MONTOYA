<script>
/* [RECORTADOR] Abre una ventana para acomodar/hacer zoom a la imagen dentro de un marco con la proporción exacta.
   Devuelve un File JPG ya recortado (o null si se cancela). */
window.zhCrop=function(file,ratio,outW,title){
  return new Promise(function(resolve){
    var url=URL.createObjectURL(file), img=new Image();
    img.onerror=function(){ URL.revokeObjectURL(url); alert('No se pudo leer la imagen.'); resolve(null); };
    img.onload=function(){
      var iw=img.naturalWidth, ih=img.naturalHeight, fw, fh;
      if(ratio>=1){ fw=Math.min(window.innerWidth-56,860); fh=fw/ratio; } else { fh=Math.min(window.innerHeight*0.55,460); fw=fh*ratio; }
      var minS=Math.max(fw/iw,fh/ih), s=minS, x=(fw-iw*s)/2, y=(fh-ih*s)/2, drag=null;
      var ov=document.createElement('div');
      ov.style.cssText='position:fixed;inset:0;z-index:100000;background:rgba(0,0,0,.82);display:flex;align-items:center;justify-content:center;padding:16px;overflow:auto';
      var btn='padding:9px 16px;border-radius:8px;font:inherit;font-size:13px;font-weight:700;cursor:pointer;';
      ov.innerHTML='<div style="background:var(--surface,#15161c);color:var(--text,#fff);border:1px solid var(--line,#333);border-radius:14px;padding:16px;max-width:100%;box-sizing:border-box">'+
        '<div style="font-weight:800;font-size:14px;margin-bottom:4px">'+title+'</div>'+
        '<div style="font-size:12px;opacity:.7;margin-bottom:10px">Arrastra la imagen para acomodarla y usa el zoom. Lo que ves dentro del marco es lo que se guarda.</div>'+
        '<div class="zcr-frame" style="position:relative;width:'+fw+'px;height:'+fh+'px;overflow:hidden;background:#000;border-radius:8px;touch-action:none;cursor:grab;margin:0 auto"></div>'+
        '<div style="display:flex;align-items:center;gap:10px;margin:12px auto 0;max-width:'+fw+'px"><span style="font-size:12px">Zoom</span><input class="zcr-zoom" type="range" min="100" max="400" value="100" style="flex:1"></div>'+
        '<div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px"><button type="button" class="zcr-cancel" style="'+btn+'border:1px solid var(--line,#444);background:transparent;color:inherit">Cancelar</button><button type="button" class="zcr-ok" style="'+btn+'border:0;background:#4A5FC7;color:#fff">Guardar recorte</button></div></div>';
      document.body.appendChild(ov);
      var frame=ov.querySelector('.zcr-frame'), zoom=ov.querySelector('.zcr-zoom');
      img.style.cssText='position:absolute;max-width:none;user-select:none;-webkit-user-drag:none;pointer-events:none';
      frame.appendChild(img);
      function clamp(){ x=Math.min(0,Math.max(fw-iw*s,x)); y=Math.min(0,Math.max(fh-ih*s,y)); }
      function render(){ img.style.width=(iw*s)+'px'; img.style.height=(ih*s)+'px'; img.style.left=x+'px'; img.style.top=y+'px'; }
      function setZoom(v){ var cx=(fw/2-x)/s, cy=(fh/2-y)/s; s=minS*(v/100); x=fw/2-cx*s; y=fh/2-cy*s; clamp(); render(); }
      clamp(); render();
      zoom.addEventListener('input',function(){ setZoom(+zoom.value); });
      frame.addEventListener('wheel',function(e){ e.preventDefault(); zoom.value=Math.max(100,Math.min(400,+zoom.value+(e.deltaY<0?10:-10))); setZoom(+zoom.value); },{passive:false});
      frame.addEventListener('pointerdown',function(e){ drag={px:e.clientX,py:e.clientY,x:x,y:y}; try{frame.setPointerCapture(e.pointerId);}catch(_){} frame.style.cursor='grabbing'; });
      frame.addEventListener('pointermove',function(e){ if(!drag) return; x=drag.x+(e.clientX-drag.px); y=drag.y+(e.clientY-drag.py); clamp(); render(); });
      function end(){ drag=null; frame.style.cursor='grab'; }
      frame.addEventListener('pointerup',end); frame.addEventListener('pointercancel',end);
      function done(val){ document.removeEventListener('keydown',onKey); ov.remove(); URL.revokeObjectURL(url); resolve(val); }
      function onKey(e){ if(e.key==='Escape') done(null); }
      document.addEventListener('keydown',onKey);
      ov.querySelector('.zcr-cancel').onclick=function(){ done(null); };
      ov.querySelector('.zcr-ok').onclick=function(){
        var cw=Math.min(outW,Math.round(fw/s)), ch=Math.round(cw/ratio), c=document.createElement('canvas'); c.width=cw; c.height=ch;
        c.getContext('2d').drawImage(img,-x/s,-y/s,fw/s,fh/s,0,0,cw,ch);
        c.toBlob(function(b){ if(!b){ alert('No se pudo recortar la imagen.'); return done(null); } done(new File([b],'banner.jpg',{type:'image/jpeg'})); },'image/jpeg',0.9);
      };
    };
    img.src=url;
  });
};
</script>
