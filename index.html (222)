/* [FIX — "no me llega ningún gmail de aviso"] La causa real: la lista
   'zayde:dropSubscribers' se guardaba vía AdminStore en la colección
   admin_meta de Firestore, que las reglas de seguridad bloquean para
   cualquiera que NO sea el admin (igual que admin_products/overrides) —
   así que aunque hubiera un formulario público para apuntarse, ESCRIBIR
   ahí desde el navegador de un visitante fallaba siempre, y la lista se
   quedaba vacía para siempre (por eso nunca salía ningún correo, y de
   hecho nada en todo el archivo llegó a escribir ahí jamás).
   Ahora "avísenme del Drop" tiene su propia colección de Firestore
   PÚBLICA, dropSubscribers (mismo patrón que newsletterSubscribers, que
   sí funciona), donde el admin puede agregar gente a mano desde el panel
   (ver zyAdminAddDropSubscriber). Esta función junta esa colección con
   newsletterSubscribers (popup "10% en tu primera compra"), así el aviso
   de Drop en vivo tiene a quién avisarle de verdad, sin pedirle a nadie
   que se registre dos veces. El backend (/api/send-email, type "drop")
   también se actualizó para aceptar correos de cualquiera de las dos
   colecciones. */
async function zyGetDropSubscriberList(){
  if(typeof db === 'undefined' || !db) return [];
  try{
    const snap = await db.collection('dropSubscribers').orderBy('date','desc').get();
    return snap.docs.map(doc=>({ id: doc.id, ...doc.data() }));
  }catch(e){ console.error('No se pudo leer dropSubscribers:', e); return []; }
}
async function zyGetDropEmailRecipients(){
  const map = {};
  try{
    const list = await zyGetDropSubscriberList();
    list.forEach(s=>{ if(s.email) map[s.email.toLowerCase()] = { name: s.name || '', email: s.email }; });
  }catch(e){ console.error(e); }
  try{
    if(typeof db !== 'undefined' && db){
      const snap = await db.collection('newsletterSubscribers').get();
      snap.forEach(doc=>{
        const d = doc.data();
        if(d && d.email && !map[d.email.toLowerCase()]) map[d.email.toLowerCase()] = { name:'', email: d.email };
      });
    }
  }catch(e){ console.error('No se pudo leer newsletterSubscribers:', e); }
  return Object.values(map);
}
