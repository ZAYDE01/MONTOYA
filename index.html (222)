/* ============================================================
   [SEGURIDAD] Acceso admin REAL con Firebase Auth.
   Antes esto comparaba un hash en el navegador — cualquiera podía abrir la
   consola y llamar zyOpenAdmin() directo, sin contraseña, y como las
   Reglas de Firestore tenían que estar abiertas para que eso funcionara,
   cualquiera podía además leer/escribir la base de datos completa desde
   fuera del sitio (pedidos con nombre/teléfono/dirección incluidos).

   Ahora la verificación la hace Firebase (servidor), no el navegador:
   zyCheckPass() intenta iniciar sesión con signInWithEmailAndPassword.
   Si la contraseña es incorrecta, Firebase la rechaza — no hay hash que
   comparar ni forma de "ver" la respuesta correcta en el código fuente.
   La seguridad real, sin embargo, vive en las Reglas de Firestore
   (firestore.rules): SOLO permiten escribir en admin_products,
   admin_overrides, admin_meta y actualizar orders si
   request.auth.uid existe como documento en la colección "admins".
   Sin eso, iniciar sesión aquí no te dejaría guardar nada.

   CONFIGURACIÓN REQUERIDA (una sola vez, en Firebase Console):
   1) Authentication > Sign-in method > activa "Correo/contraseña".
   2) Authentication > Users > Add user: crea tu cuenta admin
      (ej. tuemail@zayde.com + una contraseña fuerte) y copia su UID.
   3) Firestore > colección "admins" > crea un documento con ID = ese UID
      y cualquier campo, ej. { role: "owner" } (el contenido no importa,
      solo que el documento exista con ese ID — eso es lo que autoriza).
   4) Reemplaza ZY_ADMIN_EMAIL abajo por el correo que usaste en el paso 2.
   5) Sube firestore.rules a tu proyecto (Firestore > Reglas, o con
      `firebase deploy --only firestore:rules` si usas Firebase CLI).
   ============================================================ */
const ZY_ADMIN_EMAIL = "zayde.com.mx@gmail.com"; // <- reemplaza por el correo real del usuario admin creado en Firebase Auth
// [FIX] ¿Este usuario de Firebase Auth es la cuenta ADMIN (y no un cliente)?
function zyIsAdminAuthUser(user){
  try{ return !!(user && user.email && String(user.email).toLowerCase() === String(ZY_ADMIN_EMAIL).toLowerCase()); }
  catch(e){ return false; }
}

// [FIX] "No se pudo conectar con el servicio de acceso" aunque Firebase sí
// cargue bien: antes zyCheckPass() revisaba `firebaseReady` UNA sola vez,
// al instante — si el SDK de Firebase (que se carga con `defer`, en
// paralelo con Sentry, Stripe, fuentes, etc.) tardaba aunque fuera un
// segundo de más en estar listo, el admin veía el error de conexión para
// siempre en esa visita, aunque Firebase terminara de cargar un momento
// después (confirmado: escribiendo "firebase" en la consola sí aparecía,
// solo que unos segundos más tarde de lo que este chequeo esperaba). Ahora
// espera hasta 5 segundos, revisando cada 200ms, antes de rendirse.
function zyWaitForFirebase(timeoutMs){
  return new Promise(resolve=>{
    const start = Date.now();
    (function poll(){
      if(zyTryInitFirebase()){ resolve(true); return; }
      if(Date.now() - start >= timeoutMs){ resolve(false); return; }
      setTimeout(poll, 300);
    })();
  });
}
async function zyCheckPass(){
  const val = document.getElementById('zyPassInput').value;
  const btn = document.querySelector('#zyPassRow button');
  if(!val){ return; }
  if(!firebaseReady){
    if(btn){ btn.disabled = true; btn.textContent = 'Conectando…'; }
    const ready = await zyWaitForFirebase(8000);
    if(btn){ btn.disabled = false; btn.textContent = 'Entrar'; }
    if(!ready){
      showToast('No se pudo conectar con el servicio de acceso. Motivo: ' + (zyFirebaseLastError || 'desconocido') + '. Revisa tu conexión, bloqueador de anuncios, o VPN, y recarga la página.', true);
      return;
    }
  }
  if(ZY_ADMIN_EMAIL.indexOf('TU_CORREO_ADMIN') !== -1){
    showToast('Falta configurar ZY_ADMIN_EMAIL en el código con el correo admin real de Firebase Auth.', true);
    return;
  }
  if(btn){ btn.disabled = true; btn.textContent = 'Verificando…'; }
  try{
    zyExplicitAuthInProgress = true; // [FIX] que el listener de sesión de clientes se haga a un lado mientras entra el admin
    await firebase.auth().signInWithEmailAndPassword(ZY_ADMIN_EMAIL, val);
    document.getElementById('zyPassInput').value = '';
    zyAdminAuthenticated = true; // no se vuelve a pedir hasta que se recargue la página
    zyCloseGate();
    zyOpenAdmin();
  } catch(err){
    console.warn('Acceso admin denegado:', err && err.code);
    const row = document.getElementById('zyPassRow');
    row.classList.remove('shake'); void row.offsetWidth; row.classList.add('shake');
    document.getElementById('zyPassInput').value = '';
  } finally {
    zyExplicitAuthInProgress = false;
    if(btn){ btn.disabled = false; btn.textContent = 'Entrar'; }
  }
}
