let zyPdpChart = null;
/* Grafica el precio de cada venta real de este producto a lo largo del
   tiempo (como el "Price History" de StockX).
   [FIX] Antes leía TODOS los pedidos completos (zyFetchAllOrders), lo cual
   dejó de ser posible para un visitante normal el día que se cerró esa
   colección por privacidad (correcto haberlo hecho). Ahora lee solo la
   colección priceHistory, que únicamente guarda precio+producto+fecha, sin
   ningún dato del cliente — pensada para ser pública desde el día uno.
   Nota: solo tendrá datos de ventas confirmadas DESPUÉS de este cambio;
   las ventas anteriores no aparecerán retroactivamente aquí. */
async function zyFetchPriceHistory(productId){
  if(db){
    try{
      const snap = await db.collection('priceHistory').where('productId','==',String(productId)).limit(200).get();
      return snap.docs.map(d=>d.data());
    }catch(e){ console.error('No se pudo leer el historial de precios:', e); }
  }
  return [];
}

async function zyRenderPriceHistory(productId){
  const block = document.getElementById('pdpPriceHistoryBlock');
  if(!block) return;
  const sales = await zyFetchPriceHistory(productId);
  if(!sales.length){ block.style.display = 'none'; return; }
  block.style.display = '';
  document.getElementById('pdpPriceHistoryCount').textContent = `${sales.length} vendido${sales.length===1?'':'s'}`;
}

let zyTextFieldKeys = [];

/* ================= PEDIDOS (panel privado) =================
   Lista los pedidos reales (Firestore o respaldo local) para que marques
   cada uno como verificado tras inspeccionar la pieza físicamente. */
/* ================= BUSCADOR Y FILTRO DE PEDIDOS (panel privado) =================
   zyOrdersAdminCache guarda TODOS los pedidos ya traídos de Firestore/local
   para esta sesión del panel, así el buscador y el orden (más recientes,
   más antiguos, mayor/menor total) filtran al instante sin volver a pedirle
   los datos a Firestore en cada tecleo. Se busca por nombre, teléfono,
   correo y por el código de pedido/cotización (ej. ZY-123456789012). */
let zyOrdersAdminCache = [];
function zyNormalizeSearchText(s){
  return String(s||'')
    .toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g,'') // quita acentos (méxico -> mexico)
    .trim();
}
async function zyRenderOrdersAdmin(){
  const box = document.getElementById('zyOrdersAdminList');
  box.innerHTML = '<div class="zy-quickhint">Cargando pedidos…</div>';
  const countEl = document.getElementById('zyOrdersResultsCount');
  if(countEl) countEl.style.display = 'none';
  const { orders } = await zyFetchAllOrders();
  zyOrdersAdminCache = orders || [];
  // [VENDEDORES] qué pedidos ya tienen su venta de vendedor (para mostrar "generada" o el botón de generarla)
  try{
    if(db){
      const ls = await db.collection('sellerSalesPrivate').limit(2000).get();
      window.zyOrderSaleLinks = new Set(ls.docs.map(d => d.data().orderNum));
    }
  }catch(e){ window.zyOrderSaleLinks = window.zyOrderSaleLinks || new Set(); }
  if(!zyOrdersAdminCache.length){
    box.innerHTML = '<div class="zy-quickhint">Todavía no hay pedidos registrados.</div>';
    return;
  }
  zyFilterOrdersAdmin();
}
let zyOrdersView = 'activos'; // 'activos' | 'cancelados'
function zySetOrdersView(v){ zyOrdersView = (v==='cancelados') ? 'cancelados' : 'activos'; zyFilterOrdersAdmin(); }
/* [CANCELADOS] El admin marca que ya devolvió el dinero (desde Stripe / Mercado Pago). Solo anota el estado: no mueve dinero. */
async function zyMarkRefundDone(orderNum){
  if(!confirm('¿Confirmas que ya reembolsaste este pedido desde tu pasarela de pago?')) return;
  const at = Date.now();
  try{
    if(!db) throw new Error('Firestore no disponible');
    await db.collection('orders').doc(orderNum).update({ 'refund.status':'reembolsado', 'refund.refundedAt':at });
    const o = zyOrdersAdminCache.find(x=>x.orderNum===orderNum);
    if(o){ o.refund = Object.assign({}, o.refund, { status:'reembolsado', refundedAt:at }); }
    showToast('Reembolso marcado como hecho');
    zyFilterOrdersAdmin();
  }catch(e){ console.error(e); showToast('No se pudo guardar (revisa tu sesión de admin y las reglas de Firestore)', true); }
}
function zyClearOrdersSearch(){
  const input = document.getElementById('zyOrdersSearchInput');
  if(input) input.value = '';
  zyFilterOrdersAdmin();
}
/* Filtra zyOrdersAdminCache por el texto del buscador (nombre, teléfono,
   correo o código ZY-...) y aplica el orden elegido, luego repinta la
   lista. Se llama en cada tecleo del buscador y al cambiar el select de
   orden — todo en memoria, sin llamadas de red. */
function zyFilterOrdersAdmin(){
  if(!document.getElementById('zyOrdersAdminList')) return;
  const rawQuery = document.getElementById('zyOrdersSearchInput') ? document.getElementById('zyOrdersSearchInput').value : '';
  const query = zyNormalizeSearchText(rawQuery);
  const sortMode = document.getElementById('zyOrdersSortSelect') ? document.getElementById('zyOrdersSortSelect').value : 'recent';
  const clearBtn = document.getElementById('zyOrdersSearchClear');
  if(clearBtn) clearBtn.style.display = query ? '' : 'none';

  // [CANCELADOS] separa pedidos activos de cancelados según la vista elegida
  const nCancel = zyOrdersAdminCache.filter(o=>o.status==='cancelado').length;
  const bA = document.getElementById('zyOrdersViewActivos'), bC = document.getElementById('zyOrdersViewCancelados');
  if(bC) bC.textContent = 'Cancelados (' + nCancel + ')';
  if(bA) bA.className = 'btn ' + (zyOrdersView==='activos' ? 'btn-primary' : 'btn-ghost');
  if(bC) bC.className = 'btn ' + (zyOrdersView==='cancelados' ? 'btn-primary' : 'btn-ghost');
  const baseList = zyOrdersAdminCache.filter(o=> zyOrdersView==='cancelados' ? o.status==='cancelado' : o.status!=='cancelado');
  let list = baseList.slice();
  if(query){
    list = list.filter(o=>{
      const haystack = [
        o.orderNum,
        o.name,
        o.email,
        o.phone,
        // el teléfono también se busca sin espacios/guiones, por si el
        // admin teclea solo dígitos (ej. "3312345678")
        o.phone ? String(o.phone).replace(/\D/g,'') : ''
      ].map(zyNormalizeSearchText).join(' ');
      return haystack.includes(query);
    });
  }
  list.sort((a,b)=>{
    if(sortMode==='oldest') return new Date(a.date) - new Date(b.date);
    if(sortMode==='total-desc') return (b.total||0) - (a.total||0);
    if(sortMode==='total-asc') return (a.total||0) - (b.total||0);
    return new Date(b.date) - new Date(a.date); // 'recent' (por defecto)
  });

  const countEl = document.getElementById('zyOrdersResultsCount');
  if(countEl){
    if(query || baseList.length > list.length){
      countEl.style.display = '';
      countEl.textContent = `${list.length} pedido${list.length===1?'':'s'} encontrado${list.length===1?'':'s'} de ${baseList.length} en total.`;
    } else {
      countEl.style.display = 'none';
    }
  }

  const box = document.getElementById('zyOrdersAdminList');
  if(!list.length){
    box.innerHTML = '<div class="zy-quickhint">' + (zyOrdersView==='cancelados' && !baseList.length ? 'No hay pedidos cancelados.' : 'Ningún pedido coincide con esa búsqueda.') + '</div>';
    return;
  }
  if(zyOrdersView==='cancelados'){
    box.innerHTML = list.slice(0,60).map(o=>{
      const itemsSummary = (o.items||[]).map(it=>`${it.qty}× ${it.name}${it.size?' (T'+it.size+')':''}`).join(', ');
      const rf = o.refund || {};
      const paid = o.paymentStatus==='pagado';
      const refundHTML = rf.status==='reembolsado'
        ? `<span style="color:var(--up);font-weight:700;">✓ Reembolsado${rf.refundedAt ? ' el ' + new Date(rf.refundedAt).toLocaleDateString('es-MX') : ''}</span>`
        : (paid || rf.status==='pendiente')
          ? `<span style="color:#D45A5A;font-weight:700;">Reembolso pendiente · ${fmt(o.total)}</span> <button type="button" class="zy-order-verify-btn" onclick="zyMarkRefundDone('${zyEscapeHtml(o.orderNum)}')">Marcar reembolsado</button>`
          : `<span style="color:var(--steel);">Sin cobro: no hay nada que reembolsar</span>`;
      const giftNote = Number(o.giftCardUsed) > 0 ? (Number(o.giftRestored) > 0 ? `<span style="color:var(--up);">Saldo de tarjeta de regalo (${fmt(o.giftRestored)}) devuelto automáticamente ✓</span>` : `<span>Pagó ${fmt(o.giftCardUsed)} con saldo de tarjeta de regalo y no se devolvió solo: revísalo a mano.</span>`) : '';
      return `
      <div class="zy-order-row zy-trow">
        <div class="zy-order-row-info zy-tmain">
          <b>${zyEscapeHtml(o.orderNum)} · ${fmt(o.total)} <em class="zy-badge" style="background:rgba(178,58,58,.14);color:#D45A5A;">Cancelado</em></b>
          <span>${zyEscapeHtml(o.name||'')}${o.email ? ' · ' + zyEscapeHtml(o.email) : ' · (sin correo)'}${o.phone ? ' · ' + zyEscapeHtml(o.phone) : ''} · Pedido del ${new Date(o.date).toLocaleDateString('es-MX')}</span>
          <span>${zyEscapeHtml(itemsSummary)}</span>
          <span>Cancelado${o.cancelledAt ? ' el ' + new Date(o.cancelledAt).toLocaleString('es-MX') : ''} · Motivo: ${zyEscapeHtml(o.cancelReason || 'Sin motivo indicado')}</span>
          <span>${refundHTML}</span>
          ${giftNote}
        </div>
      </div>`;
    }).join('');
    return;
  }
  box.innerHTML = '<div class="zy-thead zy-thead--orders"><span>Pedido</span><span>Etapa</span><span>Verificación</span></div>' + list.slice(0,60).map(o=>{
    const v = o.verification || {};
    const verified = v.status === 'verificado';
    const itemsSummary = (o.items||[]).map(it=>`${it.qty}× ${it.name}${it.size?' (T'+it.size+')':''}`).join(', ');
    const currentStatus = o.status || 'recibido';
    const stageOptions = ORDER_STAGES.map(s=>`<option value="${s.key}" ${s.key===currentStatus?'selected':''}>${s.label}</option>`).join('');
    return `
    <div class="zy-order-row zy-trow">
      <div class="zy-order-row-info zy-tmain">
        <b>${zyEscapeHtml(o.orderNum)} · ${fmt(o.total)}</b>
        <span>${zyEscapeHtml(o.name||'')}${o.email ? ' · ' + zyEscapeHtml(o.email) : ' · (sin correo)'}${o.phone ? ' · ' + zyEscapeHtml(o.phone) : ''} · ${new Date(o.date).toLocaleDateString('es-MX')}</span>
        <span>${zyEscapeHtml(itemsSummary)}</span>
        <span>${o.paymentMethod==='stripe' && o.paymentStatus==='pagado' ? 'Pagado con tarjeta' : o.paymentMethod==='stripe' && o.paymentStatus==='fallido' ? `Pago fallido${o.paymentFailReason ? ' — ' + zyEscapeHtml(o.paymentFailReason) : ''}` : (o.paymentMethod==='stripe' && o.paymentStatus!=='pagado' ? 'Pago con tarjeta pendiente' : o.paymentStatus==='pagado' ? 'Pagado (confirmado a mano)' : 'Coordinado por WhatsApp')}</span>
        ${typeof zyOrderActionsHTML==='function' ? zyOrderActionsHTML(o) : ''}
        </div>
      <div class="zy-tcell"><em class="zy-badge zy-st-${currentStatus}">${(ORDER_STAGES.find(x=>x.key===currentStatus)||{}).label||currentStatus}</em><select class="zy-order-status-select" title="Cambiar etapa (avisa al cliente por email y WhatsApp)" onchange="zyAdminAdvanceOrderStatus('${o.orderNum}', this.value)">${stageOptions}</select></div>
      <div class="zy-tcell"><button type="button" class="zy-order-verify-btn" ${verified?'disabled':''} onclick="zyMarkOrderVerified('${o.orderNum}')">
        ${verified ? `✓ Verificado ${v.verifiedAt ? new Date(v.verifiedAt).toLocaleDateString('es-MX') : ''}` : 'Marcar como verificado'}
      </button></div>
    </div>`;
  }).join('');
}

/* ================= ESCÁNER DE SOCIO (ZAYDE ID / QR) =================
   Lee el QR real del ZAYDE ID del cliente con la cámara (librería jsQR,
   cargada en el <head>) y busca sus pedidos en Firestore para mostrar
   cuántas compras lleva. Si ya es "cliente frecuente" (≥ ZY_FREQUENT_
   BUYER_THRESHOLD pedidos), permite generarle con un clic un cupón de
   descuento de socio — se guarda como cualquier otro cupón (pestaña
   "Cupones") y además se manda por WhatsApp al teléfono de su pedido
   más reciente. No hace falta backend nuevo: reutiliza zyFetchAllOrders
   (ya usado en Analítica) y zyMemberCode (ya usado en el ZAYDE ID). */
const ZY_FREQUENT_BUYER_THRESHOLD = 3; // pedidos completados para calificar como cliente frecuente
let zyScanStream = null;
let zyScanRAF = null;

async function zyStartMemberScan(){
  if(typeof jsQR === 'undefined'){
    showToast('No se pudo cargar el lector de QR (revisa tu conexión a internet) — usa la búsqueda manual de abajo', true);
    return;
  }
  if(!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
    showToast('Este navegador no permite acceder a la cámara — usa la búsqueda manual de abajo', true);
    return;
  }
  const video = document.getElementById('zyScanVideo');
  try{
    zyScanStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
  }catch(e){
    console.error('No se pudo acceder a la cámara:', e);
    showToast('No se pudo acceder a la cámara — revisa los permisos del navegador', true);
    return;
  }
  video.srcObject = zyScanStream;
  try{ await video.play(); }catch(e){}
  document.getElementById('zyScanVideoWrap').style.display = '';
  document.getElementById('zyScanStartBtn').style.display = 'none';
  document.getElementById('zyScanStopBtn').style.display = '';
  document.getElementById('zyScanResult').innerHTML = '';
  const canvas = document.getElementById('zyScanCanvas');
  const ctx = canvas.getContext('2d', { willReadFrequently: true });
  const tick = ()=>{
    if(!zyScanStream) return; // se detuvo el escaneo (o se cambió de pestaña)
    if(video.readyState === video.HAVE_ENOUGH_DATA && video.videoWidth){
      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      try{
        const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
        const result = jsQR(imgData.data, imgData.width, imgData.height);
        if(result && result.data){
          zyStopMemberScan();
          zyHandleScannedText(result.data);
          return;
        }
      }catch(e){ /* frame no legible todavía, se sigue intentando */ }
    }
    zyScanRAF = requestAnimationFrame(tick);
  };
  zyScanRAF = requestAnimationFrame(tick);
}
function zyStopMemberScan(){
  if(zyScanRAF) cancelAnimationFrame(zyScanRAF);
  zyScanRAF = null;
  if(zyScanStream){ zyScanStream.getTracks().forEach(t=>t.stop()); zyScanStream = null; }
  const video = document.getElementById('zyScanVideo');
  if(video) video.srcObject = null;
  const wrap = document.getElementById('zyScanVideoWrap');
  if(wrap) wrap.style.display = 'none';
  const startBtn = document.getElementById('zyScanStartBtn');
  if(startBtn) startBtn.style.display = '';
  const stopBtn = document.getElementById('zyScanStopBtn');
  if(stopBtn) stopBtn.style.display = 'none';
}
function zyHandleScannedText(text){
  if(!text || !text.startsWith(ZY_MEMBER_QR_PREFIX)){
    showToast('Ese código QR no es un ZAYDE ID de socio', true);
    return;
  }
  const code = text.slice(ZY_MEMBER_QR_PREFIX.length).trim().toUpperCase();
  zyLookupMemberByCode(code);
}
function zyLookupMemberManual(){
  const input = document.getElementById('zyScanManualCode');
  const code = (input.value||'').trim().toUpperCase();
  if(!code){ showToast('Escribe el código del cliente', true); return; }
  zyLookupMemberByCode(code);
}
/* Busca en TODOS los pedidos (Firestore, vía zyFetchAllOrders) cuáles le
   pertenecen a este código de socio: cada pedido guarda su ownerKey
   (identificador real de la cuenta que compró — ver checkout), y
   zyMemberCode(ownerKey) recalcula el mismo código que se ve en su
   ZAYDE ID. Como es el mismo cálculo determinístico de un lado y otro,
   no hace falta guardar una lista aparte de "usuarios": el propio
   historial de pedidos ya identifica al socio. */
async function zyLookupMemberByCode(code){
  const box = document.getElementById('zyScanResult');
  box.innerHTML = '<div class="zy-quickhint">Buscando cliente…</div>';
  let orders = [];
  try{ orders = (await zyFetchAllOrders()).orders || []; }catch(e){ orders = []; }
  const matches = orders.filter(o => o.ownerKey && zyMemberCode(o.ownerKey) === code);
  if(!matches.length){
    box.innerHTML = `<div class="zy-list-item" style="color:#8A1F1F;">No se encontró ningún cliente con el código <b>${zyEscapeHtml(code)}</b>. Revisa que sea un ZAYDE ID válido — el cliente debe haber iniciado sesión al menos una vez y tener algún pedido registrado.</div>`;
    return;
  }
  matches.sort((a,b)=> new Date(b.date) - new Date(a.date));
  const latest = matches[0];
  const orderCount = matches.length;
  const totalSpent = matches.reduce((s,o)=> s + (o.total||0), 0);
  const isFrequent = orderCount >= ZY_FREQUENT_BUYER_THRESHOLD;
  // [CUPONES DE SOCIO — CÓDIGO ÚNICO] "code" aquí es el ZAYDE ID del
  // cliente (solo sirve para IDENTIFICARLO al escanear su tarjeta). El
  // cupón real que se le entrega es OTRO código, aleatorio, guardado en
  // zySocioCoupons[code] — así el cupón nunca es ni se parece a su ZAYDE ID.
  const couponCode = zySocioCoupons[code];
  const hasCoupon = !!couponCode && !!zyCouponsData[couponCode];
  const phoneAttr = zyEscapeHtml((latest.phone||'').replace(/'/g,''));
  if(isFrequent && !hasCoupon){
    // Cliente recién calificado como frecuente: se genera el cupón de socio
    // automáticamente al escanearlo, sin necesidad de que el admin dé clic
    // en un botón. Respeta las preferencias de notificación que el cliente
    // dejó en su último pedido (order.notifyEmail / order.notifyWhatsapp).
    zyGenerateMemberCoupon(code, latest.phone||'', latest.email||'', latest.name||'', latest.notifyEmail!==false, latest.notifyWhatsapp!==false);
    return;
  }
  const c = hasCoupon ? zyCouponsData[couponCode] : null;
  box.innerHTML = `
    <div class="zy-pass-card" style="max-width:360px; margin:0 auto;">
      <div class="zy-pass-kicker">Cliente identificado</div>
      <div class="zy-pass-name">${zyEscapeHtml(latest.name||'Sin nombre')}</div>
      <div class="zy-pass-sub">${latest.email ? zyEscapeHtml(latest.email)+' · ' : ''}${latest.phone ? zyEscapeHtml(latest.phone) : 'sin teléfono'}</div>
      <div class="zy-pass-idtext">${zyEscapeHtml(code)}</div>
    </div>
    <div class="zy-list-item" style="margin-top:12px;"><span>Pedidos totales</span><b>${orderCount}</b></div>
    <div class="zy-list-item"><span>Total gastado</span><b>${fmt(totalSpent)}</b></div>
    <div class="zy-list-item"><span>Última compra</span><b>${new Date(latest.date).toLocaleDateString('es-MX')}</b></div>
    ${isFrequent ? `
      <div class="promo-applied" style="margin-top:12px;"><span>🎉 Cliente frecuente — califica para descuento de socio.</span></div>
