  const pct = zyMarkupPctFor(section);
  lbl.textContent = pct > 0 ? 'Incluir +' + pct + '% de envío (' + section + ')' : 'Incluir % de envío de la sección';
  const base = parseInt((document.getElementById('zyPrice') || {}).value) || 0;
  if(!section) hint.textContent = 'Elige primero la sección del producto.';
  else if(!(pct > 0)) hint.textContent = 'Esta sección no tiene % de envío: configúralo en la tarjeta de arriba.';
  else if(!cb.checked) hint.textContent = 'Sin % de envío: el precio que escribes es el precio de lista tal cual.';
  else if(base > 0) hint.textContent = 'Tu precio base $' + base.toLocaleString('es-MX') + ' + ' + pct + '% de envío = precio de lista $' + zyListPrice(base, pct).toLocaleString('es-MX') + ' (se redondea hacia arriba a $10). El cliente nunca ve el %.';
