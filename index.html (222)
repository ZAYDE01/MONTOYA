let zyEditingPriceRef = {}; // precios de lista por ml del producto en edición
function zyRenderSizePriceGrid(selectedSizes){
  const wrap = document.getElementById('zyPriceBySizeWrap');
  const grid = document.getElementById('zyPriceBySizeGrid');
  if(!wrap || !grid) return;
  const secEl = document.getElementById('zySection');
  if(!secEl || secEl.value !== 'Perfumes'){ wrap.style.display = 'none'; grid.innerHTML = ''; return; }
  wrap.style.display = '';
  const prev = {};
  grid.querySelectorAll('input[data-psize]').forEach(inp=>{ prev[inp.dataset.psize] = inp.value; });
  if(!selectedSizes.length){
    grid.innerHTML = '<span class="zy-hint">Selecciona los ml arriba para ponerles precio</span>';
    return;
  }
  grid.innerHTML = selectedSizes.map(sz=>{
    const val = prev[sz] !== undefined ? prev[sz] : (zyEditingPriceRef[sz] !== undefined ? zyEditingPriceRef[sz] : '');
    return `<label class="zy-stock-item"><span>${zyEscapeHtml(sz)}</span><input type="number" min="0" step="1" placeholder="$ MXN" data-psize="${zyEscapeHtml(sz)}" value="${val}"></label>`;
  }).join('');
}
/* Dibuja un campo numérico independiente por cada talla seleccionada, para
   poder cargar el stock real pieza por pieza en vez de un número parejo
   para todas las tallas. Conserva lo ya escrito al agregar/quitar una talla,
   y precarga el stock guardado cuando se está editando un producto. */
function zyRenderStockGrid(selectedSizes){
  const grid = document.getElementById('zyStockGrid');
  const prev = {};
  grid.querySelectorAll('input[data-size]').forEach(inp=>{ prev[inp.dataset.size] = inp.value; });
  const defaultVal = Math.max(0, parseInt(document.getElementById('zyStock').value) || 0);
  if(!selectedSizes.length){
    grid.innerHTML = '<span class="zy-hint">Selecciona tallas arriba para asignar stock por talla</span>';
    return;
  }
  grid.innerHTML = selectedSizes.map(s=>{
    const val = prev[s] !== undefined ? prev[s] : (zyEditingStockRef[s] !== undefined ? zyEditingStockRef[s] : defaultVal);
    return `<label class="zy-stock-item"><span>${zyEscapeHtml(s)}</span><input type="number" min="0" data-size="${zyEscapeHtml(s)}" value="${val}" oninput="this.dataset.touched='1'"></label>`;
  }).join('');
}
