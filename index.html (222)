/* [% DE ENVÍO POR SECCIÓN] Porcentaje fijo que se suma al precio de lista de cada producto según su sección, para que el
   envío gratis lo cubra el propio precio y no tu bolsillo. Los porcentajes y el precio base viven en colecciones PRIVADAS
   (adminPrivate y productCosts, solo admin): el producto público solo trae el precio final, así el cliente no ve el %. */
let zyShipMarkup = {}, zyShipMarkupAvg = {}, zyShipMarkupLoaded = false, zyShipMarkupDefault = false;
const ZY_DEFAULT_SHIP_PCT = 12;   // % de envío incluido en el precio, por defecto en todas las secciones (hasta que guardes otros en el panel)
async function zyLoadShipMarkup(){
  if(zyShipMarkupLoaded) return;
  try{
    const d = await db.collection('adminPrivate').doc('shipMarkup').get();
    if(d.exists){ zyShipMarkup = d.data().pct || {}; zyShipMarkupAvg = d.data().avg || {}; zyShipMarkupDefault = false; }
    else zyShipMarkupDefault = true;   // aún no hay nada guardado: se usa el 12% por defecto
    zyShipMarkupLoaded = true;
  }catch(e){ console.warn('No se pudieron leer los % de envío (¿reglas de Firestore con adminPrivate?):', e); }
}
const ZY_SHIP_PCT_14 = ['Bolsos','Zapatos','Sneakers'];   // 14% de envío en bolsos y zapatos
function zyMarkupPctFor(section){
  if(ZY_SHIP_PCT_14.indexOf(section) > -1) return 14;
  if(zyShipMarkupDefault && section && section !== 'Membresía') return ZY_DEFAULT_SHIP_PCT;
  return Number(zyShipMarkup[section]) || 0;
}
function zyMarkupApplied(){
  const cb = document.getElementById('zyUseMarkup');
  if(!cb || !cb.checked) return 0;
  return zyMarkupPctFor((document.getElementById('zySection') || {}).value || '');
}
// Precio de lista = base + %, redondeado hacia arriba a múltiplos de $10 (ej. base 1,000 + 12% = 1,120).
function zyListPrice(base, pct){
  if(pct === undefined) pct = zyMarkupApplied();
  return (pct > 0 && base > 0) ? Math.ceil(base * (1 + pct / 100) / 10 - 1e-9) * 10 : base;   // el -1e-9 evita que 1,500 + 12% se redondee a 1,690 por decimales de coma flotante
}
function zyUpdateMarkupPreview(){
  const lbl = document.getElementById('zyMarkupLabel'), hint = document.getElementById('zyMarkupHint'), cb = document.getElementById('zyUseMarkup');
  if(!lbl || !hint || !cb) return;
