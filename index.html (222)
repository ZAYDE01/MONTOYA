  zyApplyFooterForStore(); // [FOOTER — ZAYDE G] deja listo el pie de página de la tienda actual (incluye renderFooterLinks())
  zyApplyPolicyTextsForStore(); // [MODAL DE POLÍTICAS · ZAYDE G] deja listos Sobre/Verificación/Términos/Privacidad de la tienda actual
