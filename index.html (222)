function zyRenderAdminList(){
  const box = document.getElementById('zyProductList');
  const q = (document.getElementById('zyProductSearch').value || '').toLowerCase().trim();
  let list = PRODUCTS.slice().sort((a,b)=>b.id-a.id);
  list = list.filter(p=>(p.store||'zayde')===zyAdminStoreFilter);
  if(window.zyOnlyNoSeller) list = list.filter(p=>!p.sellerId); // [VENDEDORES] solo piezas sin vendedor
  if(zyAdminFilterCat){
    list = list.filter(p=>p.category===zyAdminFilterCat);
  }
  if(q){
    list = list.filter(p=>(p.brand+' '+p.name+' '+(p.sku||'')+' '+p.category).toLowerCase().includes(q));
  }
  if(!list.length){ box.innerHTML = `<div class="zy-list-item" style="color:var(--steel);">Sin resultados</div>`; return; }
  // Agrupados por sección (mismo orden que las categorías del sitio). Si hay
  // un filtro de sección o búsqueda activa se muestran todos los resultados;
  // si no, se limita por sección para que la lista no sea eterna.
  const PER_SECTION_LIMIT = (q || zyAdminFilterCat) ? 999 : 15;
  const groups = {};
  list.forEach(p=>{ (groups[p.category] = groups[p.category] || []).push(p); });
  let html = '<div class="zy-bulkbar"><button type="button" onclick="zyBulkDelete()">Eliminar seleccionados</button><label><input type="checkbox" onchange="zyBulkAll(this.checked)"> Seleccionar todos los visibles</label>' + zyBulkSellerBarHTML() + '</div><div class="zy-thead zy-thead--prod"><span></span><span></span><span>Producto</span><span>Precio</span><span></span></div>';
  CATS.forEach(cat=>{
    const items = groups[cat];
    if(!items || !items.length) return;
    const shown = items.slice(0, PER_SECTION_LIMIT);
    html += `<div class="zy-list-section">
      <div class="zy-list-section-title">${cat} <span>${items.length}</span></div>
      ${shown.map(p=>`
        <div class="zy-list-item zy-trow zy-trow--prod">
          <span class="zy-chk"><input type="checkbox" class="zy-sel" value="${p.id}" aria-label="Seleccionar ${p.name}"></span>
          <span class="zy-thumb">${p.images && typeof p.images[0]==='string' ? `<img src="${p.images[0]}" alt="" loading="lazy">` : ''}</span>
          <span class="zy-tmain"><b>${p.name}</b><small>${zySellerTag(p)}${p.brand}${(p.material||p.color) ? ' · ' + zyEscapeHtml([p.material,p.color].filter(Boolean).join(' · ')) : ''}</small></span>
          <span class="zy-tnum">${fmt(p.price)}</span>
          <span class="zy-tcell zy-tact">
            <button onclick="zyEditProduct(${p.id})" style="color:var(--signal);">Editar</button>
            <button onclick="zyDeleteProduct(${p.id})">Eliminar</button>
          </span>
        </div>`).join('')}
      ${items.length>shown.length ? `<div class="zy-list-item" style="color:var(--steel); justify-content:center;">+${items.length-shown.length} más en ${cat} — usa el buscador</div>` : ''}
    </div>`;
  });
  box.innerHTML = html;
}
function zyDeleteProduct(id){
  const _p = PRODUCTS.find(x=>x.id===id);
  if(!confirm('¿Eliminar "'+(_p ? _p.brand+' · '+_p.name : 'este producto')+'"? Esta acción no se puede deshacer.')) return;
  PRODUCTS = PRODUCTS.filter(p=>p.id!==id);
  zyAdminProducts = zyAdminProducts.filter(p=>p.id!==id);
  // Se guarda como "eliminado" de forma permanente, sea un producto del catálogo
  // generado o uno agregado por el admin, para que no reaparezca al recargar.
  zyOverrides[id] = { _deleted:true };
  AdminStore.set('zayde:admin:products', zyAdminProducts);
  AdminStore.set('zayde:admin:overrides', zyOverrides);
  buildFilterUI();
  renderHome();
  if(currentPage==='catalog') renderCatalog();
  if(currentPage==='mayoreo') renderMayoreoPage();
  if(currentPage==='ropag') renderRopaG(); // [FIX] mismo motivo que en zyAddProduct
  zyRenderAdminList();
  showToast('Producto eliminado');
}

/* Aplica ediciones/eliminaciones guardadas por id sobre el catálogo recién
   construido (necesario porque los 42 productos "de fábrica" se regeneran en
   cada carga — sin esto, editar o borrar uno de ellos no sobreviviría a un
   refresh de la página). */
function zyApplyOverrides(){
  Object.keys(zyOverrides).forEach(idStr=>{
    const id = Number(idStr);
    const ov = zyOverrides[idStr];
    if(!ov) return;
    if(ov._deleted){ PRODUCTS = PRODUCTS.filter(p=>p.id!==id); return; }
    const p = PRODUCTS.find(x=>x.id===id);
    if(p) Object.assign(p, ov);
  });
  try{ zyReapplyLiveStock(); }catch(e){}   // [CHATBOT · STOCK EN VIVO] un override viejo no pisa el inventario en vivo
}

