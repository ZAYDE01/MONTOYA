/* ================= ANALÍTICA (panel privado) =================
   Lee tus pedidos reales (Firestore si está activo — así ve TODAS las
   ventas del sitio, no solo las de este navegador — o el respaldo local
   si Firestore no está disponible) y tus reseñas reales por producto,
   y dibuja las gráficas con Chart.js. No usa datos de ejemplo. */
let zyCharts = {};
function zyDestroyChart(key){ if(zyCharts[key]){ zyCharts[key].destroy(); delete zyCharts[key]; } }
function zyThemeColor(varName){ return getComputedStyle(document.documentElement).getPropertyValue(varName).trim() || '#999'; }

/* [PERF] Chart.js (~200 KB) ya NO se descarga en cada carga del sitio —
   antes se traía siempre con un <script> normal en el <head>, aunque el
   99% de las visitas nunca abren la pestaña Analítica del panel privado
   ni ven el historial de precios de un producto. Ahora se inyecta bajo
   demanda solo la primera vez que de verdad se necesita (aquí o en
   zyRenderPriceHistory), y queda en caché del navegador para la próxima
   vez. zyChartJsPromise evita pedirlo dos veces si dos gráficas se piden
   casi al mismo tiempo. */
let zyChartJsPromise = null;
function zyEnsureChartJs(){
  if(typeof Chart !== 'undefined') return Promise.resolve(true);
  if(window.__chartJsFailed) return Promise.resolve(false);
  if(zyChartJsPromise) return zyChartJsPromise;
  zyChartJsPromise = new Promise(resolve=>{
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js';
    s.onload = ()=>resolve(true);
    s.onerror = ()=>{ window.__chartJsFailed = true; resolve(false); };
    document.head.appendChild(s);
  });
  return zyChartJsPromise;
}

async function zyFetchAllOrders(){
  if(db){
    try{
      const snap = await db.collection('orders').orderBy('date','desc').limit(500).get();
      if(!snap.empty) return { orders: snap.docs.map(d=>d.data()), source:'Firestore (todos los pedidos del sitio)' };
    }catch(e){ console.error('No se pudieron leer los pedidos de Firestore:', e); }
  }
  const local = (await Store.get('zayde:orders')) || [];
  return { orders: local, source: 'respaldo local de este navegador (activa Firestore para ver todos los pedidos del sitio)' };
}

async function zyFetchAllReviews(){
  const ids = PRODUCTS.map(p=>p.id);
  const lists = await Promise.all(ids.map(id => zyGetReviews(id).catch(()=>[])));
  return lists.flat();
}

const fmtMXN = n => new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN',maximumFractionDigits:0}).format(n||0);

async function zyRenderAnalytics(){
  const chartOk = await zyEnsureChartJs();
  if(!chartOk){
    document.getElementById('zyAnalyticsSourceNote').textContent = 'No se pudo cargar la librería de gráficas (revisa tu conexión o bloqueador de anuncios) y recarga la página.';
    return;
  }
  document.getElementById('zyAnalyticsSourceNote').textContent = 'Cargando datos…';
  const [{orders, source}, reviews] = await Promise.all([zyFetchAllOrders(), zyFetchAllReviews()]);
  document.getElementById('zyAnalyticsSourceNote').textContent = orders.length
    ? `${orders.length} pedido${orders.length===1?'':'s'} · fuente: ${source}`
    : `Todavía no hay pedidos registrados (fuente: ${source}). En cuanto entre tu primera venta, aquí aparecerán las gráficas.`;

  // ---- Tarjetas de stats ----
  const revenue = orders.reduce((a,o)=>a + (o.total||0), 0);
  const aov = orders.length ? revenue / orders.length : 0;
  document.getElementById('zyStatRevenue').textContent = fmtMXN(revenue);
  document.getElementById('zyStatOrders').textContent = orders.length;
  document.getElementById('zyStatAOV').textContent = fmtMXN(aov);
  const avgRating = reviews.length ? (reviews.reduce((a,r)=>a+r.stars,0)/reviews.length) : 0;
  document.getElementById('zyStatRating').textContent = reviews.length ? `${avgRating.toFixed(1)} ★ (${reviews.length})` : 'Sin reseñas aún';

  try{
    const now=Date.now(), D=30*864e5, age=o=>now-new Date(o.date).getTime();
    const cur=orders.filter(o=>age(o)<D), prev=orders.filter(o=>age(o)>=D && age(o)<2*D);
    const sum=a=>a.reduce((x,o)=>x+(o.total||0),0);
    const delta=(id,c,pv)=>{ const el=document.getElementById(id); if(!el) return; let n=el.parentNode.querySelector('.zy-delta'); if(!n){ n=document.createElement('small'); el.parentNode.appendChild(n); }
      if(!pv){ n.className='zy-delta'; n.textContent=c?'Últimos 30 días · sin periodo previo para comparar':''; return; }
      const pc=Math.round((c-pv)/pv*100); n.className='zy-delta '+(pc>=0?'up':'down'); n.textContent='Últimos 30 días: '+(pc>=0?'↑ ':'↓ ')+Math.abs(pc)+'% vs. los 30 previos'; };
    delta('zyStatRevenue',sum(cur),sum(prev)); delta('zyStatOrders',cur.length,prev.length);
    delta('zyStatAOV',cur.length?sum(cur)/cur.length:0, prev.length?sum(prev)/prev.length:0);
  }catch(e){}

  const colText = zyThemeColor('--text'), colSteel = zyThemeColor('--steel'), colLine = zyThemeColor('--line'),
        colSignal = zyThemeColor('--signal'), colBrass = zyThemeColor('--brass'), colUp = zyThemeColor('--up'), colDown = zyThemeColor('--down');
  Chart.defaults.font.family = "'Montserrat',sans-serif";
  Chart.defaults.color = colSteel;

  // ---- Ingresos por día (últimos 30 días) ----
  const days = [];
  for(let i=29;i>=0;i--){ const d=new Date(); d.setDate(d.getDate()-i); d.setHours(0,0,0,0); days.push(d); }
  const revByDay = days.map(d=>{
    const next = new Date(d); next.setDate(next.getDate()+1);
    return orders.filter(o=>o.date>=d.getTime() && o.date<next.getTime()).reduce((a,o)=>a+(o.total||0),0);
  });
  zyDestroyChart('revenue');
  zyCharts.revenue = new Chart(document.getElementById('zyChartRevenue'), {
    type:'line',
    data:{ labels: days.map(d=>d.toLocaleDateString('es-MX',{day:'2-digit',month:'2-digit'})),
      datasets:[{ label:'Ingresos', data:revByDay, borderColor:colSignal, backgroundColor:colSignal+'33', fill:true, tension:.3, pointRadius:0 }] },
    options:{ responsive:true, plugins:{legend:{display:false}}, scales:{ x:{grid:{display:false}}, y:{grid:{color:colLine}, ticks:{callback:v=>fmtMXN(v)}} } }
  });
  {
    const totalRev = revByDay.reduce((a,b)=>a+b,0);
    const c = document.getElementById('zyChartRevenue');
    if(c) c.setAttribute('aria-label', `Gráfica de ingresos por día, últimos 30 días. Total del periodo: ${fmtMXN(totalRev)}.`);
  }

  // ---- Método de pago ----
  const payCounts = { stripe:0 };
