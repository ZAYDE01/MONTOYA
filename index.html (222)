  zyUpdateTitlePreview();
  document.querySelector('.zy-submit').textContent = 'Guardar cambios';
  document.querySelector('.zy-panel.zy-wide').scrollTop = 0;
  // [UX] Ya no se enfoca el campo automáticamente al abrir, para que no
  // salte el teclado del celular solo por entrar a este apartado.
}

/* Genera un SKU único: nunca se repite, aunque coincidan marca y fecha,
   porque siempre se valida contra TODOS los SKU en uso (catálogo + admin)
   antes de aceptarlo, y si por algún motivo ya existiera, se genera otro. */
function zyGenerateUniqueSku(brand){
  const inUse = new Set(PRODUCTS.map(p=>(p.sku||'').toUpperCase()));
  const initials = (brand||'ZY').replace(/[^A-Za-z]/g,'').slice(0,3).toUpperCase() || 'ZY';
  let sku;
  do{
    const time = Date.now().toString(36).toUpperCase();
    const rand = Math.random().toString(36).slice(2,6).toUpperCase();
    sku = `ZY-${initials}-${time}${rand}`;
  } while(inUse.has(sku));
  return sku;
}
function zyAddProduct(){
  const section = document.getElementById('zySection').value;
  const store = document.getElementById('zyStore').value === 'clothesg' ? 'clothesg' : 'zayde';
  // [VENDEDORES] dueño de la pieza; null = pieza propia de ZAYDE
  const sellerId = (document.getElementById('zySellerId') ? document.getElementById('zySellerId').value : '') || null;
  const brand = document.getElementById('zyBrand').value.trim() || 'ZAYDE';
  const name = document.getElementById('zyName').value.trim();
  // [DESCUENTO-AUTO] "zyPrice" ahora es siempre el precio ORIGINAL (de
  // lista) que teclea el admin. Si hay descuento, el precio que de verdad
  // se guarda como product.price (el que se cobra en todo el sitio —
  // carrito, checkout, ficha) se calcula aquí mismo aplicando el %; el
  // resto del sitio ya sabe reconstruir el precio original tachado a
  // partir de product.price + discountPct (misma fórmula inversa, ver
  // cardHTML() y renderPDP()), así que no hace falta guardar el original
  // aparte. Sin descuento (0%), el precio final es el mismo que el
  // original, igual que antes.
  let originalPrice = parseInt(document.getElementById('zyPrice').value) || 0;
  // [% DE ENVÍO] El precio base (lo que escribe el admin) se guarda aparte y privado; el precio de lista público ya lleva el %.
  const zyMkPct = zyMarkupApplied();
  const zyMkBox = document.getElementById('zyUseMarkup');
  if(zyMkBox && zyMkBox.checked && !zyShipMarkupLoaded){ showToast('No se pudieron cargar los porcentajes de envío. Desmarca “Incluir % de envío” o revisa las reglas de Firestore (adminPrivate).', true); return; }
  let zyBaseOut = originalPrice, zySizeBase = null;
  originalPrice = zyListPrice(originalPrice, zyMkPct);
  const discountPct = Math.max(0, Math.min(90, parseInt(document.getElementById('zyDiscountPct').value) || 0));
  let price = discountPct > 0 ? Math.round(originalPrice * (1 - discountPct/100)) : originalPrice;
  const desc = document.getElementById('zyDesc').value.trim();
  const material = document.getElementById('zyMaterial').value.trim();
  const color = document.getElementById('zyColor').value.trim();
  // [PERFUMES] ESPECIFICACIONES (presentación, notas) y DETALLES (aroma, colección, género)
  // [ROPA] Sección (Camisas, Playeras…), tipo exacto y detalles según la sección
  const isRopa = zyIsRopaCat(section);
  const ropaGroup = isRopa ? (document.getElementById('zyRopaGroup').value || '') : '';
  const ropaType = isRopa ? (document.getElementById('zyRopaType').value || '') : '';
  const ropaDetails = isRopa ? zyGetRopaDetails() : {};
  // [BOLSOS] dimensiones (cm), silueta, colección, género, compartimentos
  const bolsoDetails = zyIsBolsoCat(section) ? zyGetBolsoDetails() : {};
  // [LENTES] tipo de lentes y género
  const lentesDetails = zyIsLentesCat(section) ? zyGetLentesDetails() : {};
  // [ZAPATOS] tipo de calzado, suela, género y estilo
  const sneakerDetails = zyIsSneakerCat(section) ? zyGetSneakerDetails() : {};
  // [JOYERÍA] dimensiones, peso, kilataje, tipo, broche, género y piedra
  const joyDetails = zyIsJoyCat(section) ? zyGetJoyDetails() : {};
  // [GORRAS] colección, género y tipo (Cerrada / Ajustable)
  const gorraDetails = zyIsGorraCat(section) ? zyGetGorraDetails() : {};
  // [RELOJES] especificaciones, detalles y display (ficha técnica)
  const relojData = zyIsRelojCat(section) ? zyGetRelojData() : { specs:{}, details:{}, display:{} };
  const relojSpecs = relojData.specs, relojDetails = relojData.details, relojDisplay = relojData.display;
  // [FICHA-TÉCNICA] SKU editable: si lo escribes no puede repetirse con otro producto
  const editingProd = zyEditingId ? PRODUCTS.find(x=>x.id===zyEditingId) : null;
  const skuTyped = (document.getElementById('zySku').value || '').trim().toUpperCase();
  if(skuTyped && PRODUCTS.some(x=>String(x.sku||'').toUpperCase()===skuTyped && (!editingProd || x.id!==editingProd.id))){
    showToast('Ese SKU ya lo tiene otro producto. Escribe uno distinto o déjalo vacío.', true);
    document.getElementById('zySku').focus();
    return;
  }
  const isPerfume = zyIsPerfumeCat(section);
  const fragPresentation = isPerfume ? document.getElementById('zyFragPresentation').value : '';
  const fragNotes = isPerfume ? zyFragGetNotes() : [];
  const fragAroma = isPerfume ? document.getElementById('zyFragAroma').value : '';
  const fragCollection = isPerfume ? document.getElementById('zyFragCollection').value : '';
  const fragGender = isPerfume ? document.getElementById('zyFragGender').value : '';
  const sizesRaw = document.getElementById('zySizes').value.trim();
  const sizes = sizesRaw ? sizesRaw.split(',').map(s=>s.trim()).filter(Boolean) : zySizeDefaults(section).split(', ');
  if(zyMedia.some(m=>m.up)){ showToast('Espera a que terminen de subirse las fotos y videos antes de guardar.', true); return; }
  const imageCount = Math.max(1, Math.min(8, parseInt(document.getElementById('zyImageCount').value) || zyUploadedImages.length || 4));
  const zyMediaOut = zyBuildMediaOut(imageCount);
  // [FIX — se quitaron los campos "Demanda"/"% de tendencia" del panel a
  // pedido del cliente] La sección "En tendencia" del inicio sigue
  // funcionando igual (sigue filtrando por trend==='up'), simplemente ya
  // no se controla a mano por producto: todo lo que se agregue desde aquí
  // entra con un valor neutro por defecto.
  const trend = 'up';
  const trendPct = 12;
  const tag = document.getElementById('zyTag').value;
  const dateInput = document.getElementById('zyDate').value;
  const stockUnits = Math.max(0, parseInt(document.getElementById('zyStock').value) || 0);
  const featuredRaw = document.getElementById('zyFeatured').value.trim();
  const featured = {};
  FEATURED_SECTIONS.forEach(s=>{ featured[s.key] = false; });
  if(featuredRaw) featuredRaw.split(',').filter(Boolean).forEach(k=>{ featured[k] = true; });
  // [Punto 3 — Tipografía por producto] vacío = sin personalizar (usa Montserrat/color normal)
  const titleFont = document.getElementById('zyTitleFont').value || null;
  const titleColor = document.getElementById('zyTitleColorOn').checked ? document.getElementById('zyTitleColor').value : null;

  // [PERFUMES] Precio por ml: se guarda el precio FINAL (con descuento) de cada
  // presentación en product.sizePrices; product.price = el más bajo ("Desde").
  let sizePrices = null;
  if(section === 'Perfumes'){
    const listPrices = {};
    sizes.forEach(sz=>{
      const inp = document.querySelector(`#zyPriceBySizeGrid input[data-psize="${CSS.escape(sz)}"]`);
      const v = inp ? (parseInt(inp.value) || 0) : 0;
      if(v > 0){ listPrices[sz] = zyListPrice(v, zyMkPct); (zySizeBase = zySizeBase || {})[sz] = v; }
    });
    const keys = Object.keys(listPrices);
    if(keys.length){
      sizePrices = {};
      keys.forEach(k=>{ sizePrices[k] = discountPct > 0 ? Math.round(listPrices[k] * (1 - discountPct/100)) : listPrices[k]; });
      originalPrice = Math.min(...keys.map(k=>listPrices[k]));
      zyBaseOut = Math.min(...Object.values(zySizeBase));
      price = discountPct > 0 ? Math.round(originalPrice * (1 - discountPct/100)) : originalPrice;
    }
  }
  if(!name){ showToast('Escribe un nombre para el producto', true); document.getElementById('zyName').focus(); return; }
  if(!originalPrice){ showToast(section==='Perfumes' ? 'Escribe el precio de al menos una presentación (ml)' : 'Escribe un precio válido', true); document.getElementById('zyPrice').focus(); return; }

  const stock = {};
  sizes.forEach(s=>{
    const inp = document.querySelector(`#zyStockGrid input[data-size="${CSS.escape(s)}"]`);
    stock[s] = inp ? Math.max(0, parseInt(inp.value) || 0) : stockUnits;
  });
  const releaseDateISO = dateInput || new Date().toISOString().slice(0,10);
  const releaseDate = new Date(releaseDateISO+'T12:00:00').toLocaleDateString('es-MX',{year:'numeric',month:'long',day:'numeric'});

  if(zyEditingId){
    // ---- modo edición: funciona para CUALQUIER producto del sitio, sea del
    // catálogo generado o uno agregado antes por el admin. Se guarda un
    // "override" permanente por id para que la edición sobreviva siempre. ----
    const existing = PRODUCTS.find(x=>x.id===zyEditingId);
    if(existing){
      const zyPrevStock = Object.assign({}, (existing.stock && typeof existing.stock === 'object') ? existing.stock : {}); // [HISTORIAL DE STOCK] stock antes de editar
      Object.assign(existing, {
        brand, name, category:section, store, sellerId, price, sizePrices, desc: desc || existing.desc, sizes, stock,
        sku: skuTyped || existing.sku, releaseDateISO, releaseDate,
        trend, trendPct, discountPct, tag, images: zyMediaOut.images, imageCount, featured,
        videos: zyMediaOut.videos, mediaOrder: zyMediaOut.order,
        titleFont, titleColor, material, color,
        fragPresentation, fragNotes, fragAroma, fragCollection, fragGender,
        ropaGroup, ropaType, ropaDetails, bolsoDetails, lentesDetails, sneakerDetails, joyDetails, gorraDetails, relojSpecs, relojDetails, relojDisplay
      });
      zyOverrides[zyEditingId] = { ...existing };
      AdminStore.set('zayde:admin:overrides', zyOverrides);
      const pInAdmin = zyAdminProducts.find(x=>x.id===zyEditingId);
      if(pInAdmin){ Object.assign(pInAdmin, existing); AdminStore.set('zayde:admin:products', zyAdminProducts); }
      zyPushStockToFirestore(zyEditingId, stock, { prev: zyPrevStock, sellerId, name, brand });
      zySaveProductCost(zyEditingId, { basePrice: zyBaseOut, markupPct: zyMkPct, sizeBase: zySizeBase });
      showToast('Producto actualizado');
      zyNotifySellerPiecePublished(existing); // [Aviso automático] si es pieza de vendedor y aún no se le avisó
    }
  } else {
    // ---- modo alta: crea un producto nuevo ----
    const id = Date.now();
    const product = {
      id, brand, name, category:section, store, sellerId, sellerAssignedAt: sellerId ? Date.now() : null, gender:null, line:'Nuevo', price, sizePrices,
      oldPrice:null, sizes, stock,
      sku: skuTyped || zyGenerateUniqueSku(brand),
      releaseDateISO, releaseDate,
      views:0, trend, trendPct, discountPct, tag, imgSeed:'zy-admin-'+id,
      color, material, fragPresentation, fragNotes, fragAroma, fragCollection, fragGender,
      ropaGroup, ropaType, ropaDetails, bolsoDetails, lentesDetails, sneakerDetails, joyDetails, gorraDetails, relojSpecs, relojDetails, relojDisplay,
      occasion: pick(ZY_OCCASIONS, id*4.1), style: pick(ZY_STYLES, id*5.3),
      images: zyMediaOut.images, imageCount, featured,
      videos: zyMediaOut.videos, mediaOrder: zyMediaOut.order,
      titleFont, titleColor,
      desc: desc || `Pieza de ${brand}, verificada por el equipo de autenticación de ZAYDE.`
    };
    PRODUCTS.push(product);
    zyAdminProducts.push(product);
    zySaveProductCost(id, { basePrice: zyBaseOut, markupPct: zyMkPct, sizeBase: zySizeBase });
    if(sellerId) zyLogStockChange(id, {}, stock, { sellerId, name, brand, reason:'alta' }); // [HISTORIAL DE STOCK]
    AdminStore.set('zayde:admin:products', zyAdminProducts);
    document.getElementById('zyOkMsg').classList.add('show');
    setTimeout(()=>document.getElementById('zyOkMsg').classList.remove('show'), 2600);
    zyNotifySellerPiecePublished(product); // [Aviso automático] el vendedor recibe correo con foto y stock
  }

  buildFilterUI();
  renderHome();
  if(currentPage==='catalog') renderCatalog();
  if(currentPage==='mayoreo') renderMayoreoPage();
  // [FIX] ZAYDE G toma sus piezas de PRODUCTS (mismo inventario que Ropa
  // Auténtica), pero antes solo se redibujaba al navegar hacia esa página —
  // si ya estabas parado en /clothes-g mientras se agregaba/editaba un
  // producto, no se veía el cambio hasta recargar. Ahora se refresca igual
  // que catálogo y mayoreo.
  if(currentPage==='ropag') renderRopaG();
  zyResetForm();
  zyRenderAdminList();
}

/* ================= [CATEGORÍAS] Agregar / renombrar / reordenar / eliminar =================
   CATS y zyCategoryImages se guardan juntos como un solo doc en AdminStore
   (clave 'zayde:admin:categorySettings') para no gastar una lectura/escritura
   de Firestore por categoría. */
async function zySaveCategorySettings(){
  await AdminStore.set('zayde:admin:categorySettings', { cats: CATS, images: zyCategoryImages, imagesG: zyCategoryImagesG, renameMap: zyCatRenameMap });
}
function zyRefreshCategoryUI(){
  zyRenderCategoryNav();
  buildFilterUI();
  zyRenderSectionChips(document.getElementById('zySection') ? document.getElementById('zySection').value : null);
  renderFooterLinks();
  renderHome();
  if(currentPage==='catalog') renderCatalog();
  if(currentPage==='ropag') renderRopaG(); // [FIX] su "categoría de origen" puede haberse renombrado/movido
  zyRenderCategoriesAdminList();
}
async function zyAddCategory(){
  const nameInput = document.getElementById('zyNewCatName');
  const fileInput = document.getElementById('zyNewCatImage');
  const name = (nameInput.value || '').trim();
  if(!name){ showToast('Escribe un nombre para la categoría.', true); return; }
  if(CATS.some(c=>c.toLowerCase()===name.toLowerCase())){ showToast('Ya existe una categoría con ese nombre.', true); return; }
  CATS.push(name);
  if(fileInput.files && fileInput.files[0]){
    try{ zyCategoryImages[name] = await zyCompressImageFile(fileInput.files[0], 640, 0.75); }
    catch(e){ console.error(e); showToast('La categoría se agregó, pero la foto no se pudo procesar.', true); }
  }
  await zySaveCategorySettings();
  nameInput.value = ''; fileInput.value = '';
  zyRefreshCategoryUI();
  showToast('Categoría agregada.');
}
async function zyRenameCategory(oldName){
  const input = document.getElementById('zyCatNameInput_'+zySlugify(oldName));
  const newName = (input.value || '').trim();
  if(!newName || newName===oldName) return;
  if(CATS.some(c=>c.toLowerCase()===newName.toLowerCase() && c!==oldName)){ showToast('Ya existe otra categoría con ese nombre.', true); return; }
  CATS = CATS.map(c=>c===oldName ? newName : c);
  Object.keys(zyCatRenameMap).forEach(orig=>{ if(zyCatRenameMap[orig]===oldName) zyCatRenameMap[orig] = newName; });
  if(CATS_DEFAULT.includes(oldName)) zyCatRenameMap[oldName] = newName;
  if(zyCategoryImages[oldName]){ zyCategoryImages[newName] = zyCategoryImages[oldName]; delete zyCategoryImages[oldName]; }
  if(zyCategoryImagesG[oldName]){ zyCategoryImagesG[newName] = zyCategoryImagesG[oldName]; delete zyCategoryImagesG[oldName]; }
  // Los productos ya publicados en esta categoría se mueven con ella.
  PRODUCTS.forEach(p=>{ if(p.category===oldName) p.category = newName; });
  zyAdminProducts.forEach(p=>{ if(p.category===oldName) p.category = newName; });
  if(zyAdminProducts.length) await AdminStore.set('zayde:admin:products', zyAdminProducts);
  // Los links del pie de página que apuntaban a la categoría por nombre
  // (en ambos pies de página: ZAYDE y ZAYDE G).
  [zySettings.footerLinks, zySettings.footerLinksG].forEach(set=>{
    Object.keys(set||{}).forEach(col=>{
      (set[col]||[]).forEach(item=>{ if(item.cat===oldName){ item.cat = newName; item.label = newName; } });
    });
  });
  await AdminStore.set('zayde:admin:homeSettings', zySettings);
  await zySaveCategorySettings();
  zyRefreshCategoryUI();
  showToast('Categoría renombrada.');
}
async function zyReplaceCategoryImage(cat, input){
  if(!input.files || !input.files[0]) return;
  try{
    zyCategoryImages[cat] = await zyCompressImageFile(input.files[0], 640, 0.75);
    await zySaveCategorySettings();
    zyRefreshCategoryUI();
    showToast('Portada actualizada.');
  }catch(e){ console.error(e); showToast('No se pudo procesar la foto.', true); }
  input.value = '';
}
async function zyRemoveCategoryImage(cat){
  if(!zyCategoryImages[cat]) return;
  delete zyCategoryImages[cat];
  await zySaveCategorySettings();
  zyRefreshCategoryUI();
  showToast('Se quitó la portada manual — vuelve a usarse la automática.');
}
async function zyMoveCategory(cat, dir){
  const i = CATS.indexOf(cat);
  const j = i + dir;
  if(i<0 || j<0 || j>=CATS.length) return;
  [CATS[i], CATS[j]] = [CATS[j], CATS[i]];
  await zySaveCategorySettings();
  zyRefreshCategoryUI();
}
async function zyDeleteCategory(cat){
  const count = PRODUCTS.filter(p=>p.category===cat).length;
  if(count>0){ showToast(`Esta categoría tiene ${count} producto(s). Muévelos o elimínalos desde "Almacén" antes de borrarla.`, true); return; }
  if(CATS.length<=1){ showToast('Debe quedar al menos una categoría.', true); return; }
  if(!confirm(`¿Eliminar la categoría "${cat}"? Esta acción no se puede deshacer.`)) return;
  CATS = CATS.filter(c=>c!==cat);
  delete zyCategoryImages[cat];
  delete zyCategoryImagesG[cat];
  await zySaveCategorySettings();
  zyRefreshCategoryUI();
  showToast('Categoría eliminada.');
}
function zyRenderCategoriesAdminList(){
  const box = document.getElementById('zyCatAdminList');
  if(!box) return;
  box.innerHTML = CATS.map((cat,i)=>{
    const slug = zySlugify(cat);
    const count = PRODUCTS.filter(p=>p.category===cat).length;
    const img = zyCategoryImages[cat];
    return `
    <div class="zy-cat-row">
      <span class="zy-cat-info">
        <span class="zy-cat-thumb">
          ${img ? `<img src="${img}" alt="Vista previa del ícono de categoría">` : `<span style="font-size:10px; color:var(--steel);">Auto</span>`}
        </span>
        <input type="text" id="zyCatNameInput_${slug}" class="zy-cat-name-input" value="${zyEscapeHtml(cat)}" onkeydown="if(event.key==='Enter')zyRenameCategory('${cat.replace(/'/g,"\\'")}')">
        <span class="zy-cat-count">${count} producto(s)</span>
      </span>
      <span class="zy-cat-actions">
        <button type="button" onclick="zyRenameCategory('${cat.replace(/'/g,"\\'")}')" style="color:var(--signal);">Guardar nombre</button>
        <label class="btn btn-ghost" style="padding:4px 8px; font-size:11px; cursor:pointer;">Cambiar foto<input type="file" accept="image/*" style="display:none;" onchange="zyReplaceCategoryImage('${cat.replace(/'/g,"\\'")}', this)"></label>
        ${img ? `<button type="button" onclick="zyRemoveCategoryImage('${cat.replace(/'/g,"\\'")}')">Quitar foto</button>` : ''}
        <button type="button" onclick="zyMoveCategory('${cat.replace(/'/g,"\\'")}', -1)" ${i===0?'disabled style="opacity:.35;"':''}>↑</button>
        <button type="button" onclick="zyMoveCategory('${cat.replace(/'/g,"\\'")}', 1)" ${i===CATS.length-1?'disabled style="opacity:.35;"':''}>↓</button>
        <button type="button" onclick="zyDeleteCategory('${cat.replace(/'/g,"\\'")}')" style="color:var(--down);">Eliminar</button>
      </span>
    </div>`;
  }).join('');
  zyRenderCategoriesGAdminList();
}


