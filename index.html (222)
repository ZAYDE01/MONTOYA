const STAGE_MSG = {
  recibido:    ['bag',    'Pedido recibido',          'Registramos tu pedido {n}. Pronto empieza la inspección de autenticidad.'],
  verificando: ['shield', 'Verificando tus piezas',   'Tu pedido {n} entró a inspección de autenticidad.'],
  preparando:  ['check',  'Piezas verificadas ✓',     'Tu pedido {n} pasó la verificación{code} y ya se prepara para envío.'],
  camino:      ['box',    'Tu pedido va en camino',   'El pedido {n} ya salió hacia ti.'],
  entregado:   ['check',  'Pedido entregado',         'El pedido {n} fue entregado. Tienes ' + RETURN_DAYS + ' días naturales para solicitar una devolución desde Pedidos.']
};
function orderAlerts(orders){
  const out = [];
  orders.slice(0, 3).forEach(o => {
    const code = o.verification && o.verification.code ? ' (código ' + o.verification.code + ')' : '';
    let hist = Array.isArray(o.statusHistory) && o.statusHistory.length ? o.statusHistory : [{ status:o.status || 'recibido', at:o.date }];
    hist.forEach(h => {
      const def = STAGE_MSG[h.status]; if(!def) return;
      let title = def[1], msg = def[2];
      if(h.status === 'camino' && o.shipMode === 'sucursal'){ title = 'Tu pedido está listo para recoger'; msg = 'El pedido {n} ya está listo en la sucursal.'; }
      const when = new Date(h.at || o.date);
      out.push({ id:'ord_' + o.orderNum + '_' + h.status, icon:def[0], title, msg:msg.replace('{n}', o.orderNum).replace('{code}', code),
        date:when.toISOString(), read:(Date.now() - when.getTime()) > 7 * DAY, auto:true, action:{ label:'Ver pedido', type:'orders' } });
    });
    if(o.verification && o.verification.status === 'verificado' && o.verification.verifiedAt){
      const when = new Date(o.verification.verifiedAt);
      out.push({ id:'ord_' + o.orderNum + '_sello', icon:'shield', title:'Sello ZAYDE otorgado', msg:`Tu pieza del pedido ${o.orderNum} fue verificada.${o.verification.code ? ' Código ' + o.verification.code + '.' : ''}`,
        date:when.toISOString(), read:(Date.now() - when.getTime()) > 7 * DAY, auto:true, action:{ label:'Ver pedido', type:'orders' } });
    }
  });
  return out;
}

