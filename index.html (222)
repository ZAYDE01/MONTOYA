/* ============================================================
   4 · BARRA DE PROGRESO DEL CLUB + PUNTOS ZAYDE (niveles)
   Reglas (edítalas aquí): 1 punto por cada $10 MXN en piezas con
   sello + 50 puntos por pieza verificada. Los pedidos aún sin
   verificar se muestran como "pendientes".
   ============================================================ */
const PTS = {
  pesosPerPoint: 10,
  bonusPerPiece: 50,
  ranks: [ {name:'Esencial', at:0}, {name:'Selecto', at:300}, {name:'Élite', at:800}, {name:'Icono', at:1800} ]
};
function calcPoints(orders){
  let earned = 0, pending = 0, pieces = 0;
  orders.forEach(o => {
    const items = physicalItems(o);
    const n = items.reduce((s, it) => s + (it.qty || 1), 0);
    const merch = items.reduce((s, it) => s + (it.price || 0) * (it.qty || 1), 0);
    const pts = Math.floor(merch / PTS.pesosPerPoint) + n * PTS.bonusPerPiece;
    if(verifiedOrder(o)){ earned += pts; pieces += n; } else pending += pts;
  });
  return { earned, pending, pieces };
}
function rankInfo(pts){
  let cur = PTS.ranks[0], next = null;
  PTS.ranks.forEach(r => { if(pts >= r.at) cur = r; });
  next = PTS.ranks.find(r => r.at > pts) || null;
  const pct = next ? Math.round(((pts - cur.at) / (next.at - cur.at)) * 100) : 100;
  return { cur, next, pct };
}
