  zyTextFieldKeys = [];
  box.innerHTML = groupNames.map(g=>`
    <div class="zy-text-group">
      <h6>${zyEscapeHtml(g)}</h6>
      ${groups[g].map((f,i)=>{
        const idx = zyTextFieldKeys.push(f.key)-1;
        return `
        <div class="zy-text-field ${f.dirty?'zy-dirty':''}" data-field-idx="${idx}">
          <label>${zyEscapeHtml(f.key)}</label>
          <textarea>${zyEscapeHtml(f.current)}</textarea>
          <div class="zy-text-actions">
            <button type="button" onclick="zyCommitTextField(${idx})">Guardar</button>
            ${f.dirty ? `<button type="button" onclick="zyResetTextField(${idx})">Restablecer</button>` : ''}
          </div>
        </div>`;
      }).join('')}
    </div>`).join('');
}
function zyCommitTextField(idx){
