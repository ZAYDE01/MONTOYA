    pbs.filter(b=>b && b.store!=='clothesg' && b.visible!==false && b.images && b.images[0]).slice(0,2).forEach(b=>zyWarm(b.images[0]));
  }catch(e){}
  // [FLUIDEZ] el render pesado espera a que termine la animación de la intro
  if(window.zyIntroGate){ try{ await window.zyIntroGate; }catch(e){} }
