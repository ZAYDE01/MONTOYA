   que volver a enlazar sus textos nuevos, no solo los que existían al
   activar el modo. */
let zyLiveEditOn = false;
function zyBindLiveEditTargets(){
  document.querySelectorAll('[data-zt]').forEach(el=>{
    el.setAttribute('contenteditable', zyLiveEditOn ? 'true' : 'false');
