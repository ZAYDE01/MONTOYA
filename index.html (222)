const SPANISH_SPEAKING_ISOS = new Set(['MX','AR','BO','CL','CO','CR','CU','DO','EC','SV','GT','HN','NI','PA','PY','PE','PR','ES','UY','VE']);
let currentRegionIso = 'MX';
function isoToFlag(iso){
  return iso.toUpperCase().replace(/./g, c=>String.fromCodePoint(127397 + c.charCodeAt(0)));
}
function openRegionModal(){
  document.getElementById('regionModal').classList.add('open');
  document.getElementById('regionSearchInput').value = '';
  zyRenderRegionList('');
