  });
  {
    const c = document.getElementById('zyChartPayment');
    if(c) c.setAttribute('aria-label', `Método de pago de los pedidos: ${payCounts.stripe} con tarjeta (Stripe).`);
  }

  // ---- Estado de pedidos ----
  const statusCounts = {}; ORDER_STAGES.forEach(s=>statusCounts[s.key]=0);
  orders.forEach(o=>{ const idx = zyComputeStageIndex(o); statusCounts[ORDER_STAGES[idx].key]++; });
  zyDestroyChart('status');
  zyCharts.status = new Chart(document.getElementById('zyChartStatus'), {
    type:'doughnut',
    data:{ labels: ORDER_STAGES.map(s=>s.label), datasets:[{ data:ORDER_STAGES.map(s=>statusCounts[s.key]), backgroundColor:[colSteel,colSignal,colBrass,'#8B6FE0',colUp] }] },
    options:{ responsive:true, plugins:{legend:{position:'bottom', labels:{boxWidth:10, font:{size:10}}}} }
  });
  {
    const c = document.getElementById('zyChartStatus');
    const summary = ORDER_STAGES.map(s=>`${s.label}: ${statusCounts[s.key]}`).join(', ');
    if(c) c.setAttribute('aria-label', `Estado de pedidos — ${summary}.`);
  }

  // ---- Productos más vendidos ----
  const qtyByName = {};
  orders.forEach(o=> (o.items||[]).forEach(it=>{ qtyByName[it.name] = (qtyByName[it.name]||0) + (it.qty||1); }));
  const topProducts = Object.entries(qtyByName).sort((a,b)=>b[1]-a[1]).slice(0,5);
  zyDestroyChart('topProducts');
