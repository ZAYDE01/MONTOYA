function recoCategory(p){
  if(!p) return null;
  if(p.category === 'Zapatos') return 'Zapatos';
  if(p.category === 'Ropa') return 'Ropa';
  if(typeof zyIsGorraCat === 'function' && zyIsGorraCat(p.category)) return 'Gorras';
  return null;
}
function recoTarget(p, cat){
  const prof = sizeProfile[cat];
  if(!prof || !prof.size) return null;
  if(cat !== 'Zapatos') return { size:String(prof.size), note:'' };
  const mine = prof.gender || 'Hombre', pg = p.gender || mine;
  if(mine === pg) return { size:String(prof.size), note:'' };
  const n = Number(prof.size);
  if(mine === 'Hombre' && pg === 'Mujer') return { size:String(n + 1.5), note:`Convertida de tu talla ${zyShoeMx({category:'Zapatos',gender:'Hombre'},prof.size)||prof.size} MX (Hombre)` };
  if(mine === 'Mujer' && pg === 'Hombre') return { size:String(n - 1.5), note:`Convertida de tu talla ${zyShoeMx({category:'Zapatos',gender:'Mujer'},prof.size)||prof.size} MX (Mujer)` };
  return null; // Niños: sin conversión confiable
}
function sizeBtn(s){ return [...document.querySelectorAll('#pdpSizes .size-opt')].find(b => String(b.dataset.us!=null ? b.dataset.us : (b.firstChild ? b.firstChild.textContent : '')).trim() === String(s)); }
function nearest(p, size, cat){
  const list = (p.sizes || []).map(String).filter(s => (p.stock ? (Number(p.stock[s]) || 0) : 1) > 0);
  if(!list.length) return null;
  const order = cat === 'Ropa' ? CAT_SIZES.Ropa : cat === 'Gorras' ? CAP_LIST() : null;
  if(order){
    const i = order.indexOf(String(size)); if(i < 0) return null;
    return list.map(s => ({ s, d:Math.abs(order.indexOf(s) - i) })).filter(x => x.d < 99 && order.indexOf(x.s) >= 0).sort((a, b) => a.d - b.d)[0]?.s || null;
  }
  const n = Number(size);
  return list.map(s => ({ s, d:Math.abs(Number(s) - n) })).filter(x => isFinite(x.d)).sort((a, b) => a.d - b.d)[0]?.s || null;
}
