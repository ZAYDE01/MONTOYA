        var tc=t.getContext('2d'); tc.drawImage(im,0,0,48,48);
        var px=tc.getImageData(0,0,48,48).data, alpha=false;
        for(var k=3;k<px.length;k+=4){ if(px[k]<245){ alpha=true; break; } }
