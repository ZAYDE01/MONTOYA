/* ================= [VENDEDORES] Selector de dueño de la pieza =================
   Lee la colección "sellers" de Firestore (solo el admin tiene permiso) y llena
   el selector del formulario de alta. Si Firestore no está disponible o la
   colección está vacía, el selector queda solo con "ZAYDE (pieza propia)". */
let zySellersList = [];
let zySellersLoaded = false;
async function zyLoadSellers(force){
  if(zySellersLoaded && !force) return zySellersList;
  try{
    if(typeof db !== 'undefined' && db){
      const snap = await db.collection('sellers').get();
      zySellersList = snap.docs
        .map(d=>({ id:d.id, ...d.data() }))
        .filter(x=>x.status!=='pausado' && x.status!=='paused')
        .sort((a,b)=>String(a.name||'').localeCompare(String(b.name||'')));
      zySellersLoaded = true;
    }
  }catch(e){ console.warn('No se pudieron leer los vendedores:', e); }
  return zySellersList;
}
function zyRenderSellerSelect(selectedId){
  const sel = document.getElementById('zySellerId');
  if(!sel) return;
  const cur = selectedId !== undefined ? (selectedId || '') : sel.value;
  const esc = v => String(v==null?'':v).replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;');
  let html = '<option value="">ZAYDE (pieza propia)</option>';
  zySellersList.forEach(x=>{ html += '<option value="'+esc(x.id)+'">'+esc(x.name || x.email || x.id)+'</option>'; });
  // Si la pieza ya tenía un vendedor que ahora está pausado o no aparece en la lista, se conserva para no perderlo al editar
  if(cur && !zySellersList.some(x=>x.id===cur)) html += '<option value="'+esc(cur)+'">'+esc(cur)+' (no listado)</option>';
  sel.innerHTML = html;
  sel.value = cur;
}
