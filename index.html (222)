/* ================= [TIPOGRAFÍA GLOBAL — panel privado] =================
   Llena los tres selectores (fuente del sitio, grosor, y fuente SOLO de
   títulos) con lo que ya está guardado en zySettings.siteFont cada vez
   que se abre la pestaña, y deja lista la vista previa. Reutiliza
   ZY_TITLE_FONTS/ZY_BODY_WEIGHTS, ya que son el mismo catálogo curado
   que usa el selector de fuente por producto — así no hay dos listas de
   fuentes desincronizadas dentro del sitio. */
function zyLoadSiteFontForm(){
  const fontSel = document.getElementById('zySiteFontSelect');
  const weightSel = document.getElementById('zySiteFontWeight');
  const titleFontSel = document.getElementById('zySiteTitleFontSelect');
  if(!fontSel || !weightSel || !titleFontSel) return;
  if(!fontSel.dataset.filled){
    fontSel.dataset.filled = '1';
    fontSel.innerHTML = ZY_TITLE_FONTS.map(f=>`<option value="${zyEscapeHtml(f.id)}" style="font-family:${f.family}">${zyEscapeHtml(f.label)}</option>`).join('');
    ZY_TITLE_FONTS.forEach(f=>{ if(f.id) zyEnsureFont(f.id); });
  }
  if(!weightSel.dataset.filled){
    weightSel.dataset.filled = '1';
    weightSel.innerHTML = ZY_BODY_WEIGHTS.map(w=>`<option value="${w.id}">${w.label}</option>`).join('');
  }
  if(!titleFontSel.dataset.filled){
    titleFontSel.dataset.filled = '1';
    // La primera opción ("Usar la misma tipografía del sitio") ya está
    // en el HTML fijo — aquí solo se agregan las fuentes reales,
    // saltando la entrada vacía de ZY_TITLE_FONTS (esa ya la cubre la
    // opción fija de arriba, no hace falta duplicarla).
    titleFontSel.innerHTML += ZY_TITLE_FONTS.filter(f=>f.id).map(f=>`<option value="${zyEscapeHtml(f.id)}" style="font-family:${f.family}">${zyEscapeHtml(f.label)}</option>`).join('');
  }
  const sf = zySettings.siteFont || { id:'', weight:'400', titleId:null };
  fontSel.value = sf.id || '';
  weightSel.value = sf.weight || '400';
  titleFontSel.value = sf.titleId || '';
  zyUpdateSiteFontPreview();
}
/* Actualiza SOLO la caja de vista previa dentro del panel admin, sin
   tocar el resto del sitio — así el admin puede probar combinaciones
   antes de decidirse, y el cambio real (visible para todos) solo ocurre
   al tocar "Guardar tipografía del sitio". El título de la vista previa
   usa la fuente de títulos si el admin eligió una distinta; si no, cae
   de vuelta a la fuente general del sitio — mismo comportamiento que
   zyApplySiteFont() en el sitio real. */
function zyUpdateSiteFontPreview(){
  const fontId = document.getElementById('zySiteFontSelect').value;
  const weight = document.getElementById('zySiteFontWeight').value;
  const titleFontId = document.getElementById('zySiteTitleFontSelect').value;
  if(fontId) zyEnsureFont(fontId);
  if(titleFontId) zyEnsureFont(titleFontId);
  const def = zyFontById(fontId);
  const titleDef = titleFontId ? zyFontById(titleFontId) : def;
  const disp = document.getElementById('zySiteFontPreviewDisplay');
  const body = document.getElementById('zySiteFontPreviewBody');
  if(disp){ disp.style.fontFamily = titleDef.family; disp.style.fontWeight = '700'; }
  if(body){ body.style.fontFamily = def.family; body.style.fontWeight = weight; }
}
/* Guarda zySettings.siteFont en Firestore (mismo documento que el resto
   de "Contenido del sitio") y lo aplica de inmediato con
   zyApplySiteFont() — el admin ve el cambio en su propia pantalla al
   instante, y cualquier otro visitante lo ve en su próxima carga. */
function zySaveSiteFont(){
  const fontId = document.getElementById('zySiteFontSelect').value;
  const weight = document.getElementById('zySiteFontWeight').value;
  const titleFontId = document.getElementById('zySiteTitleFontSelect').value;
  zySettings.siteFont = { id: fontId, weight: weight, titleId: titleFontId || null };
  zyApplySiteFont();
  AdminStore.set('zayde:admin:homeSettings', zySettings);
  showToast('Tipografía del sitio actualizada');
}

/* ================= [Colores del sitio — panel privado] =================
   Llena los 10 inputs type="color" (5 modo claro + 5 modo oscuro) con lo
   que ya está guardado en zySettings.siteColors, o con el color original
   de cada variable si el admin nunca lo ha personalizado — así el input
   nunca aparece "en blanco". Los valores originales están quemados aquí
   porque son justo los que ya viven en :root/[data-theme=dark] arriba en
   el <style> del archivo. */
const ZY_COLOR_DEFAULTS = {
  light:{ bg:'#FAFAF8', surface:'#FFFFFF', text:'#0E0E10', signal:'#2F5FFF', brass:'#C9A227' },
  dark: { bg:'#07070A', surface:'#0E0E12', text:'#E9E7E0', signal:'#4A5FC7', brass:'#B8944A' }
};
const ZY_TAG_COLOR_DEFAULTS = {
  new:{ bg:'#2F5FFF', fg:'#FFFFFF' }, trend:{ bg:'#C9A227', fg:'#1A1200' }, discount:{ bg:'#C81E3A', fg:'#FFFFFF' }
};
function zyPopulateSiteColorInputs(){
  const tcs = (zySettings && zySettings.tagColors) || {};
  Object.keys(ZY_TAG_COLOR_DEFAULTS).forEach(k=>['bg','fg'].forEach(m=>{
    const el = document.getElementById('zyTagColor_'+k+'_'+m);
    if(el) el.value = (tcs[k] && tcs[k][m]) ? tcs[k][m] : ZY_TAG_COLOR_DEFAULTS[k][m];
  }));
  const sc = (zySettings && zySettings.siteColors) || { light:{}, dark:{} };
  ['light','dark'].forEach(mode=>{
    Object.keys(ZY_COLOR_VARMAP).forEach(k=>{
      const el = document.getElementById('zyColor_'+mode+'_'+k);
      if(!el) return;
      el.value = (sc[mode] && sc[mode][k]) ? sc[mode][k] : ZY_COLOR_DEFAULTS[mode][k];
    });
  });
}
/* Guarda zySettings.siteColors (mismo documento "Contenido del sitio" que
   tipografía/textos) y lo aplica de inmediato con zyApplySiteColors(). Si
   un color coincide exactamente con el original, se guarda como '' para
   que quede marcado como "no personalizado" — no cambia nada visualmente,
   solo mantiene los datos limpios. */
function zySaveSiteColors(){
  const sc = { light:{}, dark:{} };
  ['light','dark'].forEach(mode=>{
    Object.keys(ZY_COLOR_VARMAP).forEach(k=>{
      const el = document.getElementById('zyColor_'+mode+'_'+k);
      if(!el) return;
      const val = el.value;
      sc[mode][k] = (val && val.toLowerCase()!==ZY_COLOR_DEFAULTS[mode][k].toLowerCase()) ? val : '';
    });
  });
  zySettings.siteColors = sc;
  const tcOut = {};
