  try{
    if(savedCatSettings && Array.isArray(savedCatSettings.cats) && savedCatSettings.cats.length){
      if(savedCatSettings.renameMap) zyCatRenameMap = savedCatSettings.renameMap;
      // Los 42 productos de muestra se regeneran en cada carga con los nombres
