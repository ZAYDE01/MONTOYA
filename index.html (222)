}
function closeRegionModal(){ document.getElementById('regionModal').classList.remove('open'); }
function zyRenderRegionList(query){
  const q = (query||'').trim().toLowerCase();
  const list = REGIONS
    .filter(r=>!q || r.name.toLowerCase().includes(q))
    .sort((a,b)=>a.name.localeCompare(b.name,'es'));
  const box = document.getElementById('regionList');
  if(!list.length){ box.innerHTML = '<div style="padding:16px 4px; color:var(--steel); font-size:13px;">No encontramos ese país.</div>'; return; }
  box.innerHTML = list.map(r=>`
    <button type="button" class="region-item ${r.iso===currentRegionIso?'active':''}" onclick="selectRegion('${r.iso}')">
      <span class="region-item-flag">${isoToFlag(r.iso)}</span>
      <span class="region-item-name">${r.name}</span>
      <span class="region-item-cur">${r.currency}</span>
    </button>`).join('');
}
function selectRegion(iso){
  const r = REGIONS.find(x=>x.iso===iso);
  if(!r) return;
  currentRegionIso = iso;
  Store.set('zayde:region', iso);
  const lang = SPANISH_SPEAKING_ISOS.has(iso) ? 'es' : 'en';
  setLocale(lang);
  setCurrency(r.currency);
  const flagEl = document.getElementById('regionNavFlag');
  if(flagEl) flagEl.textContent = isoToFlag(iso);
  closeRegionModal();
  showToast(lang==='es'
    ? `Región: ${r.name} · Idioma: Español · Precios de referencia en ${r.currency}`
    : `Region: ${r.name} · Language: English · Reference prices in ${r.currency}`);
}
async function zyInitRegion(){
  try{
    const savedIso = await Store.get('zayde:region');
    if(savedIso && REGIONS.find(r=>r.iso===savedIso)) currentRegionIso = savedIso;
  }catch(e){}
  const flagEl = document.getElementById('regionNavFlag');
  if(flagEl) flagEl.textContent = isoToFlag(currentRegionIso);
}
