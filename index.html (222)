async function zyBulkAssignSeller(){
  const ids = [...document.querySelectorAll('#zyProductList .zy-sel:checked')].map(c => Number(c.value));
  if(!ids.length){ showToast('Selecciona al menos una pieza', true); return; }
  const sel = document.getElementById('zyBulkSeller');
  const v = sel ? sel.value : '';
  if(!v){ showToast('Elige a qué vendedor asignarlas', true); return; }
  const sellerId = v === '__zayde' ? null : v;
  const seller = sellerId ? zySellersList.find(x => x.id === sellerId) : null;
  if(!confirm('¿Asignar ' + ids.length + ' pieza(s) a ' + (seller ? (seller.name || seller.email) : 'ZAYDE (pieza propia)') + '?\n\nLas ventas FUTURAS de estas piezas serán de ese vendedor; las ventas ya hechas no cambian.')) return;
  let changedAdmin = false;
  const assignedAt = Date.now();
  const pieceHints = []; // datos de respaldo para el correo "Publicamos tus piezas"
  // Foto siempre como https absoluto (las del catálogo fijo pueden ser rutas relativas, y así el vendedor SÍ las ve)
  const absImg = list => {
    for(const u of (Array.isArray(list) ? list : [])){
      const raw = typeof u === 'string' ? u : (u && (u.url || u.src)) || '';
      if(!raw || /^data:/i.test(raw)) continue;
      try{ const abs = new URL(raw, location.href).href; if(/^https:\/\//i.test(abs)) return abs; }catch(e){}
    }
    return '';
  };
  ids.forEach(id => {
    const p = PRODUCTS.find(x => x.id === id); if(!p) return;
    p.sellerId = sellerId;
    const a = zyAdminProducts.find(x => x.id === id);
    const img = absImg(p.images);
    if(a){
      a.sellerId = sellerId; changedAdmin = true;
      if(sellerId) a.sellerAssignedAt = assignedAt;
      if(zyOverrides[id] && !zyOverrides[id]._deleted) zyOverrides[id].sellerId = sellerId; // un override anterior pisaría al nuevo valor
    } else {
      zyOverrides[id] = Object.assign({}, zyOverrides[id] || {}, {
        id, sellerId,
        sellerView: { name: p.name, brand: p.brand || '', price: p.price || 0, image: img || '', stock: (p.stock && typeof p.stock === 'object') ? p.stock : {},
          /* [Portal vendedor] datos de la ficha: sección (Ropa › Hoodies › tipo), detalles y SKU, para que el vendedor sepa qué es cada pieza */
          category: p.category || '', ropaGroup: (typeof zyRopaGroupOf === 'function' ? zyRopaGroupOf(p) : (p.ropaGroup || '')) || '', ropaType: p.ropaType || '', ropaDetails: (p.ropaDetails && typeof p.ropaDetails === 'object') ? p.ropaDetails : {},
          sku: p.sku || '', gender: p.gender || '', color: p.color || '', material: p.material || '', store: p.store || '', releaseDate: p.releaseDate || '', desc: String(p.desc || '').slice(0, 400) }
      });
      if(sellerId) zyOverrides[id].sellerAssignedAt = assignedAt;
    }
    if(sellerId) pieceHints.push({ id, name: p.name, brand: p.brand || '', price: p.price || 0, image: img || '', stock: (p.stock && typeof p.stock === 'object') ? p.stock : {} });
  });
  await AdminStore.set('zayde:admin:overrides', zyOverrides);
  if(changedAdmin) await AdminStore.set('zayde:admin:products', zyAdminProducts);
  zyRenderAdminList();
  let mailedNote = '';
  // [Aviso automático] el vendedor recibe un correo con sus piezas publicadas (con foto y stock) y las ve en su portal
  if(sellerId && pieceHints.length && typeof window.zySellerEvent === 'function'){
    const mailed = await window.zySellerEvent({ event:'pieces', sellerId, productIds: pieceHints.map(h => h.id), pieces: pieceHints });
    mailedNote = mailed.sent ? ' Se le avisó al vendedor por correo.' : '';
  }
  showToast(ids.length + ' pieza(s) asignada(s) a ' + (seller ? (seller.name || seller.email) : 'ZAYDE') + '.' + mailedNote);
}
