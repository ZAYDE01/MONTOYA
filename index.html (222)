  // Ahora se piden mientras la intro todavía se está viendo, así ya están listas al salir.
  try{
    const zyIsM = window.matchMedia('(max-width:760px)').matches;
    const zyWarm = u => { if(u && typeof u==='string' && !/^data:/.test(u)){ const im = new Image(); im.decoding='async'; im.src = u; } };
    const hs = (savedHome && Array.isArray(savedHome.heroSlides)) ? savedHome.heroSlides : [];
    hs.filter(x=>x && (x.img||x.imgM)).slice(0,2).forEach(x=>zyWarm(zyIsM && x.imgM ? x.imgM : x.img));
