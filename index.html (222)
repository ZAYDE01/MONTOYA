function translateUI(lang){
  document.querySelectorAll('[data-zt]').forEach(el=>{
    const key = el.getAttribute('data-zt');
    if(lang==='en' && I18N.en[key]){
      el.textContent = I18N.en[key];
    }else{
      const base = (zyTextOverrides[key]!==undefined) ? zyTextOverrides[key] : ZY_TEXT_DEFAULTS[key];
      if(base!==undefined) el.textContent = base;
    }
  });
  const searchEs = 'Busca marca, modelo, categoría o SKU...';
  const searchEn = 'Search brand, model, category or SKU...';
  ['searchInput','searchInputMobile'].forEach(id=>{
    const el = document.getElementById(id);
    if(el) el.placeholder = (lang==='en') ? searchEn : searchEs;
  });
  document.documentElement.lang = lang;
}

