/* [SEGURIDAD] Reserva (descuenta) stock ANTES de cobrar, para que dos compradores
   nunca se lleven la misma última unidad. Antes el navegador escribía directo en
   Firestore (inventory/stock), lo que obligaba a dejar esa colección abierta al
   público. Ahora lo hace el servidor (/api/send-email, type "stock-reserve"): el navegador solo pide
   "reserva esto para el pedido X" y recibe un ID de reserva. Devuelve
   {ok:true, reservationId} o {ok:false, error}. Si el servidor no responde, la compra
   NO se bloquea (igual que antes con un fallo de red). */
async function zyReserveStock(items, orderNum){
  const tracked = (items || []).filter(it => it && it.size && it.id != null);
  if(!tracked.length) return { ok:true, reservationId:null };
  try{
    const res = await fetch('/api/send-email', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ type:'stock-reserve', orderNum, items: tracked.map(it => ({ id: it.id, size: it.size, qty: it.qty || 1 })) })
    });
    const data = await res.json().catch(()=>({}));
    if(res.ok && data.ok) return { ok:true, reservationId: data.reservationId || null };
    if(res.status === 409 && data.code === 'STOCK_INSUFICIENTE'){
      const it = tracked.find(x => String(x.id) === String(data.itemId) && String(x.size) === String(data.size)) || tracked[0];
      return { ok:false, error: `Ya no hay suficientes unidades de ${`${it.brand||''} ${it.name} · talla ${it.size}`.trim()} — alguien más la compró justo ahora.` };
    }
    if(res.status === 429) return { ok:false, error:'Demasiados intentos seguidos. Espera un momento e inténtalo de nuevo.' };
    console.error('Error reservando stock:', res.status, data);
    return { ok:true, reservationId:null };
  }catch(e){
    console.error('Error reservando stock:', e);
    return { ok:true, reservationId:null }; // no bloqueamos la compra por un problema de red pasajero
  }
}
/* [VENDEDORES] Aviso de "queda 1 unidad / se agotó la talla": el stock lo descuenta el navegador del comprador,
   así que el correo lo manda el servidor (api/send-email.js, type "seller-low-stock"). El navegador solo avisa QUÉ se
   compró; el servidor revisa el inventario real, decide si toca avisar y a quién (nadie puede mandar texto ni destinatarios). */
function zyNotifySellerLowStock(items){
  try{
    const mine = (items || []).filter(it => it && it.sellerId);
    if(!mine.length) return;
    fetch('/api/send-email', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, keepalive: true,
      body: JSON.stringify({ type: 'seller-low-stock', items: mine.map(it => ({ id: it.id, size: it.size || '', qty: it.qty || 1 })) })
    }).catch(() => {});
  }catch(e){}
}
/* Si el pago con tarjeta falla DESPUÉS de reservar el stock, se libera de nuevo para
   que no quede "fantasma" sin haberse vendido. [SEGURIDAD] Lo hace el servidor y solo
   con el ID de la reserva: se devuelve una sola vez y nunca si el pedido ya se pagó. */
async function zyReleaseStock(reservationId, orderNum){
  if(!reservationId) return;
  try{
    await fetch('/api/send-email', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ type:'stock-release', orderNum, reservationId })
    });
  }catch(e){ console.error('Error liberando stock reservado:', e); }
}
/* Empuja el stock definido en el panel de admin (alta/edición de producto)
   a Firestore para que quede como la fuente de verdad compartida. */
/* [HISTORIAL DE STOCK — portal del vendedor] Cada ajuste manual del admin a una pieza de un vendedor
   deja un renglón por talla en la colección "stockLog" (de/a, cuánto cambió y cuándo). El vendedor
   lo ve en su portal; las ventas y devoluciones ya salen de sus propias ventas. Si falla (por ejemplo
   si aún no se publican las reglas), se ignora sin afectar el guardado de la pieza. */
async function zyLogStockChange(productId, prev, next, ctx){
  try{
    if(!db || !ctx || !ctx.sellerId) return;
    const sizes = Array.from(new Set(Object.keys(prev || {}).concat(Object.keys(next || {}))));
    const batch = db.batch(), at = Date.now(); let n = 0;
    sizes.forEach(sz => {
      const from = Number((prev || {})[sz]) || 0, to = Number((next || {})[sz]) || 0;
      if(from === to) return;
      batch.set(db.collection('stockLog').doc(), { sellerId:String(ctx.sellerId), productId:String(productId), productName:String(ctx.name || ''), brand:String(ctx.brand || ''), size:String(sz), from, to, delta:to - from, reason:ctx.reason || 'ajuste', at });
      n++;
    });
    if(n) await batch.commit();
  }catch(e){ console.warn('[stockLog] no se pudo registrar el movimiento:', e && e.message ? e.message : e); }
}
async function zyPushStockToFirestore(productId, stockMap, ctx){
  if(!db) return;
  try{
    const ref = db.collection('inventory').doc('stock');
    try{ if(window.zyLiveStockMap) window.zyLiveStockMap[String(productId)] = Object.assign({}, stockMap); }catch(e){}  // [CHATBOT · STOCK EN VIVO] el cambio local ya cuenta para el bot
    await ref.set({ items: { [String(productId)]: stockMap }, updatedAt: Date.now() }, { merge:true });
    if(ctx && ctx.sellerId) zyLogStockChange(productId, ctx.prev || {}, stockMap, ctx);
  }catch(e){ console.error('No se pudo actualizar el inventario en Firestore:', e); }
}
