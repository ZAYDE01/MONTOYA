</style>

<script id="zyUpgradeJS">
(function(){
'use strict';

/* ============================================================
   Utilidades compartidas
   ============================================================ */
const DAY = 864e5;
const esc = s => (typeof zyEscapeHtml === 'function') ? zyEscapeHtml(String(s == null ? '' : s)) : String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const ICON = {
  shield: '<svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>',
  check:  '<svg viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>',
  undo:   '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>',
  star:   '<svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.3L22 9l-5 5.1L18.2 22 12 18.4 5.8 22 7 14.1 2 9l7.1-.7z"/></svg>',
  cam:    '<svg viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>',
  img:    '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>'
};
const inboxKey = () => 'zayde:inbox:' + userKey();
const verifiedOrder = o => (o.verification && o.verification.status === 'verificado') || zyComputeStageIndex(o) >= 2;
const physicalItems = o => (o.items || []).filter(it => !it.isMembership && !it.isGiftCard);

async function myPhysicalOrders(){
  const all = (await Store.get('zayde:orders')) || [];
  return zyMyOrders(all).filter(o => !zyIsDigitalOnlyOrder(o)).sort((a, b) => (b.date || 0) - (a.date || 0));
}

/* ============================================================
   6 · SELLO DE VERIFICACIÓN + 1 · SOLICITAR DEVOLUCIÓN
   (se envuelve zyRenderOrderCard: el HTML original no se toca,
    solo se le agregan piezas en puntos de anclaje conocidos)
   ============================================================ */
const RETURN_DAYS = 5; // política vigente: 5 días naturales
let returnsCache = [];
async function loadReturns(){ try{ returnsCache = (await Store.get('zayde:returns:' + userKey())) || []; }catch(e){ returnsCache = []; } }

function deliveredAt(o){
  const h = (o.statusHistory || []).slice().reverse().find(x => x.status === 'entregado');
  return h ? h.at : null; // null = no hay fecha registrada (pedidos viejos)
}

function sealStripHTML(o){
  const idx = zyComputeStageIndex(o);
  const ver = verifiedOrder(o);
  const code = o.verification && o.verification.code ? o.verification.code : '';
  const when = o.verification && o.verification.verifiedAt ? new Date(o.verification.verifiedAt).toLocaleDateString('es-MX', {day:'numeric', month:'short', year:'numeric'}) : '';
  let cls = '', title, sub;
  if(ver){
    cls = ' is-verified';
    title = 'Sello ZAYDE de verificación';
    sub = 'Tu pieza pasó la inspección de autenticidad' + (when ? ' el ' + when : '') + '.' + (code ? ' Código <code>' + esc(code) + '</code>' : '');
  }else if(idx === 1){
    cls = ' is-working';
    title = 'En inspección';
    sub = 'Nuestro equipo está revisando tu pieza. El sello se otorga al terminar la verificación.';
  }else{
    title = 'Sello pendiente';
    sub = 'Se asigna cuando tu pedido entra a la etapa de inspección.' + (code ? ' Código <code>' + esc(code) + '</code>' : '');
  }
  return `<div class="zy-seal-strip${cls}"><span class="zy-seal-big">${ICON.shield}</span><div class="zy-seal-txt"><b>${title}</b><span>${sub}</span></div></div>`;
}

function returnBlockHTML(o){
  const num = esc(o.orderNum);
  const rec = returnsCache.find(r => r.orderNum === o.orderNum);
  if(rec){
    return `<div class="zy-return-row"><div class="zy-return-state">${ICON.undo}<div><b>Devolución solicitada</b>Folio ${esc(rec.id)} · ${new Date(rec.createdAt).toLocaleDateString('es-MX', {day:'numeric', month:'short'})}<br><button type="button" class="zy-return-link" onclick="zyReturnWhatsApp('${esc(rec.id)}')">Enviar detalles por WhatsApp</button></div></div></div>`;
  }
  if(o.status !== 'entregado'){
    return `<div class="zy-return-row"><button type="button" class="btn btn-ghost zy-return-btn" disabled>${ICON.undo}Solicitar devolución</button><div class="zy-return-note">Se activa cuando recibas tu pedido · tendrás <b>${RETURN_DAYS} días naturales</b></div></div>`;
  }
  const t = deliveredAt(o);
  if(t){
    const end = t + RETURN_DAYS * DAY;
    if(Date.now() > end){
      return `<div class="zy-return-row"><button type="button" class="btn btn-ghost zy-return-btn" disabled>${ICON.undo}Solicitar devolución</button><div class="zy-return-note">El plazo de ${RETURN_DAYS} días venció el <b>${new Date(end).toLocaleDateString('es-MX', {day:'numeric', month:'long'})}</b>. Si crees que es un error, escríbenos por WhatsApp.</div></div>`;
    }
    const left = Math.max(1, Math.ceil((end - Date.now()) / DAY));
    return `<div class="zy-return-row"><button type="button" class="btn btn-ghost zy-return-btn" onclick="zyOpenReturn('${num}')">${ICON.undo}Solicitar devolución</button><div class="zy-return-note">Te ${left === 1 ? 'queda <b>1 día</b>' : 'quedan <b>' + left + ' días</b>'} para solicitarla</div></div>`;
  }
  return `<div class="zy-return-row"><button type="button" class="btn btn-ghost zy-return-btn" onclick="zyOpenReturn('${num}')">${ICON.undo}Solicitar devolución</button><div class="zy-return-note">Revisaremos la fecha de entrega al recibir tu solicitud</div></div>`;
}

function decorateOrder(html, o, opts){
  if(zyIsDigitalOnlyOrder(o)) return html;
  const idx = zyComputeStageIndex(o);
  const ver = verifiedOrder(o);
  // 6 · mini-sello sobre el ícono de la etapa "Verificando"
  const sealMini = ver
    ? `<i class="zy-seal-mini" title="Verificado">${ICON.check}</i>`
    : `<i class="zy-seal-mini is-pending${idx === 1 ? ' is-working' : ''}" title="Sello pendiente">${ICON.check}</i>`;
  html = html.replace(/(<span class="zy-step-dot">)((?:(?!<\/span>)[\s\S])*?M12 22s8-4 8-10V5(?:(?!<\/span>)[\s\S])*?)(<\/span>)/, (m, a, b, c) => a + b + sealMini + c);
  // 6 · franja con el sello (justo antes de "Detalles de rastreo")
  const strip = sealStripHTML(o);
  html = html.replace('<div class="zy-track-details">', () => strip + '<div class="zy-track-details">');
  // 1 · bloque de devolución (solo en pedidos propios con acciones)
  if(opts.withActions !== false){
    const rb = returnBlockHTML(o);
    html = html.replace('<div class="order-card-actions">', () => rb + '<div class="order-card-actions">');
  }
  return html;
}

const _zyROC = window.zyRenderOrderCard;
window.zyRenderOrderCard = function(order, opts){
  let html = _zyROC.apply(this, arguments);
  try{ html = decorateOrder(html, order, opts || {}); }catch(e){ console.warn('Sello/devolución:', e); }
  return html;
};

/* ----- Modal de devolución ----- */
let rtOrder = null;
function ensureReturnModal(){
  if(document.getElementById('zyReturnModal')) return;
  const d = document.createElement('div');
  d.className = 'zy-modal'; d.id = 'zyReturnModal';
  d.setAttribute('onclick', 'if(event.target===this)zyCloseReturn()');
  d.innerHTML = '<div class="zy-panel"><button class="zy-close" onclick="zyCloseReturn()" aria-label="Cerrar">&times;</button><div id="zyReturnBody"></div></div>';
  document.body.appendChild(d);
}
window.zyCloseReturn = function(){ const m = document.getElementById('zyReturnModal'); if(m) m.classList.remove('open'); };
window.zyRtToggle = function(el){ el.classList.toggle('is-on', el.querySelector('input').checked); };
window.zyOpenReturn = async function(num){
  const all = (await Store.get('zayde:orders')) || [];
  const o = all.find(x => x.orderNum === num);
  if(!o) return;
  rtOrder = o;
  ensureReturnModal();
  const items = physicalItems(o);
  document.getElementById('zyReturnBody').innerHTML = `
    <h3>Solicitar devolución</h3>
    <p class="zy-rt-sub">Pedido <b>${esc(o.orderNum)}</b> · Elige las piezas que quieres devolver. Revisamos tu solicitud y te contactamos por WhatsApp para coordinar los siguientes pasos (consulta la <a href="#" style="text-decoration:underline" onclick="event.preventDefault();zyCloseReturn();openPolicyModal('devoluciones')">política de devoluciones</a>).</p>
    <span class="zy-rt-label">Piezas</span>
    ${items.map((it, i) => `<label class="zy-rt-item is-on" onchange="zyRtToggle(this)"><input type="checkbox" checked data-i="${i}"><span>${it.qty > 1 ? it.qty + '× ' : ''}${esc(it.name || '')}<small>${[it.brand, it.size ? 'Talla ' + it.size : ''].filter(Boolean).map(esc).join(' · ')}</small></span></label>`).join('')}
    <span class="zy-rt-label">Motivo</span>
    <select id="zyRtReason">
      <option>No me queda / talla incorrecta</option>
      <option>No es lo que esperaba</option>
      <option>Llegó dañado o con defecto</option>
      <option>Recibí una pieza diferente a la pedida</option>
      <option>Otro motivo</option>
    </select>
    <span class="zy-rt-label">Detalles (opcional)</span>
    <textarea id="zyRtDetails" placeholder="Cuéntanos qué pasó para atenderte más rápido"></textarea>
    <div class="zy-rt-actions"><button type="button" class="btn btn-ghost" onclick="zyCloseReturn()">Cancelar</button><button type="button" class="btn btn-primary" onclick="zySubmitReturn()">Enviar solicitud</button></div>`;
  document.getElementById('zyReturnModal').classList.add('open');
};
function returnWaText(rec){
  return `Hola, quiero solicitar la devolución del pedido ${rec.orderNum} (folio ${rec.id}).\nPiezas: ${rec.items.map(i => (i.qty > 1 ? i.qty + '× ' : '') + i.name + (i.size ? ' (talla ' + i.size + ')' : '')).join('; ')}.\nMotivo: ${rec.reason}.${rec.details ? '\nDetalles: ' + rec.details : ''}`;
}
window.zyReturnWhatsApp = function(id){
  const rec = returnsCache.find(r => r.id === id);
  if(!rec) return;
  window.open('https://wa.me/' + ZY_WHATSAPP_NUMBER + '?text=' + encodeURIComponent(returnWaText(rec)), '_blank');
};
window.zySubmitReturn = async function(){
  if(!rtOrder) return;
  const items = physicalItems(rtOrder);
  const picked = [...document.querySelectorAll('#zyReturnBody input[type=checkbox]')].filter(c => c.checked).map(c => items[+c.dataset.i]).filter(Boolean);
  if(!picked.length){ showToast('Elige al menos una pieza', true); return; }
  const id = 'DEV-' + String(rtOrder.orderNum).replace(/[^A-Za-z0-9]/g, '').slice(-6).toUpperCase() + '-' + Date.now().toString(36).slice(-3).toUpperCase();
  const rec = {
    id, orderNum: rtOrder.orderNum, createdAt: Date.now(), status: 'solicitada',
    reason: document.getElementById('zyRtReason').value,
    details: document.getElementById('zyRtDetails').value.trim(),
    items: picked.map(it => ({ id: it.id, name: it.name || '', size: it.size || '', qty: it.qty || 1 })),
    contact: currentUser ? { name: currentUser.name, email: currentUser.email || null } : null
  };
  await loadReturns();
  returnsCache.push(rec);
  try{ await Store.set('zayde:returns:' + userKey(), returnsCache); }catch(e){}
  try{ if(typeof db !== 'undefined' && db) await db.collection('returns').doc(id).set(rec); }
  catch(e){ console.warn('No se pudo registrar la devolución en la nube (revisa reglas de Firestore para "returns"):', e); }
  // aviso en el buzón
  try{
    const list = await zyGetInbox();
    list.push({ id:'ret_' + id, icon:'undo', title:'Devolución solicitada', msg:`Folio ${id} para el pedido ${rec.orderNum}. Te contactaremos por WhatsApp para coordinar.`, date:new Date().toISOString(), read:false, action:{label:'Ver pedido', type:'orders'} });
    await Store.set(inboxKey(), list);
    zyUpdateInboxBadge();
  }catch(e){}
  document.getElementById('zyReturnBody').innerHTML = `
