/* [Aviso automático] Correo al vendedor cuando se publica una pieza suya desde el formulario de producto.
   El servidor no repite el aviso de una pieza que ya notificó, así que editar después no manda más correos.
   Nunca bloquea el guardado: si falla, solo se anota en la consola. */
function zyNotifySellerPiecePublished(p){
  try{
    if(!p || !p.sellerId || typeof window.zySellerEvent !== 'function') return;
    let img = '';
    for(const u of (Array.isArray(p.images) ? p.images : [])){
      const raw = typeof u === 'string' ? u : (u && (u.url || u.src)) || '';
      if(!raw || /^data:/i.test(raw)) continue;
      try{ const abs = new URL(raw, location.href).href; if(/^https:\/\//i.test(abs)){ img = abs; break; } }catch(e){}
    }
    // Se espera un momento para que el producto ya esté guardado en Firestore antes de que el servidor lo lea
    setTimeout(() => {
      window.zySellerEvent({ event:'pieces', sellerId: p.sellerId, productIds:[p.id],
        pieces:[{ id:p.id, name:p.name, brand:p.brand || '', price:p.price || 0, image:img, stock:(p.stock && typeof p.stock === 'object') ? p.stock : {} }] });
    }, 2500);
  }catch(e){ console.warn('[Aviso al vendedor]', e); }
}

