function zyAddCoupon(){
  const codeInput = document.getElementById('zyCouponCode');
  const code = codeInput.value.trim().toUpperCase().replace(/\s+/g,'');
  const type = document.getElementById('zyCouponType').value;
  const rawValue = document.getElementById('zyCouponValue').value;
  const value = type==='freeship' ? 0 : parseFloat(rawValue);
  const singleUse = document.getElementById('zyCouponSingleUse').checked;
  if(!code){ showToast('Ingresa el código del cupón', true); return; }
  if(type!=='freeship' && (isNaN(value) || value<=0)){ showToast('Ingresa un valor de descuento válido', true); return; }
  if(type==='pct' && value>100){ showToast('El porcentaje no puede ser mayor a 100', true); return; }
  // Si se está editando un cupón y se le cambió el código, borra la entrada vieja
  if(zyCouponEditCode !== null && zyCouponEditCode !== code) delete zyCouponsData[zyCouponEditCode];
  if(zyCouponEditCode === null && zyCouponsData[code]){ showToast('Ya existe un cupón con ese código', true); return; }
  // Al editar un cupón de un solo uso ya canjeado, conserva su estado
  // "redeemed" en vez de reactivarlo sin querer.
  const prevRedeemed = (zyCouponEditCode !== null && zyCouponsData[code]) ? !!zyCouponsData[code].redeemed : false;
  zyCouponsData[code] = { type, value, singleUse, redeemed: singleUse ? prevRedeemed : false };
  AdminStore.set('zayde:admin:coupons', zyCouponsData);
  showToast(zyCouponEditCode !== null ? 'Cupón actualizado' : `Cupón ${code} creado`);
  zyCancelEditCoupon();
  zyRenderCouponsAdminList();
}
function zyEditCoupon(code){
  const c = zyCouponsData[code];
  if(!c) return;
  zyCouponEditCode = code;
  document.getElementById('zyCouponCode').value = code;
  document.getElementById('zyCouponType').value = c.type;
  document.getElementById('zyCouponValue').value = c.value;
  document.getElementById('zyCouponSingleUse').checked = !!c.singleUse;
  zyToggleCouponValueField();
  document.getElementById('zyCouponSubmitBtn').textContent = 'Guardar cambios';
  document.getElementById('zyCouponCancelBtn').style.display = '';
  // [UX] Ya no se enfoca el campo automáticamente, para que no salte
  // el teclado del celular solo por entrar a este apartado.
}
function zyCancelEditCoupon(){
  zyCouponEditCode = null;
  document.getElementById('zyCouponCode').value = '';
  document.getElementById('zyCouponType').value = 'pct';
  document.getElementById('zyCouponValue').value = '';
  document.getElementById('zyCouponSingleUse').checked = false;
  zyToggleCouponValueField();
  document.getElementById('zyCouponSubmitBtn').textContent = '+ Crear cupón';
  document.getElementById('zyCouponCancelBtn').style.display = 'none';
}
function zyDeleteCoupon(code){
  delete zyCouponsData[code];
  AdminStore.set('zayde:admin:coupons', zyCouponsData);
  if(zyCouponEditCode === code) zyCancelEditCoupon();
  zyRenderCouponsAdminList();
  showToast(`Cupón ${code} eliminado`);
}

