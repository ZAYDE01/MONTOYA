  zyApplySiteColors();
  AdminStore.set('zayde:admin:homeSettings', zySettings);
  showToast('Colores del sitio actualizados');
}
/* Quita toda personalización y regresa ZAYDE/ZAYDE G a sus colores
   originales, en ambos modos. */
function zyResetSiteColors(){
  zySettings.siteColors = { light:{ bg:'', surface:'', text:'', signal:'', brass:'' }, dark:{ bg:'', surface:'', text:'', signal:'', brass:'' } };
  zySettings.tagColors = {};
  zyApplySiteColors();
  zyPopulateSiteColorInputs();
  AdminStore.set('zayde:admin:homeSettings', zySettings);
  showToast('Colores restablecidos a los originales de ZAYDE');
}


/* ================= [FOTOS Y VIDEOS] Una sola lista ordenable =================
   zyMedia = [{id, t:'i'|'v', u:url|null, key, up:bool, pct:0-100}] en el orden que verá el cliente.
   - Cada archivo nuevo entra YA a la lista como "Subiendo…" y al terminar se llena SU lugar (por id),
     así nunca se duplica ni se pisa con otra subida que vaya al mismo tiempo.
   - El mismo archivo no se agrega dos veces (nombre+tamaño+fecha).
   - Las fotos pesadas del celular se reducen antes de subir (el servidor acepta máx. 3 MB).
   - Máx. 2 subidas a la vez; el input se limpia de inmediato (evita el doble "change" de algunos celulares).
   zyUploadedImages / zyUploadedVideos se derivan de zyMedia (otras partes del código las siguen leyendo). */
const ZY_MAX_PRODUCT_IMAGES = 8;
const ZY_MAX_PRODUCT_VIDEOS = 4;
let zyMedia = [];
let zyMediaSeq = 0;
function zySyncMediaArrays(){
  zyUploadedImages = zyMedia.filter(m=>m.t==='i' && m.u && !m.up).map(m=>m.u);
  zyUploadedVideos = zyMedia.filter(m=>m.t==='v' && m.u && !m.up).map(m=>m.u);
}
function zyMediaFromProduct(p){
  const imgs = (p.images || []).filter(Boolean), vids = (p.videos || []).filter(Boolean);
  const order = zyNormalizeMediaOrder(p.mediaOrder, imgs.length, vids.length);
  let i = 0, v = 0;
  return order.map(t=> t==='v' ? {id:++zyMediaSeq, t:'v', u:vids[v++], key:'', up:false, pct:100}
                               : {id:++zyMediaSeq, t:'i', u:imgs[i++], key:'', up:false, pct:100});
}
/* Lo que se guarda: fotos (tope = imageCount), videos y el orden mezclado. */
function zyBuildMediaOut(imageCount){
  const images = [], videos = [], order = [];
  zyMedia.forEach(m=>{
    if(m.up || !m.u) return;
    if(m.t === 'i'){ if(images.length < imageCount){ images.push(m.u); order.push('i'); } }
    else { videos.push(m.u); order.push('v'); }
  });
  return { images, videos, order };
}
function zyRenderMediaThumbs(){
  zySyncMediaArrays();
  const box = document.getElementById('zyMediaThumbs');
  if(!box) return;
  const last = zyMedia.length - 1;
  box.innerHTML = zyMedia.map((m, pos)=>{
    const n = `<span class="zy-thumb-n">${pos+1}</span>`;
    if(m.up){
      return `<div class="zy-thumb" data-id="${m.id}">${n}<div class="zy-thumb-up">${m.t==='v'?'Video':'Foto'}<i><b style="width:${m.pct||0}%"></b></i>${m.pct?m.pct+'%':'Subiendo…'}</div><button type="button" class="zy-thumb-x" title="Cancelar" onclick="zyRemoveMedia(${m.id})">×</button></div>`;
    }
    const media = m.t === 'v'
      ? `<video src="${zyEscapeHtml(m.u)}#t=0.1" muted playsinline preload="metadata" style="width:100%;height:100%;object-fit:cover;display:block;"></video><span class="zy-thumb-v">▶</span>`
      : `<img src="${zyEscapeHtml(m.u)}" alt="Vista previa" draggable="false">`;
    return `<div class="zy-thumb" draggable="true" data-id="${m.id}" title="Arrástrala para cambiar de lugar">${media}${n}`
      + `<button type="button" class="zy-thumb-x" title="Quitar" onclick="zyRemoveMedia(${m.id})">×</button>`
      + (pos>0 ? `<button type="button" class="zy-thumb-mv l" title="Mover antes" onclick="zyMoveMedia(${m.id},-1)">◀</button>` : '')
      + (pos<last ? `<button type="button" class="zy-thumb-mv r" title="Mover después" onclick="zyMoveMedia(${m.id},1)">▶</button>` : '')
      + `</div>`;
  }).join('');
  const nI = zyMedia.filter(m=>m.t==='i').length, nV = zyMedia.filter(m=>m.t==='v').length;
  const c = document.getElementById('zyMediaCount');
  if(c) c.textContent = `${nI} foto${nI===1?'':'s'} (máx. ${ZY_MAX_PRODUCT_IMAGES}) y ${nV} video${nV===1?'':'s'} (máx. ${ZY_MAX_PRODUCT_VIDEOS})`;
  const ic = document.getElementById('zyImageCount');
  if(ic && !ic.dataset.touched && nI > 0){ ic.value = Math.min(ZY_MAX_PRODUCT_IMAGES, nI); }
}
function zyRemoveMedia(id){
  const m = zyMedia.find(x=>x.id===id);
  if(m) m.cancelled = true;
  zyMedia = zyMedia.filter(x=>x.id!==id);
  zyRenderMediaThumbs();
}
function zyMoveMedia(id, dir){
  const i = zyMedia.findIndex(x=>x.id===id), j = i + dir;
  if(i < 0 || j < 0 || j >= zyMedia.length) return;
  const [it] = zyMedia.splice(i, 1);
  zyMedia.splice(j, 0, it);
  zyRenderMediaThumbs();
}
/* Arrastrar y soltar (computadora). En celular se usan las flechas ◀ ▶. */
(function zyInitMediaDrag(){
  let dragId = null;
  function boot(){
    const box = document.getElementById('zyMediaThumbs');
    if(!box || box.__dnd) return; box.__dnd = true;
    box.addEventListener('dragstart', e=>{
      const t = e.target.closest && e.target.closest('.zy-thumb'); if(!t) return;
      dragId = +t.dataset.id; t.classList.add('dragging');
      try{ e.dataTransfer.effectAllowed = 'move'; e.dataTransfer.setData('text/plain', String(dragId)); }catch(_){}
    });
    box.addEventListener('dragover', e=>{
      if(dragId == null) return; e.preventDefault();
      box.querySelectorAll('.drop-target').forEach(n=>n.classList.remove('drop-target'));
      const t = e.target.closest && e.target.closest('.zy-thumb'); if(t && +t.dataset.id !== dragId) t.classList.add('drop-target');
    });
    box.addEventListener('drop', e=>{
      if(dragId == null) return; e.preventDefault();
      const t = e.target.closest && e.target.closest('.zy-thumb');
      const from = zyMedia.findIndex(x=>x.id===dragId);
      let to = t ? zyMedia.findIndex(x=>x.id===+t.dataset.id) : zyMedia.length - 1;
      if(from > -1 && to > -1 && from !== to){ const [it] = zyMedia.splice(from, 1); zyMedia.splice(to, 0, it); }
      dragId = null; zyRenderMediaThumbs();
    });
    box.addEventListener('dragend', ()=>{ dragId = null; zyRenderMediaThumbs(); });
  }
  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
})();

/* Cola: máx. 2 subidas a la vez. */
const zyUpQueue = []; let zyUpActive = 0;
function zyUpPump(){
  while(zyUpActive < 2 && zyUpQueue.length){
    const job = zyUpQueue.shift(); zyUpActive++;
    Promise.resolve().then(job).catch(()=>{}).finally(()=>{ zyUpActive--; zyUpPump(); });
  }
}
function zyDataUrlToFile(dataUrl, name){
  const parts = dataUrl.split(','); const mime = (parts[0].match(/:(.*?);/)||[])[1] || 'image/jpeg';
  const bin = atob(parts[1]); const u8 = new Uint8Array(bin.length);
  for(let i=0;i<bin.length;i++) u8[i] = bin.charCodeAt(i);
  return new File([u8], name, {type: mime});
}
/* Fotos grandes del celular → se reducen para entrar en el límite de 3 MB del servidor. */
async function zyShrinkIfNeeded(file){
  if(file.size <= 2.4 * 1024 * 1024) return file;
  const base = (file.name || 'foto').replace(/\.[^.]+$/, '') + '.jpg';
  for(const [w, q] of [[2000, .85], [1600, .78], [1200, .7]]){
    const out = zyDataUrlToFile(await zyCompressImageFile(file, w, q), base);
    if(out.size <= 2.9 * 1024 * 1024) return out;
  }
  throw new Error('La foto es demasiado pesada aun reducida — usa una más ligera.');
}
const zyFileKey = f => `${f.name}|${f.size}|${f.lastModified}`;
const zyIsVideoFile = f => (f.type && f.type.startsWith('video/')) || /\.(mp4|mov|webm|m4v|avi|mkv|3gp|ogv)$/i.test(f.name || '');
const zyIsImageFile = f => (f.type && f.type.startsWith('image/')) || /\.(jpe?g|png|webp|gif|avif|heic|heif)$/i.test(f.name || '');

function zyPreviewMedia(){
  const input = document.getElementById('zyMediaInput');
  const files = Array.from(input.files || []);
  input.value = ''; // se limpia YA: evita el doble "change" y permite volver a elegir el mismo archivo
  if(!files.length) return;
  let nI = zyMedia.filter(m=>m.t==='i').length, nV = zyMedia.filter(m=>m.t==='v').length;
  let skippedDup = 0, skippedMax = 0, skippedType = 0;
  const added = [];
  files.forEach(f=>{
    const key = zyFileKey(f);
    if(zyMedia.some(m=>m.key === key)){ skippedDup++; return; }
    const isV = zyIsVideoFile(f), isI = !isV && zyIsImageFile(f);
    if(!isV && !isI){ skippedType++; return; }
    if(isV && nV >= ZY_MAX_PRODUCT_VIDEOS){ skippedMax++; return; }
    if(isI && nI >= ZY_MAX_PRODUCT_IMAGES){ skippedMax++; return; }
    if(isV) nV++; else nI++;
    const item = { id: ++zyMediaSeq, t: isV ? 'v' : 'i', u: null, key, up: true, pct: 0 };
    zyMedia.push(item); added.push([item, f]);
  });
  if(skippedDup) showToast(`${skippedDup} archivo${skippedDup>1?'s':''} ya estaba${skippedDup>1?'n':''} agregado${skippedDup>1?'s':''} — no se repite.`, true);
  if(skippedMax) showToast(`Máximo ${ZY_MAX_PRODUCT_IMAGES} fotos y ${ZY_MAX_PRODUCT_VIDEOS} videos por producto — quita alguno antes de agregar más.`, true);
  if(skippedType) showToast('Algún archivo no es foto ni video y se omitió.', true);
  zyRenderMediaThumbs();
  added.forEach(([item, f])=> zyUpQueue.push(()=> zyUploadOne(item, f)));
  zyUpPump();
}
async function zyUploadOne(item, file){
  try{
    let url;
    if(item.t === 'v'){
      url = await zyUploadVideoFile(file, frac=>{
        item.pct = Math.min(99, Math.round(frac * 100));
        const b = document.querySelector(`#zyMediaThumbs .zy-thumb[data-id="${item.id}"] .zy-thumb-up`);
        if(b){ b.querySelector('b').style.width = item.pct + '%'; b.lastChild.textContent = item.pct + '%'; }
      });
    } else {
      const hint = `${(document.getElementById('zyBrand')?.value||'').trim()} ${(document.getElementById('zyName')?.value||'').trim()}`.trim();
      const small = await zyShrinkIfNeeded(file);
      url = await zyUploadImageFile(small, 'products', hint);
    }
    if(item.cancelled) return; // el admin la quitó mientras subía
    if(zyMedia.some(m=>m !== item && m.u === url && !m.up)){ // misma URL ya presente → no duplicar
      zyMedia = zyMedia.filter(m=>m !== item);
    } else { item.u = url; item.up = false; item.pct = 100; }
  }catch(e){
    console.error('No se pudo subir el archivo del producto:', e);
    if(!item.cancelled) showToast(`No se pudo subir ${item.t==='v'?'el video':'la foto'}: ` + (e.message || 'error desconocido'), true);
    zyMedia = zyMedia.filter(m=>m !== item);
  }
  zyRenderMediaThumbs();
}
function zyAddProductVideoUrl(){
  const input = document.getElementById('zyVideoUrl');
  const url = (input.value || '').trim();
  if(!url) return;
  const looksVideo = /^https:\/\//i.test(url) && (/\.(mp4|webm|mov|m4v|ogv)(\?|#|$)/i.test(url) || /\/video\/upload\//i.test(url));
  if(!looksVideo){ showToast('Pega el enlace directo (https) de un archivo de video: .mp4, .webm o .mov', true); return; }
  if(zyMedia.filter(m=>m.t==='v').length >= ZY_MAX_PRODUCT_VIDEOS){ showToast(`Máximo ${ZY_MAX_PRODUCT_VIDEOS} videos por producto.`, true); return; }
  if(zyMedia.some(m=>m.u === url)){ showToast('Ese video ya está agregado.', true); return; }
  zyMedia.push({ id: ++zyMediaSeq, t:'v', u:url, key:'', up:false, pct:100 });
  input.value = '';
  zyRenderMediaThumbs();
}
