  function zyFixReturnDays(v){
    if(typeof v === 'string'){
      if(!/devol|return|reembols|refund/i.test(v)) return v;
      return v.replace(/\b14(\s+d[ií]as|\s+calendar\s+days|\s+days|-calendar-day|-day)/gi, '5$1');
