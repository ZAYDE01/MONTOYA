/* ============================================================
   [FIX SCROLL DE FONDO] Antes, al abrir un panel (checkout,
   carrito, login, políticas, zoom, etc.) la página de atrás
   seguía moviéndose con la rueda del mouse o el dedo, aunque
   visualmente el usuario estuviera "dentro" del panel — solo el
   zoom de fotos bloqueaba el scroll del fondo.

   Esta función detecta automáticamente CUALQUIER panel/overlay
   que se abra (buscando la clase "open" en los overlays reales
   del sitio) y congela el body mientras esté abierto, para que
   el scroll hacia abajo/arriba se quede dentro del panel activo
   y no en el fondo. No hace falta tocar cada función de apertura
   una por una: funciona para los paneles actuales y para
   cualquiera que se agregue después con este mismo patrón.
   ============================================================ */
(function(){
  var LOCK_SELECTOR = '.overlay.open, .cart-drawer.open, .checkout-modal.open, .zoom-lightbox.open, .zy-modal.open, .nl-overlay.open, .nl-popup.open, .share-sheet-overlay.open, .share-sheet.open';
  var savedScrollY = 0;
  var locked = false;

  function lockBodyScroll(){
    if(locked) return;
    locked = true;
    savedScrollY = window.scrollY || window.pageYOffset || 0;
    document.body.style.position = 'fixed';
    document.body.style.top = (-savedScrollY) + 'px';
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.style.width = '100%';
    // [FIX chatbot tapa contenido] ver regla body.zy-panel-open .zybot-float en el CSS
    document.body.classList.add('zy-panel-open');
  }

  function unlockBodyScroll(){
    if(!locked) return;
    locked = false;
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    document.body.style.width = '';
    window.scrollTo(0, savedScrollY);
    document.body.classList.remove('zy-panel-open');
  }

  function syncScrollLock(){
    var anyOpen = document.querySelector(LOCK_SELECTOR);
    if(anyOpen){ lockBodyScroll(); } else { unlockBodyScroll(); }
  }

  var zyScrollLockObserver = new MutationObserver(syncScrollLock);
  zyScrollLockObserver.observe(document.body, {
    attributes: true,
    attributeFilter: ['class'],
    subtree: true
  });

  // [FIX "se queda congelada la sección"] Si por cualquier motivo un panel
  // se cierra sin que su clase "open" se quite del todo (ej. un error a
  // mitad de una función de cierre), el body se queda con position:fixed
  // para siempre — se ve como que toda la página se "congeló" y no deja
  // moverse a otra sección, aunque los botones sigan ahí. zySyncScrollLock
  // queda expuesta para poder forzar una revisión desde otros puntos
  // clave del sitio (como navigate(), justo antes de cambiar de página)
  // en vez de depender solo del observer.
  window.zySyncScrollLock = syncScrollLock;

  // Revisión inicial por si algún panel ya viene abierto al cargar
  syncScrollLock();

  // [FIX "se queda congelada la sección" — red de seguridad] Hasta ahora,
  // liberar el candado dependía de que CADA función que pudiera dejar la
  // página trabada (removeFromCart, navigate, etc.) llamara a mano a
  // zySyncScrollLock() en el momento justo. Si aparecía un flujo nuevo que
  // no lo hiciera, o un error a la mitad de una función interrumpía el
  // código ANTES de llegar a esa línea, el candado se quedaba puesto para
  // siempre y el sitio dejaba de responder a clics aunque nada se viera
  // "abierto" en pantalla.
  //
  // Estas dos redes de seguridad cubren justo esos casos sin depender de
  // encontrar cada causa una por una:
  //
  // 1) Un watchdog que revisa cada 1.5s si el body sigue "congelado"
  //    (position:fixed) aunque ya no haya ningún panel realmente abierto
  //    que lo justifique — y si es así, lo libera solo. Esto también cubre
  //    el caso en que un panel con clase "open" se elimina de golpe del DOM
  //    (ej. al repintar con innerHTML) en vez de quitársele la clase: el
  //    MutationObserver de arriba solo mira cambios de atributo "class", no
  //    nodos que desaparecen enteros, así que sin este watchdog ese caso no
  //    se detectaría hasta la siguiente navegación manual.
  // 2) Si CUALQUIER error de JavaScript no capturado ocurre en cualquier
  //    parte del sitio (o una promesa rechazada sin .catch), se fuerza una
  //    revisión del candado de inmediato — así un error inesperado en una
  //    función que ni siquiera es de carrito/paneles no puede dejar el
  //    resto del sitio sin responder a clics.
  setInterval(syncScrollLock, 1500);
  window.addEventListener('error', function(){ try{ syncScrollLock(); }catch(e){} });
  window.addEventListener('unhandledrejection', function(){ try{ syncScrollLock(); }catch(e){} });
})();
</script>
