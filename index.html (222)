}
/* Todas las tallas posibles disponibles para click según la sección elegida.
   Para Zapatos se muestra la unión de tallas de todos los géneros. */
function zySizeOptionsFor(section){
  if(section==='Zapatos'){
    return [...new Set(Object.values(SNEAKER_SIZES_BY_GENDER).flat())].sort((a,b)=>a-b).map(String);
  }
  if(section==='Perfumes') return PERFUME_ML_SIZES.slice();
  return (CAT_SIZES[section] || ['Única']).slice();
