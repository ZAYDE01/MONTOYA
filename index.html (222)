/* ============================================================
   [TEXTOS] Sistema de edición de textos del sitio desde el panel privado.
   Cualquier elemento con data-zt="clave" es un texto editable. El texto
   que ya trae el HTML es el valor "por defecto"; los cambios se guardan
   como overrides {clave: texto} en AdminStore y se aplican sobre el DOM
   al cargar la página. data-zg agrupa los campos por sección para el panel.
   ============================================================ */
let zyTextOverrides = {};
// Defaults y grupos se calculan UNA sola vez a partir del HTML original,
// antes de aplicar overrides, para que "Restablecer" siempre funcione bien.
const ZY_TEXT_DEFAULTS = {};
const ZY_TEXT_GROUPS = {};
document.querySelectorAll('[data-zt]').forEach(el=>{
  const key = el.getAttribute('data-zt');
  if(!(key in ZY_TEXT_DEFAULTS)){
    ZY_TEXT_DEFAULTS[key] = el.textContent;
    ZY_TEXT_GROUPS[key] = el.getAttribute('data-zg') || 'General';
  }
});
