function zyEscapeHtml(s){
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
/* ============================================================
   [TEXTOS-DINÁMICOS] ZY_TEXT_DEFAULTS/ZY_TEXT_GROUPS solo se llenan
   una vez, escaneando el HTML que YA existe al cargar la página — así
   que nunca ven el texto de vistas que se dibujan después con JS (p.
   ej. "Mi cuenta", el ZAYDE ID o el Buzón). zyT(key, textoOriginal)
   registra esa clave la primera vez que se usa (para que aparezca en
   el panel de Textos del sitio) y devuelve el override guardado si el
   cliente admin ya lo editó, o el texto original si no.
   ============================================================ */
function zyT(key, fallback, group){
  if(!(key in ZY_TEXT_DEFAULTS)){
    ZY_TEXT_DEFAULTS[key] = fallback;
    ZY_TEXT_GROUPS[key] = group || 'Mi cuenta';
  }
  return zyTextOverrides.hasOwnProperty(key) ? zyTextOverrides[key] : fallback;
}
function zyTSpan(key, fallback, group){
  return `<span data-zt="${key}" data-zg="${zyEscapeHtml(group||'Mi cuenta')}">${zyEscapeHtml(zyT(key, fallback, group))}</span>`;
}
function zyApplyTextOverrides(){
  Object.keys(zyTextOverrides).forEach(key=>{
    const val = zyTextOverrides[key];
    if(val===undefined || val===null) return;
    document.querySelectorAll('[data-zt]').forEach(el=>{ if(el.getAttribute('data-zt')===key) el.textContent = val; });
  });
}
function zySaveTextOverride(key, value){
  zyTextOverrides[key] = value;
  document.querySelectorAll('[data-zt]').forEach(el=>{ if(el.getAttribute('data-zt')===key && el.textContent!==value) el.textContent = value; });
  AdminStore.set('zayde:admin:texts', zyTextOverrides);
}
function zyResetTextOverride(key){
  delete zyTextOverrides[key];
  const defaultText = ZY_TEXT_DEFAULTS[key] || '';
  document.querySelectorAll('[data-zt]').forEach(el=>{ if(el.getAttribute('data-zt')===key) el.textContent = defaultText; });
  AdminStore.set('zayde:admin:texts', zyTextOverrides);
}
