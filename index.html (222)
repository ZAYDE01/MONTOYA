/* [NUEVO] El admin agrega a mano a quien le pidió por WhatsApp o en
   persona que le avise del próximo Drop. Escribe en la colección PÚBLICA
   dropSubscribers (no en AdminStore/admin_meta — ver el comentario de
   arriba para el porqué). */
async function zyAdminAddDropSubscriber(){
  const nameEl = document.getElementById('zyDropSubName');
  const phoneEl = document.getElementById('zyDropSubPhone');
  const emailEl = document.getElementById('zyDropSubEmail');
  const name = nameEl ? nameEl.value.trim() : '';
  const phone = phoneEl ? phoneEl.value.trim() : '';
  const email = emailEl ? emailEl.value.trim() : '';
  if(!email && !phone){ showToast('Escribe al menos un correo o un WhatsApp', true); return; }
  if(email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ showToast('Ese correo no se ve válido', true); return; }
  if(typeof db === 'undefined' || !db){ showToast('Firebase no está configurado', true); return; }
  const docId = email ? encodeURIComponent(email.toLowerCase()) : ('tel-'+phone.replace(/\D/g,''));
  try{
    await db.collection('dropSubscribers').doc(docId).set({ name, phone, email, date: Date.now() }, { merge:true });
    if(nameEl) nameEl.value = '';
    if(phoneEl) phoneEl.value = '';
    if(emailEl) emailEl.value = '';
    showToast('Agregado a la lista de aviso del Drop');
    zyRenderDropSubscribers();
  }catch(e){ console.error('No se pudo agregar el suscriptor del Drop:', e); showToast('No se pudo guardar', true); }
}
async function zyClearDropSubscribers(){
  if(typeof db === 'undefined' || !db) return;
  try{
    const snap = await db.collection('dropSubscribers').get();
    const batch = db.batch();
    snap.forEach(doc=>batch.delete(doc.ref));
    await batch.commit();
  }catch(e){ console.error('No se pudo vaciar la lista de suscriptores del Drop:', e); }
}
/* Avisa por correo, uno por uno, a todos los que se registraron pidiendo
   que les avisáramos del próximo Drop en vivo — usa /api/send-drop-email
   (mismo backend de Resend que ya usas para los correos de pedidos, solo
   con una plantilla distinta). Se manda de a un correo por llamada, con
   una pequeña pausa entre cada uno para no saturar la API. Al terminar,
   pregunta si quieres vaciar la lista para el próximo Drop. */
async function zyNotifyDropSubscribersByEmail(){
  const withEmail = await zyGetDropEmailRecipients();
  if(!withEmail.length){ showToast('Todavía no hay ningún correo (ni en la lista del Drop ni en el newsletter)', true); return; }
  if(!confirm(`Se enviará el aviso de "Drop en vivo" por correo a ${withEmail.length} persona${withEmail.length===1?'':'s'}. ¿Confirmas?`)) return;

  const btn = document.getElementById('zyDropEmailBtn');
  if(btn){ btn.disabled = true; btn.textContent = 'Enviando…'; }

  let sent = 0, failed = 0;
  for(const s of withEmail){
    try{
      const res = await fetch('/api/send-email', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ type: 'drop', to: s.email, name: s.name, dropText: zySettings.dropText })
      });
      if(res.ok) sent++; else failed++;
    }catch(e){ failed++; }
    await new Promise(r=>setTimeout(r, 350)); // pausa breve entre envíos
  }

  if(btn){ btn.disabled = false; btn.textContent = 'Avisar a todos por correo que ya inició'; }
  showToast(`Correos enviados: ${sent}${failed ? ` · fallaron: ${failed}` : ''}`);

  if(sent > 0 && confirm('¿Quieres vaciar la lista de suscriptores agregados a mano para el próximo Drop? (Los correos del newsletter NO se borran)')){
    try{
      await zyClearDropSubscribers();
      zyRenderDropSubscribers();
    }catch(e){ console.error('No se pudo vaciar la lista de suscriptores:', e); }
  }
}
/* [PEDIDO CLIENTE] Versión automática (sin confirm ni botón) de la función
   de arriba — la dispara updateDropCountdown() solo, justo cuando el Drop
   pasa a estar en vivo, para que cada quien reciba su correo sin que el
   admin tenga que entrar al panel y tocar "Avisar a todos por correo".
   Usa la MISMA plantilla/endpoint (type:'drop' en /api/send-email, Gmail
   por backend) así que basta con tener GMAIL_USER/GMAIL_APP_PASSWORD
   configurados en Vercel para que ya funcione. No vacía la lista al
   terminar — eso lo sigue haciendo el admin a mano si quiere, por si
   alguien quedó sin correo o hubo un error de red a mitad del envío. */
async function zyAutoNotifyDropLiveByEmail(){
  const withEmail = await zyGetDropEmailRecipients();
  if(!withEmail.length){ console.log('[Drop en vivo] Nadie a quién avisar por correo todavía (ni en la lista del Drop ni en el newsletter).'); return; }
  let sent = 0, failed = 0;
  for(const s of withEmail){
    try{
      const res = await fetch('/api/send-email', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ type: 'drop', to: s.email, name: s.name, dropText: zySettings.dropText })
      });
      if(res.ok) sent++; else failed++;
    }catch(e){ failed++; }
    await new Promise(r=>setTimeout(r, 350)); // pausa breve entre envíos, igual que el aviso manual
  }
  console.log(`[Drop en vivo] Aviso automático por correo: ${sent} enviados, ${failed} fallidos.`);
}
/* Avisa por notificación push a todos los dispositivos que la activaron
   (colección push_subscriptions en Firestore) — llama a /api/send-push
   una vez por dispositivo, igual patrón que el aviso por correo. Si una
   suscripción ya venció (410), se borra sola de Firestore para no
   seguir intentando en vano la próxima vez. */
async function zyNotifyDropSubscribersByPush(){
  if(!db){ showToast('Las notificaciones push necesitan Firestore activo.', true); return; }
  const btn = document.getElementById('zyDropPushBtn');
  let snap;
  try{ snap = await db.collection('push_subscriptions').get(); }
  catch(e){ showToast('No se pudo leer la lista de dispositivos suscritos.', true); return; }
  if(snap.empty){ showToast('Todavía nadie activó notificaciones push', true); return; }
  if(!confirm(`Se enviará la notificación push a ${snap.size} dispositivo${snap.size===1?'':'s'}. ¿Confirmas?`)) return;

  if(btn){ btn.disabled = true; btn.textContent = 'Enviando…'; }
  let sent = 0, failed = 0;
  for(const doc of snap.docs){
    try{
      const res = await fetch('/api/send-push', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify({
          subscription: doc.data().subscription,
          title: `${zySettings.dropText}`,
          body: '¡Ya comenzó! Entra ahora antes de que se agoten las piezas.',
          url: '/'
        })
      });
      if(res.ok) sent++;
      else{
        failed++;
        if(res.status === 410){ try{ await doc.ref.delete(); }catch(e){} } // suscripción vencida, se limpia sola
      }
    }catch(e){ failed++; }
    await new Promise(r=>setTimeout(r, 200));
  }
  if(btn){ btn.disabled = false; btn.textContent = 'Avisar a todos por notificación push que ya inició'; }
  showToast(`Notificaciones enviadas: ${sent}${failed ? ` · fallaron: ${failed}` : ''}`);
}
