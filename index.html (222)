<script>
/* ================= [VENDEDORES] Panel admin: alta y gestión =================
   Colección Firestore "sellers/{uid}". El uid es el de su cuenta de Firebase
   Auth, que se crea desde aquí con una app secundaria para NO cerrar la
   sesión del admin. Nunca se borra un vendedor: se pausa (status:'pausado'). */
(function(){
  const $ = id => document.getElementById(id);
  const esc = s => (typeof zyEscapeHtml === 'function') ? zyEscapeHtml(String(s == null ? '' : s)) : String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  let sellers = [];

  function msg(text, ok){
    const m = $('zvMsg'); if(!m) return;
    m.textContent = text; m.className = 'zv-msg show ' + (ok ? 'ok' : 'err');
    clearTimeout(msg._t); msg._t = setTimeout(() => { m.className = 'zv-msg'; }, ok ? 6000 : 12000);
  }
  function needDb(){
    if(typeof db === 'undefined' || !db){ msg('Firestore no está disponible. Entra al panel con tu cuenta de administrador y recarga.', false); return false; }
    return true;
  }
  function friendlyErr(e){
    const c = (e && e.code) || '';
    if(c === 'permission-denied') return 'Firestore no te dejó escribir. Falta publicar las reglas nuevas (archivo firestore.rules) en Firebase > Firestore Database > Reglas, o no iniciaste sesión como admin.';
    if(c === 'auth/email-already-in-use') return 'Ese correo ya tiene una cuenta y no se pudo vincular.';
    if(c === 'auth/invalid-email') return 'El correo no es válido.';
    if(c === 'auth/operation-not-allowed') return 'En Firebase > Authentication activa el acceso por "Correo/contraseña".';
    if(c === 'auth/too-many-requests') return 'Firebase pidió esperar un momento. Intenta de nuevo en unos minutos.';
    return (e && (e.message || e.code)) || String(e);
  }
  function randomPass(){
    const a = new Uint8Array(18); crypto.getRandomValues(a);
    return 'Zy-' + Array.from(a, b => b.toString(36).padStart(2, '0')).join('').slice(0, 22) + '!9a';
  }
  // Crea la cuenta en una app SECUNDARIA para no tocar la sesión del admin
  async function createSellerAuth(email){
    const app2 = firebase.initializeApp(FIREBASE_CONFIG, 'zv-' + Date.now());
    try{
      const auth2 = app2.auth();
      const cred = await auth2.createUserWithEmailAndPassword(email, randomPass());
      const uid = cred.user.uid;
      // El correo de bienvenida (con el enlace para elegir contraseña) lo manda el servidor con el diseño de ZAYDE
      // al guardar la ficha del vendedor (ver zvSaveSeller). Si ese correo falla, se usa el estándar de Firebase como respaldo.
      try{ await auth2.signOut(); }catch(e){}
      return { uid, mailErr: null };
    } finally { try{ await app2.delete(); }catch(e){} }
  }

  // Pide a /api/find-user-by-email el UID de una cuenta que ya existe. El
  // servidor verifica que quien pregunta sea admin (token de Firebase +
  // documento en "admins"); a cualquier otra persona le responde 401/403.
  async function findUidByEmail(email){
    const user = firebase.auth().currentUser;
    if(!user) throw new Error('Tu sesión de administrador no está activa en Firebase. Cierra sesión del panel y vuelve a entrar.');
    const token = await user.getIdToken();
    let r;
    try{
      r = await fetch('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type':'application/json', 'Authorization':'Bearer ' + token },
        body: JSON.stringify({ type:'find-user', email })
      });
    }catch(e){ throw new Error('No se pudo contactar al servidor para vincular esa cuenta.'); }
    const out = await r.json().catch(() => ({}));
    if(r.ok && out.uid) return out.uid;
    if(r.status === 404) throw new Error('Ese correo figura como ya registrado pero no se encontró la cuenta. Intenta de nuevo en un momento.');
    if(r.status === 401 || r.status === 403) throw new Error('El servidor no reconoció tu sesión de administrador. Cierra sesión del panel y vuelve a entrar.');
    throw new Error('No se pudo vincular la cuenta existente (error ' + r.status + '). Sube la versión nueva de api/send-email.js y vuelve a intentar.');
  }

  window.zvResetForm = function(){
    ['zvEditId','zvName','zvEmail','zvPhone','zvCommission','zvCategories','zvPayout'].forEach(id => { if($(id)) $(id).value = ''; });
    $('zvEmail').disabled = false;
    $('zvEmailHint').textContent = 'Con este entra a su portal';
    $('zvFormTitle').textContent = 'Nuevo vendedor';
    $('zvFormSub').textContent = 'Se crea su cuenta con una contraseña temporal aleatoria y se le envía un correo para que él elija la suya. Tú nunca ves su contraseña.';
    $('zvSaveBtn').textContent = '+ Crear vendedor y enviar correo';
    $('zvSaveBtn').disabled = false;
    $('zvCancelBtn').style.display = 'none';
  };

  window.zvLoadSellers = async function(){
    const list = $('zvList'); if(!list) return;
    if(typeof db === 'undefined' || !db){ list.innerHTML = '<div class="zv-empty">Firestore no está disponible todavía.</div>'; return; }
    try{
      const snap = await db.collection('sellers').get();
      sellers = snap.docs.map(d => Object.assign({ id: d.id }, d.data()))
        .sort((a,b) => String(a.name||'').localeCompare(String(b.name||'')));
      if(typeof zySellersLoaded !== 'undefined'){ zySellersLoaded = false; } // el selector de productos se vuelve a llenar
      zvRender();
    }catch(e){
      list.innerHTML = '<div class="zv-empty">No se pudo leer la lista. ' + esc(friendlyErr(e)) + '</div>';
    }
  };

  function zvRender(){
    const list = $('zvList');
    $('zvCount').textContent = sellers.length ? '(' + sellers.length + ')' : '';
    zvRenderNoticeSelect();
    if(!sellers.length){ list.innerHTML = '<div class="zv-empty">Todavía no hay vendedores. Crea el primero arriba.</div>'; return; }
    list.innerHTML = sellers.map(x => {
      const on = x.status !== 'pausado';
      const comm = (x.commissionPct == null || x.commissionPct === '') ? 'tabla de Reventa' : x.commissionPct + '%';
      return '<div class="zv-row">' +
        '<div class="zv-row-top"><span class="zv-name">' + esc(x.name || '(sin nombre)') + '</span><span class="zv-badge ' + (on ? 'on' : 'off') + '">' + (on ? 'Activo' : 'Pausado') + '</span></div>' +
        '<div class="zv-meta">' + esc(x.email || '') + (x.phone ? ' · ' + esc(x.phone) : '') + '<br>Comisión: <b>' + esc(comm) + '</b>' + (x.categories ? ' · ' + esc(x.categories) : '') + '</div>' +
        '<div class="zv-actions">' +
          '<button type="button" onclick="zvEdit(\'' + esc(x.id) + '\')">Editar</button>' +
          '<button type="button" onclick="zvToggle(\'' + esc(x.id) + '\')">' + (on ? 'Pausar' : 'Activar') + '</button>' +
          '<button type="button" onclick="zvResend(\'' + esc(x.id) + '\')">Reenviar correo</button>' +
          (on ? '<button type="button" onclick="zvNoticeTo(\'' + esc(x.id) + '\')">Enviar aviso</button>' : '') +
        '</div></div>';
    }).join('');
  }

  window.zvEdit = function(id){
    const x = sellers.find(v => v.id === id); if(!x) return;
    $('zvEditId').value = id;
    $('zvName').value = x.name || '';
    $('zvEmail').value = x.email || ''; $('zvEmail').disabled = true;
    $('zvEmailHint').textContent = 'No se puede cambiar (es su acceso)';
    $('zvPhone').value = x.phone || '';
    $('zvCommission').value = (x.commissionPct == null ? '' : x.commissionPct);
    $('zvCategories').value = x.categories || '';
    $('zvPayout').value = x.payout || '';
    $('zvFormTitle').textContent = 'Editar vendedor';
    $('zvFormSub').textContent = 'Cambia sus datos o comisión. No se envía ningún correo al guardar.';
    $('zvSaveBtn').textContent = 'Guardar cambios';
    $('zvCancelBtn').style.display = '';
    $('zvName').scrollIntoView({ behavior:'smooth', block:'center' });
  };

  window.zvSaveSeller = async function(){
    if(!needDb()) return;
    const editId = $('zvEditId').value;
    const name = $('zvName').value.trim();
    const email = $('zvEmail').value.trim().toLowerCase();
    const commRaw = $('zvCommission').value.trim();
    const commissionPct = commRaw === '' ? null : Math.max(0, Math.min(100, parseFloat(commRaw)));
    if(!name){ msg('Escribe el nombre del vendedor.', false); $('zvName').focus(); return; }
    if(!editId && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)){ msg('Escribe un correo válido.', false); $('zvEmail').focus(); return; }
    if(commRaw !== '' && !isFinite(commissionPct)){ msg('La comisión debe ser un número entre 0 y 100.', false); return; }
    const data = {
      name, phone: $('zvPhone').value.trim(), commissionPct,
      categories: $('zvCategories').value.trim(), payout: $('zvPayout').value.trim(),
      updatedAt: Date.now()
    };
    const btn = $('zvSaveBtn'); const label = btn.textContent;
    btn.disabled = true; btn.textContent = 'Guardando…';
    try{
      if(editId){
        await db.collection('sellers').doc(editId).set(data, { merge:true });
        msg('Cambios guardados.', true);
      } else {
        let uid, mailErr = null, linked = false;
        try{
          ({ uid, mailErr } = await createSellerAuth(email));
        }catch(e){
          // El correo ya tiene cuenta (por ejemplo, un cliente de ZAYDE, o un
          // intento anterior que no alcanzó a guardar la ficha): se vincula
          // esa misma cuenta. El acceso al portal lo decide la ficha en
          // "sellers", no la cuenta, así que sigue siendo cliente y además vendedor.
          if(e && e.code === 'auth/email-already-in-use'){ uid = await findUidByEmail(email); linked = true; }
          else throw e;
        }
        const prev = await db.collection('sellers').doc(uid).get();
        if(prev.exists){ msg('Ese correo ya es vendedor (' + (prev.data().name || email) + '). Búscalo en la lista de abajo para editarlo.', false); btn.disabled = false; btn.textContent = label; return; }
        await db.collection('sellers').doc(uid).set(Object.assign(data, { email, status:'activo', createdAt: Date.now() }));
        // [Aviso automático] Correo de bienvenida con el diseño de ZAYDE (enlace para elegir contraseña, pasos y portal)
        let welcome = { ok:false, sent:0 };
        if(typeof window.zySellerEvent === 'function') welcome = await window.zySellerEvent({ event:'welcome', sellerId: uid, existingAccount: linked });
        if(linked){
          msg('Listo. Ese correo ya tenía cuenta en ZAYDE, así que ahora también es vendedor: entra a su portal con su misma contraseña de siempre.' + (welcome.sent ? ' Le enviamos un correo de bienvenida con el acceso.' : ''), true);
        } else if(welcome.sent){
          msg('Vendedor creado. Le enviamos un correo de bienvenida a ' + email + ' con el botón para elegir su contraseña.', true);
        } else {
          // Respaldo: correo estándar de Firebase (por ejemplo, si todavía no subes la versión nueva de api/send-email.js)
          try{
            await firebase.auth().sendPasswordResetEmail(email);
            msg('Vendedor creado. No se pudo mandar el correo con diseño de ZAYDE (revisa que ya subiste la versión nueva de api/send-email.js), así que se envió el correo estándar de Firebase a ' + email + ' para que elija su contraseña.', true);
          }catch(e2){
            msg('Vendedor creado, pero no se pudo enviar el correo de acceso (' + friendlyErr(e2) + '). Usa "Reenviar correo".', false);
          }
        }
      }
      zvResetForm();
      await zvLoadSellers();
    }catch(e){
      console.error('[Vendedores] error al guardar:', e);
      msg(friendlyErr(e), false);
      btn.disabled = false; btn.textContent = label;
    }
  };

  window.zvToggle = async function(id){
    if(!needDb()) return;
    const x = sellers.find(v => v.id === id); if(!x) return;
    const to = x.status === 'pausado' ? 'activo' : 'pausado';
    if(to === 'pausado' && !confirm('¿Pausar a ' + (x.name || 'este vendedor') + '? Perderá el acceso a sus ventas y su stock de inmediato.')) return;
    try{
      await db.collection('sellers').doc(id).set({ status: to, updatedAt: Date.now() }, { merge:true });
      msg((x.name || 'Vendedor') + (to === 'activo' ? ' activado.' : ' pausado.'), true);
      await zvLoadSellers();
    }catch(e){ msg(friendlyErr(e), false); }
  };

  /* ---- Avisos por correo a vendedores (api/send-email.js, type "seller-notice") ---- */
  function noticeMsg(text, ok){
    const m = $('zvNoticeMsg'); if(!m) return;
    m.textContent = text; m.className = 'zv-msg show ' + (ok ? 'ok' : 'err');
    clearTimeout(noticeMsg._t); noticeMsg._t = setTimeout(() => { m.className = 'zv-msg'; }, ok ? 7000 : 12000);
  }
  function zvRenderNoticeSelect(){
    const sel = $('zvNoticeTo'); if(!sel) return;
    const prev = sel.value;
    const active = sellers.filter(x => x.status !== 'pausado');
    sel.innerHTML = '<option value="all">Todos los vendedores activos (' + active.length + ')</option>' +
      active.map(x => '<option value="' + esc(x.id) + '">' + esc(x.name || x.email || x.id) + '</option>').join('');
    if(Array.prototype.some.call(sel.options, o => o.value === prev)) sel.value = prev;
  }
  window.zvNoticeTo = function(id){
    zvRenderNoticeSelect();
    $('zvNoticeTo').value = id;
    $('zvNoticeCard').scrollIntoView({ behavior:'smooth', block:'center' });
    $('zvNoticeSubject').focus();
  };
  window.zvSendNotice = async function(){
    const to = $('zvNoticeTo').value;
    const subject = $('zvNoticeSubject').value.trim();
    const message = $('zvNoticeBody').value.trim();
    if(subject.length < 3){ noticeMsg('Escribe un asunto.', false); $('zvNoticeSubject').focus(); return; }
    if(message.length < 3){ noticeMsg('Escribe el mensaje.', false); $('zvNoticeBody').focus(); return; }
    const user = firebase.auth().currentUser;
    if(!user){ noticeMsg('Tu sesión de administrador no está activa en Firebase. Cierra sesión del panel y vuelve a entrar.', false); return; }
    if(to === 'all' && !confirm('¿Enviar este aviso a todos los vendedores activos?')) return;
    const btn = $('zvNoticeBtn'); const label = btn.textContent;
    btn.disabled = true; btn.textContent = 'Enviando…';
    try{
      const token = await user.getIdToken();
      const r = await fetch('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type':'application/json', 'Authorization':'Bearer ' + token },
        body: JSON.stringify({ type:'seller-notice', sellerIds: to === 'all' ? 'all' : [to], subject, message })
      });
      const out = await r.json().catch(() => ({}));
      if(r.ok){
        noticeMsg(out.failed ? 'Enviado a ' + out.sent + '; no se pudo a ' + out.failed + '.' : 'Aviso enviado a ' + out.sent + (out.sent === 1 ? ' vendedor.' : ' vendedores.'), !out.failed);
        $('zvNoticeSubject').value = ''; $('zvNoticeBody').value = '';
      } else if(r.status === 401 || r.status === 403){
        noticeMsg('El servidor no reconoció tu sesión de administrador. Cierra sesión del panel y vuelve a entrar.', false);
      } else if(r.status === 400 && out.error === 'Falta "type" o no es válido. Usa "status", "drop", "coupon", "otp", "giftcard" o "membership".'){
        noticeMsg('Falta subir la versión nueva de api/send-email.js.', false);
      } else {
        noticeMsg(out.error || ('No se pudo enviar el aviso (error ' + r.status + ').'), false);
      }
    }catch(e){
      noticeMsg('No se pudo contactar al servidor. Revisa tu conexión.', false);
    }finally{ btn.disabled = false; btn.textContent = label; }
  };

  window.zvResend = async function(id){
    const x = sellers.find(v => v.id === id); if(!x || !x.email) return;
    // [Aviso automático] Correo de bienvenida con el diseño de ZAYDE y un enlace nuevo para elegir contraseña
    const w = (typeof window.zySellerEvent === 'function') ? await window.zySellerEvent({ event:'welcome', sellerId: id, resend: true }) : { ok:false, sent:0 };
    if(w.sent){ msg('Correo de acceso enviado a ' + x.email + '.', true); return; }
    // Respaldo: correo estándar de Firebase
    try{
      await firebase.auth().sendPasswordResetEmail(x.email);
      msg('Se envió a ' + x.email + ' el correo estándar de Firebase (el correo con diseño de ZAYDE no salió: revisa que ya subiste la versión nueva de api/send-email.js y que el vendedor esté activo).', true);
    }catch(e){ msg(friendlyErr(e), false); }
  };

  // Mostrar/ocultar la pestaña (mismo patrón que Reventa; zyShowAdminTab no conoce esta pestaña)
  const orig = window.zyShowAdminTab;
  window.zyShowAdminTab = function(tab){
    orig.apply(this, arguments);
    const pane = $('zyTabVendedores'), btn = $('zyTabBtnVendedores');
    if(pane) pane.style.display = tab === 'vendedores' ? '' : 'none';
    if(btn) btn.classList.toggle('active', tab === 'vendedores');
    if(tab === 'vendedores') zvLoadSellers();
  };
})();
</script>
<script>
/* ================= [VENDEDORES] Estados, comisión y liquidaciones =================
   1) zySyncSellerSales(): cuando cambias la etapa de un pedido, las ventas de
      vendedor de ese pedido avanzan igual (la llama zyAdminAdvanceOrderStatus).
   2) Pestaña "Ventas vendedores": ves todas las ventas, completas la comisión
      de las que quedaron "por definir", corriges un estado a mano y registras
      liquidaciones (colección "sellerPayouts").
   Regla de liberación: una venta se libera N días después de marcarse
   "entregado" (N = pestaña Reventa, 5 por defecto). Una venta devuelta, o ya
   liquidada, no se toca. */
(function(){
  const $ = id => document.getElementById(id);
  const esc = s => (typeof zyEscapeHtml === 'function') ? zyEscapeHtml(String(s == null ? '' : s)) : String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const money = n => '$' + (Number(n) || 0).toLocaleString('es-MX', { minimumFractionDigits:2, maximumFractionDigits:2 });
  const round2 = n => Math.round(n * 100) / 100;
  const DAY = 86400000;
  const fmtDate = ms => ms ? new Date(ms).toLocaleDateString('es-MX', { day:'numeric', month:'short', year:'numeric' }) : '';

  const STATUS_OPTS = [['pagado','Pagado'],['verificando','En verificación'],['preparando','Preparando'],['enviado','Enviado'],['entregado','Entregado'],['devuelto','Devuelto']];
  // Etapas de tus pedidos (ORDER_STAGES) -> estado de la venta del vendedor
  const ORDER_TO_SALE = { recibido:'pagado', verificando:'verificando', preparando:'preparando', camino:'enviado', entregado:'entregado' };

  function releaseDays(){
    const r = (typeof zySettings !== 'undefined' && zySettings && zySettings.resale) || {};
    const n = Number(r.releaseDays);
    return (isFinite(n) && n >= 0) ? n : 5;
  }
  // Campos que cambian al pasar una venta a un estado nuevo
  function statusPatch(status, at, row){
    const p = { status, statusUpdatedAt: at };
    if(status === 'entregado'){
      // Si ya estaba entregada, se conserva la fecha original (no se reinicia el plazo)
      if(row && row.status === 'entregado' && row.deliveredAt){ p.deliveredAt = row.deliveredAt; p.releaseAt = row.releaseAt || (row.deliveredAt + releaseDays() * DAY); }
      else { p.deliveredAt = at; p.releaseAt = at + releaseDays() * DAY; }
    } else if(status !== 'devuelto'){
      p.deliveredAt = null; p.releaseAt = null; // retrocedió de "entregado": se cancela la liberación
    }
    return p;
  }

  /* Avisos automáticos por correo al vendedor (api/send-email.js, type "seller-event"; SOLO admin).
     Nunca rompe lo que estés haciendo: si falla, solo se anota en la consola. Los correos no llevan
     datos del comprador y el servidor no repite un aviso que ya mandó. Devuelve { ok, sent }. */
  window.zySellerEvent = async function(payload){
    try{
      const user = (window.firebase && firebase.auth) ? firebase.auth().currentUser : null;
      if(!user) return { ok:false, sent:0 };
      const token = await user.getIdToken();
      const r = await fetch('/api/send-email', {
        method: 'POST',
        headers: { 'Content-Type':'application/json', 'Authorization':'Bearer ' + token },
        body: JSON.stringify(Object.assign({ type:'seller-event' }, payload))
      });
      let j = {}; try{ j = await r.json(); }catch(e){}
      return { ok: r.ok, sent: Number(j.sent) || 0 };
    }catch(e){
      console.warn('[Aviso al vendedor]', e);
      return { ok:false, sent:0 };
    }
  };

  /* ---------- 1) Sincronización pedido -> ventas del vendedor ---------- */
  window.zySyncSellerSales = async function(orderNum, statusKey, at){
    if(typeof db === 'undefined' || !db) return;
    const status = ORDER_TO_SALE[statusKey];
    if(!status) return;
    // El vínculo pedido -> venta vive en sellerSalesPrivate (solo lo lee el admin)
    const links = await db.collection('sellerSalesPrivate').where('orderNum', '==', orderNum).get();
    if(links.empty) return; // el pedido no tiene piezas de vendedores
    const refs = links.docs.map(d => db.collection('sellerSales').doc(d.id));
    const rows = await Promise.all(refs.map(r => r.get()));
    const batch = db.batch(); let n = 0; const changedIds = [];
    rows.forEach((snap, i) => {
      if(!snap.exists) return;
      const row = snap.data();
      if(row.settled || row.status === 'devuelto') return; // ya liquidada o devuelta: no se toca
      batch.update(refs[i], statusPatch(status, at, row)); n++;
      if(row.status !== status) changedIds.push(snap.id);
    });
    if(n) await batch.commit();
    // [Aviso automático] el vendedor se entera del nuevo estado de sus ventas (sin esperar ni bloquear)
    if(changedIds.length) window.zySellerEvent({ event:'sale-status', saleIds: changedIds });
  };

  /* ---------- 2) Pestaña "Ventas vendedores" ---------- */
  let sellers = {}, sales = [], links = {}, payouts = [];

  function msg(text, ok){
    const m = $('zvsMsg'); if(!m) return;
    m.textContent = text; m.className = 'zv-msg show ' + (ok ? 'ok' : 'err');
    clearTimeout(msg._t); msg._t = setTimeout(() => { m.className = 'zv-msg'; }, ok ? 7000 : 14000);
  }
  function friendlyErr(e){
    const c = (e && e.code) || '';
    if(c === 'permission-denied') return 'Firestore no te dejó leer o escribir. Publica la versión nueva de firestore.rules (incluye "sellerPayouts") o revisa que iniciaste sesión como admin.';
    return (e && (e.message || e.code)) || String(e);
  }
  // Clasificación de cada venta (la misma lógica la usa el portal del vendedor)
  function cls(s, now){
    if(s.status === 'devuelto') return 'devuelta';
    if(s.settled) return 'liquidada';
    if(s.net == null) return 'sinComision';
    if(s.status === 'entregado' && s.releaseAt && s.releaseAt <= now) return 'lista';
    return 'proceso';
  }
  const CLS_LABEL = { lista:'Lista para liquidar', proceso:'En proceso', sinComision:'Sin comisión', liquidada:'Liquidada', devuelta:'Devuelta' };

  window.zvsLoad = async function(){
    const list = $('zvsList'); if(!list) return;
    if(typeof db === 'undefined' || !db){ list.innerHTML = '<div class="zv-empty">Firestore no está disponible. Entra al panel con tu cuenta de administrador y recarga.</div>'; return; }
    list.innerHTML = '<div class="zv-empty">Cargando…</div>';
    try{
      const [s1, s2, s3, s4] = await Promise.all([
        db.collection('sellers').get(),
        db.collection('sellerSales').orderBy('createdAt', 'desc').limit(1000).get(),
        db.collection('sellerSalesPrivate').limit(2000).get(),
        db.collection('sellerPayouts').limit(500).get()
      ]);
      sellers = {}; s1.docs.forEach(d => { sellers[d.id] = Object.assign({ id:d.id }, d.data()); });
      sales = s2.docs.map(d => Object.assign({ id:d.id }, d.data()));
      links = {}; s3.docs.forEach(d => { links[d.id] = d.data(); });
      payouts = s4.docs.map(d => Object.assign({ id:d.id }, d.data())).sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
      fillSellerSelect();
      if($('zvsCsvMonth') && !$('zvsCsvMonth').value) $('zvsCsvMonth').value = mk(Date.now());
      zvsRender();
    }catch(e){
      console.error('[Ventas vendedores]', e);
      list.innerHTML = '<div class="zv-empty">No se pudo cargar. ' + esc(friendlyErr(e)) + '</div>';
    }
  };

  function fillSellerSelect(){
    const sel = $('zvsSeller'); const prev = sel.value;
    const arr = Object.values(sellers).sort((a, b) => String(a.name || '').localeCompare(String(b.name || '')));
    sel.innerHTML = '<option value="">Todos los vendedores</option>' +
      arr.map(x => '<option value="' + esc(x.id) + '">' + esc(x.name || x.email || x.id) + (x.status === 'pausado' ? ' (pausado)' : '') + '</option>').join('');
    if(arr.some(x => x.id === prev)) sel.value = prev;
  }

  window.zvsRender = function(){
    const now = Date.now();
    const sid = $('zvsSeller').value, f = $('zvsFilter').value;
    const pool = sid ? sales.filter(s => s.sellerId === sid) : sales;
    const sumOf = k => pool.filter(s => cls(s, now) === k).reduce((t, s) => t + (Number(s.net) || 0), 0);
    const readyTotal = round2(sumOf('lista'));
    $('zvsReady').textContent = money(readyTotal);
    $('zvsProc').textContent = money(sumOf('proceso'));
    $('zvsSettled').textContent = money(sumOf('liquidada'));
    $('zvsReview').textContent = pool.filter(s => cls(s, now) === 'sinComision').length;

    const btn = $('zvsPayBtn');
    const readyCount = pool.filter(s => cls(s, now) === 'lista').length;
    if(!sid){ btn.disabled = true; btn.textContent = 'Elige un vendedor para liquidar'; }
    else if(!readyCount){ btn.disabled = true; btn.textContent = 'No hay ventas listas para liquidar'; }
    else { const cw = calcClaw(sid, readyTotal).total; btn.disabled = false; btn.textContent = 'Registrar liquidación de ' + money(round2(readyTotal - cw)) + (cw ? ' (ya descontados ' + money(cw) + ' por devoluciones)' : '') + ' (' + readyCount + (readyCount === 1 ? ' pieza)' : ' piezas)'); }

    const view = f === 'all' ? pool : pool.filter(s => cls(s, now) === f);
    $('zvsCount').textContent = '(' + view.length + ')';
    const list = $('zvsList');
    if(!view.length){
      list.innerHTML = '<div class="zv-empty">' + (sales.length ? 'No hay ventas con ese filtro.' : 'Todavía no hay ventas de vendedores. Aparecen cuando se paga una pieza que tenga vendedor asignado.') + '</div>';
    } else {
      list.innerHTML = view.map(s => saleRow(s, now)).join('');
    }

    const pay = sid ? payouts.filter(p => p.sellerId === sid) : payouts;
    $('zvsPayouts').innerHTML = pay.length
      ? pay.map(p => '<div class="zs-pay"><span><b>' + esc(fmtDate(p.createdAt)) + '</b> · ' + esc(p.sellerName || (sellers[p.sellerId] || {}).name || '') + (p.note ? ' · ' + esc(p.note) : '') + '</span><span><b>' + money(p.amount) + '</b> · ' + esc(p.saleCount || 0) + ' pzas</span></div>').join('')
      : '<div class="zv-empty" style="border:0;">Aún no has registrado liquidaciones' + (sid ? ' a este vendedor.' : '.') + '</div>';
  };

  function saleRow(s, now){
    const k = cls(s, now);
    const seller = sellers[s.sellerId] || {};
    const link = links[s.id];
    const title = (s.brand ? s.brand + ' ' : '') + (s.productName || 'Pieza');
    const sub = [seller.name || '(vendedor)', fmtDate(s.createdAt), link ? 'Pedido ' + link.orderNum : ''].filter(Boolean).join(' · ');
    const commTxt = s.commission == null ? '<span style="color:#a86500;font-weight:700;">Comisión por definir</span>'
      : 'Comisión ' + money(s.commission) + (s.commissionPct != null ? ' (' + esc(s.commissionPct) + '%)' : '');
    let when = '';
    if(k === 'liquidada') when = 'Liquidada el ' + fmtDate(s.settledAt);
    else if(s.status === 'entregado' && s.releaseAt) when = (s.releaseAt <= now ? 'Liberada desde ' : 'Se libera el ') + fmtDate(s.releaseAt);
    const opts = STATUS_OPTS.map(o => '<option value="' + o[0] + '"' + (s.status === o[0] ? ' selected' : '') + '>' + o[1] + '</option>').join('');
    const commCtl = (s.net == null && !s.settled)
      ? '<input type="number" id="zvsPct_' + esc(s.id) + '" min="0" max="100" step="0.1" placeholder="% comisión"><button type="button" onclick="zvsApplyCommission(\'' + esc(s.id) + '\')">Aplicar comisión</button>' : '';
    return '<div class="zs-row">' +
      '<div class="zs-top"><div class="zs-name">' + esc(title) + '<small>' + esc(sub) + '</small></div><span class="zs-b ' + k + '">' + CLS_LABEL[k] + '</span></div>' +
      '<div class="zs-money"><span>' + (s.size ? 'Talla ' + esc(s.size) + ' · ' : '') + 'Cant. ' + esc(s.qty || 1) + '</span><span>Venta ' + money(s.gross) + '</span><span>' + commTxt + '</span><span>Neto ' + (s.net == null ? '—' : '<b>' + money(s.net) + '</b>') + '</span>' + (when ? '<span style="color:var(--steel);">' + esc(when) + '</span>' : '') + '</div>' +
      '<div class="zs-ctl"><select ' + (s.settled ? 'disabled' : '') + ' onchange="zvsSetStatus(\'' + esc(s.id) + '\', this.value)">' + opts + '</select>' + commCtl + '</div>' +
    '</div>';
  }

  window.zvsSetStatus = async function(id, status){
    const s = sales.find(x => x.id === id);
    if(!s || s.settled || status === s.status){ zvsRender(); return; }
    if(status === 'devuelto' && !confirm('¿Marcar esta venta como devuelta? Dejará de sumar al saldo del vendedor.')){ zvsRender(); return; }
    try{
      const patch = statusPatch(status, Date.now(), s);
      await db.collection('sellerSales').doc(id).update(patch);
      Object.assign(s, patch);
      window.zySellerEvent({ event:'sale-status', saleIds: [id] }); // [Aviso automático] al vendedor
      zvsRender();
    }catch(e){ msg(friendlyErr(e), false); zvsRender(); }
  };

  window.zvsApplyCommission = async function(id){
    const s = sales.find(x => x.id === id); if(!s || s.settled) return;
    const inp = $('zvsPct_' + id);
    const pct = inp ? parseFloat(inp.value) : NaN;
    if(!isFinite(pct) || pct < 0 || pct > 100){ msg('Escribe un porcentaje de comisión entre 0 y 100.', false); if(inp) inp.focus(); return; }
    const gross = Number(s.gross) || 0;
    const commission = round2(gross * pct / 100);
    const patch = { commissionPct: pct, commission, net: round2(gross - commission), needsReview: false, commissionSetBy: 'admin' };
    try{
      await db.collection('sellerSales').doc(id).update(patch);
      Object.assign(s, patch);
      const mailed = await window.zySellerEvent({ event:'commission', saleIds: [id] }); // [Aviso automático] al vendedor
      msg('Comisión aplicada: el vendedor recibe ' + money(patch.net) + '.' + (mailed.sent ? ' Se le avisó por correo.' : ''), true);
      zvsRender();
    }catch(e){ msg(friendlyErr(e), false); }
  };

  window.zvsRegisterPayout = async function(){
    const sid = $('zvsSeller').value; if(!sid) return;
    const btn = $('zvsPayBtn'); btn.disabled = true;
    try{
      await zvsLoad(); // datos frescos antes de pagar
      const now = Date.now();
      let ready = sales.filter(s => s.sellerId === sid && cls(s, now) === 'lista').sort((a, b) => (a.createdAt || 0) - (b.createdAt || 0));
      if(!ready.length){ msg('Ya no hay ventas listas para liquidar a este vendedor.', false); return; }
      const rest = Math.max(0, ready.length - 450); // un lote atómico admite hasta 500 escrituras
      ready = ready.slice(0, 450);
      const grossAmount = round2(ready.reduce((t, s) => t + (Number(s.net) || 0), 0));
      const claw = calcClaw(sid, grossAmount); // devoluciones de ventas ya pagadas que se descuentan ahora
      const clawTotal = claw.total;
      const amount = round2(grossAmount - clawTotal);
      const seller = sellers[sid] || {};
      if(!confirm('Vas a registrar una liquidación de ' + money(amount) + (clawTotal ? ' (ya descontados ' + money(clawTotal) + ' por devoluciones de piezas que ya se le habían pagado)' : '') + ' para ' + (seller.name || 'este vendedor') + ' (' + ready.length + ' piezas).\n\nEsas ventas quedarán como liquidadas y esto no se puede deshacer desde aquí. ¿Continuar?')) return;
      const note = (prompt('Referencia del pago (opcional). Por ejemplo: "Transferencia 15 oct" o un folio.', '') || '').trim().slice(0, 200);
      const at = Date.now();
      const payRef = db.collection('sellerPayouts').doc();
      const batch = db.batch();
      batch.set(payRef, { sellerId: sid, sellerName: seller.name || '', amount, saleCount: ready.length, saleIds: ready.map(s => s.id), note, createdAt: at, clawbackTotal: clawTotal, clawbackIds: claw.ids });
      claw.ids.forEach(id => batch.update(db.collection('sellerSales').doc(id), { clawbackApplied: true, clawbackPayoutId: payRef.id }));
      ready.forEach(s => batch.update(db.collection('sellerSales').doc(s.id), { settled: true, settledAt: at, payoutId: payRef.id }));
      await batch.commit();
      const mailed = await window.zySellerEvent({ event:'payout', payoutId: payRef.id }); // [Aviso automático] al vendedor
      msg('Liquidación registrada: ' + money(amount) + ' (' + ready.length + ' piezas).' + (mailed.sent ? ' Se le avisó al vendedor por correo.' : '') + (rest ? ' Quedaron ' + rest + ' ventas más para la siguiente liquidación.' : '') + ' Recuerda que aquí solo se registra: el pago al vendedor lo haces tú.', true);
      await zvsLoad();
    }catch(e){
      console.error('[Liquidación]', e);
      msg(friendlyErr(e), false);
    }finally{ zvsRender(); }
  };

  /* ---------- 3) Venta de vendedor a mano (pedidos pagados por transferencia, efectivo, etc.) ----------
     El webhook de Stripe solo crea la venta cuando cobra con tarjeta. Para un pedido que tú marcas
     como pagado, estas funciones crean la misma venta (sellerSales + su vínculo privado). Nunca duplican:
     si el pedido ya tiene alguna venta ligada, no se crea otra. */
  const mk = ms => { const d = new Date(ms); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0'); };
  const isoDay = ms => { if(!ms) return ''; const d = new Date(ms); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'); };
  const sellerItems = o => (o.items || []).map((it, i) => ({ it, i })).filter(x => x.it && x.it.sellerId && !x.it.isMembership && !x.it.isGiftCard);
  const lineOf = store => 'zayde';

  window.zyOrderActionsHTML = function(o){
    const num = esc(o.orderNum);
    const paid = o.paymentStatus === 'pagado';
    const parts = [];
    // [REEMBOLSOS] Lo escribe el webhook cuando haces un reembolso desde Stripe. Un reembolso PARCIAL no toca las ventas
    // de vendedor (no se sabe de qué pieza fue): este aviso es para que lo revises y, si aplica, ajustes la venta a mano.
    if(Number(o.refundedAmount) > 0){
      const fullRef = o.refundFull === true;
      parts.push('<span style="font-size:12px;font-weight:700;padding:3px 10px;border-radius:999px;background:' + (fullRef ? '#FBE6E1' : '#FBF3DD') + ';color:' + (fullRef ? '#9A3A26' : '#8A6A1F') + ';">' +
        (fullRef ? 'Reembolsado en Stripe: ' : 'Reembolso PARCIAL en Stripe: ') + money(o.refundedAmount) +
        (fullRef ? '' : ' · revisa si afecta una pieza de vendedor') + '</span>');
    }
    if(!paid && o.paymentMethod !== 'stripe'){
      parts.push('<button type="button" class="zy-order-verify-btn" onclick="zyMarkOrderPaid(\'' + num + '\')">Marcar como pagado</button>');
    }
    if(sellerItems(o).length){
      const linked = window.zyOrderSaleLinks && window.zyOrderSaleLinks.has(o.orderNum);
      if(linked) parts.push('<span style="font-size:12px;color:#1b8a4f;font-weight:700;">✓ Venta de vendedor generada</span>');
      else if(paid) parts.push('<button type="button" class="zy-order-verify-btn" onclick="zyOrderGenerateSale(\'' + num + '\')">Generar venta de vendedor</button>');
      else parts.push('<span style="font-size:12px;color:var(--steel);">Incluye pieza de vendedor: ' + (o.paymentMethod === 'stripe' ? 'la venta se crea sola cuando se confirma el pago con tarjeta.' : 'la venta se genera al marcar el pedido como pagado.') + '</span>');
    }
    return parts.length ? '<div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:6px;">' + parts.join('') + '</div>' : '';
  };

  // Aviso por correo al vendedor (reusa type "seller-notice" de api/send-email.js; no lleva datos del comprador)
  async function notifySellersOfSales(created){
    const user = firebase.auth().currentUser;
    if(!user) return { sent:0, failed:0 };
    const bySeller = {};
    created.forEach(s => { (bySeller[s.sellerId] = bySeller[s.sellerId] || []).push(s); });
    const token = await user.getIdToken();
    let sent = 0, failed = 0;
    for(const sid of Object.keys(bySeller)){
      const list = bySeller[sid];
      const lines = list.map(s => '• ' + (s.brand ? s.brand + ' ' : '') + s.productName + (s.size ? ' (talla ' + s.size + ')' : '') + ' × ' + s.qty).join('\n');
      try{
        const r = await fetch('/api/send-email', {
          method: 'POST',
          headers: { 'Content-Type':'application/json', 'Authorization':'Bearer ' + token },
          body: JSON.stringify({
            type: 'seller-notice', sellerIds: [sid],
            subject: list.length === 1 ? 'Vendiste una pieza en ZAYDE' : 'Vendiste ' + list.length + ' piezas en ZAYDE',
            message: 'Se confirmó el pago de:\n\n' + lines + '\n\nYa aparece en tu portal, con tu comisión y lo que te toca.'
          })
        });
        if(r.ok) sent++; else failed++;
      }catch(e){ failed++; }
    }
    return { sent, failed };
  }

  window.zyGenerateSellerSales = async function(orderNum){
    if(typeof db === 'undefined' || !db) throw new Error('Firestore no está disponible. Entra con tu cuenta de administrador y recarga.');
    const osnap = await db.collection('orders').doc(orderNum).get();
    if(!osnap.exists) throw new Error('El pedido no existe en la nube.');
    const order = osnap.data();
    if(order.paymentStatus !== 'pagado') return { created:0, reason:'unpaid' };
    const lines = sellerItems(order);
    if(!lines.length) return { created:0, reason:'none' };
    // Anti-duplicado: si ya hay ventas ligadas a este pedido (de Stripe o de un intento anterior), no se crea nada
    const existing = await db.collection('sellerSalesPrivate').where('orderNum', '==', orderNum).get();
    if(!existing.empty) return { created:0, reason:'exists' };

    const sellerIds = Array.from(new Set(lines.map(l => l.it.sellerId)));
    const docs = await Promise.all(sellerIds.map(id => db.collection('sellers').doc(id).get()));
    const sellers = {}; docs.forEach(d => { if(d.exists) sellers[d.id] = d.data(); });

    const at = Date.now();
    const createdAt = Number(order.paidAt) || Number(order.date) || at;
    const saleStatus = ORDER_TO_SALE[order.status || 'recibido'] || 'pagado';
    const batch = db.batch();
    const created = []; const missing = [];
    lines.forEach(({ it, i }) => {
      const seller = sellers[it.sellerId];
      if(!seller){ missing.push(it.name || it.id); return; }
      const qty = Math.max(1, parseInt(it.qty, 10) || 1);
      const gross = round2((Number(it.price) || 0) * qty);
      // Misma regla que el resto del panel: comisión propia del vendedor; si no tiene, la tabla de Reventa; si tampoco, "por definir"
      let pct = (seller.commissionPct != null && seller.commissionPct !== '' && isFinite(Number(seller.commissionPct))) ? Number(seller.commissionPct) : null;
      if(pct == null && typeof window.zyResaleFee === 'function'){
        const f = window.zyResaleFee(lineOf(it.store), it.category);
        if(f != null && isFinite(f)) pct = f;
      }
      const has = pct != null;
      const commission = has ? round2(gross * pct / 100) : null;
      const net = has ? round2(gross - commission) : null;
      const id = 'man_' + orderNum + '_' + i;
      const sale = Object.assign({
        sellerId: it.sellerId, productId: String(it.id), productName: it.name || 'Pieza', brand: it.brand || '', size: it.size || '', qty, gross,
        commissionPct: has ? pct : null, commission, net, needsReview: !has, commissionSetBy: has ? 'auto' : null,
        settled: false, createdAt, source: 'manual'
      }, statusPatch(saleStatus, at, null));
      batch.set(db.collection('sellerSales').doc(id), sale);
      batch.set(db.collection('sellerSalesPrivate').doc(id), { orderNum, sellerId: it.sellerId, createdAt, manual: true });
      created.push(Object.assign({ id }, sale));
    });
    if(!created.length) throw new Error('Los vendedores de este pedido ya no existen en la lista de vendedores.');
    await batch.commit();
    if(window.zyOrderSaleLinks) created.forEach(s => window.zyOrderSaleLinks.add(orderNum));
    let mail = { sent:0, failed:0 };
    try{ mail = await notifySellersOfSales(created); }catch(e){ console.warn('[Ventas vendedores] aviso por correo:', e); }
    return { created: created.length, missing, mail, noCommission: created.filter(s => s.net == null).length };
  };

  function manualSaleSummary(r){
    let t = 'Venta de vendedor generada (' + r.created + (r.created === 1 ? ' pieza' : ' piezas') + ').';
    if(r.noCommission) t += ' ' + r.noCommission + ' sin comisión definida: complétala en "Ventas vendedores".';
    if(r.mail && r.mail.sent) t += ' Se avisó al vendedor por correo.';
    else if(r.mail && r.mail.failed) t += ' No se pudo avisar por correo al vendedor.';
    if(r.missing && r.missing.length) t += ' No se creó la venta de: ' + r.missing.join(', ') + ' (vendedor no encontrado).';
    return t;
  }

  window.zyMarkOrderPaid = async function(orderNum){
    if(typeof db === 'undefined' || !db){ showToast('Firestore no está disponible. Entra con tu cuenta de administrador y recarga.', true); return; }
    if(!confirm('¿Confirmas que ya recibiste el pago del pedido ' + orderNum + ' (transferencia, efectivo, etc.)?\n\nSe marcará como pagado y, si incluye piezas de vendedores, se generará su venta.')) return;
    try{
      await db.collection('orders').doc(orderNum).update({ paymentStatus:'pagado', paidAt: Date.now(), paidManually: true });
    }catch(e){
      console.error('[Pedido pagado]', e);
      showToast('No se pudo marcar el pedido como pagado: ' + ((e && (e.code || e.message)) || 'error'), true);
      return;
    }
    let text = 'Pedido ' + orderNum + ' marcado como pagado.';
    try{
      const r = await window.zyGenerateSellerSales(orderNum);
      if(r.created) text += ' ' + manualSaleSummary(r);
    }catch(e){
      console.error('[Venta vendedor]', e);
      showToast(text + ' Pero no se pudo generar la venta del vendedor (' + ((e && (e.code || e.message)) || 'error') + '). Usa el botón "Generar venta de vendedor".', true);
      zyRenderOrdersAdmin();
      return;
    }
    showToast(text);
    zyRenderOrdersAdmin();
  };

  window.zyOrderGenerateSale = async function(orderNum){
    try{
      const r = await window.zyGenerateSellerSales(orderNum);
      if(r.reason === 'exists') showToast('Este pedido ya tiene su venta de vendedor.');
      else if(r.reason === 'unpaid') showToast('Primero marca el pedido como pagado.', true);
      else if(r.reason === 'none') showToast('Este pedido no tiene piezas de vendedores.', true);
      else showToast(manualSaleSummary(r));
    }catch(e){
      console.error('[Venta vendedor]', e);
      showToast('No se pudo generar la venta: ' + ((e && (e.code || e.message)) || 'error'), true);
    }
    zyRenderOrdersAdmin();
  };

  /* ---------- 4) Reportes CSV mensuales ---------- */
  window.zvsExportCsv = function(){
    const sid = $('zvsSeller').value;
    const month = $('zvsCsvMonth').value; // YYYY-MM, vacío = todos los meses
    let list = sales.slice();
    if(sid) list = list.filter(s => s.sellerId === sid);
    if(month) list = list.filter(s => s.createdAt && mk(s.createdAt) === month);
    if(!list.length){ msg('No hay ventas para ese vendedor y mes.', false); return; }
    const nameOf = s => (sellers[s.sellerId] || {}).name || (sellers[s.sellerId] || {}).email || s.sellerId || '';
    list.sort((a, b) => String(nameOf(a)).localeCompare(String(nameOf(b))) || (a.createdAt || 0) - (b.createdAt || 0));
    const now = Date.now();
    const rows = [['Mes','Fecha','Vendedor','Pedido','Pieza','Talla','Cantidad','Venta','Comisión %','Comisión ZAYDE','Neto vendedor','Estado','Liquidada','Fecha de liquidación']];
    let tg = 0, tc = 0, tn = 0, pend = 0;
    list.forEach(s => {
      const link = links[s.id];
      const counts = s.status !== 'devuelto';
      if(counts){ tg += Number(s.gross) || 0; if(s.net != null){ tc += Number(s.commission) || 0; tn += Number(s.net) || 0; } else pend++; }
      rows.push([
        s.createdAt ? mk(s.createdAt) : '', isoDay(s.createdAt), nameOf(s), link ? link.orderNum : '',
        (s.brand ? s.brand + ' ' : '') + (s.productName || ''), s.size || '', Number(s.qty) || 1,
        Number(s.gross) || 0, s.commissionPct == null ? '' : Number(s.commissionPct),
        s.commission == null ? '' : Number(s.commission), s.net == null ? '' : Number(s.net),
        CLS_LABEL[cls(s, now)], s.settled ? 'Sí' : 'No', s.settled ? isoDay(s.settledAt) : ''
      ]);
    });
    rows.push([]);
    rows.push(['TOTAL (sin devueltas)', '', '', '', '', '', '', round2(tg), '', round2(tc), round2(tn), pend ? pend + ' venta(s) sin comisión definida (no suman en comisión ni neto)' : '', '', '']);
    const who = sid ? String(nameOf(list[0])).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') : 'todos';
    zyCsvDownload('ventas-vendedores-' + (who || 'vendedor') + '-' + (month || 'todos-los-meses') + '.csv', rows);
    msg('Reporte descargado (' + list.length + (list.length === 1 ? ' venta).' : ' ventas).') + (sales.length >= 1000 ? ' Ojo: aquí se cargan las 1000 ventas más recientes.' : ''), true);
  };

  /* ---------- 5) Descuentos por devoluciones de ventas ya liquidadas ---------- */
  // Si una venta ya pagada al vendedor se devuelve, su neto se descuenta de su próxima liquidación.
  function calcClaw(sid, gross){
    const pend = sales.filter(s => s.sellerId === sid && s.status === 'devuelto' && s.settled && Number(s.clawback) > 0 && !s.clawbackApplied)
      .sort((a, b) => (a.returnedAt || 0) - (b.returnedAt || 0)).slice(0, 40);
    let room = gross, total = 0; const ids = [];
    pend.forEach(s => { const c = Number(s.clawback); if(c <= room + 0.001){ room = round2(room - c); total = round2(total + c); ids.push(s.id); } });
    return { total, ids };
  }

  /* ---------- 6) Devoluciones ---------- */
  let returns = [];
  const RET_LABEL = { solicitada:'Por revisar', aprobada:'Aprobada', rechazada:'Rechazada', no_autentica:'No pasó verificación' };
  function dmsg(text, ok){
    const m = $('zdMsg'); if(!m) return;
    m.textContent = text; m.className = 'zv-msg show ' + (ok ? 'ok' : 'err');
    clearTimeout(dmsg._t); dmsg._t = setTimeout(() => { m.className = 'zv-msg'; }, ok ? 12000 : 16000);
  }

  window.zdLoad = async function(){
    const box = $('zdList'); if(!box) return;
    if(typeof db === 'undefined' || !db){ box.innerHTML = '<div class="zv-empty">Firestore no está disponible. Entra con tu cuenta de administrador y recarga.</div>'; return; }
    box.innerHTML = '<div class="zv-empty">Cargando…</div>';
    try{
      const snap = await db.collection('returns').orderBy('createdAt', 'desc').limit(300).get();
      returns = snap.docs.map(d => Object.assign({ docId: d.id }, d.data()));
      zdRender();
    }catch(e){
      console.error('[Devoluciones]', e);
      box.innerHTML = '<div class="zv-empty">No se pudo cargar. ' + esc(friendlyErr(e)) + '</div>';
    }
  };

  window.zdRender = function(){
    const box = $('zdList'); if(!box) return;
    const f = $('zdFilter').value;
    const view = f === 'all' ? returns : returns.filter(r => (r.status || 'solicitada') === 'solicitada');
    if(!view.length){
      box.innerHTML = '<div class="zv-empty">' + (returns.length ? 'No hay devoluciones pendientes.' : 'Todavía no hay devoluciones registradas. Aparecen cuando un cliente la solicita desde su pedido.') + '</div>';
      return;
    }
    box.innerHTML = view.map(r => {
      const st = r.status || 'solicitada';
      const items = (r.items || []).map(i => (i.qty > 1 ? i.qty + '× ' : '') + (i.name || 'Pieza') + (i.size ? ' (talla ' + i.size + ')' : '')).join(' · ');
      const who = r.contact ? [r.contact.name, r.contact.email].filter(Boolean).join(' · ') : '';
      const ctl = st === 'solicitada'
        ? '<div class="zs-ctl">' +
            '<button type="button" onclick="zdResolve(\'' + esc(r.docId) + '\',\'aprobada\')">Pasó verificación · reembolsar</button>' +
            '<button type="button" onclick="zdResolve(\'' + esc(r.docId) + '\',\'no_autentica\')">No es auténtica · reembolsar</button>' +
            '<button type="button" onclick="zdResolve(\'' + esc(r.docId) + '\',\'rechazada\')">No procede</button>' +
          '</div>'
        : '<div class="zs-money"><span style="color:var(--steel);">' + esc(RET_LABEL[st] || st) + (r.resolvedAt ? ' el ' + esc(fmtDate(r.resolvedAt)) : '') + (r.resolvedNote ? ' · ' + esc(r.resolvedNote) : '') + '</span></div>';
      return '<div class="zs-row">' +
        '<div class="zs-top"><div class="zs-name">' + esc(r.id || r.docId) + ' · Pedido ' + esc(r.orderNum) + '<small>' + esc([fmtDate(r.createdAt), who].filter(Boolean).join(' · ')) + '</small></div><span class="zs-b ' + esc(st) + '">' + esc(RET_LABEL[st] || st) + '</span></div>' +
        '<div class="zs-money"><span>' + esc(items) + '</span></div>' +
        '<div class="zs-money"><span style="color:var(--steel);">Motivo: ' + esc(r.reason || '—') + (r.details ? ' · ' + esc(r.details) : '') + '</span></div>' +
        ctl + '</div>';
    }).join('');
  };

  // Marca como devueltas las ventas de vendedor ligadas a este pedido y a las piezas devueltas
  async function returnSellerSales(r, outcome){
    const lk = await db.collection('sellerSalesPrivate').where('orderNum', '==', r.orderNum).get();
    if(lk.empty) return { done:[], partial:[], already:[] };
    const snaps = await Promise.all(lk.docs.map(d => db.collection('sellerSales').doc(d.id).get()));
    const pool = snaps.filter(s => s.exists).map(s => Object.assign({ id: s.id }, s.data()));
    const norm = v => String(v == null ? '' : v).trim().toLowerCase();
    const used = new Set(); const done = [], partial = [], already = [];
    const batch = db.batch(); const at = Date.now();
    (r.items || []).forEach(it => {
      const cand = pool.find(s => !used.has(s.id) && norm(s.size) === norm(it.size) &&
        (s.productId ? String(s.productId) === String(it.id) : (norm(s.productName) === norm(it.name) || norm((s.brand ? s.brand + ' ' : '') + s.productName) === norm(it.name))));
      if(!cand) return;
      used.add(cand.id);
      if(cand.status === 'devuelto'){ already.push(cand); return; }
      if((Number(it.qty) || 1) < (Number(cand.qty) || 1)){ partial.push(cand); return; }
      const patch = { status:'devuelto', statusUpdatedAt: at, returnedAt: at, returnId: r.docId, returnOutcome: outcome, releaseAt: null, returnReason: String(r.reason || 'Devolución solicitada por el cliente').slice(0, 160), returnCondition: outcome === 'aprobada' ? 'Buen estado: regresó al inventario' : 'No pasó la verificación de autenticidad' };
      if(cand.settled && cand.net != null){ patch.clawback = Number(cand.net) || 0; patch.clawbackApplied = false; }
      batch.update(db.collection('sellerSales').doc(cand.id), patch);
      done.push(Object.assign({}, cand, patch));
    });
    if(done.length) await batch.commit();
    return { done, partial, already };
  }

  async function restockItems(items){
    const ref = db.collection('inventory').doc('stock');
    await db.runTransaction(async tx => {
      const snap = await tx.get(ref);
      const map = Object.assign({}, snap.exists ? (snap.data().items || {}) : {});
      (items || []).forEach(it => {
        const pid = String(it.id), size = it.size || '';
        if(!map[pid] || map[pid][size] === undefined) return; // sin registro de stock: no se inventa uno
        map[pid] = Object.assign({}, map[pid]);
        map[pid][size] = (Number(map[pid][size]) || 0) + (parseInt(it.qty, 10) || 1);
      });
      tx.set(ref, { items: map, updatedAt: Date.now() }, { merge: true });
    });
  }

  async function notifyCustomerReturn(r, label){
    try{
      const o = await db.collection('orders').doc(r.orderNum).get();
      const ord = o.exists ? o.data() : null;
      const email = (ord && ord.email) || (r.contact && r.contact.email);
      if(!email || (ord && ord.notifyEmail === false)) return false;
      const res = await fetch('/api/send-email', {
        method: 'POST', headers: { 'Content-Type':'application/json' },
        body: JSON.stringify({ type:'status', to: email, name: (ord && ord.name) || (r.contact && r.contact.name) || '', orderNum: r.orderNum, statusLabel: label })
      });
      return res.ok;
    }catch(e){ return false; }
  }

  window.zdResolve = async function(docId, outcome){
    const r = returns.find(x => x.docId === docId);
    if(!r || (r.status || 'solicitada') !== 'solicitada') return;
    const TXT = {
      aprobada: 'La pieza llegó y PASÓ tu verificación.\n\n• La devolución queda aprobada (el reembolso al cliente lo haces tú, en Stripe o por transferencia).\n• La venta del vendedor pasa a "devuelta": deja de sumar a su saldo. Si ya se le había liquidado, ese monto se descuenta de su próxima liquidación.\n• La pieza regresa al inventario.\n\n¿Continuar?',
      no_autentica: 'La pieza NO pasó tu verificación de autenticidad.\n\n• El cliente recibe reembolso completo (lo haces tú).\n• La venta del vendedor pasa a "devuelta" y NO se le paga. Si ya se le había liquidado, se descuenta de su próxima liquidación.\n• La pieza NO regresa al inventario.\n• Después te pregunto si quieres pausar al vendedor.\n\n¿Continuar?',
      rechazada: 'La devolución NO procede (por ejemplo: la pieza llegó usada, dañada o distinta a la que se envió).\n\n• No hay reembolso y la venta del vendedor se queda como está.\n• Coordina tú con el cliente cómo regresarle la pieza.\n\n¿Continuar?'
    };
    if(!confirm(TXT[outcome])) return;
    const note = (prompt('Nota interna (opcional). Por ejemplo: "Etiqueta sin sello" o "Reembolsado en Stripe".', '') || '').trim().slice(0, 300);
    try{
      let res = { done:[], partial:[], already:[] };
      if(outcome !== 'rechazada') res = await returnSellerSales(r, outcome);
      await db.collection('returns').doc(docId).update({ status: outcome, resolvedAt: Date.now(), resolvedNote: note, affectedSales: res.done.map(s => s.id) });
      r.status = outcome; r.resolvedAt = Date.now(); r.resolvedNote = note;
      const out = [];
      if(outcome === 'aprobada'){
        try{ await restockItems(r.items); out.push('La pieza regresó al inventario.'); }
        catch(e){ console.error('[Devoluciones] stock', e); out.push('OJO: no se pudo devolver la pieza al inventario; súmala a mano en el almacén.'); }
      }
      if(res.done.length){
        // [Aviso automático] el vendedor se entera de que su venta se devolvió / canceló
        const mailedSeller = await window.zySellerEvent({ event:'sale-status', saleIds: res.done.map(s => s.id) });
        if(mailedSeller.sent) out.push('Se avisó al vendedor por correo.');
        const claw = res.done.filter(s => s.clawback > 0);
        out.push(res.done.length + (res.done.length === 1 ? ' venta de vendedor marcada como devuelta.' : ' ventas de vendedor marcadas como devueltas.'));
        if(claw.length) out.push('Ya se le había liquidado: se descontarán ' + money(claw.reduce((t, s) => t + s.clawback, 0)) + ' de su próxima liquidación.');
      } else if(outcome !== 'rechazada' && !res.partial.length && !res.already.length){
        out.push('No encontré venta de vendedor ligada a esta devolución (puede ser pieza propia de ZAYDE).');
      }
      if(res.partial.length) out.push('Devolución parcial (menos unidades que la venta): ajusta esa venta a mano en "Ventas vendedores".');
      if(res.already.length) out.push('Una venta ya estaba marcada como devuelta.');
      if(outcome === 'no_autentica' && res.done.length){
        const ids = Array.from(new Set(res.done.map(s => s.sellerId)));
        for(const sid of ids){
          let nm = (sellers[sid] || {}).name;
          if(!nm){ try{ const sd = await db.collection('sellers').doc(sid).get(); nm = sd.exists ? sd.data().name : null; }catch(e){} }
          nm = nm || 'este vendedor';
          if(confirm('¿Pausar a ' + nm + '? Perderá el acceso a su portal de inmediato (mismo criterio que tu política: se revoca el acceso a quien vende una pieza no auténtica).')){
            try{ await db.collection('sellers').doc(sid).set({ status:'pausado', updatedAt: Date.now() }, { merge:true }); out.push(nm + ' quedó en pausa.'); }
            catch(e){ out.push('No se pudo pausar a ' + nm + ': ' + friendlyErr(e)); }
          }
        }
      }
      const mailed = await notifyCustomerReturn(r, outcome === 'rechazada' ? 'Devolución no aprobada tras la inspección' : 'Devolución aprobada: reembolso en proceso');
      out.push(mailed ? 'Se avisó al cliente por correo.' : 'No se avisó al cliente por correo (sin correo registrado o falló el envío).');
      if(outcome !== 'rechazada') out.push('Recuerda hacer el reembolso al cliente.');
      dmsg(out.join(' '), true);
      if($('zyTabVentasVend') && $('zyTabVentasVend').style.display !== 'none') zvsLoad();
    }catch(e){
      console.error('[Devoluciones]', e);
      dmsg(friendlyErr(e), false);
    }
    zdRender();
  };

  // Mostrar/ocultar la pestaña (mismo patrón que Vendedores y Reventa)
  const orig = window.zyShowAdminTab;
  window.zyShowAdminTab = function(tab){
    orig.apply(this, arguments);
    const pane = $('zyTabVentasVend'), btn = $('zyTabBtnVentasVend');
    if(pane) pane.style.display = tab === 'ventasvend' ? '' : 'none';
    if(btn) btn.classList.toggle('active', tab === 'ventasvend');
    if(tab === 'ventasvend') zvsLoad();
    const dpane = $('zyTabDevoluciones'), dbtn = $('zyTabBtnDevoluciones');
    if(dpane) dpane.style.display = tab === 'devoluciones' ? '' : 'none';
    if(dbtn) dbtn.classList.toggle('active', tab === 'devoluciones');
    if(tab === 'devoluciones') zdLoad();
  };
})();
</script>
<script>
/* ================= [VENDEDORES · MEJORAS] Propuestas, transferencias y documentos =================
   Colecciones: sellerSubmissions (propuestas), sellerPayouts (estado/referencia), sellerDocs (documentos).
   Requiere publicar la versión nueva de firestore.rules. Todo lo escribe solo el admin. */
(function(){
  const $ = id => document.getElementById(id);
  const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const money = n => '$' + (Number(n) || 0).toLocaleString('es-MX', { minimumFractionDigits:2, maximumFractionDigits:2 });
  const fmtDate = ms => ms ? new Date(ms).toLocaleDateString('es-MX', { day:'numeric', month:'short', year:'numeric' }) : '';
  const ST = [['propuesta','Propuesta enviada'],['recibida','Recibida'],['autenticacion','En autenticación'],['publicada','Publicada'],['apartada','Apartada'],['vendida','Vendida'],['devuelta','Devuelta'],['rechazada','Rechazada']];
  const PST = [['','Sin estado (transferida)'],['programada','Programada'],['procesando','En proceso'],['transferida','Transferida'],['fallida','Fallida']];
  let subs = [], pays = [], docs = [], names = {};
  const opts = (list, cur) => list.map(([v, l]) => '<option value="' + v + '"' + (v === cur ? ' selected' : '') + '>' + l + '</option>').join('');
  function msg(text, ok){ const m = $('zvpMsg'); if(!m) return; m.textContent = text; m.className = 'zv-msg show ' + (ok ? 'ok' : 'err'); clearTimeout(msg._t); msg._t = setTimeout(() => { m.className = 'zv-msg'; }, ok ? 6000 : 12000); }
  const errTxt = e => (e && e.code === 'permission-denied') ? 'Firestore no te dejó guardar. Publica la versión nueva de firestore.rules (incluye sellerSubmissions y sellerDocs).' : ((e && (e.message || e.code)) || String(e));
  const thumbs = l => (Array.isArray(l) ? l : []).filter(u => typeof u === 'string' && /^(data:image\/|https:\/\/)/.test(u)).map(u => '<img src="' + esc(u) + '" alt="" style="width:64px;height:64px;object-fit:cover;border-radius:4px;cursor:pointer;" onclick="zvpBig(this.src)">').join('');
  window.zvpBig = src => { const w = window.open('', '_blank'); if(w){ w.document.title = 'Foto'; w.document.body.style.cssText = 'margin:0;background:#000;'; const i = w.document.createElement('img'); i.src = src; i.style.cssText = 'max-width:100%;display:block;margin:auto;'; w.document.body.appendChild(i); } };
  const shrink = (file, max, q) => new Promise((ok, no) => { const r = new FileReader(); r.onerror = no; r.onload = () => { const i = new Image(); i.onerror = no; i.onload = () => { const k = Math.min(1, max / Math.max(i.width, i.height)), c = document.createElement('canvas'); c.width = Math.round(i.width * k); c.height = Math.round(i.height * k); c.getContext('2d').drawImage(i, 0, 0, c.width, c.height); ok(c.toDataURL('image/jpeg', q)); }; i.src = r.result; }; r.readAsDataURL(file); });

  function render(){
    $('zvpCount').textContent = '(' + subs.length + ')';
    $('zvpList').innerHTML = subs.length ? subs.map(x => {
      const id = esc(x.id), bad = x.status === 'rechazada' || x.status === 'devuelta';
      return '<div class="zv-row"><div class="zv-row-top"><span class="zv-name">' + esc((x.brand ? x.brand + ' ' : '') + x.name) + '</span><span class="zv-badge">' + esc((ST.find(s => s[0] === x.status) || [0, x.status])[1]) + '</span></div>' +
        '<div class="zv-meta">' + esc([names[x.sellerId] || x.sellerName || 'Vendedor', fmtDate(x.createdAt), 'Talla ' + x.size, x.condition, x.category, money(x.price)].filter(Boolean).join(' · ')) + (x.desc ? '<br>' + esc(x.desc) : '') + '</div>' +
        '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;">' + thumbs(x.photos) + thumbs(x.proofs) + '</div>' +
        '<div class="zv-row-top" style="margin-top:10px;align-items:flex-end;"><div style="flex:1;min-width:150px;"><label>Estado</label><select id="zvpS_' + id + '">' + opts(ST, x.status) + '</select></div>' +
        '<div style="flex:1;min-width:130px;"><label>ID de la pieza publicada</label><input id="zvpP_' + id + '" value="' + esc(x.productId || '') + '" maxlength="100"></div></div>' +
        '<div style="margin-top:8px;"><label>Motivo (obligatorio si rechazas o devuelves)</label><input id="zvpR_' + id + '" value="' + esc(x.rejectReason || '') + '" maxlength="500"></div>' +
        '<div style="margin-top:8px;"><label>Fotos de verificación (hasta 3)</label><input id="zvpF_' + id + '" type="file" accept="image/*" multiple>' + (Array.isArray(x.verifyPhotos) && x.verifyPhotos.length ? '<div style="display:flex;gap:6px;margin-top:6px;">' + thumbs(x.verifyPhotos) + '</div>' : '') + '</div>' +
        '<div class="zv-actions"><button type="button" onclick="zvpSave(\'' + id + '\')">Guardar</button></div></div>';
    }).join('') : '<div class="zv-empty">Todavía no hay propuestas de vendedores.</div>';
    $('zvpPay').innerHTML = pays.length ? pays.map(p => { const id = esc(p.id);
      return '<div class="zv-row"><div class="zv-row-top"><span class="zv-name">' + esc(fmtDate(p.createdAt)) + ' · ' + esc(p.sellerName || names[p.sellerId] || '') + '</span><b>' + money(p.amount) + '</b></div>' +
        '<div class="zv-row-top" style="margin-top:8px;align-items:flex-end;"><div style="flex:1;min-width:150px;"><label>Estado</label><select id="zvpPS_' + id + '">' + opts(PST, p.status || '') + '</select></div>' +
        '<div style="flex:2;min-width:180px;"><label>Referencia</label><input id="zvpPR_' + id + '" value="' + esc(p.reference || '') + '" maxlength="120"></div></div>' +
        '<div class="zv-actions"><button type="button" onclick="zvpPaySave(\'' + id + '\')">Guardar</button></div></div>'; }).join('') : '<div class="zv-empty">Aún no hay liquidaciones registradas.</div>';
    $('zvpDocs').innerHTML = docs.length ? docs.map(d => '<div class="zv-row"><div class="zv-row-top"><span class="zv-name">' + esc(d.title || d.type || 'Documento') + '</span><span class="zv-badge">' + esc(d.type || '') + '</span></div><div class="zv-meta">' + esc([names[d.sellerId] || '', d.period, fmtDate(d.createdAt)].filter(Boolean).join(' · ')) + ' · <a href="' + esc(d.url || '#') + '" target="_blank" rel="noopener">Abrir</a></div><div class="zv-actions"><button type="button" onclick="zvpDocDel(\'' + esc(d.id) + '\')">Eliminar</button></div></div>').join('') : '<div class="zv-empty">Aún no has publicado documentos.</div>';
  }
  window.zvpLoad = async function(){
    if(typeof db === 'undefined' || !db || !$('zvpList')) return;
    try{
      const [a, b, c, d] = await Promise.all([db.collection('sellers').get(), db.collection('sellerSubmissions').orderBy('createdAt', 'desc').limit(200).get(), db.collection('sellerPayouts').limit(100).get(), db.collection('sellerDocs').orderBy('createdAt', 'desc').limit(100).get()]);
      names = {}; a.docs.forEach(x => { names[x.id] = x.data().name || x.data().email || x.id; });
      subs = b.docs.map(x => Object.assign({ id:x.id }, x.data()));
      pays = c.docs.map(x => Object.assign({ id:x.id }, x.data())).sort((p, q) => (q.createdAt || 0) - (p.createdAt || 0));
      docs = d.docs.map(x => Object.assign({ id:x.id }, x.data()));
      const sel = $('zvpDocSeller'), prev = sel.value;
      sel.innerHTML = a.docs.map(x => '<option value="' + esc(x.id) + '">' + esc(names[x.id]) + '</option>').join(''); if(names[prev]) sel.value = prev;
      render();
    }catch(e){ console.error('[Propuestas vendedores]', e); $('zvpList').innerHTML = '<div class="zv-empty">No se pudo cargar. ' + esc(errTxt(e)) + '</div>'; }
  };
  window.zvpSave = async function(id){
    const x = subs.find(s => s.id === id); if(!x) return;
    const g = p => $(p + id), st = g('zvpS_').value, reason = g('zvpR_').value.trim().slice(0, 500), pid = g('zvpP_').value.trim().slice(0, 100), files = Array.from(g('zvpF_').files).slice(0, 3);
    if((st === 'rechazada' || st === 'devuelta') && !reason){ msg('Escribe el motivo para rechazar o devolver la pieza.', false); return; }
    const at = Date.now(), patch = { status:st, statusUpdatedAt:at, rejectReason:reason, productId:pid };
    if(st !== x.status) patch.history = firebase.firestore.FieldValue.arrayUnion({ status:st, at });
    try{
      if(files.length){
        const used = [].concat(x.photos || [], x.proofs || [], x.verifyPhotos || []).join('').length, room = 940000 - used;
        let out = null;
        for(const [m, q] of [[800, .6], [600, .5], [480, .4]]){ const r = await Promise.all(files.map(f => shrink(f, m, q))); if(r.join('').length <= room){ out = r; break; } }
        if(!out){ msg('Las fotos no caben en esta propuesta. Sube menos o más ligeras.', false); return; }
        patch.verifyPhotos = out;
      }
      await db.collection('sellerSubmissions').doc(id).update(patch);
      msg('Propuesta guardada: el vendedor ya ve el nuevo estado.', true); zvpLoad();
    }catch(e){ console.error(e); msg(errTxt(e), false); }
  };
  window.zvpPaySave = async function(id){
    const p = pays.find(s => s.id === id); if(!p) return;
    const st = $('zvpPS_' + id).value, patch = { status:st, reference:$('zvpPR_' + id).value.trim().slice(0, 120) };
    if(st === 'transferida' && !p.paidAt) patch.paidAt = Date.now();
    try{ await db.collection('sellerPayouts').doc(id).update(patch); msg('Transferencia actualizada.', true); zvpLoad(); }catch(e){ console.error(e); msg(errTxt(e), false); }
  };
  window.zvpDocAdd = async function(){
    const sid = $('zvpDocSeller').value, url = $('zvpDocUrl').value.trim();
    if(!sid){ msg('Elige un vendedor.', false); return; }
    if(!/^https:\/\//.test(url)){ msg('El enlace debe empezar con https://', false); return; }
    try{
      await db.collection('sellerDocs').add({ sellerId:sid, type:$('zvpDocType').value, period:$('zvpDocPeriod').value.trim().slice(0, 40), title:$('zvpDocTitle').value.trim().slice(0, 100), url, createdAt:Date.now() });
      ['zvpDocPeriod','zvpDocTitle','zvpDocUrl'].forEach(i => { $(i).value = ''; }); msg('Documento publicado.', true); zvpLoad();
    }catch(e){ console.error(e); msg(errTxt(e), false); }
  };
  window.zvpDocDel = async function(id){
    if(!confirm('¿Eliminar este documento? El vendedor dejará de verlo.')) return;
    try{ await db.collection('sellerDocs').doc(id).delete(); msg('Documento eliminado.', true); zvpLoad(); }catch(e){ console.error(e); msg(errTxt(e), false); }
  };
  // Aviso en vivo: propuestas nuevas (insignia en las pestañas + aviso emergente)
  function badge(n){
    ['zyTabBtnVentasVend', 'zyTabBtnVendedores'].forEach(id => {
      const b = $(id); if(!b) return; let s = b.querySelector('.zvp-b');
      if(!n){ if(s) s.remove(); return; }
      if(!s){ s = document.createElement('span'); s.className = 'zvp-b'; s.style.cssText = 'margin-left:6px;background:#e0245e;color:#fff;border-radius:999px;padding:1px 7px;font-size:10px;font-weight:800;'; b.appendChild(s); }
      s.textContent = n;
    });
  }
  let watchOff = null;
  function watch(user){
    if(watchOff){ watchOff(); watchOff = null; }
    if(!user || user.isAnonymous || typeof db === 'undefined' || !db) return;
    let first = true;
    watchOff = db.collection('sellerSubmissions').where('status', '==', 'propuesta').onSnapshot(snap => {
      badge(snap.size);
      if(!first) snap.docChanges().forEach(c => {
        if(c.type !== 'added') return; const d = c.doc.data();
        if(typeof showToast === 'function') showToast('Nueva propuesta: ' + ((d.brand ? d.brand + ' ' : '') + d.name) + ' · ' + (d.sellerName || 'vendedor'));
        try{ navigator.vibrate && navigator.vibrate(80); }catch(e){}
        if($('zvpList') && $('zvpList').children.length) zvpLoad();
      });
      first = false;
    }, () => { if(watchOff){ watchOff(); watchOff = null; } }); // sin permisos (no eres admin): se apaga solo
  }
  try{ if(window.firebase && firebase.auth) firebase.auth().onAuthStateChanged(watch); }catch(e){}
  // Se carga junto con la pestaña de ventas de vendedores
  const orig = window.zvsLoad;
  window.zvsLoad = async function(){ const r = orig ? await orig.apply(this, arguments) : undefined; zvpLoad(); return r; };
})();
</script>

