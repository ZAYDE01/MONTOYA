    type:'bar',
    data:{ labels: topProducts.map(t=>t[0]), datasets:[{ label:'Unidades vendidas', data: topProducts.map(t=>t[1]), backgroundColor:colBrass }] },
    options:{ indexAxis:'y', responsive:true, plugins:{legend:{display:false}}, scales:{ x:{grid:{color:colLine}, ticks:{precision:0}}, y:{grid:{display:false}} } }
  });
  {
    const c = document.getElementById('zyChartTopProducts');
    const summary = topProducts.length ? topProducts.map(t=>`${t[0]}: ${t[1]} unidades`).join(', ') : 'sin ventas registradas todavía';
    if(c) c.setAttribute('aria-label', `Productos más vendidos — ${summary}.`);
  }

  // ---- Distribución de reseñas (todo el sitio) ----
  const starCounts = [1,2,3,4,5].map(s=> reviews.filter(r=>r.stars===s).length);
  zyDestroyChart('reviews');
  zyCharts.reviews = new Chart(document.getElementById('zyChartReviews'), {
    type:'bar',
    data:{ labels:['1★','2★','3★','4★','5★'], datasets:[{ label:'Reseñas', data:starCounts, backgroundColor:colBrass }] },
    options:{ responsive:true, plugins:{legend:{display:false}}, scales:{ x:{grid:{display:false}}, y:{grid:{color:colLine}, ticks:{precision:0}} } }
  });
  {
