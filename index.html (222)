/* [SWIPE-TALLAS] Selección rápida arrastrando: al empezar sobre una talla
   apagada se ENCIENDEN todas las que cruces; si empiezas sobre una prendida
   se APAGAN. Mouse: arrastra directo. Celular: desliza en horizontal, o
   mantén presionado ~0.3 s y arrastra en cualquier dirección (así el
   scroll vertical normal de la pantalla sigue funcionando). */
(function zyInitSizeDragSelect(){
  function init(){
    const grid = document.getElementById('zySizeGrid');
    if(!grid || grid.__dragInit) return;
    grid.__dragInit = true;
    let startBtn=null, mode='add', dragging=false, sx=0, sy=0, lx=0, ly=0, armed=false, timer=null, touchMode=false;
    const btnAt = (x,y)=>{
      const el = document.elementFromPoint(x,y);
      return (el && el.closest) ? el.closest('#zySizeGrid .size-opt') : null;
    };
    const apply = b=>{
      if(!b) return;
      const want = (mode==='add');
      if(b.classList.contains('active') !== want) b.classList.toggle('active', want);
    };
    const applyLine = (x0,y0,x1,y1)=>{
      const dist = Math.hypot(x1-x0, y1-y0);
      const steps = Math.max(1, Math.ceil(dist/8));
      for(let i=1;i<=steps;i++) apply(btnAt(x0+(x1-x0)*i/steps, y0+(y1-y0)*i/steps));
    };
    const begin = (b,x,y,isTouch)=>{
      startBtn=b; touchMode=isTouch; dragging=false; armed=false;
      mode = b.classList.contains('active') ? 'remove' : 'add';
      sx=lx=x; sy=ly=y;
      clearTimeout(timer);
      if(isTouch) timer = setTimeout(()=>{ if(startBtn && !dragging){ armed=true; dragging=true; apply(startBtn); if(navigator.vibrate) try{navigator.vibrate(15);}catch(e){} } }, 300);
    };
    const move = (x,y,e)=>{
      if(!startBtn) return;
      if(!dragging){
        const dx=x-sx, dy=y-sy;
        if(touchMode){
          if(Math.abs(dx)>8 && Math.abs(dx)>Math.abs(dy)){ dragging=true; apply(startBtn); }
          else if(Math.abs(dy)>8){ clearTimeout(timer); startBtn=null; return; } // es scroll vertical
        } else {
          const cur = btnAt(x,y);
          if(cur && cur!==startBtn){ dragging=true; apply(startBtn); }
        }
      }
      if(dragging){
        if(e && e.cancelable) e.preventDefault();
        applyLine(lx,ly,x,y);
        lx=x; ly=y;
      }
    };
    const end = ()=>{
      clearTimeout(timer);
      if(dragging){
        window.zySizeDragged = true;
        setTimeout(()=>{ window.zySizeDragged = false; }, 350);
        zySyncSizesInput();
      }
      startBtn=null; dragging=false; armed=false;
    };
    grid.addEventListener('mousedown', e=>{
      if(e.button!==0) return;
      const b = e.target.closest && e.target.closest('.size-opt'); if(!b) return;
      begin(b,e.clientX,e.clientY,false);
    });
    document.addEventListener('mousemove', e=>{ if(startBtn && !touchMode) move(e.clientX,e.clientY,e); });
    document.addEventListener('mouseup', ()=>{ if(startBtn && !touchMode) end(); });
    grid.addEventListener('touchstart', e=>{
      const b = e.target.closest && e.target.closest('.size-opt'); if(!b || e.touches.length!==1) return;
      const t=e.touches[0]; begin(b,t.clientX,t.clientY,true);
    }, {passive:true});
    grid.addEventListener('touchmove', e=>{
      if(!startBtn) return; const t=e.touches[0]; move(t.clientX,t.clientY,e);
    }, {passive:false});
    grid.addEventListener('touchend', end);
    grid.addEventListener('touchcancel', end);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
