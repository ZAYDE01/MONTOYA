/* [MARGEN POR PEDIDO + RESPALDO] Se agrega al final de la pestaña "Analítica" del panel.
   - Calculadora: ganancia real por pedido pagado = (subtotal − descuento + envío cobrado) − comisión de cobro − costo real de envío − costo de mercancía.
   - Respaldo: descarga un JSON con productos, pedidos y ajustes; avisa si ya pasaron 7 días del último.
   Los parámetros se guardan solo en este navegador. No toca pedidos ni ventas. */
const ZY_MARGIN_KEY = 'zayde:marginCfg';
const ZY_BACKUP_KEY = 'zayde:lastBackupAt';
const ZY_BACKUP_COLS = ['admin_products','admin_overrides','admin_meta','inventory','orders','memberships','giftBalances','sellers','sellerHelpers','sellerSales','sellerSalesPrivate','sellerPayouts','sellerDocs','sellerSubmissions','sellerTickets','sellerChangeRequests','stockLog','priceHistory','reviews','newsletterSubscribers','dropSubscribers'];   // returns y giftcards no están en las reglas: el respaldo semanal de GitHub sí los incluye
let zyMgOrders = [];
function zyMgMoney(n){ return new Intl.NumberFormat('es-MX',{style:'currency',currency:'MXN',minimumFractionDigits:2,maximumFractionDigits:2}).format(Number(n)||0); }
function zyMgCfg(){
  const d = { feePct:3.6, feeFixed:3, feeIva:true, priceIva:true, shipCost:0, cogsPct:0 };
  try{ return Object.assign(d, JSON.parse(localStorage.getItem(ZY_MARGIN_KEY) || '{}')); }catch(e){ return d; }
}
function zyMgReadCfg(){
  const num = (id, def) => { const el = document.getElementById(id); const v = el ? parseFloat(el.value) : NaN; return isFinite(v) && v >= 0 ? v : def; };
  const iva = document.getElementById('zyMgFeeIva'), piva = document.getElementById('zyMgPriceIva');
  const cfg = { feePct:num('zyMgFeePct',3.6), feeFixed:num('zyMgFeeFixed',3), feeIva: iva ? iva.checked : true, priceIva: piva ? piva.checked : true, shipCost:num('zyMgShipCost',0), cogsPct:Math.min(100, num('zyMgCogs',0)) };
  try{ localStorage.setItem(ZY_MARGIN_KEY, JSON.stringify(cfg)); }catch(e){}
  return cfg;
}
function zyMgCalc(o, cfg){
  const items = o.items || [];
  const physical = items.filter(i => !i.isMembership && !i.isGiftCard);
  const subtotal = Number(o.subtotal) || 0, disc = Number(o.coupon && o.coupon.discount) || 0, ship = Number(o.shipping) || 0, total = Number(o.total) || 0;
  const income = (Math.max(0, subtotal - disc) + ship) / (cfg.priceIva ? 1.16 : 1);   // si los precios incluyen IVA, el ingreso real es sin IVA
  const fee = (o.paymentMethod === 'stripe' && total > 0) ? (total * cfg.feePct / 100 + cfg.feeFixed) * (cfg.feeIva ? 1.16 : 1) : 0;
  const shipCost = (o.shipMode === 'domicilio' && physical.length) ? cfg.shipCost : 0;
  const cogs = physical.reduce((a, i) => a + (Number(i.price) || 0) * (Number(i.qty) || 1), 0) * cfg.cogsPct / 100;
  const net = income - fee - shipCost - cogs;
  return { income, disc, ship, fee, shipCost, cogs, net, pct: income > 0 ? net / income * 100 : 0 };
}
function zyMarginRecalc(){
  const cfg = zyMgReadCfg();
  const res = document.getElementById('zyMgResult'); if(!res) return;
  const month = (document.getElementById('zyMgMonth') || {}).value || '';
  const key = ms => { const d = new Date(ms); return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0'); };
  const list = zyMgOrders.filter(o => o.paymentStatus === 'pagado' && (!month || (o.date && key(o.date) === month))).sort((a, b) => (b.date || 0) - (a.date || 0));
  if(!list.length){ res.innerHTML = '<p class="zy-quickhint">No hay pedidos pagados' + (month ? ' en ese mes' : '') + ' para calcular.</p>'; }
  else {
    const rows = list.map(o => ({ o, m: zyMgCalc(o, cfg) }));
    const T = rows.reduce((t, r) => { for(const k of ['income','disc','fee','shipCost','cogs','net']) t[k] += r.m[k]; return t; }, { income:0, disc:0, fee:0, shipCost:0, cogs:0, net:0 });
    const card = (l, v) => '<div class="zy-stat-card"><span class="zy-stat-label">' + l + '</span><span class="zy-stat-value">' + v + '</span></div>';
    res.innerHTML =
      '<div class="zy-stats-grid">' + card('Ingreso (sin tarjeta regalo)', zyMgMoney(T.income)) + card('Descuentos dados', zyMgMoney(T.disc)) + card('Comisión de cobro', zyMgMoney(T.fee)) +
      card('Ganancia real', zyMgMoney(T.net)) + card('Margen', (T.income > 0 ? (T.net / T.income * 100).toFixed(1) : '0.0') + '%') + '</div>' +
      '<div style="overflow-x:auto;margin-top:12px;"><table style="width:100%;border-collapse:collapse;font-size:13px;white-space:nowrap;"><thead><tr style="text-align:left;opacity:.7;"><th>Pedido</th><th>Ingreso</th><th>Desc.</th><th>Comisión</th><th>Envío real</th><th>Mercancía</th><th>Ganancia</th><th>Margen</th></tr></thead><tbody>' +
      rows.slice(0, 40).map(({ o, m }) => '<tr style="border-top:1px solid rgba(128,128,128,.25);"><td>' + String(o.orderNum || '').replace(/[<>&"]/g, '') + '</td><td>' + zyMgMoney(m.income) + '</td><td>' + zyMgMoney(m.disc) + '</td><td>' + zyMgMoney(m.fee) + '</td><td>' + zyMgMoney(m.shipCost) + '</td><td>' + zyMgMoney(m.cogs) + '</td><td><b>' + zyMgMoney(m.net) + '</b></td><td>' + m.pct.toFixed(1) + '%</td></tr>').join('') +
      '</tbody></table></div>' + (rows.length > 40 ? '<p class="zy-quickhint">Se muestran los 40 más recientes; los totales incluyen los ' + rows.length + ' pedidos.</p>' : '');
  }
  // Simulador de un pedido (para probar reglas antes de cambiarlas)
  const sim = document.getElementById('zySimOut');
  if(sim){
    const v = id => Math.max(0, parseFloat((document.getElementById(id) || {}).value) || 0);
    const fake = { subtotal:v('zySimSub'), coupon:{ discount: v('zySimSub') * Math.min(100, v('zySimDisc')) / 100 }, shipping:v('zySimShip'), total:0, paymentMethod:'stripe', shipMode:'domicilio', items:[{ price:v('zySimSub'), qty:1 }] };
    fake.total = Math.max(0, fake.subtotal - fake.coupon.discount) + fake.shipping;
    const m = zyMgCalc(fake, cfg);
    sim.innerHTML = 'Ingreso ' + zyMgMoney(m.income) + ' · comisión ' + zyMgMoney(m.fee) + ' · envío real ' + zyMgMoney(m.shipCost) + ' · mercancía ' + zyMgMoney(m.cogs) + ' → <b>ganancia ' + zyMgMoney(m.net) + ' (' + m.pct.toFixed(1) + '%)</b>';
  }
}
async function zyDownloadBackup(){
  if(typeof db === 'undefined' || !db){ showToast('Firestore no está disponible: no hay nada que respaldar', true); return; }
  const out = { _meta:{ app:'ZAYDE', at:new Date().toISOString(), version:1 }, collections:{}, errors:{} };
  for(const c of ZY_BACKUP_COLS){
    try{ const snap = await db.collection(c).get(); out.collections[c] = snap.docs.map(d => ({ id:d.id, data:d.data() })); }
    catch(e){ out.errors[c] = String((e && e.message) || e); }
  }
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([JSON.stringify(out)], { type:'application/json' }));
  a.download = 'respaldo-zayde-' + new Date().toISOString().slice(0, 10) + '.json';
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(() => URL.revokeObjectURL(a.href), 4000);
  try{ localStorage.setItem(ZY_BACKUP_KEY, String(Date.now())); }catch(e){}
  const bad = Object.keys(out.errors);
  showToast(bad.length ? 'Respaldo descargado, pero no se pudo leer: ' + bad.join(', ') : 'Respaldo descargado', bad.length > 0);
  zyBackupStatus();
}
function zyBackupStatus(){
  const el = document.getElementById('zyBackupStatus'); if(!el) return;
  let at = 0; try{ at = parseInt(localStorage.getItem(ZY_BACKUP_KEY) || '0', 10) || 0; }catch(e){}
  if(!at){ el.innerHTML = '⚠️ Aún no has descargado ningún respaldo desde este navegador.'; return; }
  const days = Math.floor((Date.now() - at) / 86400000);
  el.innerHTML = (days >= 7 ? '⚠️ ' : '✅ ') + 'Último respaldo: ' + (days === 0 ? 'hoy' : 'hace ' + days + (days === 1 ? ' día' : ' días')) + (days >= 7 ? ' — toca hacer otro.' : '.');
}
