/* [DESCUENTO-AUTO] Recalcula la vista previa cada vez que el admin teclea
   el precio original o el % de descuento — sin esperar a guardar. El
   campo "Precio original" es siempre el precio de lista (antes del
   descuento); el precio que de verdad se cobra (y el que se guarda como
   product.price en todo el sitio) se calcula aquí mismo con la misma
   fórmula que usa zyAddProduct() al guardar, así la vista previa siempre
   coincide exacto con lo que terminará viendo el cliente. */
function zyUpdateDiscountPreview(){
  const originalPrice = zyListPrice(parseInt(document.getElementById('zyPrice').value) || 0);   // ya con el % de envío si la casilla está marcada
  const discountPct = Math.max(0, Math.min(90, parseInt(document.getElementById('zyDiscountPct').value) || 0));
  const box = document.getElementById('zyDiscountPreview');
  if(!box) return;
  if(!originalPrice){ box.style.display = 'none'; return; }
  const money = n => '$' + Math.round(n).toLocaleString('es-MX') + ' MXN';
  const finalEl = document.getElementById('zyDiscountPreviewFinal');
  const oldEl = document.getElementById('zyDiscountPreviewOld');
  const badgeEl = document.getElementById('zyDiscountPreviewBadge');
  if(discountPct > 0){
    const finalPrice = Math.round(originalPrice * (1 - discountPct/100));
    finalEl.textContent = money(finalPrice);
    oldEl.textContent = money(originalPrice);
    oldEl.style.display = '';
    badgeEl.textContent = `${discountPct}% OFF`;
    badgeEl.style.display = '';
  } else {
    finalEl.textContent = money(originalPrice);
    oldEl.style.display = 'none';
    badgeEl.style.display = 'none';
  }
  box.style.display = 'flex';
}

