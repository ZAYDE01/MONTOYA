/* ================= [NAV-REVEAL] Header que se oculta al bajar y
   reaparece al mínimo scroll hacia arriba =================
   Objetivo: en cualquier punto de la página (incluso hasta abajo del
   todo), basta con el más mínimo gesto de scroll hacia arriba para que
   el header (buscador, menú, íconos) reaparezca de inmediato — sin tener
   que subir manualmente hasta el tope. Al bajar, el header se oculta
   (vía transform, ver CSS .zy-nav-hidden) para dar más espacio de
   lectura, pero solo después de bajar un poco (ZY_NAV_REVEAL_HIDE_AFTER)
   para que no "parpadee" justo al empezar a scrollear desde arriba. */
const ZY_NAV_REVEAL_HIDE_AFTER = 80; // px — no se oculta hasta pasar este punto
function zyInitNavReveal(){
  const header = document.querySelector('header');
  if(!header) return;

  // [FIX] La versión anterior de esta función medía el scroll dentro de un
  // requestAnimationFrame y, por separado, trataba de "adelantarse" leyendo
  // el movimiento crudo del dedo en touchmove. En la práctica, en varios
  // navegadores móviles ese segundo camino no disparaba show() de forma
  // confiable (por el orden en que el navegador entrega scroll vs touch, o
  // porque la bandera `ticking` podía quedarse atorada en true) y el
  // resultado que veía el cliente era que el header nunca reaparecía. Esta
  // versión usa un solo camino, simple y directo, apoyado 100% en el
  // evento nativo "scroll" — que en todos los navegadores modernos,
  // incluido iOS Safari, se dispara de forma continua durante el gesto —
  // comparando la posición actual contra la última conocida en cada evento.
  let lastY = window.scrollY || window.pageYOffset || 0;
  // [FIX — "el header se ve pegado al scroll / no reaparece firme"] Antes
  // hide() y show() se disparaban en CADA evento "scroll" comparando solo
  // contra el frame anterior — y durante el scroll inercial de celular
  // (el que sigue moviéndose solo unos instantes después de soltar el
  // dedo) es normal que haya micro-frames que aún reportan movimiento
  // "hacia abajo" justo después de uno "hacia arriba". Resultado: el
  // header alcanzaba a aparecer un instante y se volvía a esconder de
  // inmediato, dando la sensación de que iba pegado al scroll en vez de
  // reaparecer de un jalón. Ahora, cada vez que show() se dispara por un
  // gesto hacia arriba, queda un breve "colchón" (SHOW_LOCK_MS) durante
  // el cual se ignoran los hide() que lleguen justo después — así el
  // header se queda firme y visible en cuanto se nota el más mínimo
  // scroll hacia arriba, sin parpadeos, tanto en computadora (mouse/
  // trackpad) como en celular (dedo + inercia). */
  const SHOW_LOCK_MS = 260;
  let showLockUntil = 0;
  function show(){ header.classList.remove('zy-nav-hidden'); showLockUntil = Date.now() + SHOW_LOCK_MS; }
  function hide(){ if(Date.now() < showLockUntil) return; header.classList.add('zy-nav-hidden'); }
  // [HEADER FLOTANTE SOBRE EL HERO] Solo mientras estemos literalmente en
  // el tope de Inicio (scroll casi en 0, video/foto del hero recién
  // visible) el header flota transparente encima de ella (ver
  // .header-overlay en el CSS) — igual que pandora.net. En cuanto se
  // hace CUALQUIER scroll (bajando o subiendo de vuelta desde más abajo),
  // recupera su fondo sólido normal; ya no depende del alto del hero.
  // [FIX] Antes esto comparaba contra la altura casi completa del hero
  // (heroH-80, casi 100% de la pantalla al ser un video de pantalla
  // completa estilo Pandora), así que casi cualquier scroll hacia arriba
  // seguía cayendo "dentro" de esa zona y el header nunca recuperaba su
  // fondo sólido — por eso nunca se veía la barra con su recuadro negro
  // al subir. Ahora usa el mismo umbral chico que el resto del header
  // (ZY_NAV_REVEAL_HIDE_AFTER), así el comportamiento es: en el tope
  // absoluto = transparente; en cuanto te mueves de ahí (para donde sea)
  // = sólido, sin importar si sigues "dentro" del alto del hero.
  function updateHeaderOverlay(y){
    let heroEl = document.getElementById('homeHero');
    if(heroEl && (heroEl.offsetParent === null || heroEl.classList.contains('zh'))) heroEl = null;   /* [PALACIO] banner con carrusel: header sólido, no flota */
    //   // [PORTADA OCULTA EN PC] sin portada visible el header no flota
    const marquee = document.getElementById('marqueeBar');
    // [FIX-BRINCO] Esto se decide SOLO por si estamos en Inicio (no por el
    // scroll), así nunca cambia a media navegación — es justo lo que
    // evita el salto del fondo. Ver .zy-home-fixed en el CSS: fija el
    // header en position:fixed todo el tiempo que estemos en Inicio, para
    // que nunca reserve/deje de reservar espacio en la página.
    header.classList.toggle('zy-home-fixed', currentPage==='home' && !!heroEl);
    if(currentPage!=='home' || !heroEl){
      header.classList.remove('header-overlay');
      if(marquee) marquee.classList.remove('zy-hide-on-hero');
      return;
    }
    const isOverlay = y <= ZY_NAV_REVEAL_HIDE_AFTER;
    header.classList.toggle('header-overlay', isOverlay);
    // [FIX-HERO-OVERLAP] Misma condición que el header transparente: solo
    // se oculta la franja de anuncios mientras el video de pantalla
    // completa está a la vista arriba del todo (ver CSS .zy-hide-on-hero).
    if(marquee) marquee.classList.toggle('zy-hide-on-hero', isOverlay);
  }
  function onScroll(){
    const y = Math.max(0, window.scrollY || window.pageYOffset || 0);
    if(y <= ZY_NAV_REVEAL_HIDE_AFTER){
      // cerca del tope: siempre visible, sin importar la dirección
      show();
    } else if(y > lastY){
      // scrolleando hacia abajo (cualquier cantidad): se oculta
      hide();
    } else if(y < lastY){
      // CUALQUIER movimiento hacia arriba, por mínimo que sea: reaparece
      show();
    }
    lastY = y;
    updateHeaderOverlay(y);
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  window.zyUpdateHeaderOverlay = ()=>updateHeaderOverlay(Math.max(0, window.scrollY||window.pageYOffset||0));
  // Estado inicial correcto si la página carga con el scroll ya movido
  // (por ejemplo, al volver con el botón "Atrás" del navegador).
  onScroll();
}
if(document.readyState === 'loading'){
  document.addEventListener('DOMContentLoaded', zyInitNavReveal);
} else {
  zyInitNavReveal();
}

