<script>
/* ===== UBICACIÓN MÁS EXACTA ===== */
function zyGetPreciseLocation(onFirst,onRefine,onFail,opts){
  opts=opts||{}; const TARGET_M=10, REFINE_MS=25000, GIVEUP_MS=20000;
  let first=false,best=null,ended=false,rt=null,gu=null;
  const stop=()=>{ended=true; if(zyGeoWatchId!==null){navigator.geolocation.clearWatch(zyGeoWatchId);zyGeoWatchId=null;} clearTimeout(rt);clearTimeout(gu);};
  const fail=e=>{if(!first&&!ended){stop();onFail(e);}};
  const gotFix=pos=>{
    if(ended) return; const acc=pos.coords.accuracy;
    if(!first){first=true;best=pos;clearTimeout(gu);onFirst(pos); if(opts.fast||acc<=TARGET_M){stop();return;} rt=setTimeout(stop,REFINE_MS); return;}
    if(acc<best.coords.accuracy*0.9){best=pos; if(onRefine)onRefine(pos); if(acc<=TARGET_M)stop();}
  };
  stop(); ended=false;
  const err=e=>{if(e&&e.code===1)fail(e);};
  navigator.geolocation.getCurrentPosition(gotFix,err,opts.fast?{enableHighAccuracy:false,timeout:7000,maximumAge:30000}:{enableHighAccuracy:false,timeout:5000,maximumAge:0});
  if(!opts.fast) zyGeoWatchId=navigator.geolocation.watchPosition(gotFix,err,{enableHighAccuracy:true,timeout:20000,maximumAge:0});
  gu=setTimeout(()=>fail({code:3}),GIVEUP_MS);
}
/* No rellena la dirección con una lectura muy imprecisa (>300 m): espera al GPS; si nunca mejora, la usa a los 9 s. */
const _zyRG=reverseGeocodeIntoForm; let _zyRGt=null,_zyRGf=null;
reverseGeocodeIntoForm=function(c,acc){
  clearTimeout(_zyRGt); clearTimeout(_zyRGf);
  if(acc!=null&&acc>300){
    const r=document.getElementById('geoReadout');
    if(r) r.innerHTML=`<span><span class="zy-spin"></span> Afinando tu ubicación… ±${Math.round(acc)} m</span>`;
    _zyRGf=setTimeout(()=>_zyRG(c,acc),9000); return;
  }
  _zyRGt=setTimeout(()=>_zyRG(c,acc),acc==null?0:600);
};
/* Búsqueda de la dirección escrita: prueba varias formas, de la más exacta a la más general. */
function zyLocateTypedAddress(silent){
  const v=id=>((document.getElementById(id)||{}).value||'').trim();
  const addr=v('ckAddress'),city=v('ckCity'),zip=v('ckZip'),st=v('ckState');
  if(!addr&&!zip&&!city){showToast('Escribe primero tu calle, colonia y código postal',true);return;}
  const H={headers:{'Accept-Language':'es'}}, e=encodeURIComponent;
  const base='https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=mx&';
  const tries=[
    ['q='+e([addr,city,zip,st,'México'].filter(Boolean).join(', ')),true],
    ['street='+e(addr.split(',')[0])+'&city='+e(city)+'&postalcode='+e(zip)+'&state='+e(st),true],
    ['q='+e([addr.split(',')[0],city,st,'México'].filter(Boolean).join(', ')),true],
    ['q='+e([zip,city,st,'México'].filter(Boolean).join(', ')),false]
  ];
  const readout=document.getElementById('geoReadout');
  if(readout) readout.innerHTML='<span><span class="zy-spin"></span> Buscando tu dirección en el mapa…</span>';
  const run=i=>i>=tries.length?Promise.resolve(null):fetch(base+tries[i][0],H).then(r=>r.json()).then(r=>r.length?{r,exacta:tries[i][1]}:run(i+1));
  run(0).then(res=>{
    if(!res){ if(readout) readout.innerHTML='<span class="geo-empty">No encontramos esa dirección en el mapa. Revisa los datos o usa «Usar mi ubicación».</span>'; (silent||showToast('No encontramos esa dirección en el mapa',true)); return; }
    const c={lat:+res.r[0].lat,lng:+res.r[0].lon}; userCoords=c; zyPinTouched=false; zyShowDeliveryMap(c,null);
    if(readout) readout.innerHTML=`<span><b>Lat</b> ${c.lat.toFixed(5)}</span><span><b>Lng</b> ${c.lng.toFixed(5)}</span><span>${res.exacta?'Pin colocado según tu dirección. Arrástralo hasta tu puerta para mayor exactitud':'Pin colocado en tu zona: arrástralo hasta tu puerta'}</span>`;
  }).catch(()=>{ if(readout) readout.innerHTML='<span class="geo-empty">No pudimos buscar la dirección ahora. Intenta con «Usar mi ubicación».</span>'; });
}
</script>
