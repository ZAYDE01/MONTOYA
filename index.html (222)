/* [UBICACIÓN AUTOMÁTICA + SOLO MÉXICO]
   - Al escribir el código postal (5 dígitos) se elige solo el estado y se completa la ciudad/municipio.
   - Al escribir la calle (con CP válido) el pin del mapa se coloca solo; el cliente lo puede mover.
   - Los pedidos con dirección fuera de México no pasan: CP que no existe en México, estado fuera de la lista, o pin fuera de
     México (el geocodificador de OpenStreetMap lo confirma por país). El servidor repite la revisión antes de cobrar. */
const ZY_MX_BBOX = { latMin:14.3, latMax:32.9, lngMin:-118.7, lngMax:-86.4 };
function zyInMexicoBox(c){ return !!c && isFinite(c.lat) && isFinite(c.lng) && c.lat >= ZY_MX_BBOX.latMin && c.lat <= ZY_MX_BBOX.latMax && c.lng >= ZY_MX_BBOX.lngMin && c.lng <= ZY_MX_BBOX.lngMax; }
const ZY_ZIP_STATE = [[1,16,'Ciudad de México'],[20,20,'Aguascalientes'],[21,22,'Baja California'],[23,23,'Baja California Sur'],[24,24,'Campeche'],[25,27,'Coahuila'],[28,28,'Colima'],[29,30,'Chiapas'],[31,33,'Chihuahua'],[34,35,'Durango'],[36,38,'Guanajuato'],[39,41,'Guerrero'],[42,43,'Hidalgo'],[44,49,'Jalisco'],[50,57,'Estado de México'],[58,61,'Michoacán'],[62,62,'Morelos'],[63,63,'Nayarit'],[64,67,'Nuevo León'],[68,71,'Oaxaca'],[72,75,'Puebla'],[76,76,'Querétaro'],[77,77,'Quintana Roo'],[78,79,'San Luis Potosí'],[80,82,'Sinaloa'],[83,85,'Sonora'],[86,86,'Tabasco'],[87,89,'Tamaulipas'],[90,90,'Tlaxcala'],[91,96,'Veracruz'],[97,97,'Yucatán'],[98,99,'Zacatecas']];
function zyStateFromZip(zip){
  const z = String(zip || '');
  if(!/^\d{5}$/.test(z)) return '';
  const p = parseInt(z.slice(0, 2), 10);
  const r = ZY_ZIP_STATE.find(x => p >= x[0] && p <= x[1]);
  return r ? r[2] : '';
}
function zyMexicoAddressError(){
  const zip = ((document.getElementById('ckZip') || {}).value || '').trim();
  if(!zyStateFromZip(zip)) return 'Ese código postal no existe en México. Solo enviamos dentro de México.';
  if(window.zyForeignPin) return 'La ubicación del mapa está fuera de México. Solo enviamos dentro de México.';
  const c = (typeof zyDeliveryCoords !== 'undefined' && zyDeliveryCoords) || userCoords;
  if(c && !zyInMexicoBox(c)) return 'La ubicación del mapa está fuera de México. Solo enviamos dentro de México.';
  return '';
}
let zyZipTimer = null, zyZipLast = '', zyAutoLocTimer = null;
async function zyAutofillFromZip(zip){
  const st = zyStateFromZip(zip);
  if(!st){ showToast('Ese código postal no existe en México. Solo enviamos dentro de México.', true); return; }
  zyZipLast = zip;
  const stSel = document.getElementById('ckState');
  if(stSel && stSel.value !== st){ stSel.value = st; try{ renderShipOptions(); }catch(e){} }
  const cityEl = document.getElementById('ckCity');
  if(cityEl && !cityEl.value.trim()){
    try{
      const r = await fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&countrycodes=mx&addressdetails=1&postalcode=' + zip, { headers:{ 'Accept-Language':'es' } });
      const j = await r.json();
      const a = (j[0] && j[0].address) || {};
      const city = a.city || a.town || a.village || a.municipality || a.county || '';
      if(city && !cityEl.value.trim()) cityEl.value = city;
