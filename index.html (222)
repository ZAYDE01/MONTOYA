/* ================= [EN VIVO] Cambios del admin al instante, sin recargar =================
   Antes el sitio leía lo que guardas en el panel (productos, textos, inicio, banners,
   cupones, categorías…) UNA sola vez al abrir la página, por eso había que recargar.
   Ahora cada guardado "toca" un documento pequeño de versión en Firestore y todas las
   pantallas abiertas (otro dispositivo, otra pestaña, clientes navegando) lo escuchan:
   al cambiar, se vuelve a leer todo y se repinta en el momento, sin recargar la página.
   Es un solo documento (1 lectura + 1 por cambio), no escucha las colecciones completas,
   así que casi no suma costo de Firestore. Sin Firestore, las otras pestañas del mismo
   navegador se enteran por el evento "storage". */
const ZY_LIVE_VERSION_KEY = 'zayde:admin:liveVersion';
const ZY_LIVE_ID = 'lv-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
let zyLiveTimer = null, zyLiveBusy = false, zyLiveAgain = false, zyLiveBaseline = null;
function zyLiveBump(){
  try{
    if(typeof db === 'undefined' || !db) return;
    db.collection('admin_meta').doc(encodeURIComponent(ZY_LIVE_VERSION_KEY)).set({ value: Date.now(), by: ZY_LIVE_ID }).catch(()=>{});
  }catch(e){}
}
function zyLiveSchedule(){
  clearTimeout(zyLiveTimer);
  zyLiveTimer = setTimeout(zyLiveRefresh, 500);
}
function zyStartLiveContentSync(){
  try{
    if(typeof db !== 'undefined' && db){
      db.collection('admin_meta').doc(encodeURIComponent(ZY_LIVE_VERSION_KEY)).onSnapshot(snap=>{
        if(snap.metadata && (snap.metadata.hasPendingWrites || snap.metadata.fromCache)) return;
        const d = snap.exists ? snap.data() : null;
        const v = d ? d.value : 0;
        if(zyLiveBaseline === null){ zyLiveBaseline = v; return; }   // primera lectura: solo marca el punto de partida
        if(v === zyLiveBaseline) return;
        zyLiveBaseline = v;
        if(d && d.by === ZY_LIVE_ID) return;                          // lo guardé yo: ya se repintó solo
        zyLiveSchedule();
      }, err=>console.warn('Sincronización en vivo no disponible:', err && err.code));
    }
  }catch(e){}
  window.addEventListener('storage', ev=>{
    if(ev.key && String(ev.key).indexOf('zayde:admin:') === 0) zyLiveSchedule();
  });
}
