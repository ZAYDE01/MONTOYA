/* Genera un código de cupón aleatorio y único (nunca el ZAYDE ID del
   cliente, ni ningún otro dato suyo), verificando que no choque con
   ningún cupón ya existente. Formato: SOCIO-XXXXXX (letras/números). */
function zyGenerateUniqueCouponCode(){
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; // sin 0/O/1/I para evitar confusiones al teclear
  let code;
  do{
    let rand = '';
    for(let i=0;i<6;i++) rand += chars[Math.floor(Math.random()*chars.length)];
    code = 'SOCIO-'+rand;
  } while(zyCouponsData[code]);
  return code;
}
/* Crea el cupón de socio con un código ALEATORIO y ÚNICO (nunca el ZAYDE ID
   del cliente — ver zyGenerateUniqueCouponCode) con 10% de descuento,
   marcado como singleUse: en cuanto se canjea una vez, en cualquier pedido
   y sea quien sea quien lo use, queda desactivado para siempre (ver
   zyRedeemCouponIfSingleUse en el checkout). Se guarda en AdminStore junto
   con los demás cupones — aparece también editable en la pestaña "Cupones"
   por si quieres cambiarle el valor después — y la relación cliente→cupón
   se guarda aparte en zySocioCoupons para poder encontrarlo de nuevo al
   volver a escanear al mismo cliente.
   Se dispara automáticamente desde zyLookupMemberByCode en cuanto el
   cliente alcanza ZY_FREQUENT_BUYER_THRESHOLD pedidos y aún no tiene
   cupón — el admin ya no necesita generarlo a mano. Avisa al cliente
   por DOS canales: WhatsApp (semi-automático, requiere darle "Enviar")
   y correo (100% automático vía /api/send-email, si dejó su
   email en algún pedido). */
function zyGenerateMemberCoupon(memberCode, phone, email, name, notifyEmail, notifyWhatsapp){
  const code = zyGenerateUniqueCouponCode();
  zyCouponsData[code] = { type:'pct', value:10, singleUse:true, redeemed:false, memberCode, createdAt: Date.now() };
  zySocioCoupons[memberCode] = code;
  AdminStore.set('zayde:admin:coupons', zyCouponsData);
  AdminStore.set('zayde:admin:socioCoupons', zySocioCoupons);
  showToast(`Cupón de socio ${code} creado — 10% en su siguiente compra`);
  if(notifyWhatsapp!==false) zyShareMemberCoupon(code, phone);
  if(email && notifyEmail!==false) zySendMemberCouponEmail(code, email, name);
  zyLookupMemberByCode(memberCode); // repinta para mostrar "reenviar" en vez de "generar"
}
/* Envío automático real del cupón de socio al correo del cliente, vía
   el mismo backend de Resend (/api/send-coupon-email, necesita
   RESEND_API_KEY en Vercel — igual que /api/send-status-email y
   /api/send-drop-email) que ya usa el sitio para los avisos de pedidos.
   No requiere ninguna acción del admin: se dispara solo en cuanto se
   genera el cupón. Si el endpoint aún no está desplegado o falla, se
   avisa con un toast pero el cupón ya quedó creado de todas formas. */
async function zySendMemberCouponEmail(code, email, name){
  try{
    const token = await zyGetIdToken();   // [SEGURIDAD] el servidor ahora exige la sesión del admin para mandar este correo
    const res = await fetch('/api/send-email', {
      method:'POST',
      headers:Object.assign({'Content-Type':'application/json'}, token ? {'Authorization':'Bearer ' + token} : {}),
      body: JSON.stringify({ type: 'coupon', to: email, name: name||'', code, value:10 })
    });
    const data = await res.json().catch(()=>({}));
    if(!res.ok){
      showToast(`Cupón creado, pero no se pudo enviar el correo: ${data.error || 'error desconocido'}`, true);
      console.error('Error enviando email de cupón de socio:', data);
    }
  }catch(e){
    showToast('Cupón creado, pero no se pudo conectar con el servidor de email', true);
    console.error('No se pudo enviar el email del cupón de socio:', e);
  }
}
function zyShareMemberCoupon(code, phone){
