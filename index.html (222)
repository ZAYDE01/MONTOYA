/* [NOMBRE ZAPATOS] Lo guardado antes en la nube/navegador puede traer "Sneakers" o "Zapatos en general".
   Al leerlo se cambia a "Zapatos" (valores y nombres de clave), sin tocar URLs ni imágenes. */
function zyNormShoes(v){
  if(typeof v === 'string'){
    if(v.length > 600 || /^(https?:|data:|\/|blob:)/.test(v)) return v;
    return v.replace(/\bSneakers\b/g,'Zapatos').replace(/\bSNEAKERS\b/g,'ZAPATOS').replace(/Zapatos en general/g,'Zapatos').replace(/zapatos en general/g,'zapatos');
  }
  if(Array.isArray(v)) return v.map(zyNormShoes);
  if(v && typeof v === 'object'){
    const o = {};
    Object.keys(v).forEach(k=>{ const nk = (k==='Sneakers' || k==='Zapatos en general') ? 'Zapatos' : k; if(!(nk in o) || nk===k) o[nk] = zyNormShoes(v[nk===k?k:k]); });
    return o;
  }
  return v;
}
