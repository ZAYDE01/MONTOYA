<script>
/* ============================================================
   [HERO-CARRUSEL · ESTILO PALACIO DE HIERRO] — varias imágenes en el
   recuadro de inicio. Datos: zySettings.heroSlides = [{id,img,imgM,text,
   cta,link,pos:'right|left|center',tone:'light|dark'}]. Si está vacío se
   usa el video/foto de siempre (heroBgVideo / heroBgImage) o, en su
   defecto, las piezas más vistas del catálogo.
   ============================================================ */
(function(){
  var Z={i:0,n:0,slides:[],timer:null,hover:false,x0:null,dx:0,moved:false,bound:false};
  var esc=function(t){return String(t==null?'':t).replace(/[&<>"']/g,function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c];});};
  var CHEV='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg>';
  var CHEVL='<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg>';
  var S=function(){ try{ return zySettings; }catch(e){ return {}; } };

  function getSlides(bySeed){
    var st=S(), custom=(st.heroSlides||[]).filter(function(x){return x&&(x.img||x.video);});
    if(custom.length) return custom;
    if(st.heroBgVideo) return [{video:st.heroBgVideo,cta:'DESCUBRIR'}];
    if(st.heroBgImage) return [{img:st.heroBgImage,cta:'DESCUBRIR'}];
    var list=bySeed;
    try{ if(!list) list=[].concat(zyBrowsable()).sort(function(a,b){return (b.views||0)-(a.views||0);}); }catch(e){ list=[]; }
    return list.filter(function(p){return p&&p.images&&p.images[0];}).slice(0,3).map(function(p){
      return {img:p.images[0],text:p.name||'',cta:'DESCUBRIR',pos:'right'};
    });
  }
  /* ---- [TEXTO EDITABLE] fuentes y estilos por diapositiva ---- */
  var FONTS=[
    {n:'',l:'Predeterminada (Playfair Display)',s:'',g:''},
    {n:'Playfair Display',l:'Playfair Display — serif editorial',s:"'Playfair Display',serif",g:'Playfair+Display:wght@400;500;600;700;800;900'},
    {n:'Bodoni Moda',l:'Bodoni Moda — serif de lujo',s:"'Bodoni Moda',serif",g:'Bodoni+Moda:wght@400;500;600;700;800;900'},
    {n:'Cormorant Garamond',l:'Cormorant Garamond — serif fina',s:"'Cormorant Garamond',serif",g:'Cormorant+Garamond:wght@400;500;600;700'},
    {n:'DM Serif Display',l:'DM Serif Display — serif elegante',s:"'DM Serif Display',serif",g:'DM+Serif+Display'},
    {n:'Abril Fatface',l:'Abril Fatface — display serif',s:"'Abril Fatface',serif",g:'Abril+Fatface'},
    {n:'Fraunces',l:'Fraunces — serif moderna',s:"'Fraunces',serif",g:'Fraunces:wght@400;500;600;700;800;900'},
    {n:'Lora',l:'Lora — serif suave',s:"'Lora',serif",g:'Lora:wght@400;500;600;700'},
    {n:'Montserrat',l:'Montserrat — sans geométrica',s:"'Montserrat',sans-serif",g:'Montserrat:wght@400;500;600;700;800;900'},
    {n:'Poppins',l:'Poppins — sans redonda',s:"'Poppins',sans-serif",g:'Poppins:wght@400;500;600;700;800;900'},
    {n:'Inter',l:'Inter — sans limpia',s:"'Inter',sans-serif",g:'Inter:wght@400;500;600;700;800;900'},
    {n:'Space Grotesk',l:'Space Grotesk — sans moderna',s:"'Space Grotesk',sans-serif",g:'Space+Grotesk:wght@400;500;600;700'},
    {n:'Oswald',l:'Oswald — condensada',s:"'Oswald',sans-serif",g:'Oswald:wght@400;500;600;700'},
    {n:'Bebas Neue',l:'Bebas Neue — condensada display',s:"'Bebas Neue',sans-serif",g:'Bebas+Neue'},
    {n:'Anton',l:'Anton — ultra bold condensada',s:"'Anton',sans-serif",g:'Anton'},
    {n:'Archivo Black',l:'Archivo Black — sans bold',s:"'Archivo Black',sans-serif",g:'Archivo+Black'},
    {n:'Unbounded',l:'Unbounded — futurista',s:"'Unbounded',sans-serif",g:'Unbounded:wght@400;500;600;700;800;900'},
    {n:'Dancing Script',l:'Dancing Script — manuscrita',s:"'Dancing Script',cursive",g:'Dancing+Script:wght@400;500;600;700'},
    {n:'Pacifico',l:'Pacifico — manuscrita gruesa',s:"'Pacifico',cursive",g:'Pacifico'},
    {n:'Georgia',l:'Georgia — serif del sistema',s:"Georgia,serif",g:''},
    {n:'Arial',l:'Arial — sans del sistema',s:"Arial,Helvetica,sans-serif",g:''},
    {n:'Impact',l:'Impact — condensada del sistema',s:"Impact,'Arial Narrow',sans-serif",g:''}
  ];
  function fontDef(n){ for(var i=0;i<FONTS.length;i++) if(FONTS[i].n===n) return FONTS[i]; return FONTS[0]; }
  function hexOk(v){ return typeof v==='string' && /^#[0-9a-f]{6}$/i.test(v); }
  function cl(v,a,b,d){ v=parseFloat(v); if(isNaN(v)) return d; return Math.max(a,Math.min(b,v)); }
  function oneOf(v,arr,d){ return arr.indexOf(v)>=0?v:d; }
  function loadFonts(list,all){
    var used={}, fam=[];
    (all?FONTS:(list||[]).map(function(s){return fontDef(s.font);})).forEach(function(f){ if(f&&f.g&&!used[f.n]){ used[f.n]=1; fam.push(f.g); } });
    if(!fam.length) return;
    var id=all?'zhFontsLinkE':'zhFontsLink', url='https://fonts.googleapis.com/css2?family='+fam.join('&family=')+'&display=swap';
    var ex=document.getElementById(id); if(ex && ex.getAttribute('href')===url) return;
    if(!ex){ ex=document.createElement('link'); ex.id=id; ex.rel='stylesheet'; document.head.appendChild(ex); }
    ex.href=url;
  }
  /* [VIDEO + IMAGEN DE CELULAR] Una diapositiva de VIDEO tambien puede tener imagen para celular (imgM):
     en pantallas de celular (<=760 px) se muestra esa imagen en lugar del video (ahorra datos y se ve 4:5). */
  var mmMob=(window.matchMedia?window.matchMedia('(max-width:760px)'):{matches:false});
  function mobVid(s){ return !!(s && s.videoM && mmMob.matches); }   // video propio para celular
  function mobImg(s){ return !!(s && s.video && s.imgM && !s.videoM && mmMob.matches); }
  try{ var _onMm=function(){ try{ render(); }catch(e){} }; if(mmMob.addEventListener) mmMob.addEventListener('change',_onMm); else if(mmMob.addListener) mmMob.addListener(_onMm); }catch(e){}
  function slideHTML(s,i,n,pv){
    var lines=String(s.text||'').split(/\n/).map(function(t){return t.trim();}).filter(Boolean);
    var sub=String(s.sub||'').trim();
    var cta=(s.cta===undefined||s.cta===null)?'DESCUBRIR':String(s.cta).trim();
    var alt=lines.join(' ')||'ZAYDE';
    var useM=mobImg(s);   // video + imagen de celular + pantalla de celular -> se muestra la imagen en vez del video
    var useV=mobVid(s);
    var media=((s.video || useV) && !useM)
      ? '<video src="'+esc(useV?s.videoM:s.video)+'" autoplay muted '+(n>1?'':'loop ')+'playsinline webkit-playsinline="true" preload="auto"></video>'
      : '<picture>'+(s.imgM?'<source media="(max-width:760px)" srcset="'+esc(s.imgM)+'">':'')+'<img src="'+esc(useM?s.imgM:s.img)+'" alt="'+esc(alt)+'" draggable="false" '+(i===0?'fetchpriority="high"':'loading="lazy"')+'></picture>';
    var shade=cl(s.shade,0,80,0);
    var shadeHtml=shade>0?'<i class="zh-shade" style="background:rgba(0,0,0,'+(shade/100).toFixed(2)+')"></i>':'';
    var pos=s.pos==='left'?'zh-l':(s.pos==='center'?'zh-c':'zh-r');
    var vcls=s.vpos==='top'?' zh-vt':(s.vpos==='bottom'?' zh-vb':(s.vpos==='middle'?' zh-vm':''));
    var scls=s.shadow==='none'?' zh-sn':(s.shadow==='strong'?' zh-ss':'');
    var ts=[];
    if(hexOk(s.color)) ts.push('color:'+s.color);
    var k=cl(s.size,40,300,100)/100; if(k!==1) ts.push('--zk:'+k);
    var al=oneOf(s.align,['left','center','right'],''); if(al) ts.push('--zt-al:'+al,'--zt-ai:'+(al==='left'?'flex-start':(al==='right'?'flex-end':'center')));
    var f=fontDef(s.font), hs=[];
    if(f.s) hs.push('font-family:'+f.s);
    if(oneOf(String(s.weight||''),['400','500','600','700','800','900'],'')) hs.push('font-weight:'+s.weight);
    if(s.italic) hs.push('font-style:italic');
    if(s.upper) hs.push('text-transform:uppercase');
    var ls=cl(s.spacing,-5,40,0); if(ls) hs.push('letter-spacing:'+(ls/100)+'em');
    var subStyle=f.s?' style="font-family:'+f.s+'"':'';
    var text=(lines.length||sub)
      ? '<div class="zh-text '+pos+vcls+scls+'"'+(ts.length?' style="'+esc(ts.join(';'))+'"':'')+'>'+
          (lines.length?'<h2 class="zh-title"'+(hs.length?' style="'+esc(hs.join(';'))+'"':'')+'>'+lines.map(function(l){return '<span>'+esc(l)+'</span>';}).join('')+'</h2>':'')+
          (sub?'<p class="zh-sub"'+subStyle+'>'+esc(sub)+'</p>':'')+
        '</div>'
      : '';
    /* [DESCUBRIR · ESQUINA INFERIOR DERECHA] el botón ya no vive dentro del bloque de texto: va suelto en la esquina. */
    var cs=[]; if(hexOk(s.ctaBg)) cs.push('background:'+s.ctaBg); if(hexOk(s.ctaColor)) cs.push('color:'+s.ctaColor);
    var ctaHtml=cta?'<span class="zh-cta"'+(cs.length?' style="'+esc(cs.join(';'))+'"':'')+'>'+esc(cta)+CHEV+'</span>':'';
    var attrs=pv?'':' role="link" tabindex="'+(i===0?'0':'-1')+'" aria-roledescription="slide" aria-label="'+esc(alt)+' ('+(i+1)+' de '+n+')" onclick="zhOpen('+i+')" onkeydown="if(event.key===\'Enter\')zhOpen('+i+')"';
    return '<article class="zh-slide'+(s.tone==='dark'?' zh-dark':'')+'" data-i="'+i+'"'+attrs+'>'+media+shadeHtml+text+ctaHtml+'</article>';
  }
  function render(bySeed){
    var stage=document.getElementById('zhStage'); if(!stage) return;
    var hero=document.getElementById('homeHero');
    var bg=document.getElementById('heroBg'); if(bg && bg.firstChild) bg.innerHTML='';   // detiene el video viejo oculto
    var sl=Z.slides=getSlides(bySeed), n=Z.n=sl.length;
    try{ loadFonts(sl); }catch(e){}
    if(hero) hero.classList.toggle('zh-m', sl.some(function(x){return !!(x.imgM||x.videoM);}));
    if(!n){ stage.innerHTML=''; clearTimeout(Z.timer); return; }
    if(Z.i>=n) Z.i=0;
    var many=n>1;
    stage.innerHTML='<div class="zh-track" id="zhTrack">'+sl.map(function(s,i){return slideHTML(s,i,n);}).join('')+'</div>'+
      (many?'<button type="button" class="zh-arrow zh-prev" data-zh="prev" aria-label="Anterior">'+CHEVL+'</button><button type="button" class="zh-arrow zh-next" data-zh="next" aria-label="Siguiente">'+CHEV+'</button>'+
      '<div class="zh-dots">'+sl.map(function(_,i){return '<button type="button" class="zh-dot" data-zh="'+i+'" aria-label="Ir a la imagen '+(i+1)+'"></button>';}).join('')+'</div>'+
      '<div class="zh-count" aria-hidden="true"><b id="zhNow">01</b> / '+String(n).padStart(2,'0')+'</div><i class="zh-bar" id="zhBar"></i>':'');
    bind(stage); go(Z.i);
  }
  var DELAY=6000;
  /* [VIDEO] Una diapositiva con video dura lo que dura el video (mín. 3 s, máx. 15.5 s); las de imagen, 6 s. */
  function delayFor(){
    var s=Z.slides[Z.i];
    if(s && (s.video || mobVid(s)) && !mobImg(s)){
      var d=parseFloat(mobVid(s)?s.durM:s.dur);
      if(!(d>0)){ var v=document.querySelector('#zhTrack .zh-slide.active video'); d=(v&&v.duration>0&&isFinite(v.duration))?v.duration:0; }
      if(d>0) return Math.max(3000,Math.min(d*1000,15500));
    }
    return DELAY;
  }
  function tick(){
    clearTimeout(Z.timer);
    var dl=delayFor();
    var bar=document.getElementById('zhBar');
    if(bar){ bar.classList.remove('run'); void bar.offsetWidth; bar.style.animationDuration=(dl/1000)+'s'; if(Z.n>1&&!Z.hover&&!document.hidden) bar.classList.add('run'); }
    if(Z.n<2||document.hidden||Z.hover||window.matchMedia('(prefers-reduced-motion:reduce)').matches) return;
    Z.timer=setTimeout(function(){ if(Z.x0!=null) tick(); else go(Z.i+1); },dl);
  }
  function fit(){
    var hero=document.getElementById('homeHero'); if(!hero) return;
    var el=document.querySelector('#zhTrack .zh-slide.active'); if(!el) return;
