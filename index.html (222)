    box.innerHTML = `<div class="zy-reco is-warn"><span class="zy-reco-ico">${ICON.check}</span><div class="zy-reco-txt"><b>¿Cuál es tu talla?</b><small>Dínosla una vez y te la recomendamos en todas las piezas${cat === 'Zapatos' ? ' (talla MX)' : ''}.</small><div class="zy-reco-ask">${avail.slice(0, 14).map(s => `<button type="button" onclick="zyRecoSave('${cat}','${esc(s).replace(/'/g, "\\'")}')">${esc(ul(s))}</button>`).join('')}</div></div></div>`;
    return;
  }
  const t = tgt.size;
  const eq = (cat === 'Zapatos' && window.zyEqLine) ? window.zyEqLine(t, p.gender || 'Hombre') : '';
  const noteLine = tgt.note ? `<small>${esc(tgt.note)}${eq ? ' · ' + esc(eq) : ''}</small>` : `<small>${eq ? 'Equivale a ' + esc(eq) + ' · ' : ''}Basado en tu talla guardada en el perfil</small>`;
  if(sizes.includes(t) && stock(t) > 0){
    box.innerHTML = `<div class="zy-reco"><span class="zy-reco-ico">${ICON.check}</span><div class="zy-reco-txt">Recomendado para ti: <b>Talla ${esc(ul(t))}</b>${noteLine}</div><button type="button" class="zy-reco-btn" onclick="zyRecoPick('${esc(t)}')">Elegir</button></div>`;
    const b = sizeBtn(t); if(b) b.classList.add('zy-size-reco');
    return;
  }
  if(sizes.includes(t)){
    const alt = nearest(p, t, cat);
    box.innerHTML = `<div class="zy-reco is-warn"><span class="zy-reco-ico">${ICON.check}</span><div class="zy-reco-txt">Tu talla <b>${esc(ul(t))}</b> está agotada${alt ? ` · la más cercana disponible: <b>${esc(ul(alt))}</b>` : ''}${noteLine}</div><button type="button" class="zy-reco-btn" onclick="zyOpenNotifyStock(${p.id},'${esc(t)}')">Avísame</button></div>`;
    return;
  }
  const alt = nearest(p, t, cat);
  box.innerHTML = `<div class="zy-reco is-warn"><span class="zy-reco-ico">${ICON.check}</span><div class="zy-reco-txt">Esta pieza no se ofrece en tu talla <b>${esc(ul(t))}</b>${alt ? ` · la más cercana: <b>${esc(ul(alt))}</b>` : ''}${noteLine}</div>${alt ? `<button type="button" class="zy-reco-btn" onclick="zyRecoPick('${esc(alt)}')">Ver ${esc(alt)}</button>` : ''}</div>`;
};
(function watchPdpSizes(){
  const grid = document.getElementById('pdpSizes'); if(!grid) return;
  let t = null;
  new MutationObserver(() => { clearTimeout(t); t = setTimeout(async () => { if(!Object.keys(sizeProfile).length) await loadSizeProfile(); zyRenderSizeReco(); }, 30); }).observe(grid, { childList:true });
})();
loadSizeProfile();

/* ============================================================
   5 · BÚSQUEDA POR FOTO REDISEÑADA
   (misma visión real con MobileNet; solo cambian interfaz,
    estados de carga y manejo de errores)
   ============================================================ */
let psToken = 0, psLastFile = null;
const PS_HTML = `
  <button class="zy-close" onclick="closeImageSearchModal()" aria-label="Cerrar">&times;</button>
  <div class="zy-ps-head"><span class="zy-ps-ico">${ICON.cam}</span><h3>Buscar por foto</h3></div>
  <p class="zy-ps-lead">Sube una foto y encontramos piezas visualmente parecidas del catálogo. El análisis ocurre en tu dispositivo: tu foto no se sube a ningún servidor.</p>
  <div id="imgSearchPickRow">
    <div class="zy-drop" id="zyDropZone" tabindex="0" role="button" aria-label="Arrastra una foto aquí o elige un archivo">
      <div class="zy-drop-ico">${ICON.img}</div>
      <b>Arrastra una foto aquí</b>
      <span>o pégala con Ctrl/⌘ + V, súbela desde tu galería o toma una con la cámara</span>
      <div class="zy-drop-actions">
        <label class="btn btn-primary">Subir foto<input type="file" accept="image/*" id="imgSearchUpload" style="display:none" onchange="zyHandleImageFile(this.files[0])"></label>
        <label class="btn btn-ghost">Tomar foto<input type="file" accept="image/*" capture="environment" id="imgSearchCapture" style="display:none" onchange="zyHandleImageFile(this.files[0])"></label>
      </div>
      <div class="zy-ps-tips"><span>De frente</span><span>Buena luz</span><span>Una sola pieza</span></div>
    </div>
  </div>
  <div id="imgSearchPreviewBox" style="display:none">
    <div class="zy-ps-preview" id="zyPsPreview"><img id="imgSearchPreview" alt="Vista previa de la foto a buscar"><button type="button" class="zy-ps-change" onclick="zyPsReset()">Cambiar foto</button></div>
  </div>
  <div class="zy-ps-steps" id="zyPsSteps" hidden>
    <ol><li data-s="1"><i></i>Cargando el motor de visión</li><li data-s="2"><i></i>Analizando tu foto</li><li data-s="3"><i></i>Comparando con el catálogo</li></ol>
    <div class="zy-ps-bar"><i id="zyPsBar"></i></div>
  </div>
  <div id="imgSearchStatus" class="zy-ps-status" aria-live="polite"></div>
  <div class="grid" id="imgSearchResults" style="grid-template-columns:1fr 1fr; gap:12px;"></div>`;

function psStep(n, pct){
  const ol = document.querySelectorAll('#zyPsSteps li');
  ol.forEach(li => { const s = +li.dataset.s; li.classList.toggle('is-done', s < n); li.classList.toggle('is-active', s === n); });
  const bar = document.getElementById('zyPsBar'); if(bar) bar.style.width = (pct == null ? (n - 1) * 33 : pct) + '%';
}
function psShowSteps(on){
  const st = document.getElementById('zyPsSteps'); if(st) st.hidden = !on;
  const pv = document.getElementById('zyPsPreview'); if(pv) pv.classList.toggle('is-scanning', !!on);
}
function psMessage(title, sub, isError){
  const el = document.getElementById('imgSearchStatus');
  el.innerHTML = `<div class="zy-ps-msg${isError ? ' is-error' : ''}"><b>${esc(title)}</b>${esc(sub)}<div class="zy-ps-msg-actions">${psLastFile && isError ? '<button type="button" class="btn btn-primary" onclick="zyPsRetry()">Reintentar</button>' : ''}<button type="button" class="btn btn-ghost" onclick="zyPsReset()">Elegir otra foto</button></div></div>`;
}
window.zyPsReset = function(){
  psToken++; psLastFile = null;
  const $ = id => document.getElementById(id);
  const again = $('zyPsAgain'); if(again) again.remove();
  if($('imgSearchPickRow')) $('imgSearchPickRow').style.display = '';
  if($('imgSearchPreviewBox')) $('imgSearchPreviewBox').style.display = 'none';
  psShowSteps(false);
  if($('imgSearchStatus')) $('imgSearchStatus').innerHTML = '';
  if($('imgSearchResults')) $('imgSearchResults').innerHTML = '';
  ['imgSearchUpload', 'imgSearchCapture'].forEach(id => { if($(id)) $(id).value = ''; });
};
window.zyPsRetry = function(){ if(psLastFile) window.zyHandleImageFile(psLastFile); };

window.zyHandleImageFile = function(file){
  if(!file) return;
  const $ = id => document.getElementById(id);
  if(!/^image\//.test(file.type || '')){ psLastFile = null; $('imgSearchPickRow').style.display = ''; psMessage('Ese archivo no es una imagen', 'Prueba con una foto JPG, PNG o WebP.', false); return; }
  if(file.size > 12 * 1024 * 1024){ psLastFile = null; psMessage('La foto pesa demasiado', 'Elige una de menos de 12 MB.', false); return; }
  psLastFile = file;
  const token = ++psToken;
  const reader = new FileReader();
  reader.onerror = () => { if(token === psToken) psMessage('No pudimos leer la foto', 'Intenta con otra imagen.', true); };
  reader.onload = e => {
    if(token !== psToken) return;
    const img = $('imgSearchPreview');
    $('imgSearchPickRow').style.display = 'none';
    $('imgSearchPreviewBox').style.display = '';
    $('imgSearchStatus').innerHTML = '';
    $('imgSearchResults').innerHTML = '';
    psShowSteps(true); psStep(1, 6);
    img.onload = async () => {
      try{
        const model = await zyLoadVisionModel(() => { if(token === psToken) psStep(1, 18); });
        if(token !== psToken) return;
        psStep(2, 38);
        const q = await zyEmbedImage(model, img);
        if(token !== psToken) return;
        await psRun(model, q, token);
      }catch(err){
        console.error('Búsqueda por foto:', err);
        if(token !== psToken) return;
        psShowSteps(false);
        psMessage('No pudimos analizar tu foto', 'Revisa tu conexión a internet (el motor de visión se descarga la primera vez) e inténtalo de nuevo.', true);
      }
    };
    img.src = e.target.result;
  };
  reader.readAsDataURL(file);
};

async function psRun(model, queryEmbedding, token){
  const $ = id => document.getElementById(id);
  const res = $('imgSearchResults');
  const candidates = zyBrowsable().filter(p => p.images && p.images[0]);
  if(!candidates.length){ psShowSteps(false); psMessage('Aún no hay piezas para comparar', 'El catálogo todavía no tiene piezas con foto real.', false); return; }
  res.innerHTML = Array.from({length:4}, () => '<div class="zy-ps-skel"></div>').join('');
  const label = $('imgSearchStatus');
  let done = 0; const scored = []; const BATCH = 6;
  for(let i = 0; i < candidates.length; i += BATCH){
    if(token !== psToken) return;
    const batch = candidates.slice(i, i + BATCH);
    const embs = await Promise.all(batch.map(p => zyGetProductEmbedding(model, p)));
    embs.forEach((emb, idx) => { if(emb) scored.push({ p:batch[idx], sim:zyCosineSim(queryEmbedding, emb) }); });
    done += batch.length;
    psStep(3, 45 + Math.round(done / candidates.length * 55));
    label.innerHTML = `<small>Comparando ${Math.min(done, candidates.length)} de ${candidates.length} piezas…</small>`;
  }
  if(token !== psToken) return;
  psShowSteps(false);
  const ranked = scored.sort((a, b) => b.sim - a.sim).slice(0, 8);
  if(!ranked.length){ res.innerHTML = ''; psMessage('No encontramos piezas parecidas', 'Prueba con otra foto: de frente, con buena luz y una sola pieza.', false); return; }
  label.innerHTML = `${ranked.length} piezas parecidas a tu foto<small>De mayor a menor parecido</small>`;
  res.innerHTML = ranked.map((x, i) => `<div class="zy-ps-hit">${i === 0 ? '<span class="zy-ps-best">Mejor coincidencia</span>' : ''}${cardHTML(x.p)}</div>`).join('');
  if(!document.getElementById('zyPsAgain')){
    const b = document.createElement('button'); b.type = 'button'; b.id = 'zyPsAgain'; b.className = 'btn btn-ghost zy-ps-again'; b.textContent = 'Buscar con otra foto'; b.onclick = () => { b.remove(); zyPsReset(); };
    res.insertAdjacentElement('afterend', b);
  }
}
window.zyRunVisualSearch = (model, q) => psRun(model, q, psToken);

const _zyOISM = window.openImageSearchModal;
window.openImageSearchModal = function(){
  const r = _zyOISM.apply(this, arguments);
  zyPsReset();
  const again = document.getElementById('zyPsAgain'); if(again) again.remove();
  return r;
};
(function psInit(){
  const modal = document.getElementById('imageSearchModal'); if(!modal) return;
  const panel = modal.querySelector('.zy-panel'); if(!panel) return;
  panel.style.width = '560px'; panel.style.maxWidth = '94vw'; panel.style.maxHeight = '90vh';
  panel.innerHTML = PS_HTML;
  const zone = () => document.getElementById('zyDropZone');
  const isOpen = () => modal.classList.contains('open');
  ['dragenter', 'dragover'].forEach(ev => window.addEventListener(ev, e => { if(!isOpen()) return; e.preventDefault(); const z = zone(); if(z) z.classList.add('is-over'); }));
  ['dragleave', 'drop'].forEach(ev => window.addEventListener(ev, e => {
    if(!isOpen()) return;
    e.preventDefault(); const z = zone(); if(z) z.classList.remove('is-over');
    if(ev === 'drop'){ const f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]; if(f) zyHandleImageFile(f); }
  }));
  panel.addEventListener('keydown', e => { if((e.key === 'Enter' || e.key === ' ') && e.target.id === 'zyDropZone'){ e.preventDefault(); document.getElementById('imgSearchUpload').click(); } });
  document.addEventListener('paste', e => {
    if(!isOpen()) return;
    const it = [...((e.clipboardData && e.clipboardData.items) || [])].find(i => i.type && i.type.indexOf('image/') === 0);
    if(it){ e.preventDefault(); zyHandleImageFile(it.getAsFile()); }
  });
  // al abrir una pieza desde los resultados, se cierra el modal
  panel.addEventListener('click', e => { if(e.target.closest && e.target.closest('.zy-ps-hit [onclick*="openPDP"]')) setTimeout(closeImageSearchModal, 60); });
})();

/* Carga inicial de devoluciones para que el botón refleje solicitudes previas */
loadReturns();
})();
</script>

<script>
/* [REVENTA] Comisiones por categoría y línea + interruptor visible/oculto (oculto por defecto).
   Se guarda en zySettings.resale junto con el resto de ajustes del sitio. */
const ZY_RESALE_DEFAULTS = {
  zayde:{ 'Ropa':20, 'Zapatos':20, 'Perfumes':25, 'Relojes':25, 'Joyería':25, 'Lentes de sol':22.8, 'Bolsos':23.3, 'Gorras':22 }
};
function zyResaleCfg(){
  const r = (typeof zySettings !== 'undefined' && zySettings.resale) || {};
  const rd = Number(r.releaseDays);
  return { visible: r.visible === true, releaseDays: (isFinite(rd) && rd >= 0) ? rd : 5, fees: { zayde:Object.assign({}, ZY_RESALE_DEFAULTS.zayde, (r.fees||{}).zayde) } };
}
window.zyResaleFee = (line, cat) => { const v = zyResaleCfg().fees.zayde[cat]; return v == null ? null : Number(v); };
function zyResaleApply(){
  const c = zyResaleCfg();
  const card = document.getElementById('zyResaleCard'); if(card) card.style.display = c.visible ? '' : 'none';
  const box = document.getElementById('zyResalePublicFees');
  if(box){
    const row = (n, f) => `<div style="margin-bottom:10px"><b>${n}</b><div style="display:flex;flex-wrap:wrap;gap:6px 14px;font-size:13px;margin-top:4px;">${Object.entries(f).map(([k,v]) => `<span>${k}: <b>${v}%</b></span>`).join('')}</div></div>`;
    box.innerHTML = row('ZAYDE', c.fees.zayde);
  }
}
function zyResaleRenderAdmin(){
  const c = zyResaleCfg();
  document.getElementById('zyResaleVisible').checked = c.visible;
  const rdBox = document.getElementById('zyResaleReleaseDays'); if(rdBox) rdBox.value = c.releaseDays;
  const blk = (title, line) => '<div class="zr-card"><h4>' + title + '</h4>' + Object.entries(c.fees[line]).map(([k,v]) =>
    '<div class="zr-line"><span>' + k + '</span><span class="zr-pct"><input type="number" step="0.1" min="0" max="100" data-rs-line="' + line + '" data-rs-cat="' + k + '" value="' + v + '" oninput="zrCalc()"> %</span></div>').join('') + '</div>';
  document.getElementById('zyResaleFeeBox').innerHTML = blk('ZAYDE', 'zayde');
  const sel = document.getElementById('zrCalcCat');
  if(sel){
    const prev = sel.value;
    sel.innerHTML = Object.keys(c.fees.zayde).map(k => '<option value="zayde|' + k + '">ZAYDE · ' + k + '</option>').join('');
    if(prev) sel.value = prev;
  }
  zrCalc();
}
// Calculadora: usa lo que está escrito en los campos (aunque aún no se guarde)
window.zrCalc = function(){
  const sel = document.getElementById('zrCalcCat'); if(!sel || !sel.value) return;
  const [line, cat] = sel.value.split('|');
  const inp = document.querySelector('#zyResaleFeeBox input[data-rs-line="' + line + '"][data-rs-cat="' + cat + '"]');
  const pct = inp ? (parseFloat(inp.value) || 0) : 0;
  const price = parseFloat(document.getElementById('zrCalcPrice').value) || 0;
  const fee = Math.round(price * pct) / 100;
  const money = n => '$' + n.toLocaleString('es-MX', {maximumFractionDigits:2});
  document.getElementById('zrCalcFee').textContent = money(fee);
  document.getElementById('zrCalcNet').textContent = money(price - fee);
  document.getElementById('zrCalcPct').textContent = pct + '%';
};
window.zyResaleSave = function(){
  const fees = { zayde:{} };
  document.querySelectorAll('#zyResaleFeeBox input[data-rs-line]').forEach(i => { const v = parseFloat(i.value); if(isFinite(v)) fees[i.dataset.rsLine][i.dataset.rsCat] = v; });
  const rdIn = parseInt((document.getElementById('zyResaleReleaseDays') || {}).value, 10);
  const releaseDays = (isFinite(rdIn) && rdIn >= 0 && rdIn <= 90) ? rdIn : 5;
  zySettings.resale = { visible: document.getElementById('zyResaleVisible').checked, fees, releaseDays };
  AdminStore.set('zayde:admin:homeSettings', zySettings);
  zyResaleApply(); showToast('Reventa guardada · ' + (zySettings.resale.visible ? 'visible al público' : 'oculta'));
};
(function(){
  const orig = window.zyShowAdminTab;
  window.zyShowAdminTab = function(tab){
    orig.apply(this, arguments);
    const pane = document.getElementById('zyTabReventa'), btn = document.getElementById('zyTabBtnReventa');
    if(pane) pane.style.display = tab === 'reventa' ? '' : 'none';
    if(btn) btn.classList.toggle('active', tab === 'reventa');
    if(tab === 'reventa') zyResaleRenderAdmin();
  };
  let n = 0; const t = setInterval(() => { zyResaleApply(); if(++n > 20) clearInterval(t); }, 1000);
})();
</script>
<script>
/* ===== [SOPORTE VENDEDORES] sellerTickets: ver, cambiar estado y responder ===== */
(function(){
  const $ = id => document.getElementById(id), E = v => String(v == null ? '' : v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const TY = { soporte:'Soporte general', disputa:'Disputa de devolución', regreso:'Regreso de piezas', envio:'Duda de envío' };
  let T = [];
  let PR = [];
  window.zsPayLoad = async function(){
    const box = $('zsPay'); if(!box) return;
    try{ const snap = await db.collection('sellerChangeRequests').orderBy('createdAt', 'desc').limit(50).get(); PR = snap.docs.map(d => Object.assign({ id:d.id }, d.data())); zsPayRender(); }
    catch(e){ console.error('[Cambios de pago]', e); box.innerHTML = ''; }
  };
  window.zsPayRender = function(){
    const L = PR.filter(x => x.status === 'pendiente');
    $('zsPay').innerHTML = '<h4 style="margin:14px 0 8px;">Cambios de datos de pago pendientes (' + L.length + ')</h4>' + (L.map(x => '<div style="border:1px solid var(--signal);border-radius:var(--r-md);padding:14px;margin-bottom:10px;background:var(--surface);">' +
      '<b>' + E(x.sellerName) + '</b> · ' + E(x.email) + ' · <span style="color:var(--steel)">' + new Date(x.createdAt || 0).toLocaleString('es-MX') + '</span>' +
      '<div style="margin:8px 0;"><b>Antes:</b> ' + E(x.oldPayout || '—') + '<br><b>Nuevo:</b> ' + E(x.bank) + ' · ' + E(x.holder) + ' · CLABE ' + E(x.clabe) + '</div>' +
      '<p style="color:var(--steel);font-size:12px;margin:0 0 8px;">Antes de aprobar, confirma con el vendedor por WhatsApp o llamada que él pidió el cambio.</p>' +
      '<button type="button" class="zy-admin-tab" onclick="zsPayOk(\'' + x.id + '\')">Aprobar</button> <button type="button" class="zy-admin-tab" onclick="zsPayNo(\'' + x.id + '\')">Rechazar</button></div>').join('') || '<div class="zv-empty">Sin solicitudes pendientes.</div>');
  };
  window.zsPayOk = async function(id){
    const r = PR.find(x => x.id === id); if(!r) return;
    if(!confirm('¿Confirmaste con ' + r.sellerName + ' que este cambio es suyo?\n\n' + r.bank + ' · ' + r.holder + ' · CLABE ' + r.clabe + '\n\nSe usarán estos datos en sus próximos pagos.')) return;
    try{
      const b = db.batch(), at = Date.now();
      b.set(db.collection('sellers').doc(r.sellerId), { payout: r.bank + ' · ' + r.holder + ' · CLABE ' + r.clabe, payoutUpdatedAt: at }, { merge:true });
      b.update(db.collection('sellerChangeRequests').doc(id), { status:'aprobada', reviewedAt: at });
      await b.commit(); r.status = 'aprobada'; zsPayRender(); if(typeof showToast === 'function') showToast('Cambio aprobado');
    }catch(e){ console.error(e); alert('No se pudo aprobar: ' + (e && e.code || e)); }
  };
  window.zsPayNo = async function(id){
    const r = PR.find(x => x.id === id); if(!r) return;
    const why = prompt('Motivo del rechazo (el vendedor lo verá):', 'No pudimos confirmar el cambio. Contáctanos.'); if(why === null) return;
    try{ await db.collection('sellerChangeRequests').doc(id).update({ status:'rechazada', reason:String(why).slice(0, 200), reviewedAt:Date.now() }); r.status = 'rechazada'; zsPayRender(); }
    catch(e){ console.error(e); alert('No se pudo rechazar: ' + (e && e.code || e)); }
  };
  window.zsLoad = async function(){
    const box = $('zsList'); if(!box) return;
    if(typeof db === 'undefined' || !db){ box.innerHTML = '<div class="zv-empty">Firestore no está disponible. Entra como administrador y recarga.</div>'; return; }
    box.innerHTML = '<div class="zv-empty">Cargando…</div>';
    zsPayLoad();
    try{ const snap = await db.collection('sellerTickets').orderBy('createdAt', 'desc').limit(200).get(); T = snap.docs.map(d => Object.assign({ id:d.id }, d.data())); zsRender(); }
    catch(e){ console.error('[Soporte]', e); box.innerHTML = '<div class="zv-empty">No se pudo cargar. Revisa las reglas de Firestore para sellerTickets.</div>'; }
  };
  window.zsRender = function(){
    const f = $('zsFilter').value, L = T.filter(x => !f || (x.status || 'abierto') === f);
    $('zsList').innerHTML = L.map(x => '<div style="border:1px solid var(--line);border-radius:var(--r-md);padding:14px;margin-bottom:10px;background:var(--surface);">' +
      '<b>' + E(x.folio) + '</b> · ' + E(TY[x.type] || x.type) + ' · <span style="color:var(--steel)">' + E(x.sellerName || '') + ' · ' + new Date(x.createdAt || 0).toLocaleDateString('es-MX') + '</span>' +
      '<div style="margin:6px 0;"><b>' + E(x.subject) + '</b>' + (x.ref ? ' <small>(' + E(x.ref) + ')</small>' : '') + '<br>' + E(x.message) + '</div>' +
      '<select id="zsS_' + x.id + '">' + [['abierto','Abierto'],['revision','En revisión'],['resuelto','Resuelto'],['cerrado','Cerrado']].map(o => '<option value="' + o[0] + '"' + ((x.status || 'abierto') === o[0] ? ' selected' : '') + '>' + o[1] + '</option>').join('') + '</select>' +
      '<textarea id="zsR_' + x.id + '" rows="2" style="width:100%;margin:8px 0;" placeholder="Respuesta para el vendedor">' + E(x.reply || '') + '</textarea>' +
      '<button type="button" class="zy-admin-tab" onclick="zsSave(\'' + x.id + '\')">Guardar respuesta</button></div>').join('') || '<div class="zv-empty">Sin reportes.</div>';
  };
  window.zsSave = async function(id){
    const reply = $('zsR_' + id).value.trim().slice(0, 1000), status = $('zsS_' + id).value;
    try{ await db.collection('sellerTickets').doc(id).update({ status, reply, repliedAt: Date.now() }); const t = T.find(x => x.id === id); if(t){ t.status = status; t.reply = reply; } if(typeof showToast === 'function') showToast('Respuesta guardada'); }
    catch(e){ console.error(e); alert('No se pudo guardar: ' + (e && e.code || e)); }
  };
  const orig = window.zyShowAdminTab;
  window.zyShowAdminTab = function(tab){
