function zyEditProduct(id){
  const p = PRODUCTS.find(x=>x.id===id);
  if(!p) return;
  // Antes esto solo llenaba el formulario sin mostrarlo: si estabas parado en
  // la pestaña "Almacén", el clic en "Editar" no parecía hacer nada porque el
  // formulario vive en la pestaña "+ Agregar producto". Ahora cambia de
  // pestaña automáticamente para que el formulario lleno quede a la vista.
  zyShowAdminTab('productos');
  zyEditingId = id;
  zyEditingStockRef = Object.assign({}, p.stock || {});
  // [BOLSOS] stock guardado como "Única" pasa a "Unitalla" al editar
  if(p.category==='Bolsos' && zyEditingStockRef['Única']!==undefined && zyEditingStockRef['Unitalla']===undefined){ zyEditingStockRef['Unitalla'] = zyEditingStockRef['Única']; delete zyEditingStockRef['Única']; }
  zyEditingPriceRef = {};
  document.getElementById('zyPriceBySizeGrid').innerHTML = '';
  if(p.sizePrices){
    Object.keys(p.sizePrices).forEach(k=>{
      const v = p.sizePrices[k];
      zyEditingPriceRef[k] = (p.discountPct && p.discountPct > 0) ? Math.round(v / (1 - p.discountPct/100)) : v;
    });
  }
  zySetSection(p.category);
  zySetStore(p.store || 'zayde');
  zyRefreshSellerSelect(p.sellerId || '');
  document.getElementById('zyBrand').value = p.brand;
  document.getElementById('zyName').value = p.name;
  // [DESCUENTO-AUTO] El campo "Precio original" siempre debe mostrar el
  // precio DE LISTA, no lo que el cliente paga hoy. Como product.price ya
  // guarda el precio final (con el descuento ya aplicado — ver
  // zyAddProduct()), aquí se reconstruye el original con la fórmula
  // inversa antes de meterlo al campo. Si no se hiciera esto, al volver a
  // guardar sin tocar nada el descuento se aplicaría una segunda vez sobre
  // un precio que ya lo traía aplicado, y el precio final bajaría solo en
  // cada edición.
  const editOriginalPrice = (p.discountPct && p.discountPct > 0) ? Math.round(p.price / (1 - p.discountPct/100)) : p.price;
  document.getElementById('zyPrice').value = editOriginalPrice;
  { const mk = document.getElementById('zyUseMarkup'); if(mk) mk.checked = false; }   // un producto ya guardado NO vuelve a recibir el % (evita sumarlo dos veces)
  zyApplyCostToForm(id);   // si tiene precio base guardado, lo recupera y vuelve a marcar la casilla
  document.getElementById('zyDesc').value = p.desc || '';
  document.getElementById('zyMaterial').value = p.material || '';
  document.getElementById('zyColor').value = p.color || '';
  zyFragSetForm(p);
  zyRopaSetForm(p);
  zyBolsoSetForm(p);
  zyLentesSetForm(p);
  zySneakerSetForm(p);
  zyJoySetForm(p);
  zyRelojSetForm(p);
  zyGorraSetForm(p);
  zyRenderSizeGrid(p.category, (p.sizes||[]).map(String));
  zyRenderFeaturedChips(p.featured ? Object.keys(p.featured).filter(k=>p.featured[k]) : []);
  document.getElementById('zySku').value = p.sku || '';
  document.getElementById('zyDate').value = p.releaseDateISO || '';
  document.getElementById('zyStock').value = Object.values(p.stock||{})[0] || 8;
  document.getElementById('zyDiscountPct').value = p.discountPct || 0;
  document.getElementById('zyTag').value = p.tag || '';
  document.getElementById('zyImageCount').value = p.imageCount || (p.images||[]).length || 4;
  zyMedia.forEach(m=>{ m.cancelled = true; });
  zyMedia = zyMediaFromProduct(p);
  zyRenderMediaThumbs();
  document.getElementById('zyImageCount').value = p.imageCount || (p.images||[]).length || 4;
  zyUpdateDiscountPreview();
  // [Punto 3 — Tipografía por producto]
  zyPopulateTitleFontSelect();
  document.getElementById('zyTitleFont').value = p.titleFont || '';
  document.getElementById('zyTitleColorOn').checked = !!p.titleColor;
  document.getElementById('zyTitleColor').value = p.titleColor || '#0E0E10';
