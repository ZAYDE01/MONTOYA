/* ================= [ZAYDE G · PIEZAS] Segundo apartado privado =================
   Curaduría manual: el admin elige a mano, pieza por pieza, cuáles
   aparecen en el bento de /clothes-g y en qué orden — en vez de que se
   llenen solas con "las más vistas" de una categoría (modo automático,
   que sigue disponible y es el que estaba antes por default). */
let zyRopagManualSelection = []; // arreglo de IDs de producto, en orden, mientras se edita en el panel (se guarda al hacer clic en "Guardar")
function zyLoadRopagPiezasForm(){
  const rs = zySettings.ropagSettings || {};
  zyRopagManualSelection = Array.isArray(rs.manualIds) ? rs.manualIds.slice() : [];
  zySetRopagMode(rs.manualMode === 'manual' ? 'manual' : 'auto', true);
}
function zySetRopagMode(mode, skipSave){
  document.getElementById('zyRopagModeAutoBtn').classList.toggle('active', mode==='auto');
  document.getElementById('zyRopagModeManualBtn').classList.toggle('active', mode==='manual');
  document.getElementById('zyRopagManualBox').style.display = mode==='manual' ? '' : 'none';
  zyRopagPendingMode = mode;
  if(mode==='manual'){
    zyRenderRopagSelectedList();
    zyRenderRopagPiezasPicker();
  }
}
let zyRopagPendingMode = 'auto';
function zyRenderRopagSelectedList(){
  const box = document.getElementById('zyRopagSelectedList');
  if(!box) return;
  if(!zyRopagManualSelection.length){
    box.innerHTML = `<div class="zy-list-item" style="color:var(--steel);">Todavía no has elegido ninguna pieza — agrégalas de la lista de abajo.</div>`;
    return;
  }
  box.innerHTML = zyRopagManualSelection.map((id,i)=>{
    const p = PRODUCTS.find(x=>x.id===id);
    if(!p) return '';
    return `
    <div class="zy-list-item">
      <span>${i+1}. ${zyEscapeHtml(p.brand)} · ${zyEscapeHtml(p.name)} — ${fmt(p.price)}</span>
      <span style="display:flex;gap:10px;">
        <button type="button" onclick="zyRopagMovePiece(${id},-1)" ${i===0?'disabled':''} aria-label="Subir">↑</button>
        <button type="button" onclick="zyRopagMovePiece(${id},1)" ${i===zyRopagManualSelection.length-1?'disabled':''} aria-label="Bajar">↓</button>
        <button type="button" onclick="zyRopagRemovePiece(${id})" style="color:var(--down);">Quitar</button>
      </span>
    </div>`;
  }).join('');
}
function zyRenderRopagPiezasPicker(){
  const box = document.getElementById('zyRopagPiezasPicker');
  if(!box) return;
  const q = (document.getElementById('zyRopagPiezasSearch').value || '').toLowerCase().trim();
  let list = zyClothesGProducts().filter(p=>!zyRopagManualSelection.includes(p.id));
  if(q) list = list.filter(p=>(p.brand+' '+p.name+' '+p.category).toLowerCase().includes(q));
  list = list.slice(0, 60); // evita renderizar miles de filas de golpe
  if(!list.length){
    box.innerHTML = `<div class="zy-list-item" style="color:var(--steel);">Sin resultados</div>`;
    return;
  }
  box.innerHTML = list.map(p=>`
    <div class="zy-list-item">
      <span>${zyEscapeHtml(p.brand)} · ${zyEscapeHtml(p.name)} — ${p.category}</span>
      <button type="button" class="btn btn-ghost" style="padding:4px 10px; font-size:11px;" onclick="zyRopagAddPiece(${p.id})">Agregar</button>
    </div>`).join('');
}
function zyRopagAddPiece(id){
  if(zyRopagManualSelection.includes(id)) return;
  zyRopagManualSelection.push(id);
  zyRenderRopagSelectedList();
  zyRenderRopagPiezasPicker();
}
function zyRopagRemovePiece(id){
  zyRopagManualSelection = zyRopagManualSelection.filter(x=>x!==id);
  zyRenderRopagSelectedList();
  zyRenderRopagPiezasPicker();
}
function zyRopagMovePiece(id, dir){
  const i = zyRopagManualSelection.indexOf(id);
  const j = i + dir;
  if(i<0 || j<0 || j>=zyRopagManualSelection.length) return;
  [zyRopagManualSelection[i], zyRopagManualSelection[j]] = [zyRopagManualSelection[j], zyRopagManualSelection[i]];
  zyRenderRopagSelectedList();
}
function zySaveRopagPiezas(){
  if(zyRopagPendingMode==='manual' && !zyRopagManualSelection.length){
    showToast('Elige al menos una pieza antes de guardar, o cambia a modo Automático', true);
    return;
  }
  zySettings.ropagSettings = Object.assign({}, zySettings.ropagSettings, {
    manualMode: zyRopagPendingMode,
    manualIds: zyRopagManualSelection.slice()
  });
  AdminStore.set('zayde:admin:homeSettings', zySettings);
  renderRopaG();
  showToast('Piezas de ZAYDE G actualizadas');
}
